fn test_network_bridge_veth_name() {
    test_group("network_bridge_veth_name");
    var h = host_veth_name("abc123def456ghij");
    assert_eq(streq(h, "ve-abc123def456"), 1, "ve- prefix + first 12 chars");
    assert_eq(strlen(h), 15, "IFNAMSIZ-1 length");
    var h2 = host_veth_name("short");
    assert_eq(streq(h2, "ve-short"), 1, "short id untruncated");
    var h3 = host_veth_name("0123456789ab");
    assert_eq(streq(h3, "ve-0123456789ab"), 1, "exactly 12 chars");
    assert_eq(streq(container_veth_name(), "eth0"), 1, "peer is eth0");
    return 0;
}

fn test_network_bridge_ipv4_fmt() {
    test_group("network_bridge_ipv4_fmt");
    # 172.17.0.1 packed = (172<<24)|(17<<16)|(0<<8)|1
    var gw = 2886795265;
    var s = _ipv4_cstr(gw);
    assert_eq(streq(s, "172.17.0.1"), 1, "dotted-decimal gateway");
    var cidr = _ipv4_cidr_cstr(gw, 16);
    assert_eq(streq(cidr, "172.17.0.1/16"), 1, "cidr with prefix");
    # 10.0.0.255
    var b = _ipv4_cstr(167772415);
    assert_eq(streq(b, "10.0.0.255"), 1, "trailing 255 octet");
    return 0;
}