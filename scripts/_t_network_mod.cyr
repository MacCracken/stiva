fn test_network_mode_name() {
    test_group("network_mode_name");
    assert_eq(streq(network_mode_name(NETWORK_MODE_BRIDGE), "Bridge"), 1, "Bridge");
    assert_eq(streq(network_mode_name(NETWORK_MODE_HOST), "Host"), 1, "Host");
    assert_eq(streq(network_mode_name(NETWORK_MODE_NONE), "None"), 1, "None");
    assert_eq(streq(network_mode_name(NETWORK_MODE_CONTAINER), "Container"), 1, "Container");
    assert_eq(streq(network_mode_name(NETWORK_MODE_CUSTOM), "Custom"), 1, "Custom");
    return 0;
}

fn test_network_mode_container() {
    test_group("network_mode_container");
    var a: NetworkModeVal = network_mode_new(NETWORK_MODE_CONTAINER, "abc123");
    var b: NetworkModeVal = network_mode_new(NETWORK_MODE_CONTAINER, "abc123");
    assert_eq(network_mode_eq(a, b), 1, "same payload equal");
    var c: NetworkModeVal = network_mode_new(NETWORK_MODE_CONTAINER, "other");
    assert_eq(network_mode_eq(a, c), 0, "diff payload not equal");
    var d: NetworkModeVal = network_mode_new(NETWORK_MODE_CUSTOM, "abc123");
    assert_eq(network_mode_eq(a, d), 0, "diff tag not equal");
    var e: NetworkModeVal = network_mode_new(NETWORK_MODE_BRIDGE, 0);
    var f: NetworkModeVal = network_mode_new(NETWORK_MODE_BRIDGE, 0);
    assert_eq(network_mode_eq(e, f), 1, "bridge equal");
    return 0;
}

fn test_network_struct() {
    test_group("network_struct");
    var net: Network = network_new("stiva-bridge0", "172.17.0.0/16", "172.17.0.1", NETWORK_DRIVER_BRIDGE);
    assert_eq(streq(net.name, "stiva-bridge0"), 1, "name");
    assert_eq(streq(net.subnet, "172.17.0.0/16"), 1, "subnet");
    assert_eq(net.driver, NETWORK_DRIVER_BRIDGE, "driver");
    return 0;
}

fn test_network_driver_variants() {
    test_group("network_driver_variants");
    assert_eq(streq(network_driver_name(NETWORK_DRIVER_BRIDGE), "Bridge"), 1, "Bridge");
    assert_eq(streq(network_driver_name(NETWORK_DRIVER_OVERLAY), "Overlay"), 1, "Overlay");
    assert_eq(streq(network_driver_name(NETWORK_DRIVER_MACVLAN), "Macvlan"), 1, "Macvlan");
    return 0;
}

fn test_container_network() {
    test_group("container_network");
    var cn: ContainerNetwork = container_network_new("172.17.0.2", 0, "bridge", "veth-abc", "eth0");
    assert_eq(streq(cn.ip, "172.17.0.2"), 1, "ip");
    assert_eq(cn.ipv6, 0, "ipv6 none");
    assert_eq(streq(cn.container_veth, "eth0"), 1, "container_veth");
    var cn2: ContainerNetwork = container_network_new("172.17.0.2", "fd00::2", "bridge", "veth-abc", "eth0");
    assert_eq(streq(cn2.ipv6, "fd00::2"), 1, "ipv6 some");
    return 0;
}

fn test_network_policy_default_no_restrictions() {
    test_group("network_policy_default_no_restrictions");
    var policy: NetworkPolicy = network_policy_default();
    assert_eq(network_policy_has_restrictions(policy), 0, "no restrictions");
    return 0;
}

fn test_network_policy_with_deny() {
    test_group("network_policy_with_deny");
    var policy: NetworkPolicy = network_policy_default();
    vec_push(policy.egress_deny, "10.0.0.0/8");
    assert_eq(network_policy_has_restrictions(policy), 1, "has restrictions");
    var rules = network_policy_to_nft_rules(policy, "172.17.0.2");
    assert_eq(vec_len(rules), 1, "one rule");
    var r0 = vec_get(rules, 0);
    assert_eq(strstr(r0, "10.0.0.0/8") >= 0, 1, "contains cidr");
    assert_eq(strstr(r0, "drop") >= 0, 1, "contains drop");
    assert_eq(strstr(r0, "172.17.0.2") >= 0, 1, "contains ip");
    return 0;
}

fn test_dns_registry_resolve() {
    test_group("dns_registry_resolve");
    var reg: DnsRegistry = dns_registry_new();
    dns_registry_register(reg, "web", "172.17.0.2");
    dns_registry_register(reg, "db", "172.17.0.3");
    assert_eq(streq(dns_registry_resolve(reg, "web"), "172.17.0.2"), 1, "web");
    assert_eq(streq(dns_registry_resolve(reg, "db"), "172.17.0.3"), 1, "db");
    assert_eq(dns_registry_resolve(reg, "missing"), 0, "missing none");
    return 0;
}

fn test_dns_registry_unregister() {
    test_group("dns_registry_unregister");
    var reg: DnsRegistry = dns_registry_new();
    dns_registry_register(reg, "web", "172.17.0.2");
    dns_registry_unregister(reg, "web");
    assert_eq(dns_registry_resolve(reg, "web"), 0, "web removed");
    return 0;
}

fn test_dns_registry_hosts_entries() {
    test_group("dns_registry_hosts_entries");
    var reg: DnsRegistry = dns_registry_new();
    dns_registry_register(reg, "web", "172.17.0.2");
    var hosts = dns_registry_to_hosts_entries(reg);
    assert_eq(strstr(hosts, "172.17.0.2\tweb") >= 0, 1, "ip tab name");
    return 0;
}

fn test_dns_registry_inject() {
    test_group("dns_registry_inject");
    var reg: DnsRegistry = dns_registry_new();
    dns_registry_register(reg, "db", "172.17.0.3");
    sys_mkdir("/tmp/nm_inject_test", 448);
    var rc = dns_registry_inject_into(reg, "/tmp/nm_inject_test", "172.17.0.2", "web");
    assert_eq(rc, STIVA_ERR_OK, "inject ok");
    var buf = alloc(4096);
    var n = file_read_all("/tmp/nm_inject_test/etc/hosts", buf, 4095);
    store8(buf + n, 0);
    assert_eq(strstr(buf, "172.17.0.2\tweb") >= 0, 1, "self entry");
    assert_eq(strstr(buf, "172.17.0.3\tdb") >= 0, 1, "db entry");
    assert_eq(strstr(buf, "127.0.0.1\tlocalhost") >= 0, 1, "localhost");
    return 0;
}