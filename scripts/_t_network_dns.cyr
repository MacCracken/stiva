fn read_file_cstr(path) {
    var cap = 65536;
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap - 1);
    if (n < 0) { store8(buf, 0); return buf; }
    store8(buf + n, 0);
    return buf;
}

fn test_dns_parse_resolv_conf_basic() {
    test_group("network_dns::parse_resolv_conf_basic");
    var content = "nameserver 8.8.8.8\nnameserver 8.8.4.4\n";
    var servers = network_dns_parse_resolv_conf(content);
    assert_eq(vec_len(servers), 2, "two servers");
    assert_eq(vec_get(servers, 0), network_dns_parse_ipv4("8.8.8.8"), "first 8.8.8.8");
    assert_eq(vec_get(servers, 1), network_dns_parse_ipv4("8.8.4.4"), "second 8.8.4.4");
    return 0;
}

fn test_dns_parse_resolv_conf_with_comments() {
    test_group("network_dns::parse_resolv_conf_with_comments");
    var content = "# DNS\nnameserver 1.1.1.1\nsearch example.com\nnameserver 1.0.0.1\n";
    var servers = network_dns_parse_resolv_conf(content);
    assert_eq(vec_len(servers), 2, "two servers");
    assert_eq(vec_get(servers, 0), network_dns_parse_ipv4("1.1.1.1"), "first 1.1.1.1");
    return 0;
}

fn test_dns_parse_resolv_conf_empty() {
    test_group("network_dns::parse_resolv_conf_empty");
    var servers = network_dns_parse_resolv_conf("");
    assert_eq(vec_len(servers), 0, "empty is empty");
    return 0;
}

fn test_dns_parse_resolv_conf_ipv6_skipped() {
    test_group("network_dns::parse_resolv_conf_ipv6_skipped");
    var content = "nameserver 8.8.8.8\nnameserver ::1\n";
    var servers = network_dns_parse_resolv_conf(content);
    assert_eq(vec_len(servers), 1, "ipv6 skipped");
    return 0;
}

fn test_dns_ipv4_to_str_canonical() {
    test_group("network_dns::ipv4_to_str_canonical");
    assert_eq(streq(str_cstr(network_dns_ipv4_to_str(0x08080808)), "8.8.8.8"), 1, "8.8.8.8");
    assert_eq(streq(str_cstr(network_dns_ipv4_to_str(0xAC110002)), "172.17.0.2"), 1, "172.17.0.2");
    return 0;
}

fn test_dns_parse_ipv4_reject() {
    test_group("network_dns::parse_ipv4_reject");
    assert_eq(network_dns_parse_ipv4("::1"), network_dns_ipv4_invalid(), "ipv6 rejected");
    assert_eq(network_dns_parse_ipv4("1.2.3"), network_dns_ipv4_invalid(), "three octets");
    assert_eq(network_dns_parse_ipv4("1.2.3.4.5"), network_dns_ipv4_invalid(), "five octets");
    assert_eq(network_dns_parse_ipv4("256.0.0.1"), network_dns_ipv4_invalid(), "octet overflow");
    assert_eq(network_dns_parse_ipv4("1.2.3.4 "), network_dns_ipv4_invalid(), "trailing space");
    assert_eq(network_dns_parse_ipv4("0.0.0.0"), 0, "zero packs to 0");
    return 0;
}

fn test_dns_inject_resolv_conf_to_rootfs() {
    test_group("network_dns::inject_resolv_conf_to_rootfs");
    var dir = "/tmp/stiva_nd_rc";
    sys_mkdir(dir, 0x1ED);
    var servers = vec_new();
    vec_push(servers, network_dns_parse_ipv4("1.1.1.1"));
    vec_push(servers, network_dns_parse_ipv4("1.0.0.1"));
    assert_eq(network_dns_inject_resolv_conf(dir, servers), 0, "inject ok");
    var content = read_file_cstr("/tmp/stiva_nd_rc/etc/resolv.conf");
    assert_eq(strstr(content, "nameserver 1.1.1.1") >= 0, 1, "has 1.1.1.1");
    assert_eq(strstr(content, "nameserver 1.0.0.1") >= 0, 1, "has 1.0.0.1");
    return 0;
}

fn test_dns_inject_resolv_conf_defaults_when_empty() {
    test_group("network_dns::inject_resolv_conf_defaults_when_empty");
    var dir = "/tmp/stiva_nd_def";
    sys_mkdir(dir, 0x1ED);
    var empty = vec_new();
    assert_eq(network_dns_inject_resolv_conf(dir, empty), 0, "inject ok");
    var content = read_file_cstr("/tmp/stiva_nd_def/etc/resolv.conf");
    assert_eq(strstr(content, "nameserver 8.8.8.8") >= 0, 1, "default 8.8.8.8");
    return 0;
}

fn test_dns_inject_hosts_to_rootfs() {
    test_group("network_dns::inject_hosts_to_rootfs");
    var dir = "/tmp/stiva_nd_hosts";
    sys_mkdir(dir, 0x1ED);
    assert_eq(network_dns_inject_hosts(dir, network_dns_parse_ipv4("172.17.0.2"), "mycontainer"), 0, "inject ok");
    var content = read_file_cstr("/tmp/stiva_nd_hosts/etc/hosts");
    assert_eq(strstr(content, "127.0.0.1\tlocalhost") >= 0, 1, "localhost line");
    assert_eq(strstr(content, "172.17.0.2\tmycontainer") >= 0, 1, "container line");
    return 0;
}

fn test_dns_inject_hostname_to_rootfs() {
    test_group("network_dns::inject_hostname_to_rootfs");
    var dir = "/tmp/stiva_nd_hn";
    sys_mkdir(dir, 0x1ED);
    assert_eq(network_dns_inject_hostname(dir, "web-server"), 0, "inject ok");
    var content = read_file_cstr("/tmp/stiva_nd_hn/etc/hostname");
    assert_eq(streq(content, "web-server\n"), 1, "hostname content");
    return 0;
}

fn test_dns_host_servers_returns_something() {
    test_group("network_dns::host_dns_servers_returns_something");
    var servers = network_dns_host_servers();
    assert_eq(vec_len(servers) > 0, 1, "always at least defaults");
    return 0;
}