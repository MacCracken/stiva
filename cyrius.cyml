[package]
name = "stiva"
version = "${file:VERSION}"
description = "Stiva — OCI container runtime: image management, container lifecycle, orchestration. Cyrius port of Rust v2.x."
license = "GPL-3.0-or-later"
repository = "https://github.com/MacCracken/stiva"
language = "cyrius"
cyrius = "6.4.78"

[build]
entry = "src/main.cyr"
output = "build/stiva"

# ── Library surface ──────────────────────────────────────────────
# stiva is consumable at the source level as a single-file bundle,
# `dist/stiva.cyr` (built by `cyrius distlib`). `[lib].modules` lists the
# domain `src/*.cyr` files, in dependency order, that distlib concatenates
# to (re)build that bundle. It is the generator's single source of truth;
# `src/lib.cyr` mirrors this order as the human-facing aggregation header.
#
# src/main.cyr is INTENTIONALLY excluded — it is the in-tree program entry
# (its own `main()` + CLI dispatch + top-level `syscall(SYS_EXIT)`).
# src/lib.cyr is also excluded: it is a pure aggregation header (only
# `include` directives).
#
# Modules are ported bottom-up from rust-old/ (the parity oracle). This
# list grows as each module lands — keep it in dependency order.
[lib]
modules = [
    "src/error.cyr",
    "src/oci.cyr",
    "src/intents.cyr",
    "src/audit.cyr",
    "src/convert.cyr",
    "src/network_mod.cyr",
    "src/network_bridge.cyr",
    "src/network_dns.cyr",
    "src/network_pool.cyr",
    "src/network_rootless.cyr",
    "src/network_nat.cyr",
    "src/network_manager.cyr",
    "src/image.cyr",
    "src/registry.cyr",
    "src/storage.cyr",
    "src/imagelayout.cyr",
    "src/build.cyr",
    "src/encrypted.cyr",
    "src/runtime.cyr",
    "src/container.cyr",
    "src/cron.cyr",
    "src/health.cyr",
    "src/ansamblu.cyr",
    "src/agent.cyr",
    "src/fleet.cyr",
    "src/mcp.cyr",
    "src/stiva_core.cyr",
]

# ── Dependencies ─────────────────────────────────────────────────
# Stdlib is OPT-IN. This UNION covers stiva's own modules + every AGNOS dep
# bundle's `dist/*.deps` sidecar (kavach/majra/nein/bote/agnodrm) + their
# transitive git deps (sigil/libro/sakshi). Validated by an isolated probe
# build under cc 6.4.14. `sigil` (full) provides SHA-256/HMAC for image digests
# AND the AGNOS bundles' crypto — the à-la-carte sha256 chain was retired here
# (full sigil supersedes it; our audit_log_new/port_mapping_new were renamed
# stiva_* to avoid its collisions).
[deps]
stdlib = [
    "alloc", "args", "assert", "async", "atomic", "bayan", "bench", "callback",
    "chrono", "ct", "dynlib", "fdlopen", "fmt", "fnptr", "freelist", "fs",
    "hashmap", "io", "keccak", "math", "mmap", "net", "process", "random",
    "result", "sakshi", "sandhi", "sankoch", "sigil", "slice", "str", "string",
    "sync", "syscalls", "tagged", "thread", "thread_local", "tls", "vec",
    "ws_server",
]

# ── AGNOS first-party deps (Cyrius dist bundles) ─────────────────
# Declared before the deps that reference their symbols (single-pass forward-
# ref resolution): sakshi ← libro ← majra ← bote; nein needs bote-core; kavach
# + agnodrm sit on sigil (via [deps].stdlib). ~35 cross-bundle "duplicate fn
# (last definition wins)" warnings are expected — shared agnos error helpers
# each bundle vendors; benign, the ecosystem norm for multi-bundle consumers.

# Structured tracing (libro's transitive).
[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
# path = "../sakshi"   # see "Local dep development" above
tag = "2.4.6"
modules = ["dist/sakshi.cyr"]

# Audit-chain crypto tools (bote's + nein's transitive).
[deps.libro]
git = "https://github.com/MacCracken/libro.git"
# path = "../libro"   # see "Local dep development" above
tag = "2.8.2"
modules = ["dist/libro.cyr"]

# Job queue, heartbeat FSM, pub/sub — fleet / health / ansamblu / container.
[deps.majra]
git = "https://github.com/MacCracken/majra.git"
# path = "../majra"   # see "Local dep development" above
tag = "2.5.1"
modules = ["dist/majra.cyr"]

# MCP core (JSON-RPC 2.0, tool registry, structured output) — mcp. `bote-core`
# is the subset nein also needs; the full MCP surface for mcp.cyr is pulled from
# the same core (extend to dist/bote.cyr if mcp needs tools beyond core).
[deps.bote]
git = "https://github.com/MacCracken/bote.git"
# path = "../bote"   # see "Local dep development" above
tag = "3.1.4"
modules = ["dist/bote-core.cyr"]

# nftables firewall, NAT, port mapping — network/nat + network/manager.
[deps.nein]
git = "https://github.com/MacCracken/nein.git"
# path = "../nein"   # see "Local dep development" above
tag = "1.6.4"
modules = ["dist/nein.cyr"]

# Sandbox isolation — runtime + container (Sandbox, SandboxPolicy/Config,
# SecretRef, StrengthScore, ExternalizationGate).
[deps.kavach]
git = "https://github.com/MacCracken/kavach.git"
# path = "../kavach"   # see "Local dep development" above
tag = "3.9.3"
modules = ["dist/kavach.cyr"]

# ── samay + ai-hwaccel — declared, pinned, and DEFAULT-OFF ────────
# These arrived silently as kavach 3.8.0's transitive closure (kavach declared
# [deps.samay]; samay declares [deps.ai-hwaccel]), landing in lib/ undeclared
# and UNLOCKED — 83 lock entries against 85 lib/*.cyr. kavach 3.8.2 makes them
# optional on its side, so they no longer arrive uninvited; stiva now names them
# explicitly, on its own terms.
#
# The `accel` feature is now DEFAULT-ON: roadmap §H (cron containers) and §I
# (accelerator inventory + placement) have landed and call into both bundles.
#
# The two historical objections are both dead. The identifier-cap warning below
# was written against cycc's 262144-entry buffer; 6.4.76 raised it to 524288 and
# the worst unit with `accel` on measures 276,898 (52.8%) — a full
# `cyrius tests --features accel` run passes with no splitting. The size
# objection (~279 KB reaching every consumer of dist/stiva.cyr) is real but not
# material for a container runtime.
#
# They stay declared `optional` so the feature can still be switched off by a
# consumer that genuinely wants neither.
#
# NOTE: `path` OVERRIDES `tag` — a local sibling checkout wins outright. That is
# how kavach 3.8.1 arrived here while this file still said 3.7.1. `cyrius.lock`
# records only bare `<sha256>  lib/<file>` lines (no dep name / version / rev),
# so it cannot detect the substitution; `git diff cyrius.lock` after
# `cyrius deps` is the only reliable check.
[features]
default = ["accel"]
accel = ["samay", "ai-hwaccel"]

# Cron/schedule machinery + resource-aware placement (roadmap §H).
[deps.samay]
git = "https://github.com/MacCracken/samay.git"
# path = "../samay"   # see "Local dep development" above
tag = "1.0.1"
modules = ["dist/samay.cyr"]
optional = true

# Accelerator inventory + requirement matching (roadmap §I). Owns the bare
# `backend_name`; kavach's OS-backend namer was renamed `os_backend_name` in
# kavach 3.8.2 to resolve the last-def-wins collision (both enums start at 0,
# so `backend_name(Backend.OCI)` silently returned "intel-npu"). `path_exists`
# also collides but is benign — identical 1/0 semantics.
[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
# path = "../ai-hwaccel"   # see "Local dep development" above
tag = "2.3.15"
modules = ["dist/ai-hwaccel.cyr"]
optional = true

# ── Local dep development ────────────────────────────────
#
# Every `path = "../<dep>"` override is COMMENTED OUT, deliberately.
#
# A `path` override silently WINS over its `tag`, and `cyrius.lock` records no
# dep name or version, so nothing detects the substitution. The practical
# consequence, observed: the committed lock described whatever the sibling
# checkouts happened to be, `~/Repos/sakshi` sat 3 commits past its 2.4.6 tag,
# and every local build and test ran against a sakshi that exists at no tag —
# while CI, which has no siblings, resolved the tag and got different bytes.
# This is the same mechanism by which kavach 3.8.1 once arrived here unannounced
# while this file still said 3.7.1.
#
# With the overrides off, `cyrius deps` resolves from the tags on every machine,
# so the lock means one thing and CI's build is the build.
#
# To develop a dep alongside stiva: uncomment its `path` line, work, then tag
# and release the dep and bump the `tag` here before committing the lock. Do not
# commit a lock produced with an override active — the CI guard in
# .github/workflows/ci.yml compares the dep bundles against the tags and will
# reject it, naming the file.

# LUKS + dm-verity — encrypted.
[deps.agnodrm]
git = "https://github.com/MacCracken/agnodrm.git"
# path = "../agnodrm"   # see "Local dep development" above
tag = "1.5.0"
modules = ["dist/agnodrm.cyr"]

# CLI / argument parsing (getopt-long + verb dispatch) — src/main.cyr registers
# stiva's 35 subcommands as cmdit verbs instead of hand-rolling argv parsing.
# 1.2.0 adds the verb-table accessors + cmdit_completions that `stiva
# completions` is built on: without them the completion script would have to be
# a hand-kept list, drifting from the verbs the moment one is added.
[deps.cmdit]
git = "https://github.com/MacCracken/cmdit.git"
# path = "../cmdit"   # see "Local dep development" above
tag = "1.2.2"
modules = ["dist/cmdit.cyr"]
