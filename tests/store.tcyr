# stiva test suite — store / layout / archive surface
# Split out of tests/stiva.tcyr (2026-07-22): declaring [deps.samay] +
# [deps.ai-hwaccel] added ~279 KB of vendored symbols to every compilation
# unit, which pushed the monolithic stiva.tcyr past cycc's identifier cap
# (261893/262144 — a hard error, not a warning). This file carries the
# imagelayout + storage tests and includes only the 6 src modules they need,
# rather than all 26.
#
# Covers: OCI image config/manifest assembly, the oci-layout store + index.json,
# oci-archive + docker-archive save/load, the USTAR tar codec, overlay/volume
# mounts, and blob-store integrity.
# Stdlib auto-included via cyrius.cyml.

include "src/error.cyr"
include "src/oci.cyr"
include "src/image.cyr"
include "src/registry.cyr"
include "src/storage.cyr"
include "src/imagelayout.cyr"

# ── imagelayout.cyr (OCI image-layout — net-new; OCI image-spec is the oracle) ──
fn test_oci_config_object_minimal() {
    test_group("oci_config_object_minimal");
    var o = oci_config_object_jv(0, 0, 0, 0, 0, 0, 0);
    assert_eq(streq(str_cstr(json_v_build(o)), "{}"), 1, "empty config object is {}");
    return 0;
}

fn test_oci_config_object_fields() {
    test_group("oci_config_object_fields");
    var env = vec_new();
    vec_push(env, "PATH=/usr/bin");
    vec_push(env, "HOME=/root");
    var cmd = vec_new();
    vec_push(cmd, "/bin/sh");
    var ep = vec_new();
    vec_push(ep, "/entry");
    var ports = vec_new();
    vec_push(ports, "8080/tcp");
    var labels = vec_new();
    vec_push(labels, "org.opencontainers.image.authors");
    vec_push(labels, "stiva");
    var o = oci_config_object_jv(env, cmd, ep, "/app", "nobody", ports, labels);
    var j = str_cstr(json_v_build(o));
    assert_eq(strstr(j, "\"User\":\"nobody\"") >= 0, 1, "User");
    assert_eq(strstr(j, "\"ExposedPorts\":{\"8080/tcp\":{}}") >= 0, 1, "ExposedPorts empty-object map");
    assert_eq(strstr(j, "\"Env\":[\"PATH=/usr/bin\",\"HOME=/root\"]") >= 0, 1, "Env array");
    assert_eq(strstr(j, "\"Entrypoint\":[\"/entry\"]") >= 0, 1, "Entrypoint");
    assert_eq(strstr(j, "\"Cmd\":[\"/bin/sh\"]") >= 0, 1, "Cmd");
    assert_eq(strstr(j, "\"WorkingDir\":\"/app\"") >= 0, 1, "WorkingDir");
    assert_eq(strstr(j, "\"Labels\":{\"org.opencontainers.image.authors\":\"stiva\"}") >= 0, 1, "Labels");
    assert_eq(strstr(j, "\"User\"") < strstr(j, "\"Env\""), 1, "canonical order: User before Env");
    return 0;
}

fn test_oci_config_build_shape() {
    test_group("oci_config_build_shape");
    var diffs = vec_new();
    vec_push(diffs, "sha256:aaa");
    vec_push(diffs, "sha256:bbb");
    var v = oci_config_build("amd64", "linux", 0, oci_config_object_jv(0, 0, 0, 0, 0, 0, 0), diffs, 0);
    var j = str_cstr(json_v_build(v));
    assert_eq(strstr(j, "\"architecture\":\"amd64\"") >= 0, 1, "architecture");
    assert_eq(strstr(j, "\"os\":\"linux\"") >= 0, 1, "os");
    assert_eq(strstr(j, "\"config\":{}") >= 0, 1, "empty config sub-object");
    assert_eq(strstr(j, "\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:aaa\",\"sha256:bbb\"]}") >= 0, 1, "rootfs diff_ids");
    assert_eq(strstr(j, "created") >= 0, 0, "no created when 0");
    assert_eq(strstr(j, "history") >= 0, 0, "no history when absent");
    var j2 = str_cstr(json_v_build(oci_config_build("amd64", "linux", 0, oci_config_object_jv(0, 0, 0, 0, 0, 0, 0), diffs, 0)));
    assert_eq(streq(j, j2), 1, "deterministic bytes");
    var v3 = oci_config_build("arm64", "linux", "2024-01-01T00:00:00Z", 0, diffs, 0);
    var j3 = str_cstr(json_v_build(v3));
    assert_eq(strstr(j3, "\"created\":\"2024-01-01T00:00:00Z\"") >= 0, 1, "created present when provided");
    assert_eq(strstr(j3, "{\"created\":") == 0, 1, "created is the first key");
    return 0;
}

fn test_il_oci_layout_version() {
    test_group("il_oci_layout_version");
    assert_eq(streq(oci_image_layout_version(), "1.0.0"), 1, "imageLayoutVersion 1.0.0");
    return 0;
}

fn test_il_parse_full_ref() {
    test_group("il_parse_full_ref");
    # "local/demo:v1" — the import reference form.
    var rr1: ImageRef = _il_parse_full_ref("local/demo:v1");
    assert_eq(streq(rr1.registry, "local"), 1, "local registry");
    assert_eq(streq(rr1.repository, "demo"), 1, "demo repo");
    assert_eq(streq(rr1.tag, "v1"), 1, "v1 tag");
    assert_eq(rr1.digest, 0, "no digest");
    # multi-segment repository under a real registry.
    var rr2: ImageRef = _il_parse_full_ref("ghcr.io/maccracken/agnosticos:latest");
    assert_eq(streq(rr2.registry, "ghcr.io"), 1, "ghcr registry");
    assert_eq(streq(rr2.repository, "maccracken/agnosticos"), 1, "nested repo preserved");
    assert_eq(streq(rr2.tag, "latest"), 1, "latest tag");
    # docker.io/library/alpine:3.19
    var rr3: ImageRef = _il_parse_full_ref("docker.io/library/alpine:3.19");
    assert_eq(streq(rr3.registry, "docker.io"), 1, "docker.io registry");
    assert_eq(streq(rr3.repository, "library/alpine"), 1, "library/alpine repo");
    assert_eq(streq(rr3.tag, "3.19"), 1, "3.19 tag");
    # exact inverse of image_ref_full_ref (the round-trip the index relies on).
    var bb: ImageRef = _il_parse_full_ref(image_ref_full_ref(image_ref_new("local", "app", "v2", 0)));
    assert_eq(streq(bb.registry, "local"), 1, "inverse registry");
    assert_eq(streq(bb.repository, "app"), 1, "inverse repo");
    assert_eq(streq(bb.tag, "v2"), 1, "inverse tag");
    # port-registry WITH a tag: the ':' after the last '/' is the tag.
    var pr: ImageRef = _il_parse_full_ref("localhost:5000/repo:v1");
    assert_eq(streq(pr.registry, "localhost:5000"), 1, "port registry kept");
    assert_eq(streq(pr.repository, "repo"), 1, "port repo");
    assert_eq(streq(pr.tag, "v1"), 1, "port tag");
    # port-registry WITHOUT a tag: the port ':' is NOT mistaken for a tag.
    var pn: ImageRef = _il_parse_full_ref("localhost:5000/repo");
    assert_eq(streq(pn.registry, "localhost:5000"), 1, "port registry (no tag)");
    assert_eq(streq(pn.repository, "repo"), 1, "port repo (no tag)");
    assert_eq(streq(pn.tag, "latest"), 1, "default tag when only a port colon");
    # v3.0.4: a bare name → empty registry, and full_ref has NO leading slash.
    var br: ImageRef = _il_parse_full_ref("bareimg:v3");
    assert_eq(streq(br.registry, ""), 1, "bare name → empty registry");
    assert_eq(streq(br.repository, "bareimg"), 1, "bare repo");
    assert_eq(streq(image_ref_full_ref(br), "bareimg:v3"), 1, "empty registry → no leading slash");
    return 0;
}

# v3.0.4: index descriptors carry the image's real config platform (so a
# foreign-arch image from a docker/oci archive keeps its arch), else host.
fn test_platform_passthrough() {
    test_group("platform_passthrough");
    var root = "/tmp/stiva_plat";
    _stor_remove_dir_all(root);
    var store = image_store_new(root);
    var cfg = "{\"architecture\":\"arm64\",\"os\":\"linux\",\"config\":{},\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:x\"]}}";
    var cdig = sha256_digest(cfg, strlen(cfg));
    image_store_store_blob(store, cdig, cfg, strlen(cfg));
    var img = image_new(cdig, image_ref_new("local", "arm-app", "v1", 0), 10, vec_new(), 0);
    _img_set_manifest_digest(img, "sha256:mani");
    var j = str_cstr(json_v_build(_il_manifest_descriptor_jv(store, img, 100)));
    assert_eq(strstr(j, "\"architecture\":\"arm64\"") >= 0, 1, "config arm64 carried into descriptor");
    assert_eq(strstr(j, "\"os\":\"linux\"") >= 0, 1, "config os carried");
    # a missing config blob falls back to the host platform (amd64).
    var img2 = image_new("sha256:nonexistent", image_ref_new("local", "x", "v1", 0), 10, vec_new(), 0);
    _img_set_manifest_digest(img2, "sha256:mani2");
    var d2 = str_cstr(json_v_build(_il_manifest_descriptor_jv(store, img2, 100)));
    assert_eq(strstr(d2, "\"architecture\":\"amd64\"") >= 0, 1, "missing config → host platform fallback");
    return 0;
}

# A4: oci-archive save → load round-trip across two stores. Blobs transfer
# byte-identically (content-verified) and the image reconstructs with the same
# id + reference.
fn test_oci_archive_save_load() {
    test_group("oci_archive_save_load");
    var ra = "/tmp/stiva_arc_a";
    var rb = "/tmp/stiva_arc_b";
    _stor_remove_dir_all(ra);
    _stor_remove_dir_all(rb);
    var sa = image_store_new(ra);

    var content = "archive-roundtrip-rootfs";
    file_write_all("/tmp/stiva_arc.tar", content, strlen(content));
    var img = image_import(sa, "/tmp/stiva_arc.tar", "arc", "v1");
    assert_eq(img != 0, 1, "import ok");
    var origid = _img_id(img);
    var origmd = _img_manifest_digest(img);

    var arc = "/tmp/stiva_arc.oci.tar";
    xunlink(arc);
    assert_eq(image_store_save_archive(sa, "local/arc:v1", arc), 1, "save ok");
    assert_eq(file_exists(arc), 1, "archive file written");

    var sb = image_store_new(rb);
    assert_eq(image_store_load_archive(sb, arc), 1, "loaded 1 image into B");
    var listed = image_store_list(sb);
    assert_eq(vec_len(listed), 1, "one image in B");
    var got = vec_get(listed, 0);
    assert_eq(streq(_img_id(got), origid), 1, "id preserved across transfer");
    assert_eq(streq(_img_manifest_digest(got), origmd), 1, "manifest digest preserved");
    var gref: ImageRef = _image_reference(got);
    assert_eq(streq(gref.registry, "local"), 1, "ref registry preserved");
    assert_eq(streq(gref.repository, "arc"), 1, "ref repo preserved");
    assert_eq(streq(gref.tag, "v1"), 1, "ref tag preserved");
    assert_eq(image_store_has_blob(sb, origid), 1, "config blob transferred");
    assert_eq(image_store_has_blob(sb, origmd), 1, "manifest blob transferred");

    # save a nonexistent image → 0; load a non-oci tar → negative.
    assert_eq(image_store_save_archive(sa, "nope:latest", "/tmp/stiva_arc_none.tar"), 0, "save missing -> 0");
    file_write_all("/tmp/stiva_arc_bad.tar", "not really a tar", 16);
    assert_eq(image_store_load_archive(sb, "/tmp/stiva_arc_bad.tar") < 0, 1, "load non-archive -> negative");
    return 0;
}

fn test_registry_credential() {
    test_group("registry_credential");
    var cred = registry_credential_new("alice", "s3cret");
    var cc: RegistryCredential = cred;
    assert_eq(streq(cc.username, "alice"), 1, "cred username");
    assert_eq(streq(cc.password, "s3cret"), 1, "cred password");
    return 0;
}

# CredentialStore set/get/remove (rust-old registry.rs: CredentialStore::set/get/remove).
fn test_credential_store_set_get_remove() {
    test_group("credential_store_set_get_remove");
    var store = credential_store_new();
    assert_eq(credential_store_get(store, "docker.io"), 0, "empty -> none");
    credential_store_set(store, "docker.io", "alice", "s3cret");
    var cred = credential_store_get(store, "docker.io");
    assert(cred != 0, "cred present");
    var cc: RegistryCredential = cred;
    assert_eq(streq(cc.username, "alice"), 1, "username");
    assert_eq(streq(cc.password, "s3cret"), 1, "password");
    assert_eq(credential_store_remove(store, "docker.io"), 1, "remove existing -> 1");
    assert_eq(credential_store_remove(store, "docker.io"), 0, "remove missing -> 0");
    assert_eq(credential_store_get(store, "docker.io"), 0, "gone");
    return 0;
}

# CredentialStore::to_config — creds present vs default (rust-old: to_config).
fn test_credential_store_to_config() {
    test_group("credential_store_to_config");
    var store = credential_store_new();
    credential_store_set(store, "ghcr.io", "bob", "tok");
    var cfg: RegistryConfig = credential_store_to_config(store, "ghcr.io");
    assert_eq(streq(cfg.username, "bob"), 1, "config username");
    assert_eq(streq(cfg.password, "tok"), 1, "config password");
    var cfg2: RegistryConfig = credential_store_to_config(store, "quay.io");
    assert_eq(cfg2.username, 0, "default username None");
    assert_eq(cfg2.password, 0, "default password None");
    return 0;
}

# CredentialStore JSON round-trip (the serde path underneath save/load).
fn test_credential_store_json_round_trip() {
    test_group("credential_store_json_round_trip");
    var store = credential_store_new();
    credential_store_set(store, "docker.io", "alice", "pw1");
    credential_store_set(store, "ghcr.io", "bob", "pw2");
    var json = json_v_build(credential_store_to_jv(store));
    var back = credential_store_from_jv(bayan_json_v_parse_str(str_data(json), str_len(json)));
    var c1: RegistryCredential = credential_store_get(back, "docker.io");
    assert(c1 != 0, "docker.io present");
    assert_eq(streq(c1.username, "alice"), 1, "docker user");
    var c2: RegistryCredential = credential_store_get(back, "ghcr.io");
    assert(c2 != 0, "ghcr.io present");
    assert_eq(streq(c2.password, "pw2"), 1, "ghcr pw");
    return 0;
}

# CredentialStore save→load through a temp path (NOT the real ~/.stiva — uses the
# internal path-parameterized helpers to avoid clobbering the user's file).
fn test_credential_store_save_load() {
    test_group("credential_store_save_load");
    var path = "/tmp/stiva_cred_test/credentials.json";
    xunlink(path);
    var store = credential_store_new();
    credential_store_set(store, "docker.io", "alice", "pw");
    assert_eq(_credential_store_save_to(store, path), 0, "save ok");
    var loaded = _credential_store_load_from(path);
    assert(loaded != 0, "load ok");
    var c: RegistryCredential = credential_store_get(loaded, "docker.io");
    assert(c != 0, "loaded cred present");
    assert_eq(streq(c.username, "alice"), 1, "loaded username");
    # Missing file → empty (non-zero) store, not an error.
    var empty = _credential_store_load_from("/tmp/stiva_cred_test/nope.json");
    assert(empty != 0, "missing -> empty store non-zero");
    assert_eq(credential_store_get(empty, "docker.io"), 0, "empty has nothing");
    return 0;
}

# default_path lands under ~/.stiva (rust-old: default_path via dirs_path).
fn test_credential_store_default_path() {
    test_group("credential_store_default_path");
    var p = credential_store_default_path();
    assert_eq(strstr(p, "/.stiva/credentials.json") >= 0, 1, "path under /.stiva");
    return 0;
}

# STRICT deserialization parity: serde rejects a malformed credentials file
# (missing `registries`, or a cred missing a required field) — load returns an
# error, not a lenient empty/partial store. A valid empty store is accepted.
fn test_credential_store_load_malformed() {
    test_group("credential_store_load_malformed");
    var dir = "/tmp/stiva_cred_bad";
    sys_mkdir(dir, 0x1ED);
    var p1 = "/tmp/stiva_cred_bad/no_registries.json";
    var j1 = "{}";
    file_write_all(p1, j1, strlen(j1));
    assert_eq(_credential_store_load_from(p1), 0, "{} missing registries -> 0");
    var p2 = "/tmp/stiva_cred_bad/no_pw.json";
    var j2 = "{\"registries\":{\"docker.io\":{\"username\":\"u\"}}}";
    file_write_all(p2, j2, strlen(j2));
    assert_eq(_credential_store_load_from(p2), 0, "missing password -> 0");
    var p3 = "/tmp/stiva_cred_bad/empty.json";
    var j3 = "{\"registries\":{}}";
    file_write_all(p3, j3, strlen(j3));
    var s = _credential_store_load_from(p3);
    assert(s != 0, "empty registries -> non-zero store");
    assert_eq(credential_store_get(s, "docker.io"), 0, "empty store has nothing");
    return 0;
}


