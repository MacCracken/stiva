# stiva benchmarks
# Stdlib auto-included via cyrius.cyml
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header for
# the full overhead-vs-batching guidance.

# Module prefix through imagelayout.cyr (the OCI image-layout hot paths: config +
# manifest assembly and serialization — A1/A2).
include "src/error.cyr"
include "src/oci.cyr"
include "src/intents.cyr"
include "src/audit.cyr"
include "src/convert.cyr"
include "src/network_mod.cyr"
include "src/network_bridge.cyr"
include "src/network_dns.cyr"
include "src/network_pool.cyr"
include "src/network_rootless.cyr"
include "src/network_nat.cyr"
include "src/network_manager.cyr"
include "src/image.cyr"
include "src/registry.cyr"
include "src/storage.cyr"
include "src/imagelayout.cyr"
# …plus the container chain, for the §E lifecycle-event-log benches below.
include "src/build.cyr"
include "src/encrypted.cyr"
include "src/runtime.cyr"
include "src/container.cyr"

fn bench_noop(): i64 { return 0; }

fn main(): i64 {
    alloc_init();
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < 1000000) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, 1000000);
    bench_report(b);

    # A1: OCI image config assembly + compact serialize.
    var diffs = vec_new();
    vec_push(diffs, "sha256:8a0c65959572fb0a32f88c20782ce7110d2f536539f8a3d3a1b6fd7c557160e0");
    var bc = bench_new("oci_config_build+serialize");
    bench_batch_start(bc);
    var j = 0;
    while (j < 100000) {
        var cfg = oci_config_build("amd64", "linux", 0, oci_config_object_jv(0, 0, 0, 0, 0, 0, 0), diffs, 0);
        json_v_build(cfg);
        j = j + 1;
    }
    bench_batch_stop(bc, 100000);
    bench_report(bc);

    # A2: OCI manifest assembly (config + one layer descriptor) + compact serialize.
    var cfgd = descriptor_new(media_oci_config(), "sha256:e93fbbab999657e921e61a27fbacde563f2428130ec3532c1641def8cbac75f9", 163);
    var bm = bench_new("oci_manifest_to_jv+serialize");
    bench_batch_start(bm);
    var k = 0;
    while (k < 100000) {
        var ld = vec_new();
        vec_push(ld, descriptor_new(media_oci_layer(), "sha256:3cb0b54b0805a060f557bfec1ea2b40ccd42d49581860e2dcd9cf7b2b1a8aa34", 153));
        var man = oci_manifest_new(cfgd, ld);
        var mm: OciManifest = man;
        mm.media_type = media_oci_manifest();
        json_v_build(oci_manifest_to_jv(man));
        k = k + 1;
    }
    bench_batch_stop(bm, 100000);
    bench_report(bm);

    # §G2: compose YAML -> TOML, whole pipeline (parse + validate + sort +
    # emit) on a realistic 3-service document.
    var csb = str_builder_new();
    str_builder_add_cstr(csb, "services:\n  web:\n    image: nginx:latest\n    ports:\n      - \"8080:80\"\n");
    str_builder_add_cstr(csb, "    depends_on:\n      - db\n  db:\n    image: postgres:16\n");
    str_builder_add_cstr(csb, "    environment:\n      POSTGRES_PASSWORD: secret\n      POSTGRES_DB: app\n");
    str_builder_add_cstr(csb, "    volumes:\n      - pgdata:/var/lib/postgresql/data\n  cache:\n    image: redis\n");
    str_builder_add_cstr(csb, "networks:\n  frontend:\n    driver: bridge\nvolumes:\n  pgdata:\n");
    var compose_src = str_cstr(str_builder_build(csb));
    var bcv = bench_new("compose_yaml_to_toml");
    bench_batch_start(bcv);
    var c = 0;
    while (c < 20000) { compose_yaml_to_toml(compose_src); c = c + 1; }
    bench_batch_stop(bcv, 20000);
    bench_report(bcv);

    # §G2: the sort alone, on REVERSE-sorted keys — the adversarial shape
    # that made the original insertion sort O(n^2) (1 MiB of reversed keys
    # took 236 s). Guards against a regression back to a quadratic sort.
    var rsb = str_builder_new();
    str_builder_add_cstr(rsb, "services:\n");
    var s = 400;
    while (s > 0) {
        str_builder_add_cstr(rsb, "  s");
        str_builder_add_int(rsb, 1000 + s);
        str_builder_add_cstr(rsb, ":\n    image: x\n");
        s = s - 1;
    }
    var rev_src = str_cstr(str_builder_build(rsb));
    var brv = bench_new("compose_400_reverse_sorted_keys");
    bench_batch_start(brv);
    var rc2 = 0;
    while (rc2 < 200) { compose_yaml_to_toml(rev_src); rc2 = rc2 + 1; }
    bench_batch_stop(brv, 200);
    bench_report(brv);

    # flatten_layers — the rootfs materialized when overlayfs is unavailable.
    # This is the one place stiva pays real disk I/O per container CREATE, so the
    # opt-out (STIVA_ROOTFS_FALLBACK=none) is only justifiable if the cost is
    # known. Two layers, 60 files of 4 KiB over 4 directories, with the upper
    # layer overwriting 10 of the lower's — ~240 KiB moved per iteration.
    #
    # I/O bound, so the absolute number tracks the host filesystem (and page
    # cache) more than the code; the CSV trend is what guards against a
    # regression. The dest is NOT cleared between iterations on purpose: after
    # the first, every entry goes down the replace-existing path, which is the
    # steady state a multi-layer image actually exercises.
    var fl0 = "/tmp/stiva_bench_flat_l0";
    var fl1 = "/tmp/stiva_bench_flat_l1";
    var fdst = "/tmp/stiva_bench_flat_dst";
    _stor_remove_dir_all(fl0);
    _stor_remove_dir_all(fl1);
    _stor_remove_dir_all(fdst);
    sys_mkdir(fl0, 493);
    sys_mkdir(fl1, 493);
    var payload = alloc(4096);
    var pz = 0;
    while (pz < 4096) { store8(payload + pz, 65); pz = pz + 1; }   # 4 KiB of 'A'
    var fd_i = 0;
    while (fd_i < 4) {
        var dsb = str_builder_new();
        str_builder_add_cstr(dsb, fl0);
        str_builder_add_cstr(dsb, "/d");
        str_builder_add_int(dsb, fd_i);
        var subdir = str_cstr(str_builder_build(dsb));
        sys_mkdir(subdir, 493);
        var ff = 0;
        while (ff < 10) {
            var fsb = str_builder_new();
            str_builder_add_cstr(fsb, subdir);
            str_builder_add_cstr(fsb, "/f");
            str_builder_add_int(fsb, ff);
            file_write_all(str_cstr(str_builder_build(fsb)), payload, 4096);
            ff = ff + 1;
        }
        fd_i = fd_i + 1;
    }
    var ftop = 0;
    while (ftop < 10) {
        var tsb = str_builder_new();
        str_builder_add_cstr(tsb, fl1);
        str_builder_add_cstr(tsb, "/f");
        str_builder_add_int(tsb, ftop);
        file_write_all(str_cstr(str_builder_build(tsb)), payload, 4096);
        # same name in the lower layer's d0 — exercises the collision path.
        var lsb = str_builder_new();
        str_builder_add_cstr(lsb, fl0);
        str_builder_add_cstr(lsb, "/f");
        str_builder_add_int(lsb, ftop);
        file_write_all(str_cstr(str_builder_build(lsb)), payload, 4096);
        ftop = ftop + 1;
    }
    var flayers = vec_new();
    vec_push(flayers, fl0);
    vec_push(flayers, fl1);
    var bfl = bench_new("flatten_layers_2x60_files_4kib");
    bench_batch_start(bfl);
    var fi = 0;
    while (fi < 100) { flatten_layers(flayers, fdst); fi = fi + 1; }
    bench_batch_stop(bfl, 100);
    bench_report(bfl);
    _stor_remove_dir_all(fl0);
    _stor_remove_dir_all(fl1);
    _stor_remove_dir_all(fdst);

    # §E: the lifecycle event log. Persisting to {root}/events.jsonl puts disk
    # I/O on every container state change, so the question the design has to
    # answer is what one transition now costs. Measured against the numbers
    # above, not in the abstract: flatten_layers is what a CREATE actually pays,
    # and the append has to be small next to it.
    #
    # Three parts, because they are paid at different rates:
    #   1. the JSON assembly            — per event
    #   2. the append (open+flock+write+close, no rotation) — per event
    #   3. the ts parse                 — per LINE READ, only by `stiva events`
    var ev_root = "/tmp/stiva_bench_events";
    _stor_remove_dir_all(ev_root);
    sys_mkdir(ev_root, 493);

    var bej = bench_new("event_json_build");
    bench_batch_start(bej);
    var ej = 0;
    while (ej < 200000) {
        _cm_event_json("created", "3f3827cb64803633dfd3dafe4c999c1b", "image", "local/demo:v1");
        ej = ej + 1;
    }
    bench_batch_stop(bej, 200000);
    bench_report(bej);

    # Rotation is disabled here (max_bytes 0) so this measures the steady-state
    # append alone; rotation is the rare path by construction (~70k events at
    # the 8 MiB default) and folding it in would misprice the common one.
    var ev_line = _cm_event_json("started", "3f3827cb64803633dfd3dafe4c999c1b", "detach", "false");
    var bea = bench_new("event_log_append");
    bench_batch_start(bea);
    var ea = 0;
    while (ea < 20000) { container_events_append_with(ev_root, ev_line, 0, 0); ea = ea + 1; }
    bench_batch_stop(bea, 20000);
    bench_report(bea);

    var bet = bench_new("event_ts_parse");
    bench_batch_start(bet);
    var et = 0;
    while (et < 200000) { container_event_ts(ev_line); et = et + 1; }
    bench_batch_stop(bet, 200000);
    bench_report(bet);
    _stor_remove_dir_all(ev_root);

    # The gzip layer codec. `_stor_gzip_compress` is what every `import` / every
    # docker-archive `load` pays per layer, and it is on the streaming encoder
    # rather than the batch one (the batch path corrupts anything past 1 MiB —
    # see storage.cyr). The streaming encoder consumes through a 64 KiB sliding
    # window instead of addressing the whole input, so the cost of that
    # correctness fix is exactly what this measures.
    #
    # 2 MiB, sized to cross the batch encoder's 1 MiB block boundary twice.
    # Iteration counts are low because each one moves megabytes; the CSV trend,
    # not the absolute number, is the guard.
    var gz_n = 2097152;
    var gz_src = alloc(gz_n);
    var gzi = 0;
    while (gzi < gz_n) { store8(gz_src + gzi, 65 + (gzi % 26)); gzi = gzi + 1; }
    var gz_cap = gz_n + gz_n / 50 + 8192;
    var gz_buf = alloc(gz_cap);

    var bgz = bench_new("gzip_compress_2mib");
    bench_batch_start(bgz);
    var gc = 0;
    while (gc < 20) { _stor_gzip_compress(gz_src, gz_n, gz_buf, gz_cap); gc = gc + 1; }
    bench_batch_stop(bgz, 20);
    bench_report(bgz);

    # And the inverse, which `unpack_layer` pays on every container start whose
    # layer is not already unpacked.
    var gz_len = _stor_gzip_compress(gz_src, gz_n, gz_buf, gz_cap);
    var gz_out = alloc(gz_n + 65536);
    var bgd = bench_new("gzip_decompress_2mib");
    bench_batch_start(bgd);
    var gd = 0;
    while (gd < 20) { gzip_decompress(gz_buf, gz_len, gz_out, gz_n + 65536); gd = gd + 1; }
    bench_batch_stop(bgd, 20);
    bench_report(bgd);
    # unpack_layer — inflate a gzip layer blob and extract its tar. Paid once
    # per layer on every `pull` and `load`, and until now unbenchmarked, which
    # is awkward for a path that just grew a decompression ceiling: the guard
    # costs a helper call plus two compares per grow-retry iteration, and that
    # has to stay invisible next to the inflate + per-file writes it protects.
    #
    # 20 files of 4 KiB of PSEUDO-RANDOM bytes, not the 'A' filler used above:
    # a compressible fixture would price the memset-fast side of inflate and
    # would also sit near the 1000:1 ratio bound, where the fixture, not the
    # code, decides the result. Real layers are mostly incompressible.
    #
    # Like flatten_layers this is I/O bound (it writes 20 files per iteration),
    # so the absolute number tracks the host filesystem; the CSV trend is the
    # guard. The dest is not cleared between iterations — the second and later
    # passes overwrite, which is what re-pulling an existing layer does.
    var ul_src = "/tmp/stiva_bench_unpack_src";
    var ul_dst = "/tmp/stiva_bench_unpack_dst";
    var ul_tar = "/tmp/stiva_bench_unpack.tar";
    var ul_blob = "/tmp/stiva_bench_unpack.tar.gz";
    _stor_remove_dir_all(ul_src);
    _stor_remove_dir_all(ul_dst);
    sys_mkdir(ul_src, 493);
    var rnd = alloc(4096);
    var rx = 123456789;
    var rz = 0;
    while (rz < 4096) {
        rx = (rx * 1103515245 + 12345) & 2147483647;
        store8(rnd + rz, (rx >> 16) & 255);
        rz = rz + 1;
    }
    var uf = 0;
    while (uf < 20) {
        var usb = str_builder_new();
        str_builder_add_cstr(usb, ul_src);
        str_builder_add_cstr(usb, "/f");
        str_builder_add_int(usb, uf);
        file_write_all(str_cstr(str_builder_build(usb)), rnd, 4096);
        uf = uf + 1;
    }
    create_tar(ul_src, ul_tar);
    var ul_len_cell = alloc(8);
    var ul_tarbuf = _stor_read_file(ul_tar, ul_len_cell);
    var ul_tarlen = load64(ul_len_cell);
    var ul_gzcap = ul_tarlen + ul_tarlen / 50 + 8192;
    var ul_gz = alloc(ul_gzcap);
    # _stor_gzip_compress, not the batch gzip_compress: this fixture is well
    # under 1 MiB so the batch encoder would be correct today, but it corrupts
    # anything past that boundary, and a fixture that grows should not silently
    # start measuring a malformed blob.
    var ul_gzlen = _stor_gzip_compress(ul_tarbuf, ul_tarlen, ul_gz, ul_gzcap);
    file_write_all(ul_blob, ul_gz, ul_gzlen);
    sys_mkdir(ul_dst, 493);
    var bul = bench_new("unpack_layer_gz_20_files_4kib");
    bench_batch_start(bul);
    var ui = 0;
    while (ui < 100) { unpack_layer(ul_blob, ul_dst); ui = ui + 1; }
    bench_batch_stop(bul, 100);
    bench_report(bul);
    _stor_remove_dir_all(ul_src);
    _stor_remove_dir_all(ul_dst);
    sys_unlink(ul_tar);
    sys_unlink(ul_blob);

    # ── §F: one COPY layer, end to end ────────────────────
    # tar collect + assemble + gzip + blob store — the whole per-step cost of a
    # `stiva build`. Measured because the path holds ~3x the context size in
    # heap (collect reads every file, the tar buffer copies them, gzip needs a
    # destination) and there is no free, so a regression here compounds across
    # steps rather than staying flat.
    var bl_root = "/tmp/stiva-bench-buildlayer";
    var bl_ctx = "/tmp/stiva-bench-buildctx";
    _stor_remove_dir_all(bl_root);
    _stor_remove_dir_all(bl_ctx);
    var bl_store = image_store_new(bl_root);
    _stor_mkdir_p(_stor_cat2(bl_ctx, "/payload"));
    var bl_buf = alloc(4096);
    var bx = 987654321;
    var bz = 0;
    while (bz < 4096) {
        bx = (bx * 1103515245 + 12345) & 2147483647;
        store8(bl_buf + bz, (bx >> 16) & 255);
        bz = bz + 1;
    }
    var bf = 0;
    while (bf < 20) {
        var bsb = str_builder_new();
        str_builder_add_cstr(bsb, bl_ctx);
        str_builder_add_cstr(bsb, "/payload/f");
        str_builder_add_int(bsb, bf);
        file_write_all(str_cstr(str_builder_build(bsb)), bl_buf, 4096);
        bf = bf + 1;
    }
    var bbl = bench_new("build_copy_layer_20_files_4kib");
    bench_batch_start(bbl);
    var bi = 0;
    while (bi < 100) {
        var bl_len = alloc(8);
        var bl_diff = alloc(8);
        var bl_gz = build_copy_layer(bl_ctx, "payload", "/payload", bl_len, bl_diff);
        if (bl_gz != 0) { store_layer(bl_store, bl_gz, load64(bl_len)); }
        bi = bi + 1;
    }
    bench_batch_stop(bbl, 100);
    bench_report(bbl);
    _stor_remove_dir_all(bl_ctx);
    _stor_remove_dir_all(bl_root);
    return 0;
}

var r = main();
syscall(60, r);
