    assert_eq(vec_len(hc.command), 3, "hc 3 cmd");
    assert_eq(hc.interval_secs, 10, "interval 10");
    assert_eq(hc.retries, 5, "retries 5");
    return 0;
}

fn test_parse_ansamblu_health_check_defaults() {
    test_group("parse_ansamblu_health_check_defaults");
    var spec = parse_ansamblu("[services.app]\nimage = \"myapp\"\n\n[services.app.health_check]\ncommand = [\"true\"]\n");
    assert(spec != 0, "parses");
    var af: AnsambluFile = spec;
    var app: ServiceDef = map_get(af.services, "app");
    var hc: HealthCheck = app.health_check;
    assert_eq(hc.interval_secs, 30, "interval default 30");
    assert_eq(hc.timeout_secs, 5, "timeout default 5");
    assert_eq(hc.retries, 3, "retries default 3");
    return 0;
}

# Strict-parse parity: malformed input that serde's toml::from_str rejects must
# error (return 0), not be silently accepted. (Adversarial parity-verify pass.)
fn test_parse_ansamblu_strict_errors() {
    test_group("parse_ansamblu_strict_errors");
    # unknown restart value → unknown enum variant → error.
    assert_eq(parse_ansamblu("[services.app]\nimage = \"x\"\nrestart = \"sometimes\"\n"), 0, "unknown restart -> 0");
    # bare "on-failure" → OnFailure is a struct variant (needs a map) → error.
    assert_eq(parse_ansamblu("[services.app]\nimage = \"x\"\nrestart = \"on-failure\"\n"), 0, "bare on-failure -> 0");
    # non-string env value → HashMap<String,String> type error → error.
    assert_eq(parse_ansamblu("[services.app]\nimage = \"x\"\nenv = { PORT = 8090 }\n"), 0, "non-string env -> 0");
    # health_check missing the required command → error.
    assert_eq(parse_ansamblu("[services.app]\nimage = \"x\"\n\n[services.app.health_check]\ninterval_secs = 10\n"), 0, "hc missing command -> 0");
    # orphan health_check (no [services.app] main) → implicit missing image → error.
    assert_eq(parse_ansamblu("[services.web]\nimage = \"nginx\"\n\n[services.app.health_check]\ncommand = [\"true\"]\n"), 0, "orphan health_check -> 0");
    # sanity: the valid forms still parse.
    assert(parse_ansamblu("[services.app]\nimage = \"x\"\nrestart = \"always\"\nenv = { A = \"1\" }\n") != 0, "valid still parses");
    return 0;
}

fn test_agent_build_registration_from_container() {
    test_group("agent_build_registration_from_container");
    var ports = vec_new();
    vec_push(ports, "8080:80");
    var cfg = _agent_test_config(ports);
    var c = _agent_test_container("abc123def456", "web-server",
    "sha256:img", "docker.io/library/nginx:latest",
    CONTAINER_STATE_RUNNING, cfg);

    var reg = build_registration(c);
    var r: AgentRegistration = reg;
    assert_eq(streq(r.id, "abc123def456"), 1, "id");
    assert_eq(streq(r.name, "web-server"), 1, "name");
    assert_eq(streq(r.agent_type, "container"), 1, "agent_type is container");
    assert_eq(_agent_caps_contains(r.capabilities, "stiva"), 1,
    "capabilities contains stiva");
    return 0;
}

fn test_agent_build_registration_no_name() {
    test_group("agent_build_registration_no_name");
    var ports = vec_new();
    var cfg = _agent_test_config(ports);
    # name = 0 (None) → falls back to first 12 chars of id.
    var c = _agent_test_container("abc123def456", 0,
    "sha256:img", "docker.io/library/nginx:latest",
    CONTAINER_STATE_RUNNING, cfg);

    var reg = build_registration(c);
    var r: AgentRegistration = reg;
    assert_eq(streq(r.name, "abc123def456"), 1, "name falls back to first 12 of id");
    return 0;
}

fn test_agent_first12_truncates() {
    test_group("agent_first12_truncates");
    # Long id → exactly 12 chars.
    var got = _agent_first12("0123456789abcdefghij");
    assert_eq(streq(got, "0123456789ab"), 1, "truncated to 12");
    assert_eq(strlen(got), 12, "length 12");
    # Short id (< 12) → whole string preserved.
    var got2 = _agent_first12("short");
    assert_eq(streq(got2, "short"), 1, "short id preserved");
    return 0;
}

fn test_agent_registration_serde() {
    test_group("agent_registration_serde");
    # rust-old round-trips through JSON; Cyrius base has no serde, so verify
    # the struct stores/returns its fields faithfully (parity on the payload).
    var caps = vec_new();
    vec_push(caps, "stiva");
    var rp = alloc(40);
    var reg: AgentRegistration = rp;
    reg.id = "c1";
    reg.name = "web";
    reg.agent_type = "container";
    reg.capabilities = caps;
    reg.metadata = 0;
    assert_eq(streq(reg.id, "c1"), 1, "id round-trips");
    assert_eq(streq(reg.name, "web"), 1, "name round-trips");
    return 0;
}

fn test_agent_status_serde() {
    test_group("agent_status_serde");
    var s = agent_status_new("c1", "running", 0);
    var st: AgentStatus = s;
    assert_eq(streq(st.id, "c1"), 1, "id");
    assert_eq(streq(st.status, "running"), 1, "status round-trips");
    assert_eq(st.metadata, 0, "metadata none");
    return 0;
}

fn test_agent_default_registry_url() {
    test_group("agent_default_registry_url");
    assert_eq(streq(agent_default_registry_url(), "http://localhost:8090"), 1,
    "default registry url");
    return 0;
}

fn test_fleet_strategy_names() {
    test_group("fleet_strategy_names");
    assert_eq(streq(fleet_strategy_name(FLEET_STRATEGY_SPREAD), "Spread"), 1, "spread");
    assert_eq(streq(fleet_strategy_name(FLEET_STRATEGY_BINPACK), "BinPack"), 1, "binpack");
    assert_eq(streq(fleet_strategy_name(FLEET_STRATEGY_PINNED), "Pinned"), 1, "pinned");
    assert_eq(fleet_strategy_default(), FLEET_STRATEGY_SPREAD, "default spread");
    return 0;
}

fn test_fleet_node_status_names() {
    test_group("fleet_node_status_names");
    assert_eq(streq(fleet_node_status_name(FLEET_NODE_READY), "Ready"), 1, "ready");
    assert_eq(streq(fleet_node_status_name(FLEET_NODE_NOT_READY), "NotReady"), 1, "notready");
    assert_eq(streq(fleet_node_status_name(FLEET_NODE_DRAINING), "Draining"), 1, "draining");
    assert_eq(streq(fleet_node_status_name(FLEET_NODE_CORDONED), "Cordoned"), 1, "cordoned");
    return 0;
}

fn test_fleet_constraints_default() {
    test_group("fleet_constraints_default");
    var c = deployment_constraints_default();
    var cc: DeploymentConstraints = c;
    assert_eq(cc.node_labels, 0, "no labels");
    assert_eq(cc.min_memory_mb, 0 - 1, "no min mem");
    assert_eq(cc.min_cpus, 0 - 1, "no min cpus");
    assert_eq(cc.preferred_nodes, 0, "no preferred");
    return 0;
}

fn test_fleet_free_slots() {
    test_group("fleet_free_slots");
    var cap = fleet_node_capacity_new(4096, 4, 10, 3);
    var node = fleet_node_new("n1", "1.2.3.4", 0, cap, FLEET_NODE_READY, 0);
    assert_eq(free_slots(node), 7, "10-3=7");
    var cap2 = fleet_node_capacity_new(4096, 4, 5, 8);
    var node2 = fleet_node_new("n2", "1.2.3.5", 0, cap2, FLEET_NODE_READY, 0);
    assert_eq(free_slots(node2), 0, "over -> 0");
    return 0;
}

# ── agent test helpers (moved with their tests) ──
fn _agent_test_config(ports) {
    var cfg = alloc(200);
    memset(cfg, 0, 200);
    store64(cfg + 32, ports);      # ports @ field index 4
    return cfg;
}

fn _agent_test_container(id, name, image_id, image_ref, state, config) {
    var c = alloc(80);
    memset(c, 0, 80);
    store64(c + 0, id);
    store64(c + 8, name);
    store64(c + 16, image_id);
    store64(c + 24, image_ref);
    store64(c + 32, state);
    store64(c + 64, config);
    return c;
}

fn _agent_caps_contains(v, needle) {
    var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        if (streq(vec_get(v, i), needle) == 1) { return 1; }
    }
    return 0;
}

