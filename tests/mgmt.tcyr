fn test_parse_ansamblu_minimal() {
    test_group("parse_ansamblu_minimal");
    var spec = parse_ansamblu("[services.app]\nimage = \"alpine\"\n");
    assert(spec != 0, "parses");
    var af: AnsambluFile = spec;
    assert_eq(map_size(af.services), 1, "1 service");
    var app: ServiceDef = map_get(af.services, "app");
    assert_eq(vec_len(app.command), 0, "command empty");
    assert_eq(vec_len(app.depends_on), 0, "depends_on empty");
    assert_eq(map_size(af.networks), 0, "networks empty");
    assert_eq(map_size(af.volumes), 0, "volumes empty");
    return 0;
}

