fn test_parse_ansamblu_with_health_check() {
    test_group("parse_ansamblu_with_health_check");
    var spec = parse_ansamblu("[services.app]\nimage = \"myapp\"\n\n[services.app.health_check]\ncommand = [\"curl\", \"-f\", \"http://localhost/health\"]\ninterval_secs = 10\ntimeout_secs = 3\nretries = 5\n");
    assert(spec != 0, "parses");
    var af: AnsambluFile = spec;
    var app: ServiceDef = map_get(af.services, "app");
