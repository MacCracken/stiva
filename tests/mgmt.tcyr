fn test_parse_ansamblu_dependency_chain() {
    test_group("parse_ansamblu_dependency_chain");
    var spec = parse_ansamblu("[services.frontend]\nimage = \"nginx\"\ndepends_on = [\"api\"]\n\n[services.api]\nimage = \"app:latest\"\ndepends_on = [\"db\", \"cache\"]\n\n[services.db]\nimage = \"postgres:16\"\n\n[services.cache]\nimage = \"redis:7\"\n");
    assert(spec != 0, "parses");
    var af: AnsambluFile = spec;
    assert_eq(map_size(af.services), 4, "4 services");
    var fe: ServiceDef = map_get(af.services, "frontend");
    assert_eq(vec_len(fe.depends_on), 1, "frontend 1 dep");
    assert_eq(streq(vec_get(fe.depends_on, 0), "api"), 1, "frontend depends api");
    return 0;
}

fn test_parse_ansamblu_all_fields() {
    test_group("parse_ansamblu_all_fields");
    var spec = parse_ansamblu("[services.app]\nimage = \"myapp:latest\"\ncommand = [\"/start.sh\"]\nenv = { PORT = \"8080\", DEBUG = \"true\" }\nports = [\"8080:80\", \"443:443\"]\nvolumes = [\"/data:/app/data:ro\"]\ndepends_on = [\"db\"]\nreplicas = 2\n");
    assert(spec != 0, "parses");
    var af: AnsambluFile = spec;
    var app: ServiceDef = map_get(af.services, "app");
    assert_eq(streq(app.image, "myapp:latest"), 1, "image");
    assert_eq(app.replicas, 2, "replicas 2");
    assert_eq(streq(map_get(app.env, "PORT"), "8080"), 1, "env PORT");
    assert_eq(streq(map_get(app.env, "DEBUG"), "true"), 1, "env DEBUG");
    assert_eq(vec_len(app.ports), 2, "2 ports");
    return 0;
}

