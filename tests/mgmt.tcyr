fn test_fleet_free_slots() {
    test_group("fleet_free_slots");
    var cap = fleet_node_capacity_new(4096, 4, 10, 3);
    var node = fleet_node_new("n1", "1.2.3.4", 0, cap, FLEET_NODE_READY, 0);
    assert_eq(free_slots(node), 7, "10-3=7");
    var cap2 = fleet_node_capacity_new(4096, 4, 5, 8);
    var node2 = fleet_node_new("n2", "1.2.3.5", 0, cap2, FLEET_NODE_READY, 0);
    assert_eq(free_slots(node2), 0, "over -> 0");
    return 0;
}

# ── agent test helpers (moved with their tests) ──
fn _agent_test_config(ports) {
    var cfg = alloc(200);
    memset(cfg, 0, 200);
    store64(cfg + 32, ports);      # ports @ field index 4
    return cfg;
}

fn _agent_test_container(id, name, image_id, image_ref, state, config) {
    var c = alloc(80);
    memset(c, 0, 80);
    store64(c + 0, id);
    store64(c + 8, name);
    store64(c + 16, image_id);
    store64(c + 24, image_ref);
    store64(c + 32, state);
    store64(c + 64, config);
    return c;
}

fn _agent_caps_contains(v, needle) {
    var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        if (streq(vec_get(v, i), needle) == 1) { return 1; }
    }
    return 0;
}

