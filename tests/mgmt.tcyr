    test_group("parse_ansamblu_service_with_command");
    var spec = parse_ansamblu("[services.app]\nimage = \"alpine\"\ncommand = [\"/bin/sh\", \"-c\", \"echo hello\"]\n");
    assert(spec != 0, "parses");
