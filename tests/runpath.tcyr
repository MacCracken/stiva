# ── generate_spec (rust-old runtime.rs:172) ──
fn _rt_make_container(cfg) {
    return container_new("cid", 0, "img", "ref", CONTAINER_STATE_CREATED, 0 - 1, 0, 0 - 1, cfg, 0 - 1);
}

fn test_generate_spec_defaults() {
    test_group("generate_spec_defaults");
    var cfg = container_config_default();
    var ctr = _rt_make_container(cfg);
    var sp: RuntimeSpec = generate_spec(ctr, "/var/lib/stiva/rootfs");
    assert(sp != 0, "spec built");
    assert_eq(streq(sp.rootfs, "/var/lib/stiva/rootfs"), 1, "rootfs passthrough");
    # empty command → ["/bin/sh"]
    assert_eq(vec_len(sp.command), 1, "command len 1");
    assert_eq(streq(vec_get(sp.command, 0), "/bin/sh"), 1, "command /bin/sh");
    # empty workdir → "/"
    assert_eq(streq(sp.workdir, "/"), 1, "workdir /");
    # 5 base namespaces, PID first, no USER when not rootless
    assert_eq(vec_len(sp.namespaces), 5, "5 namespaces");
    assert_eq(vec_get(sp.namespaces, 0), RUNTIME_NS_PID, "ns[0] Pid");
    # standard mounts only (no volumes)
    assert_eq(vec_len(sp.mounts), 5, "5 standard mounts");
    # sentinels/pass-through
    assert_eq(sp.min_isolation_score, 0 - 1, "min_isolation_score None");
    assert_eq(sp.read_only_rootfs, 0, "read_only_rootfs false");
    assert_eq(sp.io_max_bytes_per_sec, 0, "io unset");
    return 0;
}

fn test_generate_spec_rootless() {
    test_group("generate_spec_rootless");
    var cfg: ContainerConfig = container_config_default();
    cfg.rootless = 1;
    var sp: RuntimeSpec = generate_spec(_rt_make_container(cfg), "/rootfs");
    assert_eq(vec_len(sp.namespaces), 6, "6 namespaces (User appended)");
    assert_eq(vec_get(sp.namespaces, 5), RUNTIME_NS_USER, "ns[5] User");
    assert_eq(sp.rootless, 1, "rootless passthrough");
    return 0;
}

fn test_generate_spec_env_kv() {
    test_group("generate_spec_env_kv");
    var cfg: ContainerConfig = container_config_default();
    # env map MUST be map_new (cstr keys) — generate_spec iterates map_keys/map_get.
    var m = map_new();
    map_set(m, "PATH", "/usr/bin");
    cfg.env = m;
    var sp: RuntimeSpec = generate_spec(_rt_make_container(cfg), "/rootfs");
    assert_eq(vec_len(sp.env), 1, "one env entry");
    assert_eq(streq(vec_get(sp.env, 0), "PATH=/usr/bin"), 1, "env k=v folded");
    return 0;
}

fn test_generate_spec_bad_volume() {
    test_group("generate_spec_bad_volume");
    var cfg: ContainerConfig = container_config_default();
    var vols = vec_new();
    vec_push(vols, "nocolon");   # invalid → volume_mounts returns 0
    cfg.volumes = vols;
    assert_eq(generate_spec(_rt_make_container(cfg), "/rootfs"), 0, "invalid volume -> 0");
    return 0;
}

# ── send_signal (rust-old runtime.rs:996) ──
fn test_send_signal_bad_signal() {
    test_group("send_signal_bad_signal");
    # signal out of the named range → STIVA_ERR_RUNTIME sentinel (non-OK).
    assert_eq(send_signal(1234, 999), STIVA_ERR_RUNTIME, "signal 999 -> runtime err");
    assert_eq(send_signal(1234, 0), STIVA_ERR_RUNTIME, "signal 0 -> runtime err");
    return 0;
}

fn test_send_signal_bad_pid() {
    test_group("send_signal_bad_pid");
    assert_eq(send_signal(0, 15), STIVA_ERR_RUNTIME, "pid 0 -> runtime err");
    return 0;
}

fn test_send_signal_self_signal0_range() {
    test_group("send_signal_self_signal0_range");
    # Deliver SIGCONT (18) to our own process — harmless, must succeed.
    assert_eq(send_signal(getpid(), 18), STIVA_ERR_OK, "SIGCONT self -> OK");
    return 0;
}

# ── cgroup base parsing (rust-old runtime.rs:1038) ──
fn test_resolve_cgroup_base_parse() {
    test_group("resolve_cgroup_base_parse");
    var base = _rt_cgroup_base_from_content("0::/foo/bar\n");
    assert_eq(streq(base, "/sys/fs/cgroup/foo/bar"), 1, "0:: line -> base path");
    # trailing whitespace trimmed
    var base2 = _rt_cgroup_base_from_content("12:pids:/legacy\n0::/svc  \n");
    assert_eq(streq(base2, "/sys/fs/cgroup/svc"), 1, "picks 0:: line, trims");
    # no 0:: unified line -> 0
    assert_eq(_rt_cgroup_base_from_content("1:name=systemd:/x\n"), 0, "no v2 entry -> 0");
    return 0;
}

fn test_cpu_quota_formula() {
    test_group("cpu_quota_formula");
    # shares * 100000 / 1024
    assert_eq(_rt_cpu_quota(1024), 100000, "1024 shares -> 1 core quota");
    assert_eq(_rt_cpu_quota(512), 50000, "512 shares -> half core");
    return 0;
}

fn test_apply_cgroup_limits_besteffort() {
    test_group("apply_cgroup_limits_besteffort");
    # No real writable cgroup in the harness — must NOT crash and must return 0
    # (best-effort: write failures are swallowed).
    var cfg: ContainerConfig = container_config_default();
    cfg.memory_limit = 134217728;
    cfg.cpu_shares = 512;
    cfg.max_pids = 100;
    var sp = generate_spec(_rt_make_container(cfg), "/rootfs");
    assert_eq(apply_cgroup_limits(getpid(), sp), 0, "best-effort returns 0");
    return 0;
}

# ── build_sandbox (rust-old runtime.rs:276) — kavach, synchronous ──
fn test_build_sandbox_noop() {
    test_group("build_sandbox_noop");
    kavach_init();   # register backends (idempotent alloc_init)
    var cfg: ContainerConfig = container_config_default();
    cfg.backend = "noop";
    var sp = generate_spec(_rt_make_container(cfg), "/rootfs");
    var sb = build_sandbox(sp);
    assert(sb != 0, "sandbox created");
    assert_eq(Sandbox_state(sb), SandboxState.RUNNING, "state RUNNING");
    return 0;
}

fn test_build_sandbox_bad_backend() {
    test_group("build_sandbox_bad_backend");
    kavach_init();
    var cfg: ContainerConfig = container_config_default();
    cfg.backend = "bogus";
    var sp = generate_spec(_rt_make_container(cfg), "/rootfs");
    assert_eq(build_sandbox(sp), 0, "unknown backend -> 0");
    return 0;
}

fn test_build_sandbox_fallback() {
    test_group("build_sandbox_fallback");
    kavach_init();
    # backend None, min_isolation_score None → OCI-if-available else PROCESS.
    var cfg: ContainerConfig = container_config_default();
    var sp = generate_spec(_rt_make_container(cfg), "/rootfs");
    var sb = build_sandbox(sp);
    assert(sb != 0, "fallback sandbox created");
    var cfgp = load64(sb + 8);   # Sandbox.config @ offset 8
    var bk = SandboxConfig_backend(cfgp);
    # host-dependent: OCI(4) iff runc/crun on PATH, else PROCESS(0).
    var ok = 0;
    if (bk == Backend.OCI || bk == Backend.PROCESS) { ok = 1; }
    assert_eq(ok, 1, "fallback backend is OCI or PROCESS");
    return 0;
}

fn test_build_sandbox_min_score_none() {
    test_group("build_sandbox_min_score_none");
    kavach_init();
    var cfg: ContainerConfig = container_config_default();
    cfg.min_isolation_score = 101;   # unreachable (scores clamp to 100)
    var sp = generate_spec(_rt_make_container(cfg), "/rootfs");
    assert_eq(build_sandbox(sp), 0, "no backend meets score 101 -> 0");
    return 0;
}

# ── exec_container (rust-old runtime.rs:365) — full generate→build→exec→map ──
fn test_exec_container_noop() {
    test_group("exec_container_noop");
    kavach_init();
    var cfg: ContainerConfig = container_config_default();
    cfg.backend = "noop";
    var cmd = vec_new();
    vec_push(cmd, "echo");
    vec_push(cmd, "hi");           # benign — the ext gate runs even on NOOP
    cfg.command = cmd;
    var sp = generate_spec(_rt_make_container(cfg), "/rootfs");
    var res: ContainerExecResult = exec_container(sp);
    assert(res != 0, "exec result built");
    assert_eq(res.exit_code, 0, "noop exit_code 0");
    assert_eq(res.timed_out, 0, "not timed out");
    return 0;
}

fn test_exec_container_bad_backend() {
    test_group("exec_container_bad_backend");
    kavach_init();
    var cfg: ContainerConfig = container_config_default();
    cfg.backend = "bogus";
    var sp = generate_spec(_rt_make_container(cfg), "/rootfs");
    assert_eq(exec_container(sp), 0, "build failure propagates -> 0");
    return 0;
}

# ── security_score (rust-old runtime.rs:615) — score_backend passthrough ──
fn test_security_score() {
    test_group("security_score");
    kavach_init();
    var s = security_score();
    var ok = 0;
    if (s >= 0 && s <= 100) { ok = 1; }
    assert_eq(ok, 1, "auto-backend score in 0..100");
    return 0;
}

fn test_security_score_for() {
    test_group("security_score_for");
    kavach_init();
    var s = security_score_for(Backend.PROCESS, policy_basic());
    var ok = 0;
    if (s >= 0 && s <= 100) { ok = 1; }
    assert_eq(ok, 1, "explicit score in 0..100");
    return 0;
}

# ── sakshi logging actually emits (not just compiles) ──
fn test_runpath_logging_emits() {
    test_group("runpath_logging_emits");
    kavach_init();
    sakshi_output_buffer();      # route emits to the in-memory ring
    sakshi_set_level(SK_INFO);
    sakshi_ring_clear();
    var before = sakshi_ring_event_count();
    send_signal(0, 15);          # emits an info line at entry (then errors on bad pid)
    assert(sakshi_ring_event_count() > before, "send_signal emitted a log line");
    # level filter: at SK_WARN an info emit is suppressed.
    sakshi_set_level(SK_WARN);
    sakshi_ring_clear();
    var b2 = sakshi_ring_event_count();
    security_score();            # info-level → suppressed at WARN
    assert_eq(sakshi_ring_event_count(), b2, "info suppressed at WARN");
    sakshi_set_level(SK_INFO);
    return 0;
}

# ── image-test helpers (moved with their tests) ──
fn _img_ck_ref(input, exp_reg, exp_repo, exp_tag) {
    var r = image_ref_parse(input);
    assert_eq(r != 0, 1, input);
    var rr: ImageRef = r;
    assert_eq(streq(rr.registry, exp_reg), 1, input);
    assert_eq(streq(rr.repository, exp_repo), 1, input);
    assert_eq(streq(rr.tag, exp_tag), 1, input);
    return 0;
}

fn _test_img_make(id, ref_str, size, layer_digest, layer_size) {
    var reference = image_ref_parse(ref_str);
    var layers = vec_new();
    vec_push(layers, layer_new(layer_digest, layer_size,
    "application/vnd.oci.image.layer.v1.tar+gzip"));
    return image_new(id, reference, size, layers, 1700000000);
}

# ── moved from stiva.tcyr (image ref/digest/blob/index) — cycc identifier cap ──
fn test_image_ref_parse() {
    test_group("image_ref_parse");
    _img_ck_ref("nginx", "docker.io", "library/nginx", "latest");
    _img_ck_ref("nginx:1.25", "docker.io", "library/nginx", "1.25");
    _img_ck_ref("ghcr.io/maccracken/agnosticos:latest", "ghcr.io", "maccracken/agnosticos", "latest");
    _img_ck_ref("pytorch/pytorch:2.0", "docker.io", "pytorch/pytorch", "2.0");
    _img_ck_ref("localhost:5000/myimage:v1", "localhost:5000", "myimage", "v1");
    _img_ck_ref("localhost:5000/myimage", "localhost:5000", "myimage", "latest");
    _img_ck_ref("ghcr.io/org/sub/repo:v2", "ghcr.io", "org/sub/repo", "v2");
    _img_ck_ref("myregistry.io:8443/org/team/app:prod", "myregistry.io:8443", "org/team/app", "prod");
    _img_ck_ref("  nginx:latest  ", "docker.io", "library/nginx", "latest");
    assert_eq(image_ref_parse(""), 0, "empty ref null");
    assert_eq(image_ref_parse("   "), 0, "whitespace ref null");
    return 0;
}

fn test_image_ref_digest() {
    test_group("image_ref_digest");
    var r = image_ref_parse("nginx@sha256:abcdef1234567890");
    var rr: ImageRef = r;
    assert_eq(streq(rr.repository, "library/nginx"), 1, "digest repo");
    assert_eq(streq(rr.tag, "latest"), 1, "digest tag latest");
    assert_eq(streq(rr.digest, "sha256:abcdef1234567890"), 1, "digest value");
    var r2 = image_ref_parse("nginx:1.25@sha256:abc123");
    var rr2: ImageRef = r2;
    assert_eq(streq(rr2.tag, "1.25"), 1, "tagged-digest tag");
    assert_eq(streq(rr2.digest, "sha256:abc123"), 1, "tagged-digest digest");
    var r3 = image_ref_parse("ghcr.io/user/repo:v1@sha256:deadbeef");
    var rr3: ImageRef = r3;
    assert_eq(streq(rr3.registry, "ghcr.io"), 1, "fulldigest reg");
    assert_eq(streq(rr3.repository, "user/repo"), 1, "fulldigest repo");
    assert_eq(streq(rr3.tag, "v1"), 1, "fulldigest tag");
    assert_eq(streq(rr3.digest, "sha256:deadbeef"), 1, "fulldigest digest");
    return 0;
}

fn test_image_full_ref() {
    test_group("image_full_ref");
    var r = image_ref_parse("ghcr.io/user/repo:v1");
    assert_eq(streq(image_ref_full_ref(r), "ghcr.io/user/repo:v1"), 1, "full_ref exact");
    var r2 = image_ref_parse("alpine");
    assert_eq(streq(image_ref_full_ref(r2), "docker.io/library/alpine:latest"), 1, "full_ref default tag");
    return 0;
}

fn test_image_digest_helpers() {
    test_group("image_digest_helpers");
    var d1 = sha256_digest("test", 4);
    var d2 = sha256_digest("test", 4);
    assert_eq(streq(d1, d2), 1, "sha256 deterministic");
    assert_eq(memeq(d1, "sha256:", 7), 1, "sha256 prefix");
    assert_eq(strlen(d1), 71, "sha256 len 7+64");
    assert_eq(streq(digest_hex("sha256:abcdef"), "abcdef"), 1, "digest_hex strips prefix");
    assert_eq(streq(digest_hex("abcdef"), "abcdef"), 1, "digest_hex passthrough");
    return 0;
}

fn test_image_blob_store() {
    test_group("image_blob_store");
    var root = "/tmp/stiva_img_test_store";
    var store = image_store_new(root);
    assert_eq(file_exists("/tmp/stiva_img_test_store/blobs/sha256"), 1, "blobs dir created");
    assert_eq(file_exists("/tmp/stiva_img_test_store/manifests"), 1, "manifests dir created");
    assert_eq(file_exists("/tmp/stiva_img_test_store/layers"), 1, "layers dir created");
    var data = "hello world";
    var digest = sha256_digest(data, 11);
    # Idempotent: clear any blob left in the fixed /tmp store by a prior run
    # (the Rust test used a fresh tempdir; this port uses a stable path).
    xunlink(_img_blob_path(root, digest));
    assert_eq(image_store_has_blob(store, digest), 0, "blob absent before store");
    var path = image_store_store_blob(store, digest, data, 11);
    assert_eq(path != 0, 1, "store_blob ok");
    assert_eq(file_exists(path), 1, "blob file on disk");
    assert_eq(image_store_has_blob(store, digest), 1, "blob present after store");
    var buf = alloc(64);
    var n = image_store_read_blob(store, digest, buf, 64);
    assert_eq(n, 11, "read_blob byte count");
    assert_eq(memeq(buf, "hello world", 11), 1, "read_blob content");
    var path2 = image_store_store_blob(store, digest, data, 11);
    assert_eq(path2 != 0, 1, "store_blob dedup ok");
    var wrong = "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff";
    assert_eq(image_store_store_blob(store, wrong, "actual data", 11), 0, "digest mismatch rejected");
    var absent = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    assert_eq(image_store_read_blob(store, absent, buf, 64), 0 - 1, "absent read -1");
    return 0;
}

fn test_image_index_round_trip() {
    test_group("image_index_round_trip");
    var root = "/tmp/stiva_img_idx_rt";
    xunlink("/tmp/stiva_img_idx_rt/images.json");
    var store = image_store_new(root);
    assert_eq(store != 0, 1, "store created");

    # Empty index → empty list (rust-old: Ok(vec![])).
    assert_eq(vec_len(image_store_list(store)), 0, "empty index lists nothing");

    var img = _test_img_make("sha256:config123", "alpine:3.19", 4096,
    "sha256:layer1", 4096);
    assert_eq(image_store_add_to_index(store, img), 1, "add_to_index ok");

    var listed = image_store_list(store);
    assert_eq(vec_len(listed), 1, "one image listed");
    var got: Image = vec_get(listed, 0);
    assert_eq(streq(got.id, "sha256:config123"), 1, "id round-trips");
    assert_eq(got.size_bytes, 4096, "size_bytes round-trips");
    assert_eq(vec_len(got.layers), 1, "one layer round-trips");
    var gl: Layer = vec_get(got.layers, 0);
    assert_eq(streq(gl.digest, "sha256:layer1"), 1, "layer digest round-trips");
    assert_eq(gl.size_bytes, 4096, "layer size round-trips");
    assert_eq(got.created_at, 1700000000, "created_at round-trips");
    # reference nested object round-trips.
    var gref: ImageRef = got.reference;
    assert_eq(streq(gref.registry, "docker.io"), 1, "ref registry round-trips");
    assert_eq(streq(gref.repository, "library/alpine"), 1, "ref repo round-trips");
    assert_eq(streq(gref.tag, "3.19"), 1, "ref tag round-trips");
    assert_eq(gref.digest, 0, "ref digest None round-trips as null");
    return 0;
}

fn test_image_index_dedup_on_re_add() {
    test_group("image_index_dedup_on_re_add");
    var root = "/tmp/stiva_img_idx_dedup";
    xunlink("/tmp/stiva_img_idx_dedup/images.json");
    var store = image_store_new(root);

    var img1 = _test_img_make("sha256:v1", "app:latest", 100,
    "sha256:l1", 100);
    var img2 = _test_img_make("sha256:v2", "app:latest", 200,
    "sha256:l2", 200);
    image_store_add_to_index(store, img1);
    image_store_add_to_index(store, img2);

    # Same reference "app:latest" → replaced, not duplicated.
    var listed = image_store_list(store);
    assert_eq(vec_len(listed), 1, "same reference replaced");
    var got: Image = vec_get(listed, 0);
    assert_eq(streq(got.id, "sha256:v2"), 1, "newest id kept");
    return 0;
}

fn test_image_index_multiple() {
    test_group("image_index_multiple");
    var root = "/tmp/stiva_img_idx_multi";
    xunlink("/tmp/stiva_img_idx_multi/images.json");
    var store = image_store_new(root);

    image_store_add_to_index(store, _test_img_make("sha256:a", "app:v0", 1, "sha256:la", 1));
    image_store_add_to_index(store, _test_img_make("sha256:b", "app:v1", 1, "sha256:lb", 1));
    image_store_add_to_index(store, _test_img_make("sha256:c", "app:v2", 1, "sha256:lc", 1));

    assert_eq(vec_len(image_store_list(store)), 3, "three distinct references");
    return 0;
}

fn test_image_index_remove() {
    test_group("image_index_remove");
    var root = "/tmp/stiva_img_idx_rm";
    xunlink("/tmp/stiva_img_idx_rm/images.json");
    var store = image_store_new(root);

    # A real blob backing the image, so remove's cleanup can unlink it.
    var data = "layer data";
    var digest = sha256_digest(data, 10);
    xunlink(_img_blob_path(root, digest));
    image_store_store_blob(store, digest, data, 10);
    assert_eq(image_store_has_blob(store, digest), 1, "blob present before remove");

    var reference = image_ref_parse("nginx:latest");
    var layers = vec_new();
    vec_push(layers, layer_new(digest, 10,
    "application/vnd.oci.image.layer.v1.tar+gzip"));
    var img = image_new("sha256:configrm", reference, 10, layers, 1700000000);
    image_store_add_to_index(store, img);
    assert_eq(vec_len(image_store_list(store)), 1, "one image before remove");

    assert_eq(image_store_remove(store, "sha256:configrm"), 1, "remove ok");
    assert_eq(vec_len(image_store_list(store)), 0, "index empty after remove");
    # Unreferenced blob cleaned up (rust-old: read_dir + remove_file walk).
    assert_eq(image_store_has_blob(store, digest), 0, "unreferenced blob deleted");
    return 0;
}

fn test_image_index_remove_missing() {
    test_group("image_index_remove_missing");
    var root = "/tmp/stiva_img_idx_rmmiss";
    xunlink("/tmp/stiva_img_idx_rmmiss/images.json");
    var store = image_store_new(root);
    # rust-old: Err(ImageNotFound) → sentinel -1 here.
    assert_eq(image_store_remove(store, "sha256:doesnotexist"), 0 - 1,
    "remove nonexistent -> -1");
    return 0;
}

fn test_image_index_remove_shared_blob() {
    test_group("image_index_remove_shared_blob");
    var root = "/tmp/stiva_img_idx_shared";
    xunlink("/tmp/stiva_img_idx_shared/images.json");
    var store = image_store_new(root);

    var data = "shared layer";
    var digest = sha256_digest(data, 12);
    xunlink(_img_blob_path(root, digest));
    image_store_store_blob(store, digest, data, 12);

    var ref1 = image_ref_parse("app:v1");
    var lv1 = vec_new();
    vec_push(lv1, layer_new(digest, 12, "application/vnd.oci.image.layer.v1.tar+gzip"));
    image_store_add_to_index(store, image_new("sha256:img1", ref1, 12, lv1, 1700000000));

    var ref2 = image_ref_parse("app:v2");
    var lv2 = vec_new();
    vec_push(lv2, layer_new(digest, 12, "application/vnd.oci.image.layer.v1.tar+gzip"));
    image_store_add_to_index(store, image_new("sha256:img2", ref2, 12, lv2, 1700000000));

    # Remove img1 — shared blob survives (img2 still references it).
    assert_eq(image_store_remove(store, "sha256:img1"), 1, "remove img1 ok");
    assert_eq(image_store_has_blob(store, digest), 1, "shared blob survives");

    # Remove img2 — now unreferenced → cleaned up.
    assert_eq(image_store_remove(store, "sha256:img2"), 1, "remove img2 ok");
    assert_eq(image_store_has_blob(store, digest), 0, "blob cleaned when unreferenced");
    return 0;
}

# ── container state serde + persistence (rust-old state.json round-trip) ──
fn test_container_serde_roundtrip() {
    test_group("container_serde_roundtrip");
    var cfg: ContainerConfig = container_config_default();
    var cmd = vec_new(); vec_push(cmd, "echo"); vec_push(cmd, "hi"); cfg.command = cmd;
    cfg.memory_limit = 12345; cfg.workdir = "/app"; cfg.backend = "noop";
    var env = map_new(); map_set(env, "K", "V"); cfg.env = env;
    var ctr = container_new("id1", "myname", "img1", "docker.io/x:1", CONTAINER_STATE_RUNNING, 42, 100, 200, cfg, 7);
    var s = json_v_build_pretty(container_to_jv(ctr), 2);
    var back = container_from_jv(bayan_json_v_parse_str(str_data(s), str_len(s)));
    assert(back != 0, "parsed back");
    var bc: Container = back;
    assert_eq(streq(bc.id, "id1"), 1, "id");
    assert_eq(streq(bc.name, "myname"), 1, "name");
    assert_eq(streq(bc.image_ref, "docker.io/x:1"), 1, "image_ref");
    assert_eq(bc.state, CONTAINER_STATE_RUNNING, "state preserved by from_jv");
    assert_eq(bc.pid, 42, "pid");
    assert_eq(bc.exit_status, 7, "exit_code");
    var bcfg: ContainerConfig = bc.config;
    assert_eq(bcfg.memory_limit, 12345, "config.memory_limit");
    assert_eq(streq(bcfg.workdir, "/app"), 1, "config.workdir");
    assert_eq(streq(bcfg.backend, "noop"), 1, "config.backend");
    assert_eq(vec_len(bcfg.command), 2, "config.command len");
    assert_eq(streq(vec_get(bcfg.command, 0), "echo"), 1, "config.command[0]");
    assert_eq(streq(map_get(bcfg.env, "K"), "V"), 1, "config.env round-trip");
    return 0;
}

fn test_container_serde_nulls() {
    test_group("container_serde_nulls");
    # name/pid/started_at/exit_code None → JSON null → parse back to 0 / -1.
    var ctr = container_new("id2", 0, "img", "ref:2", CONTAINER_STATE_CREATED, 0 - 1, 5, 0 - 1, container_config_default(), 0 - 1);
    var s = json_v_build_pretty(container_to_jv(ctr), 2);
    var bc: Container = container_from_jv(bayan_json_v_parse_str(str_data(s), str_len(s)));
    assert_eq(bc.name, 0, "name None");
    assert_eq(bc.pid, 0 - 1, "pid None");
    assert_eq(bc.started_at, 0 - 1, "started_at None");
    assert_eq(bc.exit_status, 0 - 1, "exit_code None");
    return 0;
}

fn test_container_state_save_load() {
    test_group("container_state_save_load");
    var root = _rt_cat2("/tmp/stiva-st-", _rt_int_to_cstr(getpid()));
    sys_mkdir(root, 493);
    var c1 = container_new("aaa", 0, "img", "ref:1", CONTAINER_STATE_STOPPED, 0 - 1, 10, 0 - 1, container_config_default(), 0);
    var c2 = container_new("bbb", "web", "img2", "ref:2", CONTAINER_STATE_RUNNING, 99, 20, 21, container_config_default(), 0 - 1);
    var cs = vec_new(); vec_push(cs, c1); vec_push(cs, c2);
    assert_eq(container_state_save(root, cs), 1, "saved");

    var loaded = container_state_load(root);
    assert_eq(vec_len(loaded), 2, "2 loaded");
    var f = container_state_find(loaded, "bbb");
    assert(f != 0, "found bbb by id");
    var fc: Container = f;
    # restart fixup: RUNNING → STOPPED, pid → -1.
    assert_eq(fc.state, CONTAINER_STATE_STOPPED, "running fixed to stopped");
    assert_eq(fc.pid, 0 - 1, "pid cleared");
    assert(container_state_find(loaded, "web") != 0, "found by name");
    assert_eq(container_state_find(loaded, "zzz"), 0, "missing -> 0");
    return 0;
}

fn test_container_state_load_missing() {
    test_group("container_state_load_missing");
    # No state.json → fresh empty vec (rust-old Ok(HashMap::new())).
    assert_eq(vec_len(container_state_load("/tmp/stiva-nonexistent-root-xyz")), 0, "missing -> empty");
    return 0;
}

# ── image_ref_new + tag (rust-old lib.rs tag) ──
fn test_image_ref_new() {
    test_group("image_ref_new");
    var r = image_ref_new("local", "demo", "v1", 0);
    assert_eq(streq(image_ref_full_ref(r), "local/demo:v1"), 1, "full_ref local/demo:v1");
    return 0;
}

fn test_image_store_tag() {
    test_group("image_store_tag");
    var root = _rt_cat2("/tmp/stiva-tag-", _rt_int_to_cstr(getpid()));
    sys_mkdir(root, 493);
    var store = image_store_new(root);
    var img = image_new("sha256:abc", image_ref_new("local", "src", "1", 0), 10, vec_new(), 0);
    image_store_add_to_index(store, img);
    assert_eq(image_store_tag(store, "sha256:abc", "dest:2"), 1, "tag by id ok");
    assert_eq(image_store_tag(store, "sha256:missing", "x:1"), 0, "tag missing -> 0");
    # src:1 + the new dest:2 alias → 2 entries.
    assert_eq(vec_len(image_store_load_index(store)), 2, "2 index entries after tag");
    return 0;
}

# ── cgroup stats read helpers (rust-old container_stats/read_cgroup_u64) ──
fn test_cgroup_read_helpers() {
    test_group("cgroup_read_helpers");
    var d = _rt_cat2("/tmp/stiva-cg-", _rt_int_to_cstr(getpid()));
    sys_mkdir(d, 493);
    var mx = "max\n";
    file_write_all(_rt_cat2(d, "/memory.max"), mx, strlen(mx));
    assert_eq(_rt_read_cgroup_u64(d, "memory.max"), 0, "\"max\" -> 0 (unlimited)");
    var pc = "42\n";
    file_write_all(_rt_cat2(d, "/pids.current"), pc, strlen(pc));
    assert_eq(_rt_read_cgroup_u64(d, "pids.current"), 42, "pids.current 42");
    assert_eq(_rt_read_cgroup_u64(d, "missing.file"), 0, "absent -> 0");
    var cst = "usage_usec 123456\nuser_usec 100\nsystem_usec 50\n";
    file_write_all(_rt_cat2(d, "/cpu.stat"), cst, strlen(cst));
    assert_eq(_rt_read_cpu_usage(d), 123456, "cpu.stat usage_usec parsed");
    return 0;
}

