}

fn test_security_score_for() {
    test_group("security_score_for");
    kavach_init();
    var s = security_score_for(Backend.PROCESS, policy_basic());
    var ok = 0;
    if (s >= 0 && s <= 100) { ok = 1; }
    assert_eq(ok, 1, "explicit score in 0..100");
