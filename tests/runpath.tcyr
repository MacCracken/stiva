# ── cgroup stats read helpers (rust-old container_stats/read_cgroup_u64) ──
fn test_cgroup_read_helpers() {
    test_group("cgroup_read_helpers");
    var d = _rt_cat2("/tmp/stiva-cg-", _rt_int_to_cstr(getpid()));
    sys_mkdir(d, 493);
    var mx = "max\n";
    file_write_all(_rt_cat2(d, "/memory.max"), mx, strlen(mx));
    assert_eq(_rt_read_cgroup_u64(d, "memory.max"), 0, "\"max\" -> 0 (unlimited)");
    var pc = "42\n";
    file_write_all(_rt_cat2(d, "/pids.current"), pc, strlen(pc));
    assert_eq(_rt_read_cgroup_u64(d, "pids.current"), 42, "pids.current 42");
    assert_eq(_rt_read_cgroup_u64(d, "missing.file"), 0, "absent -> 0");
    var cst = "usage_usec 123456\nuser_usec 100\nsystem_usec 50\n";
    file_write_all(_rt_cat2(d, "/cpu.stat"), cst, strlen(cst));
    assert_eq(_rt_read_cpu_usage(d), 123456, "cpu.stat usage_usec parsed");
    return 0;
}

# ── container_log_tail (rust-old log_tail) ──
fn test_container_log_tail() {
    test_group("container_log_tail");
    var lp = _rt_cat2("/tmp/stiva-log-", _rt_int_to_cstr(getpid()));
    var content = "line1\nline2\nline3\nline4\n";
    file_write_all(lp, content, strlen(content));
    assert_eq(streq(container_log_tail(lp, 2), "line3\nline4\n"), 1, "tail 2 lines");
    assert_eq(streq(container_log_tail(lp, 0), content), 1, "tail 0 = whole file");
    assert_eq(streq(container_log_tail(lp, 99), content), 1, "tail > total = whole file");
    assert_eq(container_log_tail("/tmp/stiva-nolog-xyz-zzz", 5), 0, "missing -> 0");
    return 0;
}

fn test_require_pid_empty_allowed_list() {
    test_group("require_pid_empty_allowed_list");
    # _container_state_allowed loops `i < n`, so n=0 matches NOTHING — an empty
    # allowed list means "no state is permitted", the inverse of "any state".
    # `stiva top` passed (0, 0) and therefore failed for every container in
    # every state; the CLI smoke test could not tell, because a stopped
    # container produces the same message either way.
    assert_eq(container_require_pid(CONTAINER_STATE_RUNNING, 1234, 0, 0), 0 - 1,
    "empty allowed list rejects even RUNNING");
    assert_eq(container_require_pid(CONTAINER_STATE_PAUSED, 4321, 0, 0), 0 - 1,
    "empty allowed list rejects even PAUSED");

    # A populated list is what actually admits a state.
    var allowed = vec_new();
    vec_push(allowed, CONTAINER_STATE_RUNNING);
    vec_push(allowed, CONTAINER_STATE_PAUSED);
    assert_eq(container_require_pid(CONTAINER_STATE_RUNNING, 1234, allowed, 2), 1234,
    "RUNNING admitted, pid returned");
    assert_eq(container_require_pid(CONTAINER_STATE_PAUSED, 4321, allowed, 2), 4321,
    "PAUSED admitted, pid returned");
    assert_eq(container_require_pid(CONTAINER_STATE_STOPPED, 1234, allowed, 2), 0 - 1,
    "STOPPED still rejected");
    # A live state with no pid is still a refusal.
    assert_eq(container_require_pid(CONTAINER_STATE_RUNNING, 0 - 1, allowed, 2), 0 - 1,
    "RUNNING with no pid rejected");
    return 0;
}

# ══ §D exec ══════════════════════════════════════════════
#
# `_exec_capture2` is tested directly rather than only through
# `exec_in_container`, because nsenter into a live container needs a live
# container — while every property that can go wrong (the stdout/stderr SPLIT,
# the exit status, the deadlock) belongs to the primitive and is testable with
# an ordinary child process, no root and no namespaces.

fn _t_exec_stub(path, body) {
    sys_unlink(path);
    file_write_all(path, body, strlen(body));
    sys_chmod(path, 493);                      # 0755
    return path;
}

fn _t_exec_args(path) {
    var v = vec_new();
    vec_push(v, path);
    return v;
}

fn test_exec_capture2_splits_streams() {
    test_group("exec_capture2_splits_streams");
    var stub = _t_exec_stub("/tmp/stiva-t-exec-split",
    "#!/bin/sh\necho to-stdout\necho to-stderr >&2\nexit 7\n");
    var err_path = "/tmp/stiva-t-exec-split.err";
    var buf = alloc(65536);
    var n = _exec_capture2(_t_exec_args(stub), 0, 0, buf, 65535, err_path);
    assert(n > 0, "stdout captured");
    store8(buf + n, 0);
    # THE assertion no existing code in this tree could satisfy: every exec path
    # before §D returned stderr = "" (kavach's confine_capture dup2s one fd onto
    # both 1 and 2; lib/process.cyr's exec_capture sends fd 2 to /dev/null).
    assert_eq(strstr(buf, "to-stdout") >= 0, 1, "stdout holds the stdout line");
    assert_eq(strstr(buf, "to-stderr") >= 0, 0, "and NOT the stderr line");
    var err = _rt_take_file(err_path, 65535);
    assert_eq(strstr(err, "to-stderr") >= 0, 1, "stderr holds the stderr line");
    assert_eq(strstr(err, "to-stdout") >= 0, 0, "and NOT the stdout line");
    assert_eq(rt_last_exec_exit(), 7, "the child's real exit code");
    sys_unlink(stub);
    return 0;
}

fn test_exec_capture2_large_stderr_does_not_deadlock() {
    test_group("exec_capture2_large_stderr_does_not_deadlock");
    # THE test that matters. A child writing well past a pipe buffer to stderr
    # BEFORE its first stdout byte deadlocks any single-threaded parent that
    # drains two pipes — proven by execution while designing this: the
    # sequential shape hung until killed, the concurrent one passed. Sending
    # stderr to a FILE removes the second pipe entirely, so there is nothing to
    # deadlock against.
    #
    # This test HANGS rather than fails if that regresses, which is the honest
    # signal — a deadlock is not an assertion failure.
    var stub = _t_exec_stub("/tmp/stiva-t-exec-bigerr",
    "#!/bin/sh\ni=0\nwhile [ $i -lt 2000 ]; do echo 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' >&2; i=$((i+1)); done\necho done-stdout\nexit 3\n");
    var err_path = "/tmp/stiva-t-exec-bigerr.err";
    var buf = alloc(65536);
    var n = _exec_capture2(_t_exec_args(stub), 0, 0, buf, 65535, err_path);
    store8(buf + n, 0);
    assert_eq(strstr(buf, "done-stdout") >= 0, 1, "stdout arrives after ~82 KiB of stderr");
    assert_eq(rt_last_exec_exit(), 3, "and the exit code survives");
    var err = _rt_take_file(err_path, 131072);
    assert(strlen(err) > 65536, "the whole stderr was captured");
    sys_unlink(stub);
    return 0;
}

fn test_exec_capture2_env_and_workdir() {
    test_group("exec_capture2_env_and_workdir");
    var stub = _t_exec_stub("/tmp/stiva-t-exec-env",
    "#!/bin/sh\necho \"V=$STIVA_T_VAR\"\npwd\n");
    var err_path = "/tmp/stiva-t-exec-env.err";
    var env = vec_new();
    vec_push(env, "STIVA_T_VAR=hello");
    # PATH is deliberately absent: the child gets EXACTLY this environment, so a
    # test that passed only because the parent's env leaked through would be
    # measuring nothing.
    var wd = "/tmp";
    var buf = alloc(4096);
    var n = _exec_capture2(_t_exec_args(stub), env, wd, buf, 4095, err_path);
    assert(n > 0, "captured output");
    store8(buf + n, 0);
    assert_eq(strstr(buf, "V=hello") >= 0, 1, "env reached the child");
    assert_eq(strstr(buf, "/tmp") >= 0, 1, "workdir took effect");
    _rt_take_file(err_path, 4096);
    sys_unlink(stub);
    return 0;
}

fn test_exec_capture2_missing_binary() {
    test_group("exec_capture2_missing_binary");
    var buf = alloc(1024);
    var n = _exec_capture2(_t_exec_args("/definitely/not/here"), 0, 0, buf, 1023,
    "/tmp/stiva-t-exec-missing.err");
    assert_eq(n, 0, "no output from a binary that never executed");
    assert_eq(rt_last_exec_exit(), 127, "a failed execve is 127, not 0");
    _rt_take_file("/tmp/stiva-t-exec-missing.err", 1024);
    return 0;
}

fn test_exec_capture2_signalled_child() {
    test_group("exec_capture2_signalled_child");
    var stub = _t_exec_stub("/tmp/stiva-t-exec-sig", "#!/bin/sh\nkill -9 $$\n");
    var buf = alloc(1024);
    _exec_capture2(_t_exec_args(stub), 0, 0, buf, 1023, "/tmp/stiva-t-exec-sig.err");
    # 128 + signal, matching kavach's confine_capture, so an exit status means
    # the same thing whichever side produced it.
    assert_eq(rt_last_exec_exit(), 137, "SIGKILL -> 128 + 9");
    _rt_take_file("/tmp/stiva-t-exec-sig.err", 1024);
    sys_unlink(stub);
    return 0;
}

fn test_exec_capture2_large_output_is_not_a_signal_death() {
    test_group("exec_capture2_large_output_is_not_a_signal_death");
    # A command that merely produces more than the cap used to be reported as
    # exit 141 (SIGPIPE): the parent closed the pipe at the cap, the child died
    # on its next write, and a successful command looked like a signal death —
    # with the truncation silent besides.
    var stub = _t_exec_stub("/tmp/stiva-t-exec-big",
    "#!/bin/sh\ni=0\nwhile [ $i -lt 3000 ]; do echo 'yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy'; i=$((i+1)); done\nexit 5\n");
    var err_path = "/tmp/stiva-t-exec-big.err";
    var cap = 4096;
    var buf = alloc(cap + 1);
    var n = _exec_capture2(_t_exec_args(stub), 0, 0, buf, cap, err_path);
    assert_eq(n, cap, "the buffer is filled exactly to the cap");
    assert_eq(rt_last_exec_exit(), 5, "the command's REAL exit code, not 141");
    assert_eq(rt_last_exec_truncated(), 1, "and the truncation is reported");
    _rt_take_file(err_path, 1024);
    sys_unlink(stub);

    # A command that fits must NOT be flagged as truncated.
    var small = _t_exec_stub("/tmp/stiva-t-exec-small", "#!/bin/sh\necho tiny\nexit 0\n");
    var b2 = alloc(4096);
    _exec_capture2(_t_exec_args(small), 0, 0, b2, 4095, "/tmp/stiva-t-exec-small.err");
    assert_eq(rt_last_exec_truncated(), 0, "output that fits is not flagged");
    assert_eq(rt_last_exec_exit(), 0, "and its exit code is 0");
    _rt_take_file("/tmp/stiva-t-exec-small.err", 1024);
    sys_unlink(small);
    return 0;
}

fn test_exec_capture2_empty_args() {
    test_group("exec_capture2_empty_args");
    var buf = alloc(64);
    assert_eq(_exec_capture2(vec_new(), 0, 0, buf, 63, "/tmp/stiva-t-exec-empty.err"), 0 - 1,
    "an empty argv is refused, not forked");
    return 0;
}

fn test_exec_workdir_escape_refused() {
    test_group("exec_workdir_escape_refused");
    # `--wd` is spliced onto /proc/<pid>/root, so a '..' component walks back OUT
    # of the container: the process stays chrooted in but its cwd lands on the
    # HOST, and every relative path the command opens reads the host filesystem.
    # Verified as an arbitrary host-file read before this guard existed, and
    # reachable from mcp_handle_exec where workdir is untrusted JSON.
    assert_eq(_rt_workdir_is_safe("/app"), 1, "an absolute in-container path");
    assert_eq(_rt_workdir_is_safe("/a/b/c"), 1, "nested");
    assert_eq(_rt_workdir_is_safe("/..foo"), 1, "'..' inside a NAME is fine");
    assert_eq(_rt_workdir_is_safe("/a..b"), 1, "and in the middle of one");
    assert_eq(_rt_workdir_is_safe("/../../.."), 0, "leading ..");
    assert_eq(_rt_workdir_is_safe("/app/../../.."), 0, "interior ..");
    assert_eq(_rt_workdir_is_safe("/app/.."), 0, "trailing ..");
    assert_eq(_rt_workdir_is_safe("../../.."), 0, "relative with ..");
    assert_eq(_rt_workdir_is_safe("relative"), 0, "relative at all is refused");
    assert_eq(_rt_workdir_is_safe(""), 0, "empty");
    assert_eq(_rt_workdir_is_safe(0), 0, "null");
    # And the driver refuses before building the nsenter argv.
    var cmd = vec_new();
    vec_push(cmd, "/bin/true");
    assert_eq(exec_in_container("/tmp", 1, cmd, 0, "/../../.."), 0, "driver refuses the escape");
    return 0;
}

fn test_exec_scratch_path_is_per_exec() {
    test_group("exec_scratch_path_is_per_exec");
    # Keying the stderr scratch file on the container's pid alone meant two
    # concurrent execs into ONE container shared it, and one exec's stderr was
    # silently lost.
    var a = _rt_exec_tag(1234);
    var b = _rt_exec_tag(1234);
    assert_eq(streq(a, b), 0, "two execs against the same pid get distinct tags");
    assert_eq(streq(_rt_exec_err_path("/tmp", a), _rt_exec_err_path("/tmp", b)), 0,
    "and therefore distinct scratch paths");
    return 0;
}

fn test_exec_in_container_empty_command() {
    test_group("exec_in_container_empty_command");
    # The oracle's only test for this function (rust-old/src/runtime.rs:1745).
    assert_eq(exec_in_container("/tmp", 1, vec_new(), 0, 0), 0, "empty command -> failure");
    assert_eq(exec_in_container("/tmp", 1, 0, 0, 0), 0, "null command -> failure");
    return 0;
}

fn test_cm_exec_requires_running() {
    test_group("cm_exec_requires_running");
    var root = "/tmp/stiva-t-cm-exec";
    _stor_remove_dir_all(root);
    var store = image_store_new(root);
    var mgr = container_manager_new(root, store);
    assert(mgr != 0, "manager created");
    if (mgr == 0) { return 0; }
    var cmd = vec_new();
    vec_push(cmd, "/bin/true");
    # No such container at all.
    assert_eq(container_manager_exec(mgr, "nosuchid", cmd, 0, 0), 0, "unknown container -> 0");
    return 0;
}

# ══ diff (roadmap v3.0.17 item 1) ════════════════════════
# No oracle: the Rust diff verb has never executed in the CLI (internals is
# never rehydrated), and its walk emits only C/D and looks for `.wh.` files in an
# overlay upper, where whiteouts are character devices. This is a rewrite.

fn _dv_write(path, content) {
    _stor_mkdir_parents(path);
    file_write_all(path, content, strlen(content));
    return 0;
}

fn _dv_find(entries, status, path) {
    var i = 0;
    while (i < vec_len(entries)) {
        var e = vec_get(entries, i);
        if (cm_diff_status(e) == status) {
            if (streq(cm_diff_path(e), path) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

fn test_cm_diff_flattened_reports_a_c_d() {
    test_group("cm_diff_flattened_reports_a_c_d");
    var root = "/tmp/stiva-t-diff";
    _stor_remove_dir_all(root);
    var store = image_store_new(root);
    var mgr = container_manager_new(root, store);
    assert(mgr != 0, "manager");
    if (mgr == 0) { return 0; }

    # A one-layer image with three files.
    var entries = vec_new();
    vec_push(entries, _tar_entry_new("app/orig.txt", 48, 420, 0, 0, 5, "orig\n"));
    vec_push(entries, _tar_entry_new("app/gone.txt", 48, 420, 0, 0, 5, "gone\n"));
    vec_push(entries, _tar_entry_new("app/same.txt", 48, 420, 0, 0, 5, "same\n"));
    var tarp = "/tmp/stiva-t-diff.tar";
    xunlink(tarp);
    _stor_write_tar(entries, tarp);
    var img = image_import(store, tarp, "d", "v1");
    assert(img != 0, "image imported");
    if (img == 0) { return 0; }

    var rec = container_manager_create(mgr, img, container_config_default());
    assert(rec != 0, "container created");
    if (rec == 0) { return 0; }
    var rc: Container = rec;

    # An unchanged container has no diff at all.
    var clean = container_manager_diff(mgr, rc.id);
    assert(clean != 0, "diff returned");
    assert_eq(vec_len(clean), 0, "an untouched rootfs reports no changes");

    # Mutate the rootfs the way a running container would.
    var rfs = _container_cat2(_cm_container_dir(root, rc.id), "/rootfs");
    _dv_write(_container_cat2(rfs, "/app/orig.txt"), "CHANGED-AND-LONGER\n");
    _dv_write(_container_cat2(rfs, "/app/added.txt"), "new\n");
    xunlink(_container_cat2(rfs, "/app/gone.txt"));

    var d = container_manager_diff(mgr, rc.id);
    assert(d != 0, "diff returned");
    if (d == 0) { return 0; }
    assert_eq(_dv_find(d, _CM_DIFF_CHG, "/app/orig.txt"), 1, "C for a modified file");
    assert_eq(_dv_find(d, _CM_DIFF_ADD, "/app/added.txt"), 1, "A for a new file");
    assert_eq(_dv_find(d, _CM_DIFF_DEL, "/app/gone.txt"), 1, "D for a removed file");
    # An untouched file must NOT appear — the fingerprint excludes mtime, so
    # merely reading a file is not a change.
    assert_eq(_dv_find(d, _CM_DIFF_CHG, "/app/same.txt"), 0, "an untouched file is not reported");
    assert_eq(_dv_find(d, _CM_DIFF_ADD, "/app/same.txt"), 0, "nor as an add");
    return 0;
}

fn test_cm_diff_unknown_container() {
    test_group("cm_diff_unknown_container");
    var root = "/tmp/stiva-t-diff2";
    _stor_remove_dir_all(root);
    var store = image_store_new(root);
    var mgr = container_manager_new(root, store);
    assert_eq(container_manager_diff(mgr, "nosuchthing"), 0, "unknown container -> 0");
    return 0;
}

fn test_cm_diff_meta_type_parse() {
    test_group("cm_diff_meta_type_parse");
    # The S_IFMT prefix of a "<type>:<size>:<mode>" fingerprint. 8192 = S_IFCHR,
    # which is how an overlayfs whiteout is spelled.
    assert_eq(_cm_diff_meta_type("8192:0:0"), 8192, "chardev");
    assert_eq(_cm_diff_meta_type("32768:12:420"), 32768, "regular file");
    assert_eq(_cm_diff_meta_type("16384:4096:493"), 16384, "directory");
    return 0;
}

fn test_cm_diff_wh_path_detection() {
    test_group("cm_diff_wh_path_detection");
    assert_eq(_cm_diff_is_wh_path("/app/.wh.gone"), 1, "a marker component");
    assert_eq(_cm_diff_is_wh_path("/.wh..wh..opq"), 1, "the opaque marker");
    assert_eq(_cm_diff_is_wh_path("/app/normal.txt"), 0, "an ordinary path");
    assert_eq(_cm_diff_is_wh_path("/app/a.wh.b"), 0, "'.wh.' mid-name is not a marker");
    return 0;
}

# ══ scan_policy persistence (roadmap v3.0.17 item 3) ═════
# The field used to serialize as `null` and read back as 0, so a per-container
# externalization policy never survived a save/load — which is why `logs --scan`
# had to be an explicit flag.

fn test_scan_policy_round_trips() {
    test_group("scan_policy_round_trips");
    var cfg: ContainerConfig = container_config_default();
    assert_eq(cfg.scan_policy, 0, "default has no policy");

    var p = ext_policy_default();
    ExternalizationPolicy_set_enabled(p, 1);
    ExternalizationPolicy_set_max_artifact_size_bytes(p, 12345);
    ExternalizationPolicy_set_block_threshold(p, 4);
    ExternalizationPolicy_set_quarantine_threshold(p, 3);
    ExternalizationPolicy_set_redact_secrets(p, 0);
    cfg.scan_policy = p;

    var jv = _container_config_to_jv(cfg);
    var back: ContainerConfig = _container_config_from_jv(jv);
    var q = back.scan_policy;
    assert(q != 0, "the policy survived the round trip");
    if (q == 0) { return 0; }
    assert_eq(ExternalizationPolicy_max_artifact_size_bytes(q), 12345, "size limit");
    assert_eq(ExternalizationPolicy_block_threshold(q), 4, "block threshold");
    assert_eq(ExternalizationPolicy_quarantine_threshold(q), 3, "quarantine threshold");
    assert_eq(ExternalizationPolicy_redact_secrets(q), 0, "redact flag");
    return 0;
}

fn test_scan_policy_absent_stays_absent() {
    test_group("scan_policy_absent_stays_absent");
    # Every state.json written before this change has `"scan_policy": null`, and
    # must keep meaning "no policy" rather than becoming a zeroed one — a 0
    # block_threshold would BLOCK every artifact.
    var cfg: ContainerConfig = container_config_default();
    var back: ContainerConfig = _container_config_from_jv(_container_config_to_jv(cfg));
    assert_eq(back.scan_policy, 0, "null round-trips to 0, not a zeroed policy");
    assert_eq(_ct_scan_policy_from_jv(0), 0, "an absent key is 0");
    assert_eq(_ct_scan_policy_from_jv(json_v_null()), 0, "an explicit null is 0");
    assert_eq(_ct_scan_policy_from_jv(json_v_int_new(7)), 0, "a non-object is 0");
    return 0;
}

fn test_scan_policy_partial_object_keeps_defaults() {
    test_group("scan_policy_partial_object_keeps_defaults");
    # A field the writer omitted must keep kavach's default, not become 0.
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("enabled"), json_v_int_new(1));
    var p = _ct_scan_policy_from_jv(o);
    assert(p != 0, "a partial object still yields a policy");
    if (p == 0) { return 0; }
    var d = ext_policy_default();
    assert_eq(ExternalizationPolicy_block_threshold(p),
    ExternalizationPolicy_block_threshold(d), "omitted block_threshold keeps the default");
    assert_eq(ExternalizationPolicy_redact_secrets(p),
    ExternalizationPolicy_redact_secrets(d), "omitted redact_secrets keeps the default");
    return 0;
}

# ══ rootless networking (roadmap v3.0.17 item 2) ═════════
# Before this, network_manager logged "bridge creation deferred (requires root)"
# and carried on — so an unprivileged `stiva run`, stiva's DEFAULT mode, produced
# a container with no connectivity and only a warning.

fn test_rootless_bin_path_is_absolute() {
    test_group("rootless_bin_path_is_absolute");
    # execve does NOT search PATH, and the child gets an empty environment, so a
    # bare name would always fail.
    var p = _rl_bin_path("slirp4netns");
    assert_eq(load8(p), 47, "the resolved path is absolute");
    assert_eq(strstr(p, "slirp4netns") >= 0, 1, "and names the binary");
    return 0;
}

fn test_rootless_sock_path_is_per_pid() {
    test_group("rootless_sock_path_is_per_pid");
    # Two containers must not share slirp4netns' API socket.
    assert_eq(streq(_rl_sock_path(111), _rl_sock_path(222)), 0, "distinct per pid");
    assert_eq(strstr(_rl_sock_path(111), "111") >= 0, 1, "names the pid");
    return 0;
}

fn test_rootless_spawn_detached_does_not_wait() {
    test_group("rootless_spawn_detached_does_not_wait");
    # THE property that makes this different from _exec_capture2: slirp4netns and
    # pasta run for the container's lifetime, so a primitive that waits would
    # hang `run` forever.
    var stub = "/tmp/stiva-t-rl-sleeper";
    sys_unlink(stub);
    var body = "#!/bin/sh\nsleep 30\n";
    file_write_all(stub, body, strlen(body));
    sys_chmod(stub, 493);
    var args = vec_new();
    vec_push(args, stub);
    var t0 = mono_now_ns();
    var pid = _rl_spawn_detached(args, "/tmp/stiva-t-rl.log");
    var elapsed_ms = (mono_now_ns() - t0) / 1000000;
    assert(pid > 0, "a pid is returned");
    # It must return immediately, not after the child's 30 s.
    assert(elapsed_ms < 2000, "returns immediately rather than waiting");
    if (pid > 0) { sys_kill(pid, 9); }
    sys_unlink(stub);
    sys_unlink("/tmp/stiva-t-rl.log");
    return 0;
}

fn test_rootless_spawn_reports_failure() {
    test_group("rootless_spawn_reports_failure");
    assert_eq(_rl_spawn_detached(vec_new(), 0), 0 - 1, "an empty argv is refused");
    return 0;
}

fn test_rootless_handle_accessors() {
    test_group("rootless_handle_accessors");
    var h = alloc(24);
    store64(h, 4242);
    store64(h + 8, NETWORK_ROOTLESS_BACKEND_PASTA);
    store64(h + 16, 0);
    assert_eq(rootless_handle_pid(h), 4242, "pid");
    assert_eq(rootless_handle_backend(h), NETWORK_ROOTLESS_BACKEND_PASTA, "backend");
    assert_eq(rootless_handle_socket(h), 0, "pasta needs no api socket");
    # stop is safe on a handle whose pid is already gone, and on 0.
    assert_eq(stop_rootless_network(0), 0, "stop(0) is a no-op");
    return 0;
}

# ══ §H cron containers ═══════════════════════════════════
# NET-NEW: rust-old has no time-triggered start, so no oracle. The timing
# semantics come from samay; what is tested here is stiva's side — validation,
# persistence, and the mapping back from a fired task to a container spec.

fn test_cron_expr_validation() {
    test_group("cron_expr_validation");
    assert_eq(cron_expr_is_valid("* * * * *"), 1, "every minute");
    assert_eq(cron_expr_is_valid("0 3 * * *"), 1, "daily at 03:00");
    assert_eq(cron_expr_is_valid("@daily"), 1, "@daily shortcut");
    assert_eq(cron_expr_is_valid("@hourly"), 1, "@hourly shortcut");
    assert_eq(cron_expr_is_valid("*/15 * * * *"), 1, "step values");
    # `cron_expr_parse` returns a RESULT, so a naive `!= 0` accepts everything —
    # which is exactly how "not a cron" was accepted as a schedule.
    assert_eq(cron_expr_is_valid("not a cron"), 0, "garbage is refused");
    assert_eq(cron_expr_is_valid("@bogus"), 0, "an unknown shortcut is refused");
    assert_eq(cron_expr_is_valid(""), 0, "empty is refused");
    assert_eq(cron_expr_is_valid(0), 0, "null is refused");
    return 0;
}

fn test_cron_store_round_trip() {
    test_group("cron_store_round_trip");
    var root = "/tmp/stiva-t-cron";
    _stor_remove_dir_all(root);
    _stor_mkdir_p(root);
    assert_eq(vec_len(cron_store_load(root)), 0, "an absent store is empty");

    var cmd = vec_new();
    vec_push(cmd, "/bin/backup");
    vec_push(cmd, "--full");
    assert_eq(cron_add(root, "nightly", "0 3 * * *", "local/tools:v1", cmd), 1, "add");
    var jobs = cron_store_load(root);
    assert_eq(vec_len(jobs), 1, "one job persisted");
    if (vec_len(jobs) != 1) { return 0; }
    var j = vec_get(jobs, 0);
    assert_eq(streq(cron_job_name(j), "nightly"), 1, "name");
    assert_eq(streq(cron_job_expr(j), "0 3 * * *"), 1, "the expression AS TYPED survives");
    assert_eq(streq(cron_job_image(j), "local/tools:v1"), 1, "image");
    assert_eq(vec_len(cron_job_command(j)), 2, "argv length");
    assert_eq(streq(vec_get(cron_job_command(j), 1), "--full"), 1, "argv content");
    assert_eq(cron_job_enabled(j), 1, "enabled by default");

    # A bad expression must never reach the store.
    assert_eq(cron_add(root, "bad", "nonsense", "local/tools:v1", vec_new()), 0, "bad expr refused");
    assert_eq(vec_len(cron_store_load(root)), 1, "and nothing was written");

    # Same name replaces rather than duplicating.
    assert_eq(cron_add(root, "nightly", "@daily", "local/other:v2", vec_new()), 1, "re-add");
    var jobs2 = cron_store_load(root);
    assert_eq(vec_len(jobs2), 1, "still one job");
    assert_eq(streq(cron_job_expr(vec_get(jobs2, 0)), "@daily"), 1, "the definition was replaced");

    assert_eq(cron_set_enabled(root, "nightly", 0), 1, "disable");
    assert_eq(cron_job_enabled(vec_get(cron_store_load(root), 0)), 0, "disabled persists");
    assert_eq(cron_remove(root, "nightly"), 1, "remove");
    assert_eq(vec_len(cron_store_load(root)), 0, "store is empty again");
    assert_eq(cron_remove(root, "nightly"), 0, "removing an unknown job reports it");
    return 0;
}

fn test_cron_due_uses_injected_clock() {
    test_group("cron_due_uses_injected_clock");
    # samay's check_due_at takes the clock, so this is deterministic.
    var jobs = vec_new();
    vec_push(jobs, cron_job_new("m", "* * * * *", "local/x:v1", vec_new(), 1, 0));
    # First evaluation with last_fired == 0 fires only if the minute matches;
    # `* * * * *` always matches.
    var t0 = 1700000000000000000;
    var due = cron_due_at(jobs, t0);
    assert_eq(vec_len(due), 1, "an every-minute job is due");
    # last_fired is advanced, so the same instant is no longer due.
    assert_eq(vec_len(cron_due_at(jobs, t0)), 0, "not due twice at the same instant");
    return 0;
}

fn test_cron_disabled_never_fires() {
    test_group("cron_disabled_never_fires");
    var jobs = vec_new();
    vec_push(jobs, cron_job_new("off", "* * * * *", "local/x:v1", vec_new(), 0, 0));
    assert_eq(vec_len(cron_due_at(jobs, 1700000000000000000)), 0, "a disabled job never fires");
    return 0;
}

fn test_cron_strip_task_suffix() {
    test_group("cron_strip_task_suffix");
    # samay appends " (cron)" to the fired task name; it has to come off before
    # the job lookup or nothing maps back.
    assert_eq(streq(_cron_strip_suffix("nightly (cron)"), "nightly"), 1, "suffix removed");
    assert_eq(streq(_cron_strip_suffix("nightly"), "nightly"), 1, "absent suffix is a no-op");
    assert_eq(streq(_cron_strip_suffix("(cron)"), "(cron)"), 1, "a name that IS the suffix is left alone");
    return 0;
}

fn main() {
    alloc_init();
    test_container_log_tail();
    test_cgroup_read_helpers();
    test_image_ref_new();
    test_image_store_tag();
