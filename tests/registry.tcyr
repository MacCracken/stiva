    alloc_init();
    test_rg_transport_seam();
    test_rg_headers_fail_closed_on_crlf();
    test_rg_http_opts_overrides_sandhi_defaults();
    test_rg_auth_flow();
    test_rg_auth_flow_success();
    test_rg_auth_access_token_key();
    test_rg_auth_basic_credentials_on_token_endpoint();
    test_rg_cached_token_reused();
    test_rg_cached_token_401_triggers_reauth();
    test_rg_401_without_challenge_header();
    test_rg_challenge_without_realm();
    test_rg_token_endpoint_no_token_field();
    test_rg_token_endpoint_error_status();
    test_rg_server_error_is_registry_not_auth();
    test_rg_token_url_carries_caller_scope();
    test_rg_platform_from_jv();
    test_rg_platform_manifest_from_jv();
    test_rg_oci_index_from_jv();
    test_rg_oci_index_hostile_entries();
    test_rg_body_is_index();
    test_rg_manifest_schema_version_guard();
    test_rg_api_base();
    test_rg_urls();
    test_rg_scopes_and_accept();
    test_rg_location_and_digest_query();
    test_rg_api_bases_mirrors();
    test_rg_cache_key_scope_separation();
    test_rg_token_cache_expiry();
    test_rg_token_url_and_basic_auth();
    test_rg_token_from_body();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
