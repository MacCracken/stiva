fn test_dns_ipv4_to_str_canonical() {
    test_group("network_dns::ipv4_to_str_canonical");
    assert_eq(streq(str_cstr(network_dns_ipv4_to_str(0x08080808)), "8.8.8.8"), 1, "8.8.8.8");
    assert_eq(streq(str_cstr(network_dns_ipv4_to_str(0xAC110002)), "172.17.0.2"), 1, "172.17.0.2");
