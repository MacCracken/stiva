    assert_eq(streq(media_oci_layer(), "application/vnd.oci.image.layer.v1.tar+gzip"), 1, "oci gzip layer media type");
    assert_eq(streq(media_oci_manifest(), "application/vnd.oci.image.manifest.v1+json"), 1, "oci manifest media type");
    assert_eq(streq(media_oci_index(), "application/vnd.oci.image.index.v1+json"), 1, "oci index media type");
