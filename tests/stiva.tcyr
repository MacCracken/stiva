fn test_build_step_type_names() {
    test_group("build_step_type_names");
    # serde `type` tag wire names (rename_all=lowercase; from_stage explicit)
    assert_eq(streq(build_step_type_name(BUILD_STEP_RUN), "run"), 1, "run");
    assert_eq(streq(build_step_type_name(BUILD_STEP_COPY), "copy"), 1, "copy");
    assert_eq(streq(build_step_type_name(BUILD_STEP_ENV), "env"), 1, "env");
    assert_eq(streq(build_step_type_name(BUILD_STEP_WORKDIR), "workdir"), 1, "workdir");
    assert_eq(streq(build_step_type_name(BUILD_STEP_LABEL), "label"), 1, "label");
    assert_eq(streq(build_step_type_name(BUILD_STEP_FROM_STAGE), "from_stage"), 1, "from_stage");
    return 0;
}

fn test_build_step_variants() {
    test_group("build_step_variants");
    # Mirrors rust-old step_variants: the payload each variant carries.
    var run = build_step_run(0);
    var rr: BuildStep = run;
    assert_eq(rr.kind, BUILD_STEP_RUN, "run kind");

    var cp = build_step_copy("./app", "/app");
    var cc: BuildStep = cp;
    assert_eq(cc.kind, BUILD_STEP_COPY, "copy kind");
    assert_eq(streq(cc.source, "./app"), 1, "copy source");
    assert_eq(streq(cc.destination, "/app"), 1, "copy destination");

    var ev = build_step_env("PORT", "8080");
    var ee: BuildStep = ev;
    assert_eq(ee.kind, BUILD_STEP_ENV, "env kind");
    assert_eq(streq(ee.key, "PORT"), 1, "env key");
    assert_eq(streq(ee.value, "8080"), 1, "env value");

    var wd = build_step_workdir("/app");
    var ww: BuildStep = wd;
    assert_eq(ww.kind, BUILD_STEP_WORKDIR, "workdir kind");
    assert_eq(streq(ww.source, "/app"), 1, "workdir path");

    var lb = build_step_label("maintainer", "stiva");
    var ll: BuildStep = lb;
    assert_eq(ll.kind, BUILD_STEP_LABEL, "label kind");
    assert_eq(streq(ll.key, "maintainer"), 1, "label key");
    assert_eq(streq(ll.value, "stiva"), 1, "label value");

    var fs = build_step_from_stage("builder", "/out", "/app");
    var ff: BuildStep = fs;
    assert_eq(ff.kind, BUILD_STEP_FROM_STAGE, "from_stage kind");
    assert_eq(streq(ff.stage, "builder"), 1, "from_stage stage");
    assert_eq(streq(ff.source, "/out"), 1, "from_stage source");
    assert_eq(streq(ff.destination, "/app"), 1, "from_stage destination");
    return 0;
}

fn test_build_sha256_digest() {
    test_group("build_sha256_digest");
    # rust-old sha256_digest_known_value / _deterministic (build.rs's private
    # sha256_digest is byte-identical to image.cyr's public one, reused here).
    var empty = sha256_digest("", 0);
    assert_eq(streq(empty, "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), 1, "sha256 of empty");
    var a = sha256_digest("hello world", 11);
    var b = sha256_digest("hello world", 11);
    assert_eq(streq(a, b), 1, "sha256 deterministic");
    return 0;
}

# rust-old: parse_full_spec — full Stivafile with every step type + config.
fn test_build_parse_full_spec() {
    test_group("build_parse_full_spec");
    var src = "[image]\nbase = \"alpine:3.19\"\nname = \"myapp\"\ntag = \"v1.0\"\n\n[[steps]]\ntype = \"run\"\ncommand = [\"apk\", \"add\", \"--no-cache\", \"curl\"]\n\n[[steps]]\ntype = \"copy\"\nsource = \"./app\"\ndestination = \"/app\"\n\n[[steps]]\ntype = \"env\"\nkey = \"PORT\"\nvalue = \"8080\"\n\n[[steps]]\ntype = \"workdir\"\npath = \"/app\"\n\n[[steps]]\ntype = \"label\"\nkey = \"maintainer\"\nvalue = \"stiva\"\n\n[[steps]]\ntype = \"run\"\ncommand = [\"/app/build.sh\"]\n\n[config]\nentrypoint = [\"/app/start.sh\"]\nexpose = [8080]\nuser = \"nobody\"\nworkdir = \"/app\"\n";
    var spec = parse_build_spec(src);
    assert_neq(spec, 0, "non-null spec");
    var ss: BuildSpec = spec;
    var img: ImageDef = ss.image;
    assert_eq(streq(img.base, "alpine:3.19"), 1, "base");
    assert_eq(streq(img.name, "myapp"), 1, "name");
    assert_eq(streq(img.tag, "v1.0"), 1, "tag");
    assert_eq(vec_len(ss.steps), 6, "6 steps");

    # Step payloads mirror rust-old step_variants.
    var s0: BuildStep = vec_get(ss.steps, 0);
    assert_eq(s0.kind, BUILD_STEP_RUN, "step0 run");
    assert_eq(vec_len(s0.command), 4, "run has 4 args");
    assert_eq(streq(vec_get(s0.command, 0), "apk"), 1, "run arg0 apk");
    var s1: BuildStep = vec_get(ss.steps, 1);
    assert_eq(s1.kind, BUILD_STEP_COPY, "step1 copy");
    assert_eq(streq(s1.source, "./app"), 1, "copy source");
    assert_eq(streq(s1.destination, "/app"), 1, "copy destination");
    var s2: BuildStep = vec_get(ss.steps, 2);
    assert_eq(s2.kind, BUILD_STEP_ENV, "step2 env");
    assert_eq(streq(s2.key, "PORT"), 1, "env key");
    assert_eq(streq(s2.value, "8080"), 1, "env value");
    var s3: BuildStep = vec_get(ss.steps, 3);
    assert_eq(s3.kind, BUILD_STEP_WORKDIR, "step3 workdir");
    assert_eq(streq(s3.source, "/app"), 1, "workdir path");
    var s4: BuildStep = vec_get(ss.steps, 4);
    assert_eq(s4.kind, BUILD_STEP_LABEL, "step4 label");
    assert_eq(streq(s4.key, "maintainer"), 1, "label key");
    var s5: BuildStep = vec_get(ss.steps, 5);
    assert_eq(s5.kind, BUILD_STEP_RUN, "step5 run");
    assert_eq(vec_len(s5.command), 1, "run has 1 arg");

    var cfg: BuildConfig = ss.config;
    assert_eq(vec_len(cfg.entrypoint), 1, "entrypoint len");
    assert_eq(streq(vec_get(cfg.entrypoint, 0), "/app/start.sh"), 1, "entrypoint[0]");
    assert_eq(vec_len(cfg.expose), 1, "expose len");
    assert_eq(vec_get(cfg.expose, 0), 8080, "expose[0] 8080");
    assert_eq(streq(cfg.user, "nobody"), 1, "user nobody");
    assert_eq(streq(cfg.workdir, "/app"), 1, "config workdir");
    return 0;
}

