fn test_registry_www_authenticate() {
    test_group("registry_www_authenticate");
    var h = "Bearer realm=\"https://auth.docker.io/token\",service=\"registry.docker.io\",scope=\"repository:library/nginx:pull\"";
    var p = parse_www_authenticate(h);
    assert_eq(streq(auth_params_get(p, "realm"), "https://auth.docker.io/token"), 1, "realm");
    assert_eq(streq(auth_params_get(p, "service"), "registry.docker.io"), 1, "service");
    assert_eq(streq(auth_params_get(p, "scope"), "repository:library/nginx:pull"), 1, "scope");
    # No "Bearer " prefix.
    var p2 = parse_www_authenticate("realm=\"https://auth.example.com/token\",service=\"registry\"");
    assert_eq(streq(auth_params_get(p2, "realm"), "https://auth.example.com/token"), 1, "no-prefix realm");
    # lowercase bearer.
    var p3 = parse_www_authenticate("bearer realm=\"https://x/token\"");
    assert_eq(streq(auth_params_get(p3, "realm"), "https://x/token"), 1, "lowercase bearer realm");
    return 0;
}

fn test_registry_platform_eq() {
    test_group("registry_platform_eq");
    var a = platform_new("amd64", "linux", 0, 0);
    var b = platform_new("amd64", "linux", 0, 0);
    assert_eq(platform_eq(a, b), 1, "same platform equal");
    var c = platform_new("arm64", "linux", 0, 0);
    assert_eq(platform_eq(a, c), 0, "diff arch not equal");
    var d = platform_new("amd64", "linux", "v8", 0);
    assert_eq(platform_eq(a, d), 0, "diff variant not equal");
    return 0;
}

