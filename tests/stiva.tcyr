fn test_container_require_pid() {
    test_group("container_require_pid");
    var allowed = vec_new();
    vec_push(allowed, CONTAINER_STATE_RUNNING);
    # Running + valid pid -> pid.
    assert_eq(container_require_pid(CONTAINER_STATE_RUNNING, 4321, allowed, 1), 4321, "running+pid");
    # Wrong state -> -1 (InvalidState).
    assert_eq(container_require_pid(CONTAINER_STATE_CREATED, 4321, allowed, 1), 0 - 1, "wrong state");
    # Right state but no pid -> -1.
    assert_eq(container_require_pid(CONTAINER_STATE_RUNNING, 0 - 1, allowed, 1), 0 - 1, "no pid");
    # Multi-state allowed set.
    var allowed2 = vec_new();
    vec_push(allowed2, CONTAINER_STATE_RUNNING);
    vec_push(allowed2, CONTAINER_STATE_PAUSED);
    assert_eq(container_require_pid(CONTAINER_STATE_PAUSED, 7, allowed2, 2), 7, "paused allowed");
    return 0;
}

fn test_container_fixup_after_restart() {
    test_group("container_fixup_after_restart");
    var cfg = container_config_default();
    # Running -> Stopped, pid cleared, changed=1.
    var r: Container = container_new("i", 0, "im", "ref", CONTAINER_STATE_RUNNING, 99, 0, 0 - 1, cfg, 0 - 1);
    assert_eq(container_fixup_after_restart(r), 1, "running changed");
    assert_eq(r.state, CONTAINER_STATE_STOPPED, "now stopped");
    assert_eq(r.pid, 0 - 1, "pid cleared");
    # Paused -> Stopped too.
    var p: Container = container_new("i", 0, "im", "ref", CONTAINER_STATE_PAUSED, 5, 0, 0 - 1, cfg, 0 - 1);
    assert_eq(container_fixup_after_restart(p), 1, "paused changed");
    assert_eq(p.state, CONTAINER_STATE_STOPPED, "paused now stopped");
    # Stopped stays put, changed=0.
    var s: Container = container_new("i", 0, "im", "ref", CONTAINER_STATE_STOPPED, 0 - 1, 0, 0 - 1, cfg, 0);
    assert_eq(container_fixup_after_restart(s), 0, "stopped unchanged");
    assert_eq(s.state, CONTAINER_STATE_STOPPED, "still stopped");
    return 0;
}

fn test_container_should_rotate() {
    test_group("container_should_rotate");
    # Disabled when either bound is 0.
    assert_eq(container_should_rotate(0, 3, 100, 100), 0, "max_bytes 0");
    assert_eq(container_should_rotate(100, 0, 100, 100), 0, "max_files 0");
    # Under limit -> no rotate.
    assert_eq(container_should_rotate(1000, 3, 500, 200), 0, "under limit");
    # Over limit -> rotate.
    assert_eq(container_should_rotate(1000, 3, 900, 200), 1, "over limit");
    return 0;
}

fn test_container_tail_start() {
    test_group("container_tail_start");
    # rust-old: saturating_sub(lines).
    assert_eq(container_tail_start(5, 3), 2, "5-3=2");
    assert_eq(container_tail_start(2, 10), 0, "saturating to 0");
    assert_eq(container_tail_start(3, 3), 0, "exact");
    return 0;
}

fn test_container_rotated_path() {
    test_group("container_rotated_path");
    assert_eq(streq(_container_rotated_path("/v/container.log", 1), "/v/container.log.1"), 1, ".1");
    assert_eq(streq(_container_rotated_path("/v/container.log", 12), "/v/container.log.12"), 1, ".12");
    return 0;
}


# ── health.cyr ──
# ── health.cyr (rust-old/src/health.rs) ──────────────────────────
# Mirrors the #[cfg(test)] module. Async fns are synchronous here; the
# timing-based Rust tests (offline detection after sleeps) become
# deterministic by using a 0ns offline_after so chb_update_statuses drives
# every node OFFLINE on the next tick.

# Helper: does `v` (vec of cstr) contain a cstr equal to `needle`?
fn _test_vec_contains_cstr(v, needle) {
    var i = 0;
    var len = vec_len(v);
    while (i < len) {
        if (streq(vec_get(v, i), needle) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn test_health_status_from_majra() {
    test_group("health_status_from_majra");
    assert_eq(health_status_from_majra(HEALTH_MAJRA_ONLINE), HEALTH_STATUS_HEALTHY, "online->healthy");
    assert_eq(health_status_from_majra(HEALTH_MAJRA_SUSPECT), HEALTH_STATUS_STARTING, "suspect->starting");
    assert_eq(health_status_from_majra(HEALTH_MAJRA_OFFLINE), HEALTH_STATUS_UNHEALTHY, "offline->unhealthy");
    assert_eq(health_status_from_majra(99), HEALTH_STATUS_UNKNOWN, "other->unknown");
    return 0;
}

fn test_health_status_serde() {
    test_group("health_status_serde");
    # Serde names round-trip (rust: serialize/deserialize identity). No JSON
    # codec in the base — check the wire names are stable & distinct.
    assert_eq(streq(health_status_name(HEALTH_STATUS_HEALTHY), "Healthy"), 1, "healthy name");
    assert_eq(streq(health_status_name(HEALTH_STATUS_UNHEALTHY), "Unhealthy"), 1, "unhealthy name");
    assert_eq(streq(health_status_name(HEALTH_STATUS_STARTING), "Starting"), 1, "starting name");
    assert_eq(streq(health_status_name(HEALTH_STATUS_UNKNOWN), "Unknown"), 1, "unknown name");
    return 0;
}

fn test_health_register_and_heartbeat() {
    test_group("health_register_and_heartbeat");
    var m = health_monitor_new();
    health_monitor_register(m, "c1", HEALTH_RESTART_NEVER, 0);
    assert_eq(health_monitor_len(m), 1, "len is 1");
    assert_eq(health_monitor_heartbeat(m, "c1"), 1, "heartbeat tracked");
    assert_eq(health_monitor_get_status(m, "c1"), HEALTH_STATUS_HEALTHY, "status healthy");
    return 0;
}

fn test_health_deregister() {
    test_group("health_deregister");
    var m = health_monitor_new();
    health_monitor_register(m, "c1", HEALTH_RESTART_NEVER, 0);
    health_monitor_deregister(m, "c1");
    assert_eq(health_monitor_is_empty(m), 1, "empty after deregister");
    return 0;
}

fn test_health_restart_count_increments() {
    test_group("health_restart_count_increments");
    # offline_after = 0 -> update drives the node OFFLINE immediately.
    var cfg = heartbeat_config_new(0, 0, 0);
    var m = health_monitor_with_config(cfg);
    health_monitor_register(m, "c1", HEALTH_RESTART_ALWAYS, 0);
    var needs = health_monitor_check_and_restart(m);
    assert_eq(_test_vec_contains_cstr(needs, "c1"), 1, "c1 needs restart");
    assert_eq(health_monitor_restart_count(m, "c1"), 1, "restart count 1");
    return 0;
}

fn test_health_never_policy_no_restart() {
    test_group("health_never_policy_no_restart");
    var cfg = heartbeat_config_new(0, 0, 0);
    var m = health_monitor_with_config(cfg);
    health_monitor_register(m, "c1", HEALTH_RESTART_NEVER, 0);
    var needs = health_monitor_check_and_restart(m);
    assert_eq(_test_vec_contains_cstr(needs, "c1"), 0, "never -> no restart");
    return 0;
}

fn test_health_on_failure_max_retries() {
    test_group("health_on_failure_max_retries");
    var cfg = heartbeat_config_new(0, 0, 0);
    var m = health_monitor_with_config(cfg);
    health_monitor_register(m, "c1", HEALTH_RESTART_ON_FAILURE, 2);
    # First restart.
    var r1 = health_monitor_check_and_restart(m);
    assert_eq(_test_vec_contains_cstr(r1, "c1"), 1, "restart 1");
    # Second restart.
    var r2 = health_monitor_check_and_restart(m);
    assert_eq(_test_vec_contains_cstr(r2, "c1"), 1, "restart 2");
    # Third attempt -> no restart (max_retries = 2).
    var r3 = health_monitor_check_and_restart(m);
    assert_eq(_test_vec_contains_cstr(r3, "c1"), 0, "no restart 3");
    assert_eq(health_monitor_restart_count(m, "c1"), 2, "count capped at 2");
    return 0;
}

fn test_health_unless_stopped_respects_user_stop() {
    test_group("health_unless_stopped_respects_user_stop");
    var cfg = heartbeat_config_new(0, 0, 0);
    var m = health_monitor_with_config(cfg);
    health_monitor_register(m, "c1", HEALTH_RESTART_UNLESS_STOPPED, 0);
    health_monitor_mark_user_stopped(m, "c1");
    var needs = health_monitor_check_and_restart(m);
    assert_eq(_test_vec_contains_cstr(needs, "c1"), 0, "user-stopped -> no restart");
    return 0;
}

