fn test_container_require_pid() {
    test_group("container_require_pid");
    var allowed = vec_new();
    vec_push(allowed, CONTAINER_STATE_RUNNING);
    # Running + valid pid -> pid.
    assert_eq(container_require_pid(CONTAINER_STATE_RUNNING, 4321, allowed, 1), 4321, "running+pid");
    # Wrong state -> -1 (InvalidState).
    assert_eq(container_require_pid(CONTAINER_STATE_CREATED, 4321, allowed, 1), 0 - 1, "wrong state");
    # Right state but no pid -> -1.
    assert_eq(container_require_pid(CONTAINER_STATE_RUNNING, 0 - 1, allowed, 1), 0 - 1, "no pid");
    # Multi-state allowed set.
    var allowed2 = vec_new();
    vec_push(allowed2, CONTAINER_STATE_RUNNING);
    vec_push(allowed2, CONTAINER_STATE_PAUSED);
    assert_eq(container_require_pid(CONTAINER_STATE_PAUSED, 7, allowed2, 2), 7, "paused allowed");
    return 0;
}

fn test_container_fixup_after_restart() {
    test_group("container_fixup_after_restart");
    var cfg = container_config_default();
    # Running -> Stopped, pid cleared, changed=1.
    var r: Container = container_new("i", 0, "im", "ref", CONTAINER_STATE_RUNNING, 99, 0, 0 - 1, cfg, 0 - 1);
    assert_eq(container_fixup_after_restart(r), 1, "running changed");
    assert_eq(r.state, CONTAINER_STATE_STOPPED, "now stopped");
    assert_eq(r.pid, 0 - 1, "pid cleared");
    # Paused -> Stopped too.
    var p: Container = container_new("i", 0, "im", "ref", CONTAINER_STATE_PAUSED, 5, 0, 0 - 1, cfg, 0 - 1);
    assert_eq(container_fixup_after_restart(p), 1, "paused changed");
    assert_eq(p.state, CONTAINER_STATE_STOPPED, "paused now stopped");
    # Stopped stays put, changed=0.
    var s: Container = container_new("i", 0, "im", "ref", CONTAINER_STATE_STOPPED, 0 - 1, 0, 0 - 1, cfg, 0);
    assert_eq(container_fixup_after_restart(s), 0, "stopped unchanged");
    assert_eq(s.state, CONTAINER_STATE_STOPPED, "still stopped");
    return 0;
}

fn test_container_should_rotate() {
    test_group("container_should_rotate");
    # Disabled when either bound is 0.
    assert_eq(container_should_rotate(0, 3, 100, 100), 0, "max_bytes 0");
    assert_eq(container_should_rotate(100, 0, 100, 100), 0, "max_files 0");
    # Under limit -> no rotate.
    assert_eq(container_should_rotate(1000, 3, 500, 200), 0, "under limit");
    # Over limit -> rotate.
    assert_eq(container_should_rotate(1000, 3, 900, 200), 1, "over limit");
    return 0;
}

fn test_container_tail_start() {
    test_group("container_tail_start");
    # rust-old: saturating_sub(lines).
    assert_eq(container_tail_start(5, 3), 2, "5-3=2");
    assert_eq(container_tail_start(2, 10), 0, "saturating to 0");
    assert_eq(container_tail_start(3, 3), 0, "exact");
    return 0;
}

