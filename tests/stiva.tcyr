fn test_network_mode_name() {
    test_group("network_mode_name");
    assert_eq(streq(network_mode_name(NETWORK_MODE_BRIDGE), "Bridge"), 1, "Bridge");
    assert_eq(streq(network_mode_name(NETWORK_MODE_HOST), "Host"), 1, "Host");
    assert_eq(streq(network_mode_name(NETWORK_MODE_NONE), "None"), 1, "None");
    assert_eq(streq(network_mode_name(NETWORK_MODE_CONTAINER), "Container"), 1, "Container");
    assert_eq(streq(network_mode_name(NETWORK_MODE_CUSTOM), "Custom"), 1, "Custom");
    return 0;
}

fn test_network_mode_container() {
    test_group("network_mode_container");
    var a: NetworkModeVal = network_mode_new(NETWORK_MODE_CONTAINER, "abc123");
    var b: NetworkModeVal = network_mode_new(NETWORK_MODE_CONTAINER, "abc123");
    assert_eq(network_mode_eq(a, b), 1, "same payload equal");
    var c: NetworkModeVal = network_mode_new(NETWORK_MODE_CONTAINER, "other");
    assert_eq(network_mode_eq(a, c), 0, "diff payload not equal");
    var d: NetworkModeVal = network_mode_new(NETWORK_MODE_CUSTOM, "abc123");
    assert_eq(network_mode_eq(a, d), 0, "diff tag not equal");
    var e: NetworkModeVal = network_mode_new(NETWORK_MODE_BRIDGE, 0);
    var f: NetworkModeVal = network_mode_new(NETWORK_MODE_BRIDGE, 0);
    assert_eq(network_mode_eq(e, f), 1, "bridge equal");
    return 0;
}

