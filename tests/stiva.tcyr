}

# copy_into_container places a host file under the rootfs, creating parent dirs
# (rust-old runtime.rs: copy_into_container_creates_file).
fn test_runtime_copy_into_container() {
    test_group("runtime_copy_into_container");
    sys_mkdir("/tmp/stiva_cp_in", 0x1ED);
    sys_mkdir("/tmp/stiva_cp_in/rootfs", 0x1ED);
    file_write_all("/tmp/stiva_cp_in/hello.txt", "hello", 5);
    assert_eq(copy_into_container("/tmp/stiva_cp_in/rootfs",
    "/tmp/stiva_cp_in/hello.txt", "/app/hello.txt"), 0, "copy ok");
    var buf = alloc(64);
    var n = file_read_all("/tmp/stiva_cp_in/rootfs/app/hello.txt", buf, 63);
    store8(buf + n, 0);
    assert_eq(streq(buf, "hello"), 1, "content hello");
    return 0;
}

# copy_from_container extracts a rootfs file to the host (rust-old runtime.rs:
# copy_from_container_reads_file).
fn test_runtime_copy_from_container() {
    test_group("runtime_copy_from_container");
    sys_mkdir("/tmp/stiva_cp_out", 0x1ED);
