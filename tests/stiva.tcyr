fn test_registry_descriptor_serde() {
    test_group("registry_descriptor_serde");
    var d = descriptor_new(media_oci_config(), "sha256:cfg", 100);
    var json = json_v_build(descriptor_to_jv(d));
    var cs = str_cstr(json);
    assert_eq(strstr(cs, "\"mediaType\":\"application/vnd.oci.image.config.v1+json\"") >= 0, 1, "has mediaType");
    assert_eq(strstr(cs, "\"digest\":\"sha256:cfg\"") >= 0, 1, "has digest");
    assert_eq(strstr(cs, "\"size\":100") >= 0, 1, "has size");
    assert_eq(strstr(cs, "urls") >= 0, 0, "no urls key when None");
    var back = descriptor_from_jv(bayan_json_v_parse_str(str_data(json), str_len(json)));
    var bb: Descriptor = back;
    assert_eq(streq(bb.media_type, media_oci_config()), 1, "media_type round-trip");
    assert_eq(streq(bb.digest, "sha256:cfg"), 1, "digest round-trip");
    assert_eq(bb.size, 100, "size round-trip");
    assert_eq(bb.urls, 0, "urls None round-trip");
    var badj = "{\"digest\":\"sha256:x\",\"size\":1}";
    assert_eq(descriptor_from_jv(bayan_json_v_parse_str(badj, strlen(badj))), 0, "missing mediaType -> 0");
    # size must be an integer (strict) — a string size is rejected, not coerced to 0.
    var badsize = "{\"mediaType\":\"x\",\"digest\":\"sha256:y\",\"size\":\"123\"}";
    assert_eq(descriptor_from_jv(bayan_json_v_parse_str(badsize, strlen(badsize))), 0, "string size -> 0");
    return 0;
}

fn test_registry_manifest_serde() {
    test_group("registry_manifest_serde");
    var cfg = descriptor_new(media_oci_config(), "sha256:cfg", 100);
    var layers = vec_new();
    vec_push(layers, descriptor_new(media_oci_layer(), "sha256:lay", 200));
    var m = oci_manifest_new(cfg, layers);
    var mm: OciManifest = m;
    mm.media_type = media_oci_manifest();
    var json = json_v_build(oci_manifest_to_jv(m));
    var cs = str_cstr(json);
    assert_eq(strstr(cs, "\"schemaVersion\":2,\"mediaType\":") >= 0, 1, "schemaVersion before mediaType");
    assert_eq(strstr(cs, "\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\"") >= 0, 1, "config descriptor");
    assert_eq(strstr(cs, "\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar+gzip\"") >= 0, 1, "layers array");
    var json2 = json_v_build(oci_manifest_to_jv(m));
    assert_eq(streq(str_cstr(json2), cs), 1, "deterministic build");
    var back = oci_manifest_from_jv(bayan_json_v_parse_str(str_data(json), str_len(json)));
    var bm: OciManifest = back;
    assert_eq(bm.schema_version, 2, "schema_version round-trip");
    assert_eq(streq(bm.media_type, media_oci_manifest()), 1, "media_type round-trip");
    var bcfg: Descriptor = bm.config;
    assert_eq(streq(bcfg.digest, "sha256:cfg"), 1, "config digest round-trip");
    assert_eq(vec_len(bm.layers), 1, "one layer round-trip");
    var blay: Descriptor = vec_get(bm.layers, 0);
    assert_eq(streq(blay.digest, "sha256:lay"), 1, "layer digest round-trip");
    assert_eq(blay.size, 200, "layer size round-trip");
    var badj = "{\"schemaVersion\":2,\"layers\":[]}";
    assert_eq(oci_manifest_from_jv(bayan_json_v_parse_str(badj, strlen(badj))), 0, "missing config -> 0");
    return 0;
}

