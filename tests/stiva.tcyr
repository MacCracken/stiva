}

fn test_dns_parse_ipv4_reject() {
    test_group("network_dns::parse_ipv4_reject");
    assert_eq(network_dns_parse_ipv4("::1"), network_dns_ipv4_invalid(), "ipv6 rejected");
    assert_eq(network_dns_parse_ipv4("1.2.3"), network_dns_ipv4_invalid(), "three octets");
    assert_eq(network_dns_parse_ipv4("1.2.3.4.5"), network_dns_ipv4_invalid(), "five octets");
    assert_eq(network_dns_parse_ipv4("256.0.0.1"), network_dns_ipv4_invalid(), "octet overflow");
    assert_eq(network_dns_parse_ipv4("1.2.3.4 "), network_dns_ipv4_invalid(), "trailing space");
    assert_eq(network_dns_parse_ipv4("0.0.0.0"), 0, "zero packs to 0");
    return 0;
}

