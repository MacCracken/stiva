fn test_dns_registry_inject() {
    test_group("dns_registry_inject");
    var reg: DnsRegistry = dns_registry_new();
    dns_registry_register(reg, "db", "172.17.0.3");
    sys_mkdir("/tmp/nm_inject_test", 448);
    var rc = dns_registry_inject_into(reg, "/tmp/nm_inject_test", "172.17.0.2", "web");
    assert_eq(rc, STIVA_ERR_OK, "inject ok");
    var buf = alloc(4096);
    var n = file_read_all("/tmp/nm_inject_test/etc/hosts", buf, 4095);
    store8(buf + n, 0);
    assert_eq(strstr(buf, "172.17.0.2\tweb") >= 0, 1, "self entry");
    assert_eq(strstr(buf, "172.17.0.3\tdb") >= 0, 1, "db entry");
    assert_eq(strstr(buf, "127.0.0.1\tlocalhost") >= 0, 1, "localhost");
    return 0;
}

