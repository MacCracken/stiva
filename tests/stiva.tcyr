fn test_container_state_serde() {
    test_group("container_state_serde");
    # Round-trip name <-> ordinal for every variant (rust-old container_state_serde).
    assert_eq(container_state_from_name(container_state_name(CONTAINER_STATE_CREATED)), CONTAINER_STATE_CREATED, "Created rt");
    assert_eq(container_state_from_name(container_state_name(CONTAINER_STATE_RUNNING)), CONTAINER_STATE_RUNNING, "Running rt");
    assert_eq(container_state_from_name(container_state_name(CONTAINER_STATE_PAUSED)), CONTAINER_STATE_PAUSED, "Paused rt");
    assert_eq(container_state_from_name(container_state_name(CONTAINER_STATE_STOPPED)), CONTAINER_STATE_STOPPED, "Stopped rt");
    assert_eq(container_state_from_name(container_state_name(CONTAINER_STATE_REMOVING)), CONTAINER_STATE_REMOVING, "Removing rt");
    assert_eq(streq(container_state_name(CONTAINER_STATE_RUNNING), "Running"), 1, "Running token");
    assert_eq(container_state_from_name("Bogus"), 0 - 1, "unknown token -> -1");
    return 0;
}

