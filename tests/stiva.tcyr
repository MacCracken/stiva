# -- Layer unpacking (gzip-tar) tests --

# Write an octal size field of `len` bytes at `p` (NUL-padded), for a USTAR
# header. Matches _stor_parse_octal's leniency (leading/trailing NULs ok).
fn _t_write_octal(p, len, val) {
    var i = len - 1;
    var v = val;
    while (i >= 0) {
        store8(p + i, 48 + (v & 7));   # '0' + low octal digit
        v = v / 8;
        i = i - 1;
    }
    return 0;
}

# Build a single-file USTAR archive (name + data) into `out`, returning the
# total byte length. Layout: 512 header (name@0, size octal @124, typeflag
# '0' @156) + ceil(size/512) data blocks + two 512-byte zero blocks (EOF).
fn _t_build_tar(out, name, data, dlen) {
    var i = 0;
    while (i < 5120) { store8(out + i, 0); i = i + 1; }   # zero the whole scratch

    # name @0
    var nl = strlen(name);
    memcpy(out, name, nl);
    # size @124 (12-byte octal field; write low 11 digits + trailing NUL)
    _t_write_octal(out + 124, 11, dlen);
    store8(out + 124 + 11, 0);
    # typeflag @156 = '0' (regular file)
    store8(out + 156, 48);

    # data blocks
    memcpy(out + 512, data, dlen);
    var blocks = (dlen + 511) / 512;
    var total = 512 + (blocks * 512);
    # two zero blocks already zero (scratch pre-zeroed) — advance past them.
    return total + 1024;
}

# _stor_parse_octal decodes ASCII octal, ignoring non-octal padding.
fn test_stor_parse_octal() {
    test_group("stor_parse_octal");
    var buf = alloc(16);
    var i = 0;
    while (i < 16) { store8(buf + i, 0); i = i + 1; }
    # "644" -> 0o644 = 420
    store8(buf, 54); store8(buf + 1, 52); store8(buf + 2, 52);
    assert_eq(_stor_parse_octal(buf, 12), 420, "0o644 = 420");
    return 0;
}

# End-to-end: gzip a hand-built USTAR archive, unpack_layer it, read back.
fn test_unpack_layer_gz_roundtrip() {
    test_group("unpack_layer_gz_roundtrip");
    var dir = "/tmp/stiva-unpack-test";
    sys_mkdir(dir, 493);
    var blob = _stor_cat2(dir, "/layer.tar.gz");
    var dest = _stor_cat2(dir, "/unpacked");
    sys_mkdir(dest, 493);

    # Build the tar, gzip it, write the blob.
    var tar = alloc(5120);
    var data = "hello from layer";
    var tlen = _t_build_tar(tar, "etc/hello.txt", data, strlen(data));
    var gz = alloc(8192);
    var glen = gzip_compress(tar, tlen, gz, 8192);
    assert(glen > 0, "gzip compressed");
    file_write_all(blob, gz, glen);

    var rc = unpack_layer(blob, dest);
    assert_eq(rc, 0, "unpack ok");

    # Read back etc/hello.txt.
    var out = _stor_cat2(dest, "/etc/hello.txt");
    var rbuf = alloc(64);
    var n = file_read_all(out, rbuf, 64);
    store8(rbuf + n, 0);
    assert_eq(streq(rbuf, "hello from layer"), 1, "content round-trips");
    return 0;
}

# unpack_layer on a nonexistent blob returns the -1 failure sentinel.
fn test_unpack_layer_missing_blob() {
    test_group("unpack_layer_missing_blob");
    assert_eq(unpack_layer("/nonexistent/stiva/blob", "/tmp"), 0 - 1, "missing blob = -1");
    return 0;
}

# unpack_layer on non-gzip bytes fails (-1) — the zstd fallback is deferred.
fn test_unpack_layer_not_gzip() {
    test_group("unpack_layer_not_gzip");
    var dir = "/tmp/stiva-unpack-badgz";
    sys_mkdir(dir, 493);
    var blob = _stor_cat2(dir, "/bad.tar.gz");
    file_write_all(blob, "this is not gzip", 16);
    assert_eq(unpack_layer(blob, dir), 0 - 1, "non-gzip = -1");
    return 0;
}

# prepare_layers on a store with no matching blob returns 0 (LayerUnpack).
fn test_prepare_layers_missing_blob() {
    test_group("prepare_layers_missing_blob");
    var root = "/tmp/stiva-prep-missing";
    var store = image_store_new(root);
    assert(store != 0, "store created");
    var layers = vec_new();
    vec_push(layers, layer_new("sha256:doesnotexist", 0, "application/vnd.oci.image.layer.v1.tar+gzip"));
    assert_eq(prepare_layers(store, layers), 0, "missing blob => 0");
    return 0;
}

# prepare_layers unpacks a real gzip'd layer, then dedups on a second call.
fn test_prepare_layers_dedup() {
    test_group("prepare_layers_dedup");
    var root = "/tmp/stiva-prep-dedup";
    var store = image_store_new(root);
    assert(store != 0, "store created");

    # Build a gzip'd tar blob and store it by its true digest.
    var tar = alloc(5120);
    var data = "layer content";
    var tlen = _t_build_tar(tar, "file.txt", data, strlen(data));
    var gz = alloc(8192);
    var glen = gzip_compress(tar, tlen, gz, 8192);
    assert(glen > 0, "gzip ok");
    var digest = sha256_digest(gz, glen);
    var stored = image_store_store_blob(store, digest, gz, glen);
    assert(stored != 0, "blob stored");

    var layers = vec_new();
    vec_push(layers, layer_new(digest, glen, "application/vnd.oci.image.layer.v1.tar+gzip"));

    # First prepare: unpacks.
    var dirs = prepare_layers(store, layers);
    assert(dirs != 0, "prepare ok");
    assert_eq(vec_len(dirs), 1, "one dir");
    var d0 = vec_get(dirs, 0);
    var f0 = _stor_cat2(d0, "/file.txt");
    assert_eq(file_exists(f0), 1, "file.txt extracted");
    var m0 = _stor_cat2(d0, "/.unpacked");
    assert_eq(file_exists(m0), 1, ".unpacked marker written");

    # Second prepare: dedup (marker present → skip), same dir returned.
    var layers2 = vec_new();
    vec_push(layers2, layer_new(digest, glen, "application/vnd.oci.image.layer.v1.tar+gzip"));
    var dirs2 = prepare_layers(store, layers2);
    assert(dirs2 != 0, "prepare2 ok");
    assert_eq(vec_len(dirs2), 1, "one dir (dedup)");
    assert_eq(streq(vec_get(dirs2, 0), d0), 1, "same layer dir");
    return 0;
}

# ── build.cyr (rust-old/src/build.rs) ──
# ── build.cyr (rust-old/src/build.rs) ────────────────────────────
# Mirrors the portable subset of build.rs's #[cfg(test)] module. The
# serde-round-trip / tar.gz layer-builder tests remain DEFERRED with their
# functions (JSON codec + tar/gzip). parse_build_spec now lands (bayan TOML
# object model) and is mirrored below (rust-old parse_full_spec /
# parse_minimal_spec / parse_no_steps / parse_missing_image_section /
# parse_unknown_step_type / step_variants).

