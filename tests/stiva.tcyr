fn test_container_serde_round_trip() {
    test_group("container_serde_round_trip");
    # Build a Container like rust-old container_serde_round_trip and read fields back.
    var cfg: ContainerConfig = container_config_default();
    cfg.memory_limit = 256 * 1024 * 1024;
    cfg.user = "nobody";
    var c: Container = container_new("abc-123", "web", "sha256:img",
    "docker.io/library/nginx:latest", CONTAINER_STATE_STOPPED, 0 - 1,
    1000, 2000, cfg, 0);
    assert_eq(streq(c.id, "abc-123"), 1, "id");
    assert_eq(c.state, CONTAINER_STATE_STOPPED, "state Stopped");
    assert_eq(c.exit_code, 0, "exit_code 0");
    var ccfg: ContainerConfig = c.config;
    assert_eq(ccfg.memory_limit, 256 * 1024 * 1024, "config memory_limit");
    assert_eq(streq(ccfg.user, "nobody"), 1, "config user");
    return 0;
}

