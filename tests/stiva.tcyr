fn test_load_key_from_file() {
    test_group("load_key_from_file");
    # Mirrors rust-old load_key_from_file: write 32 x 0x42 bytes, load, compare.
    var path = "/tmp/stiva_enc_test.key";
    var kd = alloc(32);
    memset(kd, 0x42, 32);
    file_write_all(path, kd, 32);
    var src = key_source_new_file(path);
    var len = alloc(8);
    var loaded = load_key(src, len);
    assert(loaded != 0, "key loaded");
    assert_eq(load64(len), 32, "32 bytes");
    assert_eq(load8(loaded), 0x42, "first byte 0x42");
    return 0;
}

