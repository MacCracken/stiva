# ── ansamblu.cyr ──
fn test_ansamblu_replica_count() {
    test_group("ansamblu_replica_count");
    # replicas = None (-1) → 1
    var s0 = service_def_new("x", 0, 0, 0, 0, 0);
    assert_eq(replica_count(s0), 1, "replica_count_default");
    # replicas = 0 → max(1) → 1
    var s1: ServiceDef = service_def_new("x", 0, 0, 0, 0, 0);
    s1.replicas = 0;
    assert_eq(replica_count(s1), 1, "replica_count_zero_becomes_one");
    # replicas = 3 → 3
    var s3: ServiceDef = service_def_new("x", 0, 0, 0, 0, 0);
    s3.replicas = 3;
    assert_eq(replica_count(s3), 3, "replica_count_three");
    return 0;
}

fn test_ansamblu_service_to_config() {
    test_group("ansamblu_service_to_config");
    # basic: single replica → name is the service name, env/ports carried
    var env = map_new();
    map_set(env, "PORT", "80");
    var ports = vec_new();
    vec_push(ports, "8080:80");
    var svc = service_def_new("nginx", 0, env, ports, 0, 0);
    var cfg = service_to_config("web", svc, 0);
    assert_eq(streq(load64(cfg), "web"), 1, "s2c_basic_name");            # name @0
    assert_eq(streq(map_get(load64(cfg + 16), "PORT"), "80"), 1, "s2c_env"); # env @16
    assert_eq(streq(vec_get(load64(cfg + 32), 0), "8080:80"), 1, "s2c_ports"); # ports @32

    # replicas > 1 → "{service}-{index}"
    var w: ServiceDef = service_def_new("worker", 0, 0, 0, 0, 0);
    w.replicas = 3;
    var c0 = service_to_config("worker", w, 0);
    var c1 = service_to_config("worker", w, 1);
    var c2 = service_to_config("worker", w, 2);
    assert_eq(streq(load64(c0), "worker-0"), 1, "s2c_r0");
    assert_eq(streq(load64(c1), "worker-1"), 1, "s2c_r1");
    assert_eq(streq(load64(c2), "worker-2"), 1, "s2c_r2");
    return 0;
}

fn test_ansamblu_compute_scale() {
    test_group("ansamblu_compute_scale");
    var services = map_new();
    var ids = vec_new();
    vec_push(ids, "c0");
    vec_push(ids, "c1");
    map_set(services, "web", ids);
    var sess = ansamblu_session_new("s", services, vec_new(), vec_new(), 0);

    var out = alloc(16);
    # scale up 2 → 4: to_add 2, to_remove empty
    compute_scale(sess, "web", 4, out);
    assert_eq(load64(out), 2, "scale_up_add");
    assert_eq(vec_len(load64(out + 8)), 0, "scale_up_no_remove");
    # scale down 2 → 1: to_add 0, to_remove = last id (newest-first) = "c1"
    compute_scale(sess, "web", 1, out);
    assert_eq(load64(out), 0, "scale_down_no_add");
    assert_eq(vec_len(load64(out + 8)), 1, "scale_down_one");
    assert_eq(streq(vec_get(load64(out + 8), 0), "c1"), 1, "scale_down_newest_first");
    # scale equal 2 → 2: nothing
    compute_scale(sess, "web", 2, out);
    assert_eq(load64(out), 0, "scale_eq_no_add");
    assert_eq(vec_len(load64(out + 8)), 0, "scale_eq_no_remove");
    # absent service scaled to 3: add 3
    compute_scale(sess, "ghost", 3, out);
    assert_eq(load64(out), 3, "scale_absent_add");
    return 0;
}

fn test_ansamblu_startup_order() {
    test_group("ansamblu_startup_order");
    # linear: frontend -> api -> db  (expect db before api before frontend)
    var services = map_new();
    var fe = service_def_new("nginx", 0, 0, 0, 0, 0);
    var fe_deps = vec_new(); vec_push(fe_deps, "api");
    var fes: ServiceDef = fe; fes.depends_on = fe_deps;
    var api = service_def_new("app", 0, 0, 0, 0, 0);
    var api_deps = vec_new(); vec_push(api_deps, "db");
    var apis: ServiceDef = api; apis.depends_on = api_deps;
    var db = service_def_new("postgres", 0, 0, 0, 0, 0);
    map_set(services, "frontend", fe);
    map_set(services, "api", api);
    map_set(services, "db", db);
    var spec = ansamblu_file_new(services, map_new(), map_new());

    var order = resolve_startup_order(spec);
    assert_neq(order, 0, "order_no_cycle");
    assert_eq(vec_len(order), 3, "order_len");
    # find positions
    var db_pos = 0 - 1;
    var api_pos = 0 - 1;
    var fe_pos = 0 - 1;
    var i = 0;
    while (i < vec_len(order)) {
        var nm = vec_get(order, i);
        if (streq(nm, "db") == 1) { db_pos = i; }
        if (streq(nm, "api") == 1) { api_pos = i; }
        if (streq(nm, "frontend") == 1) { fe_pos = i; }
        i = i + 1;
    }
    assert_eq(db_pos < api_pos, 1, "db_before_api");
    assert_eq(api_pos < fe_pos, 1, "api_before_frontend");
    return 0;
}

fn test_ansamblu_startup_order_cycle() {
    test_group("ansamblu_startup_order_cycle");
    # a -> b -> a is a cycle → resolve_startup_order returns 0
    var services = map_new();
    var a = service_def_new("a", 0, 0, 0, 0, 0);
    var a_deps = vec_new(); vec_push(a_deps, "b");
    var as1: ServiceDef = a; as1.depends_on = a_deps;
    var b = service_def_new("b", 0, 0, 0, 0, 0);
    var b_deps = vec_new(); vec_push(b_deps, "a");
    var bs: ServiceDef = b; bs.depends_on = b_deps;
    map_set(services, "a", a);
    map_set(services, "b", b);
    var spec = ansamblu_file_new(services, map_new(), map_new());
    assert_eq(resolve_startup_order(spec), 0, "cycle_returns_zero");
    return 0;
}

fn test_ansamblu_ready_services() {
    test_group("ansamblu_ready_services");
    # db (no deps), api (depends_on db)
    var services = map_new();
    var db = service_def_new("postgres", 0, 0, 0, 0, 0);
    var api = service_def_new("app", 0, 0, 0, 0, 0);
    var api_deps = vec_new(); vec_push(api_deps, "db");
    var apis: ServiceDef = api; apis.depends_on = api_deps;
    map_set(services, "db", db);
    map_set(services, "api", api);
    var spec = ansamblu_file_new(services, map_new(), map_new());

    # initial: db ready, api not
    var ready0 = ready_services(spec, 0);
    var db_ready0 = 0;
    var api_ready0 = 0;
    var i = 0;
    while (i < vec_len(ready0)) {
        if (streq(vec_get(ready0, i), "db") == 1) { db_ready0 = 1; }
        if (streq(vec_get(ready0, i), "api") == 1) { api_ready0 = 1; }
        i = i + 1;
    }
    assert_eq(db_ready0, 1, "db_ready_initial");
    assert_eq(api_ready0, 0, "api_not_ready_initial");

    # after db completed: api ready, db no longer (it is completed)
    var completed = map_new();
    map_set(completed, "db", 1);
    var ready1 = ready_services(spec, completed);
    var api_ready1 = 0;
    i = 0;
    while (i < vec_len(ready1)) {
        if (streq(vec_get(ready1, i), "api") == 1) { api_ready1 = 1; }
        i = i + 1;
    }
    assert_eq(api_ready1, 1, "api_ready_after_db");
    return 0;
}

fn test_ansamblu_plan_rolling_update() {
    test_group("ansamblu_plan_rolling_update");
    var services = map_new();
    var ids = vec_new();
    vec_push(ids, "old0");
    map_set(services, "web", ids);
    var sess = ansamblu_session_new("s", services, vec_new(), vec_new(), 0);

    var newsvc: ServiceDef = service_def_new("nginx:2", 0, 0, 0, 0, 0);
    newsvc.replicas = 2;
    var plan: RollingUpdatePlan = plan_rolling_update(sess, "web", newsvc);
    assert_eq(streq(plan.service_name, "web"), 1, "plan_name");
    assert_eq(streq(plan.new_image, "nginx:2"), 1, "plan_image");
    assert_eq(plan.new_replica_count, 2, "plan_count");
    assert_eq(vec_len(plan.old_containers), 1, "plan_old_len");
    assert_eq(streq(vec_get(plan.old_containers, 0), "old0"), 1, "plan_old_id");
    # config defaults 1/1/10
    var cfg: RollingUpdateConfig = plan.config;
    assert_eq(cfg.max_surge, 1, "plan_cfg_surge");
    assert_eq(cfg.max_unavailable, 1, "plan_cfg_unavail");
    assert_eq(cfg.delay_secs, 10, "plan_cfg_delay");

    # absent service → empty old_containers
    var plan2: RollingUpdatePlan = plan_rolling_update(sess, "ghost", newsvc);
    assert_eq(vec_len(plan2.old_containers), 0, "plan_absent_empty");
    return 0;
}

fn test_ansamblu_defaults() {
    test_group("ansamblu_defaults");
    # HealthCheck serde defaults
    var hc: HealthCheck = health_check_new(vec_new());
    assert_eq(hc.interval_secs, 30, "hc_interval");
    assert_eq(hc.timeout_secs, 5, "hc_timeout");
    assert_eq(hc.retries, 3, "hc_retries");
    # NetworkDef / VolumeDef defaults are None (0)
    var nd: NetworkDef = network_def_default();
    assert_eq(nd.driver, 0, "netdef_driver_none");
    assert_eq(nd.subnet, 0, "netdef_subnet_none");
    var vd_p = volume_def_default();
    assert_eq(load64(vd_p), 0, "voldef_driver_none");
    # RollingUpdateConfig default
    var ruc: RollingUpdateConfig = rolling_update_config_default();
    assert_eq(ruc.max_surge, 1, "ruc_surge");
    assert_eq(ruc.max_unavailable, 1, "ruc_unavail");
    assert_eq(ruc.delay_secs, 10, "ruc_delay");
    return 0;
}


# ── agent.cyr ──
# ── agent module tests (mirror rust-old/src/agent.rs #[cfg(test)]) ──
# Builds a Container* raw record matching src/container.cyr's field layout
# (8-byte fields: id@0 name@8 image_id@16 image_ref@24 state@32 pid@40
#  created_at@48 started_at@56 config@64 exit_code@72) and a ContainerConfig*
# whose ports field is at offset 32. The three HTTP mock tests
# (register_with_mock / deregister_with_mock / report_status_with_mock /
#  register_failure) are omitted: they require wiremock + async reqwest,
# which the ported base lacks (deferred alongside the network functions).

# Allocate a ContainerConfig* with only `ports` populated (offset 32).
fn _agent_test_config(ports) {
    var cfg = alloc(200);
    memset(cfg, 0, 200);
    store64(cfg + 32, ports);      # ports @ field index 4
    return cfg;
}

# Allocate a Container* mirroring rust-old test_container(): id, optional
# name (0 = None), image_id, image_ref, state, config.
fn _agent_test_container(id, name, image_id, image_ref, state, config) {
    var c = alloc(80);
    memset(c, 0, 80);
    store64(c + 0, id);
    store64(c + 8, name);
    store64(c + 16, image_id);
    store64(c + 24, image_ref);
    store64(c + 32, state);
    store64(c + 64, config);
    return c;
}

# True (1) iff cstr `needle` is an element of vec `v`.
fn _agent_caps_contains(v, needle) {
    var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        if (streq(vec_get(v, i), needle) == 1) { return 1; }
    }
    return 0;
}

fn test_agent_build_registration_from_container() {
    test_group("agent_build_registration_from_container");
    var ports = vec_new();
    vec_push(ports, "8080:80");
    var cfg = _agent_test_config(ports);
    var c = _agent_test_container("abc123def456", "web-server",
    "sha256:img", "docker.io/library/nginx:latest",
    CONTAINER_STATE_RUNNING, cfg);

    var reg = build_registration(c);
    var r: AgentRegistration = reg;
    assert_eq(streq(r.id, "abc123def456"), 1, "id");
    assert_eq(streq(r.name, "web-server"), 1, "name");
    assert_eq(streq(r.agent_type, "container"), 1, "agent_type is container");
    assert_eq(_agent_caps_contains(r.capabilities, "stiva"), 1,
    "capabilities contains stiva");
    return 0;
}

fn test_agent_build_registration_no_name() {
    test_group("agent_build_registration_no_name");
    var ports = vec_new();
    var cfg = _agent_test_config(ports);
    # name = 0 (None) → falls back to first 12 chars of id.
    var c = _agent_test_container("abc123def456", 0,
    "sha256:img", "docker.io/library/nginx:latest",
    CONTAINER_STATE_RUNNING, cfg);

    var reg = build_registration(c);
    var r: AgentRegistration = reg;
    assert_eq(streq(r.name, "abc123def456"), 1, "name falls back to first 12 of id");
    return 0;
}

fn test_agent_first12_truncates() {
    test_group("agent_first12_truncates");
    # Long id → exactly 12 chars.
    var got = _agent_first12("0123456789abcdefghij");
    assert_eq(streq(got, "0123456789ab"), 1, "truncated to 12");
    assert_eq(strlen(got), 12, "length 12");
    # Short id (< 12) → whole string preserved.
    var got2 = _agent_first12("short");
    assert_eq(streq(got2, "short"), 1, "short id preserved");
    return 0;
}

fn test_agent_registration_serde() {
    test_group("agent_registration_serde");
    # rust-old round-trips through JSON; Cyrius base has no serde, so verify
    # the struct stores/returns its fields faithfully (parity on the payload).
    var caps = vec_new();
    vec_push(caps, "stiva");
    var rp = alloc(40);
    var reg: AgentRegistration = rp;
    reg.id = "c1";
    reg.name = "web";
    reg.agent_type = "container";
    reg.capabilities = caps;
    reg.metadata = 0;
    assert_eq(streq(reg.id, "c1"), 1, "id round-trips");
    assert_eq(streq(reg.name, "web"), 1, "name round-trips");
    return 0;
}

fn test_agent_status_serde() {
    test_group("agent_status_serde");
    var s = agent_status_new("c1", "running", 0);
    var st: AgentStatus = s;
    assert_eq(streq(st.id, "c1"), 1, "id");
    assert_eq(streq(st.status, "running"), 1, "status round-trips");
    assert_eq(st.metadata, 0, "metadata none");
    return 0;
}

