fn test_network_manager_delete_network_with_connections_fails() {
    test_group("network_manager_delete_network_with_connections_fails");
    var mgr = network_manager_new();
    var rc1 = network_manager_create_network(mgr, "busy", "10.2.0.0/24");
    assert_eq(rc1, STIVA_ERR_OK, "create busy ok");
    var e1 = vec_new();
    var cn = network_manager_connect_container(mgr, "c1-abcdef123456", "busy", e1, 0);
    assert(cn != 0, "connected to busy");
    var rc2 = network_manager_delete_network(mgr, "busy");
    assert_eq(rc2, STIVA_ERR_NETWORK, "delete busy with connections errors");
    return 0;
}

