    sys_mkdir("/tmp/stiva_cp_out/rootfs/data", 0x1ED);
    file_write_all("/tmp/stiva_cp_out/rootfs/data/out.txt", "result", 6);
    assert_eq(copy_from_container("/tmp/stiva_cp_out/rootfs", "/data/out.txt",
    "/tmp/stiva_cp_out/output.txt"), 0, "copy ok");
    var buf = alloc(64);
    var n = file_read_all("/tmp/stiva_cp_out/output.txt", buf, 63);
    store8(buf + n, 0);
    assert_eq(streq(buf, "result"), 1, "content result");
    return 0;
}

# copy_from_container errors when the source is absent (rust-old runtime.rs:
# copy_from_container_missing_source).
fn test_runtime_copy_from_missing() {
