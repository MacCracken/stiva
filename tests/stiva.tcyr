fn test_container_network() {
    test_group("container_network");
    var cn: ContainerNetwork = container_network_new("172.17.0.2", 0, "bridge", "veth-abc", "eth0");
    assert_eq(streq(cn.ip, "172.17.0.2"), 1, "ip");
    assert_eq(cn.ipv6, 0, "ipv6 none");
    assert_eq(streq(cn.container_veth, "eth0"), 1, "container_veth");
