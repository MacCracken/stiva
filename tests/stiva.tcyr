# ── error.cyr (rust-old/src/error.rs) ────────────────────────────
fn test_error_names() {
    test_group("error_names");
    assert_eq(streq(stiva_err_name(STIVA_ERR_OK), "ok"), 1, "ok");
    assert_eq(streq(stiva_err_name(STIVA_ERR_IMAGE_NOT_FOUND), "image not found"), 1, "image not found");
    assert_eq(streq(stiva_err_name(STIVA_ERR_CONTAINER_NOT_FOUND), "container not found"), 1, "container not found");
    assert_eq(streq(stiva_err_name(STIVA_ERR_ALREADY_RUNNING), "container already running"), 1, "already running");
    assert_eq(streq(stiva_err_name(STIVA_ERR_INVALID_STATE), "invalid state"), 1, "invalid state");
    assert_eq(streq(stiva_err_name(STIVA_ERR_DIGEST_MISMATCH), "digest mismatch"), 1, "digest mismatch");
    assert_eq(streq(stiva_err_name(STIVA_ERR_AUTH_FAILED), "authentication failed"), 1, "auth failed");
    assert_eq(streq(stiva_err_name(STIVA_ERR_UNSUPPORTED_PLATFORM), "unsupported platform"), 1, "unsupported platform");
    assert_eq(streq(stiva_err_name(STIVA_ERR_ANSAMBLU), "ansamblu error"), 1, "ansamblu error");
    assert_eq(streq(stiva_err_name(STIVA_ERR_SCAN_BLOCKED), "scan blocked"), 1, "scan blocked");
    assert_eq(streq(stiva_err_name(STIVA_ERR_HTTP), "http error"), 1, "http error");
    assert_eq(STIVA_ERR_HTTP, 28, "http code is 28");
    assert_eq(streq(stiva_err_name(999), "unknown error"), 1, "unknown fallback");
    return 0;
}

