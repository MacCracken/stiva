# ── network_nat.cyr (rust-old/src/network/nat.rs) ──
fn test_nat_parse() {
    test_group("nat_parse");

    # parse_simple_port
    var s1 = network_nat_parse_port_spec("8080:80");
    assert(s1 != 0, "simple ok");
    assert_eq(port_spec_host_port(s1), 8080, "host 8080");
    assert_eq(port_spec_container_port(s1), 80, "cont 80");
    assert_eq(port_spec_protocol(s1), NETWORK_NAT_PROTO_TCP, "tcp");
    assert_eq(port_spec_has_host_addr(s1), 0, "no addr (host_addr none)");

    # parse_port_with_tcp
    var s2 = network_nat_parse_port_spec("8080:80/tcp");
    assert(s2 != 0, "explicit tcp ok");
    assert_eq(port_spec_protocol(s2), NETWORK_NAT_PROTO_TCP, "explicit tcp");

    # parse_port_with_udp
    var s3 = network_nat_parse_port_spec("53:53/udp");
    assert(s3 != 0, "udp ok");
    assert_eq(port_spec_protocol(s3), NETWORK_NAT_PROTO_UDP, "udp");
    assert_eq(port_spec_host_port(s3), 53, "udp host 53");
    assert_eq(port_spec_container_port(s3), 53, "udp cont 53");

    # parse_port_with_bind_addr — 0.0.0.0 = 0
    var s4 = network_nat_parse_port_spec("0.0.0.0:8080:80");
    assert(s4 != 0, "bind addr ok");
    assert_eq(port_spec_has_host_addr(s4), 1, "has addr");
    assert_eq(port_spec_host_addr(s4), 0, "addr 0.0.0.0");
    assert_eq(port_spec_host_port(s4), 8080, "bindaddr host 8080");
    assert_eq(port_spec_container_port(s4), 80, "bindaddr cont 80");

    # parse_port_with_localhost — 127.0.0.1 = 2130706433
    var s5 = network_nat_parse_port_spec("127.0.0.1:3000:3000/tcp");
    assert(s5 != 0, "localhost ok");
    assert_eq(port_spec_has_host_addr(s5), 1, "localhost has addr");
    assert_eq(port_spec_host_addr(s5), 2130706433, "127.0.0.1 value");
    assert_eq(port_spec_protocol(s5), NETWORK_NAT_PROTO_TCP, "localhost tcp");

    # invalid cases → 0 (Rust: is_err())
    assert_eq(network_nat_parse_port_spec(""), 0, "empty");
    assert_eq(network_nat_parse_port_spec("8080"), 0, "no colon");
    assert_eq(network_nat_parse_port_spec("8080:80/sctp"), 0, "bad proto");
    assert_eq(network_nat_parse_port_spec("99999:80"), 0, "port too big (u16 overflow)");
    assert_eq(network_nat_parse_port_spec("8080:abc"), 0, "non-numeric port");
    assert_eq(network_nat_parse_port_spec("not-an-ip:8080:80"), 0, "bad bind addr");

    # trim
    var s6 = network_nat_parse_port_spec("  8080:80  ");
    assert(s6 != 0, "trimmed ok");
    assert_eq(port_spec_host_port(s6), 8080, "trimmed host 8080");

    # port_protocol_default
    assert_eq(network_nat_proto_default(), NETWORK_NAT_PROTO_TCP, "default tcp");

    # ipv4 format roundtrip (used by network_nat_to_nein_port_mapping addr string)
    assert_eq(streq(_network_nat_fmt_ipv4(2130706433), "127.0.0.1"), 1, "fmt 127.0.0.1");
    return 0;
}


