fn test_network_mode_name() {
    test_group("network_mode_name");
    assert_eq(streq(network_mode_name(NETWORK_MODE_BRIDGE), "Bridge"), 1, "Bridge");
    assert_eq(streq(network_mode_name(NETWORK_MODE_HOST), "Host"), 1, "Host");
    assert_eq(streq(network_mode_name(NETWORK_MODE_NONE), "None"), 1, "None");
    assert_eq(streq(network_mode_name(NETWORK_MODE_CONTAINER), "Container"), 1, "Container");
    assert_eq(streq(network_mode_name(NETWORK_MODE_CUSTOM), "Custom"), 1, "Custom");
