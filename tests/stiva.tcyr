fn test_network_manager_connect_with_dns_injection() {
    test_group("network_manager_connect_with_dns_injection");
    var root = "/tmp/stiva-nm-dns-test";
    sys_mkdir(root, 0x1FF);
    var mgr = network_manager_new();
    var e1 = vec_new();
    var cn = network_manager_connect_container(mgr, "c1-abcdef123456", network_manager_default_bridge(), e1, root);
    assert(cn != 0, "connected with rootfs");
    assert_eq(file_exists("/tmp/stiva-nm-dns-test/etc/resolv.conf"), 1, "resolv.conf injected");
    assert_eq(file_exists("/tmp/stiva-nm-dns-test/etc/hosts"), 1, "hosts injected");
    assert_eq(file_exists("/tmp/stiva-nm-dns-test/etc/hostname"), 1, "hostname injected");
    return 0;
}

