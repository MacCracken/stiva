fn test_parse_signal_numeric() {
    test_group("parse_signal_numeric");
    assert_eq(parse_signal("15"), 15, "15 -> 15");
    assert_eq(parse_signal("9"), 9, "9 -> 9");
    assert_eq(parse_signal("1"), 1, "1 -> 1");
    return 0;
}

fn test_parse_signal_names() {
    test_group("parse_signal_names");
    assert_eq(parse_signal("SIGTERM"), 15, "SIGTERM -> 15");
    assert_eq(parse_signal("SIGKILL"), 9, "SIGKILL -> 9");
    assert_eq(parse_signal("TERM"), 15, "TERM -> 15");
    assert_eq(parse_signal("HUP"), 1, "HUP -> 1");
    assert_eq(parse_signal("SIGUSR1"), 10, "SIGUSR1 -> 10");
    assert_eq(parse_signal("ABORT"), 6, "ABORT alias -> 6");
    assert_eq(parse_signal("CHILD"), 17, "CHILD alias -> 17");
    return 0;
}

fn test_parse_signal_invalid() {
    test_group("parse_signal_invalid");
    assert_eq(parse_signal("SIGFOO"), 0 - 1, "SIGFOO -> -1");
    assert_eq(parse_signal("0"), 0 - 1, "0 -> -1");
    assert_eq(parse_signal("999"), 0 - 1, "999 -> -1");
    return 0;
}

