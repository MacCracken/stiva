fn test_disabled_entry_points() {
    test_group("disabled_entry_points");
    # rust-old luks/verity *_nonexistent tests: without the feature these are Err.
    # Port: null OpenVolume / null path (0) for open/format, -1 for close.
    var c = luks_volume_config_new("/nonexistent/volume.img", "test-vol", "/data", 64);
    assert_eq(stiva_luks_open(c, "password123"), 0, "luks_open disabled");
    assert_eq(stiva_luks_close("nonexistent-mapper"), 0 - 1, "luks_close disabled");
    assert_eq(stiva_luks_format(c, "password123"), 0, "luks_format disabled");
    var vc = verity_volume_config_new("/nonexistent/data.img", "/nonexistent/hash.img", "abc", "test-verity");
    assert_eq(stiva_verity_open(vc), 0, "verity_open disabled");
    assert_eq(stiva_verity_close("nonexistent-mapper"), 0 - 1, "verity_close disabled");
    assert_eq(stiva_verity_format("/nonexistent/data", "/nonexistent/hash"), 0, "verity_format disabled");
    return 0;
}


# ── runtime.cyr (rust-old/src/runtime.rs) ──
# ── runtime module tests (mirror rust-old/src/runtime.rs #[cfg(test)]) ──
# Only the self-contained, ported surface is exercised. The kavach/tokio/
# criu/tar tests in the oracle target DEFERRED functions and land with them.

# True (1) iff vec `v` of cstrs contains a cstr equal to `needle`.
fn _rt_opts_contains(v, needle) {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(v, i), needle) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn test_runtime_namespace_names() {
    test_group("runtime_namespace_names");
    assert_eq(streq(namespace_name(RUNTIME_NS_PID), "Pid"), 1, "Pid");
    assert_eq(streq(namespace_name(RUNTIME_NS_NET), "Net"), 1, "Net");
    assert_eq(streq(namespace_name(RUNTIME_NS_MOUNT), "Mount"), 1, "Mount");
    assert_eq(streq(namespace_name(RUNTIME_NS_UTS), "Uts"), 1, "Uts");
    assert_eq(streq(namespace_name(RUNTIME_NS_IPC), "Ipc"), 1, "Ipc");
    assert_eq(streq(namespace_name(RUNTIME_NS_USER), "User"), 1, "User");
    assert_eq(streq(namespace_name(RUNTIME_NS_CGROUP), "Cgroup"), 1, "Cgroup");
    return 0;
}

fn test_runtime_standard_mounts_complete() {
    test_group("runtime_standard_mounts_complete");
    var mounts = standard_mounts();
    assert_eq(vec_len(mounts), 5, "5 standard mounts");

    # destination is field offset 8 in SpecMount { source; destination; ... }.
    var m0 = vec_get(mounts, 0);
    var m1 = vec_get(mounts, 1);
    var m2 = vec_get(mounts, 2);
    var m3 = vec_get(mounts, 3);
    var m4 = vec_get(mounts, 4);
    assert_eq(streq(load64(m0 + 8), "/proc"), 1, "dest /proc");
    assert_eq(streq(load64(m1 + 8), "/sys"), 1, "dest /sys");
    assert_eq(streq(load64(m2 + 8), "/dev"), 1, "dest /dev");
    assert_eq(streq(load64(m3 + 8), "/dev/pts"), 1, "dest /dev/pts");
    assert_eq(streq(load64(m4 + 8), "/dev/shm"), 1, "dest /dev/shm");

    # mount_type at offset 16.
    assert_eq(streq(load64(m0 + 16), "proc"), 1, "type proc");
    assert_eq(streq(load64(m1 + 16), "sysfs"), 1, "type sysfs");
    return 0;
}

fn test_runtime_volume_mounts_conversion() {
    test_group("runtime_volume_mounts_conversion");
    var specs = vec_new();
    vec_push(specs, "/a:/b");
    vec_push(specs, "/c:/d:ro");

    var mounts = volume_mounts(specs, 0);
    assert_eq(vec_len(mounts), 2, "2 bind mounts");

    var m0 = vec_get(mounts, 0);   # SpecMount { source; destination; mount_type; options }
    var m1 = vec_get(mounts, 1);
    assert_eq(streq(load64(m0 + 16), "bind"), 1, "mount_type bind");
    # options at offset 24.
    assert_eq(_rt_opts_contains(load64(m0 + 24), "rbind"), 1, "m0 has rbind");
    assert_eq(_rt_opts_contains(load64(m0 + 24), "ro"), 0, "m0 has no ro");
    assert_eq(_rt_opts_contains(load64(m1 + 24), "ro"), 1, "m1 has ro (readonly)");

    # Rootless adds the idmap option.
    var specs2 = vec_new();
    vec_push(specs2, "/a:/b");
    var rl = volume_mounts(specs2, 1);
    var rm0 = vec_get(rl, 0);
    assert_eq(_rt_opts_contains(load64(rm0 + 24), "X-mount.idmap="), 1, "rootless idmap");
    return 0;
}

fn test_runtime_volume_mounts_invalid() {
    test_group("runtime_volume_mounts_invalid");
    var specs = vec_new();
    vec_push(specs, "nocolon");
    # parse_volume returns 0 for a spec with no ':' → volume_mounts returns 0.
    assert_eq(volume_mounts(specs, 0), 0, "invalid spec -> null");
    return 0;
}

