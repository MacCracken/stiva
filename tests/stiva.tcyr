# ProcessInfo JSON round-trip (rust-old runtime.rs: process_info_serde).
fn test_runtime_process_info_serde() {
    test_group("runtime_process_info_serde");
    var info = process_info_new(123, 1, "sleep", "sleep 60", 83);   # 'S' = 83
    var json = json_v_build(process_info_to_jv(info));
    var back = process_info_from_jv(bayan_json_v_parse_str(str_data(json), str_len(json)));
    var b: ProcessInfo = back;
