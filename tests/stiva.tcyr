# copy_dir_recursive copies a nested tree (rust-old runtime.rs:
# copy_dir_recursive_works). Exercises the is_dir() directory branch that a
# file-only copy test cannot reach.
fn test_runtime_copy_dir_recursive() {
    test_group("runtime_copy_dir_recursive");
    sys_mkdir("/tmp/stiva_cp_dir", 0x1ED);
    sys_mkdir("/tmp/stiva_cp_dir/src", 0x1ED);
    sys_mkdir("/tmp/stiva_cp_dir/src/sub", 0x1ED);
    file_write_all("/tmp/stiva_cp_dir/src/a.txt", "a", 1);
    file_write_all("/tmp/stiva_cp_dir/src/sub/b.txt", "b", 1);
    assert_eq(copy_dir_recursive("/tmp/stiva_cp_dir/src", "/tmp/stiva_cp_dir/dst"), 0, "copy ok");
    var b1 = alloc(8);
    var n1 = file_read_all("/tmp/stiva_cp_dir/dst/a.txt", b1, 7);
    store8(b1 + n1, 0);
    assert_eq(streq(b1, "a"), 1, "a.txt copied");
    var b2 = alloc(8);
    var n2 = file_read_all("/tmp/stiva_cp_dir/dst/sub/b.txt", b2, 7);
    store8(b2 + n2, 0);
    assert_eq(streq(b2, "b"), 1, "sub/b.txt copied (recursion)");
    return 0;
}

# copy_into_container recursively copies a directory source into the rootfs
# (regression for the is_dir(cstr) bug — a dir source must land as a tree).
fn test_runtime_copy_into_container_dir() {
    test_group("runtime_copy_into_container_dir");
    sys_mkdir("/tmp/stiva_cp_ind", 0x1ED);
    sys_mkdir("/tmp/stiva_cp_ind/rootfs", 0x1ED);
    sys_mkdir("/tmp/stiva_cp_ind/srcdir", 0x1ED);
    file_write_all("/tmp/stiva_cp_ind/srcdir/x.txt", "xyz", 3);
    assert_eq(copy_into_container("/tmp/stiva_cp_ind/rootfs",
    "/tmp/stiva_cp_ind/srcdir", "/app/data"), 0, "dir copy ok");
    var buf = alloc(16);
    var n = file_read_all("/tmp/stiva_cp_ind/rootfs/app/data/x.txt", buf, 15);
    store8(buf + n, 0);
    assert_eq(streq(buf, "xyz"), 1, "nested file copied into rootfs");
    return 0;
}

# parse_bundle ignores a negative resource limit / uid, matching serde_json
# as_u64 (which returns None for negatives) — regression for the sign guard.
fn test_parse_bundle_negative_limits() {
    test_group("parse_bundle_negative_limits");
    var dir = "/tmp/stiva_oci_neg";
    sys_mkdir(dir, 0x1ED);
    var cfg = "{\"process\":{\"args\":[\"/bin/true\"],\"user\":{\"uid\":-1}},\"linux\":{\"resources\":{\"memory\":{\"limit\":-1},\"pids\":{\"limit\":-5}}}}";
    file_write_all("/tmp/stiva_oci_neg/config.json", cfg, strlen(cfg));
    var c: ContainerConfig = parse_bundle(dir);
    assert_eq(c.rootless, 0, "negative uid -> not rootless");
    assert_eq(c.memory_limit, 0, "negative memory -> default 0");
    assert_eq(c.max_pids, 0, "negative pids -> default 0");
    return 0;
}

