# ── ansamblu.cyr ──

# ── agent.cyr ──
# ── agent module tests (mirror rust-old/src/agent.rs #[cfg(test)]) ──
# Builds a Container* raw record matching src/container.cyr's field layout
# (8-byte fields: id@0 name@8 image_id@16 image_ref@24 state@32 pid@40
#  created_at@48 started_at@56 config@64 exit_code@72) and a ContainerConfig*
# whose ports field is at offset 32. The three HTTP mock tests
# (register_with_mock / deregister_with_mock / report_status_with_mock /
#  register_failure) are omitted: they require wiremock + async reqwest,
# which the ported base lacks (deferred alongside the network functions).

# Allocate a ContainerConfig* with only `ports` populated (offset 32).
# Allocate a Container* mirroring rust-old test_container(): id, optional
# name (0 = None), image_id, image_ref, state, config.
# True (1) iff cstr `needle` is an element of vec `v`.

# ── fleet.cyr (rust-old/src/fleet.rs) ──

# ── mcp.cyr (rust-old/src/mcp.rs) ──
fn _mcp_names_contains(tools, target) {
    var i = 0;
    var n = vec_len(tools);
    for (i = 0; i < n; i = i + 1) {
        var t = vec_get(tools, i);
        if (streq(tool_def_name(t), target) == 1) { return 1; }
    }
    return 0;
}

fn test_mcp_tool_list_has_nine_tools() {
    test_group("mcp_tool_list_has_nine_tools");
    var tools = tool_list();
    assert_eq(vec_len(tools), 9);
    assert_eq(_mcp_names_contains(tools, "stiva_pull"), 1);
    assert_eq(_mcp_names_contains(tools, "stiva_run"), 1);
    assert_eq(_mcp_names_contains(tools, "stiva_ps"), 1);
    assert_eq(_mcp_names_contains(tools, "stiva_stop"), 1);
    assert_eq(_mcp_names_contains(tools, "stiva_ansamblu"), 1);
    assert_eq(_mcp_names_contains(tools, "stiva_exec"), 1);
    assert_eq(_mcp_names_contains(tools, "stiva_build"), 1);
    assert_eq(_mcp_names_contains(tools, "stiva_push"), 1);
    assert_eq(_mcp_names_contains(tools, "stiva_inspect"), 1);
    return 0;
}

fn test_mcp_tool_schemas_are_valid() {
    test_group("mcp_tool_schemas_are_valid");
    var tools = tool_list();
    var i = 0;
    var n = vec_len(tools);
    for (i = 0; i < n; i = i + 1) {
        var t = vec_get(tools, i);
        # input_schema.schema_type == "object"
        assert_eq(streq(schema_type(tool_def_input_schema(t)), "object"), 1);
        # description non-empty
        assert(strlen(tool_def_description(t)) > 0);
        # annotations present (non-null)
        assert(tool_def_annotations(t) != 0);
    }
    return 0;
}

fn test_mcp_result_ok() {
    test_group("mcp_result_ok");
    var r = mcp_result_ok("{\"key\": \"value\"}");
    assert_eq(mcp_result_success(r), 1);
    assert_eq(vec_len(mcp_result_content(r)), 1);
    var part = vec_get(mcp_result_content(r), 0);
    assert_eq(content_part_kind(part), MCP_CONTENT_TEXT);
    return 0;
}

fn test_mcp_result_err() {
    test_group("mcp_result_err");
    var r = mcp_result_err("something failed");
    assert_eq(mcp_result_success(r), 0);
    assert_eq(vec_len(mcp_result_content(r)), 1);
    var part = vec_get(mcp_result_content(r), 0);
    assert_eq(streq(content_part_text_of(part), "something failed"), 1);
    return 0;
}

fn test_mcp_result_resource() {
    test_group("mcp_result_resource");
    var r = mcp_result_resource("stiva://test/1", "{\"id\": \"1\"}");
    assert_eq(mcp_result_success(r), 1);
    assert_eq(vec_len(mcp_result_content(r)), 1);
    var part = vec_get(mcp_result_content(r), 0);
    assert_eq(content_part_kind(part), MCP_CONTENT_RESOURCE);
    assert_eq(streq(content_part_uri(part), "stiva://test/1"), 1);
    assert_eq(streq(content_part_mime_type(part), "application/json"), 1);
    return 0;
}

# mcp_handle_build (rust-old mcp.rs: handle_build — a fully-sync handler).
fn test_mcp_handle_build() {
    test_group("mcp_handle_build");
    var params = json_v_obj_new();
    json_v_obj_set(params, str_from("spec"),
    json_v_str_new(str_from("[image]\nbase = \"alpine\"\nname = \"myapp\"\n\n[[steps]]\ntype = \"run\"\ncommand = [\"echo\", \"hi\"]\n")));
    var r = mcp_handle_build(params);
    assert_eq(mcp_result_success(r), 1, "build ok");
    var text = content_part_text_of(vec_get(mcp_result_content(r), 0));
    assert_eq(strstr(text, "alpine") >= 0, 1, "reports base");
    assert_eq(strstr(text, "myapp") >= 0, 1, "reports name");
    assert_eq(strstr(text, "parsed") >= 0, 1, "status parsed");
    # missing spec -> error result
    var r2 = mcp_handle_build(json_v_obj_new());
    assert_eq(mcp_result_success(r2), 0, "missing spec -> err");
    return 0;
}

# mcp_handle_ansamblu (rust-old mcp.rs: handle_ansamblu — fully sync).
fn test_mcp_handle_ansamblu() {
    test_group("mcp_handle_ansamblu");
    # up: parse the ansamblu file, report service count.
    var up = json_v_obj_new();
    json_v_obj_set(up, str_from("action"), json_v_str_new(str_from("up")));
    json_v_obj_set(up, str_from("file"),
    json_v_str_new(str_from("[services.web]\nimage = \"nginx\"\n\n[services.db]\nimage = \"postgres\"\n")));
    var r = mcp_handle_ansamblu(up);
    assert_eq(mcp_result_success(r), 1, "up ok");
    var text = content_part_text_of(vec_get(mcp_result_content(r), 0));
    assert_eq(strstr(text, "ansamblu_up") >= 0, 1, "action ansamblu_up");
    # down: queued.
    var down = json_v_obj_new();
    json_v_obj_set(down, str_from("action"), json_v_str_new(str_from("down")));
    json_v_obj_set(down, str_from("session_id"), json_v_str_new(str_from("s-42")));
    var rd = mcp_handle_ansamblu(down);
    assert_eq(mcp_result_success(rd), 1, "down ok");
    var dtext = content_part_text_of(vec_get(mcp_result_content(rd), 0));
    assert_eq(strstr(dtext, "queued") >= 0, 1, "status queued");
    assert_eq(strstr(dtext, "s-42") >= 0, 1, "echoes session_id");
    # missing action -> error; unknown action -> error.
    assert_eq(mcp_result_success(mcp_handle_ansamblu(json_v_obj_new())), 0, "missing action -> err");
    var bad = json_v_obj_new();
    json_v_obj_set(bad, str_from("action"), json_v_str_new(str_from("sideways")));
    assert_eq(mcp_result_success(mcp_handle_ansamblu(bad)), 0, "unknown action -> err");
    return 0;
}

fn test_mcp_content_type_names() {
    test_group("mcp_content_type_names");
    # ContentPart #[serde(tag = "type")] wire values.
    assert_eq(streq(mcp_content_type_name(MCP_CONTENT_TEXT), "text"), 1);
    assert_eq(streq(mcp_content_type_name(MCP_CONTENT_RESOURCE), "resource"), 1);
    return 0;
}

fn test_mcp_content_part_text() {
    test_group("mcp_content_part_text");
    var part = content_part_text("hello");
    assert_eq(content_part_kind(part), MCP_CONTENT_TEXT);
    assert_eq(streq(content_part_text_of(part), "hello"), 1);
    assert_eq(content_part_uri(part), 0);
    return 0;
}

fn test_mcp_content_part_resource() {
    test_group("mcp_content_part_resource");
    var part = content_part_resource("stiva://containers/abc", "application/json", "{}");
    assert_eq(content_part_kind(part), MCP_CONTENT_RESOURCE);
    assert_eq(streq(content_part_uri(part), "stiva://containers/abc"), 1);
    assert_eq(streq(content_part_mime_type(part), "application/json"), 1);
    assert_eq(streq(content_part_text_of(part), "{}"), 1);
    return 0;
}


# ── lib.cyr (rust-old/src/lib.rs) ──
fn test_lib_default_config() {
    test_group("lib::default_config");
    var c: StivaConfig = stiva_config_default();
    assert_eq(streq(c.root_path, "/var/lib/agnos/containers"), 1, "default root_path");
    assert_eq(streq(c.image_path, "/var/lib/agnos/images"), 1, "default image_path");
    assert_eq(c.max_containers, 64, "default max_containers");
    assert_eq(c.audit_log, 0, "default audit_log is None (0)");
    var nm: NetworkModeVal = c.default_network;
    assert_eq(nm.tag, NETWORK_MODE_BRIDGE, "default_network is Bridge");
    return 0;
}

fn test_lib_config_custom_values() {
    test_group("lib::config_custom_values");
    var d: StivaConfig = stiva_config_new(
    "/custom/containers",
    "/custom/images",
    network_mode_new(NETWORK_MODE_HOST, 0),
    128,
    0
    );
    assert_eq(streq(d.root_path, "/custom/containers"), 1, "custom root_path");
    assert_eq(streq(d.image_path, "/custom/images"), 1, "custom image_path");
    assert_eq(d.max_containers, 128, "custom max_containers");
    var dn: NetworkModeVal = d.default_network;
    assert_eq(dn.tag, NETWORK_MODE_HOST, "custom default_network is Host");
    return 0;
}


