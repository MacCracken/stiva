fn test_network_manager_disconnect_container_releases_ip() {
    test_group("network_manager_disconnect_container_releases_ip");
    var mgr = network_manager_new();
    var e1 = vec_new();
    var cn = network_manager_connect_container(mgr, "c1-abcdef123456", network_manager_default_bridge(), e1, 0);
    assert(cn != 0, "connected");
    var before = ip_pool_allocated_count(network_manager_get_pool(mgr, network_manager_default_bridge()));
    assert_eq(before, 1, "1 allocated before");
    var rc = network_manager_disconnect_container(mgr, "c1-abcdef123456");
    assert_eq(rc, STIVA_ERR_OK, "disconnect ok");
    var after = ip_pool_allocated_count(network_manager_get_pool(mgr, network_manager_default_bridge()));
    assert_eq(after, 0, "0 allocated after");
    return 0;
}

