fn test_network_policy_default_no_restrictions() {
    test_group("network_policy_default_no_restrictions");
    var policy: NetworkPolicy = network_policy_default();
    assert_eq(network_policy_has_restrictions(policy), 0, "no restrictions");
    return 0;
}

fn test_network_policy_with_deny() {
    test_group("network_policy_with_deny");
    var policy: NetworkPolicy = network_policy_default();
    vec_push(policy.egress_deny, "10.0.0.0/8");
    assert_eq(network_policy_has_restrictions(policy), 1, "has restrictions");
    var rules = network_policy_to_nft_rules(policy, "172.17.0.2");
    assert_eq(vec_len(rules), 1, "one rule");
    var r0 = vec_get(rules, 0);
    assert_eq(strstr(r0, "10.0.0.0/8") >= 0, 1, "contains cidr");
    assert_eq(strstr(r0, "drop") >= 0, 1, "contains drop");
    assert_eq(strstr(r0, "172.17.0.2") >= 0, 1, "contains ip");
    return 0;
}

fn test_dns_registry_resolve() {
    test_group("dns_registry_resolve");
    var reg: DnsRegistry = dns_registry_new();
    dns_registry_register(reg, "web", "172.17.0.2");
    dns_registry_register(reg, "db", "172.17.0.3");
    assert_eq(streq(dns_registry_resolve(reg, "web"), "172.17.0.2"), 1, "web");
    assert_eq(streq(dns_registry_resolve(reg, "db"), "172.17.0.3"), 1, "db");
    assert_eq(dns_registry_resolve(reg, "missing"), 0, "missing none");
    return 0;
}

fn test_dns_registry_unregister() {
    test_group("dns_registry_unregister");
    var reg: DnsRegistry = dns_registry_new();
    dns_registry_register(reg, "web", "172.17.0.2");
    dns_registry_unregister(reg, "web");
    assert_eq(dns_registry_resolve(reg, "web"), 0, "web removed");
    return 0;
}

fn test_dns_registry_hosts_entries() {
    test_group("dns_registry_hosts_entries");
    var reg: DnsRegistry = dns_registry_new();
    dns_registry_register(reg, "web", "172.17.0.2");
    var hosts = dns_registry_to_hosts_entries(reg);
    assert_eq(strstr(hosts, "172.17.0.2\tweb") >= 0, 1, "ip tab name");
    return 0;
}

fn test_dns_registry_inject() {
    test_group("dns_registry_inject");
    var reg: DnsRegistry = dns_registry_new();
    dns_registry_register(reg, "db", "172.17.0.3");
    sys_mkdir("/tmp/nm_inject_test", 448);
    var rc = dns_registry_inject_into(reg, "/tmp/nm_inject_test", "172.17.0.2", "web");
    assert_eq(rc, STIVA_ERR_OK, "inject ok");
    var buf = alloc(4096);
    var n = file_read_all("/tmp/nm_inject_test/etc/hosts", buf, 4095);
    store8(buf + n, 0);
    assert_eq(strstr(buf, "172.17.0.2\tweb") >= 0, 1, "self entry");
    assert_eq(strstr(buf, "172.17.0.3\tdb") >= 0, 1, "db entry");
    assert_eq(strstr(buf, "127.0.0.1\tlocalhost") >= 0, 1, "localhost");
    return 0;
}

# ── network_bridge.cyr (rust-old/src/network/bridge.rs) ──
fn test_network_bridge_veth_name() {
    test_group("network_bridge_veth_name");
    var h = host_veth_name("abc123def456ghij");
    assert_eq(streq(h, "ve-abc123def456"), 1, "ve- prefix + first 12 chars");
    assert_eq(strlen(h), 15, "IFNAMSIZ-1 length");
    var h2 = host_veth_name("short");
    assert_eq(streq(h2, "ve-short"), 1, "short id untruncated");
    var h3 = host_veth_name("0123456789ab");
    assert_eq(streq(h3, "ve-0123456789ab"), 1, "exactly 12 chars");
    assert_eq(streq(container_veth_name(), "eth0"), 1, "peer is eth0");
    return 0;
}

fn test_network_bridge_ipv4_fmt() {
    test_group("network_bridge_ipv4_fmt");
    # 172.17.0.1 packed = (172<<24)|(17<<16)|(0<<8)|1
    var gw = 2886795265;
    var s = _ipv4_cstr(gw);
    assert_eq(streq(s, "172.17.0.1"), 1, "dotted-decimal gateway");
    var cidr = _ipv4_cidr_cstr(gw, 16);
    assert_eq(streq(cidr, "172.17.0.1/16"), 1, "cidr with prefix");
    # 10.0.0.255
    var b = _ipv4_cstr(167772415);
    assert_eq(streq(b, "10.0.0.255"), 1, "trailing 255 octet");
    return 0;
}

# ── network_dns.cyr (rust-old/src/network/dns.rs) ──
fn read_file_cstr(path) {
    var cap = 65536;
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap - 1);
    if (n < 0) { store8(buf, 0); return buf; }
    store8(buf + n, 0);
    return buf;
}

fn test_dns_parse_resolv_conf_basic() {
    test_group("network_dns::parse_resolv_conf_basic");
    var content = "nameserver 8.8.8.8\nnameserver 8.8.4.4\n";
    var servers = network_dns_parse_resolv_conf(content);
    assert_eq(vec_len(servers), 2, "two servers");
    assert_eq(vec_get(servers, 0), network_dns_parse_ipv4("8.8.8.8"), "first 8.8.8.8");
    assert_eq(vec_get(servers, 1), network_dns_parse_ipv4("8.8.4.4"), "second 8.8.4.4");
    return 0;
}

fn test_dns_parse_resolv_conf_with_comments() {
    test_group("network_dns::parse_resolv_conf_with_comments");
    var content = "# DNS\nnameserver 1.1.1.1\nsearch example.com\nnameserver 1.0.0.1\n";
    var servers = network_dns_parse_resolv_conf(content);
    assert_eq(vec_len(servers), 2, "two servers");
    assert_eq(vec_get(servers, 0), network_dns_parse_ipv4("1.1.1.1"), "first 1.1.1.1");
    return 0;
}

