# lib.cyr — stiva public library aggregation header
#
# OCI container runtime — image management, container lifecycle,
# orchestration. Cyrius port of the Rust v2.x crate (rust-old/).
#
# This is the LIBRARY header: the domain `src/*.cyr` modules in dependency
# order WITHOUT the program surface (no `main()`, no CLI dispatch, no
# top-level `syscall(SYS_EXIT)`) — that lives in `src/main.cyr`, the in-tree
# program entry, intentionally NOT part of the library.
#
# Consumers do NOT include this file directly. They depend on the committed
# single-file bundle:
#
#     [deps.stiva]
#     git     = "https://github.com/MacCracken/stiva.git"
#     path    = "../stiva"
#     tag     = "<VERSION>"
#     modules = ["dist/stiva.cyr"]
#
# `cyrius deps` materializes that bundle into the consumer's lib/stiva.cyr.
#
# The module ORDER below mirrors `[lib].modules` in cyrius.cyml, which is
# what `cyrius distlib` reads to (re)build dist/stiva.cyr. Keep the two in
# the same order. `stiva_core.cyr` (the crate-root StivaConfig + Stiva facade,
# ported from rust-old/src/lib.rs) is included last.

include "src/error.cyr"
include "src/oci.cyr"
include "src/intents.cyr"
include "src/audit.cyr"
include "src/convert.cyr"
include "src/network_mod.cyr"
include "src/network_bridge.cyr"
include "src/network_dns.cyr"
include "src/network_pool.cyr"
include "src/network_rootless.cyr"
include "src/network_nat.cyr"
include "src/network_manager.cyr"
include "src/image.cyr"
include "src/registry.cyr"
include "src/storage.cyr"
include "src/build.cyr"
include "src/encrypted.cyr"
include "src/runtime.cyr"
include "src/container.cyr"
include "src/health.cyr"
include "src/ansamblu.cyr"
include "src/agent.cyr"
include "src/fleet.cyr"
include "src/mcp.cyr"
include "src/stiva_core.cyr"
