# stiva — TOML-based image build spec: types, defaults, build cache store.
# Ported from rust-old/src/build.rs.
#
# What ports cleanly here (self-contained or depends only on already-ported
# image.cyr):
#   struct ImageDef    { base, name, tag }           + default_tag
#   struct BuildStage  { name, base, steps }
#   struct BuildConfig { entrypoint, expose, user, workdir }
#   struct BuildStep   { tag, ... } + enum BuildStep discriminants
#   struct BuildSpec   { image, steps, config, stages }
#   store_layer            (sha256_digest + store_blob — both in image.cyr)
#   check_build_cache / record_build_cache
#       (the on-disk {root}/cache/{hex} key→digest map; plain file ops)
#
# What ports here now (v3.0.0 — bayan TOML object model):
#   parse_build_spec — parses a Stivafile TOML string into the BuildSpec tree
#     via bayan_toml_parse + bayan_toml_get / _get_array / _get_sections
#     (rust-old used toml::from_str). See the fn's own comment for the [image]
#     / [[steps]] / [config] mapping and the stages caveat.
#
# What is DEFERRED (see the block at the bottom):
#   * build_cache_key — hashes serde_json::to_string(step). ACHIEVABLE via
#     bayan's JSON serializer; just not wired yet (NOT a Cyrius gap).
#   * build_run_layer / build_copy_layer / append_dir_recursive / build_image
#     — construct tar.gz layers (flate2 GzEncoder + tar::Builder) and
#     build_image is async (drives ImageStore::pull over the network). The
#     ported base has neither a tar builder / gzip encoder nor the async
#     registry network layer, so these land with those.
#
# sha256_digest is NOT re-ported here — build.rs's private copy is
# byte-identical to image.cyr's public sha256_digest; we reuse that one to
# avoid a duplicate global (Cyrius hoists fns to globals, last-def-wins).
#
# Error mapping (mirrors error.cyr): Rust `Err(StivaError::Storage(String))`
# becomes an integer sentinel here — store_layer returns 0 on a store
# failure; the caller reports it via stiva_err_print(STIVA_ERR_STORAGE,
# detail).

# ── BuildStep discriminant (rust-old: enum BuildStep) ────────────
# The Rust enum is `#[serde(tag = "type", rename_all = "lowercase")]` and
# `#[non_exhaustive]`; each variant carries fields. Cyrius has no
# data-carrying enums, so the discriminant is this enum and the payload
# lives in the BuildStep struct's fields (unused fields are 0 per variant).
# Members are prefixed BUILD_STEP_* for global enum-member uniqueness
# (Cyrius hoists members to globals under last-def-wins — see error.cyr).
enum BuildStep {
    BUILD_STEP_RUN = 0;
    BUILD_STEP_COPY = 1;
    BUILD_STEP_ENV = 2;
    BUILD_STEP_WORKDIR = 3;
    BUILD_STEP_LABEL = 4;
    BUILD_STEP_FROM_STAGE = 5;
}

# Serde `type` wire name for a BuildStep discriminant (the lowercase tag
# values; from_stage keeps its explicit `#[serde(rename = "from_stage")]`).
#[must_use]
fn build_step_type_name(kind) {
    if (kind == BUILD_STEP_RUN) { return "run"; }
    if (kind == BUILD_STEP_COPY) { return "copy"; }
    if (kind == BUILD_STEP_ENV) { return "env"; }
    if (kind == BUILD_STEP_WORKDIR) { return "workdir"; }
    if (kind == BUILD_STEP_LABEL) { return "label"; }
    if (kind == BUILD_STEP_FROM_STAGE) { return "from_stage"; }
    return "unknown";
}

# A single build step. `kind` selects which fields are meaningful:
#   RUN        → command   (cstr; the space-joined argv, or a vec — see note)
#   COPY       → source, destination
#   ENV        → key, value
#   WORKDIR    → source     (the path; reuses the `source` slot)
#   LABEL      → key, value
#   FROM_STAGE → stage, source, destination
# Unused slots are 0. In the Rust oracle `command` is a `Vec<String>`; here
# a BuildStep holds an i64 that a caller may treat as a vec of cstrs.
struct BuildStep {
    kind;
    command;
    source;
    destination;
    key;
    value;
    stage;
}

fn build_step_run(command) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_RUN;
    ss.command = command;
    ss.source = 0;
    ss.destination = 0;
    ss.key = 0;
    ss.value = 0;
    ss.stage = 0;
    return s;
}

fn build_step_copy(source, destination) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_COPY;
    ss.command = 0;
    ss.source = source;
    ss.destination = destination;
    ss.key = 0;
    ss.value = 0;
    ss.stage = 0;
    return s;
}

fn build_step_env(key, value) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_ENV;
    ss.command = 0;
    ss.source = 0;
    ss.destination = 0;
    ss.key = key;
    ss.value = value;
    ss.stage = 0;
    return s;
}

fn build_step_workdir(path) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_WORKDIR;
    ss.command = 0;
    ss.source = path;
    ss.destination = 0;
    ss.key = 0;
    ss.value = 0;
    ss.stage = 0;
    return s;
}

fn build_step_label(key, value) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_LABEL;
    ss.command = 0;
    ss.source = 0;
    ss.destination = 0;
    ss.key = key;
    ss.value = value;
    ss.stage = 0;
    return s;
}

fn build_step_from_stage(stage, source, destination) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_FROM_STAGE;
    ss.command = 0;
    ss.source = source;
    ss.destination = destination;
    ss.key = 0;
    ss.value = 0;
    ss.stage = stage;
    return s;
}

# ── ImageDef (rust-old: struct ImageDef) ──────────────────
# Image identity within a build spec. `tag` defaults to "latest" (serde
# `#[serde(default = "default_tag")]`).
struct ImageDef {
    base;
    name;
    tag;
}

fn image_def_new(base, name, tag) {
    var d = alloc(24);
    var dd: ImageDef = d;
    dd.base = base;
    dd.name = name;
    dd.tag = tag;
    return d;
}

# Default output tag (rust-old: fn default_tag). Serde default for
# ImageDef::tag when the TOML omits it.
#[must_use]
fn default_tag() {
    return "latest";
}

# ── BuildStage (rust-old: struct BuildStage) ────────────────
# A named multi-stage build stage. `steps` is a vec of BuildStep*.
struct BuildStage {
    name;
    base;
    steps;
}

fn build_stage_new(name, base, steps) {
    var s = alloc(24);
    var ss: BuildStage = s;
    ss.name = name;
    ss.base = base;
    ss.steps = steps;
    return s;
}

# ── BuildConfig (rust-old: struct BuildConfig, derives Default) ──
# Final image config applied after all steps. `entrypoint` and `expose`
# are vecs (of cstr / u16 respectively); `user` and `workdir` are cstr or
# 0 for None (Rust Option<String>).
struct BuildConfig {
    entrypoint;
    expose;
    user;
    workdir;
}

# Default BuildConfig (rust-old: BuildConfig::default): empty entrypoint /
# expose vecs, user/workdir = None (0).
fn build_config_default() {
    var c = alloc(32);
    var cc: BuildConfig = c;
    cc.entrypoint = vec_new();
    cc.expose = vec_new();
    cc.user = 0;
    cc.workdir = 0;
    return c;
}

fn build_config_new(entrypoint, expose, user, workdir) {
    var c = alloc(32);
    var cc: BuildConfig = c;
    cc.entrypoint = entrypoint;
    cc.expose = expose;
    cc.user = user;
    cc.workdir = workdir;
    return c;
}

# ── BuildSpec (rust-old: struct BuildSpec) ─────────────────
# A full TOML-based image build spec. `steps` / `stages` are vecs of
# BuildStep* / BuildStage*; `image` is an ImageDef*, `config` a BuildConfig*.
struct BuildSpec {
    image;
    steps;
    config;
    stages;
}

fn build_spec_new(image, steps, config, stages) {
    var s = alloc(32);
    var ss: BuildSpec = s;
    ss.image = image;
    ss.steps = steps;
    ss.config = config;
    ss.stages = stages;
    return s;
}

# ── Build cache store ────────────────────────
# The on-disk key→digest cache under {root}/cache. A cache key is a
# `sha256:{hex}` string; the file name is the bare hex (Rust strips the
# "sha256:" prefix with strip_prefix, which is exactly image.cyr's
# digest_hex). These are plain file operations — no serde — so they port
# cleanly on top of image.cyr's ImageStore.

# Path "{root}/cache/{hex}" for a cache key (rust-old: the shared
# `cache_dir.join(cache_key.strip_prefix("sha256:").unwrap_or(cache_key))`).
#[must_use]
fn _build_cache_path(store, cache_key) {
    var root = image_store_root(store);
    var hex = digest_hex(cache_key);          # strip "sha256:" if present
    var dir = _img_cat2(root, "/cache/");
    return _img_cat2(dir, hex);
}

# Check whether a cached layer digest exists for a cache key
# (rust-old: check_build_cache). Reads the cache file's contents (the
# stored layer digest) into `buf` (up to `maxlen`); returns the byte count,
# or -1 when no cache entry exists (rust-old: None).
fn check_build_cache(store, cache_key, buf, maxlen) {
    var path = _build_cache_path(store, cache_key);
    if (file_exists(path) == 0) { return 0 - 1; }
    return file_read_all(path, buf, maxlen);
}

# Record a cache entry mapping a cache key → a layer digest
# (rust-old: record_build_cache). Creates {root}/cache (idempotent) and
# writes the digest to the key's file. Returns 0 on success, -1 on a
# write failure (rust-old: Err(StivaError) via `?`; caller maps to
# STIVA_ERR_IO).
fn record_build_cache(store, cache_key, layer_digest) {
    var root = image_store_root(store);
    var cache_dir = _img_cat2(root, "/cache");
    sys_mkdir(cache_dir, 493);                # 0o755 — create_dir_all analogue
    var path = _build_cache_path(store, cache_key);
    var n = strlen(layer_digest);
    if (file_write_all(path, layer_digest, n) < 0) { return 0 - 1; }
    return 0;
}

# BuildStep* → JSON object, matching serde's internally-tagged encoding
# (`#[serde(tag = "type", rename_all = "lowercase")]`): the "type" tag first,
# then the variant's fields in declaration order. bayan's compact json_v_build
# then reproduces serde_json::to_string(step) byte-for-byte for the well-formed
# case (the only consumer is build_cache_key's hash input).
fn build_step_to_jv(step) {
    var s: BuildStep = step;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("type"), json_v_str_new(str_from(build_step_type_name(s.kind))));
    if (s.kind == BUILD_STEP_RUN) {
        var arr = json_v_arr_new();
        if (s.command != 0) {
            var n = vec_len(s.command);
            var i = 0;
            while (i < n) {
                json_v_arr_push(arr, json_v_str_new(str_from(vec_get(s.command, i))));
                i = i + 1;
            }
        }
        json_v_obj_set(o, str_from("command"), arr);
    }
    if (s.kind == BUILD_STEP_COPY) {
        json_v_obj_set(o, str_from("source"), json_v_str_new(str_from(s.source)));
        json_v_obj_set(o, str_from("destination"), json_v_str_new(str_from(s.destination)));
    }
    if (s.kind == BUILD_STEP_ENV) {
        json_v_obj_set(o, str_from("key"), json_v_str_new(str_from(s.key)));
        json_v_obj_set(o, str_from("value"), json_v_str_new(str_from(s.value)));
    }
    if (s.kind == BUILD_STEP_WORKDIR) {
        json_v_obj_set(o, str_from("path"), json_v_str_new(str_from(s.source)));
    }
    if (s.kind == BUILD_STEP_LABEL) {
        json_v_obj_set(o, str_from("key"), json_v_str_new(str_from(s.key)));
        json_v_obj_set(o, str_from("value"), json_v_str_new(str_from(s.value)));
    }
    if (s.kind == BUILD_STEP_FROM_STAGE) {
        json_v_obj_set(o, str_from("stage"), json_v_str_new(str_from(s.stage)));
        json_v_obj_set(o, str_from("source"), json_v_str_new(str_from(s.source)));
        json_v_obj_set(o, str_from("destination"), json_v_str_new(str_from(s.destination)));
    }
    return o;
}

# Cache key for a build step (rust-old: build_cache_key). Hashes the string
# "{base_digest}:{step_index}:{serde_json(step)}" with SHA-256; returns the
# "sha256:{hex}" digest cstr.
#[must_use]
fn build_cache_key(base_digest, step_index, step) {
    var step_json = json_v_build(build_step_to_jv(step));   # Str (compact)
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base_digest);
    str_builder_add_cstr(sb, ":");
    str_builder_add_int(sb, step_index);
    str_builder_add_cstr(sb, ":");
    str_builder_add_str(sb, step_json);
    var input = str_builder_build(sb);
    return sha256_digest(str_data(input), str_len(input));
}

# Store a layer blob and return its digest (rust-old: store_layer).
# Computes sha256 over the `len` bytes at `data`, stores it in the blob
# store keyed by that digest, and returns the `sha256:{hex}` digest cstr.
# Returns 0 on a store failure (rust-old: Err(StivaError) via `?`; caller
# maps to STIVA_ERR_STORAGE).
fn store_layer(store, data, len) {
    var digest = sha256_digest(data, len);
    if (image_store_store_blob(store, digest, data, len) == 0) { return 0; }
    sakshi_debug("layer stored", strlen("layer stored"));
    return digest;
}

# ── Parsing (rust-old: parse_build_spec) ──────────────────
# Parse a Stivafile TOML string into a BuildSpec. The Rust oracle used
# `toml::from_str` (serde) over the nested BuildSpec/ImageDef/BuildStep/
# BuildConfig tree; here we drive bayan's TOML object model (bayan_toml_parse
# → sections; bayan_toml_get / _get_array / _get_sections) and rebuild the
# same struct tree by hand.
#
# bayan returns Str fat-pointers for every value; the ported BuildSpec structs
# hold cstr slots (matching the build_step_* / image_def_new constructors and
# the rest of the module), so each captured value is copied to a NUL-terminated
# cstr via str_cstr before it lands in a struct field.
#
# Error mapping (mirrors error.cyr + the Rust oracle): the Rust returns
# `Err(StivaError::InvalidState("invalid build spec: {e}"))` on any serde
# failure. bayan is best-effort (it never structurally errors), so the one
# fallible condition we can detect is the Rust `missing field `image`` — an
# absent `[image]` table. On that we return the integer sentinel 0; the caller
# reports it via stiva_err_print(STIVA_ERR_INVALID_STATE, "invalid build
# spec: missing [image] section"). A successful parse returns the BuildSpec*.
#
# Multi-stage `[[stages]]` are NOT reconstructed here: bayan's section model is
# flat (it cannot re-nest a stage's own `[[steps]]` under its stage table the
# way serde does), and the tar.gz stage BUILDER that consumes them stays
# deferred (docs/development/roadmap.md §F). `stages` therefore parses to an
# empty vec — matching the oracle's
# `#[serde(default)]` when no stages are present, which is every case the
# parse tests exercise.

# Copy a bayan value Str to a fresh NUL-terminated cstr, or 0 when the Str is
# absent (bayan_toml_get returns 0 for a missing key). Mirrors the Rust
# Option<String> → 0-for-None convention used across the ported base.
#[must_use]
fn _bld_val_cstr(v) {
    if (v == 0) { return 0; }
    return str_cstr(v);
}

# Build a vec of cstr elements from a bayan array VALUE looked up by `key` in
# `pairs` (rust-old: a serde `Vec<String>` field like a Run command or the
# entrypoint). Returns an empty vec when the key is absent or is not an array,
# so a missing `#[serde(default)]` vec field becomes `vec_new()`.
fn _bld_str_vec(pairs, key) {
    var out = vec_new();
    var arr = bayan_toml_get_array(pairs, key);
    if (arr == 0) { return out; }
    var i = 0;
    var n = vec_len(arr);
    while (i < n) {
        vec_push(out, str_cstr(vec_get(arr, i)));
        i = i + 1;
    }
    return out;
}

# Build a vec of i64 port numbers from a bayan array VALUE (rust-old:
# `Vec<u16>` expose). Each element is parsed with str_to_int. Empty vec when
# the key is absent.
fn _bld_int_vec(pairs, key) {
    var out = vec_new();
    var arr = bayan_toml_get_array(pairs, key);
    if (arr == 0) { return out; }
    var i = 0;
    var n = vec_len(arr);
    while (i < n) {
        vec_push(out, str_to_int(vec_get(arr, i)));
        i = i + 1;
    }
    return out;
}

# Reconstruct one BuildStep from a `[[steps]]` section's pairs vec, dispatching
# on the serde `type` tag (rust-old: `#[serde(tag = "type")]`). Returns a
# BuildStep* for a recognized tag, or 0 for an unknown/missing tag (rust-old:
# serde rejects an unknown variant → parse error; the caller drops the spec).
fn _bld_step_from_pairs(pairs) {
    var ty = bayan_toml_get(pairs, "type");
    if (ty == 0) { return 0; }
    if (str_eq_cstr(ty, "run") == 1) {
        return build_step_run(_bld_str_vec(pairs, "command"));
    }
    # EVERY variant's fields are REQUIRED here, and an absent one fails the
    # parse. `_bld_val_cstr` yields 0 for a missing key, and a 0 landing in a
    # BuildStep field reaches `str_from(0)` in `build_step_to_jv` (via
    # `build_cache_key`, on the ordinary build path) — a SIGSEGV driven by an
    # untrusted Stivafile, not a diagnostic. Rejecting at the parse boundary is
    # the only place the file is still a document rather than a struct.
    #
    # serde does this for free: the oracle's `#[serde(tag = "type")]` enum has
    # non-Option fields, so a missing one is a deserialization error. This is
    # that check, written out.
    if (str_eq_cstr(ty, "copy") == 1) {
        var src = _bld_val_cstr(bayan_toml_get(pairs, "source"));
        var dst = _bld_val_cstr(bayan_toml_get(pairs, "destination"));
        if (src == 0 || dst == 0) { return 0; }
        return build_step_copy(src, dst);
    }
    if (str_eq_cstr(ty, "env") == 1) {
        var ek = _bld_val_cstr(bayan_toml_get(pairs, "key"));
        var ev = _bld_val_cstr(bayan_toml_get(pairs, "value"));
        if (ek == 0 || ev == 0) { return 0; }
        return build_step_env(ek, ev);
    }
    if (str_eq_cstr(ty, "workdir") == 1) {
        var wp = _bld_val_cstr(bayan_toml_get(pairs, "path"));
        if (wp == 0) { return 0; }
        return build_step_workdir(wp);
    }
    if (str_eq_cstr(ty, "label") == 1) {
        var lk = _bld_val_cstr(bayan_toml_get(pairs, "key"));
        var lv = _bld_val_cstr(bayan_toml_get(pairs, "value"));
        if (lk == 0 || lv == 0) { return 0; }
        return build_step_label(lk, lv);
    }
    if (str_eq_cstr(ty, "from_stage") == 1) {
        var fstage = _bld_val_cstr(bayan_toml_get(pairs, "stage"));
        var fsrc = _bld_val_cstr(bayan_toml_get(pairs, "source"));
        var fdst = _bld_val_cstr(bayan_toml_get(pairs, "destination"));
        if (fstage == 0 || fsrc == 0 || fdst == 0) { return 0; }
        return build_step_from_stage(fstage, fsrc, fdst);
    }
    return 0;                              # unknown step type → parse failure
}

# Parse a Stivafile TOML string (cstr) into a BuildSpec* (rust-old:
# parse_build_spec). Returns 0 (STIVA_ERR_INVALID_STATE) on a missing [image]
# section or an unknown step type; otherwise the heap BuildSpec pointer.
#[must_use]
fn parse_build_spec(toml_str) {
    sakshi_info("parsing build specification", strlen("parsing build specification"));
    var sections = bayan_toml_parse(str_from(toml_str));

    # ── [image] → ImageDef (required) ─────────────────
    var image_secs = bayan_toml_get_sections(sections, "image");
    if (vec_len(image_secs) == 0) { return 0; }     # missing field `image`
    var image_pairs = bayan_toml_section_pairs(vec_get(image_secs, 0));
    var base = _bld_val_cstr(bayan_toml_get(image_pairs, "base"));
    var name = _bld_val_cstr(bayan_toml_get(image_pairs, "name"));
    if (base == 0) { return 0; }                    # missing field `base`
    if (name == 0) { return 0; }                    # missing field `name`
    var tag = _bld_val_cstr(bayan_toml_get(image_pairs, "tag"));
    if (tag == 0) { tag = default_tag(); }          # serde default = "latest"
    var image = image_def_new(base, name, tag);

    # ── [[steps]] → Vec<BuildStep> (serde default = empty) ────
    var steps = vec_new();
    var step_secs = bayan_toml_get_sections(sections, "steps");
    var si = 0;
    var sn = vec_len(step_secs);
    while (si < sn) {
        var step = _bld_step_from_pairs(bayan_toml_section_pairs(vec_get(step_secs, si)));
        if (step == 0) { return 0; }                # unknown/missing step type
        vec_push(steps, step);
        si = si + 1;
    }

    # ── [config] → BuildConfig (serde default) ────────
    var config_secs = bayan_toml_get_sections(sections, "config");
    var config = 0;
    if (vec_len(config_secs) == 0) {
        config = build_config_default();
    } else {
        var cp = bayan_toml_section_pairs(vec_get(config_secs, 0));
        var entrypoint = _bld_str_vec(cp, "entrypoint");
        var expose = _bld_int_vec(cp, "expose");
        var user = _bld_val_cstr(bayan_toml_get(cp, "user"));
        var workdir = _bld_val_cstr(bayan_toml_get(cp, "workdir"));
        config = build_config_new(entrypoint, expose, user, workdir);
    }

    # ── stages: flat bayan model cannot re-nest per-stage steps; the
    # consuming tar.gz stage builder is deferred (roadmap.md §F) → empty vec
    # (serde default). `build_image` below refuses `from_stage` outright.
    sakshi_debug("build spec parsed", strlen("build spec parsed"));
    return build_spec_new(image, steps, config, vec_new());
}

# ══ §F — the build driver ═══════════════
# (rust-old: build_image :255, build_copy_layer :514)
#
# `build_image` composes machinery that already exists: the tar writer and gzip
# encoder from storage.cyr, the OCI config/manifest assembly and index from
# imagelayout.cyr, the blob store from image.cyr, and the registry client from
# registry.cyr. Nothing here needs a sandbox — see the RUN note below.
#
# FIVE DELIBERATE DIVERGENCES from the oracle, each fixing a defect rather than
# reproducing it. They are the reason a built image is valid where the oracle's
# would not be:
#
#  1. `rootfs.diff_ids` are the UNCOMPRESSED tar digests. The oracle
#     (build.rs:401) maps `all_layers.iter().map(|l| l.digest)` — the COMPRESSED
#     blob digests. The OCI image-spec defines diff_ids over the uncompressed
#     layer, so every image the oracle builds fails validation in any other tool
#     and cannot have its rootfs verified. Group A already got this right for
#     `import` (imagelayout.cyr `image_import`); this matches it.
#
#  2. A MANIFEST BLOB IS WRITTEN. The oracle stores only a config blob and calls
#     add_to_index (build.rs:429-452). In this store that produces an image that
#     silently VANISHES: `image_store_load_index` reconstructs every Image from
#     its manifest blob and skips any descriptor whose manifest is missing. The
#     build would report success and `stiva images` would not list it.
#
#  3. `architecture` and `os` ARE EMITTED. The oracle's `OciImageConfig`
#     (build.rs:197-203) has exactly two fields, `config` and `rootfs` — both
#     platform keys are absent, and both are REQUIRED by the image-spec.
#
#  4. RUN STEPS ARE REFUSED, not faked. The oracle's `build_run_layer`
#     (build.rs:475) does not run anything: it writes a marker file
#     `.stiva/run/<idx>.cmd` containing the argv, and its own doc comment admits
#     this is a placeholder. Emitting that layer would produce an image
#     asserting a command ran when none did — a lie the user cannot detect from
#     the output. Refusing is the honest failure. (Executing them for real needs
#     an exec-into-an-intermediate-rootfs design, not just §D's exec primitive.)
#
#  5. `from_stage` IS REFUSED. The oracle's (build.rs:353-389) copies from
#     `<context>/<stage_name>` if that directory happens to exist and silently
#     skips otherwise; `spec.stages` is parsed and then never read by
#     build_image at all. There is no multi-stage build to port.
#
# Plus one hardening divergence: a COPY `source` may not be absolute or contain
# a `..` component. The oracle joins it straight onto the context dir, so a
# Stivafile from an untrusted repository can copy `/etc/shadow` into an image
# the user then pushes to a public registry.

# Ceiling on ONE layer's UNCOMPRESSED tar bytes, refused loudly rather than
# discovered as an OOM. 256 MiB.
#
# WHAT THIS DOES NOT BOUND, stated precisely because the number reads more
# protective than it is. By the time it is checked, `_stor_tar_collect` has
# ALREADY read every file in the context into the arena — so the check does not
# bound the collect pass. Nor does it bound the tar buffer or the gzip
# destination directly: those are sized from the assembled archive, and the
# check merely happens before them. What it actually guarantees is that a
# context whose PAYLOAD exceeds the ceiling is refused before those two
# allocations are attempted. `_stor_tar_bytes` carries its own 16 GiB backstop
# and a null-alloc check for the rest. See storage.cyr's IN-MEMORY CAVEAT; there
# is also no `free`, so a multi-step build accumulates.
var _BLD_MAX_LAYER_BYTES = 268435456;

# Total payload bytes across a TarEntry vec (headers excluded — this bounds the
# data, and the per-entry 512-byte headers are bounded by the entry count).
#[must_use]
fn _bld_entries_bytes(entries) {
    var total = 0;
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e: TarEntry = vec_get(entries, i);
        total = total + e.size;
        i = i + 1;
    }
    return total;
}

# ── copy-source fingerprint (cache invalidation) ──────────
#
# `build_cache_key` hashes `base_digest : index : step_json`, and a copy step's
# JSON is `{"type":"copy","source":"app","destination":"/app"}` — the source's
# CONTENT appears nowhere in it. So editing a file in the build context does not
# invalidate the cache and the next build silently ships the previous layer.
#
# That is inherited (`rust-old/src/build.rs:615` has the same shape) and it is
# not theoretical: it was caught here by a rebuilt binary that never reached the
# image, surfacing much later as runc reporting `stat /app/x: no such file or
# directory` for a file the user could see in their context.
#
# The fingerprint is METADATA ONLY — path, mode, uid, gid, size, mtime to the
# nanosecond — so it costs one lstat per entry and never reads file contents.
# Reading them would cost as much as rebuilding the layer, which is what the
# cache exists to avoid.
#
# LIMIT, stated because a cache that is quietly wrong is worse than none: an
# edit that preserves path, size, mode, ownership AND nanosecond mtime will not
# invalidate. Deleting `{root}/cache` forces a full rebuild.
#
# The combiner is order-INDEPENDENT (sum + xor + count over a per-entry FNV-1a)
# because `getdents64` order is filesystem-dependent; a sort would be stable but
# costs a full materialisation of the entry list for something that only feeds a
# cache key.
var _BLD_FNV_OFFSET = 14695981039346656037;
var _BLD_FNV_PRIME = 1099511628211;

#[must_use]
fn _bld_fnv1a(s, len) {
    var h = _BLD_FNV_OFFSET;
    var i = 0;
    while (i < len) {
        h = h ^ load8(s + i);
        h = h * _BLD_FNV_PRIME;
        i = i + 1;
    }
    return h;
}

# Walk `abs_dir`, folding each entry's metadata into the 3-cell accumulator
# `acc` (sum @0, xor @8, count @16). Recurses into real directories only —
# never through a symlink, matching `_stor_tar_collect`.
fn _bld_fp_walk(abs_dir, rel_prefix, acc, depth) {
    if (depth > 64) {
        # Past the cap, perturb the accumulator instead of returning quietly.
        # Silently skipping made every tree deeper than 64 levels fingerprint
        # IDENTICALLY regardless of what changed down there, so an edit below
        # the cap served a stale cached layer. A constant nudge does not
        # identify WHAT changed, but it guarantees a deep tree never collides
        # with the same tree truncated — and the cache's job is only to notice
        # that something differs.
        store64(acc, load64(acc) + 1);
        store64(acc + 16, load64(acc + 16) + 1);
        return 0;
    }
    var fd = sys_open(abs_dir, 65536, 0);          # O_DIRECTORY
    if (fd < 0) { return 0; }
    var buf = alloc(4096);
    var sb = alloc(144);
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents64(fd, buf, 4096);
        if (n <= 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var reclen = load16(buf + pos + 16);
                var name = buf + pos + 19;
                var skip = 0;
                if (load8(name) == 46) {
                    if (load8(name + 1) == 0) { skip = 1; }
                    if (load8(name + 1) == 46) { if (load8(name + 2) == 0) { skip = 1; } }
                }
                if (skip == 0) {
                    var named = _stor_dup(name);
                    var abs_child = _stor_join(abs_dir, named);
                    var rel_child = named;
                    if (strlen(rel_prefix) > 0) {
                        rel_child = _stor_cat2(_stor_cat2(rel_prefix, "/"), named);
                    }
                    if (sys_lstat(abs_child, sb) == 0) {
                        var mode = load64(sb + 24) & 65535;
                        var uid = (load64(sb + 24) >> 32) & 4294967295;
                        var gid = load64(sb + 32) & 4294967295;
                        var size = load64(sb + 48);
                        var mts = load64(sb + 88);             # st_mtime.tv_sec
                        var mtn = load64(sb + 96);             # st_mtime.tv_nsec
                        var eb = str_builder_new();
                        str_builder_add_cstr(eb, rel_child);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, mode);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, uid);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, gid);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, size);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, mts);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, mtn);
                        var es = str_builder_build(eb);
                        var h = _bld_fnv1a(str_data(es), str_len(es));
                        store64(acc, load64(acc) + h);
                        store64(acc + 8, load64(acc + 8) ^ h);
                        store64(acc + 16, load64(acc + 16) + 1);
                        if ((mode & 61440) == 16384) {         # S_IFDIR
                            _bld_fp_walk(abs_child, rel_child, acc, depth + 1);
                        }
                    }
                }
                pos = pos + reclen;
            }
        }
    }
    sys_close(fd);
    return 0;
}

# "<sum>:<xor>:<count>" for the copy source at `context_dir/source`, or "absent"
# when it cannot be stat'ed. A source that appears and a source that vanishes
# must yield different keys, so "absent" is a value rather than an error.
#[must_use]
fn _bld_source_fingerprint(context_dir, source) {
    var path = _img_cat3(context_dir, "/", source);
    var sb = alloc(144);
    if (sys_lstat(path, sb) != 0) { return "absent"; }
    var acc = alloc(24);
    store64(acc, 0);
    store64(acc + 8, 0);
    store64(acc + 16, 0);
    var mode = load64(sb + 24) & 65535;
    if ((mode & 61440) == 16384) {
        # Fold the source root's OWN metadata in, not just its children's.
        # `_bld_fp_walk` starts INSIDE the directory, so a chmod/chown of the
        # root itself changed nothing in the fingerprint and served a stale
        # layer — even though the tar records that mode on the root's entry.
        var rb = str_builder_new();
        str_builder_add_cstr(rb, ".");
        str_builder_add_cstr(rb, "|");
        str_builder_add_int(rb, mode);
        str_builder_add_cstr(rb, "|");
        str_builder_add_int(rb, (load64(sb + 24) >> 32) & 4294967295);
        str_builder_add_cstr(rb, "|");
        str_builder_add_int(rb, load64(sb + 32) & 4294967295);
        var rs = str_builder_build(rb);
        var rh = _bld_fnv1a(str_data(rs), str_len(rs));
        store64(acc, rh);
        store64(acc + 8, rh);
        store64(acc + 16, 1);
        _bld_fp_walk(path, "", acc, 0);
    } else {
        var eb = str_builder_new();
        str_builder_add_int(eb, mode);
        str_builder_add_cstr(eb, "|");
        str_builder_add_int(eb, load64(sb + 48));              # size
        str_builder_add_cstr(eb, "|");
        str_builder_add_int(eb, load64(sb + 88));              # mtime sec
        str_builder_add_cstr(eb, "|");
        str_builder_add_int(eb, load64(sb + 96));              # mtime nsec
        var es = str_builder_build(eb);
        var h = _bld_fnv1a(str_data(es), str_len(es));
        store64(acc, h);
        store64(acc + 8, h);
        store64(acc + 16, 1);
    }
    var ob = str_builder_new();
    str_builder_add_int(ob, load64(acc));
    str_builder_add_cstr(ob, ":");
    str_builder_add_int(ob, load64(acc + 8));
    str_builder_add_cstr(ob, ":");
    str_builder_add_int(ob, load64(acc + 16));
    return str_cstr(str_builder_build(ob));
}

# The cache key for a COPY step: the oracle's key with the source fingerprint
# folded in. Kept as a separate function from `build_cache_key` so the oracle's
# key stays byte-identical for the step types whose JSON really does capture
# everything that affects the layer.
#[must_use]
fn build_copy_cache_key(base_digest, step_index, step, context_dir, source) {
    var base = build_cache_key(base_digest, step_index, step);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, ":");
    str_builder_add_cstr(sb, _bld_source_fingerprint(context_dir, source));
    var input = str_builder_build(sb);
    return sha256_digest(str_data(input), str_len(input));
}

# Reject a COPY `source` that escapes the build context: absolute, empty, or
# carrying a `..` path component. Returns 1 when the path is safe.
#
# Component-wise, not a substring scan — a file legitimately named `..foo` or
# `a..b` must not be refused.
#[must_use]
fn _bld_source_is_safe(source) {
    if (source == 0) { return 0; }
    var n = strlen(source);
    if (n == 0) { return 0; }
    if (load8(source) == 47) { return 0; }         # absolute
    var i = 0;
    var start = 0;
    while (i <= n) {
        var c = 0;
        if (i < n) { c = load8(source + i); }
        if (c == 47 || i == n) {
            if (i - start == 2) {
                if (load8(source + start) == 46) {
                    if (load8(source + start + 1) == 46) { return 0; }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

# 1 when ANY component of `context_dir/source` is a symlink.
#
# The companion to `_bld_source_is_safe`'s lexical check: that one rejects a path
# that spells an escape, this one rejects a path that walks through one. Every
# prefix is `lstat`ed — `lstat`, not `stat`, because `stat` is exactly the call
# that follows the link we are trying to detect.
#
# The CONTEXT DIR ITSELF is not checked: the user names it (`-c`), so a symlinked
# context is their own choice, the same way `-c /some/link` would be. Only the
# step-supplied `source`, which comes out of the Stivafile, is constrained.
#
# Refusing rather than resolving is deliberate. Resolving and then re-checking
# containment would be TOCTOU-racy (the link can change between the check and
# `_stor_tar_collect`'s open) and would silently change which bytes land in the
# layer. A build that names a symlinked path should fail loudly.
#[must_use]
fn _bld_path_has_symlink(context_dir, source) {
    var n = strlen(source);
    var sb = alloc(144);
    var i = 0;
    while (i <= n) {
        var c = 0;
        if (i < n) { c = load8(source + i); }
        if (c == 47 || i == n) {
            if (i > 0) {
                var prefix = _img_slice(source, 0, i);
                var full = _img_cat3(context_dir, "/", prefix);
                if (sys_lstat(full, sb) == 0) {
                    if ((load64(sb + 24) & 61440) == 40960) { return 1; }   # S_IFLNK
                }
            }
            # A trailing '/' makes the kernel resolve the FINAL component too,
            # which is how `source = "evil/"` turned a symlink-to-directory into
            # a walked tree. Stopping at the last real component covers it,
            # because the component before the slash has already been checked.
        }
        i = i + 1;
    }
    return 0;
}

# Strip a leading '/' from a COPY destination (rust-old build.rs:531-534 —
# tar member names are relative). Also strips a trailing '/' so the caller
# controls where separators go.
#[must_use]
fn _bld_dest_prefix(destination) {
    if (destination == 0) { return ""; }
    var s = destination;
    while (load8(s) == 47) { s = s + 1; }
    var n = strlen(s);
    while (n > 0) {
        if (load8(s + n - 1) != 47) { break; }
        n = n - 1;
    }
    return _img_slice(s, 0, n);
}

# Build one COPY step's gzip layer. Returns the gzip buffer (its length in
# `out_len`, the UNCOMPRESSED tar digest in `out_diff`), or 0 on failure with
# the detail already printed.
#
# The uncompressed digest is captured here rather than recomputed later because
# it is the ONLY point at which the uncompressed bytes exist — the blob store
# holds the compressed layer, so a diff_id derived after the fact would have to
# gunzip it back.
# Every check a COPY step must pass before ANY of its paths are touched.
# Returns 1 when safe; prints the reason and returns 0 otherwise.
#
# Called from the driver before the cache key is computed AND from
# build_copy_layer, because the latter is also reachable directly (tests, and
# any future caller). Both are cheap.
#[must_use]
fn _bld_copy_step_is_safe(context_dir, source, destination) {
    if (_bld_source_is_safe(source) == 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE,
            _img_cat2("copy source must be relative to the build context and free of '..': ", source));
        return 0;
    }
    # A lexical check is NOT enough, and believing it was is what made the
    # hardening ineffective. `..` rejection stops a path that SPELLS an escape;
    # it does nothing about one that WALKS through a symlink:
    #
    #     ln -s / ctx/vendor          + source = "vendor/etc/hostname"
    #     ln -s /home/u/.ssh ctx/evil + source = "evil/"     (trailing slash!)
    #
    # Both were verified reading host files into an image the user then pushes.
    # Nothing downstream stops them: `sys_lstat` resolves every component but the
    # last (and a trailing '/' makes it resolve that one too), and
    # `_stor_tar_collect` opens with O_DIRECTORY, which follows unconditionally.
    if (_bld_path_has_symlink(context_dir, source) == 1) {
        stiva_err_print(STIVA_ERR_INVALID_STATE,
            _img_cat2("copy source traverses a symlink, which can leave the build context: ", source));
        return 0;
    }
    # The DESTINATION needs the same `..` rejection. `_bld_dest_prefix` only
    # strips leading and trailing slashes, so `destination = "/../../etc"`
    # produced tar members named `../../etc/...`. stiva's own extractor discards
    # those, so the layer is merely useless here — but the layer is PUSHABLE, and
    # another runtime's extractor may not be as careful. Refusing to build it is
    # the only place that decision is ours to make.
    if (_bld_dest_is_safe(destination) == 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE,
            _img_cat2("copy destination must be free of '..': ", destination));
        return 0;
    }
    return 1;
}

# 1 when `destination` carries no `..` component (component-wise, so `..foo` is
# fine). An absolute destination IS allowed — `_bld_dest_prefix` strips the
# leading '/', which is the documented form.
#[must_use]
fn _bld_dest_is_safe(destination) {
    if (destination == 0) { return 1; }            # absent -> rootfs root
    var n = strlen(destination);
    var i = 0;
    var start = 0;
    while (i <= n) {
        var c = 0;
        if (i < n) { c = load8(destination + i); }
        if (c == 47 || i == n) {
            if (i - start == 2) {
                if (load8(destination + start) == 46) {
                    if (load8(destination + start + 1) == 46) { return 0; }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

fn build_copy_layer(context_dir, source, destination, out_len, out_diff) {
    if (_bld_copy_step_is_safe(context_dir, source, destination) == 0) { return 0; }
    var src_path = _img_cat3(context_dir, "/", source);
    var sb = alloc(144);
    if (sys_lstat(src_path, sb) != 0) {
        stiva_err_print(STIVA_ERR_STORAGE, _img_cat2("copy source not found: ", src_path));
        return 0;
    }
    var st_mode = load64(sb + 24) & 65535;
    var typ = st_mode & 61440;                      # S_IFMT
    var perms = st_mode & 4095;
    var uid = (load64(sb + 24) >> 32) & 4294967295;
    var gid = load64(sb + 32) & 4294967295;

    var dest_prefix = _bld_dest_prefix(destination);
    var entries = vec_new();
    if (typ == 16384) {                             # S_IFDIR
        # `_stor_tar_collect` emits CHILDREN only, so the destination directory
        # itself needs an explicit entry — without it `copy ./app -> /app`
        # produces `app/start.sh` with no `app/` member, and a reader that
        # creates parents implicitly loses the directory's real mode.
        if (strlen(dest_prefix) > 0) {
            vec_push(entries, _tar_entry_new(_img_cat2(dest_prefix, "/"), 53, perms, uid, gid, 0, 0));
        }
        _stor_tar_collect(src_path, dest_prefix, entries);
    } else {
        if (typ != 32768) {                         # S_IFREG
            stiva_err_print(STIVA_ERR_INVALID_STATE,
                _img_cat2("copy source is neither a regular file nor a directory: ", src_path));
            return 0;
        }
        if (strlen(dest_prefix) == 0) {
            stiva_err_print(STIVA_ERR_INVALID_STATE, "copy destination cannot be the rootfs root for a file source");
            return 0;
        }
        var fc = alloc(8);
        var data = _img_read_file(src_path, fc);
        if (data == 0) {
            stiva_err_print(STIVA_ERR_STORAGE, _img_cat2("cannot read copy source: ", src_path));
            return 0;
        }
        vec_push(entries, _tar_entry_new(dest_prefix, 48, perms, uid, gid, load64(fc), data));
    }

    if (vec_len(entries) == 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, _img_cat2("copy source produced no entries: ", src_path));
        return 0;
    }
    if (_bld_entries_bytes(entries) > _BLD_MAX_LAYER_BYTES) {
        stiva_err_print(STIVA_ERR_STORAGE, "copy layer exceeds the 256 MiB per-layer ceiling");
        return 0;
    }

    var tc = alloc(8);
    var tarbuf = _stor_tar_bytes(entries, tc);
    if (tarbuf == 0) { return 0; }        # detail printed by _stor_tar_bytes
    var tarlen = load64(tc);
    store64(out_diff, sha256_digest(tarbuf, tarlen));

    var gzcap = tarlen + tarlen / 50 + 8192;
    var gzbuf = alloc(gzcap);
    # Streaming encoder, never the batch `gzip_compress` — the latter duplicates
    # bytes at every 1 MiB block boundary (see `_stor_gzip_compress`).
    var gzlen = _stor_gzip_compress(tarbuf, tarlen, gzbuf, gzcap);
    if (gzlen < 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "failed to gzip copy layer");
        return 0;
    }
    store64(out_len, gzlen);
    return gzbuf;
}

# Resolve the base image named by `base`. LOCAL FIRST, then the registry.
#
# DIVERGENCE: the oracle pulls unconditionally (build.rs:272), so a build
# against a base already in the store still needs the network and still races
# the registry's mutable tag. Local-first makes an offline rebuild reproducible
# and matches how the facade's `run` resolves. A pull still happens when the
# base is absent AND a client was supplied.
fn _bld_resolve_base(store, client, base) {
    var im = image_store_find(store, base);
    if (im != 0) { return im; }
    var ref = image_ref_parse(base);
    if (ref == 0) {
        stiva_err_print(STIVA_ERR_INVALID_REFERENCE, base);
        return 0;
    }
    # `base` as written ("alpine:3.19") and its canonical form
    # ("docker.io/library/alpine:3.19") are both legitimate index keys.
    im = image_store_find(store, image_ref_full_ref(ref));
    if (im != 0) { return im; }
    if (client == 0) {
        stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND,
            _img_cat2("base image not in the local store and no registry client is configured: ", base));
        return 0;
    }
    return image_store_pull(client, store, ref);
}

# ── layer digest → diff_id sidecar ───────────────────────
#
# A cached layer is reusable only if its UNCOMPRESSED digest is also known, and
# that is not recoverable from the stored blob without gunzipping it. The oracle
# never faced this because its diff_ids are the compressed digests it already
# has — which is the spec bug divergence 1 fixes.
#
# Keyed by LAYER digest rather than by cache key, because the mapping is a
# property of the blob: two different steps that happen to produce identical
# bytes share one entry, and it stays valid when a cache key is invalidated.

# "{root}/cache/diffid/{hex}", or 0 for a malformed layer digest (fails closed,
# like `_img_blob_path` — this string comes back off disk).
#[must_use]
fn _bld_diffid_path(store, layer_digest) {
    if (digest_is_valid(layer_digest) == 0) { return 0; }
    var dir = _img_cat2(image_store_root(store), "/cache/diffid/");
    return _img_cat2(dir, digest_hex(layer_digest));
}

# Record a layer's uncompressed digest. Returns 0 on success, -1 on failure —
# best-effort, exactly like `record_build_cache`: a failure here costs a rebuild
# next time, never correctness.
fn _bld_record_diff_id(store, layer_digest, diff_id) {
    var path = _bld_diffid_path(store, layer_digest);
    if (path == 0) { return 0 - 1; }
    var root = image_store_root(store);
    sys_mkdir(_img_cat2(root, "/cache"), 493);            # 0o755, idempotent
    sys_mkdir(_img_cat2(root, "/cache/diffid"), 493);
    if (file_write_all(path, diff_id, strlen(diff_id)) < 0) { return 0 - 1; }
    return 0;
}

# A layer's recorded uncompressed digest, or 0 when absent/malformed.
#[must_use]
fn _bld_cached_diff_id(store, layer_digest) {
    var path = _bld_diffid_path(store, layer_digest);
    if (path == 0) { return 0; }
    if (file_exists(path) == 0) { return 0; }
    var buf = alloc(128);
    var n = file_read_all(path, buf, 127);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);                                   # file_read_all does not NUL-terminate
    if (digest_is_valid(buf) == 0) { return 0; }
    return buf;
}

# Reuse a cached layer for `cache_key`, or 0 for a miss. The blob size lands in
# `out_size` and its uncompressed digest in `out_diff`.
#
# EVERY failure mode here is a MISS, never an error: a truncated cache file, a
# blob swept by `gc`, a missing diff_id sidecar, an entry written before the
# sidecar existed. The worst case is rebuilding a layer that was already cached,
# which is the correct outcome for a cache we cannot fully trust. Making any of
# these fatal would turn `rm -rf {root}/cache` into required user knowledge.
#
# Two guards the oracle does not have — it trusts the cache file verbatim
# (build.rs:286-299), so a hand-edited entry becomes a blob path.
# `_img_blob_path` already fails closed on a malformed digest, so this was a
# silent miss rather than an escape; validating here makes it a deliberate one.
#
# It does NOT re-hash the blob. Verifying content on every hit would re-read
# every layer of every build; that is `verify_integrity`'s job, and the store
# root is stiva-owned.
fn _bld_cache_hit(store, cache_key, out_size, out_diff) {
    var buf = alloc(128);
    var n = check_build_cache(store, cache_key, buf, 127);
    if (n <= 0) { return 0; }
    # `check_build_cache` returns a byte count and does NOT NUL-terminate.
    store8(buf + n, 0);
    if (digest_is_valid(buf) == 0) { return 0; }
    if (image_store_has_blob(store, buf) == 0) { return 0; }
    var diff_id = _bld_cached_diff_id(store, buf);
    if (diff_id == 0) { return 0; }
    var path = _img_blob_path(image_store_root(store), buf);
    if (path == 0) { return 0; }
    var sb = alloc(144);
    if (sys_lstat(path, sb) != 0) { return 0; }
    store64(out_size, load64(sb + 48));                   # st_size
    store64(out_diff, diff_id);
    return buf;
}

# Build an image from a parsed BuildSpec (rust-old: build_image).
#
#   spec        BuildSpec*
#   store       ImageStore*
#   client      RegistryClient*, or 0 for a strictly-local build
#   context_dir cstr — the directory COPY sources resolve against
#
# Returns the Image*, or 0 on failure with the detail already printed.
fn build_image(spec, store, client, context_dir) {
    if (spec == 0 || store == 0) { return 0; }
    var sp: BuildSpec = spec;
    var idef: ImageDef = sp.image;
    sakshi_info("starting image build", strlen("starting image build"));

    # ── 1. Base image ──
    var base = _bld_resolve_base(store, client, idef.base);
    if (base == 0) { return 0; }
    var base_diff_ids = _il_config_diff_ids(store, base);
    var base_layers = _img_layers(base);
    # A base with layers but no readable diff_ids would yield a config whose
    # rootfs omits every inherited layer — an image that unpacks to more than it
    # claims. Refuse rather than emit it.
    if (vec_len(base_layers) > 0) {
        if (vec_len(base_diff_ids) != vec_len(base_layers)) {
            stiva_err_print(STIVA_ERR_INVALID_STATE,
                "base image config has no usable rootfs.diff_ids; cannot derive from it");
            return 0;
        }
    }

    # ── 2. Steps ──
    var new_layers = vec_new();
    var new_diff_ids = vec_new();
    var env_vars = vec_new();
    var labels = vec_new();                         # alternating k, v
    var step_workdir = 0;
    # The cache key chains: each step's key covers the digest of the layer the
    # previous step produced, so an early change invalidates everything after it
    # (rust-old: `running_digest`).
    var running_digest = _img_id(base);

    var steps = sp.steps;
    var nsteps = vec_len(steps);
    var idx = 0;
    while (idx < nsteps) {
        var st: BuildStep = vec_get(steps, idx);
        var kind = st.kind;

        if (kind == BUILD_STEP_RUN) {
            stiva_err_print(STIVA_ERR_INVALID_STATE,
                _img_cat2("run steps are not executed by this build: the oracle emitted a marker file ",
                "rather than running the command, so the layer would assert work that never happened"));
            return 0;
        }
        if (kind == BUILD_STEP_FROM_STAGE) {
            stiva_err_print(STIVA_ERR_INVALID_STATE,
                "from_stage is not supported: multi-stage builds are not implemented");
            return 0;
        }

        if (kind == BUILD_STEP_ENV) {
            vec_push(env_vars, _img_cat3(st.key, "=", st.value));
        }
        if (kind == BUILD_STEP_WORKDIR) {
            step_workdir = st.source;
        }
        if (kind == BUILD_STEP_LABEL) {
            vec_push(labels, st.key);
            vec_push(labels, st.value);
        }

        if (kind == BUILD_STEP_COPY) {
            # Validate BEFORE the cache key, not just inside build_copy_layer.
            # The key's fingerprint WALKS the source tree, so on a cache miss the
            # checks in build_copy_layer would run only after an escaping path had
            # already been traversed (and its metadata folded into a key).
            if (_bld_copy_step_is_safe(context_dir, st.source, st.destination) == 0) {
                return 0;                     # detail printed by the validator
            }
            # Content-aware: the step JSON alone would let an edited context
            # reuse the previous layer. See _bld_source_fingerprint.
            var cache_key = build_copy_cache_key(running_digest, idx, vec_get(steps, idx),
            context_dir, st.source);
            var size_cell = alloc(8);
            var cdiff_cell = alloc(8);
            var cached = _bld_cache_hit(store, cache_key, size_cell, cdiff_cell);
            if (cached != 0) {
                sakshi_info("using cached layer", strlen("using cached layer"));
                vec_push(new_layers, layer_new(cached, load64(size_cell), media_oci_layer()));
                vec_push(new_diff_ids, load64(cdiff_cell));
                running_digest = cached;
            } else {
                var len_cell = alloc(8);
                var diff_cell = alloc(8);
                var gz = build_copy_layer(context_dir, st.source, st.destination, len_cell, diff_cell);
                if (gz == 0) { return 0; }
                var gzlen = load64(len_cell);
                var diff_id = load64(diff_cell);
                var digest = store_layer(store, gz, gzlen);
                if (digest == 0) {
                    stiva_err_print(STIVA_ERR_STORAGE, "failed to store copy layer blob");
                    return 0;
                }
                var _rc = record_build_cache(store, cache_key, digest);
                var _rd = _bld_record_diff_id(store, digest, diff_id);
                vec_push(new_layers, layer_new(digest, gzlen, media_oci_layer()));
                vec_push(new_diff_ids, diff_id);
                running_digest = digest;
            }
        }
        idx = idx + 1;
    }

    # ── 3. OCI image config ──
    var all_layers = vec_new();
    var all_diff_ids = vec_new();
    var bi = 0;
    var bn = vec_len(base_layers);
    while (bi < bn) {
        vec_push(all_layers, vec_get(base_layers, bi));
        vec_push(all_diff_ids, vec_get(base_diff_ids, bi));
        bi = bi + 1;
    }
    var ni = 0;
    var nn = vec_len(new_layers);
    while (ni < nn) {
        vec_push(all_layers, vec_get(new_layers, ni));
        vec_push(all_diff_ids, vec_get(new_diff_ids, ni));
        ni = ni + 1;
    }

    var bc: BuildConfig = sp.config;
    var exposed = vec_new();
    var ei = 0;
    var en = vec_len(bc.expose);
    while (ei < en) {
        var pb = str_builder_new();
        str_builder_add_int(pb, vec_get(bc.expose, ei));
        str_builder_add_cstr(pb, "/tcp");
        vec_push(exposed, str_cstr(str_builder_build(pb)));
        ei = ei + 1;
    }
    # [config].workdir wins over a `workdir` step (rust-old build.rs:412-416).
    var workdir = bc.workdir;
    if (workdir == 0) { workdir = step_workdir; }

    var arch = normalize_arch("x86_64");
    var cfg_obj = oci_config_object_jv(env_vars, 0, bc.entrypoint, workdir, bc.user, exposed, labels);
    var cfg_s = json_v_build(oci_config_build(arch, "linux", 0, cfg_obj, all_diff_ids, 0));
    var config_digest = sha256_digest(str_data(cfg_s), str_len(cfg_s));
    if (image_store_store_blob(store, config_digest, str_data(cfg_s), str_len(cfg_s)) == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "failed to store config blob");
        return 0;
    }

    # ── 4. OCI manifest blob (absent in the oracle — divergence 2) ──
    var layer_descs = vec_new();
    var total_size = 0;
    var li = 0;
    var ln = vec_len(all_layers);
    while (li < ln) {
        var lay: Layer = vec_get(all_layers, li);
        vec_push(layer_descs, descriptor_new(lay.media_type, lay.digest, lay.size_bytes));
        total_size = total_size + lay.size_bytes;
        li = li + 1;
    }
    var man = oci_manifest_new(descriptor_new(media_oci_config(), config_digest, str_len(cfg_s)), layer_descs);
    var mm: OciManifest = man;
    mm.media_type = media_oci_manifest();
    var man_s = json_v_build(oci_manifest_to_jv(man));
    var manifest_digest = sha256_digest(str_data(man_s), str_len(man_s));
    if (image_store_store_blob(store, manifest_digest, str_data(man_s), str_len(man_s)) == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "failed to store manifest blob");
        return 0;
    }

    # ── 5. Image record + index ──
    # The output reference is a TAG, so its digest slot stays EMPTY.
    #
    # The oracle sets `digest: Some(config_digest)` (build.rs:441). Under this
    # store's digest-aware index dedup that makes every build a PINNED add,
    # which replaces only an entry with the same manifest digest — so a rebuild
    # appends a second `local/<name>:<tag>` instead of moving the tag, and
    # `run`/`find` (first-match-wins) keep resolving the ORIGINAL image. The
    # rebuild appears to succeed and changes nothing, which is precisely how it
    # was found: an edited context produced a new image that nothing could
    # reach.
    #
    # A tag is a mutable pointer and must move on rebuild. Nothing is lost: the
    # image's own id IS the config digest. `image_import` already does this.
    var out_ref = image_ref_new("local", idef.name, idef.tag, 0);
    var image = image_new(config_digest, out_ref, total_size, all_layers, 0);
    _img_set_manifest_digest(image, manifest_digest);
    if (image_store_add_to_index(store, image) == 0) {
        stiva_err_print(STIVA_ERR_IO, "failed to update image index");
        return 0;
    }
    sakshi_info("build complete", strlen("build complete"));
    return image;
}
