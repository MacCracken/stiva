# stiva — OCI container runtime (Cyrius port)
# Cyrius port from rust-old/ (18622 lines of Rust; the parity oracle).
#
# In-tree program entry: the domain `src/*.cyr` modules (in dependency
# order, mirroring src/lib.cyr and cyrius.cyml [lib].modules), then the CLI
# dispatch + `main()`. The 34-subcommand CLI (rust-old/src/main.rs) is
# ported incrementally alongside its backing modules.

include "src/error.cyr"
include "src/oci.cyr"
include "src/intents.cyr"
include "src/audit.cyr"
include "src/convert.cyr"
include "src/network_mod.cyr"
include "src/network_bridge.cyr"
include "src/network_dns.cyr"
include "src/network_pool.cyr"
include "src/network_rootless.cyr"
include "src/network_nat.cyr"
include "src/network_manager.cyr"
include "src/image.cyr"
include "src/registry.cyr"
include "src/storage.cyr"
include "src/imagelayout.cyr"
include "src/build.cyr"
include "src/encrypted.cyr"
include "src/runtime.cyr"
include "src/container.cyr"
include "src/health.cyr"
include "src/ansamblu.cyr"
include "src/agent.cyr"
include "src/fleet.cyr"
include "src/mcp.cyr"
include "src/stiva_core.cyr"

# ── CLI (cmdit verb dispatch) ──
# stiva's 33 subcommands (rust-old/src/main.rs) via the cmdit library
# (dist/cmdit.cyr) — registered as verbs, not hand-rolled argv parsing.
# `convert` has ported backing (dockerfile_to_toml); the container-lifecycle +
# registry verbs are the v3.0.x runtime-completion work (blocking, over the
# ported sync core — the substrate is ready), except detached `run -d` and
# `convert compose`, which are the v3.1 externally-blocked residue.

# Verb ids — cmdit_verb returns these in registration order.
enum StivaVerb {
    V_PULL = 0; V_BUILD = 1; V_PUSH = 2; V_RUN = 3; V_PS = 4;
    V_STOP = 5; V_RM = 6; V_EXEC = 7; V_TOP = 8; V_INSPECT = 9;
    V_IMAGES = 10; V_RMI = 11; V_TAG = 12; V_PAUSE = 13; V_UNPAUSE = 14;
    V_STATS = 15; V_LOGS = 16; V_KILL = 17; V_EXPORT = 18; V_IMPORT = 19;
    V_CP = 20; V_PRUNE = 21; V_WAIT = 22; V_CHECKPOINT = 23; V_RESTORE = 24;
    V_RESTART = 25; V_INFO = 26; V_EVENTS = 27; V_DIFF = 28; V_COMPLETIONS = 29;
    V_RENAME = 30; V_GC = 31; V_CONVERT = 32;
    V_SAVE = 33; V_LOAD = 34;
}

fn _cli_puts(s) { sys_write(1, s, strlen(s)); return 0; }

#[must_use]
fn _stiva_version_str() {
    return "3.0.3 — OCI container runtime (Cyrius port)";
}

# Register all 33 subcommands (order = the verb ids above).
fn _cli_register_verbs(h) {
    cmdit_verb(h, "pull", "Pull an image from a registry");
    cmdit_verb(h, "build", "Build an image from a Stivafile");
    cmdit_verb(h, "push", "Push a local image to a registry");
    cmdit_verb(h, "run", "Run a container from an image");
    cmdit_verb(h, "ps", "List containers");
    cmdit_verb(h, "stop", "Stop a container");
    cmdit_verb(h, "rm", "Remove a container");
    cmdit_verb(h, "exec", "Execute a command in a running container");
    cmdit_verb(h, "top", "List processes in a running container");
    cmdit_verb(h, "inspect", "Inspect a container or image");
    cmdit_verb(h, "images", "List local images");
    cmdit_verb(h, "rmi", "Remove a local image");
    cmdit_verb(h, "tag", "Tag a local image");
    cmdit_verb(h, "pause", "Pause a running container");
    cmdit_verb(h, "unpause", "Unpause a paused container");
    cmdit_verb(h, "stats", "Show container stats");
    cmdit_verb(h, "logs", "Show container logs");
    cmdit_verb(h, "kill", "Send a signal to a container");
    cmdit_verb(h, "export", "Export a container's filesystem as a tar archive");
    cmdit_verb(h, "import", "Import a tar archive as an image");
    cmdit_verb(h, "cp", "Copy files between host and container");
    cmdit_verb(h, "prune", "Remove stopped containers and dangling images");
    cmdit_verb(h, "wait", "Wait for a container to exit");
    cmdit_verb(h, "checkpoint", "Checkpoint a running container (CRIU)");
    cmdit_verb(h, "restore", "Restore a checkpointed container (CRIU)");
    cmdit_verb(h, "restart", "Restart a container");
    cmdit_verb(h, "info", "Show runtime information");
    cmdit_verb(h, "events", "Stream lifecycle events");
    cmdit_verb(h, "diff", "Show filesystem changes in a container");
    cmdit_verb(h, "completions", "Generate shell completions");
    cmdit_verb(h, "rename", "Rename a container");
    cmdit_verb(h, "gc", "Garbage-collect unreferenced data");
    cmdit_verb(h, "convert", "Convert a Dockerfile or compose file to a Stivafile");
    cmdit_verb(h, "save", "Save an image as an oci-archive tarball");
    cmdit_verb(h, "load", "Load images from an oci-archive tarball");
    return 0;
}

# `convert <input> [-o output] [-f compose|dockerfile]` — the one command with
# fully-ported backing (dockerfile_to_toml; compose_yaml_to_toml is deferred).
fn _cli_convert(h) {
    var vh = cmdit_new("stiva convert");
    var f_out = cmdit_str(vh, 111, "output", 0, "Output TOML file path (default: stdout)");
    var f_fmt = cmdit_str(vh, 102, "format", "compose", "Input format: compose|dockerfile");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva convert: missing <input> file\n");
        return CMDIT_EXIT_USAGE;
    }
    var input = cmdit_positional(vh, 0);
    var buf = alloc(1048576);
    var n = file_read_all(input, buf, 1048575);
    if (n < 0) { stiva_err_print(STIVA_ERR_IO, input); return CMDIT_EXIT_RUN; }
    store8(buf + n, 0);

    var fmt = cmdit_get_str(vh, f_fmt);
    var toml = 0;
    if (streq(fmt, "dockerfile") == 1) {
        toml = dockerfile_to_toml(buf);
        if (toml == 0) {
            stiva_err_print(STIVA_ERR_INVALID_STATE, "Dockerfile has no FROM instruction");
            return CMDIT_EXIT_RUN;
        }
    } elif (streq(fmt, "compose") == 1) {
        _cli_puts("stiva convert --format compose: not yet implemented in the Cyrius port\n");
        _cli_puts("  (compose_yaml_to_toml needs a Cyrius YAML parser — deferred to v3.1;\n");
        _cli_puts("   use --format dockerfile for now)\n");
        return CMDIT_EXIT_RUN;
    } else {
        _cli_puts("stiva convert: unknown format (expected 'compose' or 'dockerfile')\n");
        return CMDIT_EXIT_USAGE;
    }

    var out = cmdit_get_str(vh, f_out);
    if (out != 0) {
        if (file_write_all(out, toml, strlen(toml)) < 0) {
            stiva_err_print(STIVA_ERR_IO, out);
            return CMDIT_EXIT_RUN;
        }
        _cli_puts(out); _cli_puts("\n");
    } else {
        _cli_puts(toml);
    }
    return CMDIT_EXIT_OK;
}

# Container-lifecycle / registry verbs that aren't wired yet. The substrate is
# ready (single-threaded run-to-completion + a blocking sandhi HTTP client), so
# these are synchronous/blocking work on the v3.0.x runtime-completion line
# (registry pull/push, container manager, exec/CRIU) — NOT async and NOT v3.1.
# The small genuinely-blocked residue (detached `run -d`, `convert compose`) is
# v3.1. See docs/development/roadmap.md.
fn _cli_deferred(verb_name) {
    _cli_puts("stiva ");
    _cli_puts(verb_name);
    _cli_puts(": not yet wired in the Cyrius port.\n");
    _cli_puts("  Part of completing the single-node runtime (v3.0.x — registry pull/push,\n");
    _cli_puts("  container lifecycle, exec/CRIU); see docs/development/roadmap.md.\n");
    return CMDIT_EXIT_RUN;
}

# Resolve the container-data root: --root flag, else $STIVA_ROOT, else default.
fn _cli_root(h, f_root) {
    var r = cmdit_get_str(h, f_root);
    if (r != 0) { return r; }
    var e = getenv("STIVA_ROOT");
    if (e != 0) { return e; }
    return "/var/lib/stiva";
}

# Find an image in the index by exact reference OR id (rust-old: ImageStore
# lookup resolves ref then id). Returns the Image* or 0.
fn _cli_find_image(images, ref) {
    if (images == 0) { return 0; }
    var n = vec_len(images);
    var i = 0;
    while (i < n) {
        var im = vec_get(images, i);
        var iim: Image = im;
        # reference is an ImageRef* — compare its full "registry/repo:tag" form.
        if (streq(image_ref_full_ref(iim.reference), ref) == 1) { return im; }
        if (streq(iim.id, ref) == 1) { return im; }
        i = i + 1;
    }
    return 0;
}

# `run <image> [command...]` — resolve the image, prepare its rootfs, and run
# the command in a kavach sandbox (one-shot). Mirrors rust-old container.rs
# create()+start(): image lookup → prepare_layers → setup_overlay (with the
# container_root/rootfs fallback when the overlay mount is unavailable) →
# generate_spec → exec_container. Detached (-d) is deferred to v3.1.
fn _cli_run(h, root) {
    var vh = cmdit_new("stiva run");
    var f_name = cmdit_str(vh, 0, "name", 0, "Container name");
    var f_backend = cmdit_str(vh, 0, "backend", 0, "Sandbox backend: process|oci|noop|gvisor|...");
    var f_workdir = cmdit_str(vh, 119, "workdir", 0, "Working directory inside the container");
    var f_detach = cmdit_bool(vh, 100, "detach", "Run detached (deferred to v3.1)");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva run: missing <image>\n");
        return CMDIT_EXIT_USAGE;
    }
    if (cmdit_get_bool(vh, f_detach) == 1) {
        _cli_puts("stiva run --detach: detached containers are deferred to v3.1\n");
        _cli_puts("  (kavach's spawn primitive can't yet thread the seccomp/cgroup/secret\n");
        _cli_puts("   policy — a half-isolated daemon won't ship; run foreground for now)\n");
        return CMDIT_EXIT_RUN;
    }
    var image_ref = cmdit_positional(vh, 0);

    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var img = _cli_find_image(image_store_load_index(store), image_ref);
    if (img == 0) {
        stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, image_ref);
        return CMDIT_EXIT_RUN;
    }
    var ii: Image = img;

    var layer_dirs = prepare_layers(store, ii.layers);
    if (layer_dirs == 0) {
        stiva_err_print(STIVA_ERR_LAYER_UNPACK, image_ref);
        return CMDIT_EXIT_RUN;
    }

    var nm = cmdit_get_str(vh, f_name);
    var cid = nm;
    if (cid == 0) { cid = _rt_cat2("run-", _rt_int_to_cstr(getpid())); }
    sys_mkdir(_rt_cat2(root, "/containers"), 493);
    var croot = _rt_cat3(root, "/containers/", cid);
    sys_mkdir(croot, 493);

    # setup_overlay needs mount privileges; on failure fall back to
    # container_root/rootfs (rust-old create() overlay match arm).
    var overlay = setup_overlay(layer_dirs, croot);
    var rootfs = 0;
    if (overlay != 0) {
        rootfs = load64(overlay + 0);   # OverlayPaths.merged
    } else {
        rootfs = _rt_cat2(croot, "/rootfs");
        sys_mkdir(rootfs, 493);
    }

    var cfg = container_config_default();
    var cc: ContainerConfig = cfg;
    var cmdv = vec_new();
    var pc = cmdit_positional_count(vh);
    var pi = 1;
    while (pi < pc) { vec_push(cmdv, cmdit_positional(vh, pi)); pi = pi + 1; }
    if (vec_len(cmdv) > 0) { cc.command = cmdv; }
    var bk = cmdit_get_str(vh, f_backend);
    if (bk != 0) { cc.backend = bk; }
    var wd = cmdit_get_str(vh, f_workdir);
    if (wd != 0) { cc.workdir = wd; }
    if (nm != 0) { cc.name = nm; }

    var ctr = container_new(cid, nm, ii.id, image_ref_full_ref(ii.reference),
    CONTAINER_STATE_CREATED, 0 - 1, 0, 0 - 1, cfg, 0 - 1);
    var spec = generate_spec(ctr, rootfs);
    if (spec == 0) { return CMDIT_EXIT_RUN; }        # detail printed by generate_spec
    var res = exec_container(spec);
    if (res == 0) { return CMDIT_EXIT_RUN; }          # detail printed by exec_container

    var rr: ContainerExecResult = res;
    if (rr.stdout != 0 && strlen(rr.stdout) > 0) { _cli_puts(rr.stdout); }
    if (rr.stderr != 0 && strlen(rr.stderr) > 0) { sys_write(2, rr.stderr, strlen(rr.stderr)); }
    write_container_log(_rt_cat2(croot, "/container.log"), res);   # for `stiva logs`

    # Persist the container record (a foreground run ALWAYS ends Stopped) so
    # `ps`/`inspect`/`rm` can see it (rust-old: start() one-shot → Stopped).
    var rec = container_new(cid, nm, ii.id, image_ref_full_ref(ii.reference),
    CONTAINER_STATE_STOPPED, 0 - 1, 0, 0 - 1, cfg, rr.exit_code);
    var cs = container_state_load(root);
    vec_push(cs, rec);
    container_state_save(root, cs);
    return rr.exit_code;
}

# `images` — list locally stored images (rust-old: Commands::Images → the
# images.json index).
fn _cli_images(root) {
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    _cli_puts("REPOSITORY\tIMAGE ID\tSIZE\n");
    var images = image_store_load_index(store);
    if (images == 0) { return CMDIT_EXIT_OK; }
    var n = vec_len(images);
    var i = 0;
    while (i < n) {
        var iim: Image = vec_get(images, i);
        _cli_puts(image_ref_full_ref(iim.reference)); _cli_puts("\t");
        _cli_puts(iim.id); _cli_puts("\t");
        _cli_puts(_rt_int_to_cstr(iim.size_bytes)); _cli_puts("\n");
        i = i + 1;
    }
    return CMDIT_EXIT_OK;
}

# `rmi <image>` — remove a local image (rust-old: Commands::Rmi → ImageStore
# remove). Accepts a reference or an id; removes by id + drops unreferenced blobs.
fn _cli_rmi(h, root) {
    var vh = cmdit_new("stiva rmi");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva rmi: missing <image>\n");
        return CMDIT_EXIT_USAGE;
    }
    var ref = cmdit_positional(vh, 0);
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var img = _cli_find_image(image_store_load_index(store), ref);
    if (img == 0) {
        stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, ref);
        return CMDIT_EXIT_RUN;
    }
    var ii: Image = img;
    var rc = image_store_remove(store, ii.id);
    if (rc == 0 - 1) { stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, ref); return CMDIT_EXIT_RUN; }
    if (rc == 0) { stiva_err_print(STIVA_ERR_IO, "failed to save image index"); return CMDIT_EXIT_RUN; }
    _cli_puts("Deleted: "); _cli_puts(ii.id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `info` — runtime information (rust-old: Commands::Info). Version + the kavach
# security strength score + backend availability.
fn _cli_info() {
    _cli_puts("stiva "); _cli_puts(_stiva_version_str()); _cli_puts("\n");
    _cli_puts("Security score: "); _cli_puts(_rt_int_to_cstr(security_score())); _cli_puts("/100\n");
    _cli_puts("Backends:\n");
    _cli_puts("  process: "); _cli_puts(_rt_int_to_cstr(backend_is_available(Backend.PROCESS))); _cli_puts("\n");
    _cli_puts("  oci:     "); _cli_puts(_rt_int_to_cstr(backend_is_available(Backend.OCI))); _cli_puts("\n");
    _cli_puts("  noop:    "); _cli_puts(_rt_int_to_cstr(backend_is_available(Backend.NOOP))); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `ps [-a]` — list containers from state.json (rust-old: Commands::Ps).
fn _cli_ps(h, root) {
    var vh = cmdit_new("stiva ps");
    var f_all = cmdit_bool(vh, 97, "all", "Show all containers (default: running only)");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    var all = cmdit_get_bool(vh, f_all);
    _cli_puts("CONTAINER ID\tIMAGE\tSTATE\tNAME\n");
    var cs = container_state_load(root);
    var n = vec_len(cs);
    var i = 0;
    while (i < n) {
        var cc: Container = vec_get(cs, i);
        if (all == 1 || cc.state == CONTAINER_STATE_RUNNING) {
            _cli_puts(cc.id); _cli_puts("\t");
            _cli_puts(cc.image_ref); _cli_puts("\t");
            _cli_puts(container_state_name(cc.state)); _cli_puts("\t");
            if (cc.name != 0) { _cli_puts(cc.name); } else { _cli_puts("-"); }
            _cli_puts("\n");
        }
        i = i + 1;
    }
    return CMDIT_EXIT_OK;
}

# `stop <container>` — stop a running container (rust-old: Commands::Stop).
fn _cli_stop(h, root) {
    var vh = cmdit_new("stiva stop");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva stop: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var id = cmdit_positional(vh, 0);
    var cs = container_state_load(root);
    var c = container_state_find(cs, id);
    if (c == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id); return CMDIT_EXIT_RUN; }
    var cc: Container = c;
    if (cc.state != CONTAINER_STATE_RUNNING) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, id);
        return CMDIT_EXIT_RUN;
    }
    if (cc.pid > 0) { send_signal(cc.pid, 15); }   # SIGTERM
    cc.state = CONTAINER_STATE_STOPPED;
    cc.pid = 0 - 1;
    container_state_save(root, cs);
    _cli_puts(cc.id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `rm <container>` — remove a container record (rust-old: Commands::Rm).
fn _cli_rm(h, root) {
    var vh = cmdit_new("stiva rm");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva rm: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var id = cmdit_positional(vh, 0);
    var cs = container_state_load(root);
    var c = container_state_find(cs, id);
    if (c == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id); return CMDIT_EXIT_RUN; }
    var cc: Container = c;
    if (cc.state == CONTAINER_STATE_RUNNING) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, "cannot remove running container — stop it first");
        return CMDIT_EXIT_RUN;
    }
    var kept = vec_new();
    var n = vec_len(cs);
    var i = 0;
    while (i < n) {
        var k: Container = vec_get(cs, i);
        if (streq(k.id, cc.id) == 0) { vec_push(kept, vec_get(cs, i)); }
        i = i + 1;
    }
    container_state_save(root, kept);
    _cli_puts(cc.id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `inspect <container>` — print a container record as JSON (rust-old: Commands::Inspect).
fn _cli_inspect(h, root) {
    var vh = cmdit_new("stiva inspect");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva inspect: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var id = cmdit_positional(vh, 0);
    var c = container_state_find(container_state_load(root), id);
    if (c == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id); return CMDIT_EXIT_RUN; }
    var s = json_v_build_pretty(container_to_jv(c), 2);
    sys_write(1, str_data(s), str_len(s));
    _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `tag <source> <target>` — add a new reference to a local image (rust-old:
# Commands::Tag → lib.rs tag).
fn _cli_tag(h, root) {
    var vh = cmdit_new("stiva tag");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 2) {
        _cli_puts("stiva tag: usage: tag <source> <target>\n");
        return CMDIT_EXIT_USAGE;
    }
    var source = cmdit_positional(vh, 0);
    var target = cmdit_positional(vh, 1);
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var rc = image_store_tag(store, source, target);
    if (rc == 0) { stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, source); return CMDIT_EXIT_RUN; }
    if (rc == 0 - 2) { stiva_err_print(STIVA_ERR_INVALID_STATE, target); return CMDIT_EXIT_RUN; }
    if (rc == 0 - 3) { stiva_err_print(STIVA_ERR_IO, "failed to update image index"); return CMDIT_EXIT_RUN; }
    _cli_puts(target); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `import <tarfile> [name] [tag]` — import a rootfs tar as an image (rust-old:
# Commands::Import → import_rootfs). name defaults to "imported", tag "latest".
fn _cli_import(h, root) {
    var vh = cmdit_new("stiva import");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva import: usage: import <tarfile> [name] [tag]\n");
        return CMDIT_EXIT_USAGE;
    }
    var file = cmdit_positional(vh, 0);
    var name = "imported";
    if (cmdit_positional_count(vh) >= 2) { name = cmdit_positional(vh, 1); }
    var tag = "latest";
    if (cmdit_positional_count(vh) >= 3) { tag = cmdit_positional(vh, 2); }
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var img = image_import(store, file, name, tag);
    if (img == 0) { return CMDIT_EXIT_RUN; }   # image_import printed the detail
    var ii: Image = img;
    _cli_puts(ii.id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# Find a container by id/name in state.json, or print not-found + return 0.
fn _cli_find_container(root, id) {
    var c = container_state_find(container_state_load(root), id);
    if (c == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id); }
    return c;
}

# `logs <container> [-n N]` — show a container's captured output (rust-old:
# Commands::Logs → log_tail). N = last N lines (0 = all).
fn _cli_logs(h, root) {
    var vh = cmdit_new("stiva logs");
    var f_tail = cmdit_int(vh, 110, "tail", 0, "Show only the last N lines (0 = all)");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva logs: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var c = _cli_find_container(root, cmdit_positional(vh, 0));
    if (c == 0) { return CMDIT_EXIT_RUN; }
    var cc: Container = c;
    var logpath = _rt_cat3(root, "/containers/", _rt_cat2(cc.id, "/container.log"));
    var out = container_log_tail(logpath, cmdit_get_int(vh, f_tail));
    if (out != 0) { _cli_puts(out); }
    return CMDIT_EXIT_OK;
}

# `wait <container>` — print + exit with the container's exit code (rust-old:
# Commands::Wait). Our foreground containers have already exited; return the
# recorded exit_status.
fn _cli_wait(h, root) {
    var vh = cmdit_new("stiva wait");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva wait: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var c = _cli_find_container(root, cmdit_positional(vh, 0));
    if (c == 0) { return CMDIT_EXIT_RUN; }
    var ec = load64(c + 72);   # Container.exit_status @ offset 72 (cycc field-collision workaround)
    if (ec == 0 - 1) { ec = 0; }
    _cli_puts(_rt_int_to_cstr(ec)); _cli_puts("\n");
    return ec;
}

# `stats <container>` — cgroup v2 resource stats (rust-old: Commands::Stats).
fn _cli_stats(h, root) {
    var vh = cmdit_new("stiva stats");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva stats: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var c = _cli_find_container(root, cmdit_positional(vh, 0));
    if (c == 0) { return CMDIT_EXIT_RUN; }
    var cc: Container = c;
    if (cc.pid <= 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, "container has no running process");
        return CMDIT_EXIT_RUN;
    }
    var st = container_stats(cc.pid);
    if (st == 0) { stiva_err_print(STIVA_ERR_RUNTIME, "cannot read cgroup stats"); return CMDIT_EXIT_RUN; }
    # ContainerStats fields via raw offsets (memory_limit_bytes collides by NAME
    # with RuntimeSpec's field — cycc field-offset collision; read by offset).
    _cli_puts("Memory:       "); _cli_puts(_rt_int_to_cstr(load64(st + 0))); _cli_puts(" bytes\n");
    _cli_puts("Memory limit: "); _cli_puts(_rt_int_to_cstr(load64(st + 8))); _cli_puts(" bytes (0 = unlimited)\n");
    _cli_puts("CPU usage:    "); _cli_puts(_rt_int_to_cstr(load64(st + 16))); _cli_puts(" us\n");
    _cli_puts("PIDs:         ");
    _cli_puts(_rt_int_to_cstr(load64(st + 24)));
    _cli_puts(" / ");
    _cli_puts(_rt_int_to_cstr(load64(st + 32)));
    _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `pause <container>` / `unpause` — cgroup freezer (rust-old: Commands::Pause/Unpause).
fn _cli_pause(h, root) {
    var vh = cmdit_new("stiva pause");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva pause: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var cs = container_state_load(root);
    var c = container_state_find(cs, cmdit_positional(vh, 0));
    if (c == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, cmdit_positional(vh, 0)); return CMDIT_EXIT_RUN; }
    var cc: Container = c;
    if (cc.state != CONTAINER_STATE_RUNNING || cc.pid <= 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, "container is not running");
        return CMDIT_EXIT_RUN;
    }
    if (pause_container(cc.pid) != STIVA_ERR_OK) { return CMDIT_EXIT_RUN; }
    cc.state = CONTAINER_STATE_PAUSED;
    container_state_save(root, cs);
    _cli_puts(cc.id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

fn _cli_unpause(h, root) {
    var vh = cmdit_new("stiva unpause");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva unpause: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var cs = container_state_load(root);
    var c = container_state_find(cs, cmdit_positional(vh, 0));
    if (c == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, cmdit_positional(vh, 0)); return CMDIT_EXIT_RUN; }
    var cc: Container = c;
    if (cc.state != CONTAINER_STATE_PAUSED || cc.pid <= 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, "container is not paused");
        return CMDIT_EXIT_RUN;
    }
    if (unpause_container(cc.pid) != STIVA_ERR_OK) { return CMDIT_EXIT_RUN; }
    cc.state = CONTAINER_STATE_RUNNING;
    container_state_save(root, cs);
    _cli_puts(cc.id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `export <container> <output>` — tar a container's rootfs (rust-old:
# Commands::Export → export_rootfs). The rootfs is {root}/containers/<id>/rootfs
# (created by `run`).
fn _cli_export(h, root) {
    var vh = cmdit_new("stiva export");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 2) {
        _cli_puts("stiva export: usage: export <container> <output.tar>\n");
        return CMDIT_EXIT_USAGE;
    }
    var id = cmdit_positional(vh, 0);
    var output = cmdit_positional(vh, 1);
    var c = container_state_find(container_state_load(root), id);
    if (c == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id); return CMDIT_EXIT_RUN; }
    var cc: Container = c;
    var rootfs = _rt_cat3(root, "/containers/", _rt_cat2(cc.id, "/rootfs"));
    if (export_rootfs(rootfs, output) == 0) { return CMDIT_EXIT_RUN; }
    _cli_puts(output); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `save <image> <output.tar>` — write an image as an oci-archive tarball
# (skopeo/podman-compatible, no registry). rc: 1 ok · 0 not found · -1 write fail.
fn _cli_save(h, root) {
    var vh = cmdit_new("stiva save");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 2) {
        _cli_puts("stiva save: usage: save <image> <output.tar>\n");
        return CMDIT_EXIT_USAGE;
    }
    var image = cmdit_positional(vh, 0);
    var output = cmdit_positional(vh, 1);
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var rc = image_store_save_archive(store, image, output);
    if (rc == 0) { stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, image); return CMDIT_EXIT_RUN; }
    if (rc == 0 - 1) { stiva_err_print(STIVA_ERR_STORAGE, "failed to write oci-archive"); return CMDIT_EXIT_RUN; }
    _cli_puts(output); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `load <input.tar>` — import images from an oci-archive tarball into the store.
fn _cli_load(h, root) {
    var vh = cmdit_new("stiva load");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva load: usage: load <input.tar>\n");
        return CMDIT_EXIT_USAGE;
    }
    var input = cmdit_positional(vh, 0);
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var rc = image_store_load_archive(store, input);
    if (rc < 0) { return CMDIT_EXIT_RUN; }   # detail already printed
    _cli_puts("Loaded "); _cli_puts(_rt_int_to_cstr(rc)); _cli_puts(" image(s)\n");
    return CMDIT_EXIT_OK;
}

# `gc` — remove unreferenced blobs (rust-old: Commands::Gc → ImageStore gc).
fn _cli_gc(h, root) {
    var vh = cmdit_new("stiva gc");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var removed = image_store_gc(store);
    _cli_puts("Removed "); _cli_puts(_rt_int_to_cstr(removed)); _cli_puts(" unreferenced blobs\n");
    return CMDIT_EXIT_OK;
}

# `prune` — remove stopped containers + images no remaining container uses
# (rust-old: Commands::Prune → lib.rs prune).
fn _cli_prune(h, root) {
    var vh = cmdit_new("stiva prune");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }

    # 1. drop Stopped containers.
    var cs = container_state_load(root);
    var kept = vec_new();
    var removed_c = 0;
    var n = vec_len(cs);
    var i = 0;
    while (i < n) {
        var cc: Container = vec_get(cs, i);
        if (cc.state == CONTAINER_STATE_STOPPED) {
            removed_c = removed_c + 1;
        } else {
            vec_push(kept, vec_get(cs, i));
        }
        i = i + 1;
    }
    container_state_save(root, kept);

    # 2. drop images no remaining container references (by image_id).
    var images = image_store_load_index(store);
    var removed_i = 0;
    var m = vec_len(images);
    var j = 0;
    while (j < m) {
        var im: Image = vec_get(images, j);
        var refd = 0;
        var k = 0;
        while (k < vec_len(kept)) {
            var kc: Container = vec_get(kept, k);
            if (streq(kc.image_id, im.id) == 1) { refd = 1; }
            k = k + 1;
        }
        if (refd == 0) {
            image_store_remove(store, im.id);
            removed_i = removed_i + 1;
        }
        j = j + 1;
    }

    _cli_puts("Removed "); _cli_puts(_rt_int_to_cstr(removed_c)); _cli_puts(" containers, ");
    _cli_puts(_rt_int_to_cstr(removed_i)); _cli_puts(" images\n");
    return CMDIT_EXIT_OK;
}

fn main() {
    alloc_init();
    kavach_init();               # register sandbox backends (idempotent; needed by the run path)
    sakshi_set_level(SK_INFO);   # structured audit trail to stderr (SK_INFO default)
    var h = cmdit_new("stiva");
    # Global flags — bind before OR after the verb (rust-old: root_path/image_path).
    var f_root = cmdit_str(h, 0, "root", 0, "Root directory for container data");
    cmdit_str(h, 0, "image-path", 0, "Image storage directory");
    _cli_register_verbs(h);

    var r = cmdit_dispatch(h);
    if (r == CMDIT_HELP) { cmdit_help(h); return CMDIT_EXIT_OK; }
    if (r == CMDIT_VERSION) { return cmdit_version(h, _stiva_version_str()); }
    if (r == CMDIT_RESULT_ERR) { cmdit_print_error(h); return CMDIT_EXIT_USAGE; }
    if (cmdit_verb_matched(h) == 0 - 1) { cmdit_help(h); return CMDIT_EXIT_USAGE; }

    var v = cmdit_verb_matched(h);
    if (v == V_CONVERT) { return _cli_convert(h); }
    if (v == V_RUN) { return _cli_run(h, _cli_root(h, f_root)); }
    if (v == V_IMAGES) { return _cli_images(_cli_root(h, f_root)); }
    if (v == V_RMI) { return _cli_rmi(h, _cli_root(h, f_root)); }
    if (v == V_PS) { return _cli_ps(h, _cli_root(h, f_root)); }
    if (v == V_STOP) { return _cli_stop(h, _cli_root(h, f_root)); }
    if (v == V_RM) { return _cli_rm(h, _cli_root(h, f_root)); }
    if (v == V_INSPECT) { return _cli_inspect(h, _cli_root(h, f_root)); }
    if (v == V_TAG) { return _cli_tag(h, _cli_root(h, f_root)); }
    if (v == V_IMPORT) { return _cli_import(h, _cli_root(h, f_root)); }
    if (v == V_LOGS) { return _cli_logs(h, _cli_root(h, f_root)); }
    if (v == V_WAIT) { return _cli_wait(h, _cli_root(h, f_root)); }
    if (v == V_STATS) { return _cli_stats(h, _cli_root(h, f_root)); }
    if (v == V_PAUSE) { return _cli_pause(h, _cli_root(h, f_root)); }
    if (v == V_UNPAUSE) { return _cli_unpause(h, _cli_root(h, f_root)); }
    if (v == V_EXPORT) { return _cli_export(h, _cli_root(h, f_root)); }
    if (v == V_GC) { return _cli_gc(h, _cli_root(h, f_root)); }
    if (v == V_PRUNE) { return _cli_prune(h, _cli_root(h, f_root)); }
    if (v == V_INFO) { return _cli_info(); }
    if (v == V_SAVE) { return _cli_save(h, _cli_root(h, f_root)); }
    if (v == V_LOAD) { return _cli_load(h, _cli_root(h, f_root)); }
    # Every other verb is the not-yet-wired surface (mostly v3.0.x, small v3.1 residue).
    return _cli_deferred(_cli_verb_name(v));
}

# Verb id → display name (for the deferred message; registration order).
#[must_use]
fn _cli_verb_name(v) {
    if (v == V_PULL) { return "pull"; }
    if (v == V_BUILD) { return "build"; }
    if (v == V_PUSH) { return "push"; }
    if (v == V_RUN) { return "run"; }
    if (v == V_PS) { return "ps"; }
    if (v == V_STOP) { return "stop"; }
    if (v == V_RM) { return "rm"; }
    if (v == V_EXEC) { return "exec"; }
    if (v == V_TOP) { return "top"; }
    if (v == V_INSPECT) { return "inspect"; }
    if (v == V_IMAGES) { return "images"; }
    if (v == V_RMI) { return "rmi"; }
    if (v == V_TAG) { return "tag"; }
    if (v == V_PAUSE) { return "pause"; }
    if (v == V_UNPAUSE) { return "unpause"; }
    if (v == V_STATS) { return "stats"; }
    if (v == V_LOGS) { return "logs"; }
    if (v == V_KILL) { return "kill"; }
    if (v == V_EXPORT) { return "export"; }
    if (v == V_IMPORT) { return "import"; }
    if (v == V_CP) { return "cp"; }
    if (v == V_PRUNE) { return "prune"; }
    if (v == V_WAIT) { return "wait"; }
    if (v == V_CHECKPOINT) { return "checkpoint"; }
    if (v == V_RESTORE) { return "restore"; }
    if (v == V_RESTART) { return "restart"; }
    if (v == V_INFO) { return "info"; }
    if (v == V_EVENTS) { return "events"; }
    if (v == V_DIFF) { return "diff"; }
    if (v == V_COMPLETIONS) { return "completions"; }
    if (v == V_RENAME) { return "rename"; }
    if (v == V_GC) { return "gc"; }
    if (v == V_SAVE) { return "save"; }
    if (v == V_LOAD) { return "load"; }
    return "unknown";
}

var _rc = main();
syscall(SYS_EXIT, _rc);
