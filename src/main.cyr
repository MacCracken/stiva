# stiva — OCI container runtime (Cyrius port)
# Cyrius port from rust-old/ (18622 lines of Rust; the parity oracle).
#
# In-tree program entry: the domain `src/*.cyr` modules (in dependency
# order, mirroring src/lib.cyr and cyrius.cyml [lib].modules), then the CLI
# dispatch + `main()`. The 34-subcommand CLI (rust-old/src/main.rs) is
# ported incrementally alongside its backing modules.

include "src/error.cyr"
include "src/oci.cyr"
include "src/intents.cyr"
include "src/audit.cyr"
include "src/convert.cyr"
include "src/network_mod.cyr"
include "src/network_bridge.cyr"
include "src/network_dns.cyr"
include "src/network_pool.cyr"
include "src/network_rootless.cyr"
include "src/network_nat.cyr"
include "src/network_manager.cyr"
include "src/image.cyr"
include "src/registry.cyr"
include "src/storage.cyr"
include "src/imagelayout.cyr"
include "src/build.cyr"
include "src/encrypted.cyr"
include "src/runtime.cyr"
include "src/container.cyr"
include "src/health.cyr"
include "src/ansamblu.cyr"
include "src/agent.cyr"
include "src/fleet.cyr"
include "src/mcp.cyr"
include "src/stiva_core.cyr"

# ── CLI (cmdit verb dispatch) ──
# stiva's 33 subcommands (rust-old/src/main.rs) via the cmdit library
# (dist/cmdit.cyr) — registered as verbs, not hand-rolled argv parsing.
# `convert` has ported backing for BOTH formats (dockerfile_to_toml +
# compose_yaml_to_toml); the container-lifecycle + registry verbs are the
# v3.0.x runtime-completion work (blocking, over the ported sync core — the
# substrate is ready), except detached `run -d`, the v3.1 externally-blocked
# residue.

# Verb ids — cmdit_verb returns these in registration order.
enum StivaVerb {
    V_PULL = 0; V_BUILD = 1; V_PUSH = 2; V_RUN = 3; V_PS = 4;
    V_STOP = 5; V_RM = 6; V_EXEC = 7; V_TOP = 8; V_INSPECT = 9;
    V_IMAGES = 10; V_RMI = 11; V_TAG = 12; V_PAUSE = 13; V_UNPAUSE = 14;
    V_STATS = 15; V_LOGS = 16; V_KILL = 17; V_EXPORT = 18; V_IMPORT = 19;
    V_CP = 20; V_PRUNE = 21; V_WAIT = 22; V_CHECKPOINT = 23; V_RESTORE = 24;
    V_RESTART = 25; V_INFO = 26; V_EVENTS = 27; V_DIFF = 28; V_COMPLETIONS = 29;
    V_RENAME = 30; V_GC = 31; V_CONVERT = 32;
    V_SAVE = 33; V_LOAD = 34;
}

fn _cli_puts(s) { sys_write(1, s, strlen(s)); return 0; }

# Diagnostics that must NOT land on stdout. `completions` writes a shell script
# to stdout for the caller to redirect into a file or eval; a usage or error
# line mixed into that stream becomes a syntax error inside the user's shell
# config, which is a far worse failure than the original mistake.
fn _cli_eputs(s) { sys_write(2, s, strlen(s)); return 0; }

# NOTE: this literal does NOT track the VERSION file — cyrius.cyml reads
# `version = "${file:VERSION}"`, but nothing interpolates it into the compiled
# binary, so `stiva --version` is only correct if this string is bumped by hand.
# It was missed for 3.0.5 and reported 3.0.4 from a tree already bumped.
# scripts/version-bump.sh now rewrites it; keep the `X.Y.Z — ` prefix shape it
# greps for, and re-run the script rather than editing this alone.
#[must_use]
fn _stiva_version_str() {
    return "3.0.14 — OCI container runtime (Cyrius port)";
}

# Register all 33 subcommands (order = the verb ids above).
fn _cli_register_verbs(h) {
    cmdit_verb(h, "pull", "Pull an image from a registry");
    cmdit_verb(h, "build", "Build an image from a Stivafile");
    cmdit_verb(h, "push", "Push a local image to a registry");
    cmdit_verb(h, "run", "Run a container from an image");
    cmdit_verb(h, "ps", "List containers");
    cmdit_verb(h, "stop", "Stop a container");
    cmdit_verb(h, "rm", "Remove a container");
    cmdit_verb(h, "exec", "Execute a command in a running container");
    cmdit_verb(h, "top", "List processes in a running container");
    cmdit_verb(h, "inspect", "Inspect a container or image");
    cmdit_verb(h, "images", "List local images");
    cmdit_verb(h, "rmi", "Remove a local image");
    cmdit_verb(h, "tag", "Tag a local image");
    cmdit_verb(h, "pause", "Pause a running container");
    cmdit_verb(h, "unpause", "Unpause a paused container");
    cmdit_verb(h, "stats", "Show container stats");
    cmdit_verb(h, "logs", "Show container logs");
    cmdit_verb(h, "kill", "Send a signal to a container");
    cmdit_verb(h, "export", "Export a container's filesystem as a tar archive");
    cmdit_verb(h, "import", "Import a tar archive as an image");
    cmdit_verb(h, "cp", "Copy files between host and container");
    cmdit_verb(h, "prune", "Remove stopped containers and dangling images");
    cmdit_verb(h, "wait", "Wait for a container to exit");
    cmdit_verb(h, "checkpoint", "Checkpoint a running container (CRIU)");
    cmdit_verb(h, "restore", "Restore a checkpointed container (CRIU)");
    cmdit_verb(h, "restart", "Restart a container");
    cmdit_verb(h, "info", "Show runtime information");
    cmdit_verb(h, "events", "Stream lifecycle events");
    cmdit_verb(h, "diff", "Show filesystem changes in a container");
    cmdit_verb(h, "completions", "Generate shell completions");
    cmdit_verb(h, "rename", "Rename a container");
    cmdit_verb(h, "gc", "Garbage-collect unreferenced data");
    cmdit_verb(h, "convert", "Convert a Dockerfile or compose file to a Stivafile");
    cmdit_verb(h, "save", "Save an image as an oci-archive tarball");
    cmdit_verb(h, "load", "Load images from an oci-archive tarball");
    return 0;
}

# `convert <input> [-o output] [-f compose|dockerfile]` — both formats are
# fully ported (dockerfile_to_toml + compose_yaml_to_toml). Compose covers a
# documented YAML subset; see the section header in src/convert.cyr.
fn _cli_convert(h) {
    var vh = cmdit_new("stiva convert");
    var f_out = cmdit_str(vh, 111, "output", 0, "Output TOML file path (default: stdout)");
    var f_fmt = cmdit_str(vh, 102, "format", "compose", "Input format: compose|dockerfile");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva convert: missing <input> file\n");
        return CMDIT_EXIT_USAGE;
    }
    var input = cmdit_positional(vh, 0);
    # A directory opens fine and read()s 0 bytes, so file_read_all returns 0
    # rather than an error and the conversion would "succeed" with empty
    # output and exit 0. The oracle's fs::read_to_string surfaces EISDIR
    # (rust-old/src/main.rs:509) and exits before convert is reached.
    # NOTE: is_dir takes a `Str`, not a cstr (lib/fs.cyr:229 calls str_data on
    # it). Passing the bare cstr compiles and silently never matches.
    if (is_dir(str_new(input, strlen(input))) == 1) {
        stiva_err_print(STIVA_ERR_IO, _rt_cat2("not a regular file: ", input));
        return CMDIT_EXIT_RUN;
    }
    # Read one byte PAST the limit so saturation is unambiguous: n > the
    # limit means there was more file, n == the limit means it fit exactly.
    # (Reading exactly `limit` bytes cannot distinguish the two, which is why
    # the first cut of this guard rejected a complete 1048575-byte input.)
    var buf = alloc(1048578);
    var n = file_read_all(input, buf, 1048577);
    if (n < 0) { stiva_err_print(STIVA_ERR_IO, input); return CMDIT_EXIT_RUN; }
    # Truncating silently produces a plausible-but-wrong Stivafile — or, on
    # the compose path, a baffling YAML parse error pointing at a line the
    # user can see is fine — so refuse instead.
    if (n > 1048576) {
        stiva_err_print(STIVA_ERR_INVALID_STATE,
        _rt_cat2("input exceeds the 1 MiB convert limit: ", input));
        return CMDIT_EXIT_RUN;
    }
    store8(buf + n, 0);

    var fmt = cmdit_get_str(vh, f_fmt);
    var toml = 0;
    if (streq(fmt, "dockerfile") == 1) {
        toml = dockerfile_to_toml(buf);
        if (toml == 0) {
            stiva_err_print(STIVA_ERR_INVALID_STATE, "Dockerfile has no FROM instruction");
            return CMDIT_EXIT_RUN;
        }
    } elif (streq(fmt, "compose") == 1) {
        toml = compose_yaml_to_toml(buf);
        if (toml == 0) {
            stiva_err_print(STIVA_ERR_INVALID_STATE, compose_last_error());
            return CMDIT_EXIT_RUN;
        }
    } else {
        _cli_puts("stiva convert: unknown format (expected 'compose' or 'dockerfile')\n");
        return CMDIT_EXIT_USAGE;
    }

    var out = cmdit_get_str(vh, f_out);
    if (out != 0) {
        if (file_write_all(out, toml, strlen(toml)) < 0) {
            stiva_err_print(STIVA_ERR_IO, out);
            return CMDIT_EXIT_RUN;
        }
        _cli_puts(out); _cli_puts("\n");
    } else {
        _cli_puts(toml);
    }
    return CMDIT_EXIT_OK;
}

# Container-lifecycle / registry verbs that aren't wired yet. The substrate is
# ready (single-threaded run-to-completion + a blocking sandhi HTTP client), so
# these are synchronous/blocking work on the v3.0.x runtime-completion line
# (registry pull/push, container manager, exec/CRIU) — NOT async and NOT v3.1.
# The small genuinely-blocked residue (detached `run -d`, interactive
# `exec -it`) is v3.1. See docs/development/roadmap.md.
fn _cli_deferred(verb_name) {
    _cli_puts("stiva ");
    _cli_puts(verb_name);
    _cli_puts(": not yet wired in the Cyrius port.\n");
    _cli_puts("  Part of completing the single-node runtime (v3.0.x — registry pull/push,\n");
    _cli_puts("  container lifecycle, exec/CRIU); see docs/development/roadmap.md.\n");
    return CMDIT_EXIT_RUN;
}

# Resolve the container-data root: --root flag, else $STIVA_ROOT, else default.
fn _cli_root(h, f_root) {
    var r = cmdit_get_str(h, f_root);
    if (r != 0) { return r; }
    var e = getenv("STIVA_ROOT");
    if (e != 0) { return e; }
    return "/var/lib/stiva";
}

# Find an image in the index by exact reference OR id (rust-old: ImageStore
# lookup resolves ref then id). Returns the Image* or 0.
fn _cli_find_image(images, ref) {
    if (images == 0) { return 0; }
    var n = vec_len(images);
    var i = 0;
    while (i < n) {
        var im = vec_get(images, i);
        var iim: Image = im;
        # reference is an ImageRef* — compare its full "registry/repo:tag" form.
        if (streq(image_ref_full_ref(iim.reference), ref) == 1) { return im; }
        if (streq(iim.id, ref) == 1) { return im; }
        i = i + 1;
    }
    return 0;
}

# `run <image> [command...]` — resolve the image, prepare its rootfs, and run
# the command in a kavach sandbox (one-shot). Mirrors rust-old container.rs
# create()+start(): image lookup → prepare_layers → setup_overlay (with the
# container_root/rootfs fallback when the overlay mount is unavailable) →
# generate_spec → exec_container. Detached (-d) is deferred to v3.1.
fn _cli_run(h, root) {
    var vh = cmdit_new("stiva run");
    var f_name = cmdit_str(vh, 0, "name", 0, "Container name");
    var f_backend = cmdit_str(vh, 0, "backend", 0, "Sandbox backend: process|oci|noop|gvisor|...");
    var f_workdir = cmdit_str(vh, 119, "workdir", 0, "Working directory inside the container");
    var f_detach = cmdit_bool(vh, 100, "detach", "Run detached; prints the container id and returns");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva run: missing <image>\n");
        return CMDIT_EXIT_USAGE;
    }
    var image_ref = cmdit_positional(vh, 0);

    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var img = _cli_find_image(image_store_load_index(store), image_ref);
    if (img == 0) {
        stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, image_ref);
        return CMDIT_EXIT_RUN;
    }

    # Build the container config from the flags + positional command.
    var cfg = container_config_default();
    var cc: ContainerConfig = cfg;
    var cmdv = vec_new();
    var pc = cmdit_positional_count(vh);
    var pi = 1;
    while (pi < pc) { vec_push(cmdv, cmdit_positional(vh, pi)); pi = pi + 1; }
    if (vec_len(cmdv) > 0) { cc.command = cmdv; }
    var bk = cmdit_get_str(vh, f_backend);
    if (bk != 0) { cc.backend = bk; }
    var wd = cmdit_get_str(vh, f_workdir);
    if (wd != 0) { cc.workdir = wd; }
    var nm = cmdit_get_str(vh, f_name);
    if (nm != 0) { cc.name = nm; }
    cc.detach = cmdit_get_bool(vh, f_detach);

    # Through the manager (rust-old: Stiva::run → create + start one-shot):
    # unpack → overlay → spec → CREATED record → exec_container → STOPPED, with
    # lifecycle events published. Then print the cached one-shot output and
    # return the exit code, preserving the foreground-run UX.
    var mgr = container_manager_new(root, store);
    var rec = container_manager_create(mgr, img, cfg);
    if (rec == 0) { return CMDIT_EXIT_RUN; }          # detail printed by create
    var rc: Container = rec;
    if (container_manager_start(mgr, rc.id) != STIVA_ERR_OK) { return CMDIT_EXIT_RUN; }

    # Detached: the container is still running, so there is nothing to wait for
    # and no output to relay. Print the id and return, the way `docker run -d`
    # does — the caller reaches the output through `stiva logs`.
    if (cc.detach == 1) {
        _cli_puts(rc.id);
        _cli_puts("\n");
        return CMDIT_EXIT_OK;
    }

    var res = container_manager_wait(mgr, rc.id);      # cached ContainerExecResult*
    if (res != 0) {
        var so = load64(res + 8);                      # ExecResult.stdout @8 (raw — cycc 20/21)
        var se = load64(res + 16);                     # ExecResult.stderr @16
        if (so != 0 && strlen(so) > 0) { _cli_puts(so); }
        if (se != 0 && strlen(se) > 0) { sys_write(2, se, strlen(se)); }
    }
    return rc.exit_status;
}

# `images` — list locally stored images (rust-old: Commands::Images → the
# images.json index).
fn _cli_images(root) {
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    _cli_puts("REPOSITORY\tIMAGE ID\tSIZE\n");
    var images = image_store_load_index(store);
    if (images == 0) { return CMDIT_EXIT_OK; }
    var n = vec_len(images);
    var i = 0;
    while (i < n) {
        var iim: Image = vec_get(images, i);
        _cli_puts(image_ref_full_ref(iim.reference)); _cli_puts("\t");
        _cli_puts(iim.id); _cli_puts("\t");
        _cli_puts(_rt_int_to_cstr(iim.size_bytes)); _cli_puts("\n");
        i = i + 1;
    }
    return CMDIT_EXIT_OK;
}

# `rmi <image>` — remove a local image (rust-old: Commands::Rmi → ImageStore
# remove). Accepts a reference or an id; removes by id + drops unreferenced blobs.
fn _cli_rmi(h, root) {
    var vh = cmdit_new("stiva rmi");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva rmi: missing <image>\n");
        return CMDIT_EXIT_USAGE;
    }
    var ref = cmdit_positional(vh, 0);
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var img = _cli_find_image(image_store_load_index(store), ref);
    if (img == 0) {
        stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, ref);
        return CMDIT_EXIT_RUN;
    }
    var ii: Image = img;
    var rc = image_store_remove(store, ii.id);
    if (rc == 0 - 1) { stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, ref); return CMDIT_EXIT_RUN; }
    if (rc == 0) { stiva_err_print(STIVA_ERR_IO, "failed to save image index"); return CMDIT_EXIT_RUN; }
    _cli_puts("Deleted: "); _cli_puts(ii.id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `info` — runtime information (rust-old: Commands::Info). Version + the kavach
# security strength score + backend availability.
fn _cli_info() {
    _cli_puts("stiva "); _cli_puts(_stiva_version_str()); _cli_puts("\n");
    _cli_puts("Security score: "); _cli_puts(_rt_int_to_cstr(security_score())); _cli_puts("/100\n");
    _cli_puts("Backends:\n");
    _cli_puts("  process: "); _cli_puts(_rt_int_to_cstr(backend_is_available(Backend.PROCESS))); _cli_puts("\n");
    _cli_puts("  oci:     "); _cli_puts(_rt_int_to_cstr(backend_is_available(Backend.OCI))); _cli_puts("\n");
    _cli_puts("  noop:    "); _cli_puts(_rt_int_to_cstr(backend_is_available(Backend.NOOP))); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `ps [-a]` — list containers from state.json (rust-old: Commands::Ps).
fn _cli_ps(h, root) {
    var vh = cmdit_new("stiva ps");
    var f_all = cmdit_bool(vh, 97, "all", "Show all containers (default: running only)");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    var all = cmdit_get_bool(vh, f_all);
    _cli_puts("CONTAINER ID\tIMAGE\tSTATE\tNAME\n");
    # Through the manager (rust-old: Stiva::ps → ContainerManager::list).
    var cs = container_manager_list(container_manager_new(root, image_store_new(root)));
    var n = vec_len(cs);
    var i = 0;
    while (i < n) {
        var cc: Container = vec_get(cs, i);
        if (all == 1 || cc.state == CONTAINER_STATE_RUNNING) {
            _cli_puts(cc.id); _cli_puts("\t");
            _cli_puts(cc.image_ref); _cli_puts("\t");
            _cli_puts(container_state_name(cc.state)); _cli_puts("\t");
            if (cc.name != 0) { _cli_puts(cc.name); } else { _cli_puts("-"); }
            _cli_puts("\n");
        }
        i = i + 1;
    }
    return CMDIT_EXIT_OK;
}

# `stop <container>` — stop a running container (rust-old: Commands::Stop).
fn _cli_stop(h, root) {
    var vh = cmdit_new("stiva stop");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva stop: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var id = cmdit_positional(vh, 0);
    # Through the manager (rust-old: Stiva::stop). One-shot containers are
    # already Stopped, so this is idempotent rather than an error — the manager
    # handles the daemon SIGTERM/grace path (v3.1) when a handle exists.
    var mgr = container_manager_new(root, image_store_new(root));
    if (container_manager_stop(mgr, id) != STIVA_ERR_OK) { return CMDIT_EXIT_RUN; }
    _cli_puts(id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `rm <container>` — remove a container record (rust-old: Commands::Rm).
fn _cli_rm(h, root) {
    var vh = cmdit_new("stiva rm");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva rm: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var id = cmdit_positional(vh, 0);
    # Through the manager (rust-old: Stiva::rm → remove): refuses Running,
    # tears down the overlay, drops the record + directory, emits `removed`.
    var mgr = container_manager_new(root, image_store_new(root));
    if (container_manager_remove(mgr, id) != STIVA_ERR_OK) { return CMDIT_EXIT_RUN; }
    _cli_puts(id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `inspect <container>` — print a container record as JSON (rust-old: Commands::Inspect).
fn _cli_inspect(h, root) {
    var vh = cmdit_new("stiva inspect");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva inspect: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var id = cmdit_positional(vh, 0);
    var mgr = container_manager_new(root, image_store_new(root));
    var c = container_manager_get(mgr, id);
    if (c == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id); return CMDIT_EXIT_RUN; }
    var s = json_v_build_pretty(container_to_jv(c), 2);
    sys_write(1, str_data(s), str_len(s));
    _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `tag <source> <target>` — add a new reference to a local image (rust-old:
# Commands::Tag → lib.rs tag).
fn _cli_tag(h, root) {
    var vh = cmdit_new("stiva tag");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 2) {
        _cli_puts("stiva tag: usage: tag <source> <target>\n");
        return CMDIT_EXIT_USAGE;
    }
    var source = cmdit_positional(vh, 0);
    var target = cmdit_positional(vh, 1);
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var rc = image_store_tag(store, source, target);
    if (rc == 0) { stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, source); return CMDIT_EXIT_RUN; }
    if (rc == 0 - 2) { stiva_err_print(STIVA_ERR_INVALID_STATE, target); return CMDIT_EXIT_RUN; }
    if (rc == 0 - 3) { stiva_err_print(STIVA_ERR_IO, "failed to update image index"); return CMDIT_EXIT_RUN; }
    _cli_puts(target); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `import <tarfile> [name] [tag]` — import a rootfs tar as an image (rust-old:
# Commands::Import → import_rootfs). name defaults to "imported", tag "latest".
fn _cli_import(h, root) {
    var vh = cmdit_new("stiva import");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva import: usage: import <tarfile> [name] [tag]\n");
        return CMDIT_EXIT_USAGE;
    }
    var file = cmdit_positional(vh, 0);
    var name = "imported";
    if (cmdit_positional_count(vh) >= 2) { name = cmdit_positional(vh, 1); }
    var tag = "latest";
    if (cmdit_positional_count(vh) >= 3) { tag = cmdit_positional(vh, 2); }
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var img = image_import(store, file, name, tag);
    if (img == 0) { return CMDIT_EXIT_RUN; }   # image_import printed the detail
    var ii: Image = img;
    _cli_puts(ii.id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `logs <container> [-n N] [--scan]` — show a container's captured output
# (rust-old: Commands::Logs → log_tail). N = last N lines (0 = all).
#
# `--scan` routes the body through runtime.cyr's scan_output (kavach's
# externalization gate) before printing: secrets are redacted at WARN, and a
# QUARANTINE/BLOCK verdict refuses to print at all. The oracle gates this on
# a PERSISTED `container.config.scan_policy` (rust-old/src/container.rs:1210-
# 1222), but the Cyrius port zeroes that field on save/load (container.cyr
# TODO(v3.1)), so it is an explicit opt-in flag here rather than a silent
# record-driven default. Off by default — scanning changes what `logs` prints,
# and that must never happen behind the operator's back.
# Poll interval while following, and how long the log must stay QUIET before
# the follow concludes the writer is done. 2 s is a deliberate trade: long
# enough not to cut off a writer between two lines, short enough that a script
# calling `logs -f` on a finished container is not left waiting.
var _CLI_FOLLOW_POLL_MS = 200;
var _CLI_FOLLOW_QUIET_MS = 2000;

# `logs -f` — print the log, then keep printing as it grows, stopping once it
# has been quiet for _CLI_FOLLOW_QUIET_MS.
#
# Termination is QUIESCENCE-based, not container-state-based, and that is not a
# shortcut. `container_fixup_after_restart` (src/container.cyr:181) rewrites
# RUNNING/PAUSED to STOPPED for every record loaded from disk — a stale pid from
# a dead process is worse than none — so a fresh CLI process can never observe a
# container as Running. A state-based loop therefore exits on its first pass
# having followed nothing, which is exactly what the first version of this did.
# Once `run -d` lands (v3.1) and there is a live pid to probe, state becomes the
# better signal and should replace this.
#
# It polls the FILE rather than the lifecycle bus because the bus is a
# per-ContainerManager in-process `pubsub_new()` (src/container.cyr:896), never
# persisted, so a second process sees an empty one.
#
# `--scan` is refused alongside `--follow`: the externalization gate scans a
# COMPLETE output, and redacting a stream a chunk at a time could split a secret
# across two reads and pass both halves.
fn _cli_logs_follow(mgr, id, scan, tail_n) {
    if (scan == 1) {
        _cli_eputs("stiva logs: --scan cannot be combined with --follow\n");
        _cli_eputs("  the gate scans a complete output; a chunked stream could split a secret across reads\n");
        return CMDIT_EXIT_USAGE;
    }
    var path = container_manager_log_path(mgr, id);
    if (path == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return CMDIT_EXIT_RUN;
    }
    var off = 0;
    # `-n N` with `-f` prints the last N lines first and then follows from the
    # end, the way docker does — rather than silently ignoring -n, which is what
    # short-circuiting to the follow loop used to do.
    if (tail_n > 0) {
        var head = container_manager_log_tail(mgr, id, tail_n);
        if (head != 0) { _cli_puts(head); }
        off = _cli_file_size(path);
        if (off < 0) { off = 0; }
    }
    var buf = alloc(65536);
    var quiet_ms = 0;
    var going = 1;
    while (going == 1) {
        var grew = 0;
        var fd = file_open(path, 0, 0);           # O_RDONLY; absent until first write
        if (fd >= 0) {
            xlseek(fd, off, 0);                   # SEEK_SET — resume where we stopped
            var reading = 1;
            while (reading == 1) {
                var n = sys_read(fd, buf, 65536);
                if (n <= 0) { reading = 0; }
                else {
                    sys_write(1, buf, n);
                    off = off + n;
                    grew = 1;
                }
            }
            file_close(fd);
        }
        if (grew == 1) { quiet_ms = 0; }
        else { quiet_ms = quiet_ms + _CLI_FOLLOW_POLL_MS; }
        if (quiet_ms >= _CLI_FOLLOW_QUIET_MS) { going = 0; }
        else { sleep_ms(_CLI_FOLLOW_POLL_MS); }
    }
    return CMDIT_EXIT_OK;
}

# Byte length of `path`, or -1.
#[must_use]
fn _cli_file_size(path) {
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var sz = xlseek(fd, 0, 2);                    # SEEK_END
    file_close(fd);
    return sz;
}

fn _cli_logs(h, root) {
    var vh = cmdit_new("stiva logs");
    var f_tail = cmdit_int(vh, 110, "tail", 0, "Show only the last N lines (0 = all)");
    var f_scan = cmdit_bool(vh, 0, "scan", "Scan output for secrets/PII before printing (redacts, or refuses)");
    var f_follow = cmdit_bool(vh, 102, "follow", "Follow the log until the container stops");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva logs: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var id = cmdit_positional(vh, 0);
    # Through the manager (rust-old: Stiva::log_tail). Resolves the log path
    # from the record's container dir (internals is empty in a fresh process).
    var mgr = container_manager_new(root, image_store_new(root));
    if (container_manager_get(mgr, id) == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return CMDIT_EXIT_RUN;
    }
    if (cmdit_get_bool(vh, f_follow) == 1) {
        return _cli_logs_follow(mgr, id, cmdit_get_bool(vh, f_scan), cmdit_get_int(vh, f_tail));
    }
    var out = container_manager_log_tail(mgr, id, cmdit_get_int(vh, f_tail));
    if (out == 0) { return CMDIT_EXIT_OK; }
    if (cmdit_get_bool(vh, f_scan) == 1) {
        # Synthesize the ContainerExecResult the gate expects — the oracle
        # does the same at container.rs:1213-1219 (exit_code 0, empty stderr).
        var sres = scan_output(container_exec_result_new(0, out, "", 0, 0),
        ext_policy_default());
        if (sres == 0) { return CMDIT_EXIT_RUN; }   # detail printed by scan_output
        out = load64(sres + 8);                     # scanned.stdout, raw offset
    }
    _cli_puts(out);
    return CMDIT_EXIT_OK;
}

# ── `events` ─────────────────────────────────
# Reads {root}/events.jsonl, the log every container_manager_publish_event
# appends to (src/container.cyr, "the on-disk lifecycle event log"). The oracle
# (rust-old/src/main.rs:525) subscribed to the in-process bus and looped on
# rx.recv() forever — in a one-shot CLI that subscribes to a publisher nothing
# else in the process will ever publish to, so it printed nothing until Ctrl+C.
# This is a rewrite, not a port; the file is what makes it observable.
#
# Output is the stored JSON line VERBATIM, one per line — no "[HH:MM:SS.mmm] "
# prefix like the oracle's. Each line already carries its own `ts`, and a prefix
# would break `stiva events | jq`, which is the main reason to have the verb.
# Anything that is not an event (hints, warnings) goes to stderr.

# How much of the log to hold in memory. Larger than the 8 MiB default rotation
# size so a default-configured log is always read whole; a log configured larger
# than this is read from its TAIL, since the newest events are the ones an
# operator is asking about.
var _CLI_EVENTS_BUF = 16777216;

# Index just past the last '\n' in buf[0,len), or 0 when there is none — i.e.
# how many bytes of the buffer are complete lines. A trailing partial line is
# deliberately left unconsumed: while following, the writer is mid-append and
# the rest arrives next poll.
#[must_use]
fn _cli_last_line_end(buf, len) {
    var i = len - 1;
    while (i >= 0) {
        if (load8(buf + i) == 10) { return i + 1; }
        i = i - 1;
    }
    return 0;
}

# Print every complete line in buf[0,len) that falls inside the [since,until]
# window, stopping early once `count` events have been printed (count <= 0 =
# unlimited). `printed` is the running total from earlier chunks; the new total
# is returned.
fn _cli_events_scan(buf, len, since_ms, until_ms, printed, count) {
    var total = printed;
    var start = 0;
    var i = 0;
    while (i < len) {
        if (load8(buf + i) == 10) {
            if (i > start) {
                if (count > 0 && total >= count) { return total; }
                # Terminate the line in place rather than copying it out: the
                # buffer is ours, and a 70k-line log would otherwise be 70k
                # allocations. The newline is restored immediately.
                store8(buf + i, 0);
                if (container_event_in_range(container_event_ts(buf + start),
                since_ms, until_ms) == 1) {
                    _cli_puts(buf + start);
                    _cli_puts("\n");
                    total = total + 1;
                }
                store8(buf + i, 10);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return total;
}

# Read from `off` to EOF into `buf` (capped at _CLI_EVENTS_BUF), returning the
# byte count, or -1 when the file cannot be opened. Rotation and truncation are
# handled by the caller via the size it gets from _cli_events_size.
fn _cli_events_read_from(path, off, buf) {
    var fd = file_open(path, 0, 0);            # O_RDONLY
    if (fd < 0) { return 0 - 1; }
    xlseek(fd, off, 0);                        # SEEK_SET
    var got = 0;
    var reading = 1;
    while (reading == 1) {
        var n = sys_read(fd, buf + got, _CLI_EVENTS_BUF - got);
        if (n <= 0) { reading = 0; }
        else {
            got = got + n;
            if (got >= _CLI_EVENTS_BUF) { reading = 0; }
        }
    }
    file_close(fd);
    return got;
}

# st_ino's offset in `struct stat`. The stdlib's Stat enum exposes MODE/NLINK/
# UID/GID/SIZE but no INO slot; st_dev@0 + st_ino@8 happens to hold on all three
# layouts the enum covers — x86_64 (syscalls_x86_64_linux.cyr:285-286),
# asm-generic/aarch64 (syscalls_aarch64_linux.cyr:377-378), and Darwin stat64,
# whose 4-byte st_dev + 2-byte st_mode + 2-byte st_nlink (STAT_MODE=4,
# STAT_NLINK=6 there) also put st_ino at 8.
var _CLI_STAT_INO = 8;

# Stat the event log into the caller's buffer. Returns 1, or 0 when the file is
# not there — which is a NORMAL momentary state while following, since
# rotate_logs renames the live log and only the next append recreates it.
# The buffer is caller-owned so an unbounded follow does not allocate per poll.
fn _cli_events_stat(path, st) {
    if (sys_stat(path, st) < 0) { return 0; }
    return 1;
}

# Follow the log from byte `off`, printing new events as they land. Terminates
# on the FIRST of: `count` events printed, wall clock past `until_ms`, or the
# operator interrupting. With neither bound it runs until interrupted — which is
# the shape `docker events` has, and the reason both bounds exist.
#
# `ino0` is the inode the dump read from, so rotation can be detected by
# IDENTITY rather than by size. Size alone is not enough and fails in the
# ordinary case, not a corner: lifecycle events are near enough fixed-width that
# a rotated log routinely grows back to exactly the offset the reader held, and
# a `size < pos` test then sees nothing to do and goes quiet for good.
fn _cli_events_follow(path, off, ino0, since_ms, until_ms, printed, count) {
    var total = printed;
    var pos = off;
    var ino = ino0;
    var buf = alloc(_CLI_EVENTS_BUF);
    var st = alloc(STAT_BUFSZ);
    var going = 1;
    while (going == 1) {
        if (count > 0 && total >= count) { return total; }
        if (until_ms > 0 && _cm_event_ts_ms() > until_ms) { return total; }
        sleep_ms(_CLI_FOLLOW_POLL_MS);

        if (_cli_events_stat(path, st) == 1) {
            var now_ino = load64(st + _CLI_STAT_INO);
            var size = load64(st + STAT_SIZE);
            # A different inode means rotation replaced the file; a size below
            # our offset means it was truncated in place. Either way the bytes
            # we already consumed are gone and the right move is to start over
            # at its beginning.
            if (now_ino != ino) { pos = 0; ino = now_ino; }
            elif (size < pos) { pos = 0; }
            if (size > pos) {
                var n = _cli_events_read_from(path, pos, buf);
                if (n > 0) {
                    var end = _cli_last_line_end(buf, n);
                    total = _cli_events_scan(buf, end, since_ms, until_ms, total, count);
                    pos = pos + end;
                }
            }
        }
    }
    return total;
}

# `events [--since SEC] [--until SEC] [-n COUNT] [-f]` — the lifecycle event
# stream. Without `-f` it dumps the matching events and exits, so the plain form
# always terminates.
fn _cli_events(h, root) {
    var vh = cmdit_new("stiva events");
    var f_since = cmdit_int(vh, 0, "since", 0, "Only events at or after this Unix timestamp (seconds)");
    var f_until = cmdit_int(vh, 0, "until", 0,
    "Only events at or before this Unix timestamp (seconds); with -f, stop there");
    var f_count = cmdit_int(vh, 110, "count", 0, "Stop after N events (0 = unlimited)");
    var f_follow = cmdit_bool(vh, 102, "follow", "Keep polling for new events (until -n/--until, or interrupted)");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }

    var since = cmdit_get_int(vh, f_since);
    var until = cmdit_get_int(vh, f_until);
    var count = cmdit_get_int(vh, f_count);
    if (since < 0 || until < 0 || count < 0) {
        _cli_eputs("stiva events: --since/--until/--count must not be negative\n");
        return CMDIT_EXIT_USAGE;
    }
    # An inverted window selects nothing. Printing zero events for it would look
    # exactly like "the runtime did nothing", so name the mistake instead.
    if (since > 0 && until > 0 && since > until) {
        _cli_eputs("stiva events: --since is after --until; the window is empty\n");
        return CMDIT_EXIT_USAGE;
    }
    # The flags are Unix SECONDS (what `date +%s` gives); the log stores millis.
    var since_ms = since * 1000;
    var until_ms = until * 1000;
    if (until > 0) { until_ms = until_ms + 999; }   # --until T includes all of second T

    var path = container_events_path(root);
    var buf = alloc(_CLI_EVENTS_BUF);
    var st = alloc(STAT_BUFSZ);
    var printed = 0;
    var pos = 0;
    var ino = 0;
    if (_cli_events_stat(path, st) == 0) {
        # No log at all — a fresh root, or persistence turned off. Say so on
        # stderr; stdout stays a clean (empty) event stream either way.
        _cli_eputs("stiva events: no lifecycle events recorded yet under ");
        _cli_eputs(root); _cli_eputs("\n");
        if (cmdit_get_bool(vh, f_follow) == 0) { return CMDIT_EXIT_OK; }
    } else {
        var size = load64(st + STAT_SIZE);
        ino = load64(st + _CLI_STAT_INO);
        # Read the tail when the log is bigger than the buffer, and drop the
        # partial first line that window starts in.
        var start_off = 0;
        if (size > _CLI_EVENTS_BUF) {
            start_off = size - _CLI_EVENTS_BUF;
            _cli_eputs("stiva events: log exceeds the read buffer; showing the most recent 16 MiB\n");
        }
        var n = _cli_events_read_from(path, start_off, buf);
        if (n < 0) { n = 0; }
        var from = 0;
        if (start_off > 0) {
            while (from < n && load8(buf + from) != 10) { from = from + 1; }
            if (from < n) { from = from + 1; }
        }
        var end = _cli_last_line_end(buf, n);
        printed = _cli_events_scan(buf + from, end - from, since_ms, until_ms, 0, count);
        pos = start_off + end;
        # A log whose last record has no terminator was torn mid-append. Do not
        # print it (a half-JSON line would poison a `jq` pipeline), but do not
        # hide it either.
        if (end < n) {
            _cli_eputs("stiva events: the log ends in an incomplete record; it was skipped\n");
        }
    }

    if (cmdit_get_bool(vh, f_follow) == 1) {
        _cli_events_follow(path, pos, ino, since_ms, until_ms, printed, count);
    }
    return CMDIT_EXIT_OK;
}

# `wait <container>` — print + exit with the container's exit code (rust-old:
# Commands::Wait). Our foreground containers have already exited; return the
# recorded exit_status.
fn _cli_wait(h, root) {
    var vh = cmdit_new("stiva wait");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva wait: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var id = cmdit_positional(vh, 0);
    # Through the manager (rust-old: Stiva::wait → try_wait). Reads the
    # persisted exit code off the record (works across processes). Absent → -1.
    var mgr = container_manager_new(root, image_store_new(root));
    if (container_manager_get(mgr, id) == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return CMDIT_EXIT_RUN;
    }
    var ec = container_manager_try_wait(mgr, id);
    if (ec == 0 - 1) { ec = 0; }
    _cli_puts(_rt_int_to_cstr(ec)); _cli_puts("\n");
    return ec;
}

# `stats <container>` — cgroup v2 resource stats (rust-old: Commands::Stats).
fn _cli_stats(h, root) {
    var vh = cmdit_new("stiva stats");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva stats: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    # Through the manager (rust-old: Stiva::stats). require_pid gates on
    # Running/Paused; a stopped one-shot container has no live cgroup → 0.
    var mgr = container_manager_new(root, image_store_new(root));
    var st = container_manager_stats(mgr, cmdit_positional(vh, 0));
    if (st == 0) {
        stiva_err_print(STIVA_ERR_RUNTIME, "no stats (not running, or cgroup unavailable)");
        return CMDIT_EXIT_RUN;
    }
    # ContainerStats fields via raw offsets (memory_limit_bytes collides by NAME
    # with RuntimeSpec's field — cycc field-offset collision; read by offset).
    _cli_puts("Memory:       "); _cli_puts(_rt_int_to_cstr(load64(st + 0))); _cli_puts(" bytes\n");
    _cli_puts("Memory limit: "); _cli_puts(_rt_int_to_cstr(load64(st + 8))); _cli_puts(" bytes (0 = unlimited)\n");
    _cli_puts("CPU usage:    "); _cli_puts(_rt_int_to_cstr(load64(st + 16))); _cli_puts(" us\n");
    _cli_puts("PIDs:         ");
    _cli_puts(_rt_int_to_cstr(load64(st + 24)));
    _cli_puts(" / ");
    _cli_puts(_rt_int_to_cstr(load64(st + 32)));
    _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `pause <container>` / `unpause` — cgroup freezer (rust-old: Commands::Pause/Unpause).
fn _cli_pause(h, root) {
    var vh = cmdit_new("stiva pause");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva pause: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var id = cmdit_positional(vh, 0);
    var mgr = container_manager_new(root, image_store_new(root));
    if (container_manager_pause(mgr, id) != STIVA_ERR_OK) { return CMDIT_EXIT_RUN; }
    _cli_puts(id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

fn _cli_unpause(h, root) {
    var vh = cmdit_new("stiva unpause");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) { _cli_puts("stiva unpause: missing <container>\n"); return CMDIT_EXIT_USAGE; }
    var id = cmdit_positional(vh, 0);
    var mgr = container_manager_new(root, image_store_new(root));
    if (container_manager_unpause(mgr, id) != STIVA_ERR_OK) { return CMDIT_EXIT_RUN; }
    _cli_puts(id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `export <container> <output>` — tar a container's rootfs (rust-old:
# Commands::Export → export_rootfs). The rootfs is {root}/containers/<id>/rootfs
# (created by `run`).
fn _cli_export(h, root) {
    var vh = cmdit_new("stiva export");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 2) {
        _cli_puts("stiva export: usage: export <container> <output.tar>\n");
        return CMDIT_EXIT_USAGE;
    }
    var id = cmdit_positional(vh, 0);
    var output = cmdit_positional(vh, 1);
    # Through the manager (rust-old: Stiva::get_rootfs + export). Resolves the
    # rootfs (overlay merged, or the reconstructed dir) for the id-or-name.
    var mgr = container_manager_new(root, image_store_new(root));
    var rootfs = container_manager_get_rootfs(mgr, id);
    if (rootfs == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id); return CMDIT_EXIT_RUN; }
    if (export_rootfs(rootfs, output) == 0) { return CMDIT_EXIT_RUN; }
    _cli_puts(output); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `save <image> <output.tar>` — write an image as an oci-archive tarball
# (skopeo/podman-compatible, no registry). rc: 1 ok · 0 not found · -1 write fail.
fn _cli_save(h, root) {
    var vh = cmdit_new("stiva save");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 2) {
        _cli_puts("stiva save: usage: save <image> <output.tar>\n");
        return CMDIT_EXIT_USAGE;
    }
    var image = cmdit_positional(vh, 0);
    var output = cmdit_positional(vh, 1);
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var rc = image_store_save_archive(store, image, output);
    if (rc == 0) { stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, image); return CMDIT_EXIT_RUN; }
    if (rc == 0 - 1) { stiva_err_print(STIVA_ERR_STORAGE, "failed to write oci-archive"); return CMDIT_EXIT_RUN; }
    _cli_puts(output); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# ── Tier-1 verbs: CLI wiring over already-ported logic ──
#
# These use cmdit's own validators (cmdit_require_positionals / _exact,
# cmdit_range, cmdit_enum) rather than hand-rolled positional-count checks, so
# the usage text and the error taxonomy come from one place. The older handlers
# above predate that and still hand-roll; new ones should follow this shape.

# `kill <container> [-s SIGNAL]` — send a signal (rust-old: Commands::Kill,
# main.rs:135-142; signal is a NUMBER defaulting to 15/SIGTERM).
fn _cli_kill(h, root) {
    var vh = cmdit_new("stiva kill");
    var f_sig = cmdit_int(vh, 115, "signal", 15, "Signal number to send (default 15 = SIGTERM)");
    # 1..64 covers the real-time signals; 0 is the "does it exist" probe, which
    # kill(2) accepts but which would be a confusing thing to expose here.
    cmdit_range(vh, f_sig, 1, 64);
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_require_positionals(vh, 1) == CMDIT_RESULT_ERR) {
        cmdit_print_error(vh);
        _cli_puts("usage: kill <container> [-s SIGNAL]\n");
        return CMDIT_EXIT_USAGE;
    }
    var id = cmdit_positional(vh, 0);
    var mgr = container_manager_new(root, image_store_new(root));
    # require_pid already prints for a MISSING container, so only the
    # wrong-state case needs a message here — printing unconditionally added a
    # second, false line ("not running") after a correct "not found".
    if (container_manager_get(mgr, id) == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return CMDIT_EXIT_RUN;
    }
    if (container_manager_signal(mgr, id, cmdit_get_int(vh, f_sig)) != STIVA_ERR_OK) {
        stiva_err_print(STIVA_ERR_RUNTIME, "cannot signal: container is not running");
        return CMDIT_EXIT_RUN;
    }
    _cli_puts(id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `restart <container>` — stop then start (rust-old: Stiva::restart).
fn _cli_restart(h, root) {
    var vh = cmdit_new("stiva restart");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_require_positionals(vh, 1) == CMDIT_RESULT_ERR) {
        cmdit_print_error(vh);
        _cli_puts("usage: restart <container>\n");
        return CMDIT_EXIT_USAGE;
    }
    var id = cmdit_positional(vh, 0);
    var mgr = container_manager_new(root, image_store_new(root));
    if (container_manager_restart(mgr, id) != STIVA_ERR_OK) { return CMDIT_EXIT_RUN; }
    _cli_puts(id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `rename <container> <new-name>` (rust-old: Stiva::rename).
fn _cli_rename(h, root) {
    var vh = cmdit_new("stiva rename");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_require_positionals(vh, 2) == CMDIT_RESULT_ERR) {
        cmdit_print_error(vh);
        _cli_puts("usage: rename <container> <new-name>\n");
        return CMDIT_EXIT_USAGE;
    }
    var mgr = container_manager_new(root, image_store_new(root));
    var newname = cmdit_positional(vh, 1);
    if (container_manager_rename(mgr, cmdit_positional(vh, 0), newname) != STIVA_ERR_OK) {
        return CMDIT_EXIT_RUN;
    }
    _cli_puts(newname); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `top <container>` — processes inside a running container (rust-old:
# container_top; the /proc walk is ported).
fn _cli_top(h, root) {
    var vh = cmdit_new("stiva top");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_require_positionals(vh, 1) == CMDIT_RESULT_ERR) {
        cmdit_print_error(vh);
        _cli_puts("usage: top <container>\n");
        return CMDIT_EXIT_USAGE;
    }
    var mgr = container_manager_new(root, image_store_new(root));
    # The allowed list must be a REAL vec. _container_state_allowed loops
    # `i < n` and returns 0 when n is 0, so passing (0, 0) means "no state is
    # allowed" — the inverse of the intent — and `top` failed for every
    # container in every state. Every other caller passes a populated vec.
    var allowed = vec_new();
    vec_push(allowed, CONTAINER_STATE_RUNNING);
    vec_push(allowed, CONTAINER_STATE_PAUSED);
    var pid = container_manager_require_pid(mgr, cmdit_positional(vh, 0), allowed, 2);
    if (pid <= 0) {
        stiva_err_print(STIVA_ERR_RUNTIME, "container is not running");
        return CMDIT_EXIT_RUN;
    }
    var procs = container_top(pid);
    _cli_puts("PID\tPPID\tSTATE\tCOMMAND\n");
    if (procs == 0) { return CMDIT_EXIT_OK; }
    var n = vec_len(procs);
    var i = 0;
    while (i < n) {
        var pi: ProcessInfo = vec_get(procs, i);
        _cli_puts(_rt_int_to_cstr(pi.pid)); _cli_puts("\t");
        _cli_puts(_rt_int_to_cstr(pi.ppid)); _cli_puts("\t");
        var sb[2];
        store8(&sb, pi.state);
        store8(&sb + 1, 0);
        _cli_puts(&sb); _cli_puts("\t");
        var cmd = pi.cmdline;
        if (cmd == 0) { cmd = pi.comm; }
        if (cmd == 0) { cmd = ""; }
        _cli_puts(cmd); _cli_puts("\n");
        i = i + 1;
    }
    return CMDIT_EXIT_OK;
}

# `cp <src> <dst>` — copy host↔container. Exactly one side carries a
# `<container>:<path>` prefix (rust-old: copy_into_container /
# copy_from_container; both are ported).
fn _cli_cp(h, root) {
    var vh = cmdit_new("stiva cp");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_require_positionals(vh, 2) == CMDIT_RESULT_ERR) {
        cmdit_print_error(vh);
        _cli_puts("usage: cp <src> <dst>  (one side is <container>:<path>)\n");
        return CMDIT_EXIT_USAGE;
    }
    var src = cmdit_positional(vh, 0);
    var dst = cmdit_positional(vh, 1);
    var src_colon = _cli_split_colon(src);
    var dst_colon = _cli_split_colon(dst);
    # Exactly one side must be container-qualified. Both or neither is a
    # host-to-host or container-to-container copy, neither of which this verb
    # means — and guessing would silently do the wrong one.
    if (src_colon >= 0 && dst_colon >= 0) {
        _cli_puts("stiva cp: only one side may name a container\n");
        return CMDIT_EXIT_USAGE;
    }
    if (src_colon < 0 && dst_colon < 0) {
        _cli_puts("stiva cp: one side must be <container>:<path>\n");
        return CMDIT_EXIT_USAGE;
    }
    # An empty container-side path ("c1:") would join to the rootfs root and
    # splat a directory's contents over it.
    if (src_colon >= 0 && load8(src + src_colon + 1) == 0) {
        _cli_puts("stiva cp: empty path after ':'\n");
        return CMDIT_EXIT_USAGE;
    }
    if (dst_colon >= 0 && load8(dst + dst_colon + 1) == 0) {
        _cli_puts("stiva cp: empty path after ':'\n");
        return CMDIT_EXIT_USAGE;
    }
    # The container-side path is joined onto the rootfs, so `..` would walk out
    # of it. copy_into_container / copy_from_container do not check (oracle
    # parity — rust-old/src/runtime.rs:914, :946), so the gate is here.
    if (src_colon >= 0 && _cli_path_escapes(src + src_colon + 1) == 1) {
        _cli_puts("stiva cp: container path escapes the container root\n");
        return CMDIT_EXIT_USAGE;
    }
    if (dst_colon >= 0 && _cli_path_escapes(dst + dst_colon + 1) == 1) {
        _cli_puts("stiva cp: container path escapes the container root\n");
        return CMDIT_EXIT_USAGE;
    }
    var mgr = container_manager_new(root, image_store_new(root));
    var rc = 0 - 1;
    if (dst_colon >= 0) {
        var cid = _cli_slice(dst, 0, dst_colon);
        var rootfs = container_manager_get_rootfs(mgr, cid);
        if (rootfs == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, cid); return CMDIT_EXIT_RUN; }
        rc = copy_into_container(rootfs, src, dst + dst_colon + 1);
    } else {
        var cid2 = _cli_slice(src, 0, src_colon);
        var rootfs2 = container_manager_get_rootfs(mgr, cid2);
        if (rootfs2 == 0) { stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, cid2); return CMDIT_EXIT_RUN; }
        rc = copy_from_container(rootfs2, src + src_colon + 1, dst);
    }
    if (rc < 0) { return CMDIT_EXIT_RUN; }
    _cli_puts(dst); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# Index of the container/path separator in `s`, or -1 when `s` is a plain host
# path.
#
# ':' is a LEGAL byte in a Linux filename, so a token that is unambiguously a
# host path — it starts with '/', './' or '../' — is never split, however many
# colons it contains. Docker's splitCpArg makes the same exemption, and for the
# same reason: `cp /work/a:b/f.txt out.txt` must copy a file, not look for a
# container called "/work/a". (The old comment claimed a container name cannot
# contain ':'; nothing validates that either, so it was not a safe premise.)
#[must_use]
fn _cli_split_colon(s) {
    if (load8(s) == 47) { return 0 - 1; }                       # "/..."
    if (load8(s) == 46) {
        if (load8(s + 1) == 47) { return 0 - 1; }               # "./..."
        if (load8(s + 1) == 46 && load8(s + 2) == 47) { return 0 - 1; }   # "../..."
    }
    var i = 0;
    while (load8(s + i) != 0) {
        if (load8(s + i) == 58) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# 1 when a container-side path contains a `..` component, i.e. would resolve
# outside the rootfs it is joined onto. Purely lexical — a symlink INSIDE the
# image can still redirect the resolved path, which is a separate (and shared
# with the oracle) exposure tracked in the roadmap.
#[must_use]
fn _cli_path_escapes(p) {
    var i = 0;
    var at_start = 1;
    while (load8(p + i) != 0) {
        if (at_start == 1) {
            if (load8(p + i) == 46 && load8(p + i + 1) == 46) {
                var nxt = load8(p + i + 2);
                if (nxt == 0 || nxt == 47) { return 1; }
            }
        }
        at_start = 0;
        if (load8(p + i) == 47) { at_start = 1; }
        i = i + 1;
    }
    return 0;
}

#[must_use]
fn _cli_slice(s, start, end) {
    var n = end - start;
    if (n < 0) { n = 0; }
    var out = alloc(n + 1);
    memcpy(out, s + start, n);
    store8(out + n, 0);
    return out;
}

# `completions <bash|zsh|fish>` — emit a shell completion script on STDOUT.
#
# Driven by cmdit's own verb table (cmdit 1.2.0's `cmdit_completions`), NOT by a
# hand-kept list: the script is a projection of the very registration
# `_cli_register_verbs` performs, so adding a verb updates the completions with
# no second edit and nothing to drift.
#
# `h` is the top-level handle — the one carrying the verbs and global flags —
# so unlike every other handler this one does not open a per-verb scope.
fn _cli_completions(h) {
    var vh = cmdit_new("stiva completions");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_require_positionals(vh, 1) == CMDIT_RESULT_ERR) {
        cmdit_print_error(vh);
        _cli_eputs("usage: completions <bash|zsh|fish>\n");
        return CMDIT_EXIT_USAGE;
    }
    var shell = cmdit_positional(vh, 0);
    # cmdit_completions writes nothing on an unrecognised shell, so stdout stays
    # empty and only stderr carries the complaint.
    if (cmdit_completions(h, shell) < 0) {
        _cli_eputs("stiva completions: unsupported shell: ");
        _cli_eputs(shell);
        _cli_eputs("\n  supported: bash, zsh, fish\n");
        return CMDIT_EXIT_USAGE;
    }
    return CMDIT_EXIT_OK;
}

# A Stiva facade over `root` — the CLI's route to the registry client.
#
# NOTE: no audit log. stiva_config_default leaves audit_log at 0 and there is no
# global flag to set it, so the facade's audit emissions are inert from the CLI.
# Wiring `--audit-log` is its own change.
fn _cli_stiva(root) {
    var cfg = stiva_config_default();
    var cc: StivaConfig = cfg;
    cc.root_path = root;
    cc.image_path = root;
    return stiva_new(cfg);
}

# `stiva build [-f Stivafile] [-c .]` — §F. The two flags have been documented
# at docs/cli.md:85-89 since before the verb existed; this is where they finally
# get registered.
fn _cli_build(h, root) {
    var vh = cmdit_new("stiva build");
    var f_file = cmdit_str(vh, 102, "file", "Stivafile", "Path to the build spec");
    var f_ctx = cmdit_str(vh, 99, "context", ".", "Build context directory");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }

    var spec_path = cmdit_get_str(vh, f_file);
    var ctx = cmdit_get_str(vh, f_ctx);

    # Same three guards as `convert`, and for the same reasons: a directory
    # read()s 0 bytes and would "parse" as an empty spec, and a silently
    # truncated Stivafile produces a plausible-but-wrong image.
    if (is_dir(str_new(spec_path, strlen(spec_path))) == 1) {
        stiva_err_print(STIVA_ERR_IO, _rt_cat2("not a regular file: ", spec_path));
        return CMDIT_EXIT_RUN;
    }
    var buf = alloc(1048578);
    var n = file_read_all(spec_path, buf, 1048577);
    if (n < 0) { stiva_err_print(STIVA_ERR_IO, spec_path); return CMDIT_EXIT_RUN; }
    if (n > 1048576) {
        stiva_err_print(STIVA_ERR_INVALID_STATE,
        _rt_cat2("build spec exceeds the 1 MiB limit: ", spec_path));
        return CMDIT_EXIT_RUN;
    }
    store8(buf + n, 0);

    var s = _cli_stiva(root);
    if (s == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var im = stiva_build(s, buf, ctx);
    if (im == 0) { return CMDIT_EXIT_RUN; }   # detail already printed
    var ii: Image = im;
    _cli_puts(ii.id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

fn _cli_pull(h, root) {
    var vh = cmdit_new("stiva pull");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva pull: usage: pull <image>\n");
        return CMDIT_EXIT_USAGE;
    }
    var reference = cmdit_positional(vh, 0);
    var s = _cli_stiva(root);
    if (s == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var im = stiva_pull(s, reference);
    if (im == 0) { return CMDIT_EXIT_RUN; }   # detail already printed
    var ii: Image = im;
    _cli_puts(ii.id); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

fn _cli_push(h, root) {
    var vh = cmdit_new("stiva push");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva push: usage: push <image> [target]\n");
        return CMDIT_EXIT_USAGE;
    }
    var image = cmdit_positional(vh, 0);
    # Optional second positional: push under a different reference.
    var target = 0;
    if (cmdit_positional_count(vh) >= 2) { target = cmdit_positional(vh, 1); }
    var s = _cli_stiva(root);
    if (s == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    if (stiva_push(s, image, target) != 1) { return CMDIT_EXIT_RUN; }
    var shown = target;
    if (shown == 0) { shown = image; }
    _cli_puts(shown); _cli_puts("\n");
    return CMDIT_EXIT_OK;
}

# `load <input.tar>` — import images from an oci-archive tarball into the store.
fn _cli_load(h, root) {
    var vh = cmdit_new("stiva load");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    if (cmdit_positional_count(vh) < 1) {
        _cli_puts("stiva load: usage: load <input.tar>\n");
        return CMDIT_EXIT_USAGE;
    }
    var input = cmdit_positional(vh, 0);
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var rc = image_store_load_archive(store, input);
    if (rc < 0) { return CMDIT_EXIT_RUN; }   # detail already printed
    _cli_puts("Loaded "); _cli_puts(_rt_int_to_cstr(rc)); _cli_puts(" image(s)\n");
    return CMDIT_EXIT_OK;
}

# `gc` — remove unreferenced blobs (rust-old: Commands::Gc → ImageStore gc).
fn _cli_gc(h, root) {
    var vh = cmdit_new("stiva gc");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }
    var removed = image_store_gc(store);
    _cli_puts("Removed "); _cli_puts(_rt_int_to_cstr(removed)); _cli_puts(" unreferenced blobs\n");
    return CMDIT_EXIT_OK;
}

# `prune` — remove stopped containers + images no remaining container uses
# (rust-old: Commands::Prune → lib.rs prune).
fn _cli_prune(h, root) {
    var vh = cmdit_new("stiva prune");
    var vr = cmdit_parse_verb(vh, h);
    if (vr == CMDIT_HELP) { cmdit_help(vh); return CMDIT_EXIT_OK; }
    if (vr == CMDIT_VERSION) { return cmdit_version(vh, _stiva_version_str()); }
    if (vr == CMDIT_RESULT_ERR) { cmdit_print_error(vh); return CMDIT_EXIT_USAGE; }
    var store = image_store_new(root);
    if (store == 0) { stiva_err_print(STIVA_ERR_IO, root); return CMDIT_EXIT_RUN; }

    # 1. drop Stopped containers.
    var cs = container_state_load(root);
    var kept = vec_new();
    var removed_c = 0;
    var n = vec_len(cs);
    var i = 0;
    while (i < n) {
        var cc: Container = vec_get(cs, i);
        if (cc.state == CONTAINER_STATE_STOPPED) {
            removed_c = removed_c + 1;
        } else {
            vec_push(kept, vec_get(cs, i));
        }
        i = i + 1;
    }
    container_state_save(root, kept);

    # 2. drop images no remaining container references (by image_id).
    var images = image_store_load_index(store);
    var removed_i = 0;
    var m = vec_len(images);
    var j = 0;
    while (j < m) {
        var im: Image = vec_get(images, j);
        var refd = 0;
        var k = 0;
        while (k < vec_len(kept)) {
            var kc: Container = vec_get(kept, k);
            if (streq(kc.image_id, im.id) == 1) { refd = 1; }
            k = k + 1;
        }
        if (refd == 0) {
            image_store_remove(store, im.id);
            removed_i = removed_i + 1;
        }
        j = j + 1;
    }

    _cli_puts("Removed "); _cli_puts(_rt_int_to_cstr(removed_c)); _cli_puts(" containers, ");
    _cli_puts(_rt_int_to_cstr(removed_i)); _cli_puts(" images\n");
    return CMDIT_EXIT_OK;
}

fn main() {
    alloc_init();
    kavach_init();               # register sandbox backends (idempotent; needed by the run path)
    sakshi_set_level(SK_INFO);   # structured audit trail to stderr (SK_INFO default)
    var h = cmdit_new("stiva");
    # Global flags — bind before OR after the verb (rust-old: root_path/image_path).
    var f_root = cmdit_str(h, 0, "root", 0, "Root directory for container data");
    cmdit_str(h, 0, "image-path", 0, "Image storage directory");
    _cli_register_verbs(h);

    var r = cmdit_dispatch(h);
    if (r == CMDIT_HELP) { cmdit_help(h); return CMDIT_EXIT_OK; }
    if (r == CMDIT_VERSION) { return cmdit_version(h, _stiva_version_str()); }
    if (r == CMDIT_RESULT_ERR) { cmdit_print_error(h); return CMDIT_EXIT_USAGE; }
    if (cmdit_verb_matched(h) == 0 - 1) { cmdit_help(h); return CMDIT_EXIT_USAGE; }

    var v = cmdit_verb_matched(h);
    if (v == V_CONVERT) { return _cli_convert(h); }
    if (v == V_RUN) { return _cli_run(h, _cli_root(h, f_root)); }
    if (v == V_IMAGES) { return _cli_images(_cli_root(h, f_root)); }
    if (v == V_RMI) { return _cli_rmi(h, _cli_root(h, f_root)); }
    if (v == V_PS) { return _cli_ps(h, _cli_root(h, f_root)); }
    if (v == V_STOP) { return _cli_stop(h, _cli_root(h, f_root)); }
    if (v == V_RM) { return _cli_rm(h, _cli_root(h, f_root)); }
    if (v == V_INSPECT) { return _cli_inspect(h, _cli_root(h, f_root)); }
    if (v == V_TAG) { return _cli_tag(h, _cli_root(h, f_root)); }
    if (v == V_IMPORT) { return _cli_import(h, _cli_root(h, f_root)); }
    if (v == V_LOGS) { return _cli_logs(h, _cli_root(h, f_root)); }
    if (v == V_EVENTS) { return _cli_events(h, _cli_root(h, f_root)); }
    if (v == V_WAIT) { return _cli_wait(h, _cli_root(h, f_root)); }
    if (v == V_STATS) { return _cli_stats(h, _cli_root(h, f_root)); }
    if (v == V_PAUSE) { return _cli_pause(h, _cli_root(h, f_root)); }
    if (v == V_UNPAUSE) { return _cli_unpause(h, _cli_root(h, f_root)); }
    if (v == V_EXPORT) { return _cli_export(h, _cli_root(h, f_root)); }
    if (v == V_GC) { return _cli_gc(h, _cli_root(h, f_root)); }
    if (v == V_PRUNE) { return _cli_prune(h, _cli_root(h, f_root)); }
    if (v == V_INFO) { return _cli_info(); }
    if (v == V_SAVE) { return _cli_save(h, _cli_root(h, f_root)); }
    if (v == V_LOAD) { return _cli_load(h, _cli_root(h, f_root)); }
    if (v == V_PULL) { return _cli_pull(h, _cli_root(h, f_root)); }
    if (v == V_PUSH) { return _cli_push(h, _cli_root(h, f_root)); }
    if (v == V_KILL) { return _cli_kill(h, _cli_root(h, f_root)); }
    if (v == V_RESTART) { return _cli_restart(h, _cli_root(h, f_root)); }
    if (v == V_RENAME) { return _cli_rename(h, _cli_root(h, f_root)); }
    if (v == V_TOP) { return _cli_top(h, _cli_root(h, f_root)); }
    if (v == V_CP) { return _cli_cp(h, _cli_root(h, f_root)); }
    if (v == V_COMPLETIONS) { return _cli_completions(h); }
    if (v == V_BUILD) { return _cli_build(h, _cli_root(h, f_root)); }
    # Every other verb is the not-yet-wired surface (mostly v3.0.x, small v3.1 residue).
    return _cli_deferred(_cli_verb_name(v));
}

# Verb id → display name (for the deferred message; registration order).
#[must_use]
fn _cli_verb_name(v) {
    if (v == V_PULL) { return "pull"; }
    if (v == V_BUILD) { return "build"; }
    if (v == V_PUSH) { return "push"; }
    if (v == V_RUN) { return "run"; }
    if (v == V_PS) { return "ps"; }
    if (v == V_STOP) { return "stop"; }
    if (v == V_RM) { return "rm"; }
    if (v == V_EXEC) { return "exec"; }
    if (v == V_TOP) { return "top"; }
    if (v == V_INSPECT) { return "inspect"; }
    if (v == V_IMAGES) { return "images"; }
    if (v == V_RMI) { return "rmi"; }
    if (v == V_TAG) { return "tag"; }
    if (v == V_PAUSE) { return "pause"; }
    if (v == V_UNPAUSE) { return "unpause"; }
    if (v == V_STATS) { return "stats"; }
    if (v == V_LOGS) { return "logs"; }
    if (v == V_KILL) { return "kill"; }
    if (v == V_EXPORT) { return "export"; }
    if (v == V_IMPORT) { return "import"; }
    if (v == V_CP) { return "cp"; }
    if (v == V_PRUNE) { return "prune"; }
    if (v == V_WAIT) { return "wait"; }
    if (v == V_CHECKPOINT) { return "checkpoint"; }
    if (v == V_RESTORE) { return "restore"; }
    if (v == V_RESTART) { return "restart"; }
    if (v == V_INFO) { return "info"; }
    if (v == V_EVENTS) { return "events"; }
    if (v == V_DIFF) { return "diff"; }
    if (v == V_COMPLETIONS) { return "completions"; }
    if (v == V_RENAME) { return "rename"; }
    if (v == V_GC) { return "gc"; }
    if (v == V_SAVE) { return "save"; }
    if (v == V_LOAD) { return "load"; }
    return "unknown";
}

var _rc = main();
syscall(SYS_EXIT, _rc);
