# Minimal-universe probe v2: my_load_index now mirrors image_store_load_index's
# SHAPE (OciManifest/Descriptor struct-typed locals, a layer loop, image_new),
# to test whether the complex-callee register pressure is what triggers the
# miscompile rather than the surrounding module universe.

struct Descriptor  { media_type; digest; size; }
struct OciManifest { schema_version; media_type; config; layers; annotations; }
struct Layer       { digest; size_bytes; media_type; }
struct Image       { id; reference; size_bytes; layers; created_at; manifest_digest; }

fn layer_new(digest, size_bytes, media_type) {
    var l = alloc(24);
    var ll: Layer = l;
    ll.digest = digest;
    ll.size_bytes = size_bytes;
    ll.media_type = media_type;
    return l;
}

fn image_new(id, reference, size_bytes, layers, created_at) {
    var im = alloc(48);
    var ii: Image = im;
    ii.id = id;
    ii.reference = reference;
    ii.size_bytes = size_bytes;
    ii.layers = layers;
    ii.created_at = created_at;
    store64(im + 40, 0);
    return im;
}

fn mk_manifest() {
    var cfg = alloc(24);
    var cd: Descriptor = cfg;
    cd.media_type = 0;
    cd.digest = 111;          # -> becomes Image.id
    cd.size = 7;
    var mlayers = vec_new();
    var d0 = alloc(24);
    var dd: Descriptor = d0;
    dd.media_type = 900;
    dd.digest = 999;
    dd.size = 42;
    vec_push(mlayers, d0);
    var m = alloc(40);
    var mm: OciManifest = m;
    mm.schema_version = 2;
    mm.media_type = 0;
    mm.config = cfg;
    mm.layers = mlayers;
    mm.annotations = 0;
    return m;
}

# Mirrors image_store_load_index: parse a "manifest", build layers, image_new.
fn my_load_index(store) {
    var out = vec_new();
    var man = mk_manifest();
    if (man != 0) {
        var mm: OciManifest = man;
        var cfg: Descriptor = mm.config;
        var layers = vec_new();
        var total = 0;
        var mlayers = mm.layers;
        var ln = vec_len(mlayers);
        var lj = 0;
        while (lj < ln) {
            var ld: Descriptor = vec_get(mlayers, lj);
            vec_push(layers, layer_new(ld.digest, ld.size, ld.media_type));
            total = total + ld.size;
            lj = lj + 1;
        }
        var img = image_new(cfg.digest, 0, total, layers, 0);
        store64(img + 40, 222);      # manifest_digest sentinel
        store64(img + 24, 333);      # overwrite layers ptr with sentinel 333
        vec_push(out, img);
    }
    return out;
}

fn repro(store, out) {
    var images = my_load_index(store);
    var found = vec_get(images, 0);
    if (found == 0) { return 0; }
    var fi: Image = found;
    store64(out + 0, fi.manifest_digest);
    store64(out + 8, fi.id);
    store64(out + 16, fi.layers);
    return 1;
}

fn main() {
    var out = alloc(24);
    store64(out + 0, 0); store64(out + 8, 0); store64(out + 16, 0);
    repro(0, out);
    var bad = 0;
    if (load64(out + 0) != 222) { bad = bad + 2; }
    if (load64(out + 8) != 111) { bad = bad + 1; }
    if (load64(out + 16) != 333) { bad = bad + 4; }
    if (bad == 0) { sakshi_info("MATCH", strlen("MATCH")); }
    if (bad != 0) { sakshi_info("MISMATCH", strlen("MISMATCH")); }
    return bad;
}

var exit_code = main();
syscall(60, exit_code);
