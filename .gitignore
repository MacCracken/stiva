# Build artifacts
/target/
/build/

# Resolved deps — `cyrius deps` / `cyrius lib sync` populate lib/ from
# cyrius.cyml [deps].stdlib + the [deps.*] git bundles. lib/ is reproducible
# from the manifest + lockfile and is NOT committed.
/lib/

# Cyrius toolchain artifacts pulled into the workspace by the installer flow
# (release tarball + source archive). CI extracts these under $HOME/.cyrius,
# but ad-hoc local installs sometimes land them at the repo root.
cyrius-*.tar.gz
cyrius-[0-9]*/

# Frozen Rust source (the parity oracle) — keep the tree, ignore its build.
/rust-old/target/

# Editor / IDE
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# OS files
.DS_Store
Thumbs.db

# Debugging
*.pdb
core
core.*

# Coverage
lcov.info
coverage/

# Environment / secrets
.env
.env.*
*.pem
*.key
credentials.json
secrets.json

# Claude Code
.claude/

# Logs
*.log
