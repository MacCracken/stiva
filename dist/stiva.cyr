# Only `parse_intent` (the natural-language → Intent parser) remains — it is
# gated on the agnoshi project; see docs/development/roadmap.md v3.1.0 item 6:
# it needs the agnoshi project, which does not exist yet, so the sentinel above
# is the live behaviour. The field-carrying Intent value type and its serde
# round-trip (the "variant payloads" item) are now ported above.

# --- audit.cyr ---

# stiva — structured audit log (append-only JSON-lines runtime-op log)
# Ported from rust-old/src/audit.rs.
#
# Each entry records a timestamp, operation type, target (container/image),
# result, and optional metadata for compliance and forensics. Entries are
# serialized one-per-line as JSON and appended under a file lock (the Rust
# used a Mutex<File>; here the append is serialized by an flock, which is
# the cross-process-safe analogue).
#
# Enum members are namespaced (AUDIT_OP_*, AUDIT_RESULT_*) — Cyrius hoists
# enum members to global constants under "last definition wins", so bare
# names would silently collide across modules (see error.cyr).
#
# Parity notes vs Rust:
#   - AuditResult::Failed(String) — the failure message is carried on the
#     entry as `result_msg` (0 / "" when result == AUDIT_RESULT_SUCCESS).
#   - metadata: serde_json::Value — carried as a pre-serialized JSON cstr
#     (0 / "" == null; skipped from output when null, matching
#     `skip_serializing_if = "Value::is_null"`).
#   - timestamp: chrono::DateTime<Utc> — rendered ISO-8601 "…Z" via
#     chrono.cyr's iso8601 (second precision; Rust rfc3339 may carry
#     fractional seconds, elided here — the wire shape is otherwise equal).
#   - read_entries: reverse-of-lines, take(limit), skip unparseable lines.

# ── AuditOperation ─────────────────────────
# Runtime operation that was performed (rust-old: enum AuditOperation).
enum AuditOperation {
    AUDIT_OP_CREATE = 0;
    AUDIT_OP_START = 1;
    AUDIT_OP_STOP = 2;
    AUDIT_OP_KILL = 3;
    AUDIT_OP_REMOVE = 4;
    AUDIT_OP_EXEC = 5;
    AUDIT_OP_PULL = 6;
    AUDIT_OP_PUSH = 7;
    AUDIT_OP_CHECKPOINT = 8;
    AUDIT_OP_RESTORE = 9;
    # NET-NEW, not parity — the oracle's AuditOperation (rust-old/src/audit.rs:17)
    # stops at Restore and its `Stiva::build` (lib.rs:294) audits nothing. An
    # audit trail that records the pull of a base image and the push of the
    # result, but not the build that turned one into the other, has a gap
    # exactly where provenance matters. Appended, so every existing code and
    # wire name is unchanged.
    AUDIT_OP_BUILD = 10;
}

# Display string for an operation (rust-old: impl Display for AuditOperation).
#[must_use]
fn audit_op_name(op) {
    if (op == AUDIT_OP_CREATE) { return "create"; }
    if (op == AUDIT_OP_START) { return "start"; }
    if (op == AUDIT_OP_STOP) { return "stop"; }
    if (op == AUDIT_OP_KILL) { return "kill"; }
    if (op == AUDIT_OP_REMOVE) { return "remove"; }
    if (op == AUDIT_OP_EXEC) { return "exec"; }
    if (op == AUDIT_OP_PULL) { return "pull"; }
    if (op == AUDIT_OP_PUSH) { return "push"; }
    if (op == AUDIT_OP_CHECKPOINT) { return "checkpoint"; }
    if (op == AUDIT_OP_RESTORE) { return "restore"; }
    if (op == AUDIT_OP_BUILD) { return "build"; }
    return "unknown";
}

# Serde wire name for an operation. serde's default enum representation for
# a fieldless variant is the PascalCase variant name string. The Rust type
# derives Serialize/Deserialize with no rename, so the JSON value is
# "Create", "Start", … (NOT the Display lowercase form). Kept distinct from
# audit_op_name so both round-trip and human display stay faithful.
#[must_use]
fn audit_op_serde(op) {
    if (op == AUDIT_OP_CREATE) { return "Create"; }
    if (op == AUDIT_OP_START) { return "Start"; }
    if (op == AUDIT_OP_STOP) { return "Stop"; }
    if (op == AUDIT_OP_KILL) { return "Kill"; }
    if (op == AUDIT_OP_REMOVE) { return "Remove"; }
    if (op == AUDIT_OP_EXEC) { return "Exec"; }
    if (op == AUDIT_OP_PULL) { return "Pull"; }
    if (op == AUDIT_OP_PUSH) { return "Push"; }
    if (op == AUDIT_OP_CHECKPOINT) { return "Checkpoint"; }
    if (op == AUDIT_OP_RESTORE) { return "Restore"; }
    if (op == AUDIT_OP_BUILD) { return "Build"; }
    return "Create";
}

# Inverse of audit_op_serde: parse a serde variant name to an op code.
# Returns -1 on an unknown name (caller treats as unparseable line).
#[must_use]
fn audit_op_from_serde(s) {
    if (streq(s, "Create") == 1) { return AUDIT_OP_CREATE; }
    if (streq(s, "Start") == 1) { return AUDIT_OP_START; }
    if (streq(s, "Stop") == 1) { return AUDIT_OP_STOP; }
    if (streq(s, "Kill") == 1) { return AUDIT_OP_KILL; }
    if (streq(s, "Remove") == 1) { return AUDIT_OP_REMOVE; }
    if (streq(s, "Exec") == 1) { return AUDIT_OP_EXEC; }
    if (streq(s, "Pull") == 1) { return AUDIT_OP_PULL; }
    if (streq(s, "Push") == 1) { return AUDIT_OP_PUSH; }
    if (streq(s, "Checkpoint") == 1) { return AUDIT_OP_CHECKPOINT; }
    if (streq(s, "Restore") == 1) { return AUDIT_OP_RESTORE; }
    if (streq(s, "Build") == 1) { return AUDIT_OP_BUILD; }
    return 0 - 1;
}

# ── AuditResult ──────────────────────────
# Outcome of the audited operation (rust-old: enum AuditResult).
# Success carries no data; Failed carries a String message (on the entry).
enum AuditResult {
    AUDIT_RESULT_SUCCESS = 0;
    AUDIT_RESULT_FAILED = 1;
}

# ── AuditEntry ──────────────────────────
# A single audit log entry (rust-old: struct AuditEntry).
#   timestamp     — ISO-8601 cstr ("…Z")
#   operation     — AuditOperation code
#   container_id  — cstr, or 0 for None (skip_serializing_if is_none)
#   image_ref     — cstr, or 0 for None (skip_serializing_if is_none)
#   user          — cstr (current effective user)
#   result        — AuditResult code
#   result_msg    — failure message cstr for AUDIT_RESULT_FAILED (else 0)
#   metadata      — pre-serialized JSON cstr, or 0 for Null (skip when null)
#derive(accessors)
struct AuditEntry {
    timestamp;
    operation;
    container_id;
    image_ref;
    user;
    result;
    result_msg;
    metadata;
}

# Build an audit entry for a container operation (rust-old: AuditEntry::container).
# result is a code; result_msg is 0 for Success or the failure cstr for Failed.
#[must_use]
fn audit_entry_container(operation, container_id, result, result_msg) {
    var e = alloc(64);
    AuditEntry_set_timestamp(e, iso8601_now());
    AuditEntry_set_operation(e, operation);
    AuditEntry_set_container_id(e, container_id);
    AuditEntry_set_image_ref(e, 0);
    AuditEntry_set_user(e, current_user());
    AuditEntry_set_result(e, result);
    AuditEntry_set_result_msg(e, result_msg);
    AuditEntry_set_metadata(e, 0);
    return e;
}

# Build an audit entry for an image operation (rust-old: AuditEntry::image).
#[must_use]
fn audit_entry_image(operation, image_ref, result, result_msg) {
    var e = alloc(64);
    AuditEntry_set_timestamp(e, iso8601_now());
    AuditEntry_set_operation(e, operation);
    AuditEntry_set_container_id(e, 0);
    AuditEntry_set_image_ref(e, image_ref);
    AuditEntry_set_user(e, current_user());
    AuditEntry_set_result(e, result);
    AuditEntry_set_result_msg(e, result_msg);
    AuditEntry_set_metadata(e, 0);
    return e;
}

# Attach metadata to this entry (rust-old: AuditEntry::with_metadata).
# `metadata` is a pre-serialized JSON cstr. Mutates in place and returns
# the entry (builder-style, mirroring the Rust `mut self -> Self`).
#[must_use]
fn audit_entry_with_metadata(entry, metadata) {
    AuditEntry_set_metadata(entry, metadata);
    return entry;
}

# ── JSON escaping (RFC-8259 minimal) ───────────────────
# Upper bound: each byte can become \uXXXX (6 bytes); +1 for NUL. #skip-lint
# Emits a heap
# cstr with quotes/backslashes/control chars escaped. Used for the string
# fields (container_id, image_ref, user, result_msg) which are
# caller-controllable.
#[must_use]
fn _audit_json_escape(s) {
    var n = strlen(s);
    var out = alloc(n * 6 + 1);
    var i = 0;
    var pos = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 34) {
            store8(out + pos, 92); store8(out + pos + 1, 34); pos = pos + 2;
        } elif (c == 92) {
            store8(out + pos, 92); store8(out + pos + 1, 92); pos = pos + 2;
        } elif (c == 8) {
            store8(out + pos, 92); store8(out + pos + 1, 98); pos = pos + 2;
        } elif (c == 12) {
            store8(out + pos, 92); store8(out + pos + 1, 102); pos = pos + 2;
        } elif (c == 10) {
            store8(out + pos, 92); store8(out + pos + 1, 110); pos = pos + 2;
        } elif (c == 13) {
            store8(out + pos, 92); store8(out + pos + 1, 114); pos = pos + 2;
        } elif (c == 9) {
            store8(out + pos, 92); store8(out + pos + 1, 116); pos = pos + 2;
        } elif (c < 32) {
            var hex = "0123456789abcdef";
            store8(out + pos, 92); store8(out + pos + 1, 117);
            store8(out + pos + 2, 48); store8(out + pos + 3, 48);
            store8(out + pos + 4, load8(hex + ((c >> 4) & 15)));
            store8(out + pos + 5, load8(hex + (c & 15)));
            pos = pos + 6;
        } else {
            store8(out + pos, c); pos = pos + 1;
        }
        i = i + 1;
    }
    store8(out + pos, 0);
    return out;
}

# ── Serialization ─────────────────────────
# Serialize an entry as one JSON line (no trailing newline). Field order
# mirrors the Rust struct: timestamp, operation, container_id?, image_ref?,
# user, result, metadata?. Optional fields (container_id/image_ref/metadata)
# are omitted when absent, matching serde's skip_serializing_if.
#
# result is serialized as serde's externally-tagged enum form:
#   Success        -> "Success"
#   Failed(msg)    -> {"Failed":"<msg>"}
#[must_use]
fn audit_entry_to_json(entry) {
    var sb = str_builder_new();

    str_builder_add_cstr(sb, "{\"timestamp\":\"");
    str_builder_add_cstr(sb, _audit_json_escape(AuditEntry_timestamp(entry)));
    str_builder_add_cstr(sb, "\",\"operation\":\"");
    str_builder_add_cstr(sb, audit_op_serde(AuditEntry_operation(entry)));
    str_builder_add_cstr(sb, "\"");

    var cid = AuditEntry_container_id(entry);
    if (cid != 0) {
        str_builder_add_cstr(sb, ",\"container_id\":\"");
        str_builder_add_cstr(sb, _audit_json_escape(cid));
        str_builder_add_cstr(sb, "\"");
    }

    var iref = AuditEntry_image_ref(entry);
    if (iref != 0) {
        str_builder_add_cstr(sb, ",\"image_ref\":\"");
        str_builder_add_cstr(sb, _audit_json_escape(iref));
        str_builder_add_cstr(sb, "\"");
    }

    str_builder_add_cstr(sb, ",\"user\":\"");
    str_builder_add_cstr(sb, _audit_json_escape(AuditEntry_user(entry)));
    str_builder_add_cstr(sb, "\",\"result\":");
    if (AuditEntry_result(entry) == AUDIT_RESULT_SUCCESS) {
        str_builder_add_cstr(sb, "\"Success\"");
    } else {
        var msg = AuditEntry_result_msg(entry);
        if (msg == 0) { msg = ""; }
        str_builder_add_cstr(sb, "{\"Failed\":\"");
        str_builder_add_cstr(sb, _audit_json_escape(msg));
        str_builder_add_cstr(sb, "\"}");
    }

    var meta = AuditEntry_metadata(entry);
    if (meta != 0) {
        if (strlen(meta) > 0) {
            str_builder_add_cstr(sb, ",\"metadata\":");
            str_builder_add_cstr(sb, meta);
        }
    }

    str_builder_add_cstr(sb, "}");
    var s = str_builder_build(sb);
    return str_data(s);
}

# ── AuditLog ───────────────────────────
# Append-only audit logger backed by a file (rust-old: struct AuditLog).
#derive(accessors)
struct AuditLog {
    path;
}

# Open or create an append-only audit log at `path` (rust-old: AuditLog::new).
# Best-effort creates the parent directory (mirroring create_dir_all(parent)).
# The Rust also opened the file eagerly with create+append; here the file is
# created lazily on the first `log` via file_append_locked (O_CREAT). Returns
# the AuditLog handle, or 0 on allocation failure (documented sentinel).
fn stiva_audit_log_new(path) {
    _audit_ensure_parent(path);
    var log = alloc(8);
    AuditLog_set_path(log, path);
    sakshi_debug("audit log opened", strlen("audit log opened"));
    return log;
}

# Best-effort mkdir of the parent directory of `path`. A single-level mkdir
# (parity's create_dir_all recurses, but the audit path is a file inside an
# already-existing runtime dir in practice). Failure is ignored — the
# subsequent open surfaces any real error. mode 0700.
fn _audit_ensure_parent(path) {
    var n = strlen(path);
    var last = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) { last = i; }
        i = i + 1;
    }
    if (last <= 0) { return 0; }
    var parent = alloc(last + 1);
    memcpy(parent, path, last);
    store8(parent + last, 0);
    sys_mkdir(parent, 448);
    return 0;
}

# Append an audit entry to the log (rust-old: AuditLog::log).
# Serializes to JSON, appends "\n", writes under an flock. Returns
# STIVA_ERR_OK on success or STIVA_ERR_AUDIT on write failure.
fn audit_log_log(log, entry) {
    var json = audit_entry_to_json(entry);
    var jlen = strlen(json);
    var line = alloc(jlen + 2);
    memcpy(line, json, jlen);
    store8(line + jlen, 10);        # '\n'
    store8(line + jlen + 1, 0);

    var path = AuditLog_path(log);
    if (file_append_locked(path, line, jlen + 1) < 0) {
        stiva_err_print(STIVA_ERR_AUDIT, "failed to write audit entry");
        return STIVA_ERR_AUDIT;
    }
    return STIVA_ERR_OK;
}

# Read the most recent entries, up to `limit` (rust-old: AuditLog::read_entries).
# Reads the whole file, splits on '\n', walks lines in reverse taking up to
# `limit`, and parses each. Unparseable lines are skipped (filter_map .ok()).
# Returns a Vec of AuditEntry (most-recent first), or 0 on read failure.
# An absent/empty file yields an empty Vec (parity: read_to_string of an
# empty log gives no lines).
fn audit_log_read_entries(log, limit) {
    var path = AuditLog_path(log);
    var buf = alloc(1048576);        # 1 MiB read cap
    var n = file_read_all(path, buf, 1048576);
    var out = vec_new();
    if (n <= 0) { return out; }

    # Collect line [start,end) offsets, then walk them in reverse.
    var starts = vec_new();
    var ends = vec_new();
    var ls = 0;
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 10) {
            if (i > ls) { vec_push(starts, ls); vec_push(ends, i); }
            ls = i + 1;
        }
        i = i + 1;
    }
    if (n > ls) { vec_push(starts, ls); vec_push(ends, n); }

    var nlines = vec_len(starts);
    var taken = 0;
    var li = nlines - 1;
    while (li >= 0) {
        if (taken >= limit) { break; }
        var s = vec_get(starts, li);
        var e = vec_get(ends, li);
        var linelen = e - s;
        var line = alloc(linelen + 1);
        memcpy(line, buf + s, linelen);
        store8(line + linelen, 0);
        var entry = _audit_parse_line(line);
        if (entry != 0) {
            vec_push(out, entry);
            taken = taken + 1;
        }
        li = li - 1;
    }
    return out;
}

# Parse one JSON audit line into an AuditEntry. Returns 0 on any parse
# failure (mirrors serde_json::from_str(...).ok() dropping the line).
# Minimal field extraction sufficient for round-trip parity: pulls the
# string values for timestamp/operation/container_id/image_ref/user and the
# result tag. Metadata is preserved as its raw JSON tail is NOT reconstructed
# (read_entries in Rust only inspects operation/container_id/image_ref/result
# in tests); metadata is left null on parse.
fn _audit_parse_line(line) {
    var op_s = _audit_json_field(line, "\"operation\":\"");
    if (op_s == 0) { return 0; }
    var op = audit_op_from_serde(op_s);
    if (op < 0) { return 0; }

    var e = alloc(64);
    AuditEntry_set_operation(e, op);

    var ts = _audit_json_field(line, "\"timestamp\":\"");
    if (ts == 0) { ts = ""; }
    AuditEntry_set_timestamp(e, ts);

    AuditEntry_set_container_id(e, _audit_json_field(line, "\"container_id\":\""));
    AuditEntry_set_image_ref(e, _audit_json_field(line, "\"image_ref\":\""));

    var user = _audit_json_field(line, "\"user\":\"");
    if (user == 0) { user = ""; }
    AuditEntry_set_user(e, user);

    # result: either "Success" or {"Failed":"<msg>"}
    if (_audit_contains(line, "\"result\":\"Success\"") == 1) {
        AuditEntry_set_result(e, AUDIT_RESULT_SUCCESS);
        AuditEntry_set_result_msg(e, 0);
    } else {
        AuditEntry_set_result(e, AUDIT_RESULT_FAILED);
        AuditEntry_set_result_msg(e, _audit_json_field(line, "\"Failed\":\""));
    }

    AuditEntry_set_metadata(e, 0);
    return e;
}

# True (1) if cstr `hay` contains cstr `needle`. NOTE: this stdlib `strstr`
# returns a 0-based INDEX (>= 0 on match) or -1 when absent — NOT a C-style
# pointer — so the found test is `>= 0`, and index 0 is a valid match.
#[must_use]
fn _audit_contains(hay, needle) {
    if (strstr(hay, needle) >= 0) { return 1; }
    return 0;
}

# Find `key` (e.g. "\"operation\":\"") in `line` and return a fresh heap cstr
# holding the following JSON string value up to the next unescaped quote,
# with the six standard escapes decoded. Returns 0 if `key` is absent.
#[must_use]
fn _audit_json_field(line, key) {
    # strstr returns a 0-based INDEX (-1 = absent), NOT a pointer — so the
    # value starts at `line + at + strlen(key)`.
    var at = strstr(line, key);
    if (at < 0) { return 0; }
    var p = line + at + strlen(key);
    var cap = strlen(p) + 1;
    var out = alloc(cap);
    var pos = 0;
    while (load8(p) != 0) {
        var c = load8(p);
        if (c == 34) { break; }
        if (c == 92) {
            p = p + 1;
            var d = load8(p);
            if (d == 0) { break; }
            if (d == 110) { store8(out + pos, 10); }
            elif (d == 116) { store8(out + pos, 9); }
            elif (d == 114) { store8(out + pos, 13); }
            elif (d == 98) { store8(out + pos, 8); }
            elif (d == 102) { store8(out + pos, 12); }
            elif (d == 117) {
                # \uXXXX — low byte only; the control chars we emit are ASCII. #skip-lint
                var h = _audit_hex4(p + 1);
                store8(out + pos, h & 255);
                p = p + 4;
            } else { store8(out + pos, d); }
            pos = pos + 1;
        } else {
            store8(out + pos, c); pos = pos + 1;
        }
        p = p + 1;
    }
    store8(out + pos, 0);
    return out;
}

# Decode four hex digits at `p` to an int (0 on a non-hex digit).
#[must_use]
fn _audit_hex4(p) {
    var v = 0;
    var i = 0;
    while (i < 4) {
        var c = load8(p + i);
        var d = 0;
        if (c >= 48 && c <= 57) { d = c - 48; }
        elif (c >= 97 && c <= 102) { d = c - 87; }
        elif (c >= 65 && c <= 70) { d = c - 55; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

# Path to the audit log file (rust-old: AuditLog::path).
#[must_use]
#[inline]
fn audit_log_path(log) {
    return AuditLog_path(log);
}

# ── current_user ──────────────────────────
# Current effective user name, best-effort (rust-old: current_user).
# Tries $USER, then $LOGNAME, then falls back to "uid:<euid>".
#[inline]
fn current_user() {
    # Rust: std::env::var("USER").or_else(|_| var("LOGNAME")). var() is Ok
    # even for a set-but-empty value, so a set USER (even "") is returned
    # verbatim; only an UNSET var (getenv → 0) falls through. Match that.
    var u = getenv("USER");
    if (u != 0) { return u; }
    var l = getenv("LOGNAME");
    if (l != 0) { return l; }
    var buf[24];
    var len = fmt_int_buf(sys_getuid(), &buf);
    var out = alloc(len + 5);
    memcpy(out, "uid:", 4);
    memcpy(out + 4, &buf, len);
    store8(out + 4 + len, 0);
    return out;
}

# --- convert.cyr ---

# stiva — Dockerfile / docker-compose → Stivafile (TOML) migration.
# Ported from rust-old/src/convert.rs.
#
# Two public conversions, both ported:
#   compose_yaml_to_toml(yaml) -> Result<String, StivaError>
#   dockerfile_to_toml(dockerfile) -> Result<String, StivaError>
#
# `dockerfile_to_toml` is pure string processing and ports faithfully.
# `compose_yaml_to_toml` needed a YAML parser plus a JSON-Value object
# model; bayan 1.2.0 ships both (its YAML parser emits into the same
# JTAG_*-tagged graph as its JSON parser), so it is implemented here over
# a documented subset — see the section header above it for what bayan
# rejects and how that differs from serde-saphyr.
#
# Error mapping (mirrors error.cyr): the Rust `Err(StivaError::InvalidState
# (...))` on a Dockerfile with no FROM maps to the integer sentinel `0`
# (null cstr) — the caller reports it via
# stiva_err_print(STIVA_ERR_INVALID_STATE, "Dockerfile has no FROM
# instruction"). A successful conversion returns a heap cstr pointer.

# ── small cstr helpers (parity-exact byte handling) ──────────────

# True (1) iff byte `c` is ASCII whitespace stripped by Rust's str::trim
# (space, tab, CR, LF). Rust trims Unicode whitespace; Dockerfiles are
# ASCII in practice, so we match the ASCII subset the tests exercise.
#[must_use]
fn _cv_is_ws(c) {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    if (c == 10) { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

# Copy bytes [start, end) of `src` into a fresh NUL-terminated cstr.
# Returns the heap pointer (empty cstr if end <= start).
#[must_use]
fn _cv_slice(src, start, end) {
    var n = end - start;
    if (n < 0) { n = 0; }
    var out = alloc(n + 1);
    memcpy(out, src + start, n);
    store8(out + n, 0);
    return out;
}

# Trim leading+trailing ASCII whitespace, returning a fresh cstr.
#[must_use]
fn _cv_trim(s) {
    var len = strlen(s);
    var start = 0;
    while (start < len) {
        if (_cv_is_ws(load8(s + start)) == 0) { break; }
        start = start + 1;
    }
    var end = len;
    while (end > start) {
        if (_cv_is_ws(load8(s + end - 1)) == 0) { break; }
        end = end - 1;
    }
    return _cv_slice(s, start, end);
}

# Rust `line.trim_end_matches('\\').trim()` — strip trailing backslashes
# then re-trim. Returns a fresh cstr.
#[must_use]
fn _cv_strip_cont(s) {
    var len = strlen(s);
    var end = len;
    while (end > 0) {
        if (load8(s + end - 1) != 92) { break; }
        end = end - 1;
    }
    var stripped = _cv_slice(s, 0, end);
    return _cv_trim(stripped);
}

# If `s` starts with `prefix`, return a pointer just past it (into `s`);
# otherwise 0. Mirrors str::strip_prefix.
#[must_use]
fn _cv_strip_prefix(s, prefix) {
    var plen = strlen(prefix);
    if (strlen(s) < plen) { return 0; }
    if (memeq(s, prefix, plen) == 0) { return 0; }
    return s + plen;
}

# Trim a single matching leading+trailing `quote` byte if BOTH ends carry
# it — approximates Rust `str::trim_matches('"')` for the double-quote
# used by ENV/LABEL value parsing. Returns a fresh cstr.
#[must_use]
fn _cv_trim_quotes(s) {
    var len = strlen(s);
    var start = 0;
    var end = len;
    while (end > start) {
        if (load8(s + start) != 34) { break; }
        if (load8(s + end - 1) != 34) { break; }
        start = start + 1;
        end = end - 1;
    }
    return _cv_slice(s, start, end);
}

# Index of the first `byte` in `s`, or -1 (mirrors split_once/find).
#[must_use]
fn _cv_find(s, byte) {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (load8(s + i) == byte) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# True (1) iff `s` (already-trimmed line) is empty or a comment (`#`).
#[must_use]
fn _cv_skip_line(s) {
    if (load8(s) == 0) { return 1; }
    if (load8(s) == 35) { return 1; }
    return 0;
}

# ── string-builder step emitters ────────────────────
# Each appends one rendered TOML fragment to `sb`. Kept small so the
# main function reads as a 1:1 mirror of the Rust match arms.

# `[[steps]]\ntype = "run"\ncommand = ["/bin/sh", "-c", "<cmd>"]`
# where `<cmd>` has every `"` replaced with `\"` (Rust rest.replace).
fn _cv_emit_run(sb, rest) {
    str_builder_add_cstr(sb, "[[steps]]\ntype = \"run\"\ncommand = [\"/bin/sh\", \"-c\", \"");
    var len = strlen(rest);
    var i = 0;
    while (i < len) {
        var c = load8(rest + i);
        if (c == 34) { str_builder_add_cstr(sb, "\\\""); }
        else { str_builder_putc(sb, c); }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "\"]");
    return 0;
}

# `[[steps]]\ntype = "copy"\nsource = "<s>"\ndestination = "<d>"`
fn _cv_emit_copy(sb, src, dst) {
    str_builder_add_cstr(sb, "[[steps]]\ntype = \"copy\"\nsource = \"");
    str_builder_add_cstr(sb, src);
    str_builder_add_cstr(sb, "\"\ndestination = \"");
    str_builder_add_cstr(sb, dst);
    str_builder_add_cstr(sb, "\"");
    return 0;
}

# `[[steps]]\ntype = "env"\nkey = "<k>"\nvalue = "<v>"`
fn _cv_emit_env(sb, k, v) {
    str_builder_add_cstr(sb, "[[steps]]\ntype = \"env\"\nkey = \"");
    str_builder_add_cstr(sb, k);
    str_builder_add_cstr(sb, "\"\nvalue = \"");
    str_builder_add_cstr(sb, v);
    str_builder_add_cstr(sb, "\"");
    return 0;
}

# `[[steps]]\ntype = "workdir"\npath = "<p>"`
fn _cv_emit_workdir(sb, p) {
    str_builder_add_cstr(sb, "[[steps]]\ntype = \"workdir\"\npath = \"");
    str_builder_add_cstr(sb, p);
    str_builder_add_cstr(sb, "\"");
    return 0;
}

# `[[steps]]\ntype = "label"\nkey = "<k>"\nvalue = "<v>"`
fn _cv_emit_label(sb, k, v) {
    str_builder_add_cstr(sb, "[[steps]]\ntype = \"label\"\nkey = \"");
    str_builder_add_cstr(sb, k);
    str_builder_add_cstr(sb, "\"\nvalue = \"");
    str_builder_add_cstr(sb, v);
    str_builder_add_cstr(sb, "\"");
    return 0;
}

# ── ENV / LABEL "k = v" parsing ─────────────────────
# Rust: `rest.split_once('=')` → (k.trim(), v.trim().trim_matches('"')).
# For ENV, if there is no '=', fall back to `rest.split_once(' ')`
# → (k.trim(), v.trim()) (no quote-strip). Emits into `sb`; returns 1
# if a step was emitted, 0 otherwise (matches Rust's conditional push).
fn _cv_parse_env(sb, rest) {
    var eq = _cv_find(rest, 61);
    if (eq >= 0) {
        var k = _cv_trim(_cv_slice(rest, 0, eq));
        var vraw = _cv_slice(rest, eq + 1, strlen(rest));
        var v = _cv_trim_quotes(_cv_trim(vraw));
        _cv_emit_env(sb, k, v);
        return 1;
    }
    var sp = _cv_find(rest, 32);
    if (sp >= 0) {
        var k2 = _cv_trim(_cv_slice(rest, 0, sp));
        var v2 = _cv_trim(_cv_slice(rest, sp + 1, strlen(rest)));
        _cv_emit_env(sb, k2, v2);
        return 1;
    }
    return 0;
}

# Rust LABEL arm: only the '=' form; value trimmed + trim_matches('"').
fn _cv_parse_label(sb, rest) {
    var eq = _cv_find(rest, 61);
    if (eq < 0) { return 0; }
    var k = _cv_trim(_cv_slice(rest, 0, eq));
    var vraw = _cv_slice(rest, eq + 1, strlen(rest));
    var v = _cv_trim_quotes(_cv_trim(vraw));
    _cv_emit_label(sb, k, v);
    return 1;
}

# COPY arm: `rest.splitn(2, ' ')`; only emit if exactly two parts.
# Returns 1 if emitted.
fn _cv_parse_copy(sb, rest) {
    var sp = _cv_find(rest, 32);
    if (sp < 0) { return 0; }
    var src = _cv_slice(rest, 0, sp);
    var dst = _cv_slice(rest, sp + 1, strlen(rest));
    # splitn(2, ' ') keeps the remainder (including any further spaces)
    # as parts[1] verbatim — _cv_slice to end already does that.
    _cv_emit_copy(sb, src, dst);
    return 1;
}

# ── main Dockerfile converter ─────────────────────
# Convert a Dockerfile cstr to a Stivafile TOML cstr.
#
# Handles FROM, RUN, COPY, ENV, WORKDIR, LABEL, EXPOSE, ENTRYPOINT,
# USER (CMD/ADD/ARG/SHELL are skipped, as in the oracle).
#
# Returns a heap cstr on success, or 0 on the no-FROM error (caller maps
# 0 → StivaError::InvalidState "Dockerfile has no FROM instruction").
#[must_use]
fn dockerfile_to_toml(dockerfile) {
    # Accumulators mirroring the Rust locals.
    var base = "";
    var user = "";
    var workdir_config = "";
    # entrypoint: a vec of quoted-token cstrs already `"..."`-wrapped for
    # the final `entrypoint = [...]`; empty ⇒ omit the line.
    var entrypoint = vec_new();
    # expose: a vec of port ints (u16 in Rust); empty ⇒ omit the line.
    var expose = vec_new();
    # steps: builder accumulating the rendered `[[steps]]` blocks (each
    # already separated by "\n\n"); we count via step_count.
    var steps_sb = str_builder_new();
    var step_count = 0;

    var dlen = strlen(dockerfile);
    var lstart = 0;
    var pos = 0;
    while (pos <= dlen) {
        var at_end = 0;
        if (pos == dlen) { at_end = 1; }
        var is_nl = 0;
        if (at_end == 0) { if (load8(dockerfile + pos) == 10) { is_nl = 1; } }
        if (is_nl == 1 || at_end == 1) {
            var raw = _cv_slice(dockerfile, lstart, pos);
            var line = _cv_trim(raw);
            if (_cv_skip_line(line) == 0) {
                # Strip line continuations then re-trim (Rust does this
                # for every non-comment line, before the prefix checks).
                line = _cv_strip_cont(line);

                var rest = _cv_strip_prefix(line, "FROM ");
                if (rest != 0) {
                    base = _cv_trim(rest);
                } else {
                    rest = _cv_strip_prefix(line, "RUN ");
                    if (rest != 0) {
                        if (step_count > 0) { str_builder_add_cstr(steps_sb, "\n\n"); }
                        _cv_emit_run(steps_sb, rest);
                        step_count = step_count + 1;
                    } else {
                        rest = _cv_strip_prefix(line, "COPY ");
                        if (rest != 0) {
                            var tmp_sb = str_builder_new();
                            if (_cv_parse_copy(tmp_sb, rest) == 1) {
                                if (step_count > 0) { str_builder_add_cstr(steps_sb, "\n\n"); }
                                str_builder_add(steps_sb, str_builder_build(tmp_sb));
                                step_count = step_count + 1;
                            }
                        } else {
                            rest = _cv_strip_prefix(line, "ENV ");
                            if (rest != 0) {
                                var env_sb = str_builder_new();
                                if (_cv_parse_env(env_sb, rest) == 1) {
                                    if (step_count > 0) { str_builder_add_cstr(steps_sb, "\n\n"); }
                                    str_builder_add(steps_sb, str_builder_build(env_sb));
                                    step_count = step_count + 1;
                                }
                            } else {
                                rest = _cv_strip_prefix(line, "WORKDIR ");
                                if (rest != 0) {
                                    var wd = _cv_trim(rest);
                                    if (step_count > 0) { str_builder_add_cstr(steps_sb, "\n\n"); }
                                    _cv_emit_workdir(steps_sb, wd);
                                    step_count = step_count + 1;
                                    workdir_config = wd;
                                } else {
                                    rest = _cv_strip_prefix(line, "LABEL ");
                                    if (rest != 0) {
                                        var lbl_sb = str_builder_new();
                                        if (_cv_parse_label(lbl_sb, rest) == 1) {
                                            if (step_count > 0) { str_builder_add_cstr(steps_sb, "\n\n"); }
                                            str_builder_add(steps_sb, str_builder_build(lbl_sb));
                                            step_count = step_count + 1;
                                        }
                                    } else {
                                        rest = _cv_strip_prefix(line, "EXPOSE ");
                                        if (rest != 0) {
                                            _cv_parse_expose(expose, rest);
                                        } else {
                                            rest = _cv_strip_prefix(line, "ENTRYPOINT ");
                                            if (rest != 0) {
                                                # Last ENTRYPOINT wins (Rust: `entrypoint = ...`
                                                # assignment, not append) — reset before parsing.
                                                entrypoint = vec_new();
                                                _cv_parse_entrypoint(entrypoint, _cv_trim(rest));
                                            } else {
                                                rest = _cv_strip_prefix(line, "USER ");
                                                if (rest != 0) {
                                                    user = _cv_trim(rest);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            lstart = pos + 1;
        }
        pos = pos + 1;
    }

    # No FROM ⇒ error sentinel (Rust: Err(InvalidState)).
    if (strlen(base) == 0) { return 0; }

    # Assemble the output document.
    var out = str_builder_new();
    str_builder_add_cstr(out, "[image]\n");
    str_builder_add_cstr(out, "base = \"");
    str_builder_add_cstr(out, base);
    str_builder_add_cstr(out, "\"\n");
    str_builder_add_cstr(out, "name = \"converted\"\n");
    str_builder_add_cstr(out, "tag = \"latest\"\n");
    str_builder_add_cstr(out, "\n");

    # Each step block is followed by a blank line (Rust writes the step
    # then an empty writeln! per iteration).
    if (step_count > 0) {
        str_builder_add(out, str_builder_build(steps_sb));
        str_builder_add_cstr(out, "\n\n");
    }

    str_builder_add_cstr(out, "[config]\n");

    if (vec_len(entrypoint) > 0) {
        str_builder_add_cstr(out, "entrypoint = [");
        var ei = 0;
        while (ei < vec_len(entrypoint)) {
            if (ei > 0) { str_builder_add_cstr(out, ", "); }
            str_builder_add_cstr(out, vec_get(entrypoint, ei));
            ei = ei + 1;
        }
        str_builder_add_cstr(out, "]\n");
    }

    if (vec_len(expose) > 0) {
        str_builder_add_cstr(out, "expose = [");
        var pi = 0;
        while (pi < vec_len(expose)) {
            if (pi > 0) { str_builder_add_cstr(out, ", "); }
            str_builder_add_int(out, vec_get(expose, pi));
            pi = pi + 1;
        }
        str_builder_add_cstr(out, "]\n");
    }

    if (strlen(user) > 0) {
        str_builder_add_cstr(out, "user = \"");
        str_builder_add_cstr(out, user);
        str_builder_add_cstr(out, "\"\n");
    }

    if (strlen(workdir_config) > 0) {
        str_builder_add_cstr(out, "workdir = \"");
        str_builder_add_cstr(out, workdir_config);
        str_builder_add_cstr(out, "\"\n");
    }

    var built = str_builder_build(out);
    return str_cstr(built);
}

# EXPOSE arm: split on whitespace, strip `/proto` suffix, parse each
# token as a decimal port and push valid ones (0..65535 → Rust u16
# parse) onto `expose`. Invalid tokens are skipped (Rust `if let Ok`).
fn _cv_parse_expose(expose, rest) {
    var len = strlen(rest);
    var i = 0;
    while (i < len) {
        # Skip whitespace.
        while (i < len) {
            if (_cv_is_ws(load8(rest + i)) == 0) { break; }
            i = i + 1;
        }
        if (i >= len) { break; }
        var tok_start = i;
        while (i < len) {
            if (_cv_is_ws(load8(rest + i)) == 1) { break; }
            i = i + 1;
        }
        var tok = _cv_slice(rest, tok_start, i);
        # Strip protocol suffix: everything before the first '/'.
        var slash = _cv_find(tok, 47);
        var port_str = tok;
        if (slash >= 0) { port_str = _cv_slice(tok, 0, slash); }
        if (_cv_parse_u16(port_str) == 1) {
            vec_push(expose, atoi(port_str));
        }
    }
    return 0;
}

# True (1) iff `s` is a non-empty all-digit string whose value fits u16
# (0..=65535), matching Rust `port_str.parse::<u16>()`. Leading '+'/'-'
# and empties fail (Rust u16 parse rejects them).
#[must_use]
fn _cv_parse_u16(s) {
    var len = strlen(s);
    if (len == 0) { return 0; }
    var i = 0;
    while (i < len) {
        var c = load8(s + i);
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        i = i + 1;
    }
    if (atoi(s) > 65535) { return 0; }
    return 1;
}

# ENTRYPOINT arm: JSON-array form `[...]` → parse the quoted string
# elements; shell form → `["/bin/sh", "-c", "<rest>"]`. Each element is
# pushed onto `entrypoint` already wrapped as `"<elem>"` (ready for the
# `entrypoint = [...]` join). `rest` is the trimmed remainder.
fn _cv_parse_entrypoint(entrypoint, rest) {
    if (load8(rest) == 91) {
        # JSON array form. The oracle uses serde_json to parse a
        # Vec<String>; we do a minimal quoted-token scan sufficient for
        # the well-formed arrays a Dockerfile ENTRYPOINT carries.
        # On a malformed array the Rust `if let Ok(arr)` leaves
        # entrypoint empty — our scan simply pushes whatever complete
        # `"..."` tokens it finds.
        var len = strlen(rest);
        var i = 0;
        while (i < len) {
            if (load8(rest + i) == 34) {
                var estart = i + 1;
                var j = estart;
                while (j < len) {
                    if (load8(rest + j) == 34) { break; }
                    j = j + 1;
                }
                if (j >= len) { break; }
                var elem = _cv_slice(rest, estart, j);
                var wrapped = _cv_wrap_quote(elem);
                vec_push(entrypoint, wrapped);
                i = j + 1;
            } else {
                i = i + 1;
            }
        }
        return 0;
    }
    # Shell form → ["/bin/sh", "-c", "<rest>"].
    vec_push(entrypoint, "\"/bin/sh\"");
    vec_push(entrypoint, "\"-c\"");
    vec_push(entrypoint, _cv_wrap_quote(rest));
    return 0;
}

# Wrap `s` as `"<s>"` in a fresh cstr (no interior escaping — matches the
# oracle's `format!("\"{s}\"")`).
#[must_use]
fn _cv_wrap_quote(s) {
    var len = strlen(s);
    var out = alloc(len + 3);
    store8(out, 34);
    memcpy(out + 1, s, len);
    store8(out + 1 + len, 34);
    store8(out + 2 + len, 0);
    return out;
}

# ══ docker-compose YAML → stiva compose TOML ═════════════════════
# Oracle: rust-old/src/convert.rs:11-175. Built on bayan's YAML parser
# (lib/bayan.cyr:4275-5150), which emits into the SAME JTAG_*-tagged
# value graph as its JSON parser — exactly the "YAML parser + Value
# model" pair this conversion waited on until bayan 1.2.0 landed it
# (roadmap §G; CHANGELOG 3.0.6).
#
# ── Two structural facts drive the whole port ──
#
# 1. ORDERING. serde_json's Map (no `preserve_order` feature in
#    rust-old/Cargo.toml) is a BTreeMap, so the oracle emits services,
#    networks, volumes, env-maps and depends_on-objects in SORTED key
#    order. bayan objects are insertion-ordered pair vectors. Every
#    `for (name, x) in obj` in the oracle therefore becomes
#    `_cv_sorted_idx(obj)` here. Miss one and every multi-service file
#    diverges. Document-ordered by contrast (oracle uses Vec): the
#    command/ports/volumes/depends_on ARRAY forms and the env LIST form.
#
# 2. BORROWED STRINGS. bayan's JTAG_STR values and object keys are
#    Str{ptr,len} headers pointing INTO the source buffer (bayan.cyr:
#    4331-4332) — not copies, and NOT NUL-terminated. So: the caller's
#    yaml buffer must outlive the returned TOML, and `strlen(str_data(s))`
#    reads past the end. Always go through str_builder_add(sb, s).
#
# ── The subset is honest, not total ──
# bayan rejects, with a verbatim message surfaced via compose_last_error():
# flow mappings (`{k: v}`), block scalars (`|`, `>`), anchors/aliases
# (`&x`/`*x`), tags (`!!str`), multi-document (`---` twice), tab indent,
# complex keys (`? `), and escaped quotes inside quoted scalars. Merge keys
# (`<<`) have no bayan support at all — `<<: *base` dies incidentally on the
# alias check, but a literal `<<: x` would silently become a key, so
# _cv_validate_doc rejects it explicitly, everywhere in the document.
#
# ── Divergences from the oracle, all deliberate and all tested ──
#  · anchors/merge keys — serde-saphyr RESOLVES them before the walk, so a
#    service inheriting via `<<: *base` got its parent's fields. We reject.
#    This is the biggest real-world subset loss.
#  · escaped quotes (`"a\"b"`) — the oracle accepted them and then emitted
#    invalid TOML (it did no escaping either); bayan errors. Stricter.
#  · OUTPUT IS ESCAPED. The oracle emitted every value and section name
#    through a bare `format!`. Since this converter exists to ingest
#    THIRD-PARTY files, that let a hostile compose file close its own string
#    and open a fabricated table, so the document a human reviewed and the
#    one parse_ansamblu later loaded could differ. See _cv_emit_toml_str.
#  · YAML 1.1 bool/null tokens are resolved HERE rather than in the parser,
#    because bayan is YAML 1.2 core and the oracle's parser was not. Without
#    it `restart: no` — compose's documented default — diverges on ordinary
#    files. See _cv_yaml11_token.
#  · duplicate mapping keys are REJECTED, matching the oracle. bayan accepts
#    them, and since the emitter ITERATES these maps both pairs would
#    survive into unloadable TOML. See _cv_validate_doc.
#
# Two gaps left in bayan's scalar resolver, documented rather than worked
# around here: an integer above i64::MAX wraps negative (serde_json holds a
# u64 and round-trips it), and non-decimal / underscored / leading-zero
# spellings (0x1f, 1_000, 007) stay strings — which also un-drops array
# elements the oracle's filter_map(as_str) discards.

# Detail cstr for the last compose_yaml_to_toml failure, or 0. The
# pointer-return convention (see the header) has no room for a payload,
# so this mirrors bayan's own bayan_yaml_last_error() idiom.
var _cv_compose_err = 0;

#[must_use]
fn compose_last_error() {
    if (_cv_compose_err == 0) { return "invalid YAML"; }
    return _cv_compose_err;
}

# Rust String Ord: unsigned byte-wise lexicographic, shorter prefix
# first. load8 zero-extends, so no masking is needed. Args are bayan Str
# pointers (borrowed, not NUL-terminated) — never strlen them.
#[must_use]
fn _cv_key_lt(a, b) {
    var la = str_len(a);
    var lb = str_len(b);
    var n = la;
    if (lb < n) { n = lb; }
    var i = 0;
    while (i < n) {
        var ca = load8(str_data(a) + i);
        var cb = load8(str_data(b) + i);
        if (ca < cb) { return 1; }
        if (ca > cb) { return 0; }
        i = i + 1;
    }
    if (la < lb) { return 1; }
    return 0;
}

# Indices 0..obj_len-1 of `obj` sorted by key — the BTreeMap order the
# oracle gets for free.
#
# Bottom-up merge sort, NOT the insertion sort this started as. `convert`
# exists to ingest third-party compose files, and an insertion sort is
# O(n^2) on adversarial (reverse-sorted) key order: a 1 MiB file of ~95k
# reverse-ordered service keys took **236 s of pinned CPU**, against 0.09 s
# for the identical bytes in ascending order — a ~2000x amplification on
# attacker-chosen input, with no output until it finishes. Merge sort is
# O(n log n) regardless of input order, so the amplification disappears
# rather than being papered over with a size cap. Stable, which does not
# matter once duplicate keys are rejected but costs nothing.
# (There is no vec_sort in lib/vec.cyr.)
#[must_use]
fn _cv_sorted_idx(obj) {
    var n = bayan_json_v_obj_len(obj);
    var idx = vec_new();
    var i = 0;
    while (i < n) { vec_push(idx, i); i = i + 1; }
    if (n < 2) { return idx; }

    var buf = vec_new();
    i = 0;
    while (i < n) { vec_push(buf, 0); i = i + 1; }

    var width = 1;
    while (width < n) {
        var lo = 0;
        while (lo < n) {
            var mid = lo + width;
            if (mid > n) { mid = n; }
            var hi = lo + width + width;
            if (hi > n) { hi = n; }
            # Merge idx[lo, mid) and idx[mid, hi) into buf[lo, hi).
            var a = lo;
            var b = mid;
            var o = lo;
            while (o < hi) {
                var take_a = 0;
                if (a < mid) {
                    if (b >= hi) { take_a = 1; }
                    else {
                        # Strict `<` on the right operand keeps the merge
                        # stable: ties take from the left run.
                        if (_cv_key_lt(bayan_json_v_obj_key(obj, vec_get(idx, b)),
                            bayan_json_v_obj_key(obj, vec_get(idx, a))) == 0) { take_a = 1; }
                    }
                }
                if (take_a == 1) { vec_set(buf, o, vec_get(idx, a)); a = a + 1; }
                else { vec_set(buf, o, vec_get(idx, b)); b = b + 1; }
                o = o + 1;
            }
            lo = lo + width + width;
        }
        i = 0;
        while (i < n) { vec_set(idx, i, vec_get(buf, i)); i = i + 1; }
        width = width + width;
    }
    return idx;
}

# ── document validation (recursive, before any emission) ──
# Two constructs must be refused for the conversion to be honest, and both
# have to be checked over the WHOLE document, not just the maps the emitter
# happens to walk:
#
#  * **merge keys.** bayan has no `<<` handling at all. The common
#    `<<: *base` form dies incidentally on the alias check, but a literal
#    `<<: x` would silently become a TOML key named `<<`.
#  * **duplicate mapping keys.** serde-saphyr (the oracle's parser) rejects
#    the document outright. bayan keeps both pairs and `obj_get` returns the
#    first — which sounds like a harmless superset until you notice the
#    emitter ITERATES these maps, so both survive and the output carries two
#    `[services.a]` tables, or `env = { A = "1", A = "2" }`. That is not
#    merely divergent, it is TOML no parser will load, handed back with exit
#    code 0. Rejecting matches the oracle and is the only safe answer.
#
# Sets _cv_compose_err and returns 1 on a violation, else 0.
fn _cv_validate_doc(v) {
    if (bayan_json_v_is_arr(v) == 1) {
        var an = bayan_json_v_arr_len(v);
        var ai = 0;
        while (ai < an) {
            if (_cv_validate_doc(bayan_json_v_arr_get(v, ai)) == 1) { return 1; }
            ai = ai + 1;
        }
        return 0;
    }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }

    var n = bayan_json_v_obj_len(v);
    var i = 0;
    while (i < n) {
        if (str_eq_cstr(bayan_json_v_obj_key(v, i), "<<") == 1) {
            _cv_compose_err = "invalid YAML: merge keys ('<<') not supported";
            return 1;
        }
        i = i + 1;
    }

    # Adjacent-equal check over the sorted order — O(n log n) total, versus
    # O(n^2) for a naive pairwise scan on the same attacker-supplied input.
    if (n > 1) {
        var order = _cv_sorted_idx(v);
        i = 1;
        while (i < n) {
            var prev = bayan_json_v_obj_key(v, vec_get(order, i - 1));
            var cur = bayan_json_v_obj_key(v, vec_get(order, i));
            if (_cv_key_lt(prev, cur) == 0) {
                var esb = str_builder_new();
                str_builder_add_cstr(esb, "invalid YAML: duplicate mapping key: ");
                str_builder_add(esb, cur);
                _cv_compose_err = str_cstr(str_builder_build(esb));
                return 1;
            }
            i = i + 1;
        }
    }

    i = 0;
    while (i < n) {
        if (_cv_validate_doc(bayan_json_v_obj_val(v, i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ── YAML 1.1 bool/null tokens ─────────────────────
# bayan resolves the YAML 1.2 core schema: only `true`/`false`/`null` become
# tagged scalars. serde-saphyr — the oracle's parser — resolves the wider
# YAML 1.1 token family, so in the oracle `restart: no` is `Value::Bool(false)`,
# `.as_str()` returns None, and `convert.rs:133-135` emits **nothing**. A naive
# port emits `restart = "no"`.
#
# That is not a curiosity: `no` is docker-compose's documented default for
# `restart`, and the same flip hits `image`, `driver`, `subnet`, and the
# ports/volumes/depends_on/command array arms — where the oracle's
# `filter_map(as_str)` DROPS a bool element and a naive port keeps it as a
# quoted string. So the tokens are resolved here instead, at the guards.
#
# Returns the canonical `Value::to_string()` rendering — "true"/"false"/"null"
# — for a token, or 0 for an ordinary string. The token set is the one
# measured against the compiled oracle, not guessed.
#[must_use]
fn _cv_yaml11_token(s) {
    if (s == 0) { return 0; }
    var n = str_len(s);
    if (n < 1) { return 0; }
    if (n > 5) { return 0; }
    var t = alloc(n + 1);
    memcpy(t, str_data(s), n);
    store8(t + n, 0);

    if (streq(t, "y") == 1) { return "true"; }
    if (streq(t, "Y") == 1) { return "true"; }
    if (streq(t, "yes") == 1) { return "true"; }
    if (streq(t, "Yes") == 1) { return "true"; }
    if (streq(t, "YES") == 1) { return "true"; }
    if (streq(t, "on") == 1) { return "true"; }
    if (streq(t, "On") == 1) { return "true"; }
    if (streq(t, "ON") == 1) { return "true"; }
    if (streq(t, "True") == 1) { return "true"; }
    if (streq(t, "TRUE") == 1) { return "true"; }

    if (streq(t, "n") == 1) { return "false"; }
    if (streq(t, "N") == 1) { return "false"; }
    if (streq(t, "no") == 1) { return "false"; }
    if (streq(t, "No") == 1) { return "false"; }
    if (streq(t, "NO") == 1) { return "false"; }
    if (streq(t, "off") == 1) { return "false"; }
    if (streq(t, "Off") == 1) { return "false"; }
    if (streq(t, "OFF") == 1) { return "false"; }
    if (streq(t, "False") == 1) { return "false"; }
    if (streq(t, "FALSE") == 1) { return "false"; }

    if (streq(t, "Null") == 1) { return "null"; }
    if (streq(t, "NULL") == 1) { return "null"; }
    return 0;
}

# True (1) iff `v` is a JTAG_STR the oracle's parser would NOT have left as a
# string — i.e. every `.as_str()` guard in the oracle sees None. Use this
# wherever the oracle calls as_str() on a value that came from YAML.
#[must_use]
fn _cv_is_yaml_str(v) {
    if (bayan_json_v_is_str(v) == 0) { return 0; }
    if (_cv_yaml11_token(bayan_json_v_str(v)) != 0) { return 0; }
    return 1;
}

# ── TOML output escaping ──────────────────────────
# **A deliberate divergence from the oracle**, recorded in the CHANGELOG.
# rust-old emits every value through a bare `format!("\"{v}\"")` and every
# section name through `format!("[services.{name}]")` — no escaping anywhere.
# Since `convert` exists to ingest THIRD-PARTY compose files, that is a
# structure-forgery hole, not a formatting quirk: a hostile file can close
# the string it is written into and open a new table, so what a human reads
# in the compose source and what stiva's own parse_ansamblu later loads are
# different documents. Inheriting the oracle's behavior here would inherit a
# vulnerability, so this port escapes.
#
# TOML basic-string escapes (v1.0.0 §String): backslash, quote, and the
# control range must be escaped; the rest passes through as UTF-8 bytes.
fn _cv_emit_toml_str(sb, s) {
    str_builder_putc(sb, 34);
    var p = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c == 92) { str_builder_add_cstr(sb, "\\\\"); }
        elif (c == 34) { str_builder_add_cstr(sb, "\\\""); }
        elif (c == 8) { str_builder_add_cstr(sb, "\\b"); }
        elif (c == 9) { str_builder_add_cstr(sb, "\\t"); }
        elif (c == 10) { str_builder_add_cstr(sb, "\\n"); }
        elif (c == 12) { str_builder_add_cstr(sb, "\\f"); }
        elif (c == 13) { str_builder_add_cstr(sb, "\\r"); }
        elif (c < 32 || c == 127) {
            # A 4-hex-digit \u escape is the only form TOML accepts for the
            # rest of C0.
            str_builder_add_cstr(sb, "\\u00");
            var hi = c / 16;
            var lo = c - hi * 16;
            if (hi < 10) { str_builder_putc(sb, 48 + hi); } else { str_builder_putc(sb, 87 + hi); }
            if (lo < 10) { str_builder_putc(sb, 48 + lo); } else { str_builder_putc(sb, 87 + lo); }
        }
        else { str_builder_putc(sb, c); }
        i = i + 1;
    }
    str_builder_putc(sb, 34);
    return 0;
}

# Emit `s` as a TOML key: bare when it is a non-empty run of [A-Za-z0-9_-],
# quoted otherwise. Used for service/network/volume names (inside the
# `[services.<name>]` dotted path, where a quoted segment is legal) and for
# inline-table keys in `env = { ... }`.
fn _cv_emit_toml_key(sb, s) {
    var p = str_data(s);
    var n = str_len(s);
    var bare = 1;
    if (n == 0) { bare = 0; }
    var i = 0;
    while (i < n && bare == 1) {
        var c = load8(p + i);
        var ok = 0;
        if (c >= 65 && c <= 90) { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c == 95 || c == 45) { ok = 1; }
        if (ok == 0) { bare = 0; }
        i = i + 1;
    }
    if (bare == 1) { str_builder_add(sb, s); return 0; }
    _cv_emit_toml_str(sb, s);
    return 0;
}

# ── Value::to_string() analogue ───────────────────
# The oracle's env fallback for a non-string value is serde_json's
# `Value::to_string()` (convert.rs:59). `bayan_json_v_build` matches it
# byte-for-byte on scalars and arrays — but NOT on objects: serde_json's Map
# is a BTreeMap at EVERY depth, so it serializes nested keys sorted, while
# `_jb_walk` walks bayan's insertion-ordered pair vector. A compose
# `environment:` whose value is itself a mapping therefore renders with a
# different key order. This walks the graph with the same sort applied
# recursively.
#
# Returns a Str. Known remaining gap, at bayan's scalar resolver rather than
# here: an integer above i64::MAX is a u64 in serde_json and round-trips
# exactly, but wraps negative through bayan's JTAG_INT.
#[must_use]
fn _cv_value_to_string(v) {
    var sb = str_builder_new();
    _cv_v_to_str_into(sb, v);
    return str_builder_build(sb);
}

fn _cv_v_to_str_into(sb, v) {
    if (bayan_json_v_is_obj(v) == 1) {
        var n = bayan_json_v_obj_len(v);
        str_builder_putc(sb, 123);
        if (n > 0) {
            var order = _cv_sorted_idx(v);
            var i = 0;
            while (i < n) {
                if (i > 0) { str_builder_putc(sb, 44); }
                var idx = vec_get(order, i);
                # serde_json always writes object keys as JSON strings.
                str_builder_add(sb, bayan_json_v_build(
                    bayan_json_v_str_new(bayan_json_v_obj_key(v, idx))));
                str_builder_putc(sb, 58);
                _cv_v_to_str_into(sb, bayan_json_v_obj_val(v, idx));
                i = i + 1;
            }
        }
        str_builder_putc(sb, 125);
        return 0;
    }
    if (bayan_json_v_is_arr(v) == 1) {
        var m = bayan_json_v_arr_len(v);
        str_builder_putc(sb, 91);
        var j = 0;
        while (j < m) {
            if (j > 0) { str_builder_putc(sb, 44); }
            _cv_v_to_str_into(sb, bayan_json_v_arr_get(v, j));
            j = j + 1;
        }
        str_builder_putc(sb, 93);
        return 0;
    }
    # A JTAG_STR the oracle's parser would have RESOLVED renders as the
    # resolved value, not as a quoted string: `A: yes` is Bool(true) there,
    # so to_string() gives `true`, never `"yes"`.
    if (bayan_json_v_is_str(v) == 1) {
        var tok = _cv_yaml11_token(bayan_json_v_str(v));
        if (tok != 0) { str_builder_add_cstr(sb, tok); return 0; }
    }
    # Scalars: bayan's own serializer is byte-exact against serde_json here
    # (true/false/null, 8080, 1.5, 1.0, 1e10 -> 10000000000.0, -0.25).
    str_builder_add(sb, bayan_json_v_build(v));
    return 0;
}

# `<key> = ["a", "b"]\n` from a JTAG_ARR, keeping only JTAG_STR elements
# in DOCUMENT order (oracle: filter_map over a Vec). Emits nothing and
# returns 0 when nothing survives — the oracle's `if !items.is_empty()`.
# drop_empty=1 also drops zero-length strings (the ports arm,
# rust-old/src/convert.rs:92-93, where a bare integer maps to "").
fn _cv_emit_str_arr(sb, key, arr, drop_empty) {
    var n = bayan_json_v_arr_len(arr);
    var tmp = str_builder_new();
    var cnt = 0;
    var i = 0;
    while (i < n) {
        var v = bayan_json_v_arr_get(arr, i);
        if (_cv_is_yaml_str(v) == 1) {
            var s = bayan_json_v_str(v);
            var keep = 1;
            if (drop_empty == 1) { if (str_len(s) == 0) { keep = 0; } }
            if (keep == 1) {
                if (cnt > 0) { str_builder_add_cstr(tmp, ", "); }
                _cv_emit_toml_str(tmp, s);
                cnt = cnt + 1;
            }
        }
        i = i + 1;
    }
    if (cnt == 0) { return 0; }
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, " = [");
    str_builder_add(sb, str_builder_build(tmp));
    str_builder_add_cstr(sb, "]\n");
    return 1;
}

# `command = [...]` — string form splits on whitespace, array form keeps
# JTAG_STR elements. Unlike ports/volumes this ALWAYS emits once a branch
# matches, so `command: ""` renders `command = []` (oracle: the writeln!
# sits outside the is_empty guard).
fn _cv_emit_compose_command(sb, cmd) {
    if (_cv_is_yaml_str(cmd) == 1) {
        str_builder_add_cstr(sb, "command = [");
        var s = bayan_json_v_str(cmd);
        var p = str_data(s);
        var n = str_len(s);
        var i = 0;
        var cnt = 0;
        while (i < n) {
            while (i < n && _cv_is_ws(load8(p + i)) == 1) { i = i + 1; }
            if (i < n) {
                var st = i;
                while (i < n && _cv_is_ws(load8(p + i)) == 0) { i = i + 1; }
                if (cnt > 0) { str_builder_add_cstr(sb, ", "); }
                _cv_emit_toml_str(sb, str_new(p + st, i - st));
                cnt = cnt + 1;
            }
        }
        str_builder_add_cstr(sb, "]\n");
        return 1;
    }
    if (bayan_json_v_is_arr(cmd) == 1) {
        var m = bayan_json_v_arr_len(cmd);
        str_builder_add_cstr(sb, "command = [");
        var j = 0;
        var c2 = 0;
        while (j < m) {
            var v = bayan_json_v_arr_get(cmd, j);
            if (_cv_is_yaml_str(v) == 1) {
                if (c2 > 0) { str_builder_add_cstr(sb, ", "); }
                _cv_emit_toml_str(sb, bayan_json_v_str(v));
                c2 = c2 + 1;
            }
            j = j + 1;
        }
        str_builder_add_cstr(sb, "]\n");
        return 1;
    }
    return 0;
}

# `env = { K = "v", ... }`. Map form is SORTED (BTreeMap) and renders a
# non-string value via bayan_json_v_build — the exact analogue of the
# oracle's `v.to_string()` (verified: true→true, 8080→8080, 1.5→1.5,
# null→null, [1,2]→[1,2]). List form is DOCUMENT-ordered, keeps only
# JTAG_STR items containing '=', and splits at the FIRST '=' with no
# trimming; items without '=' are silently dropped (so bare `- FOO`
# host-inheritance is lost — oracle behavior). Both suppress an empty
# result. Named _compose_ because _cv_emit_env is the Dockerfile ENV step.
fn _cv_emit_compose_env(sb, env) {
    if (bayan_json_v_is_obj(env) == 1) {
        var n = bayan_json_v_obj_len(env);
        if (n == 0) { return 0; }
        var order = _cv_sorted_idx(env);
        str_builder_add_cstr(sb, "env = { ");
        var i = 0;
        while (i < n) {
            if (i > 0) { str_builder_add_cstr(sb, ", "); }
            var k = bayan_json_v_obj_key(env, vec_get(order, i));
            var v = bayan_json_v_obj_val(env, vec_get(order, i));
            _cv_emit_toml_key(sb, k);
            str_builder_add_cstr(sb, " = ");
            if (_cv_is_yaml_str(v) == 1) { _cv_emit_toml_str(sb, bayan_json_v_str(v)); }
            else { _cv_emit_toml_str(sb, _cv_value_to_string(v)); }
            i = i + 1;
        }
        str_builder_add_cstr(sb, " }\n");
        return 1;
    }
    if (bayan_json_v_is_arr(env) == 1) {
        var m = bayan_json_v_arr_len(env);
        var tmp = str_builder_new();
        var cnt = 0;
        var j = 0;
        while (j < m) {
            var item = bayan_json_v_arr_get(env, j);
            if (_cv_is_yaml_str(item) == 1) {
                var s = bayan_json_v_str(item);
                var p = str_data(s);
                var slen = str_len(s);
                var eq = 0 - 1;
                var q = 0;
                while (q < slen && eq < 0) {
                    if (load8(p + q) == 61) { eq = q; }
                    q = q + 1;
                }
                if (eq >= 0) {
                    if (cnt > 0) { str_builder_add_cstr(tmp, ", "); }
                    _cv_emit_toml_key(tmp, str_new(p, eq));
                    str_builder_add_cstr(tmp, " = ");
                    _cv_emit_toml_str(tmp, str_new(p + eq + 1, slen - eq - 1));
                    cnt = cnt + 1;
                }
            }
            j = j + 1;
        }
        if (cnt == 0) { return 0; }
        str_builder_add_cstr(sb, "env = { ");
        str_builder_add(sb, str_builder_build(tmp));
        str_builder_add_cstr(sb, " }\n");
        return 1;
    }
    return 0;
}

# `depends_on = [...]` — array form keeps JTAG_STR elements in document
# order; object form (the `condition:` long syntax) takes the SORTED keys
# and discards the conditions.
fn _cv_emit_compose_depends(sb, deps) {
    if (bayan_json_v_is_arr(deps) == 1) {
        return _cv_emit_str_arr(sb, "depends_on", deps, 0);
    }
    if (bayan_json_v_is_obj(deps) == 1) {
        var n = bayan_json_v_obj_len(deps);
        if (n == 0) { return 0; }
        var order = _cv_sorted_idx(deps);
        str_builder_add_cstr(sb, "depends_on = [");
        var i = 0;
        while (i < n) {
            if (i > 0) { str_builder_add_cstr(sb, ", "); }
            _cv_emit_toml_str(sb, bayan_json_v_obj_key(deps, vec_get(order, i)));
            i = i + 1;
        }
        str_builder_add_cstr(sb, "]\n");
        return 1;
    }
    return 0;
}

# `<key> = "<str>"\n` if `v` holds a JTAG_STR under `field`, else nothing.
# Mirrors the oracle's `.get(f).and_then(|v| v.as_str())` chains.
fn _cv_emit_compose_str_field(sb, v, field, key) {
    var f = bayan_json_v_obj_get(v, field);
    if (_cv_is_yaml_str(f) == 0) { return 0; }
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, " = ");
    _cv_emit_toml_str(sb, bayan_json_v_str(f));
    str_builder_add_cstr(sb, "\n");
    return 1;
}

# Convert a docker-compose YAML cstr to stiva compose TOML.
#
# Returns a heap cstr on success — possibly "" (empty input, a bare
# scalar, a top-level sequence, or a document carrying none of the three
# sections all yield Ok("") in the oracle) — or 0 on failure, with the
# detail available from compose_last_error(). Same contract as
# dockerfile_to_toml: 0 is the unambiguous error sentinel, because an
# empty builder still returns a non-zero pointer to "".
#[must_use]
fn compose_yaml_to_toml(yaml) {
    sakshi_info("converting docker-compose YAML to stiva TOML",
      strlen("converting docker-compose YAML to stiva TOML"));

    _cv_compose_err = 0;

    # bayan_yaml_parse_buf, NOT bayan_yaml_parse — the latter takes a
    # 16-byte Str, and handing it a cstr compiles with only an arity
    # warning before silently yielding a non-object.
    var doc = bayan_yaml_parse_buf(yaml, strlen(yaml));
    if (doc == 0) {
        var esb = str_builder_new();
        str_builder_add_cstr(esb, "invalid YAML: ");
        str_builder_add_cstr(esb, bayan_yaml_last_error());
        str_builder_add_cstr(esb, " (byte ");
        str_builder_add_int(esb, bayan_yaml_last_error_pos());
        str_builder_add_cstr(esb, ")");
        _cv_compose_err = str_cstr(str_builder_build(esb));
        return 0;
    }
    # One recursive pass over the WHOLE document rejects merge keys and
    # duplicate mapping keys before anything is emitted. Doing it here rather
    # than per-section is what makes the guard consistent with itself: the
    # same construct used to error at the root and pass silently inside an
    # `environment:` map.
    if (_cv_validate_doc(doc) == 1) { return 0; }

    var out = str_builder_new();

    # ── services ──
    var services = bayan_json_v_obj_get(doc, "services");
    if (bayan_json_v_is_obj(services) == 1) {
        var sn = bayan_json_v_obj_len(services);
        var sorder = _cv_sorted_idx(services);
        var si = 0;
        while (si < sn) {
            var sidx = vec_get(sorder, si);
            var svc = bayan_json_v_obj_val(services, sidx);
            # The header is written before any body type check, so a null
            # or scalar service body still yields a header + blank line.
            str_builder_add_cstr(out, "[services.");
            _cv_emit_toml_key(out, bayan_json_v_obj_key(services, sidx));
            str_builder_add_cstr(out, "]\n");

            _cv_emit_compose_str_field(out, svc, "image", "image");

            var cmd = bayan_json_v_obj_get(svc, "command");
            if (cmd != 0) { _cv_emit_compose_command(out, cmd); }

            var env = bayan_json_v_obj_get(svc, "environment");
            if (env != 0) { _cv_emit_compose_env(out, env); }

            var ports = bayan_json_v_obj_get(svc, "ports");
            if (bayan_json_v_is_arr(ports) == 1) {
                _cv_emit_str_arr(out, "ports", ports, 1);
            }

            var vols = bayan_json_v_obj_get(svc, "volumes");
            if (bayan_json_v_is_arr(vols) == 1) {
                _cv_emit_str_arr(out, "volumes", vols, 0);
            }

            var deps = bayan_json_v_obj_get(svc, "depends_on");
            if (deps != 0) { _cv_emit_compose_depends(out, deps); }

            _cv_emit_compose_str_field(out, svc, "restart", "restart");

            str_builder_add_cstr(out, "\n");
            si = si + 1;
        }
    }

    # ── top-level networks ──
    var networks = bayan_json_v_obj_get(doc, "networks");
    if (bayan_json_v_is_obj(networks) == 1) {
        var nn = bayan_json_v_obj_len(networks);
        var norder = _cv_sorted_idx(networks);
        var ni = 0;
        while (ni < nn) {
            var nidx = vec_get(norder, ni);
            var net = bayan_json_v_obj_val(networks, nidx);
            str_builder_add_cstr(out, "[networks.");
            _cv_emit_toml_key(out, bayan_json_v_obj_key(networks, nidx));
            str_builder_add_cstr(out, "]\n");

            _cv_emit_compose_str_field(out, net, "driver", "driver");

            # .ipam.config[0].subnet — index 0 only (Rust `.first()`).
            # Every bayan accessor is null- and tag-safe, so the chain
            # needs no guards beyond the two the oracle itself performs.
            var cfg = bayan_json_v_obj_get(bayan_json_v_obj_get(net, "ipam"), "config");
            if (bayan_json_v_is_arr(cfg) == 1) {
                if (bayan_json_v_arr_len(cfg) > 0) {
                    _cv_emit_compose_str_field(out,
                      bayan_json_v_arr_get(cfg, 0), "subnet", "subnet");
                }
            }
            str_builder_add_cstr(out, "\n");
            ni = ni + 1;
        }
    }

    # ── top-level volumes ──
    var volumes = bayan_json_v_obj_get(doc, "volumes");
    if (bayan_json_v_is_obj(volumes) == 1) {
        var vn = bayan_json_v_obj_len(volumes);
        var vorder = _cv_sorted_idx(volumes);
        var vi = 0;
        while (vi < vn) {
            var vidx = vec_get(vorder, vi);
            str_builder_add_cstr(out, "[volumes.");
            _cv_emit_toml_key(out, bayan_json_v_obj_key(volumes, vidx));
            str_builder_add_cstr(out, "]\n");
            _cv_emit_compose_str_field(out,
              bayan_json_v_obj_val(volumes, vidx), "driver", "driver");
            str_builder_add_cstr(out, "\n");
            vi = vi + 1;
        }
    }

    var built = str_builder_build(out);
    return str_cstr(built);
}

# --- network_mod.cyr ---

# stiva — container networking types (network mode, driver, policy, DNS registry).
# Ported from rust-old/src/network/mod.rs.
#
# rust-old/src/network/mod.rs is the module root: it declares the six
# submodules (bridge, dns, manager, nat, pool, rootless — each their own
# file, ported separately) and defines the leaf types shared across them:
#   NetworkMode, Network, NetworkDriver, ContainerNetwork,
#   NetworkPolicy (+ has_restrictions, to_nft_rules),
#   DnsRegistry (+ register, unregister, resolve, to_hosts_entries, inject_into).
# All of those are self-contained (only error.cyr + stdlib), so they port
# in full here.
#
# Memory model: structs are heap objects. Constructors `alloc()` the struct
# (8 bytes per field) and return the POINTER; callers bind it to a
# `: TypeName`-annotated local so dot-access resolves (per the Cyrius guide,
# pointer-to-struct dot-syntax needs the type annotation). This mirrors the
# kavach port's struct convention.
#
# IP addresses: Rust used std::net::Ipv4Addr / Ipv6Addr. In Cyrius we carry
# the canonical *display* form (a NUL-terminated cstr, e.g. "172.17.0.2"),
# which is exactly what the serde wire form and every consumer path used.
# The optional IPv6 (Option<Ipv6Addr>) maps to a cstr pointer or 0 (None).

# ── NetworkMode (rust-old: enum NetworkMode) ────────────────
# The tag values; Bridge/Host/None carry no payload, Container/Custom carry
# a String. Members prefixed NETWORK_MODE_* for global enum-member
# uniqueness (see error.cyr). Serde names below match derive(Serialize).
enum NetworkMode {
    NETWORK_MODE_BRIDGE = 0;
    NETWORK_MODE_HOST = 1;
    NETWORK_MODE_NONE = 2;
    NETWORK_MODE_CONTAINER = 3;
    NETWORK_MODE_CUSTOM = 4;
}

# A NetworkMode value: the tag plus (for Container/Custom) a payload cstr.
# For Bridge/Host/None `value` is 0.
struct NetworkModeVal {
    tag;
    value;
}

# Wrap a tag + optional payload cstr into a heap NetworkModeVal (pointer).
fn network_mode_new(tag, value) {
    var v: NetworkModeVal = alloc(16);
    v.tag = tag;
    v.value = value;
    return v;
}

# Serde external-tag name for a bare NetworkMode tag (derive default:
# unit variants serialize to their name "Bridge"/"Host"/"None"; the two
# payload variants serialize to {"Container": "<s>"} / {"Custom": "<s>"}).
# This returns the variant name string.
#[must_use]
fn network_mode_name(tag) {
    if (tag == NETWORK_MODE_BRIDGE) { return "Bridge"; }
    if (tag == NETWORK_MODE_HOST) { return "Host"; }
    if (tag == NETWORK_MODE_NONE) { return "None"; }
    if (tag == NETWORK_MODE_CONTAINER) { return "Container"; }
    if (tag == NETWORK_MODE_CUSTOM) { return "Custom"; }
    return "Bridge";
}

# 1 iff two NetworkModeVal (pointers) are equal (matches derive(PartialEq,
# Eq)): same tag, and for payload variants the same payload string.
#[must_use]
fn network_mode_eq(a, b) {
    var pa: NetworkModeVal = a;
    var pb: NetworkModeVal = b;
    if (pa.tag != pb.tag) { return 0; }
    if (pa.tag == NETWORK_MODE_CONTAINER || pa.tag == NETWORK_MODE_CUSTOM) {
        return streq(pa.value, pb.value);
    }
    return 1;
}

# ── NetworkDriver (rust-old: enum NetworkDriver) ───────────────
enum NetworkDriver {
    NETWORK_DRIVER_BRIDGE = 0;
    NETWORK_DRIVER_OVERLAY = 1;
    NETWORK_DRIVER_MACVLAN = 2;
}

# Serde name for a NetworkDriver (derive default: the variant name).
#[must_use]
fn network_driver_name(d) {
    if (d == NETWORK_DRIVER_BRIDGE) { return "Bridge"; }
    if (d == NETWORK_DRIVER_OVERLAY) { return "Overlay"; }
    if (d == NETWORK_DRIVER_MACVLAN) { return "Macvlan"; }
    return "Bridge";
}

# ── Network (rust-old: struct Network) ──────────────────
# name/subnet/gateway are cstrs; driver is a NetworkDriver tag.
struct Network {
    name;
    subnet;
    gateway;
    driver;
}

fn network_new(name, subnet, gateway, driver) {
    var n: Network = alloc(32);
    n.name = name;
    n.subnet = subnet;
    n.gateway = gateway;
    n.driver = driver;
    return n;
}

# ── ContainerNetwork (rust-old: struct ContainerNetwork) ─────────
# ip / network_name / host_veth / container_veth are cstrs; ipv6 is a cstr
# pointer or 0 for None (Option<Ipv6Addr>).
struct ContainerNetwork {
    ip;
    ipv6;
    network_name;
    host_veth;
    container_veth;
}

fn container_network_new(ip, ipv6, network_name, host_veth, container_veth) {
    var cn: ContainerNetwork = alloc(40);
    cn.ip = ip;
    cn.ipv6 = ipv6;
    cn.network_name = network_name;
    cn.host_veth = host_veth;
    cn.container_veth = container_veth;
    return cn;
}

# ── NetworkPolicy (rust-old: struct NetworkPolicy) ──────────────
# Each list field is a vec of cstrs (egress_ports is a vec of port ints).
# egress_rate_limit is a u64 (bytes/sec, 0 = unlimited).
struct NetworkPolicy {
    egress_allow;
    egress_deny;
    ingress_allow;
    ingress_deny;
    egress_ports;
    egress_rate_limit;
}

# Default NetworkPolicy — all empty vecs, rate limit 0 (rust-old: derive
# Default). Requires alloc_init() beforehand for the backing vecs.
fn network_policy_default() {
    var p: NetworkPolicy = alloc(48);
    p.egress_allow = vec_new();
    p.egress_deny = vec_new();
    p.ingress_allow = vec_new();
    p.ingress_deny = vec_new();
    p.egress_ports = vec_new();
    p.egress_rate_limit = 0;
    return p;
}

# True (1) iff any restriction is configured (rust-old: has_restrictions).
#[must_use]
fn network_policy_has_restrictions(pol) {
    var p: NetworkPolicy = pol;
    if (vec_len(p.egress_allow) > 0) { return 1; }
    if (vec_len(p.egress_deny) > 0) { return 1; }
    if (vec_len(p.ingress_allow) > 0) { return 1; }
    if (vec_len(p.ingress_deny) > 0) { return 1; }
    if (vec_len(p.egress_ports) > 0) { return 1; }
    if (p.egress_rate_limit > 0) { return 1; }
    return 0;
}

# Generate nftables rules for this policy (rust-old: to_nft_rules).
# Returns a vec of rule cstrs. Emits a drop rule per egress_deny CIDR, then
# a drop rule per ingress_deny CIDR — EXACT format strings preserved from
# the Rust format! literals. `container_ip` is a cstr.
#[must_use]
fn network_policy_to_nft_rules(pol, container_ip) {
    var p: NetworkPolicy = pol;
    var rules = vec_new();

    var n = vec_len(p.egress_deny);
    var i = 0;
    while (i < n) {
        var cidr = vec_get(p.egress_deny, i);
        # "add rule inet stiva-policy forward ip saddr {container_ip} ip daddr {cidr} drop"
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "add rule inet stiva-policy forward ip saddr ");
        str_builder_add_cstr(sb, container_ip);
        str_builder_add_cstr(sb, " ip daddr ");
        str_builder_add_cstr(sb, cidr);
        str_builder_add_cstr(sb, " drop");
        vec_push(rules, str_cstr(str_builder_build(sb)));
        i = i + 1;
    }

    var m = vec_len(p.ingress_deny);
    var j = 0;
    while (j < m) {
        var scidr = vec_get(p.ingress_deny, j);
        # "add rule inet stiva-policy forward ip saddr {cidr} ip daddr {container_ip} drop"
        var sb2 = str_builder_new();
        str_builder_add_cstr(sb2, "add rule inet stiva-policy forward ip saddr ");
        str_builder_add_cstr(sb2, scidr);
        str_builder_add_cstr(sb2, " ip daddr ");
        str_builder_add_cstr(sb2, container_ip);
        str_builder_add_cstr(sb2, " drop");
        vec_push(rules, str_cstr(str_builder_build(sb2)));
        j = j + 1;
    }

    return rules;
}

# ── DnsRegistry (rust-old: struct DnsRegistry) ────────────────
# name → IPv4 (cstr) mapping for intra-session service discovery.
struct DnsRegistry {
    entries;
}

# New empty registry (rust-old: derive Default). cstr-keyed map (map_new) —
# names are NUL-terminated cstrings, so the hash_str/streq (KeyTypeCstr)
# path is correct; map_new_str is only for Str fat-pointer keys and would
# mis-hash cstrings. Requires alloc_init() beforehand.
fn dns_registry_new() {
    var reg: DnsRegistry = alloc(8);
    reg.entries = map_new();
    return reg;
}

# Register a name→IP mapping (rust-old: register). `name` and `ip` are cstrs.
fn dns_registry_register(r, name, ip) {
    var reg: DnsRegistry = r;
    map_set(reg.entries, name, ip);
    return 0;
}

# Remove a mapping (rust-old: unregister).
fn dns_registry_unregister(r, name) {
    var reg: DnsRegistry = r;
    map_delete(reg.entries, name);
    return 0;
}

# Look up an IP by name (rust-old: resolve). Returns the IP cstr, or 0 for
# None (no such entry).
#[must_use]
fn dns_registry_resolve(r, name) {
    var reg: DnsRegistry = r;
    return map_get(reg.entries, name);
}

# Generate /etc/hosts content for all registered entries (rust-old:
# to_hosts_entries) — one "{ip}\t{name}\n" line per entry. Returns a heap
# cstr. HashMap iteration order is unspecified in both Rust and here.
#[must_use]
fn dns_registry_to_hosts_entries(r) {
    var reg: DnsRegistry = r;
    var sb = str_builder_new();
    var keys = map_keys(reg.entries);
    var n = vec_len(keys);
    var i = 0;
    while (i < n) {
        var name = vec_get(keys, i);
        var ip = map_get(reg.entries, name);
        str_builder_add_cstr(sb, ip);
        str_builder_putc(sb, 9);        # '\t'
        str_builder_add_cstr(sb, name);
        str_builder_putc(sb, 10);       # '\n'
        i = i + 1;
    }
    return str_cstr(str_builder_build(sb));
}

# Inject all entries into a container's /etc/hosts (rust-old: inject_into).
# `rootfs` is a directory cstr; writes <rootfs>/etc/hosts with localhost
# lines, the container's own {ip}\t{hostname}, then all registered service
# names. Returns STIVA_ERR_OK on success, or STIVA_ERR_IO on write failure
# (rust-old propagated std::io::Error via `?` → StivaError::Io).
fn dns_registry_inject_into(reg, rootfs, container_ip, hostname) {
    # Build "<rootfs>/etc" as a cstr (rootfs is a NUL-terminated cstr; we
    # join with a literal '/' the way std::path::Path::join does — the extra
    # slash on a "…/" rootfs is harmless to the kernel). path_join from
    # fs.cyr takes Str fat-pointers, so we concatenate cstrs directly here.
    var esb = str_builder_new();
    str_builder_add_cstr(esb, rootfs);
    str_builder_putc(esb, 47);      # '/'
    str_builder_add_cstr(esb, "etc");
    var etc = str_cstr(str_builder_build(esb));
    sys_mkdir(etc, 448);        # 0700; create_dir_all — rootfs already exists

    # Fixed prelude:
    #   "127.0.0.1\tlocalhost\n"
    #   "::1\t\tlocalhost\n"
    #   "{container_ip}\t{hostname}\n"
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "127.0.0.1\tlocalhost\n::1\t\tlocalhost\n");
    str_builder_add_cstr(sb, container_ip);
    str_builder_putc(sb, 9);        # '\t'
    str_builder_add_cstr(sb, hostname);
    str_builder_putc(sb, 10);       # '\n'

    # All registered service names (container-to-container DNS).
    var extra = dns_registry_to_hosts_entries(reg);
    str_builder_add_cstr(sb, extra);

    var content = str_cstr(str_builder_build(sb));

    # "<etc>/hosts"
    var hsb = str_builder_new();
    str_builder_add_cstr(hsb, etc);
    str_builder_putc(hsb, 47);      # '/'
    str_builder_add_cstr(hsb, "hosts");
    var hosts = str_cstr(str_builder_build(hsb));

    var rc = file_write_all(hosts, content, strlen(content));
    if (rc < 0) { return STIVA_ERR_IO; }
    return STIVA_ERR_OK;
}

# --- network_bridge.cyr ---

# stiva — Linux bridge + veth pair management via `ip` (iproute2)
# Ported from rust-old/src/network/bridge.rs.
#
# All operations shell out to `ip` / `sysctl` / `nsenter`, matching the Rust
# (which avoids a large netlink dependency, per agnos-sys). Each Rust fn
# returned `Result<(), StivaError::Network(String)>`; here we return an
# integer sentinel: 0 (STIVA_ERR_OK) on success, STIVA_ERR_NETWORK on
# failure. The Rust context strings (`format!("`ip {}` failed: ...")`) are
# elided from the return value — the caller carries detail via
# stiva_err_print(STIVA_ERR_NETWORK, detail), matching error.cyr's idiom.
#
# IPv4 addresses (`std::net::Ipv4Addr` in Rust) are represented here as a
# packed 32-bit i64 in host order: (a << 24) | (b << 16) | (c << 8) | d,
# i.e. a.b.c.d. `_ipv4_fmt` renders dotted-decimal for the `ip` argv. The
# real `Ipv4Addr`-carrying network types land with src/network.cyr (see the
# DEFERRED note); the packed-i64 convention is the port's local encoding.

# ── command-runner helpers ──────────────────────
# Absolute paths for the shelled-out tools (execve needs a resolved path;
# exec_vec does no $PATH lookup). iproute2 installs `ip` at /usr/bin/ip on
# modern distros (/sbin/ip on older ones); nsenter + sysctl at /usr/bin.
#[must_use]
fn _ip_bin() {
    if (file_exists("/usr/bin/ip") == 1) { return "/usr/bin/ip"; }
    if (file_exists("/sbin/ip") == 1) { return "/sbin/ip"; }
    if (file_exists("/bin/ip") == 1) { return "/bin/ip"; }
    return "ip";
}

#[must_use]
fn _sysctl_bin() {
    if (file_exists("/usr/sbin/sysctl") == 1) { return "/usr/sbin/sysctl"; }
    if (file_exists("/sbin/sysctl") == 1) { return "/sbin/sysctl"; }
    if (file_exists("/usr/bin/sysctl") == 1) { return "/usr/bin/sysctl"; }
    return "sysctl";
}

#[must_use]
fn _nsenter_bin() {
    if (file_exists("/usr/bin/nsenter") == 1) { return "/usr/bin/nsenter"; }
    if (file_exists("/bin/nsenter") == 1) { return "/bin/nsenter"; }
    return "nsenter";
}

# exec_vec (lib/process.cyr) returns the child's exit code directly, which
# is exactly the boolean success/fail these ops need (Rust checked
# `output.status.success()`). We discard stdout/stderr — iproute2 chatter on
# the happy path is uninteresting, and the argv vecs are small enough that a
# full pipe is not a concern. `_ip_last_rc` holds the most recent exit code
# for the runners to translate into the STIVA_ERR_* sentinel.
var _ip_last_rc = 0;

# ── `ip <args...>` — one runner per arity used below ─────────────
# Cyrius has no varargs; the Rust `ip(&["a","b",...])` calls each expand to
# a fixed argv here. Every argv element is a cstr (literal or built).
fn _ip3(a1, a2, a3) {
    var args = vec_new();
    vec_push(args, _ip_bin());
    vec_push(args, a1);
    vec_push(args, a2);
    vec_push(args, a3);
    _ip_last_rc = exec_vec(args);
    if (_ip_last_rc == 0) { return STIVA_ERR_OK; }
    return STIVA_ERR_NETWORK;
}

fn _ip4(a1, a2, a3, a4) {
    var args = vec_new();
    vec_push(args, _ip_bin());
    vec_push(args, a1);
    vec_push(args, a2);
    vec_push(args, a3);
    vec_push(args, a4);
    _ip_last_rc = exec_vec(args);
    if (_ip_last_rc == 0) { return STIVA_ERR_OK; }
    return STIVA_ERR_NETWORK;
}

fn _ip5(a1, a2, a3, a4, a5) {
    var args = vec_new();
    vec_push(args, _ip_bin());
    vec_push(args, a1);
    vec_push(args, a2);
    vec_push(args, a3);
    vec_push(args, a4);
    vec_push(args, a5);
    _ip_last_rc = exec_vec(args);
    if (_ip_last_rc == 0) { return STIVA_ERR_OK; }
    return STIVA_ERR_NETWORK;
}

# `ip link add <name> type veth peer name <peer>` — 8-element argv.
fn _ip_veth_add(host, peer) {
    var args = vec_new();
    vec_push(args, _ip_bin());
    vec_push(args, "link");
    vec_push(args, "add");
    vec_push(args, host);
    vec_push(args, "type");
    vec_push(args, "veth");
    vec_push(args, "peer");
    vec_push(args, "name");
    vec_push(args, peer);
    _ip_last_rc = exec_vec(args);
    if (_ip_last_rc == 0) { return STIVA_ERR_OK; }
    return STIVA_ERR_NETWORK;
}

# ── IPv4 formatting ─────────────────────────
# Append dotted-decimal `a.b.c.d` for a packed 32-bit host-order addr to a
# str_builder. Rust used `{gateway}` / `container_ip.to_string()`.
fn _ipv4_fmt(sb, addr) {
    var a = (addr / 16777216) % 256;
    var b = (addr / 65536) % 256;
    var c = (addr / 256) % 256;
    var d = addr % 256;
    str_builder_add_int(sb, a);
    str_builder_putc(sb, 46);
    str_builder_add_int(sb, b);
    str_builder_putc(sb, 46);
    str_builder_add_int(sb, c);
    str_builder_putc(sb, 46);
    str_builder_add_int(sb, d);
    return 0;
}

# Build a cstr "a.b.c.d/<prefix>" for `ip addr add`.
#[must_use]
fn _ipv4_cidr_cstr(addr, prefix_len) {
    var sb = str_builder_new();
    _ipv4_fmt(sb, addr);
    str_builder_putc(sb, 47);           # '/'
    str_builder_add_int(sb, prefix_len);
    var s = str_builder_build(sb);
    return str_cstr(s);
}

# Build a cstr "a.b.c.d" (bare address) for `ip route add ... via <gw>`.
#[must_use]
fn _ipv4_cstr(addr) {
    var sb = str_builder_new();
    _ipv4_fmt(sb, addr);
    var s = str_builder_build(sb);
    return str_cstr(s);
}

# Decimal cstr for an integer (pid) — for `ip link set <veth> netns <pid>`.
#[must_use]
fn _int_cstr(n) {
    var s = str_from_int(n);
    return str_cstr(s);
}

# ── sysctl ────────────────────────────
# `sysctl -w <key>=<value>`. Returns STIVA_ERR_OK / STIVA_ERR_NETWORK.
fn _sysctl(key, value) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, key);
    str_builder_putc(sb, 61);           # '='
    str_builder_add_cstr(sb, value);
    var kv = str_cstr(str_builder_build(sb));

    var args = vec_new();
    vec_push(args, _sysctl_bin());
    vec_push(args, "-w");
    vec_push(args, kv);
    _ip_last_rc = exec_vec(args);
    if (_ip_last_rc == 0) { return STIVA_ERR_OK; }
    return STIVA_ERR_NETWORK;
}

# ── public surface ─────────────────────────

# Enable IPv4 forwarding (needed for NAT). rust-old: enable_ip_forward.
fn enable_ip_forward() {
    return _sysctl("net.ipv4.ip_forward", "1");
}

# Create a Linux bridge interface with an IP address. rust-old: create_bridge.
# `gateway` is a packed IPv4 (see header). Returns STIVA_ERR_OK on success,
# else the first failing step's STIVA_ERR_NETWORK (Rust `?`-early-return).
fn create_bridge(name, gateway, prefix_len) {
    # ip link add <name> type bridge
    var r1 = _ip5("link", "add", name, "type", "bridge");
    if (r1 != STIVA_ERR_OK) { return r1; }

    # ip addr add <gateway>/<prefix_len> dev <name>
    var cidr = _ipv4_cidr_cstr(gateway, prefix_len);
    var r2 = _ip5("addr", "add", cidr, "dev", name);
    if (r2 != STIVA_ERR_OK) { return r2; }

    # ip link set <name> up
    var r3 = _ip4("link", "set", name, "up");
    if (r3 != STIVA_ERR_OK) { return r3; }

    # Enable IP forwarding for NAT.
    return enable_ip_forward();
}

# Delete a bridge interface. rust-old: delete_bridge.
# ip link set <name> down ; ip link delete <name> type bridge
fn delete_bridge(name) {
    var r1 = _ip4("link", "set", name, "down");
    if (r1 != STIVA_ERR_OK) { return r1; }
    return _ip5("link", "delete", name, "type", "bridge");
}

# Container-veth end name is always "eth0" (rust-old constant).
#[must_use]
fn container_veth_name() {
    return "eth0";
}

# Build the host-side veth name: "ve-" + first up-to-12 chars of the
# container id. Linux IFNAMSIZ = 16 (incl NUL) ⇒ max 15 chars; "ve-"(3) +
# 12 = 15. rust-old: create_veth_pair's `host_veth`. Returns a cstr.
#[must_use]
fn host_veth_name(container_id) {
    var n = strlen(container_id);
    var take = n;
    if (take > 12) { take = 12; }
    var out = alloc(3 + take + 1);
    store8(out + 0, 118);               # 'v'
    store8(out + 1, 101);               # 'e'
    store8(out + 2, 45);                # '-'
    memcpy(out + 3, container_id, take);
    store8(out + 3 + take, 0);
    return out;
}

# Create a veth pair for a container. rust-old: create_veth_pair.
# Returns the host-veth cstr on success (peer is always "eth0", available
# via container_veth_name()), or 0 on failure. The Rust returned the
# `(host_veth, container_veth)` tuple; here the caller reconstructs the
# pair from host_veth_name(id) / container_veth_name().
#[must_use]
fn create_veth_pair(container_id) {
    var host = host_veth_name(container_id);
    var peer = container_veth_name();
    # ip link add <host> type veth peer name <peer>
    var r = _ip_veth_add(host, peer);
    if (r != STIVA_ERR_OK) { return 0; }
    return host;
}

# Attach a veth interface to a bridge. rust-old: attach_to_bridge.
# ip link set <veth> master <bridge> ; ip link set <veth> up
fn attach_to_bridge(veth, bridge) {
    var r1 = _ip5("link", "set", veth, "master", bridge);
    if (r1 != STIVA_ERR_OK) { return r1; }
    return _ip4("link", "set", veth, "up");
}

# Move a veth interface into a network namespace (by PID).
# rust-old: move_to_netns. ip link set <veth> netns <pid>
fn move_to_netns(veth, pid) {
    var pid_str = _int_cstr(pid);
    return _ip5("link", "set", veth, "netns", pid_str);
}

# Delete a veth pair (deleting one end removes the other). rust-old:
# delete_veth. Errors are intentionally ignored ("if already gone, ignore")
# — always returns STIVA_ERR_OK, matching Rust's `let _ = ip(...); Ok(())`.
fn delete_veth(host_veth) {
    var _r = _ip3("link", "delete", host_veth);
    return STIVA_ERR_OK;
}

# ── nsenter-based in-namespace config ───────────────────
# `nsenter -t <pid> -n -- ip <args...>`. One runner per arity used.
fn _nsenter_ip4(pid_str, a1, a2, a3, a4) {
    var args = vec_new();
    vec_push(args, _nsenter_bin());
    vec_push(args, "-t");
    vec_push(args, pid_str);
    vec_push(args, "-n");
    vec_push(args, "--");
    vec_push(args, _ip_bin());
    vec_push(args, a1);
    vec_push(args, a2);
    vec_push(args, a3);
    vec_push(args, a4);
    _ip_last_rc = exec_vec(args);
    if (_ip_last_rc == 0) { return STIVA_ERR_OK; }
    return STIVA_ERR_NETWORK;
}

fn _nsenter_ip5(pid_str, a1, a2, a3, a4, a5) {
    var args = vec_new();
    vec_push(args, _nsenter_bin());
    vec_push(args, "-t");
    vec_push(args, pid_str);
    vec_push(args, "-n");
    vec_push(args, "--");
    vec_push(args, _ip_bin());
    vec_push(args, a1);
    vec_push(args, a2);
    vec_push(args, a3);
    vec_push(args, a4);
    vec_push(args, a5);
    _ip_last_rc = exec_vec(args);
    if (_ip_last_rc == 0) { return STIVA_ERR_OK; }
    return STIVA_ERR_NETWORK;
}

# Configure an interface inside a network namespace (by PID) using nsenter.
# rust-old: configure_container_iface. `container_ip` / `gateway` are packed
# IPv4. Returns STIVA_ERR_OK, else the first failing step's STIVA_ERR_NETWORK.
fn configure_container_iface(pid, iface, container_ip, prefix_len, gateway) {
    var pid_str = _int_cstr(pid);

    # nsenter ... ip addr add <container_ip>/<prefix_len> dev <iface>
    var cidr = _ipv4_cidr_cstr(container_ip, prefix_len);
    var r1 = _nsenter_ip5(pid_str, "addr", "add", cidr, "dev", iface);
    if (r1 != STIVA_ERR_OK) { return r1; }

    # nsenter ... ip link set <iface> up
    var r2 = _nsenter_ip4(pid_str, "link", "set", iface, "up");
    if (r2 != STIVA_ERR_OK) { return r2; }

    # nsenter ... ip link set lo up
    var r3 = _nsenter_ip4(pid_str, "link", "set", "lo", "up");
    if (r3 != STIVA_ERR_OK) { return r3; }

    # nsenter ... ip route add default via <gateway>
    var gw = _ipv4_cstr(gateway);
    var r4 = _nsenter_ip5(pid_str, "route", "add", "default", "via", gw);
    if (r4 != STIVA_ERR_OK) { return r4; }

    return STIVA_ERR_OK;
}

# ── DEFERRED (land with src/network.cyr) ──────────────────
# rust-old/src/network/bridge.rs is otherwise fully ported above. The
# private Rust helpers `ip(&[&str])` and `sysctl(key, value)` are inlined
# into the per-arity runners here (Cyrius has no varargs / closures), so
# there is no standalone `ip`/`sysctl`/`nsenter` public symbol to port.
#
# The real `std::net::Ipv4Addr` type used by callers lives in
# rust-old/src/network/mod.rs and lands with src/network.cyr; this module
# encodes an address as a packed 32-bit host-order i64 (a.b.c.d) in the
# meantime. When network.cyr lands, callers pass that same packed encoding
# (or network.cyr adds an Ipv4 struct + a `_ipv4_pack` bridge helper).

# --- network_dns.cyr ---

# stiva — container DNS config: resolv.conf / hosts / hostname injection
# Ported from rust-old/src/network/dns.rs.
#
# Rust modeled DNS servers as Vec<Ipv4Addr>; Cyrius has no Ipv4Addr type, so a
# parsed IPv4 is carried as a packed u32 (a.b.c.d -> (a<<24)|(b<<16)|(c<<8)|d).
# network_dns_ipv4_invalid() (-1) is the "not a valid IPv4" sentinel — the parse
# helpers reject anything that is not exactly four 0..255 dotted decimal octets,
# which is precisely what Rust's `str::parse::<Ipv4Addr>()` accepts here (and it
# is why the resolv.conf tests skip an "::1" IPv6 line). Packed u32 preserves
# the parity the tests check: `servers[0] == "8.8.8.8".parse()` becomes an
# integer equality on the packed value, and `network_dns_ipv4_to_str` renders
# the canonical dotted-quad Rust's Display produces for `format!("nameserver {s}")`.
#
# The Rust functions return Result<(), StivaError> mapping fs errors via `?`;
# here the fallible inject_* return an integer sentinel: 0 on success, or the
# STIVA_ERR_IO code (from error.cyr) on a filesystem failure. Callers carry the
# path context via stiva_err_print(STIVA_ERR_IO, detail).

# Sentinel: a string that did not parse as a dotted-quad IPv4 (rust: parse err).
# (Enum members must be integer literals in Cyrius, and -1 is not a literal, so
# the invalid-IPv4 marker is a helper fn rather than an enum member.)
#[must_use]
fn network_dns_ipv4_invalid() {
    return 0 - 1;
}

# Default DNS servers if the host resolv.conf is unavailable
# (rust-old: const DEFAULT_DNS = ["8.8.8.8", "8.8.4.4"]).
# 8.8.8.8 = 0x08080808 ; 8.8.4.4 = 0x08080404.
#[must_use]
fn network_dns_default_primary() {
    return 0x08080808;
}

#[must_use]
fn network_dns_default_secondary() {
    return 0x08080404;
}

# ── IPv4 packing / parsing / formatting ──────────────────

# Parse one 0..255 decimal octet starting at cstr `s`+`off`, stopping at a
# '.' (46) or NUL. Returns two values: the octet value (0..255) and the number
# of characters consumed, or (network_dns_ipv4_invalid(), 0) if the run of digits
# is empty, non-numeric, has a leading-zero longer form, or exceeds 255.
# (Rust's Ipv4Addr::from_str rejects empty octets, non-digits, >255, and — for
# the std parser — multi-digit octets with a leading zero.)
fn _network_dns_parse_octet(s, off) {
    var i = 0;
    var val = 0;
    var digits = 0;
    var lead_zero = 0;
    var go = 1;
    while (go == 1) {
        var c = load8(s + off + i);
        if (c == 46 || c == 0) { go = 0; }
        else {
            if (c < 48 || c > 57) { return (network_dns_ipv4_invalid(), 0); }
            if (digits == 0 && c == 48) { lead_zero = 1; }
            val = val * 10 + (c - 48);
            digits = digits + 1;
            if (val > 255) { return (network_dns_ipv4_invalid(), 0); }
            i = i + 1;
        }
    }
    if (digits == 0) { return (network_dns_ipv4_invalid(), 0); }
    # Reject "01", "007" etc. — leading zero with more than one digit.
    if (lead_zero == 1 && digits > 1) { return (network_dns_ipv4_invalid(), 0); }
    return (val, i);
}

# Parse a NUL-terminated dotted-quad IPv4 cstr into a packed u32, or
# network_dns_ipv4_invalid() if it is not exactly four valid octets separated by
# three dots with nothing trailing (rust: `parse::<Ipv4Addr>().ok()`).
#[must_use]
fn network_dns_parse_ipv4(s) {
    var pos = 0;
    var packed = 0;
    var k = 0;
    while (k < 3) {
        var v, l = _network_dns_parse_octet(s, pos);
        if (v == network_dns_ipv4_invalid()) { return network_dns_ipv4_invalid(); }
        packed = (packed << 8) | v;
        pos = pos + l;
        # Must sit on a '.' separator now.
        if (load8(s + pos) != 46) { return network_dns_ipv4_invalid(); }
        pos = pos + 1;
        k = k + 1;
    }
    var v4, l4 = _network_dns_parse_octet(s, pos);
    if (v4 == network_dns_ipv4_invalid()) { return network_dns_ipv4_invalid(); }
    packed = (packed << 8) | v4;
    pos = pos + l4;
    # Nothing may trail the last octet.
    if (load8(s + pos) != 0) { return network_dns_ipv4_invalid(); }
    return packed;
}

# Render a packed IPv4 u32 as its canonical dotted-quad Str
# (matches Rust's Ipv4Addr Display used in `format!("nameserver {s}")`).
#[must_use]
fn network_dns_ipv4_to_str(packed) {
    var a = (packed >> 24) & 255;
    var b = (packed >> 16) & 255;
    var c = (packed >> 8) & 255;
    var d = packed & 255;
    var sb = str_builder_new();
    str_builder_add_int(sb, a);
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, b);
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, c);
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, d);
    return str_builder_build(sb);
}

# ── resolv.conf parsing ───────────────────────

# In-place ASCII whitespace trim of the cstr region [start, end) of buffer
# `buf` (space/tab/CR/LF). Returns two values: the new start offset and new end
# offset (both relative to buf). Mirrors Rust's str::trim (we only strip ASCII
# whitespace, which is all resolv.conf carries).
fn _network_dns_trim_bounds(buf, start, end) {
    var s = start;
    var e = end;
    while (s < e) {
        var c2 = load8(buf + s);
        if (c2 == 32 || c2 == 9 || c2 == 13 || c2 == 10) { s = s + 1; }
        else { break; }
    }
    while (e > s) {
        var c3 = load8(buf + e - 1);
        if (c3 == 32 || c3 == 9 || c3 == 13 || c3 == 10) { e = e - 1; }
        else { break; }
    }
    return (s, e);
}

# Copy the cstr region [start, end) of `buf` into a fresh NUL-terminated
# heap buffer and return its address.
fn _network_dns_slice_cstr(buf, start, end) {
    var n = end - start;
    if (n < 0) { n = 0; }
    var out = alloc(n + 1);
    memcpy(out, buf + start, n);
    store8(out + n, 0);
    return out;
}

# Parse nameserver entries from a NUL-terminated resolv.conf `content` cstr.
# Returns a vec of packed IPv4 u32 (rust-old: parse_resolv_conf -> Vec<Ipv4Addr>).
# For each line: trim, and if it begins with "nameserver", trim the remainder
# and parse as IPv4 — pushing only successfully-parsed (IPv4) addresses, so
# IPv6 / malformed nameserver lines and all non-nameserver lines are skipped.
#[must_use]
fn network_dns_parse_resolv_conf(content) {
    var out = vec_new();
    var total = strlen(content);
    var line_start = 0;
    var i = 0;
    var go = 1;
    while (go == 1) {
        var c = load8(content + i);
        if (c == 10 || c == 0) {
            # Line is [line_start, i).
            var ls, le = _network_dns_trim_bounds(content, line_start, i);
            var pref = "nameserver";
            var pref_len = 10;
            var has_pref = 0;
            if (le - ls >= pref_len) {
                has_pref = memeq(content + ls, pref, pref_len);
            }
            if (has_pref == 1) {
                # Remainder after "nameserver", then trimmed.
                var rs, re = _network_dns_trim_bounds(content, ls + pref_len, le);
                var ipcstr = _network_dns_slice_cstr(content, rs, re);
                var packed = network_dns_parse_ipv4(ipcstr);
                if (packed != network_dns_ipv4_invalid()) {
                    vec_push(out, packed);
                }
            }
            if (c == 0) { go = 0; }
            else { line_start = i + 1; }
        }
        i = i + 1;
    }
    return out;
}

# Read DNS servers from the host's /etc/resolv.conf, falling back to the two
# DEFAULT_DNS servers (rust-old: host_dns_servers -> Vec<Ipv4Addr>).
# Returns a vec of packed IPv4 u32 — ALWAYS non-empty.
#
# DIVERGENCE, and the reason it is one: the oracle
# (rust-old/src/network/dns.rs:13-18) falls back only when the READ fails. A
# resolv.conf that reads fine but yields no IPv4 nameserver — an IPv6-only host,
# a file with only `search`/`options` lines, an empty file — parses to an EMPTY
# vec, so the "always non-empty" contract this function's callers rely on is
# broken on exactly those hosts.
#
# That is not hypothetical here: the oracle's own test
# (`host_dns_servers_returns_something`) asserts non-empty, and this port mirrors
# it. On a host without an IPv4 nameserver that test FAILS — a latent CI flake
# that passes everywhere an IPv4 resolver happens to be configured. Falling back
# on an empty PARSE as well as a failed read makes the contract, the test, and
# the callers agree.
#
# `network_dns_inject_resolv_conf` re-defaults on empty too, so a container never
# got a nameserver-less resolv.conf; the hole was in the contract, and in any
# caller (like network_manager) that passes the vec somewhere else first.
#[must_use]
fn network_dns_host_servers() {
    var cap = 65536;
    var buf = alloc(cap);
    var n = file_read_all("/etc/resolv.conf", buf, cap - 1);
    if (n >= 0) {
        store8(buf + n, 0);
        var parsed = network_dns_parse_resolv_conf(buf);
        if (vec_len(parsed) > 0) { return parsed; }
    }
    var out = vec_new();
    vec_push(out, network_dns_default_primary());
    vec_push(out, network_dns_default_secondary());
    return out;
}

# ── injection into the container rootfs ──────────────────

# mkdir "<rootfs>/etc" (create_dir_all analogue for the single "etc" level;
# the parent rootfs is created by the caller). Returns the freshly-built
# "<rootfs>/etc" Str; EEXIST is ignored (idempotent, matching create_dir_all).
fn _network_dns_ensure_etc(rootfs) {
    # rootfs is a raw cstr; path_join operates on Str fat pointers, so lift it.
    var etc = path_join(str_from(rootfs), str_from("etc"));
    # 0o755 = 0x1ED. sys_mkdir ignores an already-existing dir (EEXIST).
    sys_mkdir(str_cstr(etc), 0x1ED);
    return etc;
}

# Write /etc/resolv.conf into the container rootfs (rust-old: inject_resolv_conf).
# `dns_servers` is a vec of packed IPv4 u32; when empty, the DEFAULT_DNS servers
# are used. Content is "nameserver <ip>\n" per server. `rootfs` is a cstr path.
# Returns 0 on success, or STIVA_ERR_IO on a filesystem failure.
fn network_dns_inject_resolv_conf(rootfs, dns_servers) {
    var etc = _network_dns_ensure_etc(rootfs);

    # Choose the effective server list.
    var servers = dns_servers;
    if (vec_len(dns_servers) == 0) {
        servers = vec_new();
        vec_push(servers, network_dns_default_primary());
        vec_push(servers, network_dns_default_secondary());
    }

    # Build "nameserver a.b.c.d\n" for each, joined (trailing "\n").
    var sb = str_builder_new();
    var count = vec_len(servers);
    var i = 0;
    while (i < count) {
        str_builder_add_cstr(sb, "nameserver ");
        str_builder_add(sb, network_dns_ipv4_to_str(vec_get(servers, i)));
        str_builder_add_cstr(sb, "\n");
        i = i + 1;
    }
    var content = str_builder_build(sb);

    var path = path_join(etc, str_from("resolv.conf"));
    var w = file_write_all(str_cstr(path), str_data(content), str_len(content));
    if (w < 0) { return STIVA_ERR_IO; }
    return 0;
}

# Write /etc/hosts into the container rootfs (rust-old: inject_hosts).
# `container_ip` is a packed IPv4 u32; `hostname` is a cstr. Format matches Rust
# exactly: localhost v4/v6 lines then "<ip>\t<hostname>\n". `rootfs` is a cstr.
# Returns 0 on success, or STIVA_ERR_IO on a filesystem failure.
fn network_dns_inject_hosts(rootfs, container_ip, hostname) {
    var etc = _network_dns_ensure_etc(rootfs);

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "127.0.0.1\tlocalhost\n");
    str_builder_add_cstr(sb, "::1\t\tlocalhost\n");
    str_builder_add(sb, network_dns_ipv4_to_str(container_ip));
    str_builder_add_cstr(sb, "\t");
    str_builder_add_cstr(sb, hostname);
    str_builder_add_cstr(sb, "\n");
    var content = str_builder_build(sb);

    var path = path_join(etc, str_from("hosts"));
    var w = file_write_all(str_cstr(path), str_data(content), str_len(content));
    if (w < 0) { return STIVA_ERR_IO; }
    return 0;
}

# Write /etc/hostname into the container rootfs (rust-old: inject_hostname).
# Content is "<hostname>\n". `rootfs` and `hostname` are cstrs.
# Returns 0 on success, or STIVA_ERR_IO on a filesystem failure.
fn network_dns_inject_hostname(rootfs, hostname) {
    var etc = _network_dns_ensure_etc(rootfs);

    var sb = str_builder_new();
    str_builder_add_cstr(sb, hostname);
    str_builder_add_cstr(sb, "\n");
    var content = str_builder_build(sb);

    var path = path_join(etc, str_from("hostname"));
    var w = file_write_all(str_cstr(path), str_data(content), str_len(content));
    if (w < 0) { return STIVA_ERR_IO; }
    return 0;
}

# --- network_pool.cyr ---

# stiva — IP address pool: allocate and release IPs within a subnet.
# Ported from rust-old/src/network/pool.rs.
#
# Three public types:
#   IpPool        — IPv4 pool over a CIDR subnet (HashSet of allocated addrs)
#   Ipv6Pool      — IPv6 pool over a CIDR subnet
#   DualStackPool — { v4: IpPool, v6: Option<Ipv6Pool> }
#
# i64-everywhere representation:
#   * IPv4 addresses are the 32-bit host value carried in an i64 (0 .. 2^32-1).
#   * IPv6 addresses are 16-byte big-endian buffers on the heap; an address is
#     an i64 pointer to that buffer. u128 does not fit i64, so byte buffers +
#     memeq/byte-increment stand in for u128 compare/add.
#   * The `allocated` HashSet is a `vec` of addresses (i64 host value for v4,
#     i64 buffer pointer for v6) with linear membership scan — same
#     contains/insert/remove semantics the Rust HashSet provided.
#
# Error mapping (mirrors error.cyr): every Rust `Err(StivaError::Network(...))`
# maps to the integer sentinel `0` returned from a constructor / a negative
# sentinel from an allocator; the caller reports it via
# stiva_err_print(STIVA_ERR_NETWORK, detail). Constructors return a heap
# pointer to the pool struct on success, or 0 on failure.
#
# `alloc_init()` must have been called once before any pool is created.

# ── IPv4 struct layout ────────────────────────
# base       : network-aligned base address (u32 host value)
# prefix_len : subnet prefix length
# gateway    : first usable address (base + 1)
# allocated  : vec of allocated u32 host values
# next       : next candidate for allocation
struct IpPool {
    base;
    prefix_len;
    gateway;
    allocated;
    next;
}

# ── IPv6 struct layout ────────────────────────
# base       : ptr to 16-byte network-aligned base (big-endian)
# prefix_len : subnet prefix length
# gateway    : ptr to 16-byte gateway (base + 1)
# allocated  : vec of ptrs to 16-byte allocated addresses
# next       : ptr to 16-byte next candidate
struct Ipv6Pool {
    base;
    prefix_len;
    gateway;
    allocated;
    next;
}

# ── DualStack struct layout ──────────────────────
# v4 : ptr to IpPool (always present)
# v6 : ptr to Ipv6Pool, or 0 when v4-only
struct DualStackPool {
    v4;
    v6;
}

# ── IPv4 address parse / format ─────────────────────

# Parse a single decimal octet [start,end) of cstr `s`. Returns the value
# (0..255) via store at `out`, and 1 on success / 0 on invalid (empty,
# non-digit, or >255). Rust's Ipv4Addr parse rejects these.
#[must_use]
fn _np_parse_octet(s, start, end, out) {
    if (end <= start) { return 0; }
    # Rust Ipv4Addr::from_str rejects an octet with a leading zero ("010",
    # "00", "172.017.0.0") — only a bare "0" is a valid zero octet.
    if (end - start > 1 && load8(s + start) == 48) { return 0; }
    var val = 0;
    var i = start;
    while (i < end) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { return 0; }
        val = val * 10 + (c - 48);
        if (val > 255) { return 0; }
        i = i + 1;
    }
    store64(out, val);
    return 1;
}

# Parse a dotted-quad IPv4 address cstr into its u32 host value. Returns 1
# on success (value stored at `out`), 0 on invalid (wrong dot count, bad
# octet). Mirrors Rust `addr_str.parse::<Ipv4Addr>()`.
#[must_use]
fn _np_parse_ipv4(s, out) {
    var len = strlen(s);
    if (len == 0) { return 0; }
    var octets = 0;
    var seg_start = 0;
    var cell = alloc(8);
    var value = 0;
    var i = 0;
    while (i <= len) {
        var c = 0;
        if (i < len) { c = load8(s + i); }
        if (i == len || c == 46) {   # '.' or end
            if (_np_parse_octet(s, seg_start, i, cell) == 0) { return 0; }
            var oct = load64(cell);
            value = value * 256 + oct;
            octets = octets + 1;
            seg_start = i + 1;
        }
        i = i + 1;
    }
    if (octets != 4) { return 0; }
    store64(out, value);
    return 1;
}

# Format a u32 host value into a fresh dotted-quad cstr. Mirrors Rust
# `Ipv4Addr::from(v)` Display.
#[must_use]
fn _np_fmt_ipv4(v) {
    var sb = str_builder_new();
    var b0 = (v / 16777216) % 256;
    var b1 = (v / 65536) % 256;
    var b2 = (v / 256) % 256;
    var b3 = v % 256;
    str_builder_add_int(sb, b0);
    str_builder_putc(sb, 46);
    str_builder_add_int(sb, b1);
    str_builder_putc(sb, 46);
    str_builder_add_int(sb, b2);
    str_builder_putc(sb, 46);
    str_builder_add_int(sb, b3);
    var s = str_builder_build(sb);
    return str_cstr(s);
}

# Parse a decimal prefix-length cstr into its value. Returns 1 on success
# (value stored at `out`), 0 on invalid (empty / non-digit).
#[must_use]
fn _np_parse_prefix(s, out) {
    var len = strlen(s);
    if (len == 0) { return 0; }
    var val = 0;
    var i = 0;
    while (i < len) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { return 0; }
        val = val * 10 + (c - 48);
        i = i + 1;
    }
    store64(out, val);
    return 1;
}

# Find the byte index of the first '/' in `s`, or -1 if absent. Mirrors
# Rust `str::split_once('/')`.
#[must_use]
fn _np_find_slash(s) {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (load8(s + i) == 47) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ── IpPool (IPv4) ─────────────────────────

# Create a new IPv4 pool for a CIDR subnet (e.g. "172.17.0.0/16").
# Returns a heap IpPool pointer on success, or 0 on any parse/validation
# error (Rust: Err(StivaError::Network(...))). The gateway is the first
# usable address (.1); allocation starts from .2.
#[must_use]
fn ip_pool_new(subnet) {
    var slash = _np_find_slash(subnet);
    if (slash < 0) { return 0; }                 # invalid subnet CIDR

    # addr_str = subnet[0..slash] ; prefix_str = subnet[slash+1..]
    var addr_str = alloc(slash + 1);
    memcpy(addr_str, subnet, slash);
    store8(addr_str + slash, 0);

    var addr_cell = alloc(8);
    if (_np_parse_ipv4(addr_str, addr_cell) == 0) { return 0; }  # invalid addr
    var addr = load64(addr_cell);

    var prefix_str = subnet + slash + 1;
    var pfx_cell = alloc(8);
    if (_np_parse_prefix(prefix_str, pfx_cell) == 0) { return 0; }  # invalid prefix
    var prefix_len = load64(pfx_cell);

    if (prefix_len > 30) { return 0; }           # prefix too small for a pool

    # mask = prefix_len == 0 ? 0 : !((1 << (32 - prefix_len)) - 1)
    var mask = 0;
    if (prefix_len == 0) {
        mask = 0;
    } else {
        var host_bits = 32 - prefix_len;
        var span = 1 << host_bits;
        # 32-bit complement of (span - 1): keep low 32 bits.
        mask = (~(span - 1)) & 4294967295;
    }
    var base = addr & mask;                       # network-aligned

    var pool = alloc(40);
    var p: IpPool = pool;
    p.base = base;
    p.prefix_len = prefix_len;
    p.gateway = base + 1;
    p.allocated = vec_new();
    p.next = base + 2;                           # start allocation from .2
    return pool;
}

# Gateway address (u32 host value) for this pool.
#[must_use]
fn ip_pool_gateway(pool) {
    var p: IpPool = pool;
    return p.gateway;
}

# Subnet prefix length.
#[must_use]
fn ip_pool_prefix_len(pool) {
    var p: IpPool = pool;
    return p.prefix_len;
}

# Subnet string in CIDR notation ("base/prefix"). Fresh heap cstr.
#[must_use]
fn ip_pool_subnet(pool) {
    var p: IpPool = pool;
    var addr = _np_fmt_ipv4(p.base);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, addr);
    str_builder_putc(sb, 47);
    str_builder_add_int(sb, p.prefix_len);
    var s = str_builder_build(sb);
    return str_cstr(s);
}

# Number of allocated addresses.
#[must_use]
fn ip_pool_allocated_count(pool) {
    var p: IpPool = pool;
    return vec_len(p.allocated);
}

# Maximum allocatable addresses (total minus network + gateway + broadcast).
#[must_use]
fn _ip_pool_max_hosts(pool) {
    var p: IpPool = pool;
    var total = 1 << (32 - p.prefix_len);
    if (total < 3) { return 0; }                 # saturating_sub(3)
    return total - 3;
}

# Broadcast address (u32 host value).
#[must_use]
fn _ip_pool_broadcast(pool) {
    var p: IpPool = pool;
    return p.base + (1 << (32 - p.prefix_len)) - 1;
}

# True (1) iff u32 host value `ip` is in the pool's allocated set.
#[must_use]
fn _ip_pool_contains(pool, ip) {
    var p: IpPool = pool;
    var set = p.allocated;
    var n = vec_len(set);
    var i = 0;
    while (i < n) {
        if (vec_get(set, i) == ip) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Allocate the next available IPv4 address. Returns the u32 host value on
# success, or -1 on exhaustion (Rust: Err(StivaError::Network(...));
# caller maps -1 → STIVA_ERR_NETWORK).
#[must_use]
fn ip_pool_allocate(pool) {
    var p: IpPool = pool;
    if (vec_len(p.allocated) >= _ip_pool_max_hosts(pool)) {
        return 0 - 1;                            # IP pool exhausted for subnet
    }

    var broadcast = _ip_pool_broadcast(pool);
    var start = p.next;

    while (1) {
        if (p.next >= broadcast) {
            p.next = p.base + 2;                 # wrap around
        }

        var candidate = p.next;
        p.next = p.next + 1;

        # Skip gateway and already-allocated.
        if (candidate == p.gateway || _ip_pool_contains(pool, candidate) == 1) {
            if (p.next == start) { return 0 - 1; }   # wrapped to start → full
            continue;
        }

        vec_push(p.allocated, candidate);
        return candidate;
    }
    return 0 - 1;
}

# Release an IPv4 address (u32 host value) back to the pool. Returns 1 iff
# the address was present (Rust HashSet::remove bool).
#[must_use]
fn ip_pool_release(pool, ip) {
    var p: IpPool = pool;
    var set = p.allocated;
    var idx = vec_find(set, ip);
    if (idx < 0) { return 0; }
    vec_remove(set, idx);
    return 1;
}

# ── IPv6 address parse / format ─────────────────────

# Parse a hex nibble byte `c`, returning 0..15, or -1 if not a hex digit.
#[must_use]
fn _np_hex_nibble(c) {
    if (c >= 48 && c <= 57) { return c - 48; }        # 0-9
    if (c >= 97 && c <= 102) { return c - 97 + 10; }  # a-f
    if (c >= 65 && c <= 70) { return c - 65 + 10; }   # A-F
    return 0 - 1;
}

# Parse an IPv6 address cstr into a fresh 16-byte big-endian buffer.
# Supports the "::" zero-compression form. Returns the buffer pointer on
# success, or 0 on invalid (mirrors Rust `addr_str.parse::<Ipv6Addr>()`).
#[must_use]
fn _np_parse_ipv6(s) {
    var len = strlen(s);
    if (len == 0) { return 0; }

    # Collect groups before and after "::" separately.
    var head = vec_new();        # 16-bit group values before "::"
    var tail = vec_new();        # 16-bit group values after "::"
    var seen_dc = 0;             # have we passed the "::" ?
    var cur = tail;              # current target vec (head until "::" seen)
    cur = head;

    var i = 0;
    var group_val = 0;
    var group_digits = 0;
    while (i < len) {
        var c = load8(s + i);
        if (c == 58) {                            # ':'
            # Look for "::"
            var next_c = 0;
            if (i + 1 < len) { next_c = load8(s + i + 1); }
            if (i + 1 < len && next_c == 58) {
                # Flush a pending group (leading "::" has none).
                if (group_digits > 0) {
                    vec_push(cur, group_val);
                    group_val = 0;
                    group_digits = 0;
                }
                if (seen_dc == 1) { return 0; }   # two "::" is invalid
                seen_dc = 1;
                cur = tail;
                i = i + 2;
                continue;
            }
            # Single ':' — group separator. A group must precede it.
            if (group_digits == 0) { return 0; }
            vec_push(cur, group_val);
            group_val = 0;
            group_digits = 0;
            i = i + 1;
            continue;
        }
        var nib = _np_hex_nibble(c);
        if (nib < 0) { return 0; }                # non-hex char
        group_val = group_val * 16 + nib;
        group_digits = group_digits + 1;
        if (group_digits > 4) { return 0; }       # group > 16 bits
        i = i + 1;
    }
    # Flush trailing group (unless the string ended on a ':' handled above,
    # which would have left group_digits == 0 and is only valid after "::").
    if (group_digits > 0) {
        vec_push(cur, group_val);
    } else {
        # A dangling single ':' at the end (not "::") is invalid: it means
        # the last char was ':' with no "::" compression to justify it.
        if (len > 0 && load8(s + len - 1) == 58) {
            var last2 = 0;
            if (len >= 2) { last2 = load8(s + len - 2); }
            if (last2 != 58) { return 0; }
        }
    }

    var nhead = vec_len(head);
    var ntail = vec_len(tail);

    var buf = alloc(16);
    memset(buf, 0, 16);

    if (seen_dc == 1) {
        # Compressed: head groups at front, tail groups at back, zeros in
        # between. Total groups must be < 8 (else "::" compresses nothing).
        if (nhead + ntail > 7) { return 0; }
        var g = 0;
        while (g < nhead) {
            var val = vec_get(head, g);
            store8(buf + g * 2, (val / 256) % 256);
            store8(buf + g * 2 + 1, val % 256);
            g = g + 1;
        }
        var t = 0;
        while (t < ntail) {
            var val2 = vec_get(tail, t);
            var slot = 8 - ntail + t;
            store8(buf + slot * 2, (val2 / 256) % 256);
            store8(buf + slot * 2 + 1, val2 % 256);
            t = t + 1;
        }
        return buf;
    }

    # No compression: must be exactly 8 groups.
    if (nhead != 8) { return 0; }
    var g2 = 0;
    while (g2 < 8) {
        var val3 = vec_get(head, g2);
        store8(buf + g2 * 2, (val3 / 256) % 256);
        store8(buf + g2 * 2 + 1, val3 % 256);
        g2 = g2 + 1;
    }
    return buf;
}

# Format a 16-byte big-endian IPv6 buffer into a fresh cstr, using the
# canonical "::" compression of the longest run of zero groups. Mirrors
# Rust `Ipv6Addr` Display (RFC 5952).
#[must_use]
fn _np_fmt_ipv6(buf) {
    # Read 8 groups.
    var groups = alloc(8 * 8);
    var i = 0;
    while (i < 8) {
        var hi = load8(buf + i * 2);
        var lo = load8(buf + i * 2 + 1);
        store64(groups + i * 8, hi * 256 + lo);
        i = i + 1;
    }

    # Find longest run of consecutive zero groups (length >= 2 to compress).
    var best_start = 0 - 1;
    var best_len = 0;
    var run_start = 0 - 1;
    var run_len = 0;
    var j = 0;
    while (j < 8) {
        if (load64(groups + j * 8) == 0) {
            if (run_start < 0) { run_start = j; run_len = 0; }
            run_len = run_len + 1;
            if (run_len > best_len) { best_len = run_len; best_start = run_start; }
        } else {
            run_start = 0 - 1;
            run_len = 0;
        }
        j = j + 1;
    }
    if (best_len < 2) { best_start = 0 - 1; }

    # Emit groups. The compressed run [best_start, best_start+best_len) is
    # replaced by "::". A leading run yields a leading "::" (e.g. "::1"); a
    # trailing run yields a trailing "::" (e.g. "fd00::"). Mirrors RFC 5952.
    var sb = str_builder_new();
    var k = 0;
    while (k < 8) {
        if (best_start >= 0 && k == best_start) {
            # A colon before the gap (unless the gap starts at index 0).
            if (k > 0) { str_builder_putc(sb, 58); }
            str_builder_putc(sb, 58);            # the gap's own colon
            k = k + best_len;
            # If the run reached the end, we already have the trailing "::".
            continue;
        }
        if (k > 0) { str_builder_putc(sb, 58); }
        _np_fmt_hex16(sb, load64(groups + k * 8));
        k = k + 1;
    }
    var s = str_builder_build(sb);
    return str_cstr(s);
}

# Append a 16-bit group as lowercase hex without leading zeros.
fn _np_fmt_hex16(sb, val) {
    if (val == 0) { str_builder_putc(sb, 48); return 0; }
    # Collect nibbles high-to-low, skipping leading zeros.
    var started = 0;
    var shift = 12;
    while (shift >= 0) {
        var nib = (val >> shift) & 15;
        if (nib != 0 || started == 1 || shift == 0) {
            started = 1;
            var d = 48 + nib;
            if (nib >= 10) { d = 97 + nib - 10; }
            str_builder_putc(sb, d);
        }
        shift = shift - 4;
    }
    return 0;
}

# Compare two 16-byte IPv6 buffers. Returns 1 iff equal.
#[must_use]
fn _np_ipv6_eq(a, b) {
    return memeq(a, b, 16);
}

# Copy a 16-byte IPv6 buffer into a fresh heap buffer.
#[must_use]
fn _np_ipv6_dup(src) {
    var out = alloc(16);
    memcpy(out, src, 16);
    return out;
}

# In-place increment of a 16-byte big-endian IPv6 buffer by 1 (wraps).
fn _np_ipv6_inc(buf) {
    var i = 15;
    while (i >= 0) {
        var v = load8(buf + i) + 1;
        store8(buf + i, v % 256);
        if (v < 256) { return 0; }               # no carry
        i = i - 1;
    }
    return 0;
}

# Apply the /prefix network mask to a 16-byte buffer in place (zero the
# host bits). Mirrors Rust `base & mask` over u128.
fn _np_ipv6_mask(buf, prefix_len) {
    var bit = 0;
    while (bit < 128) {
        if (bit >= prefix_len) {
            var byte_idx = bit / 8;
            var bit_in_byte = 7 - (bit % 8);
            var cur = load8(buf + byte_idx);
            var m = 255 & (~(1 << bit_in_byte));
            store8(buf + byte_idx, cur & m);
        }
        bit = bit + 1;
    }
    return 0;
}

# ── Ipv6Pool ───────────────────────────

# Create a new IPv6 pool for a CIDR subnet (e.g. "fd00::/64"). Returns a
# heap Ipv6Pool pointer on success, or 0 on error (Rust:
# Err(StivaError::Network(...))). Gateway is base+1; allocation starts at
# base+2.
#[must_use]
fn ipv6_pool_new(subnet) {
    var slash = _np_find_slash(subnet);
    if (slash < 0) { return 0; }                 # invalid IPv6 subnet CIDR

    var addr_str = alloc(slash + 1);
    memcpy(addr_str, subnet, slash);
    store8(addr_str + slash, 0);

    var base = _np_parse_ipv6(addr_str);
    if (base == 0) { return 0; }                 # invalid IPv6 address

    var prefix_str = subnet + slash + 1;
    var pfx_cell = alloc(8);
    if (_np_parse_prefix(prefix_str, pfx_cell) == 0) { return 0; }  # invalid prefix
    var prefix_len = load64(pfx_cell);

    if (prefix_len > 126) { return 0; }          # prefix too small for a pool

    _np_ipv6_mask(base, prefix_len);             # network-align in place

    var gateway = _np_ipv6_dup(base);
    _np_ipv6_inc(gateway);                       # base + 1

    var next = _np_ipv6_dup(base);
    _np_ipv6_inc(next);
    _np_ipv6_inc(next);                          # base + 2

    var pool = alloc(40);
    var p: Ipv6Pool = pool;
    p.base = base;
    p.prefix_len = prefix_len;
    p.gateway = gateway;
    p.allocated = vec_new();
    p.next = next;
    return pool;
}

# Gateway address (ptr to 16-byte buffer) for this pool.
#[must_use]
fn ipv6_pool_gateway(pool) {
    var p: Ipv6Pool = pool;
    return p.gateway;
}

# Subnet string in CIDR notation ("base/prefix"). Fresh heap cstr.
#[must_use]
fn ipv6_pool_subnet(pool) {
    var p: Ipv6Pool = pool;
    var addr = _np_fmt_ipv6(p.base);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, addr);
    str_builder_putc(sb, 47);
    str_builder_add_int(sb, p.prefix_len);
    var s = str_builder_build(sb);
    return str_cstr(s);
}

# True (1) iff the 16-byte address `ip` is in the pool's allocated set.
#[must_use]
fn _ipv6_pool_contains(pool, ip) {
    var p: Ipv6Pool = pool;
    var set = p.allocated;
    var n = vec_len(set);
    var i = 0;
    while (i < n) {
        if (_np_ipv6_eq(vec_get(set, i), ip) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Allocate the next available IPv6 address. Returns a ptr to a fresh
# 16-byte buffer on success, or 0 on exhaustion (Rust:
# Err(StivaError::Network(...))). Scan is capped at 65534 like the oracle.
#[must_use]
fn ipv6_pool_allocate(pool) {
    var p: Ipv6Pool = pool;
    var max_scan = 65534;
    var iter = 0;
    while (iter < max_scan) {
        var candidate = _np_ipv6_dup(p.next);
        _np_ipv6_inc(p.next);                    # advance next

        if (_np_ipv6_eq(candidate, p.gateway) == 1 || _ipv6_pool_contains(pool, candidate) == 1) {
            iter = iter + 1;
            continue;
        }

        vec_push(p.allocated, candidate);
        return candidate;
    }
    # Shouldn't happen for /64 pools, but handle gracefully. (Rust resets
    # next to `start`; the value is recomputed on next call so we leave it.)
    return 0;                                     # IPv6 pool exhausted
}

# Release an IPv6 address (16-byte buffer ptr) back to the pool. Returns 1
# iff the address was present.
#[must_use]
fn ipv6_pool_release(pool, ip) {
    var p: Ipv6Pool = pool;
    var set = p.allocated;
    var n = vec_len(set);
    var i = 0;
    while (i < n) {
        if (_np_ipv6_eq(vec_get(set, i), ip) == 1) {
            vec_remove(set, i);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# ── DualStackPool ─────────────────────────

# Create a dual-stack pool with only IPv4. Returns a heap DualStackPool
# pointer on success, or 0 if the v4 subnet is invalid.
#[must_use]
fn dual_stack_v4_only(subnet) {
    var v4 = ip_pool_new(subnet);
    if (v4 == 0) { return 0; }
    var pool = alloc(16);
    var d: DualStackPool = pool;
    d.v4 = v4;
    d.v6 = 0;
    return pool;
}

# Create a dual-stack pool with both IPv4 and IPv6. Returns 0 if either
# subnet is invalid.
#[must_use]
fn dual_stack_dual(v4_subnet, v6_subnet) {
    var v4 = ip_pool_new(v4_subnet);
    if (v4 == 0) { return 0; }
    var v6 = ipv6_pool_new(v6_subnet);
    if (v6 == 0) { return 0; }
    var pool = alloc(16);
    var d: DualStackPool = pool;
    d.v4 = v4;
    d.v6 = v6;
    return pool;
}

# Allocate an IPv4 address. Returns the u32 host value, or -1 on exhaustion.
#[must_use]
fn dual_stack_allocate_v4(pool) {
    var d: DualStackPool = pool;
    return ip_pool_allocate(d.v4);
}

# Allocate an IPv6 address if the IPv6 pool exists. Returns:
#   ptr to 16-byte buffer — allocated v6 address
#   0                     — no IPv6 pool (Rust Ok(None)) OR exhausted
# Rust distinguishes None from Err; here both surface as 0. Callers that
# need the distinction check `d.v6 == 0` first (no pool) vs a failed
# allocate (pool present).
#[must_use]
fn dual_stack_allocate_v6(pool) {
    var d: DualStackPool = pool;
    if (d.v6 == 0) { return 0; }                 # Ok(None)
    return ipv6_pool_allocate(d.v6);
}

# Allocate both addresses. Stores the v4 host value at `out_v4` and the v6
# buffer ptr (or 0 for none) at `out_v6`. Returns 1 on success, 0 if the v4
# allocation was exhausted (Rust `?` short-circuits on the v4 error).
#[must_use]
fn dual_stack_allocate(pool, out_v4, out_v6) {
    var d: DualStackPool = pool;
    var v4 = ip_pool_allocate(d.v4);
    if (v4 < 0) { return 0; }
    store64(out_v4, v4);
    var v6 = dual_stack_allocate_v6(pool);
    store64(out_v6, v6);                          # 0 when no v6 pool
    return 1;
}

# Release both addresses. `v6` is a 16-byte buffer ptr or 0 for none.
fn dual_stack_release(pool, v4, v6) {
    var d: DualStackPool = pool;
    ip_pool_release(d.v4, v4);
    if (d.v6 != 0 && v6 != 0) {
        ipv6_pool_release(d.v6, v6);
    }
    return 0;
}

# --- network_rootless.cyr ---

# stiva — rootless networking: userspace stack for unprivileged containers.
# Ported from rust-old/src/network/rootless.rs.
#
# The oracle uses slirp4netns or pasta to provide networking without
# CAP_NET_ADMIN, auto-detecting available backends. This port carries the
# self-contained, non-async surface:
#   - RootlessNetworkBackend enum (+ serde wire names, default)
#   - PortMapping struct
#   - parse_port_mappings  (pure string parsing)
#   - is_unprivileged      (getuid + /proc/self/status CapEff parse)
#   - which                (PATH split + is_file)
#   - available_backends   (which pasta / which slirp4netns)
#   - select_backend       (preference resolution)
#
# The async process-spawning surface (RootlessNetworkHandle wrapping a
# tokio::process::Child, start_rootless_network, stop_rootless_network,
# start_slirp4netns, start_pasta, add_slirp_port_forwards) depends on the
# async process runtime, UNIX-socket JSON RPC (serde_json) and filesystem
# cleanup that are not in the ported base — they land in the DEFERRED
# block at the bottom (same pattern as src/oci.cyr).
#
# Error mapping (mirrors error.cyr): the Rust
# `Err(StivaError::RootlessNetwork(...))` maps to the integer code
# STIVA_ERR_ROOTLESS_NETWORK; fallible functions return a sentinel and the
# caller reports the context via
# stiva_err_print(STIVA_ERR_ROOTLESS_NETWORK, detail).

# ── RootlessNetworkBackend ──────────────────────

# Rootless network backend selection (rust-old: enum RootlessNetworkBackend).
# `Auto` is the serde/Default value (Rust `#[default]`). Prefixed
# NETWORK_ROOTLESS_BACKEND_* for global enum-member uniqueness (see error.cyr).
enum RootlessNetworkBackend {
    NETWORK_ROOTLESS_BACKEND_AUTO = 0;
    NETWORK_ROOTLESS_BACKEND_SLIRP4NETNS = 1;
    NETWORK_ROOTLESS_BACKEND_PASTA = 2;
}

# Default backend (rust-old: `#[default] Auto`).
#[must_use]
fn network_rootless_backend_default() {
    return NETWORK_ROOTLESS_BACKEND_AUTO;
}

# Serde wire name for a backend — the enum-variant names serde serializes
# by default (no `#[serde(rename)]` in the oracle, so PascalCase variant
# names). Used by the serde round-trip parity test.
#[must_use]
fn network_rootless_backend_name(backend) {
    if (backend == NETWORK_ROOTLESS_BACKEND_AUTO) { return "Auto"; }
    if (backend == NETWORK_ROOTLESS_BACKEND_SLIRP4NETNS) { return "Slirp4netns"; }
    if (backend == NETWORK_ROOTLESS_BACKEND_PASTA) { return "Pasta"; }
    return "Auto";
}

# Parse a backend serde wire name back to the enum value; -1 if unknown.
#[must_use]
fn network_rootless_backend_from_name(name) {
    if (streq(name, "Auto") == 1) { return NETWORK_ROOTLESS_BACKEND_AUTO; }
    if (streq(name, "Slirp4netns") == 1) { return NETWORK_ROOTLESS_BACKEND_SLIRP4NETNS; }
    if (streq(name, "Pasta") == 1) { return NETWORK_ROOTLESS_BACKEND_PASTA; }
    return 0 - 1;
}

# ── PortMapping ──────────────────────────

# Port mapping for rootless containers (rust-old: struct PortMapping).
# host_port / container_port are u16 in Rust (0..65535); protocol is a
# heap cstr ("tcp" / "udp").
struct PortMapping {
    host_port;
    container_port;
    protocol;
}

# Accessors mirroring a #derive(accessors) surface (see kavach audit.cyr).
#[must_use]
fn PortMapping_host_port(p) { var pp: PortMapping = p; return pp.host_port; }
#[must_use]
fn PortMapping_container_port(p) { var pp: PortMapping = p; return pp.container_port; }
#[must_use]
fn PortMapping_protocol(p) { var pp: PortMapping = p; return pp.protocol; }

# Allocate a PortMapping on the heap and return its pointer.
#[must_use]
fn stiva_port_mapping_new(host_port, container_port, protocol) {
    var p = alloc(24);
    var pp: PortMapping = p;
    pp.host_port = host_port;
    pp.container_port = container_port;
    pp.protocol = protocol;
    return p;
}

# ── small cstr helpers (parity-exact byte handling) ──────────────

# Copy bytes [start, end) of `src` into a fresh NUL-terminated cstr.
#[must_use]
fn _rl_slice(src, start, end) {
    var n = end - start;
    if (n < 0) { n = 0; }
    var out = alloc(n + 1);
    memcpy(out, src + start, n);
    store8(out + n, 0);
    return out;
}

# Index of the LAST `byte` in `s`, or -1 (mirrors str::rsplit_once).
#[must_use]
fn _rl_rfind(s, byte) {
    var len = strlen(s);
    var i = len - 1;
    while (i >= 0) {
        if (load8(s + i) == byte) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

# Index of the FIRST `byte` in `s`, or -1 (mirrors str::split_once).
#[must_use]
fn _rl_find(s, byte) {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (load8(s + i) == byte) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Parse a NUL-terminated decimal cstr as a u16 (0..=65535). Returns the
# value on success, or -1 on empty / non-digit / out-of-range — mirrors
# Rust `str::parse::<u16>()`, which accepts an optional leading '+' ("+80"
# → 80) but rejects '-', empty, and overflow.
#[must_use]
fn _rl_parse_u16(s) {
    var len = strlen(s);
    if (len == 0) { return 0 - 1; }
    var i = 0;
    if (load8(s) == 43) { i = 1; }   # optional leading '+'
    if (i >= len) { return 0 - 1; }  # a lone '+' has no digits
    var acc = 0;
    while (i < len) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        acc = acc * 10 + (c - 48);
        if (acc > 65535) { return 0 - 1; }
        i = i + 1;
    }
    return acc;
}

# ── parse_port_mappings ───────────────────────

# Parse port specs (e.g., "8080:80/tcp") into a vec of PortMapping
# pointers. Format: [host_port:]container_port[/protocol].
#
# `specs` is a vec of cstrs; returns a vec of PortMapping pointers on
# success, or 0 (null) on any invalid spec — the caller reports it via
# stiva_err_print(STIVA_ERR_ROOTLESS_NETWORK, detail). This mirrors the
# Rust `Result<Vec<PortMapping>, StivaError>`: the four distinct Rust
# error strings ("invalid host port: {h}", "invalid container port: {c}",
# "invalid port: {port_part}") all funnel to STIVA_ERR_ROOTLESS_NETWORK.
#[must_use]
fn parse_port_mappings(specs) {
    var mappings = vec_new();
    var si = 0;
    while (si < vec_len(specs)) {
        var spec = vec_get(specs, si);

        # rsplit_once('/') → (port_part, protocol), else (spec, "tcp").
        var port_part = spec;
        var protocol = "tcp";
        var slash = _rl_rfind(spec, 47);
        if (slash >= 0) {
            port_part = _rl_slice(spec, 0, slash);
            protocol = _rl_slice(spec, slash + 1, strlen(spec));
        }

        # split_once(':') → (host, container), else single port for both.
        var host_port = 0;
        var container_port = 0;
        var colon = _rl_find(port_part, 58);
        if (colon >= 0) {
            var h = _rl_slice(port_part, 0, colon);
            var c = _rl_slice(port_part, colon + 1, strlen(port_part));
            var hp = _rl_parse_u16(h);
            if (hp < 0) { return 0; }
            var cp = _rl_parse_u16(c);
            if (cp < 0) { return 0; }
            host_port = hp;
            container_port = cp;
        } else {
            var p = _rl_parse_u16(port_part);
            if (p < 0) { return 0; }
            host_port = p;
            container_port = p;
        }

        vec_push(mappings, stiva_port_mapping_new(host_port, container_port, protocol));
        si = si + 1;
    }
    return mappings;
}

# ── is_unprivileged ─────────────────────────

# Parse a hex substring [start, end) of `buf` (after any trim) into an
# i64 — mirrors Rust `u64::from_str_radix(hex.trim(), 16)`. Returns the
# value, or -1 on a non-hex byte / empty range.
#[must_use]
fn _rl_parse_hex(buf, start, end) {
    if (end <= start) { return 0 - 1; }
    var i = start;
    var acc = 0;
    while (i < end) {
        var c = load8(buf + i);
        var d = 0 - 1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        elif (c >= 97 && c <= 102) { d = c - 97 + 10; }
        elif (c >= 65 && c <= 70) { d = c - 65 + 10; }
        if (d < 0) { return 0 - 1; }
        acc = acc * 16 + d;
        i = i + 1;
    }
    return acc;
}

# Check if we're running unprivileged (not root and no CAP_NET_ADMIN).
# Returns 1 (unprivileged) or 0 (privileged) — mirrors the Rust bool.
#
# root ⇒ privileged (0). Otherwise read /proc/self/status, find the
# "CapEff:\t<hex>" line, and test bit 12 (CAP_NET_ADMIN): set ⇒ privileged
# (0), clear ⇒ unprivileged (1). If CapEff can't be read/found, assume
# unprivileged (1) — matches the Rust `true` fallbacks.
#[must_use]
fn is_unprivileged() {
    var uid = sys_getuid();
    if (uid == 0) { return 0; }

    var buf = alloc(8192);
    var n = file_read_all("/proc/self/status", buf, 8191);
    if (n <= 0) { return 1; }
    store8(buf + n, 0);

    # Scan line by line for the "CapEff:\t" prefix.
    var pos = 0;
    while (pos < n) {
        # Find end of this line.
        var eol = pos;
        while (eol < n && load8(buf + eol) != 10) { eol = eol + 1; }

        # Match prefix "CapEff:\t" (8 bytes: C a p E f f : \t).
        var is_capeff = 0;
        if (eol - pos >= 8) {
            if (memeq(buf + pos, "CapEff:\t", 8) == 1) { is_capeff = 1; }
        }
        if (is_capeff == 1) {
            # hex spans [pos+8, eol); trim trailing whitespace (Rust .trim()).
            var hs = pos + 8;
            var he = eol;
            while (he > hs) {
                var tc = load8(buf + he - 1);
                if (tc == 32 || tc == 9 || tc == 13) { he = he - 1; }
                else { break; }
            }
            var caps = _rl_parse_hex(buf, hs, he);
            if (caps < 0) { return 1; }
            # bit 12 = CAP_NET_ADMIN. Clear ⇒ unprivileged (1).
            if ((caps & 4096) == 0) { return 1; }
            return 0;
        }

        pos = eol + 1;
    }
    # CapEff not found — assume unprivileged.
    return 1;
}

# ── which / available_backends / select_backend ───────────────

# Check if binary `name` is available in PATH (rust-old: fn which).
# Splits $PATH on ':' and tests each `dir/name` for existence.
# Returns 1 if found, 0 otherwise (including no PATH set).
#[must_use]
fn stiva_which(name) {
    var path = getenv("PATH");
    if (path == 0) { return 0; }
    var plen = strlen(path);
    if (plen == 0) { return 0; }
    var nlen = strlen(name);

    var start = 0;
    var i = 0;
    while (i <= plen) {
        var at_sep = 0;
        if (i == plen) { at_sep = 1; }
        elif (load8(path + i) == 58) { at_sep = 1; }
        if (at_sep == 1) {
            var dlen = i - start;
            if (dlen > 0) {
                # Build "<dir>/<name>".
                var cand = alloc(dlen + 1 + nlen + 1);
                memcpy(cand, path + start, dlen);
                store8(cand + dlen, 47);
                memcpy(cand + dlen + 1, name, nlen);
                store8(cand + dlen + 1 + nlen, 0);
                if (file_exists(cand) == 1) { return 1; }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# Detect which rootless network backends are available on the system.
# Returns a vec of backend enum values, in the same push order as the
# oracle: pasta first (if present), then slirp4netns (rust-old:
# fn available_backends).
#[must_use]
fn available_backends() {
    var backends = vec_new();
    if (stiva_which("pasta") == 1) {
        vec_push(backends, NETWORK_ROOTLESS_BACKEND_PASTA);
    }
    if (stiva_which("slirp4netns") == 1) {
        vec_push(backends, NETWORK_ROOTLESS_BACKEND_SLIRP4NETNS);
    }
    return backends;
}

# True (1) iff `backends` vec contains `backend`.
#[must_use]
fn _rl_contains(backends, backend) {
    var i = 0;
    while (i < vec_len(backends)) {
        if (vec_get(backends, i) == backend) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Select the best available backend, respecting user preference
# (rust-old: fn select_backend).
#
# For Auto: prefer pasta, then slirp4netns; if neither, return -1 — the
# caller reports stiva_err_print(STIVA_ERR_ROOTLESS_NETWORK, "no rootless
# network backend found (install pasta or slirp4netns)").
# For a specific preference: return it if available, else -1 — the caller
# reports "{preference:?} not found in PATH".
#
# Returns the resolved backend enum value on success, or -1 on failure.
#[must_use]
fn select_backend(preference) {
    var available = available_backends();

    if (preference == NETWORK_ROOTLESS_BACKEND_AUTO) {
        if (_rl_contains(available, NETWORK_ROOTLESS_BACKEND_PASTA) == 1) {
            return NETWORK_ROOTLESS_BACKEND_PASTA;
        }
        if (_rl_contains(available, NETWORK_ROOTLESS_BACKEND_SLIRP4NETNS) == 1) {
            return NETWORK_ROOTLESS_BACKEND_SLIRP4NETNS;
        }
        return 0 - 1;
    }

    if (_rl_contains(available, preference) == 1) {
        return preference;
    }
    return 0 - 1;
}

# ══ rootless network spawn ══  (roadmap v3.0.17 item 2)
#
# Until now `network_manager` only warned that the bridge needed root
# and carried on, so an unprivileged `stiva run` — stiva's DEFAULT mode —
# produced a container with no connectivity and only a warning. The detection
# half (available_backends / select_backend / parse_port_mappings) was already
# ported; only the spawn was missing, for want of a subprocess primitive.
#
# WHY NOT `_exec_capture2`. These are DAEMONS: slirp4netns and pasta run for
# the container lifetime, attached to its network namespace. A capture primitive
# waits for the child, so using it would hang `run` forever. This needs a
# detached spawn returning the pid. See docs/development/roadmap.md.

# A running rootless-network helper: pid @0, backend @8, api socket path @16
# (0 when the backend has none).
#[must_use]
fn rootless_handle_pid(h) { return load64(h); }
#[must_use]
fn rootless_handle_backend(h) { return load64(h + 8); }
#[must_use]
fn rootless_handle_socket(h) { return load64(h + 16); }

# Fork/exec `args` and return the child pid WITHOUT waiting. stdin and stdout go
# to /dev/null; stderr appends to `log_path` so a failure to start is
# diagnosable after the fact — the oracle pipes stderr and then never reads it.
#
# The child is deliberately not reaped: it outlives this one-shot process and is
# reparented to init, exactly like a detached container. `stop_rootless_network`
# signals it by pid.
fn _rl_spawn_detached(args, log_path) {
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    var argv = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) {
        store64(argv + i * 8, vec_get(args, i));
        i = i + 1;
    }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    store64(envp, 0);

    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        var devnull = sys_open("/dev/null", 2, 0);          # O_RDWR
        if (devnull >= 0) {
            sys_dup2(devnull, 0);
            sys_dup2(devnull, 1);
            sys_close(devnull);
        }
        if (log_path != 0) {
            var lf = sys_open(log_path, 1089, 384);          # O_WRONLY|O_CREAT|O_APPEND, 0600
            if (lf >= 0) { sys_dup2(lf, 2); sys_close(lf); }
        }
        # CVE-2024-21626: never hand inherited host fds to a child that outlives
        # this process.
        var fd = 3;
        while (fd < 1024) { sys_close(fd); fd = fd + 1; }
        sys_execve(vec_get(args, 0), argv, envp);
        sys_exit(127);
    }
    return pid;
}

# "<n>" as a fresh cstr.
#[must_use]
fn _rl_int_cstr(v) {
    var sb = str_builder_new();
    str_builder_add_int(sb, v);
    return str_cstr(str_builder_build(sb));
}

# The API socket path slirp4netns is told to create for `pid`.
#[must_use]
fn _rl_sock_path(pid) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/stiva-slirp-");
    str_builder_add_int(sb, pid);
    str_builder_add_cstr(sb, ".sock");
    return str_cstr(str_builder_build(sb));
}

# Start slirp4netns against `pid`'s network namespace. Returns a handle, or 0.
fn _rl_start_slirp4netns(bin, pid, port_mappings, log_path) {
    var sock = _rl_sock_path(pid);
    sys_unlink(sock);                       # a stale socket makes slirp4netns refuse
    var args = vec_new();
    vec_push(args, bin);
    vec_push(args, "--configure");
    vec_push(args, "--mtu=65520");
    vec_push(args, "--disable-host-loopback");
    vec_push(args, "--api-socket");
    vec_push(args, sock);
    vec_push(args, _rl_int_cstr(pid));
    vec_push(args, "tap0");
    var child = _rl_spawn_detached(args, log_path);
    if (child < 0) {
        stiva_err_print(STIVA_ERR_ROOTLESS_NETWORK, "failed to start slirp4netns");
        return 0;
    }
    var h = alloc(24);
    store64(h, child);
    store64(h + 8, NETWORK_ROOTLESS_BACKEND_SLIRP4NETNS);
    store64(h + 16, sock);
    # Port forwards go over the API socket, which only exists once slirp4netns
    # has initialised — hence the retry loop rather than the oracle's fixed
    # 200 ms sleep, which is a race on a loaded machine either way.
    if (port_mappings != 0) {
        if (vec_len(port_mappings) > 0) { _rl_add_slirp_forwards(sock, port_mappings); }
    }
    return h;
}

# Start pasta against `pid`'s network namespace. Returns a handle, or 0.
#
# pasta takes port mappings as ARGV flags, so it needs no API socket at all —
# which is why it is preferred when mappings are present.
fn _rl_start_pasta(bin, pid, port_mappings, log_path) {
    var args = vec_new();
    vec_push(args, bin);
    vec_push(args, "--ns-ifname");
    vec_push(args, "eth0");
    if (port_mappings != 0) {
        var i = 0;
        while (i < vec_len(port_mappings)) {
            var m = vec_get(port_mappings, i);
            var flag = "-t";
            if (streq(PortMapping_protocol(m), "udp") == 1) { flag = "-u"; }
            vec_push(args, flag);
            var sb = str_builder_new();
            str_builder_add_int(sb, PortMapping_host_port(m));
            str_builder_add_cstr(sb, ":");
            str_builder_add_int(sb, PortMapping_container_port(m));
            vec_push(args, str_cstr(str_builder_build(sb)));
            i = i + 1;
        }
    }
    vec_push(args, _rl_int_cstr(pid));
    var child = _rl_spawn_detached(args, log_path);
    if (child < 0) {
        stiva_err_print(STIVA_ERR_ROOTLESS_NETWORK, "failed to start pasta");
        return 0;
    }
    var h = alloc(24);
    store64(h, child);
    store64(h + 8, NETWORK_ROOTLESS_BACKEND_PASTA);
    store64(h + 16, 0);
    return h;
}

# Ask slirp4netns to forward each mapping, over its JSON-RPC UNIX socket.
# Best-effort: a failure costs port forwarding, never the container's network.
fn _rl_add_slirp_forwards(sock, port_mappings) {
    var i = 0;
    while (i < vec_len(port_mappings)) {
        var m = vec_get(port_mappings, i);
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "{\"execute\":\"add_hostfwd\",\"arguments\":{\"proto\":\"");
        str_builder_add_cstr(sb, PortMapping_protocol(m));
        str_builder_add_cstr(sb, "\",\"host_addr\":\"0.0.0.0\",\"host_port\":");
        str_builder_add_int(sb, PortMapping_host_port(m));
        str_builder_add_cstr(sb, ",\"guest_port\":");
        str_builder_add_int(sb, PortMapping_container_port(m));
        str_builder_add_cstr(sb, "}}");
        var msg = str_builder_build(sb);
        _rl_unix_send(sock, str_data(msg), str_len(msg));
        i = i + 1;
    }
    return 0;
}

# Connect to the AF_UNIX socket at `path`, write `len` bytes, close. Returns 0 on
# success, -1 otherwise. Retries briefly: the socket appears only once
# slirp4netns has initialised, and the oracle's fixed 200 ms sleep is a race on
# a loaded machine.
#
# sockaddr_un: sa_family @0 (u16, AF_UNIX = 1), sun_path @2, 108 bytes.
fn _rl_unix_send(path, data, len) {
    var plen = strlen(path);
    if (plen > 107) { return 0 - 1; }
    var attempt = 0;
    while (attempt < 50) {
        var fd = sys_socket(1, 1, 0);                    # AF_UNIX, SOCK_STREAM
        if (fd >= 0) {
            var sa = alloc(110);
            var z = 0;
            while (z < 110) { store8(sa + z, 0); z = z + 1; }
            store16(sa, 1);                              # AF_UNIX
            memcpy(sa + 2, path, plen);
            if (sys_connect(fd, sa, 110) == 0) {
                sys_write(fd, data, len);
                sys_close(fd);
                return 0;
            }
            sys_close(fd);
        }
        # 10 ms between attempts, 50 attempts -> a 500 ms ceiling. Through
        # `sleep_ms`, NOT a raw nanosleep: syscall 35 is nanosleep on Linux and
        # something else entirely elsewhere — the drift class filed upstream.
        sleep_ms(10);
        attempt = attempt + 1;
    }
    return 0 - 1;
}

# Start the rootless network helper for `pid`, choosing a backend.
#
# DIVERGENCE: when port mappings are present and `preference` is Auto, pasta is
# chosen over slirp4netns. pasta takes mappings as argv, so they are in effect
# the moment it starts; slirp4netns needs a JSON-RPC round trip against a socket
# that does not exist yet, which is inherently racy. The oracle has no such
# preference and its slirp path sleeps 200 ms and hopes.
#
# Returns a handle, or 0 (detail printed). 0 is not fatal to the caller: a
# container without port forwarding is still a container.
fn start_rootless_network(preference, pid, port_mappings, log_path) {
    var want = preference;
    if (want == NETWORK_ROOTLESS_BACKEND_AUTO) {
        if (port_mappings != 0) {
            if (vec_len(port_mappings) > 0) {
                if (stiva_which("pasta") == 1) { want = NETWORK_ROOTLESS_BACKEND_PASTA; }
            }
        }
    }
    var backend = select_backend(want);
    if (backend == NETWORK_ROOTLESS_BACKEND_AUTO) {
        stiva_err_print(STIVA_ERR_ROOTLESS_NETWORK,
          "no rootless network backend available (install slirp4netns or pasta)");
        return 0;
    }
    if (backend == NETWORK_ROOTLESS_BACKEND_PASTA) {
        return _rl_start_pasta(_rl_bin_path("pasta"), pid, port_mappings, log_path);
    }
    return _rl_start_slirp4netns(_rl_bin_path("slirp4netns"), pid, port_mappings, log_path);
}

# Absolute path for a helper binary. execve does NOT search PATH, and the child
# is exec'd with an empty environment, so a bare name would always fail.
#[must_use]
fn _rl_bin_path(name) {
    var a = _rl_cat2("/usr/bin/", name);
    if (file_exists(a) == 1) { return a; }
    var b = _rl_cat2("/usr/local/bin/", name);
    if (file_exists(b) == 1) { return b; }
    var c = _rl_cat2("/bin/", name);
    if (file_exists(c) == 1) { return c; }
    return a;
}

#[must_use]
fn _rl_cat2(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_cstr(str_builder_build(sb));
}

# Stop a rootless network helper: SIGTERM the pid and remove its socket.
# Returns 0. Best-effort — the helper also exits on its own when the container's
# netns goes away.
fn stop_rootless_network(h) {
    if (h == 0) { return 0; }
    var pid = rootless_handle_pid(h);
    if (pid > 0) { sys_kill(pid, 15); }
    var sock = rootless_handle_socket(h);
    if (sock != 0) { sys_unlink(sock); }
    return 0;
}

# ── NOT PORTED ──
# rust-old/src/network/rootless.rs also defines the async, OS-process-
# coupled surface — these wrap tokio::process::Child, UNIX-socket JSON
# RPC (serde_json), std::env::temp_dir and filesystem cleanup, none of
# which exist in the ported base yet:
#
#   struct RootlessNetworkHandle { child, backend, api_socket }
#   impl RootlessNetworkHandle { fn backend(&self) -> &RootlessNetworkBackend }
#
#   async fn start_rootless_network(
#       backend: &RootlessNetworkBackend,
#       container_pid: u32,
#       port_mappings: &[PortMapping],
#   ) -> Result<RootlessNetworkHandle, StivaError>
#
#   async fn stop_rootless_network(
#       handle: &mut RootlessNetworkHandle,
#   ) -> Result<(), StivaError>
#
#   async fn start_slirp4netns(pid: u32, port_mappings: &[PortMapping])
#       -> Result<RootlessNetworkHandle, StivaError>
#   async fn add_slirp_port_forwards(sock_path: &Path,
#       port_mappings: &[PortMapping]) -> Result<(), StivaError>
#   async fn start_pasta(pid: u32, port_mappings: &[PortMapping])
#       -> Result<RootlessNetworkHandle, StivaError>
#
# All fallible paths map to STIVA_ERR_ROOTLESS_NETWORK. Tracked in the
# roadmap alongside the async/process-spawn runtime port.

# --- network_nat.cyr ---

# stiva — NAT and port mapping via nein.
# Ported from rust-old/src/network/nat.rs.
#
# The Rust module parses container port-mapping specs and bridges them into
# nein's NAT / bridge primitives. In Cyrius the nein crate is vendored as the
# flat bundle lib/nein.cyr; its handle-based fns stand in for the Rust types:
#   nein::bridge::PortMapping  → pm_tcp / pm_udp / pm_host_port / ...
#   nein::nat::NatRule         → nat_masquerade / nat_dnat (handle + nat_type/nat_vN)
#   nein::nat::container_masquerade / port_forward → same-named bundle fns
#   nein::bridge::BridgeConfig → bridge_config_new
#
# Error mapping (mirrors error.cyr): every Rust `Err(StivaError::PortMapping(..))`
# maps to the integer sentinel `0` (invalid) returned from `network_nat_parse_port_spec`;
# the caller reports it via stiva_err_print(STIVA_ERR_PORT_MAPPING, detail).
# The context strings the Rust carried in the PortMapping payload are elided.
#
# `alloc_init()` must have been called once before any PortSpec is created.

# ── Protocol for port mappings (rust-old: enum PortProtocol) ─────────
# Prefixed NETWORK_NAT_PROTO_* for global enum-member uniqueness (see
# error.cyr). Tcp is the #[default].
enum PortProtocol {
    NETWORK_NAT_PROTO_TCP = 0;
    NETWORK_NAT_PROTO_UDP = 1;
}

# Default protocol (rust-old: #[default] Tcp).
#[must_use]
fn network_nat_proto_default() {
    return NETWORK_NAT_PROTO_TCP;
}

# ── PortSpec (rust-old: struct PortSpec) ──────────────────
# host_addr      : u32 host value of the IPv4 bind address (valid iff
#                  has_host_addr == 1); mirrors Option<Ipv4Addr>.
# has_host_addr  : 1 when a bind address was given, else 0 (None).
# host_port      : port on the host (u16).
# container_port : port inside the container (u16).
# protocol       : PortProtocol.
struct PortSpec {
    host_addr;
    has_host_addr;
    host_port;
    container_port;
    protocol;
}

# Constructor is `network_nat_`-prefixed: nein's bundle defines an unrelated
# `port_spec_new(protocol, port, transport)`; last-def-wins would silently
# clobber one of the two. The read accessors below stay `port_spec_*` (no
# nein collision) to mirror the Rust field names.
#[must_use]
fn network_nat_port_spec_new(host_addr, has_host_addr, host_port, container_port, protocol) {
    var p = alloc(40);
    var ps: PortSpec = p;
    ps.host_addr = host_addr;
    ps.has_host_addr = has_host_addr;
    ps.host_port = host_port;
    ps.container_port = container_port;
    ps.protocol = protocol;
    return p;
}

fn port_spec_host_addr(p) { var ps: PortSpec = p; return ps.host_addr; }
fn port_spec_has_host_addr(p) { var ps: PortSpec = p; return ps.has_host_addr; }
fn port_spec_host_port(p) { var ps: PortSpec = p; return ps.host_port; }
fn port_spec_container_port(p) { var ps: PortSpec = p; return ps.container_port; }
fn port_spec_protocol(p) { var ps: PortSpec = p; return ps.protocol; }

# ── string helpers (self-contained; NUL-terminated cstrings) ─────────

# True (1) iff `c` is ASCII whitespace that Rust's str::trim strips at the
# ends of a port spec — space, tab, newline, carriage return.
#[must_use]
fn _network_nat_is_ws(c) {
    if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; }
    return 0;
}

# Trim leading/trailing ASCII whitespace from `s`, writing a fresh cstr.
# Mirrors Rust `spec.trim()`.
#[must_use]
fn _network_nat_trim(s) {
    var len = strlen(s);
    var start = 0;
    while (start < len && _network_nat_is_ws(load8(s + start)) == 1) {
        start = start + 1;
    }
    var end = len;
    while (end > start && _network_nat_is_ws(load8(s + end - 1)) == 1) {
        end = end - 1;
    }
    var n = end - start;
    var out = alloc(n + 1);
    memcpy(out, s + start, n);
    store8(out + n, 0);
    return out;
}

# Byte index of the LAST occurrence of `ch` in `s`, or -1 if absent.
# Mirrors Rust `str::rsplit_once(ch)` split-point discovery.
#[must_use]
fn _network_nat_rindex(s, ch) {
    var len = strlen(s);
    var i = len - 1;
    while (i >= 0) {
        if (load8(s + i) == ch) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

# Count of `ch` occurrences in `s`.
#[must_use]
fn _network_nat_count(s, ch) {
    var len = strlen(s);
    var n = 0;
    var i = 0;
    while (i < len) {
        if (load8(s + i) == ch) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# Copy the [start,end) byte range of `s` into a fresh cstr.
#[must_use]
fn _network_nat_slice(s, start, end) {
    var n = end - start;
    var out = alloc(n + 1);
    memcpy(out, s + start, n);
    store8(out + n, 0);
    return out;
}

# Lowercase an ASCII cstr into a fresh buffer (for the protocol compare;
# mirrors Rust `proto.to_lowercase()`).
#[must_use]
fn _network_nat_lower(s) {
    var len = strlen(s);
    var out = alloc(len + 1);
    var i = 0;
    while (i < len) {
        var c = load8(s + i);
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(out + i, c);
        i = i + 1;
    }
    store8(out + len, 0);
    return out;
}

# ── numeric / address parse (mirrors Rust parse::<u16>() / Ipv4Addr) ──

# Parse a decimal u16 port cstr. Returns the value (0..65535) via store at
# `out` and 1 on success; 0 on invalid (empty, non-digit, or > 65535).
# Mirrors Rust `s.parse::<u16>()` in parse_port.
#[must_use]
fn _network_nat_parse_port(s, out) {
    var len = strlen(s);
    if (len == 0) { return 0; }
    var val = 0;
    var i = 0;
    while (i < len) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { return 0; }
        val = val * 10 + (c - 48);
        if (val > 65535) { return 0; }
        i = i + 1;
    }
    store64(out, val);
    return 1;
}

# Parse a single decimal IPv4 octet [start,end) of `s`. Returns 1 on success
# (value 0..255 stored at `out`), 0 on invalid. Rust Ipv4Addr::from_str
# rejects a leading-zero octet ("010", "00") — only bare "0" is valid.
#[must_use]
fn _network_nat_parse_octet(s, start, end, out) {
    if (end <= start) { return 0; }
    if (end - start > 1 && load8(s + start) == 48) { return 0; }
    var val = 0;
    var i = start;
    while (i < end) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { return 0; }
        val = val * 10 + (c - 48);
        if (val > 255) { return 0; }
        i = i + 1;
    }
    store64(out, val);
    return 1;
}

# Parse a dotted-quad IPv4 cstr into its u32 host value. Returns 1 on
# success (value stored at `out`), 0 on invalid. Mirrors Rust
# `parts[0].parse::<Ipv4Addr>()`.
#[must_use]
fn _network_nat_parse_ipv4(s, out) {
    var len = strlen(s);
    if (len == 0) { return 0; }
    var octets = 0;
    var seg_start = 0;
    var cell = alloc(8);
    var value = 0;
    var i = 0;
    while (i <= len) {
        var c = 0;
        if (i < len) { c = load8(s + i); }
        if (i == len || c == 46) {   # '.' or end
            if (_network_nat_parse_octet(s, seg_start, i, cell) == 0) { return 0; }
            var oct = load64(cell);
            value = value * 256 + oct;
            octets = octets + 1;
            seg_start = i + 1;
        }
        i = i + 1;
    }
    if (octets != 4) { return 0; }
    store64(out, value);
    return 1;
}

# Format a u32 host value into a fresh dotted-quad cstr (for network_nat_to_nein_port_mapping
# addr string; mirrors Rust `container_ip.to_string()`).
#[must_use]
fn _network_nat_fmt_ipv4(v) {
    var sb = str_builder_new();
    var b0 = (v / 16777216) % 256;
    var b1 = (v / 65536) % 256;
    var b2 = (v / 256) % 256;
    var b3 = v % 256;
    str_builder_add_int(sb, b0);
    str_builder_putc(sb, 46);
    str_builder_add_int(sb, b1);
    str_builder_putc(sb, 46);
    str_builder_add_int(sb, b2);
    str_builder_putc(sb, 46);
    str_builder_add_int(sb, b3);
    var s = str_builder_build(sb);
    return str_cstr(s);
}

# ── network_nat_parse_port_spec (rust-old: network_nat_parse_port_spec) ───────
# Parse a port specification string. Formats:
#   "8080:80"                     — host 8080 → container 80 (TCP)
#   "8080:80/tcp"                 — explicit TCP
#   "8080:80/udp"                 — UDP
#   "0.0.0.0:8080:80"             — explicit bind address
#   "127.0.0.1:8080:80/tcp"       — bind address + protocol
# Returns a PortSpec pointer on success, or 0 on any error (empty spec,
# unknown protocol, wrong colon count, bad port/address). The caller reports
# via stiva_err_print(STIVA_ERR_PORT_MAPPING, detail).
#[must_use]
fn network_nat_parse_port_spec(spec_in) {
    var spec = _network_nat_trim(spec_in);
    if (strlen(spec) == 0) {
        # StivaError::PortMapping("empty port spec")
        return 0;
    }

    # Split off protocol suffix on the LAST '/'.
    var protocol = NETWORK_NAT_PROTO_TCP;
    var port_part = spec;
    var slash = _network_nat_rindex(spec, 47);   # '/'
    if (slash >= 0) {
        var proto_cstr = _network_nat_lower(spec + slash + 1);
        if (streq(proto_cstr, "tcp") == 1) {
            protocol = NETWORK_NAT_PROTO_TCP;
        } elif (streq(proto_cstr, "udp") == 1) {
            protocol = NETWORK_NAT_PROTO_UDP;
        } else {
            # StivaError::PortMapping("unknown protocol: {proto}")
            return 0;
        }
        port_part = _network_nat_slice(spec, 0, slash);
    }

    # Number of ':'-separated parts.
    var colons = _network_nat_count(port_part, 58);   # ':'
    var parts = colons + 1;

    var cell = alloc(8);

    if (parts == 2) {
        # host_port:container_port
        var c0 = _network_nat_rindex(port_part, 58);
        # colons == 1 here, so first ':' index == c0.
        var host_str = _network_nat_slice(port_part, 0, c0);
        var cont_str = port_part + c0 + 1;
        if (_network_nat_parse_port(host_str, cell) == 0) { return 0; }
        var host_port = load64(cell);
        if (_network_nat_parse_port(cont_str, cell) == 0) { return 0; }
        var container_port = load64(cell);
        return network_nat_port_spec_new(0, 0, host_port, container_port, protocol);
    }

    if (parts == 3) {
        # host_addr:host_port:container_port
        var i1 = _network_nat_index(port_part, 58, 0);
        var i2 = _network_nat_index(port_part, 58, i1 + 1);
        var addr_str = _network_nat_slice(port_part, 0, i1);
        var host_str2 = _network_nat_slice(port_part, i1 + 1, i2);
        var cont_str2 = port_part + i2 + 1;
        if (_network_nat_parse_ipv4(addr_str, cell) == 0) {
            # StivaError::PortMapping("invalid bind address '{}': {e}")
            return 0;
        }
        var host_addr = load64(cell);
        if (_network_nat_parse_port(host_str2, cell) == 0) { return 0; }
        var host_port2 = load64(cell);
        if (_network_nat_parse_port(cont_str2, cell) == 0) { return 0; }
        var container_port2 = load64(cell);
        return network_nat_port_spec_new(host_addr, 1, host_port2, container_port2, protocol);
    }

    # StivaError::PortMapping("invalid port spec: {spec}")
    return 0;
}

# Byte index of the first `ch` in `s` at or after `from`, or -1 if absent.
#[must_use]
fn _network_nat_index(s, ch, from) {
    var len = strlen(s);
    var i = from;
    while (i < len) {
        if (load8(s + i) == ch) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ── nein bridging (rust-old: network_nat_to_nein_port_mapping / masquerade_rule /
#    port_forward_rule / network_nat_bridge_config) ────────────────

# Convert a PortSpec to a nein PortMapping handle. `container_ip` is a u32
# host value. Mirrors `network_nat_to_nein_port_mapping`.
#[must_use]
fn network_nat_to_nein_port_mapping(spec, container_ip) {
    var addr = _network_nat_fmt_ipv4(container_ip);
    var hp = port_spec_host_port(spec);
    var cp = port_spec_container_port(spec);
    if (port_spec_protocol(spec) == NETWORK_NAT_PROTO_TCP) {
        return pm_tcp(hp, addr, cp);
    }
    return pm_udp(hp, addr, cp);
}

# Build a masquerade NAT rule for a bridge subnet (nein::nat::container_masquerade).
#[must_use]
fn masquerade_rule(subnet, outbound_iface) {
    return container_masquerade(subnet, outbound_iface);
}

# Build a DNAT (port forward) rule (nein::nat::port_forward).
#[must_use]
fn port_forward_rule(host_port, container_addr, container_port) {
    return port_forward(host_port, container_addr, container_port);
}

# Create a nein BridgeConfig handle (nein::bridge::BridgeConfig::new).
#[must_use]
fn network_nat_bridge_config(bridge_name, subnet, outbound_iface) {
    return bridge_config_new(bridge_name, subnet, outbound_iface);
}

# --- network_manager.cyr ---

# stiva — network manager: lifecycle for bridge networks, container connectivity
# Ported from rust-old/src/network/manager.rs.
#
# The Rust NetworkManager owns:
#   networks     : HashMap<String, ManagedNetwork>   (name -> { pool, bridge_created })
#   connections  : HashMap<String, ContainerNetwork> (container_id -> connection)
#   outbound_iface : String
#
# In Cyrius these are heap structs (pointer per field) with cstr-keyed maps
# (hashmap.cyr KeyTypeCstr path — names/ids are NUL-terminated cstrings).
# `alloc_init()` must have run once before any manager is created.
#
# IP representation: rust-old carried `ContainerNetwork.ip` as an Ipv4Addr.
# network_pool.cyr allocates the u32 host value and network_mod.cyr's
# ContainerNetwork stores it — so here `.ip` is the u32 host value
# (ip_pool_allocate's return). We format it to a dotted-quad cstr on demand
# (via _np_fmt_ipv4 from network_pool.cyr) for the NAT/DNS paths that need a
# string, exactly where rust-old called `ip.to_string()` / `%ip`. Release
# feeds the same u32 back to ip_pool_release. The test parity check
# `cn.ip == "172.17.0.2".parse::<Ipv4Addr>()` becomes an integer compare on
# that host value (172.17.0.2 = 0xAC110002 = 2886795266).
#
# Error mapping (mirrors error.cyr): every Rust `Err(StivaError::Network(...))`
# becomes STIVA_ERR_NETWORK returned via an integer sentinel; the caller
# reports detail via stiva_err_print(STIVA_ERR_NETWORK, detail). Fallible
# constructors/queries that must yield a value return 0 (or a documented
# negative) on failure.

# ── constants (rust-old: pub const DEFAULT_*, const DEFAULT_OUTBOUND_IFACE) ──

# Default bridge network name (rust-old: DEFAULT_BRIDGE).
#[must_use]
fn network_manager_default_bridge() {
    return "stiva0";
}

# Default bridge subnet (rust-old: DEFAULT_SUBNET).
#[must_use]
fn network_manager_default_subnet() {
    return "172.17.0.0/16";
}

# Default outbound interface for NAT (rust-old: DEFAULT_OUTBOUND_IFACE).
#[must_use]
fn _network_manager_default_outbound_iface() {
    return "eth0";
}

# ── ManagedNetwork (rust-old: struct ManagedNetwork) ─────────────
# pool          : ptr to an IpPool (network_pool.cyr)
# bridge_created : 1 if the bridge interface was created, 0 if skipped (needs
#                  root; rootless path is roadmap v3.0.17 item 2)
struct ManagedNetwork {
    pool;
    bridge_created;
}

fn _managed_network_new(pool, bridge_created) {
    var m: ManagedNetwork = alloc(16);
    m.pool = pool;
    m.bridge_created = bridge_created;
    return m;
}

# ── NetworkManager (rust-old: struct NetworkManager) ─────────────
# networks       : cstr-keyed map name -> ManagedNetwork ptr
# connections    : cstr-keyed map container_id -> ContainerNetwork ptr
# outbound_iface : cstr
struct NetworkManager {
    networks;
    connections;
    outbound_iface;
}

# Create a new network manager with the default bridge network
# (rust-old: NetworkManager::new). Returns the manager ptr on success, or 0
# on failure (the default-bridge create_network failed). Callers report via
# stiva_err_print(STIVA_ERR_NETWORK, detail).
#[must_use]
fn network_manager_new() {
    return network_manager_with_outbound(_network_manager_default_outbound_iface());
}

# Create with a specific outbound interface (rust-old: with_outbound).
# Returns the manager ptr, or 0 if the default-bridge create fails.
#[must_use]
fn network_manager_with_outbound(outbound_iface) {
    var mgr: NetworkManager = alloc(24);
    mgr.networks = map_new();
    mgr.connections = map_new();
    mgr.outbound_iface = outbound_iface;

    # Create default bridge network (IP pool only; bridge iface requires root).
    var rc = network_manager_create_network(mgr, network_manager_default_bridge(), network_manager_default_subnet());
    if (rc != STIVA_ERR_OK) { return 0; }
    return mgr;
}

# Create a named network with the given subnet (rust-old: create_network).
# Returns STIVA_ERR_OK on success, or STIVA_ERR_NETWORK if the name already
# exists or the subnet is invalid. The bridge interface is created best-effort
# (skipped with a warning when not root — roadmap v3.0.17 item 2); the pool is
# always registered.
fn network_manager_create_network(m, name, subnet) {
    var mgr: NetworkManager = m;

    if (map_has(mgr.networks, name) == 1) {
        # "network '{name}' already exists"
        return STIVA_ERR_NETWORK;
    }

    var pool = ip_pool_new(subnet);
    if (pool == 0) { return STIVA_ERR_NETWORK; }

    # Try to create the bridge interface (requires root). On failure the Rust
    # logged a warn and continued with bridge_created = false.
    var br = create_bridge(name, ip_pool_gateway(pool), ip_pool_prefix_len(pool));
    var bridge_created = 0;
    if (br == STIVA_ERR_OK) {
        sakshi_info("bridge network created", strlen("bridge network created"));
        bridge_created = 1;
    } else {
        sakshi_warn("bridge creation skipped, requires root (roadmap v3.0.17 item 2):",
          strlen("bridge creation skipped, requires root (roadmap v3.0.17 item 2):"));
    }

    map_set(mgr.networks, name, _managed_network_new(pool, bridge_created));
    return STIVA_ERR_OK;
}

# Count the connections whose network_name == `name` (rust-old: the
# `connected` Vec filter/collect, used only for its length here).
#[must_use]
fn _network_manager_connected_count(m, name) {
    var mgr: NetworkManager = m;
    var ids = map_keys(mgr.connections);
    var n = vec_len(ids);
    var count = 0;
    var i = 0;
    while (i < n) {
        var id = vec_get(ids, i);
        var cn: ContainerNetwork = map_get(mgr.connections, id);
        if (streq(cn.network_name, name) == 1) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

# Delete a named network (rust-old: delete_network). Returns STIVA_ERR_OK on
# success, or STIVA_ERR_NETWORK if the network is unknown or still has
# containers connected (in which case the network is left in place, matching
# the Rust "put network back" behaviour). The bridge delete is best-effort.
fn network_manager_delete_network(m, name) {
    var mgr: NetworkManager = m;

    if (map_has(mgr.networks, name) == 0) {
        # "network '{name}' not found"
        return STIVA_ERR_NETWORK;
    }

    # Check no containers are connected.
    var connected = _network_manager_connected_count(m, name);
    if (connected > 0) {
        # Network stays registered (Rust removed then re-inserted on error);
        # here we never removed it, so it is already "put back".
        # "cannot delete network '{name}': {connected} containers connected"
        return STIVA_ERR_NETWORK;
    }

    map_delete(mgr.networks, name);
    var _r = delete_bridge(name);      # best-effort (Rust: `let _ = ...`)
    sakshi_info("network deleted", strlen("network deleted"));
    return STIVA_ERR_OK;
}

# Connect a container to a network (rust-old: connect_container).
# Allocates an IP, creates a veth pair, attaches to the bridge, applies NAT
# rules for any port specs, and injects DNS into the rootfs when supplied.
# Returns the ContainerNetwork ptr on success, or 0 on failure (unknown
# network, IP exhausted, or an invalid port spec).
#
# Params:
#   m            : NetworkManager ptr
#   container_id : cstr
#   network_name : cstr
#   port_specs   : vec of cstr port-spec strings (may be empty)
#   rootfs       : cstr rootfs path, or 0 for None
#[must_use]
fn network_manager_connect_container(m, container_id, network_name, port_specs, rootfs) {
    var mgr: NetworkManager = m;

    var mn = map_get(mgr.networks, network_name);
    if (mn == 0) {
        # "network '{network_name}' not found"
        return 0;
    }
    var network: ManagedNetwork = mn;

    # Allocate IP (u32 host value). -1 on exhaustion → propagate as failure.
    var ip = ip_pool_allocate(network.pool);
    if (ip < 0) { return 0; }

    # Create veth pair. On failure (requires root) keep the IP allocated and
    # fall back to a synthesized host name + "eth0" container end.
    var host_veth = create_veth_pair(container_id);
    var container_veth = container_veth_name();      # always "eth0"
    if (host_veth == 0) {
        # ve-<first up-to-12 chars of id> — same as bridge.cyr host_veth_name.
        sakshi_warn("veth creation skipped, requires root (roadmap v3.0.17 item 2):",
          strlen("veth creation skipped, requires root (roadmap v3.0.17 item 2):"));
        host_veth = host_veth_name(container_id);
    }

    # Attach host side to bridge (best-effort; Rust `let _ = ...`).
    var _a = attach_to_bridge(host_veth, network_name);

    # Parse port mappings and apply NAT rules via nein. An invalid port spec
    # is a hard error (Rust `?`), releasing nothing (the IP stays allocated,
    # matching the Rust which returns Err after the `pool.allocate()?`).
    if (vec_len(port_specs) > 0) {
        var subnet = ip_pool_subnet(network.pool);
        var bridge_cfg = network_nat_bridge_config(network_name, subnet, mgr.outbound_iface);
        var bf = bridge_firewall_new(bridge_cfg);

        var np = vec_len(port_specs);
        var i = 0;
        while (i < np) {
            var spec = vec_get(port_specs, i);
            var port_spec = network_nat_parse_port_spec(spec);
            if (port_spec == 0) {
                # Invalid port spec (Rust: Err(StivaError::PortMapping(...))).
                return 0;
            }
            var mapping = network_nat_to_nein_port_mapping(port_spec, ip);
            var addres = bf_add_port_mapping(bf, mapping);
            if (is_err_result(addres) == 1) {
                # "port mapping error: {e}" (Rust mapped to StivaError::Network).
                return 0;
            }
            i = i + 1;
        }

        var fw = bf_to_firewall(bf);
        if (is_err_result(firewall_validate(fw)) == 1) {
            # "firewall validation failed: {e}" — warn only, non-fatal (Rust).
            sakshi_warn("firewall validation failed:", strlen("firewall validation failed:"));
        } else {
            _network_manager_apply_nft_ruleset(firewall_render(fw));
        }
    }

    # Inject DNS into container rootfs if available (all best-effort).
    if (rootfs != 0) {
        var dns = network_dns_host_servers();
        var _d1 = network_dns_inject_resolv_conf(rootfs, dns);
        var hostname = host_veth_name_trunc(container_id);   # first up-to-12 chars
        var _d2 = network_dns_inject_hosts(rootfs, ip, hostname);
        var _d3 = network_dns_inject_hostname(rootfs, hostname);
    }

    var cn = container_network_new(ip, 0, network_name, host_veth, container_veth);
    map_set(mgr.connections, container_id, cn);
    sakshi_info("container connected to network", strlen("container connected to network"));
    return cn;
}

# First up-to-12 chars of `container_id` as a fresh cstr — the hostname the
# Rust derived via `container_id[..12.min(len)]`. (bridge.cyr's host_veth_name
# prepends "ve-"; this is the bare truncation the DNS path needs.)
#[must_use]
fn host_veth_name_trunc(container_id) {
    var n = strlen(container_id);
    var take = n;
    if (take > 12) { take = 12; }
    var out = alloc(take + 1);
    memcpy(out, container_id, take);
    store8(out + take, 0);
    return out;
}

# Disconnect a container from its network (rust-old: disconnect_container).
# Releases the IP back to its pool and deletes the veth pair (best-effort).
# Returns STIVA_ERR_OK on success, or STIVA_ERR_NETWORK if the container is
# not connected to any network.
fn network_manager_disconnect_container(m, container_id) {
    var mgr: NetworkManager = m;

    var cnp = map_get(mgr.connections, container_id);
    if (cnp == 0) {
        # "container '{container_id}' not connected to any network"
        return STIVA_ERR_NETWORK;
    }
    var cn: ContainerNetwork = cnp;
    map_delete(mgr.connections, container_id);

    # Release IP back to pool (if the network still exists).
    var mn = map_get(mgr.networks, cn.network_name);
    if (mn != 0) {
        var network: ManagedNetwork = mn;
        var _r = ip_pool_release(network.pool, cn.ip);
    }

    # Delete veth pair (best-effort; errors ignored — "if already gone, ignore").
    var _v = delete_veth(cn.host_veth);
    sakshi_info("container disconnected from network", strlen("container disconnected from network"));
    return STIVA_ERR_OK;
}

# Resolve which network name to use for a NetworkMode (rust-old:
# resolve_network_name). Returns a name cstr, or 0 for None (Host / None /
# Container(_) use no managed network). `mode` is a NetworkModeVal ptr
# (network_mod.cyr).
#[must_use]
fn network_manager_resolve_network_name(m, mode) {
    var mv: NetworkModeVal = mode;
    if (mv.tag == NETWORK_MODE_BRIDGE) { return network_manager_default_bridge(); }
    if (mv.tag == NETWORK_MODE_CUSTOM) { return mv.value; }
    # Host | None | Container(_) → None.
    return 0;
}

# Get the connection info for a container (rust-old: get_connection).
# Returns the ContainerNetwork ptr, or 0 if not connected.
#[must_use]
fn network_manager_get_connection(m, container_id) {
    var mgr: NetworkManager = m;
    return map_get(mgr.connections, container_id);
}

# List all network names (rust-old: list_networks -> Vec<&str>). Returns a vec
# of name cstrs (map iteration order is unspecified, as in Rust).
#[must_use]
fn network_manager_list_networks(m) {
    var mgr: NetworkManager = m;
    return map_keys(mgr.networks);
}

# True (1) iff a network with `name` is registered — helper for the
# `list_networks().contains(...)` assertions the Rust tests use.
#[must_use]
fn network_manager_has_network(m, name) {
    var mgr: NetworkManager = m;
    return map_has(mgr.networks, name);
}

# Get the IP pool ptr for a network, for inspection (rust-old: get_pool).
# Returns the IpPool ptr, or 0 if the network is unknown.
#[must_use]
fn network_manager_get_pool(m, network_name) {
    var mgr: NetworkManager = m;
    var mn = map_get(mgr.networks, network_name);
    if (mn == 0) { return 0; }
    var network: ManagedNetwork = mn;
    return network.pool;
}

# ── nftables apply (rust-old: fn apply_nft_ruleset) ──────────────
# Rust spawned `nft -f -`, piped the ruleset to its stdin, and waited —
# synchronous, best-effort (all failures logged, never returned). Cyrius's
# exec_vec has no stdin-piping surface, so we write the rendered ruleset to a
# temp file and run `nft -f <file>` (semantically identical: nft reads the
# ruleset from the given path instead of stdin). Every failure is swallowed,
# matching the Rust warn-only contract. `ruleset` is a Str (firewall_render).
fn _network_manager_apply_nft_ruleset(ruleset) {
    var path = "/tmp/stiva-nft-ruleset.nft";
    var w = file_write_all(path, str_data(ruleset), str_len(ruleset));
    if (w < 0) { return 0; }            # can't stage ruleset — non-fatal

    var nft = _network_manager_nft_bin();
    var args = vec_new();
    vec_push(args, nft);
    vec_push(args, "-f");
    vec_push(args, path);
    var _rc = exec_vec(args);           # best-effort; ignore exit code
    sakshi_debug("applied nftables ruleset", strlen("applied nftables ruleset"));
    return 0;
}

# Resolve the `nft` binary path (execve needs an absolute path; exec_vec does
# no $PATH lookup). nftables installs at /usr/sbin/nft on modern distros.
#[must_use]
fn _network_manager_nft_bin() {
    if (file_exists("/usr/sbin/nft") == 1) { return "/usr/sbin/nft"; }
    if (file_exists("/sbin/nft") == 1) { return "/sbin/nft"; }
    if (file_exists("/usr/bin/nft") == 1) { return "/usr/bin/nft"; }
    return "nft";
}

# --- image.cyr ---

# stiva — OCI image management: reference parsing, structs, blob store.
# Ported from rust-old/src/image.rs.
#
# What ports cleanly here (self-contained or blob-store-only):
#   struct ImageRef { registry, repository, tag, digest }  + parse + full_ref
#   struct Layer    { digest, size_bytes, media_type }
#   struct Image    { id, reference, size_bytes, layers, created_at }
#   sha256_digest, digest_hex        (pure digest helpers)
#   ImageStore::new / root / store_blob / has_blob / read_blob
#     (the content-addressable blob store — no JSON, just files)
#
# What lives HERE (the substrate): the structs + reference parsing, the pure
#   digest helpers, the content-addressable blob store (new / root / store_blob /
#   has_blob / read_blob / blob_size), and verify_integrity (a format-agnostic
#   blob re-hash).
#
# The image-set / index layer MOVED to imagelayout.cyr (A2, v3.0.1): the store is
#   now a valid OCI image layout (oci-layout + index.json + blobs/sha256), so
#   load_index / add_to_index / list / remove / gc / import / tag reconstruct
#   Image records from on-disk OCI manifest + config blobs. The legacy ad-hoc
#   `images.json` index is RETIRED.
#
# What moved to the NETWORK layer (see the block at the bottom):
#   * pull / push landed with roadmap §B (v3.0.9) as image_store_pull /
#     image_store_push in imagelayout.cyr — include order puts registry.cyr
#     first, so the driver has to sit downstream of both.
#   * verify_signature is §B Inc-9; fetch_foreign_layer is deliberately NOT
#     ported (SSRF on registry-controlled data — see the §B Inc-7 divergence).
#
# Error mapping (mirrors error.cyr): Rust `Err(StivaError::X(String))`
# becomes an integer sentinel here — parse() returns 0 (null) on an
# invalid reference; the caller reports it via
# stiva_err_print(STIVA_ERR_INVALID_REFERENCE, detail). store_blob returns
# 0 on a digest mismatch (caller: STIVA_ERR_DIGEST_MISMATCH). read_blob
# returns 0 when the blob is absent (caller: STIVA_ERR_IMAGE_NOT_FOUND).

# ── small cstr helpers (parity-exact byte handling) ──────────────

# True (1) iff byte `c` is ASCII whitespace stripped by Rust str::trim
# (space, tab, CR, LF). Image refs are ASCII in practice.
#[must_use]
fn _img_is_ws(c) {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    if (c == 10) { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

# Copy bytes [start, end) of `src` into a fresh NUL-terminated cstr.
# Returns the heap pointer (empty cstr if end <= start).
#[must_use]
fn _img_slice(src, start, end) {
    var n = end - start;
    if (n < 0) { n = 0; }
    var out = alloc(n + 1);
    memcpy(out, src + start, n);
    store8(out + n, 0);
    return out;
}

# Fresh copy of a NUL-terminated cstr.
#[must_use]
fn _img_dup(s) {
    return _img_slice(s, 0, strlen(s));
}

# Trim leading+trailing ASCII whitespace, returning a fresh cstr.
#[must_use]
fn _img_trim(s) {
    var len = strlen(s);
    var start = 0;
    while (start < len) {
        if (_img_is_ws(load8(s + start)) == 0) { break; }
        start = start + 1;
    }
    var end = len;
    while (end > start) {
        if (_img_is_ws(load8(s + end - 1)) == 0) { break; }
        end = end - 1;
    }
    return _img_slice(s, start, end);
}

# Index of the first `byte` in `s`, or -1 (mirrors str::find / split_once).
#[must_use]
fn _img_find(s, byte) {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (load8(s + i) == byte) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Index of the last `byte` in `s`, or -1 (mirrors str::rfind / rsplit_once).
#[must_use]
fn _img_rfind(s, byte) {
    var len = strlen(s);
    var i = len - 1;
    while (i >= 0) {
        if (load8(s + i) == byte) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

# True (1) iff `s` contains `byte` anywhere.
#[must_use]
fn _img_contains(s, byte) {
    if (_img_find(s, byte) >= 0) { return 1; }
    return 0;
}

# Concatenate two cstrs into a fresh heap cstr.
#[must_use]
fn _img_cat2(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    var out = alloc(la + lb + 1);
    memcpy(out, a, la);
    memcpy(out + la, b, lb);
    store8(out + la + lb, 0);
    return out;
}

# Concatenate three cstrs into a fresh heap cstr.
#[must_use]
fn _img_cat3(a, b, c) {
    var la = strlen(a);
    var lb = strlen(b);
    var lc = strlen(c);
    var out = alloc(la + lb + lc + 1);
    memcpy(out, a, la);
    memcpy(out + la, b, lb);
    memcpy(out + la + lb, c, lc);
    store8(out + la + lb + lc, 0);
    return out;
}

# ── ImageRef ───────────────────────────
# A parsed image reference. `digest` is a cstr or 0 for None.
struct ImageRef {
    registry;
    repository;
    tag;
    digest;
}

# Parse an image reference string (rust-old: ImageRef::parse).
#
# Supports: `nginx`, `nginx:1.25`, `user/repo:tag`, `ghcr.io/user/repo:tag`,
# `localhost:5000/repo:tag`, `repo@sha256:...`.
#
# Returns a heap `ImageRef*` on success, or 0 on an empty reference /
# empty repository (rust-old: Err(StivaError::InvalidReference(...))). The
# caller reports the null via stiva_err_print(STIVA_ERR_INVALID_REFERENCE,
# ...).
#[must_use]
fn image_ref_parse(reference) {
    var trimmed = _img_trim(reference);
    if (load8(trimmed) == 0) { return 0; }

    # Handle digest references (repo@sha256:...).
    var digest = 0;
    var ref_wo_digest = trimmed;
    var at = _img_find(trimmed, 64);
    if (at >= 0) {
        ref_wo_digest = _img_slice(trimmed, 0, at);
        digest = _img_slice(trimmed, at + 1, strlen(trimmed));
    }

    # Split tag — but only if the colon comes after the last slash (so a
    # port like localhost:5000 is not confused with a tag).
    var ref_wo_tag = 0;
    var tag = 0;
    var slash_pos = _img_rfind(ref_wo_digest, 47);
    if (slash_pos >= 0) {
        var after_start = slash_pos + 1;
        # after_slash = ref_wo_digest[slash_pos+1..]; look for its last ':'.
        var after_len = strlen(ref_wo_digest) - after_start;
        var colon_in_after = 0 - 1;
        var j = after_start;
        while (j < strlen(ref_wo_digest)) {
            if (load8(ref_wo_digest + j) == 58) { colon_in_after = j; }
            j = j + 1;
        }
        if (colon_in_after >= 0) {
            # before = ref_wo_digest[..slash_pos+1]; name = after_slash up to colon.
            ref_wo_tag = _img_slice(ref_wo_digest, 0, colon_in_after);
            tag = _img_slice(ref_wo_digest, colon_in_after + 1, strlen(ref_wo_digest));
        } else {
            ref_wo_tag = _img_dup(ref_wo_digest);
            tag = _img_dup("latest");
        }
    } else {
        # No slash at all — simple name or name:tag (rsplit at last ':').
        var last_colon = _img_rfind(ref_wo_digest, 58);
        if (last_colon >= 0) {
            ref_wo_tag = _img_slice(ref_wo_digest, 0, last_colon);
            tag = _img_slice(ref_wo_digest, last_colon + 1, strlen(ref_wo_digest));
        } else {
            ref_wo_tag = _img_dup(ref_wo_digest);
            tag = _img_dup("latest");
        }
    }

    # Split registry from repository. A first component is a registry if it
    # contains a dot or colon (port).
    var registry = 0;
    var repository = 0;
    var first_slash = _img_find(ref_wo_tag, 47);
    if (first_slash >= 0) {
        var first = _img_slice(ref_wo_tag, 0, first_slash);
        var rest = _img_slice(ref_wo_tag, first_slash + 1, strlen(ref_wo_tag));
        if (_img_contains(first, 46) == 1 || _img_contains(first, 58) == 1) {
            registry = first;
            repository = rest;
        } else {
            # No dot/colon in first segment → Docker Hub user/repo.
            registry = _img_dup("docker.io");
            repository = _img_dup(ref_wo_tag);
        }
    } else {
        # Bare name like "nginx" → docker.io/library/nginx.
        registry = _img_dup("docker.io");
        repository = _img_cat2("library/", ref_wo_tag);
    }

    if (load8(repository) == 0) { return 0; }

    var r = alloc(32);
    var rr: ImageRef = r;
    rr.registry = registry;
    rr.repository = repository;
    rr.tag = tag;
    rr.digest = digest;
    return r;
}

# Full reference string "{registry}/{repository}:{tag}" (rust-old: full_ref).
#[must_use]
fn image_ref_full_ref(ref) {
    var rr: ImageRef = ref;
    # An empty registry → "repository:tag" (no spurious leading '/'); this stays
    # the exact inverse of imagelayout's _il_parse_full_ref for registry-less refs.
    if (strlen(rr.registry) == 0) {
        return _img_cat3(rr.repository, ":", rr.tag);
    }
    var reg_slash = _img_cat2(rr.registry, "/");
    var reg_repo = _img_cat2(reg_slash, rr.repository);
    return _img_cat3(reg_repo, ":", rr.tag);
}

# ── Layer / Image ─────────────────────────

# An image layer (rust-old: struct Layer).
struct Layer {
    digest;
    size_bytes;
    media_type;
}

fn layer_new(digest, size_bytes, media_type) {
    var l = alloc(24);
    var ll: Layer = l;
    ll.digest = digest;
    ll.size_bytes = size_bytes;
    ll.media_type = media_type;
    return l;
}

# A locally stored OCI image (rust-old: struct Image). `layers` is a vec
# of Layer*; `created_at` is an epoch-seconds i64 (chrono::DateTime in Rust).
# `manifest_digest` (A2, appended at offset 40) is the "sha256:{hex}" digest of
# this image's OCI manifest blob (0 before the store assembles one). It anchors it in
# the on-disk `index.json` descriptor list and is a GC root alongside `id` (the
# config digest) and the layer digests. `image_new` leaves it 0; the OCI store
# layer (imagelayout.cyr) sets it on import / reconstructs it on load.
struct Image {
    id;
    reference;
    size_bytes;
    layers;
    created_at;
    manifest_digest;
}

fn image_new(id, reference, size_bytes, layers, created_at) {
    var im = alloc(48);
    var ii: Image = im;
    ii.id = id;
    ii.reference = reference;
    ii.size_bytes = size_bytes;
    ii.layers = layers;
    ii.created_at = created_at;
    store64(im + 40, 0);      # manifest_digest @40 — raw store (see _img_set_manifest_digest)
    return im;
}

# ── Digest helpers ─────────────────────────

# Compute `sha256:{hex}` digest for `len` bytes at `data`
# (rust-old: sha256_digest). Returns a fresh heap cstr of length 7+64.
#[must_use]
fn sha256_digest(data, len) {
    var hex = sha256_hex(data, len);   # 64-char lowercase hex cstr
    return _img_cat2("sha256:", hex);
}

# Extract the hex portion from a `sha256:{hex}` digest (rust-old:
# digest_hex). Returns a pointer INTO `digest` just past the "sha256:"
# prefix when present, else `digest` itself (borrow, no allocation).
#[must_use]
fn digest_hex(digest) {
    if (strlen(digest) >= 7 && memeq(digest, "sha256:", 7) == 1) {
        return digest + 7;
    }
    return digest;
}

# ── ImageStore ──────────────────────────
# Local image storage with content-addressable blob store. Only the
# `root` path is held (rust-old: struct ImageStore { root }).
#
# The store is an 8-byte heap cell holding the root cstr pointer. A
# SINGLE-field struct is deliberately NOT used: Cyrius miscompiles
# field access through a pointer-annotated local for a 1-field struct
# (it scalar-replaces the sole field into a register, so `s.root = v`
# never reaches memory). We use explicit load64/store64 on the cell,
# via the _img_store_root helper, to sidestep that.

# Root cstr for a store cell.
#[must_use]
fn _img_store_root(store) {
    return load64(store);
}

# 1 when `digest` is exactly "sha256:" + 64 lowercase hex digits.
#
# SECURITY, load-bearing: a digest becomes a FILESYSTEM PATH via _img_blob_path,
# and once §B landed, digests arrive from a remote registry's manifest JSON. An
# unvalidated `"digest": "sha256:../../../../etc/shadow"` turns the blob store
# into an arbitrary-file-read (`has_blob` reports it present, so the pull
# "succeeds" without ever downloading or verifying anything, and `push` then
# uploads that file to a registry) and, via the `.dl`/`.tmp` scratch names, an
# arbitrary-file-truncate. Lowercase-only is deliberate: the OCI image-spec
# requires the lowercase form, and accepting both would make one blob addressable
# by two distinct paths.
#[must_use]
fn digest_is_valid(digest) {
    if (digest == 0) { return 0; }
    if (strlen(digest) != 71) { return 0; }
    if (memeq(digest, "sha256:", 7) == 0) { return 0; }
    var i = 7;
    while (i < 71) {
        var c = load8(digest + i);
        var ok = 0;
        if (c >= 48 && c <= 57) { ok = 1; }        # 0-9
        if (c >= 97 && c <= 102) { ok = 1; }       # a-f
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Path "{root}/blobs/sha256/{hex}" for a `sha256:{hex}` digest, or 0 when the
# digest is not a well-formed one. Fails CLOSED — see digest_is_valid. Callers
# must treat 0 as "no such blob"; every one in-tree does.
#[must_use]
fn _img_blob_path(root, digest) {
    if (digest_is_valid(digest) == 0) { return 0; }
    var hex = digest_hex(digest);
    var base = _img_cat2(root, "/blobs/sha256/");
    return _img_cat2(base, hex);
}

# Open or create an image store (rust-old: ImageStore::new). Creates the
# root and the blobs/sha256, manifests, and layers subdirectories
# (create_dir_all analogues; EEXIST ignored — idempotent). Returns a
# heap ImageStore*, or 0 if the root could not be created.
fn image_store_new(root) {
    # 0o755 = 493. create_dir_all recurses in Rust; here we create each
    # level in order so nested paths succeed even from a fresh root.
    sys_mkdir(root, 493);
    var blobs = _img_cat2(root, "/blobs");
    sys_mkdir(blobs, 493);
    var blobs_sha = _img_cat2(root, "/blobs/sha256");
    sys_mkdir(blobs_sha, 493);
    var manifests = _img_cat2(root, "/manifests");
    sys_mkdir(manifests, 493);
    var layers = _img_cat2(root, "/layers");
    sys_mkdir(layers, 493);

    # Rust ImageStore::new propagates create_dir_all failures via `?`. sys_mkdir
    # returns -EEXIST for an already-present dir (idempotent, fine) and other
    # negatives for real failures — rather than decode errno, verify the three
    # required dirs exist; if any is missing, creation genuinely failed → 0.
    if (file_exists(blobs_sha) == 0) { return 0; }
    if (file_exists(manifests) == 0) { return 0; }
    if (file_exists(layers) == 0) { return 0; }

    var s = alloc(8);
    store64(s, _img_dup(root));
    return s;
}

# Get image storage root (rust-old: root).
#[must_use]
fn image_store_root(store) {
    return _img_store_root(store);
}

# Check whether a blob exists locally (rust-old: has_blob). Returns 1/0.
#[must_use]
fn image_store_has_blob(store, digest) {
    var path = _img_blob_path(_img_store_root(store), digest);
    if (path == 0) { return 0; }
    return file_exists(path);
}

# Store a blob by its expected digest, verifying SHA-256
# (rust-old: store_blob). On success returns the blob path cstr.
# On a digest mismatch returns 0 (rust-old: Err(DigestMismatch); caller
# maps to STIVA_ERR_DIGEST_MISMATCH). Dedup: if the path already exists,
# returns the path without rewriting.
fn image_store_store_blob(store, digest, data, len) {
    sakshi_debug("storing blob", strlen("storing blob"));
    var path = _img_blob_path(_img_store_root(store), digest);
    if (path == 0) { return 0; }

    # Dedup: skip if already present.
    if (file_exists(path) == 1) { return path; }

    # Verify digest.
    var actual = sha256_digest(data, len);
    if (streq(actual, digest) == 0) { return 0; }

    # Write atomically via temp file + rename.
    var tmp = _img_cat2(path, ".tmp");
    if (file_write_all(tmp, data, len) < 0) { return 0; }
    if (sys_rename(tmp, path) < 0) { return 0; }
    return path;
}

# Read a blob from the store (rust-old: read_blob). Fills up to `maxlen`
# bytes into `buf`; returns the byte count read, or -1 when the blob is
# absent (rust-old: Err(ImageNotFound); caller maps -1 →
# STIVA_ERR_IMAGE_NOT_FOUND) / on any read failure.
fn image_store_read_blob(store, digest, buf, maxlen) {
    sakshi_debug("reading blob", strlen("reading blob"));
    var path = _img_blob_path(_img_store_root(store), digest);
    if (path == 0) { return 0 - 1; }
    if (file_exists(path) == 0) { return 0 - 1; }
    return file_read_all(path, buf, maxlen);
}

# Byte length of a stored blob (SEEK_END), or -1 if absent/unopenable. Used by
# the OCI index writer (imagelayout.cyr) to fill a manifest descriptor's `size`.
#[must_use]
fn image_store_blob_size(store, digest) {
    var path = _img_blob_path(_img_store_root(store), digest);
    if (path == 0) { return 0 - 1; }
    var fd = file_open(path, 0, 0);            # O_RDONLY
    if (fd < 0) { return 0 - 1; }
    var size = xlseek(fd, 0, 2);               # SEEK_END → byte length
    file_close(fd);
    return size;
}

# ── images.json index (serde_json Vec<Image> round-trip in Rust) ─
# Ported onto the bayan JSON codec (lib/bayan.cyr, json_v_* value model).
# The index is a JSON ARRAY of image objects, each shaped exactly like the
# Rust serde output:
#   { "id": str,
#     "reference": { "registry": str, "repository": str,
#                    "tag": str, "digest": str|null },
#     "size_bytes": int,
#     "layers": [ { "digest": str, "size_bytes": int,
#                   "media_type": str }, ... ],
#     "created_at": int }              # epoch-seconds i64 (chrono in Rust)
#
# Cyrius/bayan bridging notes:
#   * bayan builds/parses a tagged value tree of Str fat-pointers; this
#     module holds cstr pointers. We convert cstr→Str via str_from(...)
#     when building, and Str→cstr via str_cstr(...) when parsing back
#     (so downstream image.cyr code keeps its cstr contract).
#   * json_v_obj_set keys are Str (the serializer reads them via
#     str_data/str_len); json_v_obj_get keys are cstr (it strlen()s them).
#   * A missing/absent index file is Rust `Ok(vec![])` → we return a fresh
#     empty vec, never an error sentinel.

# Read the `reference` field (ImageRef*) of an Image*. A 5-field struct is
# safe to access through a pointer-annotated local, but this named helper
# keeps the index code readable and localizes the field layout.
#[must_use]
fn _image_reference(image) {
    var ii: Image = image;
    return ii.reference;
}

# manifest_digest lives at offset 40 (Image's 6th field). Access it via raw
# load64/store64 rather than the struct field: cycc miscompiles this field's
# access in SOME function contexts (a struct-id collision — the same class as
# the ImageStore single-field workaround above), reading/writing garbage while
# other contexts compile it fine. The raw offset is always correct, so every
# manifest_digest read/write routes through these two accessors.
#[must_use]
fn _img_manifest_digest(image) {
    return load64(image + 40);
}

fn _img_set_manifest_digest(image, digest) {
    store64(image + 40, digest);
    return 0;
}

# Raw-offset accessors for Image.id (@0) and Image.layers (@24), and Layer.digest
# (@0). Same cycc-miscompile guard as _img_manifest_digest: some function
# contexts (e.g. image_store_save_archive) miscompile the struct-field access to
# these fields, so callers in those contexts read them via these accessors.
#[must_use]
fn _img_id(image) {
    return load64(image + 0);
}

#[must_use]
fn _img_layers(image) {
    return load64(image + 24);
}

#[must_use]
fn _layer_digest(layer) {
    return load64(layer + 0);
}

# Read the whole file at `path` into a fresh buffer (SEEK_END-sized, so no
# maxlen truncation — an integrity check must hash the ENTIRE blob, and layer
# blobs can exceed image_import's 64 MiB read cap). Writes the byte length to
# `out_len`; returns the buffer, or 0 (out_len < 0) on open/seek failure.
# Mirrors storage.cyr's _stor_read_file, kept local to image.cyr.
fn _img_read_file(path, out_len) {
    var fd = file_open(path, 0, 0);            # O_RDONLY
    if (fd < 0) { store64(out_len, fd); return 0; }
    var size = xlseek(fd, 0, 2);               # SEEK_END → byte length
    xlseek(fd, 0, 0);                          # SEEK_SET → rewind
    if (size < 0) { file_close(fd); store64(out_len, 0 - 1); return 0; }
    var buf = alloc(size + 1);
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(fd, buf + total, size - total);
        if (n <= 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= size) { rgo = 0; }
        }
    }
    file_close(fd);
    store64(out_len, total);
    return buf;
}

# Verify blob integrity: walk {root}/blobs/sha256, re-hash each blob, and
# compare against its content-addressed name (rust-old: verify_integrity).
# Returns a vec of the "sha256:<hex>" digests whose contents mismatch, or that
# could not be read. An empty vec means every blob verified.
fn image_store_verify_integrity(store) {
    sakshi_info("verifying blob integrity", strlen("verifying blob integrity"));
    var root = _img_store_root(store);
    var corrupted = vec_new();
    var blobs_dir = _img_cat2(root, "/blobs/sha256");
    var entries = dir_list(str_from(blobs_dir));
    var ne = vec_len(entries);
    var ei = 0;
    while (ei < ne) {
        var hex = str_cstr(vec_get(entries, ei));
        var expected = _img_cat2("sha256:", hex);
        var blob_path = _img_cat2(_img_cat2(blobs_dir, "/"), hex);
        var len_cell = alloc(8);
        var data = _img_read_file(blob_path, len_cell);
        var n = load64(len_cell);
        if (data == 0) {
            vec_push(corrupted, expected);
        } else {
            var actual = sha256_digest(data, n);
            if (streq(actual, expected) == 0) { vec_push(corrupted, expected); }
        }
        ei = ei + 1;
    }
    return corrupted;
}

# ── ImageRef constructor + import + tag ─────────────────────────

# Construct an ImageRef directly (rust-old: ImageRef { .. }). Kept here in
# image.cyr (where the struct is defined) so field access resolves correctly.
#[must_use]
fn image_ref_new(registry, repository, tag, digest) {
    var r = alloc(32);
    var rr: ImageRef = r;
    rr.registry = registry;
    rr.repository = repository;
    rr.tag = tag;
    rr.digest = digest;
    return r;
}

# ── Network layer: where the rest of rust-old/src/image.rs went ──
# gc / verify_integrity are ported: verify_integrity (re-read + re-hash every
# blob) lives here; gc + remove + the index/import/tag layer moved to
# imagelayout.cyr (A2).
#
# The registry-driven half landed with roadmap §B (v3.0.9) and lives in
# imagelayout.cyr, because include order puts registry.cyr BEFORE it:
#   rust-old `async fn pull`  → image_store_pull(client, store, ref)
#   rust-old `async fn push`  → image_store_push(client, store, ref_or_id, target)
#
# Still unported from rust-old/src/image.rs, both deliberate:
#   `verify_signature` — roadmap §B Inc-9 (discovery / referrers).
#   `fetch_foreign_layer` — NOT being ported. It follows a descriptor's `urls`
#     to an arbitrary external host on registry-controlled data; image_store_pull
#     refuses foreign layers instead. See the roadmap §B Inc-7 divergence note.

# --- registry.cyr ---

# stiva — OCI registry client: manifests, descriptors, platform selection.
# Ported from rust-old/src/registry.rs.
#
# registry.rs is overwhelmingly a networked async HTTP client built on
# reqwest + tokio (RwLock, Instant) + serde_json. None of that transport,
# concurrency, or JSON-model machinery exists in the ported base, so every
# RegistryClient method (fetch_manifest, resolve_manifest, fetch_blob,
# blob_exists, push_blob, push_blob_chunked, push_manifest, list_tags,
# catalog, referrers, authenticated_request, acquire_token, token cache) —
# plus the serde load/save of CredentialStore — lands in the DEFERRED block
# at the bottom (same pattern as src/oci.cyr / src/convert.cyr).
#
# What ports faithfully here is the SELF-CONTAINED leaf surface:
#   * media-type constants (functions returning the wire strings)
#   * the descriptor / manifest / index / platform data types
#   * ManifestResponse tag enum
#   * registry_host, normalize_arch, current_platform, select_platform
#   * parse_www_authenticate (pure cstr parsing → key/value store)
#
# i64-everywhere representation:
#   * cstrings for all wire strings (media types, digests, os/arch).
#   * `Option<String>` maps to a cstr pointer, 0 for None.
#   * `u64 size` carried in an i64.
#   * `Vec<String>` (urls) and Vec<Descriptor> (layers/manifests) map to
#     vec.cyr vectors of cstr / struct pointers; 0 vec pointer means None.
#
# Error mapping (mirrors error.cyr): the Rust
# `Err(StivaError::UnsupportedPlatform(...))` from select_platform maps to
# the sentinel `0` (null PlatformManifest pointer); the caller reports it
# via stiva_err_print(STIVA_ERR_UNSUPPORTED_PLATFORM, "<os>/<arch>").
#
# `alloc_init()` must have been called once before any type is constructed.

# ── media types (rust-old: MEDIA_* consts) ─────────────────
#[must_use]
fn media_manifest_v2() {
    return "application/vnd.docker.distribution.manifest.v2+json";
}

#[must_use]
fn media_manifest_list_v2() {
    return "application/vnd.docker.distribution.manifest.list.v2+json";
}

#[must_use]
fn media_oci_manifest() {
    return "application/vnd.oci.image.manifest.v1+json";
}

#[must_use]
fn media_oci_index() {
    return "application/vnd.oci.image.index.v1+json";
}

# OCI layer media type for zstd-compressed tar archives.
#[must_use]
fn media_oci_layer_zstd() {
    return "application/vnd.oci.image.layer.v1.tar+zstd";
}

# Media type for empty OCI config (used in artifact manifests).
#[must_use]
fn media_oci_empty() {
    return "application/vnd.oci.empty.v1+json";
}

# OCI image config media type (the config blob referenced by a manifest).
#[must_use]
fn media_oci_config() {
    return "application/vnd.oci.image.config.v1+json";
}

# OCI layer media type for gzip-compressed tar archives (stiva builds gzip;
# zstd is the v3.1 upstream residue — see media_oci_layer_zstd).
#[must_use]
fn media_oci_layer() {
    return "application/vnd.oci.image.layer.v1.tar+gzip";
}

# ── ManifestResponse tag (rust-old: enum ManifestResponse) ──────
# Fetched manifest — either a single manifest or an index. Prefixed
# REGISTRY_MANIFEST_* for global enum-member uniqueness (see error.cyr).
enum ManifestResponse {
    REGISTRY_MANIFEST_RESPONSE_MANIFEST = 0;
    REGISTRY_MANIFEST_RESPONSE_INDEX = 1;
}

# ── Descriptor (rust-old: struct Descriptor) ────────────────
# media_type  : cstr — content media type
# digest      : cstr — content digest
# size        : i64  — content size in bytes (u64 in Rust)
# urls        : vec ptr of cstr, or 0 for None — foreign-layer external URLs
# annotations : vec ptr, or 0 for None — descriptor annotations
struct Descriptor {
    media_type;
    digest;
    size;
    urls;
    annotations;
}

# Create a new descriptor with required fields only (rust-old: Descriptor::new).
#[must_use]
fn descriptor_new(media_type, digest, size) {
    var d = alloc(40);
    var dd: Descriptor = d;
    dd.media_type = media_type;
    dd.digest = digest;
    dd.size = size;
    dd.urls = 0;
    dd.annotations = 0;
    return d;
}

# Create a foreign layer descriptor with external URLs (rust-old: Descriptor::foreign).
# `urls` is a vec.cyr vector of cstr pointers.
#[must_use]
fn descriptor_foreign(media_type, digest, size, urls) {
    var d = descriptor_new(media_type, digest, size);
    var dd: Descriptor = d;
    dd.urls = urls;
    return d;
}

# Descriptor → JTAG_OBJ json value (OCI content descriptor). Emits the
# canonical key order `mediaType, digest, size, [urls]` — insertion order is
# preserved by bayan, so the bytes (and any content-address over them) are
# deterministic. `annotations` are attached by the index/manifest builder that
# owns the ref.name, not here (Descriptor.annotations stays reserved).
#[must_use]
fn descriptor_to_jv(d) {
    var dd: Descriptor = d;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("mediaType"), json_v_str_new(str_from(dd.media_type)));
    json_v_obj_set(o, str_from("digest"), json_v_str_new(str_from(dd.digest)));
    json_v_obj_set(o, str_from("size"), json_v_int_new(dd.size));
    if (dd.urls != 0) {
        var ua = json_v_arr_new();
        var n = vec_len(dd.urls);
        var i = 0;
        while (i < n) {
            json_v_arr_push(ua, json_v_str_new(str_from(vec_get(dd.urls, i))));
            i = i + 1;
        }
        json_v_obj_set(o, str_from("urls"), ua);
    }
    return o;
}

# Absolute ceiling for a descriptor's declared `size`, 64 GiB. No real OCI blob
# approaches this; it exists so an attacker-declared size cannot overflow the
# download ceiling arithmetic or license an unbounded write.
var _REG_MAX_DESCRIPTOR_SIZE = 68719476736;

# JTAG_OBJ json value → Descriptor* (OCI content descriptor). STRICT on the
# required trio (mediaType/digest/size); returns 0 if any is missing/mistyped
# (the caller maps to Err). `urls` is optional (foreign layers).
#[must_use]
fn descriptor_from_jv(v) {
    if (v == 0) { return 0; }
    var mtf = json_v_obj_get(v, "mediaType");
    if (json_v_is_str(mtf) == 0) { return 0; }
    var dgf = json_v_obj_get(v, "digest");
    if (json_v_is_str(dgf) == 0) { return 0; }
    # The digest becomes a filesystem path (_img_blob_path) and a URL path
    # segment (_reg_blob_url), and it arrives from a remote registry. Reject
    # anything that is not exactly "sha256:" + 64 lowercase hex HERE, at the
    # parse boundary, so no malformed digest can reach either. See
    # digest_is_valid in image.cyr for what this prevents.
    if (digest_is_valid(str_cstr(json_v_str(dgf))) == 0) { return 0; }
    var szf = json_v_obj_get(v, "size");
    if (json_v_is_int(szf) == 0) { return 0; }
    var size = json_v_int(szf);
    # A negative or absurd size would otherwise disable the download ceiling in
    # registry_fetch_blob_to_store (`if (expected_size > 0)`), and
    # `size + 65536` on i64max wraps negative — either way, unbounded. The
    # descriptor is attacker-controlled, so bound it here.
    if (size < 0) { return 0; }
    if (size > _REG_MAX_DESCRIPTOR_SIZE) { return 0; }
    var d = descriptor_new(str_cstr(json_v_str(mtf)), str_cstr(json_v_str(dgf)), size);
    var uf = json_v_obj_get(v, "urls");
    if (json_v_is_arr(uf) == 1) {
        var dd: Descriptor = d;
        var urls = vec_new();
        var n = json_v_arr_len(uf);
        var i = 0;
        while (i < n) {
            var e = json_v_arr_get(uf, i);
            if (json_v_is_str(e) == 1) { vec_push(urls, str_cstr(json_v_str(e))); }
            i = i + 1;
        }
        dd.urls = urls;
    }
    return d;
}

# ── OciManifest (rust-old: struct OciManifest) ────────────────
# schema_version : i64  — always 2 for v2 schema 2
# media_type     : cstr, or 0 for None
# config         : Descriptor ptr
# layers         : vec ptr of Descriptor ptrs
# artifact_type  : cstr, or 0 for None (OCI artifact v1.1.0)
# subject        : Descriptor ptr, or 0 for None (parent-manifest link)
struct OciManifest {
    schema_version;
    media_type;
    config;
    layers;
    artifact_type;
    subject;
}

# Create a standard image manifest (rust-old: OciManifest::new).
#[must_use]
fn oci_manifest_new(config, layers) {
    var m = alloc(48);
    var mm: OciManifest = m;
    mm.schema_version = 2;
    mm.media_type = 0;
    mm.config = config;
    mm.layers = layers;
    mm.artifact_type = 0;
    mm.subject = 0;
    return m;
}

# True (1) iff this manifest represents an OCI artifact (v1.1.0) rather
# than a container image (rust-old: OciManifest::is_artifact).
#[must_use]
fn oci_manifest_is_artifact(m) {
    var mm: OciManifest = m;
    if (mm.artifact_type != 0) { return 1; }
    var cfg: Descriptor = mm.config;
    if (streq(cfg.media_type, media_oci_empty()) == 1) { return 1; }
    return 0;
}

# OciManifest → JTAG_OBJ json value (OCI image manifest v1). Canonical key
# order `schemaVersion, mediaType, artifactType, config, layers, subject` (only
# the present optionals emitted), so the serialized bytes — and the manifest
# digest computed over them — are deterministic.
#[must_use]
fn oci_manifest_to_jv(m) {
    var mm: OciManifest = m;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("schemaVersion"), json_v_int_new(mm.schema_version));
    if (mm.media_type != 0) {
        json_v_obj_set(o, str_from("mediaType"), json_v_str_new(str_from(mm.media_type)));
    }
    if (mm.artifact_type != 0) {
        json_v_obj_set(o, str_from("artifactType"), json_v_str_new(str_from(mm.artifact_type)));
    }
    json_v_obj_set(o, str_from("config"), descriptor_to_jv(mm.config));
    var larr = json_v_arr_new();
    var layers = mm.layers;
    var n = vec_len(layers);
    var i = 0;
    while (i < n) {
        json_v_arr_push(larr, descriptor_to_jv(vec_get(layers, i)));
        i = i + 1;
    }
    json_v_obj_set(o, str_from("layers"), larr);
    if (mm.subject != 0) {
        json_v_obj_set(o, str_from("subject"), descriptor_to_jv(mm.subject));
    }
    return o;
}

# JTAG_OBJ json value → OciManifest*. Requires a valid `config` descriptor;
# returns 0 otherwise. `layers` defaults to empty; mediaType/artifactType/
# subject/schemaVersion are recovered when present.
#[must_use]
fn oci_manifest_from_jv(v) {
    if (v == 0) { return 0; }
    var cfg = descriptor_from_jv(json_v_obj_get(v, "config"));
    if (cfg == 0) { return 0; }
    var layers = vec_new();
    var lf = json_v_obj_get(v, "layers");
    if (json_v_is_arr(lf) == 1) {
        var n = json_v_arr_len(lf);
        var i = 0;
        while (i < n) {
            var ld = descriptor_from_jv(json_v_arr_get(lf, i));
            # A layer that will not parse fails the WHOLE manifest. Skipping it
            # (which this did until the digest validator started rejecting
            # descriptors) yields an image silently missing a filesystem layer —
            # a container that runs and is simply wrong, which is worse than a
            # failed pull. The oracle's serde `Vec<Descriptor>` also fails the
            # whole deserialization on a bad element, so this is parity too.
            if (ld == 0) { return 0; }
            vec_push(layers, ld);
            i = i + 1;
        }
    }
    var m = oci_manifest_new(cfg, layers);
    var mm: OciManifest = m;
    # Guard the tag like every sibling field does. bayan's json_v_int returns 0
    # for any non-INT tag, so an unguarded read silently turns a registry-sent
    # `"schemaVersion": "2"` into 0 — and this parses attacker-controlled bytes.
    var svf = json_v_obj_get(v, "schemaVersion");
    if (json_v_is_int(svf) == 1) { mm.schema_version = json_v_int(svf); }
    var mtf = json_v_obj_get(v, "mediaType");
    if (json_v_is_str(mtf) == 1) { mm.media_type = str_cstr(json_v_str(mtf)); }
    var atf = json_v_obj_get(v, "artifactType");
    if (json_v_is_str(atf) == 1) { mm.artifact_type = str_cstr(json_v_str(atf)); }
    var sf = json_v_obj_get(v, "subject");
    if (json_v_is_obj(sf) == 1) { mm.subject = descriptor_from_jv(sf); }
    return m;
}

# ── Platform (rust-old: struct Platform) ──────────────────
# architecture : cstr
# os           : cstr
# variant      : cstr, or 0 for None
# os_version   : cstr, or 0 for None
struct Platform {
    architecture;
    os;
    variant;
    os_version;
}

#[must_use]
fn platform_new(architecture, os, variant, os_version) {
    var p = alloc(32);
    var pp: Platform = p;
    pp.architecture = architecture;
    pp.os = os;
    pp.variant = variant;
    pp.os_version = os_version;
    return p;
}

# Structural equality mirroring Rust `#[derive(PartialEq, Eq)]` on Platform:
# all four fields compared (None==None via 0==0, None!=Some via cstr guard).
#[must_use]
fn platform_eq(a, b) {
    var aa: Platform = a;
    var bb: Platform = b;
    if (streq(aa.architecture, bb.architecture) == 0) { return 0; }
    if (streq(aa.os, bb.os) == 0) { return 0; }
    if (_reg_opt_eq(aa.variant, bb.variant) == 0) { return 0; }
    if (_reg_opt_eq(aa.os_version, bb.os_version) == 0) { return 0; }
    return 1;
}

# Compare two Option<String> cstrs (0 = None). None==None → 1; a present
# and b absent (or vice versa) → 0; both present → streq.
#[must_use]
fn _reg_opt_eq(a, b) {
    if (a == 0 && b == 0) { return 1; }
    if (a == 0 || b == 0) { return 0; }
    return streq(a, b);
}

# ── PlatformManifest (rust-old: struct PlatformManifest) ────────
# media_type : cstr
# digest     : cstr
# size       : i64 (u64 in Rust)
# platform   : Platform ptr, or 0 for None
struct PlatformManifest {
    media_type;
    digest;
    size;
    platform;
}

#[must_use]
fn platform_manifest_new(media_type, digest, size, platform) {
    var pm = alloc(32);
    var p: PlatformManifest = pm;
    p.media_type = media_type;
    p.digest = digest;
    p.size = size;
    p.platform = platform;
    return pm;
}

# ── OciIndex (rust-old: struct OciIndex) ──────────────────
# schema_version : i64
# media_type     : cstr, or 0 for None
# manifests      : vec ptr of PlatformManifest ptrs
struct OciIndex {
    schema_version;
    media_type;
    manifests;
}

#[must_use]
fn oci_index_new(media_type, manifests) {
    var idx = alloc(24);
    var ii: OciIndex = idx;
    ii.schema_version = 2;
    ii.media_type = media_type;
    ii.manifests = manifests;
    return idx;
}

# ── index / platform JSON parsing (rust-old: serde Deserialize) ──
# `descriptor_from_jv` above deliberately drops `platform` (a Descriptor has no
# such field); a manifest LIST needs it, so these three parse the index shape.
# Required for `select_platform` to ever see real registry bytes.

# Platform from a JSON object (rust-old: registry.rs:131-139).
# `architecture` + `os` are required; `variant`/`os.version` optional.
#[must_use]
fn platform_from_jv(v) {
    if (json_v_is_obj(v) == 0) { return 0; }
    var af = json_v_obj_get(v, "architecture");
    var of = json_v_obj_get(v, "os");
    if (json_v_is_str(af) == 0) { return 0; }
    if (json_v_is_str(of) == 0) { return 0; }
    var variant = 0;
    var vf = json_v_obj_get(v, "variant");
    if (json_v_is_str(vf) == 1) { variant = str_cstr(json_v_str(vf)); }
    var osver = 0;
    var ovf = json_v_obj_get(v, "os.version");
    if (json_v_is_str(ovf) == 1) { osver = str_cstr(json_v_str(ovf)); }
    return platform_new(str_cstr(json_v_str(af)), str_cstr(json_v_str(of)), variant, osver);
}

# One manifest-list entry (rust-old: registry.rs:121-128). mediaType/digest/size
# required (tag-guarded like descriptor_from_jv); `platform` optional.
#[must_use]
fn platform_manifest_from_jv(v) {
    if (json_v_is_obj(v) == 0) { return 0; }
    var mtf = json_v_obj_get(v, "mediaType");
    var df = json_v_obj_get(v, "digest");
    var sf = json_v_obj_get(v, "size");
    if (json_v_is_str(mtf) == 0) { return 0; }
    if (json_v_is_str(df) == 0) { return 0; }
    if (json_v_is_int(sf) == 0) { return 0; }
    return platform_manifest_new(str_cstr(json_v_str(mtf)), str_cstr(json_v_str(df)),
      json_v_int(sf), platform_from_jv(json_v_obj_get(v, "platform")));
}

# A manifest list / image index (rust-old: registry.rs:111-118).
#
# DIVERGENCE from the oracle's serde-strict decode: a malformed ENTRY is dropped
# rather than failing the whole index. This parses bytes a remote registry
# controls, and one junk entry must not be able to fail an otherwise-valid pull
# — the same hostile-input posture as the tar reader's name checks. A missing or
# non-array `manifests` still yields an empty index (not an error), matching the
# oracle's `Vec` default.
#[must_use]
fn oci_index_from_jv(v) {
    if (json_v_is_obj(v) == 0) { return 0; }
    var manifests = vec_new();
    var mf = json_v_obj_get(v, "manifests");
    if (json_v_is_arr(mf) == 1) {
        var n = json_v_arr_len(mf);
        var i = 0;
        while (i < n) {
            var e = platform_manifest_from_jv(json_v_arr_get(mf, i));
            if (e != 0) { vec_push(manifests, e); }
            i = i + 1;
        }
    }
    var mt = 0;
    var mtf = json_v_obj_get(v, "mediaType");
    if (json_v_is_str(mtf) == 1) { mt = str_cstr(json_v_str(mtf)); }
    var idx = oci_index_new(mt, manifests);
    var ii: OciIndex = idx;
    var svf = json_v_obj_get(v, "schemaVersion");
    if (json_v_is_int(svf) == 1) { ii.schema_version = json_v_int(svf); }
    return idx;
}

# True (1) iff a parsed body looks like an index rather than a single manifest.
# Structural sniff used when Content-Type is absent or unhelpful: an index has
# `manifests` (array), a manifest has `config` (object). The oracle dispatches on
# Content-Type alone and mis-parses an index sent without one.
#[must_use]
fn _reg_body_is_index(v) {
    if (json_v_is_obj(v) == 0) { return 0; }
    if (json_v_is_arr(json_v_obj_get(v, "manifests")) == 1) { return 1; }
    return 0;
}

# ── RegistryCredential (rust-old: struct RegistryCredential) ────
# username : cstr
# password : cstr (plaintext — OS keyring recommended for production)
struct RegistryCredential {
    username;
    password;
}

#[must_use]
fn registry_credential_new(username, password) {
    var c = alloc(16);
    var cc: RegistryCredential = c;
    cc.username = username;
    cc.password = password;
    return c;
}

# ── helpers ───────────────────────────

# Map registry shorthand to actual host (rust-old: registry_host).
# Returns a cstr — "docker.io" is rewritten to the real Docker Hub host;
# everything else passes through unchanged.
#[must_use]
fn registry_host(registry) {
    if (streq(registry, "docker.io") == 1) { return "registry-1.docker.io"; }
    return registry;
}

# Normalize Rust arch strings to OCI arch strings (rust-old: normalize_arch).
# Returns a cstr; unknown arches pass through unchanged.
#[must_use]
fn normalize_arch(arch) {
    if (streq(arch, "x86_64") == 1) { return "amd64"; }
    if (streq(arch, "aarch64") == 1) { return "arm64"; }
    if (streq(arch, "arm") == 1) { return "arm"; }
    if (streq(arch, "s390x") == 1) { return "s390x"; }
    if (streq(arch, "powerpc64") == 1) { return "ppc64le"; }
    return arch;
}

# Detect current platform (rust-old: current_platform).
# The Rust reads std::env::consts::{OS, ARCH}; those compile-time consts are
# not available here. We return a Platform built from the host's uname, but
# since no uname binding exists in the base yet the os/arch strings are the
# build-target defaults ("linux" / normalized host arch). Callers that need
# the exact runtime triple use the DEFERRED transport path.
#[must_use]
fn current_platform() {
    return platform_new(normalize_arch("x86_64"), "linux", 0, 0);
}

# Select the best matching platform from an index (rust-old: select_platform).
# Returns a PlatformManifest pointer (a clone of the matched entry) on
# success, or 0 when no os/arch match exists — the caller maps 0 to
# StivaError::UnsupportedPlatform("<os>/<arch>") via
# stiva_err_print(STIVA_ERR_UNSUPPORTED_PLATFORM, detail).
#
# Match precedence mirrors the Rust exactly:
#   1. Exact: os == target.os && arch == target.arch &&
#             (target.variant is None || entry.variant == target.variant)
#   2. Relaxed: os == target.os && arch == target.arch (variant ignored)
#[must_use]
fn select_platform(index, target) {
    var idx: OciIndex = index;
    var tp: Platform = target;
    var n = vec_len(idx.manifests);

    # Pass 1: exact match.
    var i = 0;
    while (i < n) {
        var entry = vec_get(idx.manifests, i);
        var e: PlatformManifest = entry;
        if (e.platform != 0) {
            var p: Platform = e.platform;
            if (streq(p.os, tp.os) == 1 && streq(p.architecture, tp.architecture) == 1) {
                # target.variant.is_none() || p.variant == target.variant
                if (tp.variant == 0 || _reg_opt_eq(p.variant, tp.variant) == 1) {
                    return _platform_manifest_clone(entry);
                }
            }
        }
        i = i + 1;
    }

    # Pass 2: relaxed match (ignore variant).
    i = 0;
    while (i < n) {
        var entry2 = vec_get(idx.manifests, i);
        var e2: PlatformManifest = entry2;
        if (e2.platform != 0) {
            var p2: Platform = e2.platform;
            if (streq(p2.os, tp.os) == 1 && streq(p2.architecture, tp.architecture) == 1) {
                sakshi_warn("no exact variant match, using ", strlen("no exact variant match, using "));
                return _platform_manifest_clone(entry2);
            }
        }
        i = i + 1;
    }

    # No match — UnsupportedPlatform.
    return 0;
}

# Shallow-clone a PlatformManifest (mirrors the Rust `entry.clone()`; the
# cloned Platform is a fresh struct so callers may retain it independently).
#[must_use]
fn _platform_manifest_clone(entry) {
    var e: PlatformManifest = entry;
    var plat = 0;
    if (e.platform != 0) {
        var p: Platform = e.platform;
        plat = platform_new(p.architecture, p.os, p.variant, p.os_version);
    }
    return platform_manifest_new(e.media_type, e.digest, e.size, plat);
}

# ── WWW-Authenticate parsing (rust-old: parse_www_authenticate) ─
# Parse `Bearer realm="...",service="...",scope="..."` into key/value
# pairs. The Rust returns a HashMap<String,String>; here we return an
# opaque AuthParams handle (two parallel vecs of cstr keys/values) queried
# via auth_params_get(params, key) -> value cstr or 0.
#
# Parsing steps mirror the Rust exactly:
#   * strip a leading "Bearer " or "bearer " prefix (else use whole header)
#   * split the remainder on ','
#   * for each part: trim; split_once('='); trim the key; trim '"' from both
#     ends of the value; insert key→value.
struct AuthParams {
    keys;
    values;
}

#[must_use]
fn parse_www_authenticate(header) {
    var keys = vec_new();
    var values = vec_new();
    var ap = alloc(16);
    var app: AuthParams = ap;
    app.keys = keys;
    app.values = values;

    # Strip "Bearer " / "bearer " prefix (7 bytes) if present.
    var params = header;
    if (strlen(header) >= 7 && memeq(header, "Bearer ", 7) == 1) { params = header + 7; }
    elif (strlen(header) >= 7 && memeq(header, "bearer ", 7) == 1) { params = header + 7; }

    var plen = strlen(params);
    var start = 0;
    while (start <= plen) {
        # Find the next ',' (or end of string).
        var end = start;
        while (end < plen) {
            if (load8(params + end) == 44) { break; }
            end = end + 1;
        }
        # part = params[start..end], trimmed.
        var part = _reg_trim(params, start, end);
        # split_once('=').
        var eq = _reg_find_byte(part, 61);
        if (eq >= 0) {
            var key = _reg_trim(part, 0, eq);
            # value = part[eq+1 ..], then trim_matches('"').
            var vlen = strlen(part);
            var val = _reg_slice(part, eq + 1, vlen);
            var vtrim = _reg_trim_quotes(val);
            vec_push(keys, key);
            vec_push(values, vtrim);
        }
        if (end >= plen) { break; }
        start = end + 1;
    }
    return ap;
}

# Look up a key in AuthParams — returns the value cstr, or 0 if absent
# (mirrors HashMap::get). On duplicate keys, last-write-wins like a HashMap
# insert: we scan from the end so the most recently inserted value wins.
#[must_use]
fn auth_params_get(params, key) {
    var app: AuthParams = params;
    var n = vec_len(app.keys);
    var i = n - 1;
    while (i >= 0) {
        var k = vec_get(app.keys, i);
        if (streq(k, key) == 1) { return vec_get(app.values, i); }
        i = i - 1;
    }
    return 0;
}

# Count of parsed key/value pairs (for is_empty checks in tests).
#[must_use]
fn auth_params_len(params) {
    var app: AuthParams = params;
    return vec_len(app.keys);
}

# ── small cstr helpers (parity-exact byte handling) ─────────────

# True (1) iff byte `c` is ASCII whitespace stripped by Rust's str::trim.
#[must_use]
fn _reg_is_ws(c) {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    if (c == 10) { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

# Copy bytes [start, end) of `src` into a fresh NUL-terminated cstr.
#[must_use]
fn _reg_slice(src, start, end) {
    var n = end - start;
    if (n < 0) { n = 0; }
    var out = alloc(n + 1);
    memcpy(out, src + start, n);
    store8(out + n, 0);
    return out;
}

# Trim ASCII whitespace from src[start..end], returning a fresh cstr
# (mirrors str::trim on the slice).
#[must_use]
fn _reg_trim(src, start, end) {
    var s = start;
    while (s < end) {
        if (_reg_is_ws(load8(src + s)) == 0) { break; }
        s = s + 1;
    }
    var e = end;
    while (e > s) {
        if (_reg_is_ws(load8(src + e - 1)) == 0) { break; }
        e = e - 1;
    }
    return _reg_slice(src, s, e);
}

# Index of the first `byte` in cstr `s`, or -1 (mirrors split_once).
#[must_use]
fn _reg_find_byte(s, byte) {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (load8(s + i) == byte) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Strip matching leading+trailing '"' bytes (mirrors trim_matches('"'):
# strips ALL leading and ALL trailing quote chars). Returns a fresh cstr.
#[must_use]
fn _reg_trim_quotes(s) {
    var len = strlen(s);
    var start = 0;
    while (start < len) {
        if (load8(s + start) != 34) { break; }
        start = start + 1;
    }
    var end = len;
    while (end > start) {
        if (load8(s + end - 1) != 34) { break; }
        end = end - 1;
    }
    return _reg_slice(s, start, end);
}

# ── RegistryConfig / MirrorConfig (rust-old: struct RegistryConfig / MirrorConfig) ──
# RegistryConfig carries optional basic-auth creds + mirror config. MirrorConfig
# is a single-field wrapper over HashMap<hostname, Vec<mirror-url>>; per the port's
# single-field-struct rule it collapses to a bare map handle (0 = empty/default).
struct RegistryConfig {
    username;   # Option<String> → cstr | 0
    password;   # Option<String> → cstr | 0
    mirrors;    # MirrorConfig → map handle (hostname → vec of URL cstr) | 0 = empty
}

#[must_use]
fn registry_config_new(username, password, mirrors) {
    var c = alloc(24);
    var cc: RegistryConfig = c;
    cc.username = username;
    cc.password = password;
    cc.mirrors = mirrors;
    return c;
}

# rust-old: RegistryConfig::default — all fields None/empty.
#[must_use]
fn registry_config_default() {
    return registry_config_new(0, 0, 0);
}

# ── CredentialStore (rust-old: struct CredentialStore + impl) ──
# Persistent registry-auth store, JSON at {HOME}/.stiva/credentials.json. Modeled
# as a cstr-keyed map (registry hostname → RegistryCredential*) — the sole
# `registries` field collapses to the map (single-field-struct rule).

# Concatenate two cstrs into a fresh cstr (registry-local path join).
#[must_use]
fn _reg_cat2(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    var out = alloc(la + lb + 1);
    memcpy(out, a, la);
    memcpy(out + la, b, lb);
    store8(out + la + lb, 0);
    return out;
}

# Directory portion of a file path (up to the last '/'), or 0 if none.
#[must_use]
fn _reg_parent_dir(path) {
    var len = strlen(path);
    var slash = 0 - 1;
    var i = 0;
    while (i < len) {
        if (load8(path + i) == 47) { slash = i; }   # '/'
        i = i + 1;
    }
    if (slash <= 0) { return 0; }
    return _reg_slice(path, 0, slash);
}

# Stiva config dir (rust-old: dirs_path) — {HOME}/.stiva, or /tmp/.stiva if HOME unset.
#[must_use]
fn _cred_dirs_path() {
    var home = getenv("HOME");
    if (home == 0) { return "/tmp/.stiva"; }
    return _reg_cat2(home, "/.stiva");
}

# Default credential-store path (rust-old: CredentialStore::default_path).
#[must_use]
fn credential_store_default_path() {
    return _reg_cat2(_cred_dirs_path(), "/credentials.json");
}

# A fresh empty store (rust-old: CredentialStore::default).
#[must_use]
fn credential_store_new() {
    return map_new();
}

# CredentialStore → JSON object {"registries": {host: {username, password}}}.
fn credential_store_to_jv(store) {
    var o = json_v_obj_new();
    var regs = json_v_obj_new();
    if (store != 0) {
        var keys = map_keys(store);
        var n = vec_len(keys);
        var i = 0;
        while (i < n) {
            var k = vec_get(keys, i);
            var cred: RegistryCredential = map_get(store, k);
            var co = json_v_obj_new();
            json_v_obj_set(co, str_from("username"), json_v_str_new(str_from(cred.username)));
            json_v_obj_set(co, str_from("password"), json_v_str_new(str_from(cred.password)));
            json_v_obj_set(regs, str_from(k), co);
            i = i + 1;
        }
    }
    json_v_obj_set(o, str_from("registries"), regs);
    return o;
}

# JSON object → CredentialStore map (registry → RegistryCredential*). STRICT, to
# match serde: `registries` is a required field, and RegistryCredential requires
# both `username` and `password` (no serde defaults). Returns 0 (invalid — the
# caller maps to Err) when the top level isn't an object, `registries` is
# missing/non-object, or any entry is not an object with both string fields. A
# valid-but-empty `{"registries":{}}` yields a fresh (non-zero) empty store.
fn credential_store_from_jv(v) {
    if (v == 0) { return 0; }
    var regs = json_v_obj_get(v, "registries");
    if (json_v_is_obj(regs) == 0) { return 0; }
    var store = map_new();
    var n = json_v_obj_len(regs);
    var i = 0;
    while (i < n) {
        var key = str_cstr(json_v_obj_key(regs, i));
        var cv = json_v_obj_val(regs, i);
        if (json_v_is_obj(cv) == 0) { return 0; }
        var uf = json_v_obj_get(cv, "username");
        if (json_v_is_str(uf) == 0) { return 0; }
        var pf = json_v_obj_get(cv, "password");
        if (json_v_is_str(pf) == 0) { return 0; }
        map_set(store, key, registry_credential_new(str_cstr(json_v_str(uf)), str_cstr(json_v_str(pf))));
        i = i + 1;
    }
    return store;
}

# Load a store from `path` (internal; the public load uses default_path).
# Missing file → fresh empty store; read/parse/schema error → 0 (caller maps to
# Err — matches serde's "missing field" rejection of a malformed file).
fn _credential_store_load_from(path) {
    if (file_exists(path) == 0) { return map_new(); }
    var cap = 1048576;
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap);
    if (n < 0) {
        stiva_err_print(STIVA_ERR_REGISTRY, "failed to read credentials");
        return 0;
    }
    var v = bayan_json_v_parse_buf(buf, n);
    if (v == 0) {
        stiva_err_print(STIVA_ERR_REGISTRY, "invalid credentials file");
        return 0;
    }
    var store = credential_store_from_jv(v);
    if (store == 0) {
        stiva_err_print(STIVA_ERR_REGISTRY, "invalid credentials file");
        return 0;
    }
    return store;
}

# Load credentials from disk (rust-old: CredentialStore::load).
fn credential_store_load() {
    return _credential_store_load_from(credential_store_default_path());
}

# Save a store to `path` (internal; the public save uses default_path). Creates
# the parent dir (create_dir_all). Returns 0 / -1.
fn _credential_store_save_to(store, path) {
    var dir = _reg_parent_dir(path);
    if (dir != 0) { sys_mkdir(dir, 493); }
    var s = json_v_build_pretty(credential_store_to_jv(store), 2);
    if (file_write_all(path, str_data(s), str_len(s)) < 0) {
        stiva_err_print(STIVA_ERR_REGISTRY, "failed to write credentials");
        return 0 - 1;
    }
    return 0;
}

# Save credentials to disk (rust-old: CredentialStore::save).
fn credential_store_save(store) {
    return _credential_store_save_to(store, credential_store_default_path());
}

# Store credentials for a registry (rust-old: set) — overwrites any existing entry.
fn credential_store_set(store, registry, username, password) {
    map_set(store, registry, registry_credential_new(username, password));
    return 0;
}

# Get credentials for a registry (rust-old: get) — RegistryCredential* or 0.
#[must_use]
fn credential_store_get(store, registry) {
    if (map_has(store, registry) == 0) { return 0; }
    return map_get(store, registry);
}

# Remove credentials for a registry (rust-old: remove) — 1 if an entry existed.
fn credential_store_remove(store, registry) {
    return map_delete(store, registry);
}

# Build a RegistryConfig for a registry from its stored creds (rust-old: to_config).
#[must_use]
fn credential_store_to_config(store, registry) {
    var cred = credential_store_get(store, registry);
    if (cred == 0) { return registry_config_default(); }
    var cc: RegistryCredential = cred;
    return registry_config_new(cc.username, cc.password, 0);
}

# ── DEFERRED (land with the async transport layer) ──────
# rust-old/src/registry.rs also defines the HTTP client surface, all coupled to
# reqwest / tokio (the sync CredentialStore/RegistryConfig/MirrorConfig above are
# now ported):
#
#   struct AuthToken { token, expires_at: Option<tokio::time::Instant> }
#   struct RegistryClient { reqwest::Client, config, tokens: Arc<RwLock<..>> }
#     - new / with_config / with_base_url / default
#     - api_base / api_bases                       (mirror resolution)
#     - fetch_manifest / resolve_manifest / fetch_blob   (async GET)
#     - blob_exists / push_blob / push_blob_chunked / push_manifest (async)
#     - list_tags / catalog / referrers            (async discovery)
#     - authenticated_get / authenticated_request / acquire_token  (bearer)
#     - get_cached_token / cache_token             (RwLock token cache)
#
# These require an HTTP client, async runtime, a JSON object model, and a
# credential-file (de)serializer — none present in the ported base. They
# land with the transport layer for parity. Tracked in the roadmap.

# ══ RegistryClient (roadmap §B) ═══════════════════════════
# The blocking client over sandhi's HTTPS transport. `Arc<RwLock<HashMap>>`
# collapses to a plain map (single-node run-to-completion), so no locking.
#
# ── Why offset accessors and not `struct` declarations ──
# The cycc struct-id 20/21 ↔ SIMD-sentinel miscompile is STILL OPEN and moves
# with each compilation unit's struct-id assignment. Declaring new structs in
# this file would RENUMBER struct ids in all five units that include it and
# could move the collision onto a currently-clean struct. Adding zero structs
# makes §B provably unable to perturb the existing assignment. Same idiom as
# lib/sandhi.cyr's SANDHI_*_OFF enums.

# RegistryClient layout — 32 bytes.
#   REG_CL_CONFIG    @0  — RegistryConfig* | 0
#   REG_CL_TOKENS    @8  — map: cache-key cstr -> AuthToken*
#   REG_CL_BASE_URL  @16 — cstr | 0; overrides https://{host}. This is the
#                          oracle's #[cfg(test)] base_url, promoted to a real
#                          field so the CLI can target a self-hosted registry.
#   REG_CL_TRANSPORT @24 — 0 = live sandhi; else a canned transport (test seam)
enum RegClientOff {
    REG_CL_CONFIG = 0;
    REG_CL_TOKENS = 8;
    REG_CL_BASE_URL = 16;
    REG_CL_TRANSPORT = 24;
}

# AuthToken layout — 16 bytes (rust-old: struct AuthToken).
enum RegTokenOff {
    REG_TOK_TOKEN = 0;        # cstr
    REG_TOK_EXPIRES_NS = 8;   # monotonic ns deadline; 0 = never expires
}

# ── Transport seam (Inc-3) ───────────────────────
# REG_CL_TRANSPORT (@24) holds 0 for the live sandhi path, else one of these.
# It exists because the bearer state machine is only reachable over a real
# socket otherwise: a canned transport makes the oracle's wiremock cases
# (rust-old/src/registry.rs:1591-2503) portable to a suite that never opens a
# connection. Same no-struct rule as the rest of §B — offsets, not a type.
#
#   REG_TP_SEND @0  — fn(ctx, method, url, headers, body, body_len)
#                     -> sandhi-shaped response* (SANDHI_RESP_OFF_*)
#   REG_TP_SINK @8  — fn(ctx, url, cb, sink_ctx, headers)
#                     -> sandhi-shaped download result* | 0 = no download script
#   REG_TP_CTX  @16 — opaque, handed back as arg 0 of both
#
# The canned side returns SANDHI-shaped values on purpose: every consumer from
# Inc-4 up reads through sandhi_http_status/_body/_body_len/_headers, so a
# stiva-specific response type would be both a new struct AND a translation
# layer for no gain.
enum RegTransportOff {
    REG_TP_SEND = 0;
    REG_TP_SINK = 8;
    REG_TP_CTX = 16;
}

#[must_use]
fn registry_transport_new(send_fp, sink_fp, ctx) {
    var t = alloc(24);
    if (t == 0) { return 0; }
    store64(t + REG_TP_SEND, send_fp);
    store64(t + REG_TP_SINK, sink_fp);
    store64(t + REG_TP_CTX, ctx);
    return t;
}

fn registry_client_set_transport(client, transport) {
    store64(client + REG_CL_TRANSPORT, transport);
    return 0;
}

# ── last-error channel ───────────────────────────
# The §B surface returns pointer-0 / -1 sentinels (module idiom), which has no
# room for the oracle's error inventory. Same shape as convert.cyr's
# _cv_compose_err and runtime.cyr's _rt_last_scan_verdict: the call returns the
# sentinel, the detail is read back here.
var _reg_last_err = 0;
var _reg_last_status = 0;

#[must_use]
fn registry_last_error() { return _reg_last_err; }

#[must_use]
fn registry_last_status() { return _reg_last_status; }

# Record a failure and return `ret` (so call sites read `return _reg_fail(...)`).
# When 1, _reg_fail records but does not PRINT. For probes whose failure is an
# expected answer rather than a problem: a blob-existence HEAD that 404s means
# "not present, go upload it", and printing an error there would make a normal
# first push emit one scary line per blob.
var _reg_quiet = 0;

fn _reg_fail(code, msg, status) {
    _reg_last_err = code;
    _reg_last_status = status;
    if (msg != 0) {
        if (_reg_quiet == 0) { stiva_err_print(code, msg); }
    }
    return 0;
}

fn _reg_clear_err() {
    _reg_last_err = 0;
    _reg_last_status = 0;
    return 0;
}

# ── HTTP options ────────────────────
# sandhi defaults are wrong for a registry on two counts: redirect following is
# OFF (registries 307 manifests and blobs to a CDN), and the buffered cap is
# 256 KiB — a fat multi-arch index or a config blob with a long `history` array
# exceeds it, and sandhi reports that as SANDHI_ERR_PROTOCOL, which is also
# what an unparseable status line returns. Set both explicitly on EVERY
# buffered call; a call that forgets silently reverts to 256 KiB.
var _REG_MANIFEST_MAX_BYTES = 8388608;   # 8 MiB
var _REG_HTTP_TOTAL_MS = 60000;

# Blob legs get their own, far larger budget. sandhi's total_ms is a deadline
# for the WHOLE transfer (lib/sandhi.cyr:9081, :9463, enforced in the body loop
# at :9610), not an idle timeout — so the 60 s control-plane budget caps every
# blob at whatever fits in a minute. A 400 MB layer on a 50 Mbit/s link needs
# ~64 s and would fail, permanently and identically on every retry, since there
# is no resume. 1 hour is a liveness backstop, not a rate expectation. The
# oracle sets no timeout at all (rust-old/src/registry.rs:313-317).
var _REG_BLOB_TOTAL_MS = 3600000;
var _REG_HTTP_MAX_HOPS = 10;             # oracle: Policy::limited(10)

#[must_use]
fn _reg_http_opts() {
    var o = sandhi_http_options_new();
    if (o == 0) { return 0; }
    sandhi_http_options_follow_redirects(o, 1);
    sandhi_http_options_max_hops(o, _REG_HTTP_MAX_HOPS);
    sandhi_http_options_max_response_bytes(o, _REG_MANIFEST_MAX_BYTES);
    sandhi_http_options_total_ms(o, _REG_HTTP_TOTAL_MS);
    return o;
}

# Options for a blob-sized transfer: the long deadline, and no response-byte
# cap (the streaming sink enforces its own descriptor-derived ceiling, and the
# 8 MiB manifest cap would reject every real layer).
#[must_use]
fn _reg_blob_http_opts() {
    var o = sandhi_http_options_new();
    if (o == 0) { return 0; }
    sandhi_http_options_follow_redirects(o, 1);
    sandhi_http_options_max_hops(o, _REG_HTTP_MAX_HOPS);
    sandhi_http_options_total_ms(o, _REG_BLOB_TOTAL_MS);
    return o;
}

# ── transport dispatch ───────────────────────────

# One buffered request. Returns a sandhi response*, or 0.
fn _reg_send(client, method, url, headers, body, body_len) {
    var t = load64(client + REG_CL_TRANSPORT);
    if (t == 0) {
        # A request carrying a body is a blob upload; give it the long deadline
        # for the same reason downloads get one (see _REG_BLOB_TOTAL_MS).
        var opts = _reg_http_opts();
        if (body_len > 0) { opts = _reg_blob_http_opts(); }
        return sandhi_http_request_auto(method, url, headers, body, body_len, opts);
    }
    return fncall6(load64(t + REG_TP_SEND), load64(t + REG_TP_CTX),
      method, url, headers, body, body_len);
}

# One streaming download. Returns a sandhi download-result*, or 0.
fn _reg_download(client, url, cb, sink_ctx, headers) {
    var t = load64(client + REG_CL_TRANSPORT);
    if (t == 0) {
        return sandhi_http_download_sink_headers(url, cb, sink_ctx, headers, _reg_blob_http_opts());
    }
    var f = load64(t + REG_TP_SINK);
    if (f == 0) { return 0; }
    return fncall5(f, load64(t + REG_TP_CTX), url, cb, sink_ctx, headers);
}

# ── header building ──────────────────────────────

# `accept` / `authorization` are cstr or 0. Returns a headers handle, or 0.
# sandhi_headers_add returns -1 on a CR/LF-bearing value — and a
# registry-supplied token flows straight into Authorization, so that branch is
# reachable by hostile input and MUST fail closed rather than send a smuggled
# request line.
#[must_use]
fn _reg_headers(accept, authorization) {
    var h = sandhi_headers_new();
    if (h == 0) { return 0; }
    if (accept != 0) {
        if (sandhi_headers_add(h, "Accept", accept) != 0) { return 0; }
    }
    if (authorization != 0) {
        if (sandhi_headers_add(h, "Authorization", authorization) != 0) { return 0; }
    }
    return h;
}

# "Bearer {token}". Never call with token == 0 (_reg_cat2 strlens both args).
#[must_use]
fn _reg_bearer(token) {
    if (token == 0) { return 0; }
    return _reg_cat2("Bearer ", token);
}

# ══ Bearer state machine (Inc-4) ═════════════════════════
# rust-old/src/registry.rs:905-985 (authenticated_request) + :506-546
# (acquire_token). Four phases: try a cached token, probe unauthenticated,
# acquire on the challenge, retry once. A second 401 is terminal.

# Exchange a WWW-Authenticate challenge for a bearer token
# (rust-old: acquire_token, registry.rs:506-546). Returns the token cstr, or 0.
fn _reg_acquire_token(client, www_auth, scope) {
    var params = parse_www_authenticate(www_auth);
    var realm = auth_params_get(params, "realm");
    if (realm == 0) {
        return _reg_fail(STIVA_ERR_AUTH_FAILED, "no realm in www-authenticate", 0);
    }
    # The challenge's own `scope` is DISCARDED and the caller's sent instead
    # (registry.rs:512-516). That is what makes a push scope survive a registry
    # that answers with a pull-scoped challenge.
    var url = _reg_token_url(realm, auth_params_get(params, "service"), scope);

    # Basic credentials go to the TOKEN endpoint only, never to the resource
    # (registry.rs:518-521). Both fields must be present; a username without a
    # password sends nothing.
    var cfg = load64(client + REG_CL_CONFIG);
    var basic = 0;
    if (cfg != 0) {
        var cc: RegistryConfig = cfg;
        if (cc.username != 0 && cc.password != 0) {
            basic = _reg_basic_auth_header(cc.username, cc.password);
        }
    }
    var h = _reg_headers(0, basic);
    if (h == 0) { return _reg_fail(STIVA_ERR_AUTH_FAILED, "malformed credentials", 0); }

    var r = _reg_send(client, "GET", url, h, 0, 0);
    if (r == 0) { return _reg_fail(STIVA_ERR_AUTH_FAILED, "token request failed", 0); }
    if (sandhi_http_err_kind(r) != SANDHI_OK) {
        return _reg_fail(STIVA_ERR_AUTH_FAILED, "token request transport failure", 0);
    }
    var st = sandhi_http_status(r);
    if (st < 200 || st >= 300) {
        return _reg_fail(STIVA_ERR_AUTH_FAILED, "token endpoint returned an error status", st);
    }
    var tok = _reg_token_from_body(sandhi_http_body(r), sandhi_http_body_len(r));
    if (tok == 0) {
        return _reg_fail(STIVA_ERR_AUTH_FAILED, "no token in auth response", st);
    }
    return tok;
}

# Classify a response that is neither a transport failure nor a 401.
# 2xx AND 3xx are both success (registry.rs:926-928) — the caller decides what
# to do with a redirect it was handed rather than followed.
fn _reg_resp_terminal(r) {
    var st = sandhi_http_status(r);
    if (st >= 400) {
        return _reg_fail(STIVA_ERR_REGISTRY, "registry returned an error status", st);
    }
    return r;
}

# Perform `method url` against `ref`'s registry, acquiring and caching a bearer
# token as needed (rust-old: authenticated_request, registry.rs:905-985).
# `accept` is a cstr or 0. Returns the sandhi response* on 2xx/3xx, else 0 with
# the detail in registry_last_error()/_status().
fn _reg_authenticated_request(client, ref, method, url, scope, accept) {
    _reg_clear_err();
    # Keyed on the RAW registry, not registry_host() (registry.rs:913): a
    # docker.io ref caches under "docker.io|…" while the URL targets
    # registry-1.docker.io. Keying on the mapped host would re-authenticate on
    # every request.
    #
    # ImageRef.registry is read by RAW OFFSET (@0), not `var rr: ImageRef =
    # ref; rr.registry`. The cycc struct-id 20/21 miscompile bites THIS
    # function context in the 6-module tests/registry.tcyr unit under 6.4.77:
    # the typed read returned a pointer-shaped garbage value, so the cache key
    # became "<junk>|<scope>". Every lookup then missed and every request
    # re-authenticated — a silent 3x request amplification against the
    # registry, not a crash. Caught only because a test asserted the cached
    # token was reachable by an independently-built key.
    var key = _reg_cache_key(load64(ref + 0), scope);

    # ── Phase 1: cached-token attempt ──
    var tok = _reg_get_cached_token(client, key);
    if (tok != 0) {
        var h1 = _reg_headers(accept, _reg_bearer(tok));
        if (h1 == 0) { return _reg_fail(STIVA_ERR_AUTH_FAILED, "malformed cached token", 0); }
        var r1 = _reg_send(client, method, url, h1, 0, 0);
        if (r1 == 0) { return _reg_fail(STIVA_ERR_HTTP, "transport failure", 0); }
        if (sandhi_http_err_kind(r1) != SANDHI_OK) {
            return _reg_fail(STIVA_ERR_HTTP, "transport failure", 0);
        }
        if (sandhi_http_status(r1) != 401) { return _reg_resp_terminal(r1); }
        # 401 with a cached token: fall through and re-authenticate. The stale
        # entry is deliberately NOT evicted — the oracle only overwrites it via
        # cache_token (registry.rs:934, no map removal).
    }

    # ── Phase 2: unauthenticated probe (elicits the challenge) ──
    var h2 = _reg_headers(accept, 0);
    if (h2 == 0) { return _reg_fail(STIVA_ERR_HTTP, "cannot build request headers", 0); }
    var r2 = _reg_send(client, method, url, h2, 0, 0);
    if (r2 == 0) { return _reg_fail(STIVA_ERR_HTTP, "transport failure", 0); }
    if (sandhi_http_err_kind(r2) != SANDHI_OK) {
        return _reg_fail(STIVA_ERR_HTTP, "transport failure", 0);
    }
    if (sandhi_http_status(r2) != 401) { return _reg_resp_terminal(r2); }

    # ── Phase 3: challenge -> token ──
    var www = sandhi_headers_get(sandhi_http_headers(r2), "WWW-Authenticate");
    if (www == 0) {
        return _reg_fail(STIVA_ERR_AUTH_FAILED, "401 without www-authenticate header", 401);
    }
    var fresh = _reg_acquire_token(client, www, scope);
    if (fresh == 0) { return 0; }   # already failed + printed
    _reg_cache_token(client, key, fresh);

    # ── Phase 4: retry once; a second 401 is terminal ──
    var h3 = _reg_headers(accept, _reg_bearer(fresh));
    if (h3 == 0) { return _reg_fail(STIVA_ERR_AUTH_FAILED, "malformed token", 0); }
    var r3 = _reg_send(client, method, url, h3, 0, 0);
    if (r3 == 0) { return _reg_fail(STIVA_ERR_HTTP, "transport failure", 0); }
    if (sandhi_http_err_kind(r3) != SANDHI_OK) {
        return _reg_fail(STIVA_ERR_HTTP, "transport failure", 0);
    }
    if (sandhi_http_status(r3) == 401) {
        return _reg_fail(STIVA_ERR_AUTH_FAILED, "authentication failed", 401);
    }
    return _reg_resp_terminal(r3);
}

# GET convenience (rust-old: authenticated_get, registry.rs:494-503).
fn _reg_authenticated_get(client, ref, url, scope, accept) {
    return _reg_authenticated_request(client, ref, "GET", url, scope, accept);
}

# ══ Manifest fetch + platform resolve (Inc-5) ════════════
# rust-old/src/registry.rs:381-464.

# What a manifest fetch produced. The oracle uses an enum
# (ManifestResponse::Manifest | ::Index); §B declares no new types, so the
# kind rides alongside the pointer via these two accessors.
enum RegManifestKind {
    REG_MK_NONE = 0;
    REG_MK_MANIFEST = 1;
    REG_MK_INDEX = 2;
}

var _reg_last_manifest_kind = 0;

# Raw manifest bytes + their true digest, from the most recent successful fetch.
#
# The pull driver needs the bytes AS SERVED, not a re-serialization. The oracle
# re-encodes the parsed manifest with `to_vec_pretty` and stores THAT under its
# own digest (rust-old/src/image.rs:151-153) — which is a different digest from
# the one the registry served, so the stored layout no longer matches the
# registry's content-addressed identity and `Docker-Content-Digest` can never be
# re-verified from disk. Keeping the original bytes is what makes the local
# store a truthful OCI image layout.
var _reg_last_manifest_body = 0;
var _reg_last_manifest_body_len = 0;
var _reg_last_manifest_digest = 0;

#[must_use]
fn registry_last_manifest_body() { return _reg_last_manifest_body; }
#[must_use]
fn registry_last_manifest_body_len() { return _reg_last_manifest_body_len; }
#[must_use]
fn registry_last_manifest_digest() { return _reg_last_manifest_digest; }

#[must_use]
fn registry_last_manifest_kind() { return _reg_last_manifest_kind; }

# Fetch the manifest (or index) for `ref` (rust-old: fetch_manifest,
# registry.rs:381-437). Returns an OciManifest* or OciIndex* — which one is
# reported by registry_last_manifest_kind(). Returns 0 on failure.
#
# Digest verification is OPPORTUNISTIC and byte-exact, matching the oracle
# (registry.rs:409-428): only when the registry sends Docker-Content-Digest,
# and compared as a whole string INCLUDING the "sha256:" prefix. A registry
# that returns uppercase hex therefore fails closed. That is defence in depth
# against a MITM or a corrupted cache, not the primary integrity check.
fn registry_fetch_manifest(client, ref) {
    _reg_last_manifest_kind = REG_MK_NONE;
    _reg_last_manifest_body = 0;
    _reg_last_manifest_body_len = 0;
    _reg_last_manifest_digest = 0;
    var url = _reg_manifest_url(client, ref);
    var scope = _reg_pull_scope(ref);
    var r = _reg_authenticated_get(client, ref, url, scope, _reg_manifest_accept());
    if (r == 0) { return 0; }

    var st = sandhi_http_status(r);
    if (st < 200 || st >= 300) {
        # A 3xx reaches here when the redirect budget ran out; the oracle's
        # is_success() guard rejects it rather than parsing a redirect body.
        return _reg_fail(STIVA_ERR_REGISTRY, "manifest fetch failed", st);
    }

    var body = sandhi_http_body(r);
    var blen = sandhi_http_body_len(r);
    if (body == 0 || blen <= 0) {
        return _reg_fail(STIVA_ERR_REGISTRY, "empty manifest body", st);
    }

    var hdrs = sandhi_http_headers(r);
    # Computed unconditionally: it is both the integrity check AND the identity
    # the pull driver stores the manifest blob under.
    var actual = sha256_digest(body, blen);
    var expected = 0;
    if (hdrs != 0) { expected = sandhi_headers_get(hdrs, "Docker-Content-Digest"); }
    # A reference pinned BY DIGEST (repo@sha256:…) is the stronger claim, and it
    # comes from the caller rather than the registry — so it wins. Without this
    # the received bytes are only ever checked against a header the registry
    # chooses whether to send, which makes digest pinning — the exact control
    # you reach for against a compromised registry or a mutated tag — purely
    # decorative.
    var rr: ImageRef = ref;
    if (rr.digest != 0) { expected = rr.digest; }
    if (expected != 0) {
        if (streq(actual, expected) == 0) {
            return _reg_fail(STIVA_ERR_DIGEST_MISMATCH, "manifest digest mismatch", st);
        }
    }

    # Copy the body out of sandhi's response buffer — the caller may issue more
    # requests (resolve_manifest does exactly that) before consuming these.
    var keep = alloc(blen + 1);
    memcpy(keep, body, blen);
    store8(keep + blen, 0);
    _reg_last_manifest_body = keep;
    _reg_last_manifest_body_len = blen;
    _reg_last_manifest_digest = actual;

    var v = bayan_json_v_parse_buf(body, blen);
    if (v == 0) { return _reg_fail(STIVA_ERR_REGISTRY, "manifest is not valid JSON", st); }

    # Index vs manifest: Content-Type first (the oracle's only test), then the
    # body shape as a fallback. The fallback is a deliberate divergence — a
    # registry that omits Content-Type would otherwise have its index parsed as
    # a manifest, yielding an empty layer list and a silently broken pull.
    var ct = 0;
    if (hdrs != 0) { ct = sandhi_headers_get(hdrs, "Content-Type"); }
    var is_index = 0;
    if (ct != 0) {
        if (strstr(ct, "manifest.list") >= 0) { is_index = 1; }
        if (strstr(ct, "image.index") >= 0) { is_index = 1; }
    } else {
        is_index = _reg_body_is_index(v);
    }

    if (is_index == 1) {
        var idx = oci_index_from_jv(v);
        if (idx == 0) { return _reg_fail(STIVA_ERR_REGISTRY, "malformed image index", st); }
        _reg_last_manifest_kind = REG_MK_INDEX;
        return idx;
    }
    var man = oci_manifest_from_jv(v);
    if (man == 0) { return _reg_fail(STIVA_ERR_REGISTRY, "malformed image manifest", st); }
    _reg_last_manifest_kind = REG_MK_MANIFEST;
    return man;
}

# Resolve `ref` to a concrete single-platform manifest (rust-old:
# resolve_manifest, registry.rs:443-464). An index is resolved against
# current_platform() and the selected child is fetched by digest. A nested
# index is rejected. Returns an OciManifest*, or 0.
fn registry_resolve_manifest(client, ref) {
    var first = registry_fetch_manifest(client, ref);
    if (first == 0) { return 0; }
    if (registry_last_manifest_kind() == REG_MK_MANIFEST) { return first; }

    var entry = select_platform(first, current_platform());
    if (entry == 0) {
        return _reg_fail(STIVA_ERR_UNSUPPORTED_PLATFORM, "no manifest for this platform", 0);
    }
    var pe: PlatformManifest = entry;

    # Re-fetch pinned to the selected digest. The ref is built INLINE from the
    # source ref's fields rather than through a helper: an ImageRef obtained
    # from a wrapper fn reads back as garbage in some units under cycc 6.4.77
    # (see CLAUDE.md — it fails silently, not with a crash).
    var sr: ImageRef = ref;
    var pinned = image_ref_new(sr.registry, sr.repository, sr.tag, pe.digest);
    var second = registry_fetch_manifest(client, pinned);
    if (second == 0) { return 0; }
    if (registry_last_manifest_kind() != REG_MK_MANIFEST) {
        return _reg_fail(STIVA_ERR_REGISTRY, "nested manifest list not supported", 0);
    }
    return second;
}

# ══ Blob fetch — STREAMING (Inc-6) ═══════════════════════
# rust-old/src/registry.rs:468-489 buffers the whole blob into bytes::Bytes.
# We stream it to disk instead, hashing as it lands: a layer is routinely
# hundreds of MiB and buffering one is how a container runtime OOMs its host.
# This became possible only at sandhi 1.9.3 — before that the streaming API
# hardcoded `headers = 0` and so could not carry `Authorization`, which is why
# the original §B plan had blobs on the buffered path behind a size ceiling.
#
# We also verify the digest INLINE, which the oracle does not do here (it
# relies on image.rs's store_blob checking on write). Verifying while
# streaming is strictly stronger: a corrupt blob never reaches the
# content-addressed path at all.

# Sink context — 40 bytes.
#   REG_SINK_FD      @0  — destination fd
#   REG_SINK_SHA     @8  — 144-byte sha256 streaming context
#   REG_SINK_WRITTEN @16 — bytes written so far
#   REG_SINK_LIMIT   @24 — hard ceiling, 0 = unbounded
#   REG_SINK_ERR     @32 — 0 ok · 1 short write · 2 limit exceeded
enum RegSinkOff {
    REG_SINK_FD = 0;
    REG_SINK_SHA = 8;
    REG_SINK_WRITTEN = 16;
    REG_SINK_LIMIT = 24;
    REG_SINK_ERR = 32;
}

# The download sink: write, hash, count. Returns 1 to continue, -1 to abort
# (sandhi stops the transfer and reports stopped=1).
fn _reg_blob_sink(ctx, buf, len) {
    var written = load64(ctx + REG_SINK_WRITTEN);
    var limit = load64(ctx + REG_SINK_LIMIT);
    # The descriptor's size is attacker-controlled, so it is a CEILING only —
    # never trusted as the truth. The digest is the authority. Without this a
    # lying registry could stream until the disk filled.
    if (limit > 0 && written + len > limit) {
        store64(ctx + REG_SINK_ERR, 2);
        return 0 - 1;
    }
    var fd = load64(ctx + REG_SINK_FD);
    var off = 0;
    while (off < len) {
        var n = file_write(fd, buf + off, len - off);
        if (n <= 0) {
            store64(ctx + REG_SINK_ERR, 1);
            return 0 - 1;
        }
        off = off + n;
    }
    sha256_update(load64(ctx + REG_SINK_SHA), buf, len);
    store64(ctx + REG_SINK_WRITTEN, written + len);
    return 1;
}

fn _reg_sink_new(fd, sha, limit) {
    var s = alloc(40);
    store64(s + REG_SINK_FD, fd);
    store64(s + REG_SINK_SHA, sha);
    store64(s + REG_SINK_WRITTEN, 0);
    store64(s + REG_SINK_LIMIT, limit);
    store64(s + REG_SINK_ERR, 0);
    return s;
}

# One authenticated streaming attempt against `url`, into `sink`.
fn _reg_blob_stream_once(client, ref, url, scope, sink) {
    var sr: ImageRef = ref;
    var tok = _reg_get_cached_token(client, _reg_cache_key(sr.registry, scope));
    var auth = 0;
    if (tok != 0) { auth = _reg_bearer(tok); }
    # fetch_blob sends no Accept (registry.rs:472).
    var h = _reg_headers(0, auth);
    if (h == 0) { return 0; }
    return _reg_download(client, url, &_reg_blob_sink, sink, h);
}

# Stream blob `digest` for `ref` into the store's content-addressed path,
# verifying SHA-256 as it lands. `expected_size` (from the descriptor, 0 if
# unknown) becomes the sink ceiling. Returns the blob path cstr, or 0.
#
# A blob already present is a no-op — the store is content-addressed, so a
# matching digest is a matching blob.
# One streaming attempt into `tmp`, from a clean slate: truncate, fresh hash
# context, fresh sink. Returns a 2-word [sink, download_result] pair, or 0 if
# the tempfile could not be opened.
fn _reg_blob_attempt(client, ref, url, scope, tmp, limit) {
    var fd = file_open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 420);
    if (fd < 0) { return 0; }
    var sha = alloc(144);
    sha256_init_into(sha);
    var sink = _reg_sink_new(fd, sha, limit);
    var res = _reg_blob_stream_once(client, ref, url, scope, sink);
    file_close(fd);
    var out = alloc(16);
    store64(out + 0, sink);
    store64(out + 8, res);
    return out;
}

fn registry_fetch_blob_to_store(client, store, ref, digest, expected_size) {
    _reg_clear_err();
    if (image_store_has_blob(store, digest) == 1) {
        return _img_blob_path(image_store_root(store), digest);
    }
    var path = _img_blob_path(image_store_root(store), digest);
    # 0 = the digest is not well-formed. Fail closed rather than letting a
    # registry-supplied string become a filesystem path (see digest_is_valid).
    if (path == 0) {
        return _reg_fail(STIVA_ERR_DIGEST_MISMATCH, "malformed blob digest", 0);
    }
    # `.dl` rather than store_blob's `.tmp` so a concurrent import and a pull
    # cannot collide on the same scratch name.
    var tmp = _reg_cat2(path, ".dl");

    var scope = _reg_pull_scope(ref);
    var url = _reg_blob_url(client, ref, digest);
    var lim = 0;
    if (expected_size > 0) { lim = expected_size + 65536; }

    # The streaming path CANNOT see a 401 challenge: sandhi's download driver
    # reports a non-2xx as status + err and never surfaces the hop's response
    # headers, so WWW-Authenticate is unreachable there. The token therefore has
    # to be acquired on the BUFFERED path — a HEAD to the same URL elicits the
    # challenge and populates the cache.
    #
    # Only when the cache is COLD, though. In a real pull the manifest fetch
    # already primed the same registry|scope key, so the common case is one
    # request per blob. Probing unconditionally would double the request count
    # of every layer in the image.
    #
    # ImageRef.registry by raw offset (@0) — see _reg_authenticated_request for
    # why the typed read is not safe in this unit.
    var key = _reg_cache_key(load64(ref + 0), scope);
    if (_reg_get_cached_token(client, key) == 0) {
        if (_reg_authenticated_request(client, ref, "HEAD", url, scope, 0) == 0) { return 0; }
    }

    var a = _reg_blob_attempt(client, ref, url, scope, tmp, lim);
    if (a == 0) { return _reg_fail(STIVA_ERR_IO, "cannot open blob tempfile", 0); }
    var sink = load64(a + 0);
    var res = load64(a + 8);

    # A cached token the registry no longer accepts arrives here as a bare 401
    # with no usable challenge. Re-run the buffered state machine (which
    # refreshes the entry on its own 401) and stream once more. A second 401 is
    # terminal — no unbounded retry loop.
    if (res != 0 && sandhi_download_status(res) == 401) {
        if (_reg_authenticated_request(client, ref, "HEAD", url, scope, 0) == 0) {
            xunlink(tmp);
            return 0;
        }
        a = _reg_blob_attempt(client, ref, url, scope, tmp, lim);
        if (a == 0) {
            # The first attempt's partial tempfile is still on disk here.
            xunlink(tmp);
            return _reg_fail(STIVA_ERR_IO, "cannot open blob tempfile", 0);
        }
        sink = load64(a + 0);
        res = load64(a + 8);
    }

    if (res == 0) {
        xunlink(tmp);
        return _reg_fail(STIVA_ERR_REGISTRY, "blob download failed", 0);
    }
    var serr = load64(sink + REG_SINK_ERR);
    if (serr == 1) {
        xunlink(tmp);
        return _reg_fail(STIVA_ERR_IO, "short write streaming blob", 0);
    }
    if (serr == 2) {
        xunlink(tmp);
        return _reg_fail(STIVA_ERR_REGISTRY, "blob exceeds its descriptor size", 0);
    }
    if (sandhi_download_err(res) != SANDHI_OK) {
        xunlink(tmp);
        return _reg_fail(STIVA_ERR_REGISTRY, "blob download failed", sandhi_download_status(res));
    }
    var dst = sandhi_download_status(res);
    if (dst < 200 || dst >= 300) {
        xunlink(tmp);
        return _reg_fail(STIVA_ERR_REGISTRY, "blob fetch failed", dst);
    }

    # Digest check BEFORE the blob is visible at its content-addressed path.
    var raw = alloc(32);
    sha256_finalize(load64(sink + REG_SINK_SHA), raw);
    var actual = _reg_cat2("sha256:", hex_encode(raw, 32));
    if (streq(actual, digest) == 0) {
        xunlink(tmp);
        return _reg_fail(STIVA_ERR_DIGEST_MISMATCH, "blob digest mismatch", 0);
    }
    if (sys_rename(tmp, path) < 0) {
        xunlink(tmp);
        return _reg_fail(STIVA_ERR_IO, "cannot commit blob", 0);
    }
    return path;
}

# ══ Push (Inc-8) ═══════════════════════════════
# Oracle: rust-old/src/registry.rs:548-800 (blob_exists / push_blob /
# push_blob_chunked / push_manifest). The OCI distribution upload dance is:
#   POST /v2/<repo>/blobs/uploads/   -> 202 + Location
#   PUT  <location>?digest=<digest>  -> 201            (monolithic)
# or
#   PATCH <location> + Content-Range -> 202 + Location (repeat)
#   PUT   <location>?digest=<digest> -> 201            (finalize, empty body)
#
# A body-carrying request does NOT go through _reg_authenticated_request. That
# state machine replays its request up to three times (cached-token attempt,
# unauthenticated probe, post-token retry) — fine for a HEAD, catastrophic for a
# layer upload, which would go up the wire three times. Instead the bodyless
# POST that opens the session primes the token cache, and the PATCH/PUT legs
# carry that cached token directly. This is the oracle's shape too, and for the
# same reason.

# Decimal for a non-negative int. registry.cyr's test unit does not include
# runtime.cyr, so _rt_int_to_cstr is out of reach here.
#[must_use]
fn _reg_uint_str(n) {
    if (n <= 0) { return "0"; }
    var buf = alloc(24);
    var i = 23;
    store8(buf + i, 0);
    var v = n;
    while (v > 0) {
        i = i - 1;
        store8(buf + i, 48 + v % 10);
        v = v / 10;
    }
    return buf + i;
}

# Length of a URL's origin prefix — scheme://host[:port] — or 0 if it has none.
fn _reg_origin_len(url) {
    if (url == 0) { return 0; }
    var n = strlen(url);
    var i = 0;
    var scheme_end = 0 - 1;
    while (i + 2 < n) {
        if (load8(url + i) == 58) {                      # ':'
            if (load8(url + i + 1) == 47) {              # '/'
                if (load8(url + i + 2) == 47) { scheme_end = i + 3; i = n; }
            }
        }
        i = i + 1;
    }
    if (scheme_end < 0) { return 0; }
    var j = scheme_end;
    while (j < n) {
        var c = load8(url + j);
        # The authority ends at the first '/', '?' or '#'. Stopping only at '/'
        # would fold a query string into the origin, so "https://reg.test?x=1"
        # would compare unequal to its own base — and this parser is used as a
        # security control (_reg_same_origin).
        if (c == 47 || c == 63 || c == 35) { return j; }
        j = j + 1;
    }
    return n;
}

# 1 when both URLs share scheme + host + port.
fn _reg_same_origin(a, b) {
    var la = _reg_origin_len(a);
    var lb = _reg_origin_len(b);
    if (la == 0 || lb == 0) { return 0; }
    if (la != lb) { return 0; }
    return memeq(a, b, la);
}

# Headers for a body-carrying push leg: the cached push token, plus an optional
# Content-Type and one optional extra header (Content-Range, for PATCH).
# Content-Length is deliberately NOT set — sandhi emits it for POST/PUT/PATCH
# itself (lib/sandhi.cyr:4256-4267) and rejects a duplicate.
#
# `url` is compared against the API base and the Bearer token is attached ONLY
# when they share an origin.
#
# SECURITY, and a divergence from the oracle: the upload URL comes from the
# registry's `Location` header, and _reg_resolve_location accepts an absolute
# URL. A hostile (or compromised) registry can therefore answer the upload POST
# with `Location: https://evil.example/x` and the oracle will PUT the layer
# there WITH the Authorization header attached (registry.rs:610-625) — handing a
# push-scoped registry token to an arbitrary host. sandhi already strips
# Authorization when a *redirect* crosses origins (lib/sandhi.cyr:5077-5117);
# this is the same policy applied to the Location hop, which is not a redirect
# and so is not covered by it. A registry that genuinely offloads uploads to
# another host must use a pre-signed URL, which is the norm.
fn _reg_push_headers(client, ref, scope, url, base, ctype, xname, xval) {
    var auth = 0;
    if (_reg_same_origin(url, base) == 1) {
        var tok = _reg_get_cached_token(client, _reg_cache_key(load64(ref + 0), scope));
        if (tok != 0) { auth = _reg_bearer(tok); }
    }
    var h = _reg_headers(0, auth);
    if (h == 0) { return 0; }
    if (ctype != 0) {
        if (sandhi_headers_add(h, "Content-Type", ctype) != 0) { return 0; }
    }
    if (xname != 0) {
        if (sandhi_headers_add(h, xname, xval) != 0) { return 0; }
    }
    return h;
}

# 1 when the blob is already in the registry.
#
# DIVERGENCE: the oracle checks with a PULL scope (registry.rs:552) even though
# every caller is a push. On a registry that authenticates HEAD, that mints a
# pull token under the pull cache key — which the upload legs, keyed on
# push,pull, cannot use. The probe is then a wasted round trip AND the upload
# starts cold. Using the push scope makes the precheck prime the exact token the
# upload needs.
#[must_use]
fn registry_blob_exists(client, ref, digest) {
    # Quiet: a 404 here is the ANSWER ("not present"), not a fault. Without this
    # a normal first push prints "registry returned an error status" once per
    # blob, which reads like a failure while the push is working perfectly.
    _reg_quiet = 1;
    var r = _reg_authenticated_request(client, ref, "HEAD",
      _reg_blob_url(client, ref, digest), _reg_push_scope(ref), 0);
    _reg_quiet = 0;
    if (r == 0) { return 0; }
    var st = sandhi_http_status(r);
    if (st >= 200 && st < 300) { return 1; }
    return 0;
}

# Open an upload session. Returns the absolute upload URL, or 0.
fn _reg_start_upload(client, ref, scope) {
    var r = _reg_authenticated_request(client, ref, "POST",
      _reg_uploads_url(client, ref), scope, 0);
    if (r == 0) { return 0; }
    var st = sandhi_http_status(r);
    if (st < 200 || st >= 300) {
        return _reg_fail(STIVA_ERR_REGISTRY, "cannot open blob upload session", st);
    }
    var hdrs = sandhi_http_headers(r);
    var loc = 0;
    if (hdrs != 0) { loc = sandhi_headers_get(hdrs, "Location"); }
    if (loc == 0) {
        return _reg_fail(STIVA_ERR_REGISTRY, "no Location header in upload response", st);
    }
    var base = _reg_api_base(client, ref);
    var abs = _reg_resolve_location(base, loc);
    # SECURITY: reject an off-origin upload target BEFORE any body is sent.
    #
    # _reg_resolve_location honours an absolute URL, so a hostile or compromised
    # registry can answer this POST with `Location: https://evil.example/x`.
    # Withholding the Bearer token there (which _reg_push_headers does) is not
    # enough on its own: the request still goes out with the layer body, the
    # foreign host answers 401 with its own challenge, and the re-auth path
    # would mint a token against ITS realm — sending the configured registry
    # credentials, which for Basic auth are long-lived, to a host the attacker
    # chose. Refusing here closes all of it at once.
    #
    # A registry that genuinely offloads uploads elsewhere uses a pre-signed
    # URL and does not need our credentials; supporting that is a deliberate
    # future decision, not something to allow by omission.
    if (_reg_same_origin(abs, base) == 0) {
        return _reg_fail(STIVA_ERR_REGISTRY, "upload Location is off-origin; refusing", st);
    }
    return abs;
}

# Send one body-carrying push leg, re-authenticating once on a 401.
#
# DIVERGENCE: the oracle sends these legs with whatever token happens to be
# cached and does NOT retry (registry.rs:610-635, 775-788) — a token that
# expired during a long upload turns into a bare 401 with no recovery, and a
# cold cache turns into an unauthenticated PUT. Since the token TTL is 270 s and
# a large layer can easily outlast that, one re-auth is the difference between a
# push that works and a push that fails at the finalize step.
fn _reg_push_send(client, ref, method, url, scope, ctype, xname, xval, body, blen) {
    var base = _reg_api_base(client, ref);
    var h = _reg_push_headers(client, ref, scope, url, base, ctype, xname, xval);
    if (h == 0) {
        # _reg_headers/_reg_push_headers fail CLOSED on a CR/LF-bearing value,
        # and `ctype` can be a registry-supplied mediaType. Without this the
        # push returns 0 with registry_last_error() still reading OK, and the
        # caller reports a failure with no reason at all.
        return _reg_fail(STIVA_ERR_REGISTRY, "cannot build request headers", 0);
    }
    var r = _reg_send(client, method, url, h, body, blen);
    if (r == 0) { return _reg_fail(STIVA_ERR_HTTP, "transport failure", 0); }
    if (sandhi_http_err_kind(r) != SANDHI_OK) {
        return _reg_fail(STIVA_ERR_HTTP, "transport failure", 0);
    }
    if (sandhi_http_status(r) != 401) { return r; }

    # Never mint a token from an off-origin challenge: _reg_acquire_token would
    # GET the realm the FOREIGN host named, carrying the configured Basic
    # credentials. _reg_start_upload already refuses off-origin targets, so this
    # is belt-and-braces for any future caller.
    if (_reg_same_origin(url, base) == 0) {
        return _reg_fail(STIVA_ERR_AUTH_FAILED, "refusing to authenticate off-origin", 401);
    }
    # Unlike the streaming download path, a buffered 401 DOES carry its
    # challenge, so the token can be minted straight from this response — no
    # separate probe request, and no guessing at a URL to probe.
    var www = 0;
    var rh = sandhi_http_headers(r);
    if (rh != 0) { www = sandhi_headers_get(rh, "WWW-Authenticate"); }
    if (www == 0) {
        return _reg_fail(STIVA_ERR_AUTH_FAILED, "401 without www-authenticate header", 401);
    }
    var fresh = _reg_acquire_token(client, www, scope);
    if (fresh == 0) { return 0; }   # already failed + reported
    _reg_cache_token(client, _reg_cache_key(load64(ref + 0), scope), fresh);

    var h2 = _reg_push_headers(client, ref, scope, url, base, ctype, xname, xval);
    if (h2 == 0) {
        return _reg_fail(STIVA_ERR_REGISTRY, "cannot build request headers", 0);
    }
    var r2 = _reg_send(client, method, url, h2, body, blen);
    if (r2 == 0) { return _reg_fail(STIVA_ERR_HTTP, "transport failure", 0); }
    if (sandhi_http_err_kind(r2) != SANDHI_OK) {
        return _reg_fail(STIVA_ERR_HTTP, "transport failure", 0);
    }
    if (sandhi_http_status(r2) == 401) {
        return _reg_fail(STIVA_ERR_AUTH_FAILED, "authentication failed", 401);
    }
    return r2;
}

# Monolithic blob upload. Returns 1 on success, 0 on failure.
fn registry_push_blob(client, ref, digest, data, len) {
    _reg_clear_err();
    if (registry_blob_exists(client, ref, digest) == 1) { return 1; }
    _reg_clear_err();   # a "not present" probe is not an error

    var scope = _reg_push_scope(ref);
    var up = _reg_start_upload(client, ref, scope);
    if (up == 0) { return 0; }

    var r = _reg_push_send(client, ref, "PUT", _reg_append_digest_query(up, digest),
      scope, "application/octet-stream", 0, 0, data, len);
    if (r == 0) { return 0; }
    var st = sandhi_http_status(r);
    if (st < 200 || st >= 300) {
        return _reg_fail(STIVA_ERR_REGISTRY, "blob upload failed", st);
    }
    return 1;
}

# Chunked blob upload, for layers too large to hold in one request.
#
# The session is stateful, so a 401 mid-stream cannot simply be retried the way
# a monolithic PUT can — _reg_push_send's re-auth still applies per leg, but if
# the registry has invalidated the session the finalize will fail loudly rather
# than silently truncating.
fn registry_push_blob_chunked(client, ref, digest, data, len, chunk_size) {
    _reg_clear_err();
    if (chunk_size <= 0) {
        return _reg_fail(STIVA_ERR_REGISTRY, "chunk size must be positive", 0);
    }
    if (registry_blob_exists(client, ref, digest) == 1) { return 1; }
    _reg_clear_err();

    var scope = _reg_push_scope(ref);
    var loc = _reg_start_upload(client, ref, scope);
    if (loc == 0) { return 0; }

    var off = 0;
    while (off < len) {
        var end = off + chunk_size;
        if (end > len) { end = len; }
        # Content-Range is an INCLUSIVE byte range with no "bytes=" prefix
        # (OCI distribution spec; oracle registry.rs:693).
        var rng = _reg_cat2(_reg_cat2(_reg_uint_str(off), "-"), _reg_uint_str(end - 1));
        var r = _reg_push_send(client, ref, "PATCH", loc, scope,
          "application/octet-stream", "Content-Range", rng, data + off, end - off);
        if (r == 0) { return 0; }
        var st = sandhi_http_status(r);
        if (st < 200 || st >= 300) {
            return _reg_fail(STIVA_ERR_REGISTRY, "chunk upload failed", st);
        }
        # The registry may hand back a new Location for the next chunk.
        var hdrs = sandhi_http_headers(r);
        if (hdrs != 0) {
            var nl = sandhi_headers_get(hdrs, "Location");
            if (nl != 0) {
                var nbase = _reg_api_base(client, ref);
                var nabs = _reg_resolve_location(nbase, nl);
                # Same gate as _reg_start_upload — a mid-session redirect to a
                # foreign host is the same attack, once per chunk.
                if (_reg_same_origin(nabs, nbase) == 0) {
                    return _reg_fail(STIVA_ERR_REGISTRY,
                      "upload Location is off-origin; refusing", 0);
                }
                loc = nabs;
            }
        }
        off = end;
    }

    # Finalize: PUT with an empty body.
    var fr = _reg_push_send(client, ref, "PUT", _reg_append_digest_query(loc, digest),
      scope, 0, 0, 0, 0, 0);
    if (fr == 0) { return 0; }
    var fst = sandhi_http_status(fr);
    if (fst < 200 || fst >= 300) {
        return _reg_fail(STIVA_ERR_REGISTRY, "chunked upload finalize failed", fst);
    }
    return 1;
}

# PUT a manifest at ref's tag. `body`/`blen` are the manifest bytes as they
# should be stored — the caller owns serialization, so a manifest pulled from
# one registry can be pushed to another byte-for-byte, preserving its digest.
#
# DIVERGENCE: the oracle probes for a token with `let _ = ...`, discarding the
# result including a failure, then PUTs regardless — so an auth failure becomes
# an unauthenticated PUT and a second, more confusing 401 (registry.rs:766-788).
# We require the probe to succeed. Its own 404 is fine and expected: the tag
# does not exist yet, which is the whole point of pushing it.
fn registry_push_manifest(client, ref, body, blen, ctype) {
    _reg_clear_err();
    if (body == 0 || blen <= 0) {
        return _reg_fail(STIVA_ERR_REGISTRY, "empty manifest body", 0);
    }
    var mt = ctype;
    if (mt == 0) { mt = media_oci_manifest(); }
    var scope = _reg_push_scope(ref);
    # PUT at the TAG, never at the digest. _reg_manifest_url prefers ref.digest,
    # which is right for a FETCH (a digest pins harder than a tag) and wrong
    # here: PUTting to /manifests/sha256:… is spec-legal but creates no tag, so
    # `stiva push localhost:5000/app@sha256:<d>` would produce a repository
    # nothing can pull by name. The oracle uses image.tag unconditionally
    # (rust-old/src/registry.rs:761).
    var rr: ImageRef = ref;
    var url = _reg_cat2(_reg_cat2(_reg_cat2(_reg_api_base(client, ref), "/v2/"),
        rr.repository), _reg_cat2("/manifests/", rr.tag));

    if (_reg_get_cached_token(client, _reg_cache_key(load64(ref + 0), scope)) == 0) {
        # Quiet for the same reason as the blob precheck: a 404 here means "no
        # such tag yet", which is the normal state of affairs when pushing.
        _reg_quiet = 1;
        var probe = _reg_authenticated_request(client, ref, "HEAD", url, scope, 0);
        _reg_quiet = 0;
        if (probe == 0) {
            # A 404/405 means "no such tag yet" / "HEAD unsupported", not an auth
            # problem; only a genuine auth failure should stop the push. The
            # oracle discards this result entirely (`let _ = ...`,
            # registry.rs:769-773) and then PUTs regardless, turning an auth
            # failure into an unauthenticated PUT and a second, confusing 401.
            if (registry_last_error() == STIVA_ERR_AUTH_FAILED) {
                return _reg_fail(STIVA_ERR_AUTH_FAILED, "cannot authenticate for push", 401);
            }
            _reg_clear_err();
        }
    }

    var r = _reg_push_send(client, ref, "PUT", url, scope, mt, 0, 0, body, blen);
    if (r == 0) { return 0; }
    var st = sandhi_http_status(r);
    if (st < 200 || st >= 300) {
        return _reg_fail(STIVA_ERR_REGISTRY, "manifest push failed", st);
    }
    return 1;
}

# ══ Discovery (Inc-9) ═══════════════════════════
# Oracle: rust-old/src/registry.rs:806-897 (list_tags / catalog / referrers)
# and rust-old/src/image.rs:524-551 (verify_signature).

# Parse a JSON body into a vec of the string elements under `key`. An absent or
# non-array field yields an EMPTY vec, not an error — the oracle's
# `.unwrap_or_default()` (registry.rs:826, :866). Non-string elements are
# skipped, matching its `filter_map`.
fn _reg_str_array_field(body, blen, key) {
    var v = bayan_json_v_parse_buf(body, blen);
    if (v == 0) { return 0; }
    var out = vec_new();
    var f = json_v_obj_get(v, key);
    if (json_v_is_arr(f) == 0) { return out; }
    var n = json_v_arr_len(f);
    var i = 0;
    while (i < n) {
        var e = json_v_arr_get(f, i);
        if (json_v_is_str(e) == 1) { vec_push(out, str_cstr(json_v_str(e))); }
        i = i + 1;
    }
    return out;
}

# Tags for a repository: GET /v2/{repo}/tags/list. Returns a vec of cstr, or 0.
# An empty vec means "the repository exists and has no tags"; 0 means the
# request or the parse failed — the two are NOT the same, so callers must
# distinguish them.
fn registry_list_tags(client, ref) {
    _reg_clear_err();
    var r = _reg_authenticated_get(client, ref, _reg_tags_url(client, ref),
      _reg_pull_scope(ref), 0);
    if (r == 0) { return 0; }
    var st = sandhi_http_status(r);
    if (st < 200 || st >= 300) {
        return _reg_fail(STIVA_ERR_REGISTRY, "tag list failed", st);
    }
    var body = sandhi_http_body(r);
    var blen = sandhi_http_body_len(r);
    if (body == 0 || blen <= 0) {
        return _reg_fail(STIVA_ERR_REGISTRY, "empty tag list body", st);
    }
    var tags = _reg_str_array_field(body, blen, "tags");
    if (tags == 0) { return _reg_fail(STIVA_ERR_REGISTRY, "failed to parse tag list", st); }
    return tags;
}

# Repositories in a registry: GET /v2/_catalog. Returns a vec of cstr, or 0.
#
# Sent UNAUTHENTICATED, like the oracle (registry.rs:840-845): the catalog is
# not repository-scoped, so there is no scope to request a token for. Many
# registries disable it outright, and Docker Hub never supported it — a 401 or
# 404 here is ordinary, not a malfunction.
fn registry_catalog(client, registry) {
    _reg_clear_err();
    if (registry == 0) { return 0; }
    # Honour an explicit base URL. Every other builder goes through
    # _reg_api_base; hardcoding https:// here (as the oracle does at
    # registry.rs:840) sends a TLS ClientHello into a plaintext registry for a
    # client built with registry_client_with_base_url("http://localhost:5000"),
    # which this port promotes to a production configuration where the oracle
    # gated it behind #[cfg(test)].
    var base = load64(client + REG_CL_BASE_URL);
    if (base == 0) { base = _reg_cat2("https://", registry_host(registry)); }
    var url = _reg_cat2(base, "/v2/_catalog");
    var h = _reg_headers(0, 0);
    if (h == 0) { return _reg_fail(STIVA_ERR_HTTP, "cannot build request headers", 0); }
    var r = _reg_send(client, "GET", url, h, 0, 0);
    if (r == 0) { return _reg_fail(STIVA_ERR_HTTP, "catalog request failed", 0); }
    if (sandhi_http_err_kind(r) != SANDHI_OK) {
        return _reg_fail(STIVA_ERR_HTTP, "catalog request failed", 0);
    }
    var st = sandhi_http_status(r);
    if (st < 200 || st >= 300) {
        return _reg_fail(STIVA_ERR_REGISTRY, "catalog failed", st);
    }
    var body = sandhi_http_body(r);
    var blen = sandhi_http_body_len(r);
    if (body == 0 || blen <= 0) {
        return _reg_fail(STIVA_ERR_REGISTRY, "empty catalog body", st);
    }
    var repos = _reg_str_array_field(body, blen, "repositories");
    if (repos == 0) { return _reg_fail(STIVA_ERR_REGISTRY, "failed to parse catalog", st); }
    return repos;
}

# Artifacts referencing a manifest: GET /v2/{repo}/referrers/{digest}
# (OCI distribution v1.1.0). Returns a vec of Descriptor*, or 0.
#
# A registry that does not implement referrers answers 404; the oracle
# propagates that as an error and so do we — "no referrers" and "this registry
# cannot answer" are different facts.
fn registry_referrers(client, ref, digest) {
    _reg_clear_err();
    if (digest_is_valid(digest) == 0) {
        return _reg_fail(STIVA_ERR_DIGEST_MISMATCH, "malformed digest", 0);
    }
    var r = _reg_authenticated_get(client, ref, _reg_referrers_url(client, ref, digest),
      _reg_pull_scope(ref), 0);
    if (r == 0) { return 0; }
    var st = sandhi_http_status(r);
    if (st < 200 || st >= 300) {
        return _reg_fail(STIVA_ERR_REGISTRY, "referrers query failed", st);
    }
    var body = sandhi_http_body(r);
    var blen = sandhi_http_body_len(r);
    if (body == 0 || blen <= 0) {
        return _reg_fail(STIVA_ERR_REGISTRY, "empty referrers body", st);
    }
    var v = bayan_json_v_parse_buf(body, blen);
    if (v == 0) { return _reg_fail(STIVA_ERR_REGISTRY, "failed to parse referrers", st); }
    var out = vec_new();
    var f = json_v_obj_get(v, "manifests");
    if (json_v_is_arr(f) == 0) { return out; }
    var n = json_v_arr_len(f);
    var i = 0;
    while (i < n) {
        var d = descriptor_from_jv(json_v_arr_get(f, i));
        # A malformed entry is SKIPPED here, unlike a manifest's layers where a
        # bad descriptor fails the whole parse. Referrers is a discovery list:
        # one unreadable artifact should not hide the readable ones, and nothing
        # downstream depends on the list being complete (oracle: filter_map,
        # registry.rs:892).
        if (d != 0) { vec_push(out, d); }
        i = i + 1;
    }
    return out;
}

# Signature media types recognised by verify_signature (oracle image.rs:535).
#[must_use]
fn media_cosign_signature() {
    return "application/vnd.dev.cosign.simplesigning.v1+json";
}

#[must_use]
fn media_notary_signature() {
    return "application/vnd.cncf.notary.signature";
}

# 1 when a cosign or notation signature artifact references `digest`, 0 when
# none does, and 0 - 1 when the query itself failed.
#
# DIVERGENCE, deliberate: the oracle returns Ok(false) / Err, i.e. two values;
# we return three, because collapsing "no signature" and "could not ask" into
# one falsy answer is how an unverifiable image gets treated as an unsigned one.
# The caller must be able to tell them apart.
#
# This checks only that a signature artifact EXISTS. It does not verify the
# signature cryptographically — neither does the oracle, despite the name.
fn registry_verify_signature(client, ref, digest) {
    var refs = registry_referrers(client, ref, digest);
    if (refs == 0) { return 0 - 1; }
    var n = vec_len(refs);
    var i = 0;
    while (i < n) {
        var dd: Descriptor = vec_get(refs, i);
        var mt = dd.media_type;
        if (mt != 0) {
            if (streq(mt, media_cosign_signature()) == 1) { return 1; }
            if (streq(mt, media_notary_signature()) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Registry tokens are short-lived; the oracle caches for 270 s (its comment says
# 5 minutes, the code says 270 — the code wins).
var _REG_TOKEN_TTL_NS = 270000000000;

fn registry_client_new() {
    return registry_client_with_config(registry_config_default());
}

fn registry_client_with_config(config) {
    var c = alloc(32);
    if (c == 0) { return 0; }
    store64(c + REG_CL_CONFIG, config);
    store64(c + REG_CL_TOKENS, map_new());
    store64(c + REG_CL_BASE_URL, 0);
    store64(c + REG_CL_TRANSPORT, 0);
    return c;
}

# Point the client at an explicit base URL (e.g. http://localhost:5000),
# replacing `https://{registry_host}` everywhere. In the oracle this is
# `#[cfg(test)]`-only; here it is a real field so the CLI can target a local or
# self-hosted registry, and so tests can drive the client without a socket.
fn registry_client_with_base_url(base_url) {
    var c = registry_client_new();
    if (c == 0) { return 0; }
    store64(c + REG_CL_BASE_URL, base_url);
    return c;
}

#[must_use]
fn registry_client_config(client) { return load64(client + REG_CL_CONFIG); }

# ── URL construction (rust-old: api_base / api_bases + the per-call formats) ──

# The API base for an image's registry (rust-old: api_base, registry.rs:348).
# The base_url override wins outright; otherwise https:// + the rewritten host
# (registry_host maps docker.io -> registry-1.docker.io).
#[must_use]
fn _reg_api_base(client, ref) {
    var b = load64(client + REG_CL_BASE_URL);
    if (b != 0) { return b; }
    var rr: ImageRef = ref;
    return _reg_cat2("https://", registry_host(rr.registry));
}

# Every base to try, mirrors first (rust-old: api_bases, registry.rs:358).
# NOTE: dead code in the oracle too — `#[allow(dead_code)]`, never consulted by
# any request path. Ported for parity; deliberately NOT wired (wiring it would
# be a behavior change, not a port). Tracked in the roadmap.
#[must_use]
fn _reg_api_bases(client, ref) {
    var out = vec_new();
    var cfg = load64(client + REG_CL_CONFIG);
    if (cfg != 0) {
        var cc: RegistryConfig = cfg;
        if (cc.mirrors != 0) {
            var n = vec_len(cc.mirrors);
            var i = 0;
            while (i < n) { vec_push(out, vec_get(cc.mirrors, i)); i = i + 1; }
        }
    }
    vec_push(out, _reg_api_base(client, ref));
    return out;
}

# "{base}/v2/{repository}/manifests/{reference}". A digest pins over a tag
# (rust-old: registry.rs:384-388).
#[must_use]
fn _reg_manifest_url(client, ref) {
    var rr: ImageRef = ref;
    var reference = rr.digest;
    if (reference == 0) { reference = rr.tag; }
    var u = _reg_cat2(_reg_api_base(client, ref), "/v2/");
    u = _reg_cat2(u, rr.repository);
    u = _reg_cat2(u, "/manifests/");
    return _reg_cat2(u, reference);
}

# "{base}/v2/{repository}/blobs/{digest}" (rust-old: registry.rs:468-472).
#[must_use]
fn _reg_blob_url(client, ref, digest) {
    var rr: ImageRef = ref;
    var u = _reg_cat2(_reg_api_base(client, ref), "/v2/");
    u = _reg_cat2(u, rr.repository);
    u = _reg_cat2(u, "/blobs/");
    return _reg_cat2(u, digest);
}

# "{base}/v2/{repository}/blobs/uploads/" — the trailing slash is required by
# the distribution spec (rust-old: registry.rs:588).
#[must_use]
fn _reg_uploads_url(client, ref) {
    var rr: ImageRef = ref;
    var u = _reg_cat2(_reg_api_base(client, ref), "/v2/");
    u = _reg_cat2(u, rr.repository);
    return _reg_cat2(u, "/blobs/uploads/");
}

# "{base}/v2/{repository}/tags/list" (rust-old: registry.rs:812).
#[must_use]
fn _reg_tags_url(client, ref) {
    var rr: ImageRef = ref;
    var u = _reg_cat2(_reg_api_base(client, ref), "/v2/");
    u = _reg_cat2(u, rr.repository);
    return _reg_cat2(u, "/tags/list");
}

# "{base}/v2/{repository}/referrers/{digest}" (rust-old: registry.rs:878).
#[must_use]
fn _reg_referrers_url(client, ref, digest) {
    var rr: ImageRef = ref;
    var u = _reg_cat2(_reg_api_base(client, ref), "/v2/");
    u = _reg_cat2(u, rr.repository);
    u = _reg_cat2(u, "/referrers/");
    return _reg_cat2(u, digest);
}

# The bearer scopes (rust-old: registry.rs:400, :763). Order matters: the
# distribution spec's push scope is "push,pull", not "pull,push".
#[must_use]
fn _reg_pull_scope(ref) {
    var rr: ImageRef = ref;
    return _reg_cat2(_reg_cat2("repository:", rr.repository), ":pull");
}

#[must_use]
fn _reg_push_scope(ref) {
    var rr: ImageRef = ref;
    return _reg_cat2(_reg_cat2("repository:", rr.repository), ":push,pull");
}

# The Accept header for a manifest GET — all four types the client understands,
# in the oracle's order (rust-old: registry.rs:390-396).
#[must_use]
fn _reg_manifest_accept() {
    var a = _reg_cat2(media_oci_manifest(), ", ");
    a = _reg_cat2(a, media_oci_index());
    a = _reg_cat2(a, ", ");
    a = _reg_cat2(a, media_manifest_v2());
    a = _reg_cat2(a, ", ");
    return _reg_cat2(a, media_manifest_list_v2());
}

# Resolve an upload Location against the API base (rust-old: registry.rs:600-604).
# An absolute URL is used as-is; a path is appended to the base.
#[must_use]
fn _reg_resolve_location(base, location) {
    if (location == 0) { return 0; }
    if (strlen(location) >= 4) {
        if (memeq(location, "http", 4) == 1) { return location; }
    }
    return _reg_cat2(base, location);
}

# Append ?digest= (or &digest=) to an upload URL (rust-old: registry.rs:607-608).
#[must_use]
fn _reg_append_digest_query(url, digest) {
    var sep = "?";
    if (_reg_find_byte(url, 63) >= 0) { sep = "&"; }   # '?'
    return _reg_cat2(_reg_cat2(_reg_cat2(url, sep), "digest="), digest);
}

# ── Token cache (rust-old: get_cached_token / cache_token) ──
#
# DIVERGENCE, mandatory: the oracle keys on `format!("{}\0{}", registry, scope)`
# — a NUL-separated Rust String. Cyrius maps are CSTR-keyed (lib/hashmap.cyr's
# hash_str walks to the first NUL, and key equality is streq), so a NUL-joined
# key would hash and compare as just the registry, COLLAPSING the pull and
# push,pull scopes into one entry. A push would then reuse a pull-scoped token
# and 401 with no retry (the PUT leg has no re-auth). '|' cannot occur in a
# registry host or an OCI scope (repository names are [a-z0-9._/-]), so it is a
# safe separator with identical semantics.
#[must_use]
fn _reg_cache_key(registry, scope) {
    return _reg_cat2(_reg_cat2(registry, "|"), scope);
}

fn _reg_auth_token_new(token, expires_at_ns) {
    var t = alloc(16);
    store64(t + REG_TOK_TOKEN, token);
    store64(t + REG_TOK_EXPIRES_NS, expires_at_ns);
    return t;
}

# Cache a token with an explicit `now` (rust-old: cache_token, registry.rs:999).
# The `_at` variant is the deterministic-expiry seam the tests drive — same
# pattern as _credential_store_save_to.
fn _reg_cache_token_at(client, key, token, now_ns) {
    map_set(load64(client + REG_CL_TOKENS), key,
      _reg_auth_token_new(token, now_ns + _REG_TOKEN_TTL_NS));
    return 0;
}

fn _reg_cache_token(client, key, token) {
    return _reg_cache_token_at(client, key, token, clock_now_ns());
}

# A cached, unexpired token for `key`, else 0 (rust-old: get_cached_token,
# registry.rs:988). An expired entry is left in place, matching the oracle —
# the next cache_token overwrites it.
#[must_use]
fn _reg_get_cached_token_at(client, key, now_ns) {
    var tokens = load64(client + REG_CL_TOKENS);
    if (map_has(tokens, key) == 0) { return 0; }
    var t = map_get(tokens, key);
    if (t == 0) { return 0; }
    var exp = load64(t + REG_TOK_EXPIRES_NS);
    if (exp != 0 && now_ns >= exp) { return 0; }
    return load64(t + REG_TOK_TOKEN);
}

#[must_use]
fn _reg_get_cached_token(client, key) {
    return _reg_get_cached_token_at(client, key, clock_now_ns());
}

# "{realm}?scope={scope}[&service={service}]" (rust-old: registry.rs:513-516).
#[must_use]
fn _reg_token_url(realm, service, scope) {
    var u = _reg_cat2(_reg_cat2(realm, "?scope="), scope);
    if (service != 0) { u = _reg_cat2(_reg_cat2(u, "&service="), service); }
    return u;
}

# "Basic {base64(user:pass)}" (rust-old: registry.rs:521 basic_auth).
# NOTE: base64_encode returns a raw NUL-terminated cstr, not a Str.
#[must_use]
fn _reg_basic_auth_header(username, password) {
    if (username == 0) { return 0; }
    var raw = _reg_cat2(_reg_cat2(username, ":"), password);
    return _reg_cat2("Basic ", base64_encode(raw, strlen(raw)));
}

# Pull the token out of a token-endpoint body: "token", else "access_token"
# (rust-old: registry.rs:541-545). Returns a cstr, or 0 when neither is present.
#[must_use]
fn _reg_token_from_body(body, body_len) {
    var v = bayan_json_v_parse_buf(body, body_len);
    if (v == 0) { return 0; }
    var t = json_v_obj_get(v, "token");
    if (json_v_is_str(t) == 1) { return str_cstr(json_v_str(t)); }
    var a = json_v_obj_get(v, "access_token");
    if (json_v_is_str(a) == 1) { return str_cstr(json_v_str(a)); }
    return 0;
}

# --- storage.cyr ---

# stiva — container storage: overlay filesystem, volumes, tmpfs, layer unpack.
# Ported from rust-old/src/storage.rs.
#
# What ports cleanly here (self-contained or syscall/ported-dep only):
#   struct VolumeMount { source, target, read_only } + parse_volume
#   struct OverlayPaths { merged, upper, work, container_root }
#     + setup_overlay / teardown_overlay   (mkdir + overlay mount syscalls)
#   mount_volumes                          (parse_volume + bind mount syscall)
#
# NET-NEW (no oracle counterpart): `flatten_layers` — the rootfs the container
# actually gets when overlayfs is unavailable. See its header for why the
# inherited "empty directory" fallback is not usable.
#
# Layer unpacking (unpack_layer / prepare_layers) is implemented on the Cyrius
# stdlib `sankoch` gzip_decompress + zstd_decompress and a hand-rolled USTAR
# tar reader. Both compressed layer media types the OCI image-spec defines are
# therefore supported on the unpack side.
#
# zstd DECODE landed in sankoch 2.5.0 (2026-07-10); the "zstd is absent from
# sankoch" note this header used to carry was stale. zstd *encode*
# (`zstd_compress`) exists too but stiva still builds gzip layers — switching
# the writer is a separate decision, not a codec gap.
#
# Error mapping (mirrors error.cyr): Rust `Err(StivaError::X(String))`
# becomes an integer sentinel here. parse_volume returns 0 (null) on an
# invalid spec (rust-old: Err(StivaError::Storage(...)); caller reports via
# stiva_err_print(STIVA_ERR_STORAGE, detail)). setup_overlay returns 0 on
# no-layers / mount failure (caller: STIVA_ERR_OVERLAY). mount_volumes and
# flatten_layers return -1 on failure (caller: STIVA_ERR_STORAGE).

# ── small cstr helpers (parity-exact byte handling) ──────────────

# Copy bytes [start, end) of `src` into a fresh NUL-terminated cstr.
# Returns the heap pointer (empty cstr if end <= start).
#[must_use]
fn _stor_slice(src, start, end) {
    var n = end - start;
    if (n < 0) { n = 0; }
    var out = alloc(n + 1);
    memcpy(out, src + start, n);
    store8(out + n, 0);
    return out;
}

# Fresh copy of a NUL-terminated cstr.
#[must_use]
fn _stor_dup(s) {
    return _stor_slice(s, 0, strlen(s));
}

# Concatenate two cstrs into a fresh heap cstr.
#[must_use]
fn _stor_cat2(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    var out = alloc(la + lb + 1);
    memcpy(out, a, la);
    memcpy(out + la, b, lb);
    store8(out + la + lb, 0);
    return out;
}

# Count occurrences of `byte` in `s` (so split-part count = count+1).
#[must_use]
fn _stor_count(s, byte) {
    var len = strlen(s);
    var i = 0;
    var c = 0;
    while (i < len) {
        if (load8(s + i) == byte) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Index of the nth (0-based) `byte` in `s`, or -1 if fewer than n+1 present.
#[must_use]
fn _stor_nth_index(s, byte, n) {
    var len = strlen(s);
    var i = 0;
    var seen = 0;
    while (i < len) {
        if (load8(s + i) == byte) {
            if (seen == n) { return i; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# ── VolumeMount ──────────────────────────
# A volume mount definition. `read_only` is 1/0 (rust-old: struct VolumeMount).
struct VolumeMount {
    source;
    target;
    read_only;
}

fn volume_mount_new(source, target, read_only) {
    var v = alloc(24);
    var vv: VolumeMount = v;
    vv.source = source;
    vv.target = target;
    vv.read_only = read_only;
    return v;
}

# Parse a volume string `"source:target[:ro]"` (rust-old: parse_volume).
#
# 2 parts → { source, target, read_only: false }.
# 3 parts → read_only = (parts[2] == "ro").
# Any other count → 0 (rust-old: Err(StivaError::Storage("invalid volume
# spec: {spec}")); caller reports via stiva_err_print(STIVA_ERR_STORAGE)).
#[must_use]
fn parse_volume(spec) {
    var colons = _stor_count(spec, 58);   # ':' = 58
    var nparts = colons + 1;

    if (nparts == 2) {
        var c0 = _stor_nth_index(spec, 58, 0);
        var source = _stor_slice(spec, 0, c0);
        var target = _stor_slice(spec, c0 + 1, strlen(spec));
        return volume_mount_new(source, target, 0);
    }
    if (nparts == 3) {
        var a0 = _stor_nth_index(spec, 58, 0);
        var a1 = _stor_nth_index(spec, 58, 1);
        var src = _stor_slice(spec, 0, a0);
        var tgt = _stor_slice(spec, a0 + 1, a1);
        var mode = _stor_slice(spec, a1 + 1, strlen(spec));
        var ro = 0;
        if (streq(mode, "ro") == 1) { ro = 1; }
        return volume_mount_new(src, tgt, ro);
    }
    return 0;
}

# ── OverlayPaths ──────────────────────────
# Overlay directory layout for a container (rust-old: struct OverlayPaths).
struct OverlayPaths {
    merged;
    upper;
    work;
    container_root;
}

fn overlay_paths_new(merged, upper, work, container_root) {
    var p = alloc(32);
    var pp: OverlayPaths = p;
    pp.merged = merged;
    pp.upper = upper;
    pp.work = work;
    pp.container_root = container_root;
    return p;
}

# Join a dir cstr and a child name with a '/' separator.
#[must_use]
fn _stor_join(dir, name) {
    var slash = _stor_cat2(dir, "/");
    return _stor_cat2(slash, name);
}

# Build the overlay lowerdir option string: layer dirs in REVERSE order
# (top layer first for overlayfs), joined by ':'. `layers` is a vec of
# cstr layer-dir pointers; `n` = its length.
#[must_use]
fn _stor_lowerdir(layers, n) {
    var out = _stor_dup("");
    var i = n - 1;
    while (i >= 0) {
        var dir = vec_get(layers, i);
        out = _stor_cat2(out, dir);
        if (i > 0) { out = _stor_cat2(out, ":"); }
        i = i - 1;
    }
    return out;
}

# Prepare overlay directory structure and mount overlayfs
# (rust-old: setup_overlay). `layers` is a vec of cstr layer-dir pointers
# ordered bottom-to-top; `container_root` is a cstr.
#
# Returns a heap OverlayPaths* on success, or 0 on failure. Rust returns
# Err(StivaError::Overlay(...)) on: empty layers, invalid overlay options
# (NUL in string — not reachable here as we build a clean cstr), or a mount
# failure. Caller reports 0 via stiva_err_print(STIVA_ERR_OVERLAY, detail).
#
# NOTE: the upper/work/merged dirs are created REGARDLESS of mount success,
# matching the Rust ordering (create_dir_all before mount), so a caller
# testing the dir-setup path observes the same side effects.
fn setup_overlay(layers, container_root) {
    if (vec_len(layers) == 0) { return 0; }

    var upper = _stor_join(container_root, "upper");
    var work = _stor_join(container_root, "work");
    var merged = _stor_join(container_root, "merged");

    # 0o755 = 493. create_dir_all analogues; EEXIST is idempotent/fine.
    sys_mkdir(upper, 493);
    sys_mkdir(work, 493);
    sys_mkdir(merged, 493);

    # Build "lowerdir={},upperdir={},workdir={}" mount data.
    var lowerdir = _stor_lowerdir(layers, vec_len(layers));
    var opts = _stor_dup("lowerdir=");
    opts = _stor_cat2(opts, lowerdir);
    opts = _stor_cat2(opts, ",upperdir=");
    opts = _stor_cat2(opts, upper);
    opts = _stor_cat2(opts, ",workdir=");
    opts = _stor_cat2(opts, work);

    # mount("overlay", merged, "overlay", 0, opts). sys_mount returns 0 on
    # success, negative on failure. Rust maps a mount error to
    # Err(StivaError::Overlay("mount overlay failed: ...")).
    var rc = sys_mount("overlay", merged, "overlay", 0, opts);
    if (rc < 0) { return 0; }

    sakshi_info("overlay mounted", strlen("overlay mounted"));
    return overlay_paths_new(merged, upper, work, _stor_dup(container_root));
}

# Tear down overlay filesystem — unmount and clean up (rust-old:
# teardown_overlay). Best-effort throughout: an unmount or rmdir failure is
# ignored (Rust logs a warning / discards the Result). Always returns 0 (Ok).
#
# MNT_DETACH = 2 — lazy unmount if busy (rust-old: UnmountFlags::DETACH).
fn teardown_overlay(paths) {
    var pp: OverlayPaths = paths;

    if (file_exists(pp.merged) == 1) {
        if (sys_umount2(pp.merged, 2) < 0) {
            sakshi_warn("overlay umount failed", strlen("overlay umount failed"));
        }
    }

    # Clean up writable layers (remove_dir_all analogue).
    if (file_exists(pp.upper) == 1) {
        _stor_remove_dir_all(pp.upper);
    }
    if (file_exists(pp.work) == 1) {
        _stor_remove_dir_all(pp.work);
    }

    return 0;
}

# Recursively remove a directory tree (remove_dir_all analogue). Best-effort:
# walks entries via getdents64, recurses into subdirs, unlinks files, then
# rmdir's `path`. Returns 0 always (failures ignored, matching Rust's
# `let _ = std::fs::remove_dir_all(...)`).
#
# `path` is a cstr. Uses a raw getdents64 walk (Linux dirent64: reclen @16,
# d_type @18, d_name @19) — overlayfs is Linux-only, matching the rust-old
# `#[cfg(target_os = "linux")]` gate on the whole teardown mount path.
#
# O_RDONLY = 0, O_DIRECTORY = 65536 (0o200000). DT_DIR = 4.
fn _stor_remove_dir_all(path) {
    # O_DIRECTORY|O_NOFOLLOW (65536|131072). Without O_NOFOLLOW this follows a
    # symlink-to-directory and recursively deletes the TARGET — so a lower layer
    # leaving `dest/foo` as a link to /etc, plus a caller that hands this
    # `dest/foo`, is an arbitrary host-tree delete.
    #
    # Every in-tree caller is currently safe by construction: `_stor_replace_existing`
    # lstats first and only recurses on a real S_IFDIR, and the rest pass paths
    # stiva itself built. That is a property of the CALLERS, not of this function,
    # and the whiteout code below deletes paths named by an untrusted image — so
    # the guarantee belongs here.
    var fd = sys_open(path, 196608, 0);
    if (fd >= 0) {
        var buf = alloc(4096);
        var rgo = 1;
        while (rgo == 1) {
            var n = sys_getdents64(fd, buf, 4096);
            if (n <= 0) { rgo = 0; }
            else {
                var pos = 0;
                while (pos < n) {
                    var reclen = load16(buf + pos + 16);
                    var dtype = load8(buf + pos + 18);
                    var name = buf + pos + 19;
                    # Skip "." and "..".
                    var skip = 0;
                    if (load8(name) == 46) {
                        if (load8(name + 1) == 0) { skip = 1; }
                        if (load8(name + 1) == 46) {
                            if (load8(name + 2) == 0) { skip = 1; }
                        }
                    }
                    if (skip == 0) {
                        var child = _stor_join(path, name);
                        if (dtype == 4) {
                            _stor_remove_dir_all(child);
                        } else {
                            sys_unlink(child);
                        }
                    }
                    pos = pos + reclen;
                }
            }
        }
        sys_close(fd);
    }
    sys_rmdir(path);
    return 0;
}

# ── mount_volumes ─────────────────────────
# Mount bind volumes into the container rootfs (rust-old: mount_volumes,
# Linux path). Each spec is `"source:target[:ro]"`; the target is relative
# to `merged_rootfs`. `volume_specs` is a vec of cstr specs.
#
# Returns a vec of VolumeMount* on success, or 0 on failure. Rust returns
# Err(StivaError::Storage(...)) on a bad spec (via parse_volume) or a bind
# mount failure. Caller reports 0 via stiva_err_print(STIVA_ERR_STORAGE).
#
# MS_BIND = 4096; MS_RDONLY = 1 (rust-old: MountFlags::BIND / ::RDONLY).
fn mount_volumes(volume_specs, merged_rootfs) {
    var mounts = vec_new();
    var n = vec_len(volume_specs);
    var i = 0;
    while (i < n) {
        var spec = vec_get(volume_specs, i);
        var vol = parse_volume(spec);
        if (vol == 0) { return 0; }
        var vv: VolumeMount = vol;

        # target_in_rootfs = merged_rootfs + vol.target (strip a leading '/').
        var tgt = vv.target;
        if (load8(tgt) == 47) { tgt = tgt + 1; }   # '/' = 47
        var target_in_rootfs = _stor_join(merged_rootfs, tgt);

        # 0o755 = 493. create_dir_all for the mountpoint.
        sys_mkdir(target_in_rootfs, 493);

        var flags = 4096;                 # MS_BIND
        if (vv.read_only == 1) { flags = flags + 1; }   # | MS_RDONLY

        var rc = sys_mount(vv.source, target_in_rootfs, "", flags, 0);
        if (rc < 0) { return 0; }

        vec_push(mounts, vol);
        i = i + 1;
    }
    return mounts;
}

# ── Layer unpacking (gzip-tar + zstd-tar) ──────────
# rust-old drives flate2 (gzip) / zstd::stream::Decoder + tar stream decoders;
# here we use the Cyrius stdlib `sankoch` gzip_decompress / zstd_decompress and
# a hand-rolled USTAR reader.

# Read an entire file into a fresh heap buffer. Returns the buffer pointer;
# writes its length to the 8-byte cell at `out_len`. Returns 0 on open
# failure (out_len set to a negative errno). Sizes the buffer via lseek to
# SEEK_END so the whole blob is captured (file_read_all is maxlen-bounded).
#[must_use]
fn _stor_read_file(path, out_len) {
    var fd = file_open(path, 0, 0);        # O_RDONLY
    if (fd < 0) {
        store64(out_len, fd);
        return 0;
    }
    var size = xlseek(fd, 0, 2);           # SEEK_END → byte length
    xlseek(fd, 0, 0);                       # SEEK_SET → rewind
    if (size < 0) {
        file_close(fd);
        store64(out_len, 0 - 1);
        return 0;
    }
    var buf = alloc(size + 1);
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(fd, buf + total, size - total);
        if (n <= 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= size) { rgo = 0; }
        }
    }
    file_close(fd);
    store64(out_len, total);
    return buf;
}

# Parse a NUL/space-terminated octal field of `len` bytes at `p` into an
# i64. USTAR numeric fields (size, mode) are ASCII octal, right-space- or
# NUL-padded. Leading spaces and trailing NUL/space are ignored.
#[must_use]
fn _stor_parse_octal(p, len) {
    # GNU base-256 escape: first byte has 0x80 set — value is big-endian binary
    # in the remaining bytes (used by the writer for size > ~8 GiB, uid/gid > 2^21).
    if ((load8(p) & 128) != 0) {
        var bv = load8(p) & 127;            # low 7 bits of the first byte
        var bi = 1;
        while (bi < len) {
            bv = (bv * 256) + load8(p + bi);
            bi = bi + 1;
        }
        return bv;
    }
    var val = 0;
    var i = 0;
    while (i < len) {
        var c = load8(p + i);
        if (c >= 48 && c <= 55) {           # '0'..'7'
            val = (val * 8) + (c - 48);
        }
        i = i + 1;
    }
    return val;
}

# Recursively create `path` and all missing parents (create_dir_all
# analogue). Walks each '/'-separated prefix and sys_mkdir's it (0o755 =
# 493); EEXIST is idempotent/fine. `path` is a NUL-terminated cstr.
fn _stor_mkdir_p(path) {
    var len = strlen(path);
    var i = 1;                              # skip a leading '/'
    while (i <= len) {
        var at_sep = 0;
        if (i == len) { at_sep = 1; }
        else {
            if (load8(path + i) == 47) { at_sep = 1; }    # '/'
        }
        if (at_sep == 1) {
            var prefix = _stor_slice(path, 0, i);
            sys_mkdir(prefix, 493);
        }
        i = i + 1;
    }
    return 0;
}

# Create every parent directory of a file `path` (the dir portion up to the
# last '/'). No-op when `path` has no '/'.
fn _stor_mkdir_parents(path) {
    var len = strlen(path);
    var slash = 0 - 1;
    var i = 0;
    while (i < len) {
        if (load8(path + i) == 47) { slash = i; }
        i = i + 1;
    }
    if (slash > 0) {
        var dir = _stor_slice(path, 0, slash);
        _stor_mkdir_p(dir);
    }
    return 0;
}

# A tar entry name is safe to extract iff it is RELATIVE and contains no ".."
# component — otherwise it could escape `dest` (path traversal). Rejects an
# absolute name ('/'-prefixed) and any ".." path segment. Returns 1 (safe) / 0.
# rust-old relied on the `tar` crate's built-in guard; this restores it for
# untrusted archives (oci-archive load) and untrusted image layers (unpack).
fn _stor_name_is_safe(name) {
    var len = strlen(name);
    if (len == 0) { return 0; }
    if (load8(name) == 47) { return 0; }        # absolute
    var i = 0;
    while (i < len) {
        # i is at a component start (i==0 or the previous byte was '/').
        if (load8(name + i) == 46) {                        # '.'
            if (i + 1 < len && load8(name + i + 1) == 46) { # '..'
                var e = i + 2;
                if (e == len || load8(name + e) == 47) { return 0; }
            }
        }
        while (i < len && load8(name + i) != 47) { i = i + 1; }
        while (i < len && load8(name + i) == 47) { i = i + 1; }
    }
    return 1;
}

# True (1) iff a symlink target contains a ".." component (a relative escape).
# Absolute targets are allowed — a legitimate rootfs symlink (e.g. /lib →
# /usr/lib) resolves against the container root at runtime, not at extraction.
fn _stor_target_escapes(target) {
    var len = strlen(target);
    var i = 0;
    while (i < len) {
        if (load8(target + i) == 46) {
            if (i + 1 < len && load8(target + i + 1) == 46) {
                var e = i + 2;
                if (e == len || load8(target + e) == 47) {
                    if (i == 0 || load8(target + i - 1) == 47) { return 1; }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# True (1) iff `path` exists and is a symlink (lstat S_IFLNK). Used to avoid
# writing a file THROUGH an existing symlink during extraction.
#[must_use]
fn _stor_is_symlink(path) {
    var sb = alloc(144);
    if (sys_lstat(path, sb) != 0) { return 0; }
    if ((load64(sb + 24) & 61440) == 40960) { return 1; }   # S_IFMT == S_IFLNK
    return 0;
}

# True (1) iff any ANCESTOR directory of `dest/name` (a component of `name`, not
# the final one) already exists as a symlink. A malicious archive can plant a
# symlink entry (e.g. `x → /etc`) then a later `x/evil` entry that would be
# written through the link, escaping `dest`. Refusing to descend through a
# symlinked ancestor blocks that (the O_NOFOLLOW-per-component defense the `tar`
# crate gives, without an openat wrapper).
#[must_use]
fn _stor_has_symlink_ancestor(dest, name) {
    var sb = alloc(144);
    # Build "dest/name" ONCE (mutable), then lstat each ancestor by temporarily
    # NUL-terminating at its trailing '/' and restoring it — O(len) total rather
    # than the O(len^2) of rebuilding the prefix per component.
    var full = _stor_join(dest, name);
    var flen = strlen(full);
    var i = strlen(dest) + 1;                    # skip dest + '/' (dest is trusted)
    while (i < flen) {
        if (load8(full + i) == 47) {             # ancestor boundary
            store8(full + i, 0);                 # terminate the prefix at the '/'
            var is_link = 0;
            if (sys_lstat(full, sb) == 0) {
                if ((load64(sb + 24) & 61440) == 40960) { is_link = 1; }   # S_IFLNK
            }
            store8(full + i, 47);                # restore
            if (is_link == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Extract a decompressed USTAR archive `tar` of `tar_len` bytes into `dest`.
# Minimal reader: 512-byte headers — name@0 (100b), mode@100, uid@108, gid@116,
# size@124 (12b octal), typeflag@156 ('0'/'\0' = file, '5' = dir, '2' = symlink),
# linkname@157. File data follows in ceil(size/512) 512-byte blocks. Two all-zero
# blocks (or running out of bytes) ends the archive.
#
# Perms: chown is applied BEFORE chmod (chown clears setuid/setgid), best-effort
# (needs root). Path-traversal names (absolute / "..") and ".."-escaping symlink
# targets are rejected — an untrusted archive must not escape `dest`.
# Returns 0 on success, -1 on a malformed header (short/torn block).
fn _stor_extract_tar(tar, tar_len, dest) {
    var pos = 0;
    var pending_name = 0;    # GNU 'L' long-name for the next real entry (0 = none)
    var pending_link = 0;    # GNU 'K' long-link target for the next symlink entry
    var rgo = 1;
    while (rgo == 1) {
        # Need a full 512-byte header block.
        if (pos + 512 > tar_len) { rgo = 0; }
        else {
            var hdr = tar + pos;
            # All-zero name byte @0 marks the end-of-archive block(s).
            if (load8(hdr) == 0) {
                rgo = 0;
            } else {
                # USTAR name field is exactly 100 bytes and is NOT NUL-terminated
                # when the name fills all 100 — bound the copy to avoid over-read.
                var nlen = 0;
                while (nlen < 100 && load8(hdr + nlen) != 0) { nlen = nlen + 1; }
                var name = _stor_slice(hdr, 0, nlen);
                # USTAR prefix@345(155): if present, full name = prefix + '/' + name.
                if (load8(hdr + 345) != 0) {
                    var plen = 0;
                    while (plen < 155 && load8(hdr + 345 + plen) != 0) { plen = plen + 1; }
                    name = _stor_cat2(_stor_cat2(_stor_slice(hdr, 345, 345 + plen), "/"), name);
                }
                var mode = _stor_parse_octal(hdr + 100, 8);   # perm bits @100
                var uid = _stor_parse_octal(hdr + 108, 8);    # uid @108
                var gid = _stor_parse_octal(hdr + 116, 8);    # gid @116
                var size = _stor_parse_octal(hdr + 124, 12);
                var typeflag = load8(hdr + 156);
                pos = pos + 512;                        # advance past header

                # Validate the size against the remaining bytes BEFORE any use — a
                # negative (crafted base-256 / >2^63 octal) or oversized value would
                # otherwise slip past the signed torn-region check into a huge
                # `sys_write` (heap over-read) and drive `pos` backward (OOB header
                # reads). `pos <= tar_len` holds here (header block was in-range).
                if (size < 0 || size > tar_len - pos) {
                    return 0 - 1;
                }
                # Bound GNU long-name / long-link length: a crafted multi-MB name
                # (gzip-amplified) would otherwise drive the per-component ancestor
                # scan + lstat into a CPU DoS. Real paths are < PATH_MAX (4096);
                # 8 KiB is a generous ceiling.
                if (typeflag == 76 || typeflag == 75) {
                    if (size > 8192) { return 0 - 1; }
                }

                if (typeflag == 76) {                   # 'L' GNU long name
                    # The data (name + NUL, size bytes) is the name of the NEXT entry.
                    var lnn = size;
                    if (lnn > 0) { lnn = lnn - 1; }     # drop the trailing NUL
                    pending_name = _stor_slice(tar + pos, 0, lnn);
                } else {
                    if (typeflag == 75) {               # 'K' GNU long link target
                        var lkn = size;
                        if (lkn > 0) { lkn = lkn - 1; }
                        pending_link = _stor_slice(tar + pos, 0, lkn);
                    } else {
                        # Real entry — a pending 'L'/'K' overrides the header fields.
                        # Reject path-traversal names / a symlinked ancestor (either
                        # would escape `dest`); skipped entries still step over data.
                        var ename = name;
                        if (pending_name != 0) { ename = pending_name; }
                        if (_stor_name_is_safe(ename) == 1 && _stor_has_symlink_ancestor(dest, ename) == 0) {
                            var full = _stor_join(dest, ename);
                            if (typeflag == 53) {                   # '5' → directory
                                _stor_mkdir_p(full);
                                _stor_lchown(full, uid, gid);       # chown BEFORE chmod:
                                if (mode != 0) { sys_chmod(full, mode); }   # chown clears setuid/setgid
                            } else {
                                if (typeflag == 50) {               # '2' → symlink
                                    var target = pending_link;
                                    if (target == 0) {
                                        var lnlen = 0;
                                        while (lnlen < 100 && load8(hdr + 157 + lnlen) != 0) { lnlen = lnlen + 1; }
                                        target = _stor_slice(hdr + 157, 0, lnlen);
                                    }
                                    if (_stor_target_escapes(target) == 0) {
                                        _stor_mkdir_parents(full);
                                        if (_stor_is_symlink(full) == 1) { sys_unlink(full); }
                                        sys_symlink(target, full);
                                        _stor_lchown(full, uid, gid);   # perms follow target → no chmod
                                    }
                                } else {
                                    if (typeflag == 48 || typeflag == 0) {   # '0' or '\0' → file
                                        _stor_mkdir_parents(full);
                                        # Never write THROUGH an existing symlink at the target.
                                        if (_stor_is_symlink(full) == 1) { sys_unlink(full); }
                                        file_write_all(full, tar + pos, size);
                                        _stor_lchown(full, uid, gid);   # chown BEFORE chmod
                                        if (mode != 0) { sys_chmod(full, mode); }
                                    }
                                    # else: char/block/fifo/hardlink — skipped.
                                }
                            }
                        }
                        pending_name = 0;
                        pending_link = 0;
                    }
                }

                # Step over the file data: ceil(size/512) blocks.
                var blocks = (size + 511) / 512;
                pos = pos + (blocks * 512);
            }
        }
    }
    return 0;
}

# ── gzip compression (streaming — the batch encoder is unusable) ──────────
#
# UPSTREAM BUG — sankoch's batch `gzip_compress` / `deflate_compress*` writes a
# MALFORMED stream for any input larger than DEFLATE_BLOCK_SIZE (1 MiB).
#
# `_deflate_compress_level_inner` (lib/sankoch.cyr:4814) chunks the input into
# 1 MiB outer blocks and resumes each next block at `block_end`. But the
# per-block encoders — `_deflate_compress_fixed_block` (:4845, levels 1-3) and
# `_deflate_compress_dynamic_block` (:5100, levels 4-9) — legitimately run PAST
# `block_end`: they match against the FULL `src`, so a match starting just
# below the boundary carries up to LZ77_MAX_MATCH (258) bytes over it. That
# overshoot is discarded by the chunker and re-emitted by the following block,
# so the stream decodes to `src_len + overshoot` bytes and the gzip trailer's
# CRC-32 no longer matches — `gzip_decompress` returns -ERR_CHECKSUM_MISMATCH
# (-5), which `unpack_layer` maps to its -1 sentinel. Measured on a 2 MB input:
# 220 bytes duplicated at offset 1048576, decoded length 2000220. GNU `gunzip`
# rejects the very same stream at the very same offset, so this is a genuinely
# malformed stream, not a decoder disagreement — and the sankoch DECODER is
# correct (streams from GNU gzip round-trip byte-exact).
#
# The STREAMING encoder is not affected: `_denc_consume` (:5373) stores the
# offset its LZ77 loop actually reached back into the encoder ctx, so an
# overshoot carries into the next consume instead of being re-encoded. It is
# also byte-compatible with GNU gunzip, and compresses marginally SMALLER than
# the batch path (4904 vs 4943 bytes on that same 2 MB input) — RFC 1951 caps
# back-references at 32 KiB regardless, so the 1 MiB outer chunk never bought
# any extra match reach to lose.
#
# Every gzip layer blob stiva WRITES therefore goes through here. Layers stiva
# READS are unaffected (they come from a correct encoder), so
# `_stor_unpack_gz_bytes` below is unchanged.
#
# Feed size for `gzip_enc_write`. The encoder copies input through a 64 KiB
# sliding window and consumes it as it goes, so this bounds nothing but the
# per-call loop; 256 KiB keeps the call count low without a large working set.
var _STOR_GZ_FEED = 262144;

# Compress `src[0..src_len)` into `dst` as a gzip stream, at the same level 6
# the batch `gzip_compress` used. Returns the byte length written (>= 0), or a
# negative sankoch ERR_* on failure. `dst_cap` must be >= 18 (10-byte header +
# 8-byte trailer).
#
# `gzip_enc_init` takes sankoch's mutex and `gzip_enc_finish` is what RELEASES
# it, so finish MUST run even after a write error — hence the sticky `werr`
# rather than an early return.
#[must_use]
fn _stor_gzip_compress(src, src_len, dst, dst_cap) {
    if (src_len < 0) { return 0 - 1; }
    var ctx = gzip_enc_init(6, dst, dst_cap);
    if (ctx == 0) { return 0 - 1; }        # bad args / OOM (lock already released)

    var off = 0;
    var werr = 0;
    while (off < src_len && werr == 0) {
        var take = _STOR_GZ_FEED;
        if (off + take > src_len) { take = src_len - off; }
        werr = gzip_enc_write(ctx, src + off, take);
        off = off + take;
    }

    var out = gzip_enc_finish(ctx);        # releases the mutex on every path
    if (werr < 0) { return werr; }
    return out;
}

# ── Decompression ceilings — SHARED by both layer codecs ────────────────
# Layer blobs are attacker-influenced: `stiva pull` fetches them from an
# arbitrary registry and `stiva load` reads them out of an untrusted
# oci-archive / docker-archive. Neither decode path may size its output buffer
# from the blob alone, so both bound it here, the same way.
#
# Two ceilings, because a bomb reaches each path differently:
#   * zstd DECLARES its output size — Frame_Content_Size is read straight out
#     of the attacker-supplied frame header, so honouring it blindly is
#     allocation amplification: a 100-byte blob can declare 1 TiB.
#   * gzip declares nothing, so its buffer is a guess that doubles on
#     ERR_BUFFER_TOO_SMALL. That reacts to actual decoded output rather than a
#     forged header — which defeats amplification from a *small* blob, but does
#     NOT bound the loop: a blob that genuinely decodes large walks the buffer
#     up one doubling at a time, unbounded. Same DoS, reached in steps.
# The ceilings terminate both.
#
# _STOR_MAX_OUT is absolute (large ML base layers run to single-digit GiB).
# _STOR_MAX_RATIO bounds output against the compressed length, floored at
# _STOR_MIN_OUT so a legitimately tiny blob is not rejected for a ratio it
# cannot avoid — the guessed cap starts at 1 MiB, and a blob small enough for
# the floor to bind decodes to at most ~1 MiB anyway.
#
# Real layers clear both by orders of magnitude. Note deflate's own maximum is
# 1032:1, so on the gzip path the ratio only rejects a near-pure run of one
# repeated byte and _STOR_MAX_OUT is the operative bound; zstd's RLE has no
# such limit, which is why the ratio carries that path.
var _STOR_MAX_OUT = 8589934592;         # 8 GiB absolute
var _STOR_MAX_RATIO = 1000;             # vs. the compressed length
var _STOR_MIN_OUT = 1048576;            # 1 MiB — ratio floor + initial cap

# Largest output buffer either codec may allocate for `blob_len` compressed
# bytes: the ratio bound, floored at _STOR_MIN_OUT and capped at the absolute
# ceiling. A grow-retry loop cannot free its rejected buffers (lib/alloc.cyr
# exposes no bare `free`), so cumulative allocation across a full doubling run
# is bounded at ~2x this, and peak live at exactly this.
fn _stor_decomp_limit(blob_len) {
    var lim = blob_len * _STOR_MAX_RATIO;
    if (lim < _STOR_MIN_OUT) { lim = _STOR_MIN_OUT; }
    if (lim > _STOR_MAX_OUT) { lim = _STOR_MAX_OUT; }
    return lim;}

# Decompress a gzip'd tar `file` and extract it into `dest` (rust-old:
# unpack_tar_gz — flate2 GzDecoder + tar::Archive). `blob` is the raw
# gzip bytes, `blob_len` its length. Returns 0 on success, negative on
# failure (gzip error → the sankoch ERR_* negative; tar error → -1).
#
# The decompressed size is unknown up front; we size the output buffer
# generously (32x the compressed size, min 1 MiB) and retry doubling on
# ERR_BUFFER_TOO_SMALL, up to _stor_decomp_limit. gzip's trailer ISIZE could
# size it exactly, but it is as attacker-controlled as zstd's FCS and a growth
# loop is codec-agnostic. Hitting the ceiling returns -2: the blob decodes to
# more than we are willing to hold, i.e. a decompression bomb.
fn _stor_unpack_gz_bytes(blob, blob_len, dest) {
    var limit = _stor_decomp_limit(blob_len);
    var cap = blob_len * 32;
    if (cap < _STOR_MIN_OUT) { cap = _STOR_MIN_OUT; }   # >= 1 MiB
    if (cap > limit) { cap = limit; }
    var dlen = 0 - 1;
    var tries = 0;
    var out = 0;
    var rgo = 1;
    while (rgo == 1) {
        out = alloc(cap);
        dlen = gzip_decompress(blob, blob_len, out, cap);
        if (dlen == (0 - 2)) {              # ERR_BUFFER_TOO_SMALL → grow + retry
            if (cap >= limit) { return 0 - 2; }     # ceiling → decompression bomb
            cap = cap * 2;
            if (cap > limit) { cap = limit; }
            tries = tries + 1;
            if (tries > 24) { return 0 - 2; }   # backstop; the ceiling above binds first
        } else {
            rgo = 0;
        }
    }
    if (dlen < 0) { return dlen; }          # gzip decode failed (not gzip, corrupt, …)
    return _stor_extract_tar(out, dlen, dest);
}

# Decompress a zstd'd tar `blob` and extract it into `dest` (rust-old:
# unpack_tar_zstd — zstd::stream::Decoder + tar::Archive). Returns 0 on
# success, negative on failure.
#
# Unlike gzip, `zstd_decompress` (lib/sankoch.cyr:10401) returns -1 for BOTH a
# too-small output buffer (`:10458`) and a corrupt frame — the two are
# indistinguishable by return code — so a grow-retry loop cannot be driven off
# it the way _stor_unpack_gz_bytes drives off ERR_BUFFER_TOO_SMALL. We size the
# buffer from the frame header instead (`zstd_frame_content_size`, `:10465`),
# and only fall back to bounded grow-retry when the header omits the size
# (fcs_flag 0 on a multi-frame input), where a corrupt blob simply costs a few
# wasted attempts before failing.
fn _stor_unpack_zstd_bytes(blob, blob_len, dest) {
    var limit = _stor_decomp_limit(blob_len);
    var cap = zstd_frame_content_size(blob, blob_len);
    if (cap > 0) {
        if (cap > limit) { return 0 - 1; }      # declared size over the ceiling
        var out1 = alloc(cap);
        var dlen1 = zstd_decompress(blob, blob_len, out1, cap);
        if (dlen1 < 0) { return dlen1; }
        return _stor_extract_tar(out1, dlen1, dest);
    }

    # Frame declares no content size — grow-retry, bounded by the same ceiling.
    var gcap = blob_len * 32;
    if (gcap < _STOR_MIN_OUT) { gcap = _STOR_MIN_OUT; }     # >= 1 MiB
    if (gcap > limit) { gcap = limit; }
    var tries = 0;
    while (tries < 12) {
        var out = alloc(gcap);
        var dlen = zstd_decompress(blob, blob_len, out, gcap);
        if (dlen >= 0) { return _stor_extract_tar(out, dlen, dest); }
        if (gcap >= limit) { return 0 - 1; }    # ceiling → bomb (or a corrupt frame)
        gcap = gcap * 2;
        if (gcap > limit) { gcap = limit; }
        tries = tries + 1;
    }
    return 0 - 1;
}

# Unpack a single layer blob to a directory (rust-old: unpack_layer).
# Supports gzip-tar and zstd-tar. `blob_path` and `dest` are cstrs.
#
# rust-old attempts gzip and falls back to zstd on failure. We sniff the 4-byte
# zstd magic (28 B5 2F FD) and dispatch instead: observably identical for every
# real input, but it avoids allocating the gzip path's 32x output buffer only to
# have `gzip_decompress` reject the magic immediately. Anything that is not a
# zstd frame still goes down the gzip path, which fast-fails on bad magic — so
# the "try both" behaviour is preserved where it matters.
#
# Returns 0 on success, -1 on failure (rust-old maps every failure — open,
# decode, tar — to Err(StivaError::LayerUnpack)). The caller reports the -1
# via stiva_err_print(STIVA_ERR_LAYER_UNPACK, detail); the sentinel stays a
# plain integer here (matching parse_volume/mount_volumes in this module,
# which never name a cross-module enum const in executable code).
fn unpack_layer(blob_path, dest) {
    var len_cell = alloc(8);
    var blob = _stor_read_file(blob_path, len_cell);
    if (blob == 0) { return 0 - 1; }        # cannot open blob
    var blob_len = load64(len_cell);

    var is_zstd = 0;
    if (blob_len >= 4) {
        if ((load8(blob) & 0xFF) == 0x28 && (load8(blob + 1) & 0xFF) == 0xB5
          && (load8(blob + 2) & 0xFF) == 0x2F && (load8(blob + 3) & 0xFF) == 0xFD) {
            is_zstd = 1;
        }
    }

    var rc = 0 - 1;
    if (is_zstd == 1) {
        rc = _stor_unpack_zstd_bytes(blob, blob_len, dest);
    } else {
        rc = _stor_unpack_gz_bytes(blob, blob_len, dest);
    }
    if (rc == 0) { return 0; }
    return 0 - 1;
}

# Unpack all image layers to the store's `layers/` directory (rust-old:
# prepare_layers). `store` is an ImageStore* (image.cyr); `layers` is a vec
# of Layer* ordered bottom-to-top. Returns an ordered vec of layer-dir cstrs
# (bottom first). Layers already unpacked are skipped (dedup by a `.unpacked`
# marker). Returns 0 on failure (a missing blob, or an unpack error) — caller
# reports via stiva_err_print(STIVA_ERR_LAYER_UNPACK, detail).
fn prepare_layers(store, layers) {
    var layer_dirs = vec_new();
    var root = image_store_root(store);
    var layers_base = _stor_cat2(root, "/layers");
    var n = vec_len(layers);
    var i = 0;
    while (i < n) {
        var layer = vec_get(layers, i);
        # Layer is defined in image.cyr (struct Layer { digest; size_bytes;
        # media_type }); digest is field 0. Read it by raw offset so this
        # module parses standalone (no cross-module struct type annotation).
        var digest = load64(layer);
        var hex = digest_hex(digest);              # strip "sha256:" prefix
        var layer_dir = _stor_join(layers_base, hex);
        var marker = _stor_join(layer_dir, ".unpacked");

        # Dedup: already-unpacked layers are skipped.
        if (file_exists(layer_dir) == 1) {
            if (file_exists(marker) == 1) {
                sakshi_info("layer already unpacked, skipping", strlen("layer already unpacked, skipping"));
                vec_push(layer_dirs, layer_dir);
                i = i + 1;
                continue;
            }
        }

        _stor_mkdir_p(layer_dir);

        # Blob must exist at blobs/sha256/<hex>.
        var blob_base = _stor_cat2(root, "/blobs/sha256/");
        var blob_path = _stor_cat2(blob_base, hex);
        if (file_exists(blob_path) == 0) {
            return 0;                               # rust-old: LayerUnpack("blob not found …")
        }

        sakshi_info("unpacking layer", strlen("unpacking layer"));
        var rc = unpack_layer(blob_path, layer_dir);
        if (rc != 0) { return 0; }

        # Mark as unpacked so we skip next time (write empty file).
        file_write_all(marker, "", 0);

        vec_push(layer_dirs, layer_dir);
        i = i + 1;
    }
    return layer_dirs;
}

# ── Layer FLATTEN — the rootfs when overlayfs is unavailable ──────
# NET-NEW (no oracle): rust-old has no counterpart. `setup_overlay` needs
# CAP_SYS_ADMIN and an overlayfs-capable kernel; when it fails, the oracle
# falls back to a bare `container_root.join("rootfs")` and never puts anything
# in it (rust-old/src/container.rs:366-369), so an unprivileged container runs
# against an EMPTY directory. Flattening the already-unpacked layer dirs into
# that directory is what makes the fallback a usable rootfs.
#
# Semantics match the overlayfs lowerdir stack this module builds: layers are
# applied BOTTOM-TO-TOP and a later layer's entry replaces an earlier one.
#
# COPY, not hard-link. Hard links would share inodes with the store's `layers/`
# cache, so the first write inside any container would corrupt the layer every
# other container reads. That is the same reason Docker's `vfs` driver copies.
#
# WHITEOUTS ARE NOT APPLIED, deliberately. OCI `.wh.<name>` / `.wh..wh..opq`
# markers are extracted literally by `_stor_extract_tar`, so overlayfs (which
# understands only its own char-dev-0:0 whiteouts, not the tar convention) does
# not honour them either. Applying them here alone would make an unprivileged
# rootfs differ from a privileged one for the same image. It is a real gap —
# a file deleted in an upper layer stays visible — but it belongs to BOTH paths
# and is tracked as one item; see docs/development/roadmap.md.

# Copy the BYTES of regular file `src` to `dst`, streaming through the caller's
# `buf` (`buflen` bytes) so peak memory is one chunk no matter how large the file
# is — unlike `_stor_read_file` + `file_write_all`, which would hold every file
# of the tree at once in the bump arena (`alloc` never frees).
#
# Ownership and mode are the CALLER's job (lchown then chmod, in that order).
# O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577, created 0o600 (384) so the file is
# never even briefly world-readable while its real mode is still pending.
# Returns 0 on success, -1 on any open/read/write failure.
fn _stor_copy_file_streamed(src, dst, buf, buflen) {
    var rfd = file_open(src, 0, 0);                # O_RDONLY
    # An unreadable SOURCE is not fatal — see the caller. -2 distinguishes it
    # from a write-side failure so the caller can skip rather than abort.
    if (rfd < 0) { return 0 - 2; }
    # O_WRONLY|O_CREAT|O_TRUNC|O_NOFOLLOW. O_NOFOLLOW (0o100000) is the
    # belt-and-braces half of the symlink fix: even if a stale link somehow
    # survives _stor_replace_existing, the write fails with ELOOP instead of
    # landing on the link's target somewhere outside the rootfs.
    var wfd = file_open(dst, 131649, 384);
    if (wfd < 0) {
        file_close(rfd);
        return 0 - 1;
    }
    var rc = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(rfd, buf, buflen);
        if (n < 0) { rc = 0 - 1; rgo = 0; }
        else {
            if (n == 0) { rgo = 0; }               # EOF
            else {
                # A short write is legal; drain the chunk before reading more.
                var off = 0;
                while (off < n) {
                    var w = sys_write(wfd, buf + off, n - off);
                    if (w <= 0) {
                        rc = 0 - 1;
                        off = n;                   # abandon the chunk
                        rgo = 0;
                    } else {
                        off = off + w;
                    }
                }
            }
        }
    }
    file_close(wfd);
    file_close(rfd);
    return rc;
}

# Clear whatever currently occupies `path` so a higher layer's entry can take
# it: a directory is removed recursively, anything else unlinked. Absent → no-op.
# `sb` is a caller-owned 144-byte struct stat scratch. Always returns 0.
# Remove whatever sits at `path` so a new entry can take its place. Returns 0
# when the path is CLEAR afterwards, -1 when something is still there.
#
# The return value is load-bearing: the caller writes to `path` next, and an
# unlink that failed (a read-only parent directory is enough) leaves a symlink
# in place for that write to follow — straight out of the container rootfs.
# Silently ignoring the failure is how this became an arbitrary-file-overwrite.
# Merge-aware variant for the directory branch: an existing DIRECTORY is kept
# (that is the merge), anything else must be removed and verified gone.
fn _stor_replace_existing_dirsafe(path, sb) {
    if (sys_lstat(path, sb) != 0) { return 0; }             # nothing there
    if ((load64(sb + 24) & 61440) == 16384) { return 0; }   # already a dir — merge
    sys_unlink(path);
    if (sys_lstat(path, sb) == 0) { return 0 - 1; }         # still there — refuse
    return 0;
}

fn _stor_replace_existing(path, sb) {
    if (sys_lstat(path, sb) != 0) { return 0; }             # nothing there
    if ((load64(sb + 24) & 61440) == 16384) {               # S_IFDIR
        _stor_remove_dir_all(path);
    } else {
        sys_unlink(path);
    }
    if (sys_lstat(path, sb) == 0) { return 0 - 1; }         # still there — refuse
    return 0;
}

# Merge the tree under `src` into `dst`, source entries winning over anything
# already present (so calling this once per layer, bottom-to-top, yields the
# overlay stack's view). Perms-preserving: real mode via chmod and uid/gid via
# lchown (best-effort, needs root), chown BEFORE chmod because chown clears
# setuid/setgid — the same ordering `_stor_extract_tar` uses. Symlinks are
# recreated as links, never dereferenced.
#
# Linux struct stat: st_mode@24(u32) st_uid@28 st_gid@32; dirent64: d_reclen@16
# d_name@19 — matching `_stor_tar_collect`. `cpbuf`/`cplen` is the shared file
# copy buffer. Returns 0, or -1 if any entry could not be materialized.
#
# SECURITY: a directory replaces a same-named symlink left by a lower layer
# instead of being descended through. Without that, a layer shipping `usr →
# /etc` followed by one shipping `usr/passwd` would write outside the rootfs —
# the escape `_stor_has_symlink_ancestor` blocks on the extraction side.
# ── OCI whiteouts ──────────────
#
# A layer deletes a path from the layers below it by shipping a marker rather
# than the file: `.wh.<name>` removes `<name>`, and `.wh..wh..opq` in a
# directory hides EVERYTHING that directory inherited from below.
#
# Both were previously extracted LITERALLY, so a file deleted in an upper layer
# stayed visible in the container and the marker itself appeared alongside it.
# Inherited — `rust-old/src/storage.cyr` has no whiteout handling at all, and
# overlayfs understands only its own char-dev-0:0 convention, never the tar one,
# so the privileged path was equally wrong.
#
# WHY THIS LIVES AT MERGE TIME, not at unpack. The roadmap proposed fixing it in
# `_stor_extract_tar` "where it lands for both paths at once". It cannot: the
# file a marker deletes lives in a DIFFERENT layer, and unpack sees one layer's
# tar in isolation. The only unpack-time representation that works is overlayfs's
# char-dev-0:0 whiteout, and creating those needs CAP_MKNOD — which the
# unprivileged path, the one that always runs, does not have. So the markers stay
# in the layer directory as this layer's metadata, and the merge interprets them.
#
# WHY A PRE-PASS. `getdents64` order is filesystem-dependent, so a single
# streaming pass would apply `.wh.foo` before or after copying a sibling
# depending on the directory layout — and `.wh..wh..opq` must take effect before
# ANY of this layer entry lands. Whiteouts are therefore applied in full, for one
# directory, before that directory content is merged. Matches containerd.
#
# 1 when `name` is a whiteout marker of any kind.
#[must_use]
fn _stor_is_whiteout(name) {
    return memeq(name, ".wh.", 4);
}

# 1 when `name` is specifically the opaque-directory marker.
#[must_use]
fn _stor_is_opaque(name) {
    return streq(name, ".wh..wh..opq");
}

# Delete every entry in `dir` (used for an opaque directory). Returns 0.
fn _stor_clear_dir(dir, sb) {
    var fd = sys_open(dir, 196608, 0);          # O_DIRECTORY|O_NOFOLLOW
    if (fd < 0) { return 0; }
    var names = vec_new();
    var buf = alloc(4096);
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents64(fd, buf, 4096);
        if (n <= 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var nm = buf + pos + 19;
                var skip = 0;
                if (load8(nm) == 46) {
                    if (load8(nm + 1) == 0) { skip = 1; }
                    if (load8(nm + 1) == 46) { if (load8(nm + 2) == 0) { skip = 1; } }
                }
                # Collected first, deleted after: unlinking during the same
                # getdents64 walk that produced the names invalidates the
                # directory stream's position on some filesystems.
                if (skip == 0) { vec_push(names, _stor_dup(nm)); }
                pos = pos + load16(buf + pos + 16);
            }
        }
    }
    sys_close(fd);
    var i = 0;
    while (i < vec_len(names)) {
        _stor_replace_existing(_stor_join(dir, vec_get(names, i)), sb);
        i = i + 1;
    }
    return 0;
}

# Apply `src`'s whiteouts to `dst`, before any of `src`'s content is merged.
# Returns 0 always — a marker naming something that is not there is normal (the
# lower layers simply never created it).
fn _stor_apply_whiteouts(src, dst, sb) {
    var fd = sys_open(src, 196608, 0);          # O_DIRECTORY|O_NOFOLLOW
    if (fd < 0) { return 0; }
    var targets = vec_new();
    var opaque = 0;
    var buf = alloc(4096);
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents64(fd, buf, 4096);
        if (n <= 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var nm = buf + pos + 19;
                if (_stor_is_whiteout(nm) == 1) {
                    if (_stor_is_opaque(nm) == 1) { opaque = 1; }
                    else { vec_push(targets, _stor_dup(nm + 4)); }
                }
                pos = pos + load16(buf + pos + 16);
            }
        }
    }
    sys_close(fd);

    # Opaque first — it removes everything, making the individual markers in the
    # same directory no-ops rather than a second pass over a cleared tree.
    if (opaque == 1) { _stor_clear_dir(dst, sb); }
    var i = 0;
    while (i < vec_len(targets)) {
        var t = vec_get(targets, i);
        # A marker naming "." or ".." or carrying a '/' is not a filename — it is
        # an attempt to reach outside this directory. `.wh.` + `../../etc` would
        # otherwise delete host files.
        if (_stor_wh_name_is_safe(t) == 1) {
            _stor_replace_existing(_stor_join(dst, t), sb);
        }
        i = i + 1;
    }
    return 0;
}

# 1 when a whiteout target is a plain filename: non-empty, not "." or "..", and
# containing no '/'. The name comes from an untrusted image.
#[must_use]
fn _stor_wh_name_is_safe(name) {
    var n = strlen(name);
    if (n == 0) { return 0; }
    if (streq(name, ".") == 1) { return 0; }
    if (streq(name, "..") == 1) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(name + i) == 47) { return 0; }        # '/'
        i = i + 1;
    }
    return 1;
}

fn _stor_flatten_tree(src, dst, cpbuf, cplen) {
    # This layer's deletions take effect before any of its content lands.
    var wsb = alloc(144);
    _stor_apply_whiteouts(src, dst, wsb);
    var fd = sys_open(src, 65536, 0);      # O_DIRECTORY (dir-only open)
    if (fd < 0) { return 0 - 1; }
    var buf = alloc(4096);
    var sb = alloc(144);                    # struct stat
    var rc = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents64(fd, buf, 4096);
        if (n <= 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var reclen = load16(buf + pos + 16);
                var nm = buf + pos + 19;
                var skip = 0;
                if (load8(nm) == 46) {                      # '.'
                    if (load8(nm + 1) == 0) { skip = 1; }
                    if (load8(nm + 1) == 46) { if (load8(nm + 2) == 0) { skip = 1; } }
                }
                if (skip == 0) {
                    # Copy the name out of the dirent buffer before recursing.
                    var named = _stor_dup(nm);
                    # `.unpacked` is prepare_layers' own bookkeeping marker, not
                    # image content — it must not land in the container rootfs.
                    if (streq(named, ".unpacked") == 1) { skip = 1; }
                    # Whiteout markers are this layer's DELETION instructions,
                    # already applied by _stor_apply_whiteouts above. They are
                    # metadata, never content: copying them through is what put
                    # `.wh.foo` into the container next to the `foo` it was
                    # supposed to remove.
                    if (_stor_is_whiteout(named) == 1) { skip = 1; }
                    if (skip == 0) {
                        var s_child = _stor_join(src, named);
                        var d_child = _stor_join(dst, named);
                        if (sys_lstat(s_child, sb) == 0) {
                            var st = load64(sb + 24);
                            var perms = st & 4095;                        # & 0o7777
                            var uid = (st >> 32) & 4294967295;            # st_uid
                            var gid = load64(sb + 32) & 4294967295;       # st_gid
                            var typ = st & 61440;                         # S_IFMT
                            if (typ == 16384) {                           # S_IFDIR
                                # Merge into an existing dir; displace anything
                                # else — and VERIFY the displacement worked.
                                if (_stor_replace_existing_dirsafe(d_child, sb) != 0) {
                                    rc = 0 - 1;
                                    skip = 1;
                                }
                                if (skip == 0) {
                                    sys_mkdir(d_child, 493);
                                    # Confirm we are about to descend into a REAL
                                    # directory. Without this, a lower layer's
                                    # surviving symlink (say usr -> /etc) makes
                                    # the recursion below write through it, out
                                    # of the rootfs and onto the host.
                                    if (sys_lstat(d_child, sb) != 0) { rc = 0 - 1; skip = 1; }
                                    elif ((load64(sb + 24) & 61440) != 16384) { rc = 0 - 1; skip = 1; }
                                }
                                if (skip == 0) {
                                    _stor_lchown(d_child, uid, gid);
                                    # The directory's OWN mode is applied on the
                                    # way OUT, not here: a 0555 dir (every
                                    # /nix/store path, any `chmod 555` install
                                    # dir) would otherwise be read-only before
                                    # its children are written, failing the whole
                                    # create — but only when unprivileged, since
                                    # root has CAP_DAC_OVERRIDE. Same shape as
                                    # GNU tar's --delay-directory-restore.
                                    if (_stor_flatten_tree(s_child, d_child, cpbuf, cplen) != 0) {
                                        rc = 0 - 1;
                                    }
                                    if (perms != 0) { sys_chmod(d_child, perms); }
                                }
                            } else {
                                if (typ == 40960) {                       # S_IFLNK
                                    # PATH_MAX, not 1024: a truncated target is a
                                    # link to a DIFFERENT, attacker-chosen path,
                                    # and _stor_extract_tar already accepts GNU
                                    # long-link entries, so layers can carry them.
                                    var tgt = alloc(4097);
                                    var tn = sys_readlink(s_child, tgt, 4096);
                                    if (tn < 0 || tn >= 4096) {
                                        # <0 failed; ==4096 is indistinguishable
                                        # from truncation. Refuse either way.
                                        rc = 0 - 1;
                                    } else {
                                        store8(tgt + tn, 0);
                                        if (_stor_replace_existing(d_child, sb) != 0) { rc = 0 - 1; }
                                        elif (sys_symlink(tgt, d_child) != 0) { rc = 0 - 1; }
                                        else { _stor_lchown(d_child, uid, gid); }
                                    }
                                } else {
                                    if (typ == 32768) {                   # S_IFREG
                                        if (_stor_replace_existing(d_child, sb) != 0) {
                                            rc = 0 - 1;
                                        } else {
                                            var crc = _stor_copy_file_streamed(s_child, d_child, cpbuf, cplen);
                                            if (crc == 0 - 2) {
                                                # Source unreadable (mode 0000 is
                                                # legal image content). Under
                                                # overlayfs that file simply reads
                                                # as denied inside the container;
                                                # failing the create here would
                                                # make an unprivileged run reject
                                                # images a privileged one accepts.
                                                sakshi_warn("flatten: skipping unreadable source file",
                                                  strlen("flatten: skipping unreadable source file"));
                                            } elif (crc != 0) {
                                                rc = 0 - 1;
                                            } else {
                                                _stor_lchown(d_child, uid, gid);
                                                if (perms != 0) { sys_chmod(d_child, perms); }
                                            }
                                        }
                                    }
                                    # else: fifo/socket/device — skipped, as the
                                    # tar reader and writer both skip them.
                                }
                            }
                        }
                    }
                }
                pos = pos + reclen;
            }
        }
    }
    sys_close(fd);
    return rc;
}

# Flatten prepared `layer_dirs` (a vec of cstr dirs, bottom-to-top, as
# `prepare_layers` returns) into `dest` — the container rootfs used when
# `setup_overlay` could not mount. Creates `dest`, then merges each layer in
# order so the top layer wins.
#
# An EMPTY layer vec succeeds with an empty `dest`: an image with no layers
# genuinely has no filesystem, which is a different fact from a copy that
# failed. (`setup_overlay` returns 0 for the same input because overlayfs
# rejects a mount with no lowerdir, not because it is an error here.)
#
# Returns 0 on success, -1 on failure; the caller reports via
# stiva_err_print(STIVA_ERR_STORAGE, detail) — the same convention as
# parse_volume / setup_overlay / mount_volumes above.
fn flatten_layers(layer_dirs, dest) {
    var n = vec_len(layer_dirs);
    _stor_mkdir_p(dest);
    if (n == 0) { return 0; }
    sakshi_info("flattening layers into rootfs", strlen("flattening layers into rootfs"));
    var cpbuf = alloc(65536);
    var i = 0;
    while (i < n) {
        if (_stor_flatten_tree(vec_get(layer_dirs, i), dest, cpbuf, 65536) != 0) {
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0;
}

# ── USTAR tar WRITER + export ─────────────────────
# rust-old/src/runtime.rs export_rootfs (~line 783) drives tar::Builder::
# append_dir_all(".", rootfs) — a PLAIN (uncompressed) USTAR archive of the
# whole rootfs, no gzip. This is the one genuine codec gap in the port (the
# reader above extracts USTAR; nothing wrote it). The writer below produces
# headers the _stor_extract_tar reader reads back (round-trip verified) and
# that GNU `tar` accepts (checksum + magic exact).
#
# IN-MEMORY CAVEAT: the archive is assembled in a single heap buffer sized to
# the full uncompressed total (sum over files of 512 header + roundup512(size),
# plus the trailing 1024-byte zero terminator), then written in one shot. A
# rootfs larger than addressable RAM cannot be exported (roadmap: Known
# limitations) — rust-old streamed
# via tar::Builder; a streaming writer lands if that ever matters.

# Round a byte count up to the next multiple of 512.
#[must_use]
fn _tar_round512(n) {
    return ((n + 511) / 512) * 512;
}

# Write `val` as `width` zero-padded octal ASCII digits at `dst`, then a NUL
# terminator at dst+width (USTAR numeric fields: `width` octal digits + NUL,
# e.g. size = 11 digits + NUL @124, mode = 7 digits + NUL @100). The field
# occupies width+1 bytes total. Digits are emitted right-to-left.
fn _tar_octal(dst, val, width) {
    var i = width - 1;
    var v = val;
    while (i >= 0) {
        store8(dst + i, 48 + (v % 8));    # '0' + low octal digit
        v = v / 8;
        i = i - 1;
    }
    store8(dst + width, 0);               # trailing NUL
    return 0;
}

# Choose the USTAR name/prefix split point for `name` (a full path can span the
# `name` field (100b) + `prefix` field (155b), joined by '/'). Returns:
#   -2  → fits directly in the name field (len <= 100), no prefix
#   >=1 → the index of the separating '/' (prefix = name[0..p], part = name[p+1..])
#   -1  → does not fit USTAR (needs GNU longname — a v3.0.x+ item)
# Picks the largest valid '/' so the prefix carries as much as possible: the
# name part after it must be <=100 (and >=1) bytes and the prefix <=155.
#[must_use]
fn _tar_find_split(name) {
    var ln = strlen(name);
    if (ln <= 100) { return 0 - 2; }
    var hi = 155;
    if (hi > ln - 2) { hi = ln - 2; }     # name part >= 1 byte
    var lo = ln - 101;                     # name part <= 100 → p >= ln-101
    if (lo < 1) { lo = 1; }                # prefix >= 1 byte
    if (lo > hi) { return 0 - 1; }
    var p = hi;
    while (p >= lo) {
        if (load8(name + p) == 47) { return p; }   # '/'
        p = p - 1;
    }
    return 0 - 1;
}

# Write a USTAR numeric field of `fieldwidth` bytes at `dst`. Uses octal ASCII
# (`fieldwidth-1` digits + NUL) when the value fits; otherwise the GNU base-256
# escape (first byte 0x80, then the value big-endian in the remaining bytes) so
# size > ~8 GiB and uid/gid > ~2^21 no longer silently truncate. `_stor_parse_octal`
# decodes both forms.
fn _tar_numeric(dst, val, fieldwidth) {
    var digits = fieldwidth - 1;
    var limit = 1;
    var k = 0;
    while (k < digits) { limit = limit * 8; k = k + 1; }   # 8^digits
    if (val >= 0 && val < limit) {
        _tar_octal(dst, val, digits);
    } else {
        store8(dst, 128);                  # 0x80 base-256 marker
        var i = fieldwidth - 1;
        var v = val;
        while (i >= 1) {
            store8(dst + i, v & 255);
            v = v / 256;
            i = i - 1;
        }
    }
    return 0;
}

# Fill a 512-byte USTAR header block at `hdr` for entry `name` (cstr, < 100
# bytes) with real `mode`/`uid`/`gid`, `size` bytes of data, USTAR `typeflag`
# (48 '0' regular · 53 '5' directory · 50 '2' symlink), and — for a symlink —
# `linkname` (cstr, < 100 bytes, else 0). The block is assumed already zeroed.
# Field layout (offsets/lengths per USTAR/POSIX.1-1988):
#   name@0(100) mode@100(8) uid@108(8) gid@116(8) size@124(12) mtime@136(12)
#   chksum@148(8) typeflag@156(1) linkname@157(100) magic@257(6) version@263(2)
# Numeric fields are octal ASCII (digits + NUL). magic = "ustar\0", version "00".
# mtime = 0 (reproducible archives). Checksum: the 8 chksum bytes are set to
# ASCII spaces (0x20), ALL 512 header bytes are summed as unsigned, and the sum
# is written back as 6 zero-padded octal digits + NUL(0) + space(0x20) — the
# GNU-compatible form _stor_parse_octal also reads.
fn _tar_fill_header(hdr, name, mode, uid, gid, size, typeflag, linkname) {
    # name@0(100) + prefix@345(155), joined by '/' for paths up to 255 bytes
    # (validated to fit by _stor_write_tar / _tar_find_split before we get here).
    var sp = _tar_find_split(name);
    if (sp == 0 - 2) {
        memcpy(hdr, name, strlen(name));           # fits directly in name@0
    } else {
        if (sp == 0 - 1) {
            # too long for USTAR name+prefix — a preceding GNU 'L' entry carries
            # the real name; store a truncated copy here (readers use the 'L' name).
            var tn = strlen(name);
            if (tn > 100) { tn = 100; }
            memcpy(hdr, name, tn);
        } else {
            memcpy(hdr, name + sp + 1, strlen(name) - sp - 1);   # name part @0
            memcpy(hdr + 345, name, sp);                          # prefix @345
        }
    }

    _tar_octal(hdr + 100, mode, 7);       # mode @100 (perm bits, 7 octal + NUL)
    _tar_numeric(hdr + 108, uid, 8);      # uid @108 (octal, or base-256 if large)
    _tar_numeric(hdr + 116, gid, 8);      # gid @116
    _tar_numeric(hdr + 124, size, 12);    # size @124
    _tar_octal(hdr + 136, 0, 11);         # mtime 0 @136

    store8(hdr + 156, typeflag);          # typeflag @156
    if (linkname != 0) {                  # linkname @157 (symlink target, max 100)
        var llen = strlen(linkname);
        if (llen > 100) { llen = 100; }   # a preceding GNU 'K' entry carries the full target
        memcpy(hdr + 157, linkname, llen);
    }

    # magic "ustar\0" @257, version "00" @263.
    store8(hdr + 257, 117);  # 'u'
    store8(hdr + 258, 115);  # 's'
    store8(hdr + 259, 116);  # 't'
    store8(hdr + 260, 97);   # 'a'
    store8(hdr + 261, 114);  # 'r'
    store8(hdr + 262, 0);    # NUL
    store8(hdr + 263, 48);   # '0'
    store8(hdr + 264, 48);   # '0'

    # Checksum: fill chksum field with spaces, sum all 512 bytes.
    var k = 0;
    while (k < 8) { store8(hdr + 148 + k, 32); k = k + 1; }   # 8 spaces
    var sum = 0;
    var j = 0;
    while (j < 512) { sum = sum + load8(hdr + j); j = j + 1; }
    # Write: 6 octal digits + NUL(0) + space(0x20).
    _tar_octal(hdr + 148, sum, 6);        # 6 digits + NUL @148..154 (NUL @154)
    store8(hdr + 154, 0);                 # NUL after 6 digits
    store8(hdr + 155, 32);                # trailing space
    return 0;
}

# lchown(path, uid, gid) — set ownership WITHOUT following a trailing symlink.
# Best-effort: the caller ignores the return (chown needs CAP_CHOWN — a no-op
# when rootless).
#
# ⚠ WAS A LATENT aarch64 PROCESS-KILLER, fixed in 3.0.18. This read
# `syscall(94, path, uid, gid)`, and 94 is `lchown` on x86_64 but
# `__NR_exit_group` on aarch64 — so an aarch64 build TERMINATED SILENTLY on the
# first tar entry of any layer unpack, `import`, or `load`. Verified by
# execution at the time: `stiva load` printed nothing and exited 16 (the path
# pointer's low byte), with `exit_group` visible under qemu strace.
#
# ⚠ It sat behind a comment asserting it "cannot be fixed correctly here —
# the cyrius stdlib exposes neither a `sys_lchown` wrapper nor a
# `SYS_LCHOWN`/`SYS_FCHOWNAT` per-arch constant". That was FALSE, and false at
# the pin in force when it was written: `sys_fchownat` is at
# `lib/syscalls_x86_64_linux.cyr:393` and `lib/syscalls_aarch64_linux.cyr:611`,
# `SYS_FCHOWNAT` at `:116` / `:109`, `AT_FDCWD` and `AT_SYMLINK_NOFOLLOW` at
# `lib/syscalls_linux_common.cyr:38`/`:41` and `:61`/`:68` with per-platform
# values. The stdlib's own header (`syscalls_x86_64_linux.cyr:381`) documents
# this exact use: "with AT_FDCWD + AT_SYMLINK_NOFOLLOW it gives lchown
# semantics". Nobody re-checked after the claim was typed — the same failure
# mode that produced eight false "blocked" labels on the v3.1.0 roadmap. If you
# are about to write "cannot", grep for the symbol first.
#[inline]
fn _stor_lchown(path, uid, gid) {
    return sys_fchownat(AT_FDCWD, path, uid, gid, AT_SYMLINK_NOFOLLOW);
}

# A collected tar entry (writer side). `payload`: for a regular file the data
# buffer; for a symlink the link-target cstr; for a directory 0.
struct TarEntry {
    relpath;    # tar name (directories carry a trailing '/')
    typeflag;   # 48 '0' regular · 53 '5' dir · 50 '2' symlink
    mode;       # permission bits (st_mode & 0o7777)
    uid;
    gid;
    size;       # data length (0 for dir/symlink)
    payload;    # data cstr (regular) | link target cstr (symlink) | 0 (dir)
}

fn _tar_entry_new(relpath, typeflag, mode, uid, gid, size, payload) {
    var e = alloc(56);
    var ee: TarEntry = e;
    ee.relpath = relpath;
    ee.typeflag = typeflag;
    ee.mode = mode;
    ee.uid = uid;
    ee.gid = gid;
    ee.size = size;
    ee.payload = payload;
    return e;
}

# Recursively collect tar entries under `abs_dir`, naming each from `rel_prefix`
# ("" at the root). Uses a raw getdents64 walk + lstat so real mode/uid/gid,
# directory entries, and symlinks (stored as links, NOT dereferenced) are all
# captured. Linux struct stat: st_mode@24(u32) st_uid@28 st_gid@32 st_size@48;
# Linux dirent64: d_reclen@16 d_name@19. Returns 0 (a subtree that fails to open
# is skipped — best-effort, matching the reader).
fn _stor_tar_collect(abs_dir, rel_prefix, out) {
    var fd = sys_open(abs_dir, 65536, 0);   # O_DIRECTORY
    if (fd < 0) { return 0; }
    var buf = alloc(4096);
    var sb = alloc(144);                     # struct stat
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents64(fd, buf, 4096);
        if (n <= 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var reclen = load16(buf + pos + 16);
                var name = buf + pos + 19;
                var skip = 0;
                if (load8(name) == 46) {
                    if (load8(name + 1) == 0) { skip = 1; }
                    if (load8(name + 1) == 46) { if (load8(name + 2) == 0) { skip = 1; } }
                }
                if (skip == 0) {
                    var named = _stor_dup(name);
                    var abs_child = _stor_join(abs_dir, named);
                    var rel_child = named;
                    if (strlen(rel_prefix) > 0) {
                        rel_child = _stor_cat2(_stor_cat2(rel_prefix, "/"), named);
                    }
                    if (sys_lstat(abs_child, sb) == 0) {
                        var mode = load64(sb + 24) & 65535;               # st_mode (16-bit)
                        var perms = mode & 4095;                          # & 0o7777
                        var uid = (load64(sb + 24) >> 32) & 4294967295;   # st_uid
                        var gid = load64(sb + 32) & 4294967295;           # st_gid
                        var typ = mode & 61440;                           # S_IFMT
                        if (typ == 16384) {                               # S_IFDIR
                            vec_push(out, _tar_entry_new(_stor_cat2(rel_child, "/"), 53, perms, uid, gid, 0, 0));
                            _stor_tar_collect(abs_child, rel_child, out);
                        } else {
                            if (typ == 40960) {                           # S_IFLNK
                                var tgt = alloc(1024);
                                var tn = sys_readlink(abs_child, tgt, 1023);
                                if (tn < 0) { tn = 0; }
                                store8(tgt + tn, 0);
                                vec_push(out, _tar_entry_new(rel_child, 50, perms, uid, gid, 0, tgt));
                            } else {
                                if (typ == 32768) {                       # S_IFREG
                                    var len_cell = alloc(8);
                                    var data = _stor_read_file(abs_child, len_cell);
                                    if (data != 0) {
                                        var fsz = load64(len_cell);
                                        vec_push(out, _tar_entry_new(rel_child, 48, perms, uid, gid, fsz, data));
                                    }
                                }
                                # else: fifo/socket/device — skipped (as the reader does).
                            }
                        }
                    }
                }
                pos = pos + reclen;
            }
        }
    }
    sys_close(fd);
    return 0;
}

# Write a GNU long-name ('L'=76) / long-link ('K'=75) pseudo-entry at `buf`: a
# header named "././@LongLink" whose data is the full string + NUL (block-padded).
# The reader consumes it as the name/linkname of the NEXT entry, lifting the USTAR
# 255-byte name / 100-byte linkname limits. Returns the bytes written.
fn _tar_write_long(buf, typeflag, s) {
    var slen = strlen(s);
    _tar_fill_header(buf, "././@LongLink", 0, 0, 0, slen + 1, typeflag, 0);
    memcpy(buf + 512, s, slen);
    store8(buf + 512 + slen, 0);
    return 512 + _tar_round512(slen + 1);
}

# Assemble a USTAR tar from a vec of TarEntry* into ONE heap buffer. Pass 1
# tallies the archive size (including any GNU long-name/long-link pseudo-entries);
# pass 2 fills the buffer (see the IN-MEMORY CAVEAT). Returns the buffer and
# stores its byte length in `out_len`.
#
# The two trailing all-zero blocks are never written explicitly — `alloc` hands
# back zeroed memory and pass 2 stops short of them. Do not "optimise" that into
# an uninitialised allocator without memset'ing the tail: a tar whose end-of-
# archive marker is garbage is silently truncated by every reader.
#
# Split out of `_stor_write_tar` so a builder can gzip the bytes directly
# (§F `build`) instead of round-tripping through a temp file.
fn _stor_tar_bytes(entries, out_len) {
    var nf = vec_len(entries);
    var total = 0;
    var i = 0;
    while (i < nf) {
        var e: TarEntry = vec_get(entries, i);
        # A name > 255b / unsplittable gets a preceding GNU long-name ('L') entry;
        # a symlink target >= 100b gets a long-link ('K') entry (no length limit).
        if (_tar_find_split(e.relpath) == 0 - 1) {
            total = total + 512 + _tar_round512(strlen(e.relpath) + 1);
        }
        if (e.typeflag == 50) {
            if (strlen(e.payload) >= 100) {
                total = total + 512 + _tar_round512(strlen(e.payload) + 1);
            }
        }
        total = total + 512 + _tar_round512(e.size);
        i = i + 1;
    }
    total = total + 1024;                 # two trailing all-zero blocks

    # Refuse rather than write through a failed allocation. `alloc` returns 0
    # when it cannot satisfy the request, and pass 2 below writes unconditionally
    # — so a context large enough to exhaust the arena was a NULL-deref SIGSEGV
    # rather than an error the caller could report. The ceiling is generous
    # (16 GiB) because this is a backstop, not a policy: the per-layer limit that
    # actually bounds a build lives in build.cyr.
    if (total > 17179869184) {
        stiva_err_print(STIVA_ERR_STORAGE, "tar: archive exceeds the 16 GiB assembly ceiling");
        store64(out_len, 0);
        return 0;
    }
    var buf = alloc(total);
    if (buf == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "tar: cannot allocate the archive buffer");
        store64(out_len, 0);
        return 0;
    }
    var pos = 0;
    var k = 0;
    while (k < nf) {
        var e: TarEntry = vec_get(entries, k);
        if (_tar_find_split(e.relpath) == 0 - 1) {
            pos = pos + _tar_write_long(buf + pos, 76, e.relpath);   # 'L' long-name
        }
        var link = 0;
        if (e.typeflag == 50) {
            link = e.payload;
            if (strlen(link) >= 100) {
                pos = pos + _tar_write_long(buf + pos, 75, link);    # 'K' long-link
            }
        }
        _tar_fill_header(buf + pos, e.relpath, e.mode, e.uid, e.gid, e.size, e.typeflag, link);
        pos = pos + 512;
        if (e.size > 0) {
            memcpy(buf + pos, e.payload, e.size);
            pos = pos + _tar_round512(e.size);
        }
        k = k + 1;
    }

    store64(out_len, total);
    return buf;
}

# Assemble + write a USTAR tar from a vec of TarEntry* to `out_path`. Returns 1
# on success, 0 on failure with stiva_err_print(STIVA_ERR_STORAGE, detail).
# Shared by create_tar (the rootfs walk) and the oci-archive save path (a
# hand-built entry list).
fn _stor_write_tar(entries, out_path) {
    var len_cell = alloc(8);
    var buf = _stor_tar_bytes(entries, len_cell);
    if (buf == 0) { return 0; }           # detail printed by _stor_tar_bytes
    var wrote = file_write_all(out_path, buf, load64(len_cell));
    if (wrote < 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "tar: cannot write output archive");
        return 0;
    }
    return 1;
}

# Build a plain (uncompressed) USTAR tar of everything under `src_dir` (cstr),
# writing it to `out_path` (cstr). PERMS-PRESERVING: real mode/uid/gid, plus
# directory ('5') and symlink ('2', stored as the link, not dereferenced)
# entries — via the getdents64 + lstat walk (`_stor_tar_collect`). Entry names
# are each path RELATIVE to src_dir. Returns 1 on success, 0 on failure (a name
# or symlink target that overflows the 100-byte USTAR field) with
# stiva_err_print(STIVA_ERR_STORAGE, detail).
#
# See the IN-MEMORY CAVEAT above: the whole archive is held in one heap buffer.
fn create_tar(src_dir, out_path) {
    var entries = vec_new();
    _stor_tar_collect(src_dir, "", entries);
    return _stor_write_tar(entries, out_path);
}

# Export a container rootfs as a plain USTAR tarball (rust-old runtime.rs
# export_rootfs, ~line 783). Thin wrapper over create_tar. `rootfs` and
# `output` are cstrs. Returns 1 on success, 0 on failure (create_tar has
# already reported via stiva_err_print).
fn export_rootfs(rootfs, output) {
    sakshi_info("exporting rootfs to tar", strlen("exporting rootfs to tar"));
    return create_tar(rootfs, output);
}

# ── DEFERRED ─────────────────────────
# Every rust-old/src/storage.rs entry point is ported. `unpack_tar_zstd`
# (rust-old: zstd::stream::Decoder + tar::Archive) landed as
# `_stor_unpack_zstd_bytes` once sankoch 2.5.0 shipped zstd decode; the
# unpack_tar_gz / unpack_layer / prepare_layers / create_tar / export_rootfs
# surface was already implemented above.
#
# Remaining (a deliberate choice, NOT a codec gap): stiva still WRITES gzip
# layers. `zstd_compress` is available in sankoch, so emitting
# `application/vnd.oci.image.layer.v1.tar+zstd` is a build-side decision to
# make when there is a reason to, not a blocked item.

# --- imagelayout.cyr ---

# imagelayout.cyr — OCI image-layout: config/manifest assembly, `oci-layout`
# marker, `index.json` store, and (v3.0.2) oci-archive save/load.
#
# NET-NEW work: the frozen rust-old oracle had NO OCI image-layout — it (like
# the pre-A2 Cyrius port) kept an ad-hoc `images.json`. So the OCI **image-spec**
# is the parity oracle here, not rust-old. Docker/Podman/skopeo interop is the
# goal: the store root becomes a valid OCI image layout
#   {root}/oci-layout   {root}/index.json   {root}/blobs/sha256/<hex>
#
# Depends on: image.cyr (blob store + sha256_digest/digest_hex + Image/Layer/
# ImageRef), registry.cyr (Descriptor/OciManifest/OciIndex + media_* + serde),
# and — for save/load only (v3.0.2) — storage.cyr (tar). Included AFTER those.

# ── image-spec constants ──

# imageLayoutVersion written to the `oci-layout` marker at the store root.
#[must_use]
fn oci_image_layout_version() {
    return "1.0.0";
}

# ── OCI image config assembly (A1) ────────────────────────

# vec<cstr> → JTAG_ARR of strings, or 0 when the vec is empty/absent (so the
# caller omits the field — serde skip_serializing_if = Vec::is_empty parity).
#[must_use]
fn _il_str_arr(v) {
    if (v == 0) { return 0; }
    var n = vec_len(v);
    if (n == 0) { return 0; }
    var arr = json_v_arr_new();
    var i = 0;
    while (i < n) {
        json_v_arr_push(arr, json_v_str_new(str_from(vec_get(v, i))));
        i = i + 1;
    }
    return arr;
}

# Alternating [k,v,k,v,...] vec<cstr> → JTAG_OBJ, or 0 when empty. Insertion
# order is preserved (deterministic bytes). A dangling final key is ignored.
#[must_use]
fn _il_kv_obj(v) {
    if (v == 0) { return 0; }
    var n = vec_len(v);
    if (n < 2) { return 0; }
    var o = json_v_obj_new();
    var i = 0;
    while (i + 1 < n) {
        json_v_obj_set(o, str_from(vec_get(v, i)), json_v_str_new(str_from(vec_get(v, i + 1))));
        i = i + 2;
    }
    return o;
}

# vec<cstr> port keys ("8080/tcp") → {"8080/tcp":{}} JTAG_OBJ, or 0 when empty.
#[must_use]
fn _il_ports_obj(v) {
    if (v == 0) { return 0; }
    var n = vec_len(v);
    if (n == 0) { return 0; }
    var o = json_v_obj_new();
    var i = 0;
    while (i < n) {
        json_v_obj_set(o, str_from(vec_get(v, i)), json_v_obj_new());
        i = i + 1;
    }
    return o;
}

# Build the `config` sub-object of an OCI image config. Every field is optional
# and omitted when empty (serde skip_serializing_if parity). Canonical field
# order mirrors the OCI image-spec struct: User, ExposedPorts, Env, Entrypoint,
# Cmd, WorkingDir, Labels. Returns a fresh (possibly empty {}) JTAG_OBJ.
#   env/cmd/entrypoint : vec<cstr> or 0    exposed_ports : vec<cstr "port/proto"> or 0
#   workdir/user       : cstr or 0         labels        : alternating [k,v] vec<cstr> or 0
#[must_use]
fn oci_config_object_jv(env, cmd, entrypoint, workdir, user, exposed_ports, labels) {
    var o = json_v_obj_new();
    if (user != 0) {
        json_v_obj_set(o, str_from("User"), json_v_str_new(str_from(user)));
    }
    var ports = _il_ports_obj(exposed_ports);
    if (ports != 0) { json_v_obj_set(o, str_from("ExposedPorts"), ports); }
    var ea = _il_str_arr(env);
    if (ea != 0) { json_v_obj_set(o, str_from("Env"), ea); }
    var epa = _il_str_arr(entrypoint);
    if (epa != 0) { json_v_obj_set(o, str_from("Entrypoint"), epa); }
    var ca = _il_str_arr(cmd);
    if (ca != 0) { json_v_obj_set(o, str_from("Cmd"), ca); }
    if (workdir != 0) {
        json_v_obj_set(o, str_from("WorkingDir"), json_v_str_new(str_from(workdir)));
    }
    var lo = _il_kv_obj(labels);
    if (lo != 0) { json_v_obj_set(o, str_from("Labels"), lo); }
    return o;
}

# Build a full OCI image config value (application/vnd.oci.image.config.v1+json).
#   architecture / os : required cstrs
#   created_str       : RFC3339 cstr, or 0 to omit "created" (0 → reproducible)
#   cfg_obj           : a config sub-object jv (0 → emit empty {})
#   diff_ids          : vec<cstr> of UNCOMPRESSED layer digests (rootfs.diff_ids)
#   history           : vec<jv> history entries, or 0 to omit
# Canonical key order: created, architecture, os, config, rootfs, history — the
# bytes (and the config-blob digest over them) are deterministic.
#[must_use]
fn oci_config_build(architecture, os, created_str, cfg_obj, diff_ids, history) {
    var o = json_v_obj_new();
    if (created_str != 0) {
        json_v_obj_set(o, str_from("created"), json_v_str_new(str_from(created_str)));
    }
    json_v_obj_set(o, str_from("architecture"), json_v_str_new(str_from(architecture)));
    json_v_obj_set(o, str_from("os"), json_v_str_new(str_from(os)));
    var co = cfg_obj;
    if (co == 0) { co = json_v_obj_new(); }
    json_v_obj_set(o, str_from("config"), co);

    var rootfs = json_v_obj_new();
    json_v_obj_set(rootfs, str_from("type"), json_v_str_new(str_from("layers")));
    var diffs = json_v_arr_new();
    if (diff_ids != 0) {
        var n = vec_len(diff_ids);
        var i = 0;
        while (i < n) {
            json_v_arr_push(diffs, json_v_str_new(str_from(vec_get(diff_ids, i))));
            i = i + 1;
        }
    }
    json_v_obj_set(rootfs, str_from("diff_ids"), diffs);
    json_v_obj_set(o, str_from("rootfs"), rootfs);

    if (history != 0) {
        var hn = vec_len(history);
        if (hn > 0) {
            var harr = json_v_arr_new();
            var j = 0;
            while (j < hn) {
                json_v_arr_push(harr, vec_get(history, j));
                j = j + 1;
            }
            json_v_obj_set(o, str_from("history"), harr);
        }
    }
    return o;
}

# Compact JSON bytes (Str) for a config value — the exact bytes stored as the
# config blob and content-addressed. Compact (json_v_build) matches the
# registry convention and keeps the digest byte-stable.
#[must_use]
fn oci_config_json(cfg_v) {
    return json_v_build(cfg_v);
}

# Read an image's `rootfs.diff_ids` back out of its stored config blob, as a
# vec<cstr> of UNCOMPRESSED layer digests. Empty vec when the blob is missing,
# unparseable, or carries no diff_ids.
#
# Every other diff_ids site in this tree WRITES them; this is the only reader.
# It exists because a derived image's config must carry
# `base.diff_ids ++ new.diff_ids` — and the base's are recoverable only from its
# config blob, since the `Image` record holds compressed layer digests and the
# uncompressed ones appear nowhere else on disk.
#
# An empty result is NOT distinguishable from "the base genuinely has no
# layers", which is why the caller (§F build) refuses to build on a base whose
# config it could not read rather than silently emitting a config whose
# diff_ids omit every inherited layer — an image that unpacks to a rootfs the
# manifest says should have more in it.
fn _il_config_diff_ids(store, image) {
    var out = vec_new();
    if (store == 0 || image == 0) { return out; }
    var cfg_path = _img_blob_path(image_store_root(store), _img_id(image));
    if (cfg_path == 0) { return out; }
    if (file_exists(cfg_path) == 0) { return out; }
    var cc = alloc(8);
    var cbuf = _img_read_file(cfg_path, cc);
    if (cbuf == 0) { return out; }
    var cv = bayan_json_v_parse_buf(cbuf, load64(cc));
    if (cv == 0) { return out; }
    var rootfs = json_v_obj_get(cv, "rootfs");
    if (rootfs == 0) { return out; }
    var arr = json_v_obj_get(rootfs, "diff_ids");
    if (arr == 0) { return out; }
    if (json_v_is_arr(arr) == 0) { return out; }
    var n = json_v_arr_len(arr);
    var i = 0;
    while (i < n) {
        var e = json_v_arr_get(arr, i);
        if (json_v_is_str(e) == 1) { vec_push(out, str_cstr(json_v_str(e))); }
        i = i + 1;
    }
    return out;
}

# ── oci-layout marker + index.json store (A2) ──
#
# The store root becomes a valid OCI image layout: an `oci-layout` marker, a
# top-level `index.json` (a descriptor list — one per image, annotated with its
# ref.name), and the shared `blobs/sha256/<hex>` store (config/manifest/layer
# blobs). The legacy ad-hoc `images.json` is RETIRED — index.json + the manifest
# and config blobs are the single source of truth, reconstructed into Image
# records on load. This replaces the pre-A2 store layer that lived in image.cyr.

# The org.opencontainers.image.ref.name annotation key (image ref → descriptor).
#[must_use]
fn _il_ref_name_key() {
    return "org.opencontainers.image.ref.name";
}

# {root}/oci-layout and {root}/index.json paths.
#[must_use]
fn _il_layout_path(root) {
    return _img_cat2(root, "/oci-layout");
}

#[must_use]
fn _il_index_path(root) {
    return _img_cat2(root, "/index.json");
}

# Atomic write via a temp file + rename (mirrors the blob-store idiom).
fn _il_atomic_write(path, data, len) {
    var tmp = _img_cat2(path, ".tmp");
    if (file_write_all(tmp, data, len) < 0) { return 0; }
    if (sys_rename(tmp, path) < 0) { return 0; }
    return 1;
}

# Read a JTAG_STR field `key` (cstr) from obj `v` as a fresh cstr, or 0 if the
# field is absent/null/non-string.
#[must_use]
fn _il_jv_str_field(v, key) {
    var f = json_v_obj_get(v, key);
    if (json_v_is_str(f) == 0) { return 0; }
    return str_cstr(json_v_str(f));
}

# Write {root}/oci-layout = {"imageLayoutVersion":"1.0.0"} if absent. 1/0.
fn image_store_write_oci_layout(store) {
    var path = _il_layout_path(image_store_root(store));
    if (file_exists(path) == 1) { return 1; }
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("imageLayoutVersion"), json_v_str_new(str_from(oci_image_layout_version())));
    var s = json_v_build(o);
    return _il_atomic_write(path, str_data(s), str_len(s));
}

# Parse index.json into its root jv object, or 0 (absent/empty/unparsable). Uses
# the explicit 2-arg parse entry point (the 1-arg wrapper mis-lowers).
#[must_use]
fn _il_index_read_jv(store) {
    var path = _il_index_path(image_store_root(store));
    if (file_exists(path) == 0) { return 0; }
    # Whole-file read (no fixed cap) so a large index is never truncated into a
    # parse failure (which the add guard would then treat as corruption).
    var len_cell = alloc(8);
    var buf = _img_read_file(path, len_cell);
    var n = load64(len_cell);
    if (buf == 0) { return 0; }
    if (n <= 0) { return 0; }
    return bayan_json_v_parse_buf(buf, n);
}

# The `manifests` array jv from a parsed index root, or 0.
#[must_use]
fn _il_index_manifests(idx) {
    if (idx == 0) { return 0; }
    var m = json_v_obj_get(idx, "manifests");
    if (json_v_is_arr(m) == 0) { return 0; }
    return m;
}

# The ref.name annotation of an index descriptor jv, or 0.
#[must_use]
fn _il_desc_ref_name(desc) {
    var ann = json_v_obj_get(desc, "annotations");
    if (json_v_is_obj(ann) == 0) { return 0; }
    return _il_jv_str_field(ann, _il_ref_name_key());
}

# Reconstruct an ImageRef from a full_ref string "registry/repository:tag" — the
# exact inverse of image_ref_full_ref (split the last ':' for the tag, the first
# '/' of the remainder for the registry). Avoids image_ref_parse's Docker-hub
# heuristics, which would not round-trip a "local/..." reference. Digest is None.
#[must_use]
fn _il_parse_full_ref(s) {
    var len = strlen(s);
    var last_slash = _img_rfind(s, 47);
    var lc = _img_rfind(s, 58);          # ':'
    var tag = "latest";
    var rest = s;
    # A ':' is a tag separator only if it comes AFTER the last '/', otherwise it
    # is a registry port (e.g. "localhost:5000/repo" with no tag). This mirrors
    # image_ref_parse and keeps externally-produced ref.names round-tripping.
    if (lc >= 0 && lc > last_slash) {
        tag = _img_slice(s, lc + 1, len);
        rest = _img_slice(s, 0, lc);
    }
    var rlen = strlen(rest);
    var fs = _img_find(rest, 47);         # '/' → registry boundary
    if (fs < 0) {
        return image_ref_new("", rest, tag, 0);
    }
    var registry = _img_slice(rest, 0, fs);
    var repository = _img_slice(rest, fs + 1, rlen);
    return image_ref_new(registry, repository, tag, 0);
}

# Build one index.json manifest descriptor for `image`:
#   { mediaType, digest(manifest), size(manifest bytes), platform{arch,os},
#     annotations{ ref.name: full_ref } }. Single-node store → current_platform.
#[must_use]
fn _il_manifest_descriptor_jv(store, image, manifest_size) {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("mediaType"), json_v_str_new(str_from(media_oci_manifest())));
    json_v_obj_set(o, str_from("digest"), json_v_str_new(str_from(_img_manifest_digest(image))));
    json_v_obj_set(o, str_from("size"), json_v_int_new(manifest_size));
    # Platform: prefer the image's real config architecture/os (so a foreign-arch
    # image loaded from a docker/oci archive keeps its platform), else the host.
    var arch = 0;
    var os = 0;
    var cfg_path = _img_blob_path(image_store_root(store), _img_id(image));
    if (cfg_path != 0 && file_exists(cfg_path) == 1) {
        var cc = alloc(8);
        var cbuf = _img_read_file(cfg_path, cc);
        if (cbuf != 0) {
            var cv = bayan_json_v_parse_buf(cbuf, load64(cc));
            if (cv != 0) {
                arch = _il_jv_str_field(cv, "architecture");
                os = _il_jv_str_field(cv, "os");
            }
        }
    }
    if (arch == 0 || os == 0) {
        # Host platform (current_platform's hardcoded amd64/linux) via literals —
        # avoids a Platform struct-field read that cycc miscompiles in this fn.
        arch = normalize_arch("x86_64");
        os = "linux";
    }
    var po = json_v_obj_new();
    json_v_obj_set(po, str_from("architecture"), json_v_str_new(str_from(arch)));
    json_v_obj_set(po, str_from("os"), json_v_str_new(str_from(os)));
    json_v_obj_set(o, str_from("platform"), po);
    var ann = json_v_obj_new();
    var rn = image_ref_full_ref(_image_reference(image));
    json_v_obj_set(ann, str_from(_il_ref_name_key()), json_v_str_new(str_from(rn)));
    json_v_obj_set(o, str_from("annotations"), ann);
    return o;
}

# Read + parse an image's manifest blob into an OciManifest*, or 0.
#[must_use]
fn _il_read_manifest(store, digest) {
    var path = _img_blob_path(image_store_root(store), digest);
    if (path == 0) { return 0; }
    if (file_exists(path) == 0) { return 0; }
    var len_cell = alloc(8);
    var buf = _img_read_file(path, len_cell);
    var n = load64(len_cell);
    if (buf == 0) { return 0; }
    if (n <= 0) { return 0; }
    var jv = bayan_json_v_parse_buf(buf, n);
    if (jv == 0) { return 0; }
    return oci_manifest_from_jv(jv);
}

# Load the image index (replaces the images.json load). Reads index.json, then
# for each descriptor reads its manifest blob and rebuilds an Image: id = the
# config-descriptor digest, layers from the manifest layer descriptors, size =
# sum of layer sizes, reference from the ref.name annotation, created_at = 0
# (import omits "created"), manifest_digest from the descriptor. Missing/empty
# index → empty vec. A descriptor whose manifest blob is missing is skipped.
#[must_use]
fn image_store_load_index(store) {
    var out = vec_new();
    var manifests = _il_index_manifests(_il_index_read_jv(store));
    if (manifests == 0) { return out; }
    var n = json_v_arr_len(manifests);
    var i = 0;
    while (i < n) {
        var desc = json_v_arr_get(manifests, i);
        var mdigest = _il_jv_str_field(desc, "digest");
        if (mdigest != 0) {
            var man = _il_read_manifest(store, mdigest);
            if (man != 0) {
                var mm: OciManifest = man;
                var cfg: Descriptor = mm.config;
                var layers = vec_new();
                var total = 0;
                var mlayers = mm.layers;
                var ln = vec_len(mlayers);
                var lj = 0;
                while (lj < ln) {
                    var ld: Descriptor = vec_get(mlayers, lj);
                    vec_push(layers, layer_new(ld.digest, ld.size, ld.media_type));
                    total = total + ld.size;
                    lj = lj + 1;
                }
                var refname = _il_desc_ref_name(desc);
                var reference = 0;
                if (refname != 0) { reference = _il_parse_full_ref(refname); }
                if (reference == 0) { reference = image_ref_new("local", cfg.digest, "latest", 0); }
                var img = image_new(cfg.digest, reference, total, layers, 0);
                _img_set_manifest_digest(img, mdigest);
                vec_push(out, img);
            }
        }
        i = i + 1;
    }
    return out;
}

# Rewrite index.json from a vec of Image* (each must have manifest_digest set +
# its manifest blob present). Emits {schemaVersion, mediaType, manifests[]}. 1/0.
fn _il_index_rewrite(store, images) {
    var manifests = json_v_arr_new();
    var n = vec_len(images);
    var i = 0;
    while (i < n) {
        var im = vec_get(images, i);
        var ii: Image = im;
        var msize = image_store_blob_size(store, _img_manifest_digest(ii));
        if (msize < 0) { msize = 0; }
        json_v_arr_push(manifests, _il_manifest_descriptor_jv(store, im, msize));
        i = i + 1;
    }
    var root = json_v_obj_new();
    json_v_obj_set(root, str_from("schemaVersion"), json_v_int_new(2));
    json_v_obj_set(root, str_from("mediaType"), json_v_str_new(str_from(media_oci_index())));
    json_v_obj_set(root, str_from("manifests"), manifests);
    var s = json_v_build_pretty(root, 2);
    return _il_atomic_write(_il_index_path(image_store_root(store)), str_data(s), str_len(s));
}

# Add or replace an image in index.json (replaces any entry with the same
# full_ref), ensuring the oci-layout marker exists. Precondition: the image's
# manifest/config/layer blobs are already stored and manifest_digest is set
# (import and tag guarantee this). Returns 1/0.
fn image_store_add_to_index(store, image) {
    # Refuse to clobber a present-but-unparseable index — otherwise the load →
    # dedup → rewrite below would drop every other image (their blobs orphaned).
    # An absent index is fine (this add creates it). `remove` is already safe
    # (an empty load makes it report not-found without rewriting).
    var ipath = _il_index_path(image_store_root(store));
    if (file_exists(ipath) == 1) {
        if (_il_index_read_jv(store) == 0) {
            stiva_err_print(STIVA_ERR_IO, "index.json is present but unreadable; refusing to overwrite it");
            return 0;
        }
    }
    image_store_write_oci_layout(store);
    var new_ref = image_ref_full_ref(_image_reference(image));
    var new_md = _img_manifest_digest(image);
    # Is the incoming reference pinned to a digest? image_ref_full_ref drops the
    # digest field, so two digest-pinned pulls of the same repository both
    # render as "repo:latest" and, keyed on that alone, the second would silently
    # evict the first — different content under one key, with the first image's
    # blobs orphaned until gc.
    # ImageRef.digest by RAW OFFSET (@24). An ImageRef obtained from a wrapper
    # function, stored in a typed local and then field-read, is the exact form
    # CLAUDE.md's 2026-07-24 note records reading back as garbage under the live
    # cycc struct-id miscompile — and this file already avoids a Platform field
    # read for the same reason. Consistent with _img_manifest_digest above.
    var new_pinned = 0;
    if (load64(_image_reference(image) + 24) != 0) { new_pinned = 1; }

    var images = image_store_load_index(store);
    var kept = vec_new();
    var n = vec_len(images);
    var i = 0;
    while (i < n) {
        var ex = vec_get(images, i);
        var drop = 0;
        # Same content under the same name: an idempotent re-add, replace it.
        if (streq(image_ref_full_ref(_image_reference(ex)), new_ref) == 1) {
            if (new_pinned == 0) {
                drop = 1;              # a tag is a mutable pointer — it moved
            } else {
                var ex_md = _img_manifest_digest(ex);
                if (ex_md != 0 && new_md != 0) {
                    # Pinned add: replace only the SAME manifest, so a second
                    # distinct digest coexists rather than evicting the first.
                    if (streq(ex_md, new_md) == 1) { drop = 1; }
                } else {
                    drop = 1;
                }
            }
        }
        if (drop == 0) { vec_push(kept, ex); }
        i = i + 1;
    }
    vec_push(kept, image);
    return _il_index_rewrite(store, kept);
}

# List locally stored images (rust-old: list). Returns a vec of Image*.
#[must_use]
fn image_store_list(store) {
    return image_store_load_index(store);
}

# Sweep unreferenced blobs: for each hex in blobs/sha256, form "sha256:{hex}"
# and unlink when it is not in `referenced`. Returns the count removed.
fn _il_sweep_blobs(root, referenced) {
    var removed = 0;
    var blobs_dir = _img_cat2(root, "/blobs/sha256");
    var entries = dir_list(str_from(blobs_dir));
    var ne = vec_len(entries);
    var ei = 0;
    while (ei < ne) {
        var hex = str_cstr(vec_get(entries, ei));
        var digest = _img_cat2("sha256:", hex);
        var found = 0;
        var ri = 0;
        while (ri < vec_len(referenced)) {
            if (streq(vec_get(referenced, ri), digest) == 1) { found = 1; }
            ri = ri + 1;
        }
        if (found == 0) {
            var blob_path = _img_cat2(_img_cat2(blobs_dir, "/"), hex);
            xunlink(blob_path);
            removed = removed + 1;
        }
        ei = ei + 1;
    }
    return removed;
}

# Collect the referenced-digest set of a vec of Image*: each image's config id,
# its manifest digest, and every layer digest — the GC roots.
#[must_use]
fn _il_referenced_digests(images) {
    var referenced = vec_new();
    var ii = 0;
    while (ii < vec_len(images)) {
        var im: Image = vec_get(images, ii);
        vec_push(referenced, im.id);
        var imd = _img_manifest_digest(im);
        if (imd != 0) { vec_push(referenced, imd); }
        var layers = im.layers;
        var lj = 0;
        while (lj < vec_len(layers)) {
            var ll: Layer = vec_get(layers, lj);
            vec_push(referenced, ll.digest);
            lj = lj + 1;
        }
        ii = ii + 1;
    }
    return referenced;
}

# Remove an image by id (config digest), drop now-unreferenced blobs, and
# rewrite index.json. Returns 1 on success, -1 when no image has `id`, 0 on a
# rewrite failure. Shared blobs (config/manifest/layers) survive.
fn image_store_remove(store, id) {
    var root = image_store_root(store);
    var images = image_store_load_index(store);
    var before = vec_len(images);
    var kept = vec_new();
    var i = 0;
    while (i < before) {
        var im = vec_get(images, i);
        var ii: Image = im;
        if (streq(ii.id, id) == 0) { vec_push(kept, im); }
        i = i + 1;
    }
    if (vec_len(kept) == before) { return 0 - 1; }
    _il_sweep_blobs(root, _il_referenced_digests(kept));
    if (_il_index_rewrite(store, kept) == 0) { return 0; }
    return 1;
}

# Garbage-collect unreferenced blobs (rust-old: gc). Referenced set = every
# indexed image's config id + manifest digest + layer digests. Returns the count
# of blobs removed. index.json is unchanged (only orphan blobs are dropped).
fn image_store_gc(store) {
    var images = image_store_load_index(store);
    return _il_sweep_blobs(image_store_root(store), _il_referenced_digests(images));
}

# Import a rootfs tar as a single-layer OCI image (rust-old: import_rootfs +
# lib.rs import), producing a full OCI image layout: a gzip layer blob, an OCI
# image config blob (rootfs.diff_ids = the UNCOMPRESSED tar digest, per spec), an
# OCI manifest blob, the oci-layout marker, and an index.json entry under
# reference `local/<name>:<tag>`. Returns the Image*, or 0 on failure (detail to
# stderr). Synchronous — gzip via sankoch, sha256 via sigil. 64 MiB tar cap.
fn image_import(store, tar_path, name, tag) {
    # Whole-file read (SEEK_END-sized) — a rootfs tar can exceed any fixed cap
    # (base images run well past 64 MiB), and a truncated read would produce a
    # self-consistent but silently-incomplete image.
    var tlen_cell = alloc(8);
    var tarbuf = _img_read_file(tar_path, tlen_cell);
    var tarlen = load64(tlen_cell);
    if (tarbuf == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, _img_cat2("failed to read import tar: ", tar_path));
        return 0;
    }

    # rootfs.diff_ids uses the UNCOMPRESSED tar digest (OCI spec); the layer blob
    # is content-addressed over the COMPRESSED bytes.
    var diff_id = sha256_digest(tarbuf, tarlen);

    var gzcap = tarlen + tarlen / 50 + 8192;
    var gzbuf = alloc(gzcap);
    # Streaming encoder, NOT the batch `gzip_compress` — the latter corrupts any
    # input past 1 MiB (see `_stor_gzip_compress` in storage.cyr), which is every
    # real rootfs tar.
    var gzlen = _stor_gzip_compress(tarbuf, tarlen, gzbuf, gzcap);
    if (gzlen < 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "failed to gzip import tar");
        return 0;
    }
    var layer_digest = sha256_digest(gzbuf, gzlen);
    if (image_store_store_blob(store, layer_digest, gzbuf, gzlen) == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "failed to store layer blob");
        return 0;
    }
    var layer = layer_new(layer_digest, gzlen, media_oci_layer());

    # OCI image config blob.
    var pp: Platform = current_platform();
    var diff_ids = vec_new();
    vec_push(diff_ids, diff_id);
    var cfg_v = oci_config_build(pp.architecture, pp.os, 0, oci_config_object_jv(0, 0, 0, 0, 0, 0, 0), diff_ids, 0);
    var cfg_s = json_v_build(cfg_v);
    var config_digest = sha256_digest(str_data(cfg_s), str_len(cfg_s));
    if (image_store_store_blob(store, config_digest, str_data(cfg_s), str_len(cfg_s)) == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "failed to store config blob");
        return 0;
    }
    var config_desc = descriptor_new(media_oci_config(), config_digest, str_len(cfg_s));

    # OCI manifest blob.
    var layer_descs = vec_new();
    vec_push(layer_descs, descriptor_new(media_oci_layer(), layer_digest, gzlen));
    var man = oci_manifest_new(config_desc, layer_descs);
    var mm: OciManifest = man;
    mm.media_type = media_oci_manifest();
    var man_s = json_v_build(oci_manifest_to_jv(man));
    var manifest_digest = sha256_digest(str_data(man_s), str_len(man_s));
    if (image_store_store_blob(store, manifest_digest, str_data(man_s), str_len(man_s)) == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "failed to store manifest blob");
        return 0;
    }

    var layers = vec_new();
    vec_push(layers, layer);
    var ref = image_ref_new("local", name, tag, 0);
    var image = image_new(config_digest, ref, gzlen, layers, 0);
    _img_set_manifest_digest(image, manifest_digest);

    if (image_store_add_to_index(store, image) == 0) {
        stiva_err_print(STIVA_ERR_IO, "failed to update image index");
        return 0;
    }
    sakshi_info("import complete", strlen("import complete"));
    return image;
}

# Tag a local image with a new reference (rust-old: lib.rs tag). Finds the source
# by id OR full_ref, clones it under the parsed new reference (the manifest/
# config/layer blobs are shared — same manifest_digest), and re-indexes. Returns
# 1, 0 (source not found), -2 (new ref unparseable), -3 (index save failure).
fn image_store_tag(store, source, new_ref) {
    var images = image_store_load_index(store);
    var found = 0;
    var n = vec_len(images);
    var i = 0;
    while (i < n) {
        var im = vec_get(images, i);
        var ii: Image = im;
        if (streq(ii.id, source) == 1 || streq(image_ref_full_ref(ii.reference), source) == 1) {
            found = im;
        }
        i = i + 1;
    }
    if (found == 0) { return 0; }
    var parsed = image_ref_parse(new_ref);
    if (parsed == 0) { return 0 - 2; }
    var fi: Image = found;
    var tagged = image_new(fi.id, parsed, fi.size_bytes, fi.layers, fi.created_at);
    _img_set_manifest_digest(tagged, _img_manifest_digest(found));
    if (image_store_add_to_index(store, tagged) == 0) { return 0 - 3; }
    return 1;
}

# ── oci-archive save / load (A4) ──
#
# An oci-archive is a tar of a (single-image) OCI image layout: `oci-layout`,
# `index.json`, and `blobs/sha256/<hex>` — the machine-to-machine transfer form
# skopeo/podman produce and consume (`oci-archive:img.tar`). No registry needed.

# Build a TarEntry (regular file, mode 0644) for a store blob, named
# `blobs/sha256/<hex>`. Returns 0 if the blob is missing/unreadable.
#[must_use]
fn _il_blob_tar_entry(store, digest) {
    if (digest == 0) { return 0; }
    var path = _img_blob_path(image_store_root(store), digest);
    if (path == 0) { return 0; }
    if (file_exists(path) == 0) { return 0; }
    var len_cell = alloc(8);
    var data = _img_read_file(path, len_cell);
    if (data == 0) { return 0; }
    var arcname = _img_cat2("blobs/sha256/", digest_hex(digest));
    return _tar_entry_new(arcname, 48, 420, 0, 0, load64(len_cell), data);
}

# Save an image (by id or full_ref) as an oci-archive tarball at `out_path`. The
# archive is a valid single-image OCI layout: oci-layout, index.json (just this
# image's descriptor), and its manifest/config/layer blobs. Returns 1 on
# success, 0 (image not found), -1 (a missing blob or write failure).
fn image_store_save_archive(store, ref_or_id, out_path) {
    var images = image_store_load_index(store);
    var found = 0;
    var n = vec_len(images);
    var i = 0;
    while (i < n) {
        var im = vec_get(images, i);
        if (streq(_img_id(im), ref_or_id) == 1 || streq(image_ref_full_ref(_image_reference(im)), ref_or_id) == 1) {
            found = im;
        }
        i = i + 1;
    }
    if (found == 0) { return 0; }

    var entries = vec_new();

    # oci-layout marker.
    var lo = json_v_obj_new();
    json_v_obj_set(lo, str_from("imageLayoutVersion"), json_v_str_new(str_from(oci_image_layout_version())));
    var lo_s = json_v_build(lo);
    vec_push(entries, _tar_entry_new("oci-layout", 48, 420, 0, 0, str_len(lo_s), str_data(lo_s)));

    # index.json with only this image's descriptor.
    var msize = image_store_blob_size(store, _img_manifest_digest(found));
    if (msize < 0) { msize = 0; }
    var manifests = json_v_arr_new();
    json_v_arr_push(manifests, _il_manifest_descriptor_jv(store, found, msize));
    var idx = json_v_obj_new();
    json_v_obj_set(idx, str_from("schemaVersion"), json_v_int_new(2));
    json_v_obj_set(idx, str_from("mediaType"), json_v_str_new(str_from(media_oci_index())));
    json_v_obj_set(idx, str_from("manifests"), manifests);
    var idx_s = json_v_build(idx);
    vec_push(entries, _tar_entry_new("index.json", 48, 420, 0, 0, str_len(idx_s), str_data(idx_s)));

    # blobs: manifest, config, then each layer. Image/Layer fields are read via
    # raw-offset accessors — cycc miscompiles the struct-field access in this fn.
    var me = _il_blob_tar_entry(store, _img_manifest_digest(found));
    if (me == 0) { return 0 - 1; }
    vec_push(entries, me);
    var ce = _il_blob_tar_entry(store, _img_id(found));
    if (ce == 0) { return 0 - 1; }
    vec_push(entries, ce);
    var layers = _img_layers(found);
    var lj = 0;
    while (lj < vec_len(layers)) {
        var ll = vec_get(layers, lj);
        var le = _il_blob_tar_entry(store, _layer_digest(ll));
        if (le == 0) { return 0 - 1; }
        vec_push(entries, le);
        lj = lj + 1;
    }

    if (_stor_write_tar(entries, out_path) == 0) { return 0 - 1; }
    return 1;
}

# Copy a blob (by digest) from an OCI layout dir into the store, verifying its
# content digest (image_store_store_blob re-hashes). Returns 1 on success, 0 if
# the source blob is missing or fails verification. A blob already in the store
# is a no-op success (dedup on transfer).
fn _il_copy_blob_from(store, layout, digest) {
    if (image_store_has_blob(store, digest) == 1) { return 1; }
    var src = _img_cat2(_img_cat2(layout, "/blobs/sha256/"), digest_hex(digest));
    if (file_exists(src) == 0) { return 0; }
    var len_cell = alloc(8);
    var data = _img_read_file(src, len_cell);
    if (data == 0) { return 0; }
    if (image_store_store_blob(store, digest, data, load64(len_cell)) == 0) { return 0; }
    return 1;
}

# Merge an on-disk OCI layout dir (`layout`) into `store`: for each index.json
# manifest descriptor, copy its manifest/config/layer blobs (verifying digests)
# and add the reconstructed image to the store index. Returns the number of
# images loaded, or -1 if the layout has no readable index.json.
fn _il_load_oci_layout(store, layout) {
    var idx_path = _img_cat2(layout, "/index.json");
    if (file_exists(idx_path) == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "archive has oci-layout but no index.json");
        return 0 - 1;
    }
    var il_cell = alloc(8);
    var ibuf = _img_read_file(idx_path, il_cell);
    if (ibuf == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "archive index.json is unreadable");
        return 0 - 1;
    }
    var manifests = _il_index_manifests(bayan_json_v_parse_buf(ibuf, load64(il_cell)));
    if (manifests == 0) { return 0; }

    var loaded = 0;
    var n = json_v_arr_len(manifests);
    var i = 0;
    while (i < n) {
        var desc = json_v_arr_get(manifests, i);
        var mdigest = _il_jv_str_field(desc, "digest");
        if (mdigest != 0) {
            if (_il_copy_blob_from(store, layout, mdigest) == 1) {
                var man = _il_read_manifest(store, mdigest);
                if (man != 0) {
                    var mm: OciManifest = man;
                    var cfg: Descriptor = mm.config;
                    # Every referenced blob must copy AND verify (image_store_store_blob
                    # re-hashes) — a missing/tampered config or layer skips the whole
                    # image rather than indexing a broken one.
                    var ok = _il_copy_blob_from(store, layout, cfg.digest);
                    var layers = vec_new();
                    var total = 0;
                    var mlayers = mm.layers;
                    var lj = 0;
                    while (lj < vec_len(mlayers)) {
                        var ld: Descriptor = vec_get(mlayers, lj);
                        if (_il_copy_blob_from(store, layout, ld.digest) == 0) { ok = 0; }
                        vec_push(layers, layer_new(ld.digest, ld.size, ld.media_type));
                        total = total + ld.size;
                        lj = lj + 1;
                    }
                    if (ok == 1) {
                        var refname = _il_desc_ref_name(desc);
                        var reference = 0;
                        if (refname != 0) { reference = _il_parse_full_ref(refname); }
                        if (reference == 0) { reference = image_ref_new("local", cfg.digest, "latest", 0); }
                        var img = image_new(cfg.digest, reference, total, layers, 0);
                        _img_set_manifest_digest(img, mdigest);
                        if (image_store_add_to_index(store, img) == 1) { loaded = loaded + 1; }
                    } else {
                        stiva_err_print(STIVA_ERR_STORAGE, "archive image skipped: blob missing or unverified");
                    }
                }
            }
        }
        i = i + 1;
    }
    return loaded;
}

# Load an oci-archive tarball at `path` into the store (the transfer inverse of
# save). Extracts to a scratch dir under the store root, validates the oci-layout
# marker, then merges the layout. Returns the number of images loaded, or -1 on
# failure. A docker-archive (manifest.json, no oci-layout) is detected and
# converted through `_il_load_docker_archive` (landed v3.0.3).
# Gzip one uncompressed docker-archive layer tar (`dir/lname`) and store it as an
# OCI gzip layer blob, appending its descriptor + Layer to the given vecs. Returns
# the compressed length (> 0) on success, 0 on any read/gzip/store failure.
fn _il_docker_add_layer(store, dir, lname, layer_descs, layers) {
    # `lname` comes from an untrusted manifest.json — reject absolute / ".." so it
    # cannot escape `dir` to read an arbitrary host file.
    if (_stor_name_is_safe(lname) == 0) { return 0; }
    var lpath = _img_cat2(_img_cat2(dir, "/"), lname);
    var llc = alloc(8);
    var lbuf = _img_read_file(lpath, llc);
    if (lbuf == 0) { return 0; }
    var ulen = load64(llc);
    var gzcap = ulen + ulen / 50 + 8192;
    var gzbuf = alloc(gzcap);
    # Streaming encoder — see `_stor_gzip_compress` (storage.cyr) for why the
    # batch `gzip_compress` cannot be used on a layer tar.
    var gzlen = _stor_gzip_compress(lbuf, ulen, gzbuf, gzcap);
    if (gzlen < 0) { return 0; }
    var ldigest = sha256_digest(gzbuf, gzlen);
    if (image_store_store_blob(store, ldigest, gzbuf, gzlen) == 0) { return 0; }
    vec_push(layer_descs, descriptor_new(media_oci_layer(), ldigest, gzlen));
    vec_push(layers, layer_new(ldigest, gzlen, media_oci_layer()));
    return gzlen;
}

# Load a `docker save` layout (extracted at `dir`) into the OCI store: parse
# manifest.json (an array of {Config, RepoTags, Layers}), and for each image
# store the config blob verbatim (its rootfs.diff_ids already match), gzip each
# uncompressed layer tar into an OCI gzip blob, assemble + store an OCI manifest,
# and index it under RepoTags[0]. Returns the number of images loaded, or -1 if
# manifest.json is absent/unparsable. Reuses the OCI store path — no new types.
fn _il_load_docker_archive(store, dir) {
    var mpath = _img_cat2(dir, "/manifest.json");
    if (file_exists(mpath) == 0) { return 0 - 1; }
    var mc = alloc(8);
    var mbuf = _img_read_file(mpath, mc);
    if (mbuf == 0) { return 0 - 1; }
    var root = bayan_json_v_parse_buf(mbuf, load64(mc));
    if (json_v_is_arr(root) == 0) { return 0 - 1; }

    var loaded = 0;
    var n = json_v_arr_len(root);
    var i = 0;
    while (i < n) {
        var entry = json_v_arr_get(root, i);
        var cfg_name = _il_jv_str_field(entry, "Config");
        # Reject an absolute / ".." Config path (untrusted manifest.json) — same
        # host-file-read escape as the layer names.
        if (cfg_name != 0 && _stor_name_is_safe(cfg_name) == 1) {
            var cc = alloc(8);
            var cbuf = _img_read_file(_img_cat2(_img_cat2(dir, "/"), cfg_name), cc);
            if (cbuf != 0) {
                var clen = load64(cc);
                var config_digest = sha256_digest(cbuf, clen);
                if (image_store_store_blob(store, config_digest, cbuf, clen) != 0) {
                    var config_desc = descriptor_new(media_oci_config(), config_digest, clen);
                    var layer_descs = vec_new();
                    var layers = vec_new();
                    var total = 0;
                    var ok = 1;
                    var larr = json_v_obj_get(entry, "Layers");
                    if (json_v_is_arr(larr) == 1) {
                        var ln = json_v_arr_len(larr);
                        var lj = 0;
                        while (lj < ln) {
                            var lf = json_v_arr_get(larr, lj);
                            if (json_v_is_str(lf) == 1) {
                                var lname = str_cstr(json_v_str(lf));
                                var gl = _il_docker_add_layer(store, dir, lname, layer_descs, layers);
                                if (gl == 0) { ok = 0; } else { total = total + gl; }
                            }
                            lj = lj + 1;
                        }
                    }
                    if (ok == 1 && vec_len(layers) > 0) {
                        var man = oci_manifest_new(config_desc, layer_descs);
                        var mm: OciManifest = man;
                        mm.media_type = media_oci_manifest();
                        var man_s = json_v_build(oci_manifest_to_jv(man));
                        var mdig = sha256_digest(str_data(man_s), str_len(man_s));
                        if (image_store_store_blob(store, mdig, str_data(man_s), str_len(man_s)) != 0) {
                            var reference = 0;
                            var rt = json_v_obj_get(entry, "RepoTags");
                            if (json_v_is_arr(rt) == 1) {
                                if (json_v_arr_len(rt) > 0) {
                                    var rt0 = json_v_arr_get(rt, 0);
                                    if (json_v_is_str(rt0) == 1) {
                                        reference = image_ref_parse(str_cstr(json_v_str(rt0)));
                                    }
                                }
                            }
                            if (reference == 0) { reference = image_ref_new("local", config_digest, "latest", 0); }
                            var img = image_new(config_digest, reference, total, layers, 0);
                            _img_set_manifest_digest(img, mdig);
                            if (image_store_add_to_index(store, img) == 1) { loaded = loaded + 1; }
                        }
                    } else {
                        stiva_err_print(STIVA_ERR_STORAGE, "docker image skipped: layer missing/ungzippable");
                    }
                }
            }
        }
        i = i + 1;
    }
    return loaded;
}

fn image_store_load_archive(store, path) {
    var len_cell = alloc(8);
    var tarbuf = _img_read_file(path, len_cell);
    if (tarbuf == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "cannot read archive");
        return 0 - 1;
    }

    var tmp = _img_cat2(image_store_root(store), "/.load-tmp");
    _stor_remove_dir_all(tmp);
    sys_mkdir(tmp, 493);
    if (_stor_extract_tar(tarbuf, load64(len_cell), tmp) != 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "malformed archive");
        _stor_remove_dir_all(tmp);
        return 0 - 1;
    }

    if (file_exists(_img_cat2(tmp, "/oci-layout")) == 0) {
        # Not an oci-archive — try a `docker save` layout (manifest.json).
        if (file_exists(_img_cat2(tmp, "/manifest.json")) == 1) {
            var dcount = _il_load_docker_archive(store, tmp);
            _stor_remove_dir_all(tmp);
            return dcount;
        }
        _stor_remove_dir_all(tmp);
        stiva_err_print(STIVA_ERR_STORAGE, "not an oci-archive or docker-archive (no oci-layout / manifest.json)");
        return 0 - 1;
    }

    var count = _il_load_oci_layout(store, tmp);
    _stor_remove_dir_all(tmp);
    return count;
}

# ══ Registry pull driver (roadmap §B Inc-7) ══════════════
# Oracle: rust-old/src/image.rs:139-236 (ImageStore::pull).
#
# This lives in imagelayout.cyr rather than registry.cyr purely because of
# include order: registry.cyr is included FIRST, so it cannot call
# image_store_add_to_index. The dependency only runs one way.

# Fetch one layer or config blob into the store.
# Foreign/non-distributable layers (a descriptor carrying `urls`) are NOT
# followed — see the note in image_store_pull.
fn _il_pull_blob(client, store, ref, digest, size) {
    if (image_store_has_blob(store, digest) == 1) { return 1; }
    if (registry_fetch_blob_to_store(client, store, ref, digest, size) == 0) { return 0; }
    return 1;
}

# Pull `ref` from `client` into `store`. Returns the Image*, or 0.
#
# Divergences from the oracle, each deliberate:
#
#  * **The manifest is stored under the digest the registry served**, using the
#    bytes as received. The oracle re-serializes the parsed manifest with
#    `to_vec_pretty` and stores that under the re-encoded digest
#    (image.rs:151-153), so the stored blob's digest is not the manifest's real
#    identity: index.json then points at something the registry never served and
#    `Docker-Content-Digest` can never be re-checked from disk. For a store that
#    claims to be an OCI image layout that is simply wrong.
#  * **Layers download sequentially.** The oracle uses `buffer_unordered(4)`.
#    The Cyrius runtime is single-threaded run-to-completion; parallel layer
#    fetch is roadmap v3.1.
#  * **Foreign layers are refused, not fetched.** The oracle follows
#    `descriptor.urls` to an arbitrary external host (image.rs:186-190). That
#    URL comes from the manifest, i.e. from the registry — following it is an
#    SSRF primitive against whatever the daemon can reach, and the bytes are
#    still digest-checked but the *request* has already happened. Refusing is
#    the safe default; a flag to opt in belongs with the CLI work in Inc-10.
fn image_store_pull(client, store, ref) {
    if (client == 0 || store == 0 || ref == 0) { return 0; }
    sakshi_info("pulling image", strlen("pulling image"));

    # 1. Resolve (transparently handles a multi-arch index).
    var man = registry_resolve_manifest(client, ref);
    if (man == 0) { return 0; }

    # 2. Persist the manifest bytes exactly as served.
    var mbody = registry_last_manifest_body();
    var mlen = registry_last_manifest_body_len();
    var mdigest = registry_last_manifest_digest();
    if (mbody == 0 || mlen <= 0 || mdigest == 0) {
        stiva_err_print(STIVA_ERR_REGISTRY, "manifest bytes unavailable after resolve");
        return 0;
    }
    if (image_store_store_blob(store, mdigest, mbody, mlen) == 0) {
        stiva_err_print(STIVA_ERR_IO, "cannot store manifest blob");
        return 0;
    }

    var mm: OciManifest = man;

    # 3. Config blob. Its digest becomes the image id, so this one is not
    #    optional — a missing config means no inspect, no run.
    var cfg: Descriptor = mm.config;
    var cfg_digest = cfg.digest;
    if (cfg_digest == 0) {
        stiva_err_print(STIVA_ERR_REGISTRY, "manifest has no config descriptor");
        return 0;
    }
    if (_il_pull_blob(client, store, ref, cfg_digest, cfg.size) == 0) { return 0; }

    # 4. Layers, in manifest order. A failure aborts the pull WITHOUT adding to
    #    index.json, so a half-pulled image is never listable or runnable; the
    #    blobs that did land stay content-addressed and are either reused by the
    #    next attempt or swept by `gc`.
    var layers = vec_new();
    var total = 0;
    var descs = mm.layers;
    var n = 0;
    if (descs != 0) { n = vec_len(descs); }
    var i = 0;
    while (i < n) {
        var ld: Descriptor = vec_get(descs, i);
        var ldigest = ld.digest;
        if (ldigest == 0) {
            stiva_err_print(STIVA_ERR_REGISTRY, "layer descriptor has no digest");
            return 0;
        }
        if (ld.urls != 0) {
            if (vec_len(ld.urls) > 0) {
                stiva_err_print(STIVA_ERR_PULL_FAILED,
                  "foreign layer (descriptor carries urls); refusing to fetch from an external host");
                return 0;
            }
        }
        if (_il_pull_blob(client, store, ref, ldigest, ld.size) == 0) { return 0; }
        vec_push(layers, layer_new(ldigest, ld.size, ld.media_type));
        total = total + ld.size;
        i = i + 1;
    }

    # 5. Image record — id is the config digest (oracle image.rs:218).
    # created_at is epoch SECONDS (image.cyr:272-278) — clock_epoch_secs, not
    # clock_now_ns, which is monotonic uptime in ns (lib/chrono.cyr:10-15) and
    # would record an image as created a few seconds after boot, in 1970.
    # Note it is not durable: index.json carries no `created` field, so
    # image_store_load_index reconstructs it as 0 (imagelayout.cyr:363).
    var image = image_new(cfg_digest, ref, total, layers, clock_epoch_secs());
    _img_set_manifest_digest(image, mdigest);

    # 6. Publish. Only now does the image become visible to list/inspect/run.
    if (image_store_add_to_index(store, image) == 0) {
        stiva_err_print(STIVA_ERR_IO, "failed to update image index");
        return 0;
    }
    sakshi_info("pull complete", strlen("pull complete"));
    return image;
}

# ══ Registry push driver (roadmap §B Inc-8) ══════════════
# Oracle: rust-old has no equivalent driver — it exposes push_blob /
# push_manifest and leaves assembly to the caller. The ordering below is the OCI
# distribution requirement, not an invention: a manifest may only be PUT once
# every blob it references is already in the registry, otherwise the registry
# rejects it (or, worse, accepts a manifest with dangling references).

# Read a blob out of the store. Returns the buffer; writes its length to
# `out_len`. 0 on failure.
fn _il_read_blob(store, digest, out_len) {
    var path = _img_blob_path(image_store_root(store), digest);
    if (path == 0) { store64(out_len, 0); return 0; }
    if (file_exists(path) == 0) { store64(out_len, 0); return 0; }
    return _img_read_file(path, out_len);
}

# Upload one blob from the store. `_IL_PUSH_CHUNK_THRESHOLD` picks monolithic vs
# chunked: a single PUT is one round trip and every registry supports it, but a
# very large layer in one request risks proxy body limits and gives up all
# progress on a failure.
var _IL_PUSH_CHUNK_THRESHOLD = 67108864;
var _IL_PUSH_CHUNK_SIZE = 16777216;

fn _il_push_blob(client, store, target, digest) {
    # Precheck BEFORE reading. _img_read_file allocates the whole blob out of a
    # bump arena with no free on this path, so reading first would make peak RSS
    # the sum of every layer — even when the registry already has them all and
    # nothing is uploaded. That is exactly the failure Inc-6 streams to avoid.
    if (registry_blob_exists(client, target, digest) == 1) { return 1; }
    var lc = alloc(8);
    var buf = _il_read_blob(store, digest, lc);
    var n = load64(lc);
    if (buf == 0 || n <= 0) {
        # Name the digest: on a twenty-layer image "blob missing from local
        # store" alone does not tell the operator which layer to re-pull.
        stiva_err_print(STIVA_ERR_IO, _img_cat2("cannot read blob for push: ", digest));
        return 0;
    }
    if (n > _IL_PUSH_CHUNK_THRESHOLD) {
        return registry_push_blob_chunked(client, target, digest, buf, n, _IL_PUSH_CHUNK_SIZE);
    }
    return registry_push_blob(client, target, digest, buf, n);
}

# Resolve a local image by config-digest ID or by full reference, the dual key
# every image-taking verb uses (rust-old: lib.rs:316-320). Returns Image*, or 0.
#
# FIRST match wins, matching the oracle's `.find()` and the two other resolvers
# in this tree (_stiva_find_image, _cli_find_image). It matters now that the
# digest-aware index dedup lets two pinned images share a full_ref: a last-wins
# resolver here would make `push <ref>` upload a different image than
# `run <ref>` starts, with nothing to signal the divergence.
#[must_use]
fn image_store_find(store, ref_or_id) {
    if (store == 0 || ref_or_id == 0) { return 0; }
    var images = image_store_load_index(store);
    var n = vec_len(images);
    var i = 0;
    while (i < n) {
        var im = vec_get(images, i);
        if (streq(_img_id(im), ref_or_id) == 1) { return im; }
        if (streq(image_ref_full_ref(_image_reference(im)), ref_or_id) == 1) { return im; }
        i = i + 1;
    }
    return 0;
}

# Push the local image `ref_or_id` to `target`. Returns 1 on success, 0 on
# failure.
#
# The manifest is pushed as the EXACT bytes held in the store, so an image
# pulled from one registry and pushed to another keeps its digest — which is the
# entire point of content addressing, and only works because Inc-7 stores the
# manifest as served rather than re-serializing it.
fn image_store_push(client, store, ref_or_id, target) {
    if (client == 0 || store == 0 || target == 0 || ref_or_id == 0) { return 0; }

    var found = image_store_find(store, ref_or_id);
    if (found == 0) {
        stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, ref_or_id);
        return 0;
    }

    var mdigest = _img_manifest_digest(found);
    if (mdigest == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "image has no manifest digest");
        return 0;
    }
    var man = _il_read_manifest(store, mdigest);
    if (man == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "manifest blob missing or unparseable");
        return 0;
    }

    sakshi_info("pushing image", strlen("pushing image"));

    # 1. Config blob first. The manifest references it, so it has to land first.
    var mm: OciManifest = man;
    var cfg: Descriptor = mm.config;
    if (cfg.digest == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "manifest has no config descriptor");
        return 0;
    }
    if (_il_push_blob(client, store, target, cfg.digest) == 0) { return 0; }

    # 2. Every layer.
    var descs = mm.layers;
    var ln = 0;
    if (descs != 0) { ln = vec_len(descs); }
    var j = 0;
    while (j < ln) {
        var ld: Descriptor = vec_get(descs, j);
        if (ld.digest == 0) {
            stiva_err_print(STIVA_ERR_STORAGE, "layer descriptor has no digest");
            return 0;
        }
        if (_il_push_blob(client, store, target, ld.digest) == 0) { return 0; }
        j = j + 1;
    }

    # 3. The manifest last — only now are all its references resolvable.
    var mc = alloc(8);
    var mbuf = _il_read_blob(store, mdigest, mc);
    var mlen = load64(mc);
    if (mbuf == 0 || mlen <= 0) {
        stiva_err_print(STIVA_ERR_IO, "cannot read manifest blob");
        return 0;
    }
    if (registry_push_manifest(client, target, mbuf, mlen, mm.media_type) == 0) { return 0; }

    sakshi_info("push complete", strlen("push complete"));
    return 1;
}

# --- build.cyr ---

# stiva — TOML-based image build spec: types, defaults, build cache store.
# Ported from rust-old/src/build.rs.
#
# What ports cleanly here (self-contained or depends only on already-ported
# image.cyr):
#   struct ImageDef    { base, name, tag }           + default_tag
#   struct BuildStage  { name, base, steps }
#   struct BuildConfig { entrypoint, expose, user, workdir }
#   struct BuildStep   { tag, ... } + enum BuildStep discriminants
#   struct BuildSpec   { image, steps, config, stages }
#   store_layer            (sha256_digest + store_blob — both in image.cyr)
#   check_build_cache / record_build_cache
#       (the on-disk {root}/cache/{hex} key→digest map; plain file ops)
#
# What ports here now (v3.0.0 — bayan TOML object model):
#   parse_build_spec — parses a Stivafile TOML string into the BuildSpec tree
#     via bayan_toml_parse + bayan_toml_get / _get_array / _get_sections
#     (rust-old used toml::from_str). See the fn's own comment for the [image]
#     / [[steps]] / [config] mapping and the stages caveat.
#
# What is DEFERRED (see the block at the bottom):
#   * build_cache_key — hashes serde_json::to_string(step). ACHIEVABLE via
#     bayan's JSON serializer; just not wired yet (NOT a Cyrius gap).
#   * build_run_layer / build_copy_layer / append_dir_recursive / build_image
#     — construct tar.gz layers (flate2 GzEncoder + tar::Builder) and
#     build_image is async (drives ImageStore::pull over the network). The
#     ported base has neither a tar builder / gzip encoder nor the async
#     registry network layer, so these land with those.
#
# sha256_digest is NOT re-ported here — build.rs's private copy is
# byte-identical to image.cyr's public sha256_digest; we reuse that one to
# avoid a duplicate global (Cyrius hoists fns to globals, last-def-wins).
#
# Error mapping (mirrors error.cyr): Rust `Err(StivaError::Storage(String))`
# becomes an integer sentinel here — store_layer returns 0 on a store
# failure; the caller reports it via stiva_err_print(STIVA_ERR_STORAGE,
# detail).

# ── BuildStep discriminant (rust-old: enum BuildStep) ────────────
# The Rust enum is `#[serde(tag = "type", rename_all = "lowercase")]` and
# `#[non_exhaustive]`; each variant carries fields. Cyrius has no
# data-carrying enums, so the discriminant is this enum and the payload
# lives in the BuildStep struct's fields (unused fields are 0 per variant).
# Members are prefixed BUILD_STEP_* for global enum-member uniqueness
# (Cyrius hoists members to globals under last-def-wins — see error.cyr).
enum BuildStep {
    BUILD_STEP_RUN = 0;
    BUILD_STEP_COPY = 1;
    BUILD_STEP_ENV = 2;
    BUILD_STEP_WORKDIR = 3;
    BUILD_STEP_LABEL = 4;
    BUILD_STEP_FROM_STAGE = 5;
}

# Serde `type` wire name for a BuildStep discriminant (the lowercase tag
# values; from_stage keeps its explicit `#[serde(rename = "from_stage")]`).
#[must_use]
fn build_step_type_name(kind) {
    if (kind == BUILD_STEP_RUN) { return "run"; }
    if (kind == BUILD_STEP_COPY) { return "copy"; }
    if (kind == BUILD_STEP_ENV) { return "env"; }
    if (kind == BUILD_STEP_WORKDIR) { return "workdir"; }
    if (kind == BUILD_STEP_LABEL) { return "label"; }
    if (kind == BUILD_STEP_FROM_STAGE) { return "from_stage"; }
    return "unknown";
}

# A single build step. `kind` selects which fields are meaningful:
#   RUN        → command   (cstr; the space-joined argv, or a vec — see note)
#   COPY       → source, destination
#   ENV        → key, value
#   WORKDIR    → source     (the path; reuses the `source` slot)
#   LABEL      → key, value
#   FROM_STAGE → stage, source, destination
# Unused slots are 0. In the Rust oracle `command` is a `Vec<String>`; here
# a BuildStep holds an i64 that a caller may treat as a vec of cstrs.
struct BuildStep {
    kind;
    command;
    source;
    destination;
    key;
    value;
    stage;
}

fn build_step_run(command) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_RUN;
    ss.command = command;
    ss.source = 0;
    ss.destination = 0;
    ss.key = 0;
    ss.value = 0;
    ss.stage = 0;
    return s;
}

fn build_step_copy(source, destination) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_COPY;
    ss.command = 0;
    ss.source = source;
    ss.destination = destination;
    ss.key = 0;
    ss.value = 0;
    ss.stage = 0;
    return s;
}

fn build_step_env(key, value) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_ENV;
    ss.command = 0;
    ss.source = 0;
    ss.destination = 0;
    ss.key = key;
    ss.value = value;
    ss.stage = 0;
    return s;
}

fn build_step_workdir(path) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_WORKDIR;
    ss.command = 0;
    ss.source = path;
    ss.destination = 0;
    ss.key = 0;
    ss.value = 0;
    ss.stage = 0;
    return s;
}

fn build_step_label(key, value) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_LABEL;
    ss.command = 0;
    ss.source = 0;
    ss.destination = 0;
    ss.key = key;
    ss.value = value;
    ss.stage = 0;
    return s;
}

fn build_step_from_stage(stage, source, destination) {
    var s = alloc(56);
    var ss: BuildStep = s;
    ss.kind = BUILD_STEP_FROM_STAGE;
    ss.command = 0;
    ss.source = source;
    ss.destination = destination;
    ss.key = 0;
    ss.value = 0;
    ss.stage = stage;
    return s;
}

# ── ImageDef (rust-old: struct ImageDef) ──────────────────
# Image identity within a build spec. `tag` defaults to "latest" (serde
# `#[serde(default = "default_tag")]`).
struct ImageDef {
    base;
    name;
    tag;
}

fn image_def_new(base, name, tag) {
    var d = alloc(24);
    var dd: ImageDef = d;
    dd.base = base;
    dd.name = name;
    dd.tag = tag;
    return d;
}

# Default output tag (rust-old: fn default_tag). Serde default for
# ImageDef::tag when the TOML omits it.
#[must_use]
fn default_tag() {
    return "latest";
}

# ── BuildStage (rust-old: struct BuildStage) ────────────────
# A named multi-stage build stage. `steps` is a vec of BuildStep*.
struct BuildStage {
    name;
    base;
    steps;
}

fn build_stage_new(name, base, steps) {
    var s = alloc(24);
    var ss: BuildStage = s;
    ss.name = name;
    ss.base = base;
    ss.steps = steps;
    return s;
}

# ── BuildConfig (rust-old: struct BuildConfig, derives Default) ──
# Final image config applied after all steps. `entrypoint` and `expose`
# are vecs (of cstr / u16 respectively); `user` and `workdir` are cstr or
# 0 for None (Rust Option<String>).
struct BuildConfig {
    entrypoint;
    expose;
    user;
    workdir;
}

# Default BuildConfig (rust-old: BuildConfig::default): empty entrypoint /
# expose vecs, user/workdir = None (0).
fn build_config_default() {
    var c = alloc(32);
    var cc: BuildConfig = c;
    cc.entrypoint = vec_new();
    cc.expose = vec_new();
    cc.user = 0;
    cc.workdir = 0;
    return c;
}

fn build_config_new(entrypoint, expose, user, workdir) {
    var c = alloc(32);
    var cc: BuildConfig = c;
    cc.entrypoint = entrypoint;
    cc.expose = expose;
    cc.user = user;
    cc.workdir = workdir;
    return c;
}

# ── BuildSpec (rust-old: struct BuildSpec) ─────────────────
# A full TOML-based image build spec. `steps` / `stages` are vecs of
# BuildStep* / BuildStage*; `image` is an ImageDef*, `config` a BuildConfig*.
struct BuildSpec {
    image;
    steps;
    config;
    stages;
}

fn build_spec_new(image, steps, config, stages) {
    var s = alloc(32);
    var ss: BuildSpec = s;
    ss.image = image;
    ss.steps = steps;
    ss.config = config;
    ss.stages = stages;
    return s;
}

# ── Build cache store ────────────────────────
# The on-disk key→digest cache under {root}/cache. A cache key is a
# `sha256:{hex}` string; the file name is the bare hex (Rust strips the
# "sha256:" prefix with strip_prefix, which is exactly image.cyr's
# digest_hex). These are plain file operations — no serde — so they port
# cleanly on top of image.cyr's ImageStore.

# Path "{root}/cache/{hex}" for a cache key (rust-old: the shared
# `cache_dir.join(cache_key.strip_prefix("sha256:").unwrap_or(cache_key))`).
#[must_use]
fn _build_cache_path(store, cache_key) {
    var root = image_store_root(store);
    var hex = digest_hex(cache_key);          # strip "sha256:" if present
    var dir = _img_cat2(root, "/cache/");
    return _img_cat2(dir, hex);
}

# Check whether a cached layer digest exists for a cache key
# (rust-old: check_build_cache). Reads the cache file's contents (the
# stored layer digest) into `buf` (up to `maxlen`); returns the byte count,
# or -1 when no cache entry exists (rust-old: None).
fn check_build_cache(store, cache_key, buf, maxlen) {
    var path = _build_cache_path(store, cache_key);
    if (file_exists(path) == 0) { return 0 - 1; }
    return file_read_all(path, buf, maxlen);
}

# Record a cache entry mapping a cache key → a layer digest
# (rust-old: record_build_cache). Creates {root}/cache (idempotent) and
# writes the digest to the key's file. Returns 0 on success, -1 on a
# write failure (rust-old: Err(StivaError) via `?`; caller maps to
# STIVA_ERR_IO).
fn record_build_cache(store, cache_key, layer_digest) {
    var root = image_store_root(store);
    var cache_dir = _img_cat2(root, "/cache");
    sys_mkdir(cache_dir, 493);                # 0o755 — create_dir_all analogue
    var path = _build_cache_path(store, cache_key);
    var n = strlen(layer_digest);
    if (file_write_all(path, layer_digest, n) < 0) { return 0 - 1; }
    return 0;
}

# BuildStep* → JSON object, matching serde's internally-tagged encoding
# (`#[serde(tag = "type", rename_all = "lowercase")]`): the "type" tag first,
# then the variant's fields in declaration order. bayan's compact json_v_build
# then reproduces serde_json::to_string(step) byte-for-byte for the well-formed
# case (the only consumer is build_cache_key's hash input).
fn build_step_to_jv(step) {
    var s: BuildStep = step;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("type"), json_v_str_new(str_from(build_step_type_name(s.kind))));
    if (s.kind == BUILD_STEP_RUN) {
        var arr = json_v_arr_new();
        if (s.command != 0) {
            var n = vec_len(s.command);
            var i = 0;
            while (i < n) {
                json_v_arr_push(arr, json_v_str_new(str_from(vec_get(s.command, i))));
                i = i + 1;
            }
        }
        json_v_obj_set(o, str_from("command"), arr);
    }
    if (s.kind == BUILD_STEP_COPY) {
        json_v_obj_set(o, str_from("source"), json_v_str_new(str_from(s.source)));
        json_v_obj_set(o, str_from("destination"), json_v_str_new(str_from(s.destination)));
    }
    if (s.kind == BUILD_STEP_ENV) {
        json_v_obj_set(o, str_from("key"), json_v_str_new(str_from(s.key)));
        json_v_obj_set(o, str_from("value"), json_v_str_new(str_from(s.value)));
    }
    if (s.kind == BUILD_STEP_WORKDIR) {
        json_v_obj_set(o, str_from("path"), json_v_str_new(str_from(s.source)));
    }
    if (s.kind == BUILD_STEP_LABEL) {
        json_v_obj_set(o, str_from("key"), json_v_str_new(str_from(s.key)));
        json_v_obj_set(o, str_from("value"), json_v_str_new(str_from(s.value)));
    }
    if (s.kind == BUILD_STEP_FROM_STAGE) {
        json_v_obj_set(o, str_from("stage"), json_v_str_new(str_from(s.stage)));
        json_v_obj_set(o, str_from("source"), json_v_str_new(str_from(s.source)));
        json_v_obj_set(o, str_from("destination"), json_v_str_new(str_from(s.destination)));
    }
    return o;
}

# Cache key for a build step (rust-old: build_cache_key). Hashes the string
# "{base_digest}:{step_index}:{serde_json(step)}" with SHA-256; returns the
# "sha256:{hex}" digest cstr.
#[must_use]
fn build_cache_key(base_digest, step_index, step) {
    var step_json = json_v_build(build_step_to_jv(step));   # Str (compact)
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base_digest);
    str_builder_add_cstr(sb, ":");
    str_builder_add_int(sb, step_index);
    str_builder_add_cstr(sb, ":");
    str_builder_add_str(sb, step_json);
    var input = str_builder_build(sb);
    return sha256_digest(str_data(input), str_len(input));
}

# Store a layer blob and return its digest (rust-old: store_layer).
# Computes sha256 over the `len` bytes at `data`, stores it in the blob
# store keyed by that digest, and returns the `sha256:{hex}` digest cstr.
# Returns 0 on a store failure (rust-old: Err(StivaError) via `?`; caller
# maps to STIVA_ERR_STORAGE).
fn store_layer(store, data, len) {
    var digest = sha256_digest(data, len);
    if (image_store_store_blob(store, digest, data, len) == 0) { return 0; }
    sakshi_debug("layer stored", strlen("layer stored"));
    return digest;
}

# ── Parsing (rust-old: parse_build_spec) ──────────────────
# Parse a Stivafile TOML string into a BuildSpec. The Rust oracle used
# `toml::from_str` (serde) over the nested BuildSpec/ImageDef/BuildStep/
# BuildConfig tree; here we drive bayan's TOML object model (bayan_toml_parse
# → sections; bayan_toml_get / _get_array / _get_sections) and rebuild the
# same struct tree by hand.
#
# bayan returns Str fat-pointers for every value; the ported BuildSpec structs
# hold cstr slots (matching the build_step_* / image_def_new constructors and
# the rest of the module), so each captured value is copied to a NUL-terminated
# cstr via str_cstr before it lands in a struct field.
#
# Error mapping (mirrors error.cyr + the Rust oracle): the Rust returns
# `Err(StivaError::InvalidState("invalid build spec: {e}"))` on any serde
# failure. bayan is best-effort (it never structurally errors), so the one
# fallible condition we can detect is the Rust `missing field `image`` — an
# absent `[image]` table. On that we return the integer sentinel 0; the caller
# reports it via stiva_err_print(STIVA_ERR_INVALID_STATE, "invalid build
# spec: missing [image] section"). A successful parse returns the BuildSpec*.
#
# Multi-stage `[[stages]]` are NOT reconstructed here: bayan's section model is
# flat (it cannot re-nest a stage's own `[[steps]]` under its stage table the
# way serde does), and the tar.gz stage BUILDER that consumes them stays
# deferred (docs/development/roadmap.md §F). `stages` therefore parses to an
# empty vec — matching the oracle's
# `#[serde(default)]` when no stages are present, which is every case the
# parse tests exercise.

# Copy a bayan value Str to a fresh NUL-terminated cstr, or 0 when the Str is
# absent (bayan_toml_get returns 0 for a missing key). Mirrors the Rust
# Option<String> → 0-for-None convention used across the ported base.
#[must_use]
fn _bld_val_cstr(v) {
    if (v == 0) { return 0; }
    return str_cstr(v);
}

# Build a vec of cstr elements from a bayan array VALUE looked up by `key` in
# `pairs` (rust-old: a serde `Vec<String>` field like a Run command or the
# entrypoint). Returns an empty vec when the key is absent or is not an array,
# so a missing `#[serde(default)]` vec field becomes `vec_new()`.
fn _bld_str_vec(pairs, key) {
    var out = vec_new();
    var arr = bayan_toml_get_array(pairs, key);
    if (arr == 0) { return out; }
    var i = 0;
    var n = vec_len(arr);
    while (i < n) {
        vec_push(out, str_cstr(vec_get(arr, i)));
        i = i + 1;
    }
    return out;
}

# Build a vec of i64 port numbers from a bayan array VALUE (rust-old:
# `Vec<u16>` expose). Each element is parsed with str_to_int. Empty vec when
# the key is absent.
fn _bld_int_vec(pairs, key) {
    var out = vec_new();
    var arr = bayan_toml_get_array(pairs, key);
    if (arr == 0) { return out; }
    var i = 0;
    var n = vec_len(arr);
    while (i < n) {
        vec_push(out, str_to_int(vec_get(arr, i)));
        i = i + 1;
    }
    return out;
}

# Reconstruct one BuildStep from a `[[steps]]` section's pairs vec, dispatching
# on the serde `type` tag (rust-old: `#[serde(tag = "type")]`). Returns a
# BuildStep* for a recognized tag, or 0 for an unknown/missing tag (rust-old:
# serde rejects an unknown variant → parse error; the caller drops the spec).
fn _bld_step_from_pairs(pairs) {
    var ty = bayan_toml_get(pairs, "type");
    if (ty == 0) { return 0; }
    if (str_eq_cstr(ty, "run") == 1) {
        return build_step_run(_bld_str_vec(pairs, "command"));
    }
    # EVERY variant's fields are REQUIRED here, and an absent one fails the
    # parse. `_bld_val_cstr` yields 0 for a missing key, and a 0 landing in a
    # BuildStep field reaches `str_from(0)` in `build_step_to_jv` (via
    # `build_cache_key`, on the ordinary build path) — a SIGSEGV driven by an
    # untrusted Stivafile, not a diagnostic. Rejecting at the parse boundary is
    # the only place the file is still a document rather than a struct.
    #
    # serde does this for free: the oracle's `#[serde(tag = "type")]` enum has
    # non-Option fields, so a missing one is a deserialization error. This is
    # that check, written out.
    if (str_eq_cstr(ty, "copy") == 1) {
        var src = _bld_val_cstr(bayan_toml_get(pairs, "source"));
        var dst = _bld_val_cstr(bayan_toml_get(pairs, "destination"));
        if (src == 0 || dst == 0) { return 0; }
        return build_step_copy(src, dst);
    }
    if (str_eq_cstr(ty, "env") == 1) {
        var ek = _bld_val_cstr(bayan_toml_get(pairs, "key"));
        var ev = _bld_val_cstr(bayan_toml_get(pairs, "value"));
        if (ek == 0 || ev == 0) { return 0; }
        return build_step_env(ek, ev);
    }
    if (str_eq_cstr(ty, "workdir") == 1) {
        var wp = _bld_val_cstr(bayan_toml_get(pairs, "path"));
        if (wp == 0) { return 0; }
        return build_step_workdir(wp);
    }
    if (str_eq_cstr(ty, "label") == 1) {
        var lk = _bld_val_cstr(bayan_toml_get(pairs, "key"));
        var lv = _bld_val_cstr(bayan_toml_get(pairs, "value"));
        if (lk == 0 || lv == 0) { return 0; }
        return build_step_label(lk, lv);
    }
    if (str_eq_cstr(ty, "from_stage") == 1) {
        var fstage = _bld_val_cstr(bayan_toml_get(pairs, "stage"));
        var fsrc = _bld_val_cstr(bayan_toml_get(pairs, "source"));
        var fdst = _bld_val_cstr(bayan_toml_get(pairs, "destination"));
        if (fstage == 0 || fsrc == 0 || fdst == 0) { return 0; }
        return build_step_from_stage(fstage, fsrc, fdst);
    }
    return 0;                              # unknown step type → parse failure
}

# Parse a Stivafile TOML string (cstr) into a BuildSpec* (rust-old:
# parse_build_spec). Returns 0 (STIVA_ERR_INVALID_STATE) on a missing [image]
# section or an unknown step type; otherwise the heap BuildSpec pointer.
#[must_use]
fn parse_build_spec(toml_str) {
    sakshi_info("parsing build specification", strlen("parsing build specification"));
    var sections = bayan_toml_parse(str_from(toml_str));

    # ── [image] → ImageDef (required) ─────────────────
    var image_secs = bayan_toml_get_sections(sections, "image");
    if (vec_len(image_secs) == 0) { return 0; }     # missing field `image`
    var image_pairs = bayan_toml_section_pairs(vec_get(image_secs, 0));
    var base = _bld_val_cstr(bayan_toml_get(image_pairs, "base"));
    var name = _bld_val_cstr(bayan_toml_get(image_pairs, "name"));
    if (base == 0) { return 0; }                    # missing field `base`
    if (name == 0) { return 0; }                    # missing field `name`
    var tag = _bld_val_cstr(bayan_toml_get(image_pairs, "tag"));
    if (tag == 0) { tag = default_tag(); }          # serde default = "latest"
    var image = image_def_new(base, name, tag);

    # ── [[steps]] → Vec<BuildStep> (serde default = empty) ────
    var steps = vec_new();
    var step_secs = bayan_toml_get_sections(sections, "steps");
    var si = 0;
    var sn = vec_len(step_secs);
    while (si < sn) {
        var step = _bld_step_from_pairs(bayan_toml_section_pairs(vec_get(step_secs, si)));
        if (step == 0) { return 0; }                # unknown/missing step type
        vec_push(steps, step);
        si = si + 1;
    }

    # ── [config] → BuildConfig (serde default) ────────
    var config_secs = bayan_toml_get_sections(sections, "config");
    var config = 0;
    if (vec_len(config_secs) == 0) {
        config = build_config_default();
    } else {
        var cp = bayan_toml_section_pairs(vec_get(config_secs, 0));
        var entrypoint = _bld_str_vec(cp, "entrypoint");
        var expose = _bld_int_vec(cp, "expose");
        var user = _bld_val_cstr(bayan_toml_get(cp, "user"));
        var workdir = _bld_val_cstr(bayan_toml_get(cp, "workdir"));
        config = build_config_new(entrypoint, expose, user, workdir);
    }

    # ── stages: flat bayan model cannot re-nest per-stage steps; the
    # consuming tar.gz stage builder is deferred (roadmap.md §F) → empty vec
    # (serde default). `build_image` below refuses `from_stage` outright.
    sakshi_debug("build spec parsed", strlen("build spec parsed"));
    return build_spec_new(image, steps, config, vec_new());
}

# ══ §F — the build driver ═══════════════
# (rust-old: build_image :255, build_copy_layer :514)
#
# `build_image` composes machinery that already exists: the tar writer and gzip
# encoder from storage.cyr, the OCI config/manifest assembly and index from
# imagelayout.cyr, the blob store from image.cyr, and the registry client from
# registry.cyr. Nothing here needs a sandbox — see the RUN note below.
#
# FIVE DELIBERATE DIVERGENCES from the oracle, each fixing a defect rather than
# reproducing it. They are the reason a built image is valid where the oracle's
# would not be:
#
#  1. `rootfs.diff_ids` are the UNCOMPRESSED tar digests. The oracle
#     (build.rs:401) maps `all_layers.iter().map(|l| l.digest)` — the COMPRESSED
#     blob digests. The OCI image-spec defines diff_ids over the uncompressed
#     layer, so every image the oracle builds fails validation in any other tool
#     and cannot have its rootfs verified. Group A already got this right for
#     `import` (imagelayout.cyr `image_import`); this matches it.
#
#  2. A MANIFEST BLOB IS WRITTEN. The oracle stores only a config blob and calls
#     add_to_index (build.rs:429-452). In this store that produces an image that
#     silently VANISHES: `image_store_load_index` reconstructs every Image from
#     its manifest blob and skips any descriptor whose manifest is missing. The
#     build would report success and `stiva images` would not list it.
#
#  3. `architecture` and `os` ARE EMITTED. The oracle's `OciImageConfig`
#     (build.rs:197-203) has exactly two fields, `config` and `rootfs` — both
#     platform keys are absent, and both are REQUIRED by the image-spec.
#
#  4. RUN STEPS ARE REFUSED, not faked. The oracle's `build_run_layer`
#     (build.rs:475) does not run anything: it writes a marker file
#     `.stiva/run/<idx>.cmd` containing the argv, and its own doc comment admits
#     this is a placeholder. Emitting that layer would produce an image
#     asserting a command ran when none did — a lie the user cannot detect from
#     the output. Refusing is the honest failure. (Executing them for real needs
#     an exec-into-an-intermediate-rootfs design, not just §D's exec primitive.)
#
#  5. `from_stage` IS REFUSED. The oracle's (build.rs:353-389) copies from
#     `<context>/<stage_name>` if that directory happens to exist and silently
#     skips otherwise; `spec.stages` is parsed and then never read by
#     build_image at all. There is no multi-stage build to port.
#
# Plus one hardening divergence: a COPY `source` may not be absolute or contain
# a `..` component. The oracle joins it straight onto the context dir, so a
# Stivafile from an untrusted repository can copy `/etc/shadow` into an image
# the user then pushes to a public registry.

# Ceiling on ONE layer's UNCOMPRESSED tar bytes, refused loudly rather than
# discovered as an OOM. 256 MiB.
#
# WHAT THIS DOES NOT BOUND, stated precisely because the number reads more
# protective than it is. By the time it is checked, `_stor_tar_collect` has
# ALREADY read every file in the context into the arena — so the check does not
# bound the collect pass. Nor does it bound the tar buffer or the gzip
# destination directly: those are sized from the assembled archive, and the
# check merely happens before them. What it actually guarantees is that a
# context whose PAYLOAD exceeds the ceiling is refused before those two
# allocations are attempted. `_stor_tar_bytes` carries its own 16 GiB backstop
# and a null-alloc check for the rest. See storage.cyr's IN-MEMORY CAVEAT; there
# is also no `free`, so a multi-step build accumulates.
var _BLD_MAX_LAYER_BYTES = 268435456;

# Total payload bytes across a TarEntry vec (headers excluded — this bounds the
# data, and the per-entry 512-byte headers are bounded by the entry count).
#[must_use]
fn _bld_entries_bytes(entries) {
    var total = 0;
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e: TarEntry = vec_get(entries, i);
        total = total + e.size;
        i = i + 1;
    }
    return total;
}

# ── copy-source fingerprint (cache invalidation) ──────────
#
# `build_cache_key` hashes `base_digest : index : step_json`, and a copy step's
# JSON is `{"type":"copy","source":"app","destination":"/app"}` — the source's
# CONTENT appears nowhere in it. So editing a file in the build context does not
# invalidate the cache and the next build silently ships the previous layer.
#
# That is inherited (`rust-old/src/build.rs:615` has the same shape) and it is
# not theoretical: it was caught here by a rebuilt binary that never reached the
# image, surfacing much later as runc reporting `stat /app/x: no such file or
# directory` for a file the user could see in their context.
#
# The fingerprint is METADATA ONLY — path, mode, uid, gid, size, mtime to the
# nanosecond — so it costs one lstat per entry and never reads file contents.
# Reading them would cost as much as rebuilding the layer, which is what the
# cache exists to avoid.
#
# LIMIT, stated because a cache that is quietly wrong is worse than none: an
# edit that preserves path, size, mode, ownership AND nanosecond mtime will not
# invalidate. Deleting `{root}/cache` forces a full rebuild.
#
# The combiner is order-INDEPENDENT (sum + xor + count over a per-entry FNV-1a)
# because `getdents64` order is filesystem-dependent; a sort would be stable but
# costs a full materialisation of the entry list for something that only feeds a
# cache key.
var _BLD_FNV_OFFSET = 14695981039346656037;
var _BLD_FNV_PRIME = 1099511628211;

#[must_use]
fn _bld_fnv1a(s, len) {
    var h = _BLD_FNV_OFFSET;
    var i = 0;
    while (i < len) {
        h = h ^ load8(s + i);
        h = h * _BLD_FNV_PRIME;
        i = i + 1;
    }
    return h;
}

# Walk `abs_dir`, folding each entry's metadata into the 3-cell accumulator
# `acc` (sum @0, xor @8, count @16). Recurses into real directories only —
# never through a symlink, matching `_stor_tar_collect`.
fn _bld_fp_walk(abs_dir, rel_prefix, acc, depth) {
    if (depth > 64) {
        # Past the cap, perturb the accumulator instead of returning quietly.
        # Silently skipping made every tree deeper than 64 levels fingerprint
        # IDENTICALLY regardless of what changed down there, so an edit below
        # the cap served a stale cached layer. A constant nudge does not
        # identify WHAT changed, but it guarantees a deep tree never collides
        # with the same tree truncated — and the cache's job is only to notice
        # that something differs.
        store64(acc, load64(acc) + 1);
        store64(acc + 16, load64(acc + 16) + 1);
        return 0;
    }
    var fd = sys_open(abs_dir, 65536, 0);          # O_DIRECTORY
    if (fd < 0) { return 0; }
    var buf = alloc(4096);
    var sb = alloc(144);
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents64(fd, buf, 4096);
        if (n <= 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var reclen = load16(buf + pos + 16);
                var name = buf + pos + 19;
                var skip = 0;
                if (load8(name) == 46) {
                    if (load8(name + 1) == 0) { skip = 1; }
                    if (load8(name + 1) == 46) { if (load8(name + 2) == 0) { skip = 1; } }
                }
                if (skip == 0) {
                    var named = _stor_dup(name);
                    var abs_child = _stor_join(abs_dir, named);
                    var rel_child = named;
                    if (strlen(rel_prefix) > 0) {
                        rel_child = _stor_cat2(_stor_cat2(rel_prefix, "/"), named);
                    }
                    if (sys_lstat(abs_child, sb) == 0) {
                        var mode = load64(sb + 24) & 65535;
                        var uid = (load64(sb + 24) >> 32) & 4294967295;
                        var gid = load64(sb + 32) & 4294967295;
                        var size = load64(sb + 48);
                        var mts = load64(sb + 88);             # st_mtime.tv_sec
                        var mtn = load64(sb + 96);             # st_mtime.tv_nsec
                        var eb = str_builder_new();
                        str_builder_add_cstr(eb, rel_child);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, mode);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, uid);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, gid);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, size);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, mts);
                        str_builder_add_cstr(eb, "|");
                        str_builder_add_int(eb, mtn);
                        var es = str_builder_build(eb);
                        var h = _bld_fnv1a(str_data(es), str_len(es));
                        store64(acc, load64(acc) + h);
                        store64(acc + 8, load64(acc + 8) ^ h);
                        store64(acc + 16, load64(acc + 16) + 1);
                        if ((mode & 61440) == 16384) {         # S_IFDIR
                            _bld_fp_walk(abs_child, rel_child, acc, depth + 1);
                        }
                    }
                }
                pos = pos + reclen;
            }
        }
    }
    sys_close(fd);
    return 0;
}

# "<sum>:<xor>:<count>" for the copy source at `context_dir/source`, or "absent"
# when it cannot be stat'ed. A source that appears and a source that vanishes
# must yield different keys, so "absent" is a value rather than an error.
#[must_use]
fn _bld_source_fingerprint(context_dir, source) {
    var path = _img_cat3(context_dir, "/", source);
    var sb = alloc(144);
    if (sys_lstat(path, sb) != 0) { return "absent"; }
    var acc = alloc(24);
    store64(acc, 0);
    store64(acc + 8, 0);
    store64(acc + 16, 0);
    var mode = load64(sb + 24) & 65535;
    if ((mode & 61440) == 16384) {
        # Fold the source root's OWN metadata in, not just its children's.
        # `_bld_fp_walk` starts INSIDE the directory, so a chmod/chown of the
        # root itself changed nothing in the fingerprint and served a stale
        # layer — even though the tar records that mode on the root's entry.
        var rb = str_builder_new();
        str_builder_add_cstr(rb, ".");
        str_builder_add_cstr(rb, "|");
        str_builder_add_int(rb, mode);
        str_builder_add_cstr(rb, "|");
        str_builder_add_int(rb, (load64(sb + 24) >> 32) & 4294967295);
        str_builder_add_cstr(rb, "|");
        str_builder_add_int(rb, load64(sb + 32) & 4294967295);
        var rs = str_builder_build(rb);
        var rh = _bld_fnv1a(str_data(rs), str_len(rs));
        store64(acc, rh);
        store64(acc + 8, rh);
        store64(acc + 16, 1);
        _bld_fp_walk(path, "", acc, 0);
    } else {
        var eb = str_builder_new();
        str_builder_add_int(eb, mode);
        str_builder_add_cstr(eb, "|");
        str_builder_add_int(eb, load64(sb + 48));              # size
        str_builder_add_cstr(eb, "|");
        str_builder_add_int(eb, load64(sb + 88));              # mtime sec
        str_builder_add_cstr(eb, "|");
        str_builder_add_int(eb, load64(sb + 96));              # mtime nsec
        var es = str_builder_build(eb);
        var h = _bld_fnv1a(str_data(es), str_len(es));
        store64(acc, h);
        store64(acc + 8, h);
        store64(acc + 16, 1);
    }
    var ob = str_builder_new();
    str_builder_add_int(ob, load64(acc));
    str_builder_add_cstr(ob, ":");
    str_builder_add_int(ob, load64(acc + 8));
    str_builder_add_cstr(ob, ":");
    str_builder_add_int(ob, load64(acc + 16));
    return str_cstr(str_builder_build(ob));
}

# The cache key for a COPY step: the oracle's key with the source fingerprint
# folded in. Kept as a separate function from `build_cache_key` so the oracle's
# key stays byte-identical for the step types whose JSON really does capture
# everything that affects the layer.
#[must_use]
fn build_copy_cache_key(base_digest, step_index, step, context_dir, source) {
    var base = build_cache_key(base_digest, step_index, step);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, ":");
    str_builder_add_cstr(sb, _bld_source_fingerprint(context_dir, source));
    var input = str_builder_build(sb);
    return sha256_digest(str_data(input), str_len(input));
}

# Reject a COPY `source` that escapes the build context: absolute, empty, or
# carrying a `..` path component. Returns 1 when the path is safe.
#
# Component-wise, not a substring scan — a file legitimately named `..foo` or
# `a..b` must not be refused.
#[must_use]
fn _bld_source_is_safe(source) {
    if (source == 0) { return 0; }
    var n = strlen(source);
    if (n == 0) { return 0; }
    if (load8(source) == 47) { return 0; }         # absolute
    var i = 0;
    var start = 0;
    while (i <= n) {
        var c = 0;
        if (i < n) { c = load8(source + i); }
        if (c == 47 || i == n) {
            if (i - start == 2) {
                if (load8(source + start) == 46) {
                    if (load8(source + start + 1) == 46) { return 0; }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

# 1 when ANY component of `context_dir/source` is a symlink.
#
# The companion to `_bld_source_is_safe`'s lexical check: that one rejects a path
# that spells an escape, this one rejects a path that walks through one. Every
# prefix is `lstat`ed — `lstat`, not `stat`, because `stat` is exactly the call
# that follows the link we are trying to detect.
#
# The CONTEXT DIR ITSELF is not checked: the user names it (`-c`), so a symlinked
# context is their own choice, the same way `-c /some/link` would be. Only the
# step-supplied `source`, which comes out of the Stivafile, is constrained.
#
# Refusing rather than resolving is deliberate. Resolving and then re-checking
# containment would be TOCTOU-racy (the link can change between the check and
# `_stor_tar_collect`'s open) and would silently change which bytes land in the
# layer. A build that names a symlinked path should fail loudly.
#[must_use]
fn _bld_path_has_symlink(context_dir, source) {
    var n = strlen(source);
    var sb = alloc(144);
    var i = 0;
    while (i <= n) {
        var c = 0;
        if (i < n) { c = load8(source + i); }
        if (c == 47 || i == n) {
            if (i > 0) {
                var prefix = _img_slice(source, 0, i);
                var full = _img_cat3(context_dir, "/", prefix);
                if (sys_lstat(full, sb) == 0) {
                    if ((load64(sb + 24) & 61440) == 40960) { return 1; }   # S_IFLNK
                }
            }
            # A trailing '/' makes the kernel resolve the FINAL component too,
            # which is how `source = "evil/"` turned a symlink-to-directory into
            # a walked tree. Stopping at the last real component covers it,
            # because the component before the slash has already been checked.
        }
        i = i + 1;
    }
    return 0;
}

# Strip a leading '/' from a COPY destination (rust-old build.rs:531-534 —
# tar member names are relative). Also strips a trailing '/' so the caller
# controls where separators go.
#[must_use]
fn _bld_dest_prefix(destination) {
    if (destination == 0) { return ""; }
    var s = destination;
    while (load8(s) == 47) { s = s + 1; }
    var n = strlen(s);
    while (n > 0) {
        if (load8(s + n - 1) != 47) { break; }
        n = n - 1;
    }
    return _img_slice(s, 0, n);
}

# Build one COPY step's gzip layer. Returns the gzip buffer (its length in
# `out_len`, the UNCOMPRESSED tar digest in `out_diff`), or 0 on failure with
# the detail already printed.
#
# The uncompressed digest is captured here rather than recomputed later because
# it is the ONLY point at which the uncompressed bytes exist — the blob store
# holds the compressed layer, so a diff_id derived after the fact would have to
# gunzip it back.
# Every check a COPY step must pass before ANY of its paths are touched.
# Returns 1 when safe; prints the reason and returns 0 otherwise.
#
# Called from the driver before the cache key is computed AND from
# build_copy_layer, because the latter is also reachable directly (tests, and
# any future caller). Both are cheap.
#[must_use]
fn _bld_copy_step_is_safe(context_dir, source, destination) {
    if (_bld_source_is_safe(source) == 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE,
          _img_cat2("copy source must be relative to the build context and free of '..': ", source));
        return 0;
    }
    # A lexical check is NOT enough, and believing it was is what made the
    # hardening ineffective. `..` rejection stops a path that SPELLS an escape;
    # it does nothing about one that WALKS through a symlink:
    #
    #     ln -s / ctx/vendor          + source = "vendor/etc/hostname"
    #     ln -s /home/u/.ssh ctx/evil + source = "evil/"     (trailing slash!)
    #
    # Both were verified reading host files into an image the user then pushes.
    # Nothing downstream stops them: `sys_lstat` resolves every component but the
    # last (and a trailing '/' makes it resolve that one too), and
    # `_stor_tar_collect` opens with O_DIRECTORY, which follows unconditionally.
    if (_bld_path_has_symlink(context_dir, source) == 1) {
        stiva_err_print(STIVA_ERR_INVALID_STATE,
          _img_cat2("copy source traverses a symlink, which can leave the build context: ", source));
        return 0;
    }
    # The DESTINATION needs the same `..` rejection. `_bld_dest_prefix` only
    # strips leading and trailing slashes, so `destination = "/../../etc"`
    # produced tar members named `../../etc/...`. stiva's own extractor discards
    # those, so the layer is merely useless here — but the layer is PUSHABLE, and
    # another runtime's extractor may not be as careful. Refusing to build it is
    # the only place that decision is ours to make.
    if (_bld_dest_is_safe(destination) == 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE,
          _img_cat2("copy destination must be free of '..': ", destination));
        return 0;
    }
    return 1;
}

# 1 when `destination` carries no `..` component (component-wise, so `..foo` is
# fine). An absolute destination IS allowed — `_bld_dest_prefix` strips the
# leading '/', which is the documented form.
#[must_use]
fn _bld_dest_is_safe(destination) {
    if (destination == 0) { return 1; }            # absent -> rootfs root
    var n = strlen(destination);
    var i = 0;
    var start = 0;
    while (i <= n) {
        var c = 0;
        if (i < n) { c = load8(destination + i); }
        if (c == 47 || i == n) {
            if (i - start == 2) {
                if (load8(destination + start) == 46) {
                    if (load8(destination + start + 1) == 46) { return 0; }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

fn build_copy_layer(context_dir, source, destination, out_len, out_diff) {
    if (_bld_copy_step_is_safe(context_dir, source, destination) == 0) { return 0; }
    var src_path = _img_cat3(context_dir, "/", source);
    var sb = alloc(144);
    if (sys_lstat(src_path, sb) != 0) {
        stiva_err_print(STIVA_ERR_STORAGE, _img_cat2("copy source not found: ", src_path));
        return 0;
    }
    var st_mode = load64(sb + 24) & 65535;
    var typ = st_mode & 61440;                      # S_IFMT
    var perms = st_mode & 4095;
    var uid = (load64(sb + 24) >> 32) & 4294967295;
    var gid = load64(sb + 32) & 4294967295;

    var dest_prefix = _bld_dest_prefix(destination);
    var entries = vec_new();
    if (typ == 16384) {                             # S_IFDIR
        # `_stor_tar_collect` emits CHILDREN only, so the destination directory
        # itself needs an explicit entry — without it `copy ./app -> /app`
        # produces `app/start.sh` with no `app/` member, and a reader that
        # creates parents implicitly loses the directory's real mode.
        if (strlen(dest_prefix) > 0) {
            vec_push(entries, _tar_entry_new(_img_cat2(dest_prefix, "/"), 53, perms, uid, gid, 0, 0));
        }
        _stor_tar_collect(src_path, dest_prefix, entries);
    } else {
        if (typ != 32768) {                         # S_IFREG
            stiva_err_print(STIVA_ERR_INVALID_STATE,
              _img_cat2("copy source is neither a regular file nor a directory: ", src_path));
            return 0;
        }
        if (strlen(dest_prefix) == 0) {
            stiva_err_print(STIVA_ERR_INVALID_STATE, "copy destination cannot be the rootfs root for a file source");
            return 0;
        }
        var fc = alloc(8);
        var data = _img_read_file(src_path, fc);
        if (data == 0) {
            stiva_err_print(STIVA_ERR_STORAGE, _img_cat2("cannot read copy source: ", src_path));
            return 0;
        }
        vec_push(entries, _tar_entry_new(dest_prefix, 48, perms, uid, gid, load64(fc), data));
    }

    if (vec_len(entries) == 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, _img_cat2("copy source produced no entries: ", src_path));
        return 0;
    }
    if (_bld_entries_bytes(entries) > _BLD_MAX_LAYER_BYTES) {
        stiva_err_print(STIVA_ERR_STORAGE, "copy layer exceeds the 256 MiB per-layer ceiling");
        return 0;
    }

    var tc = alloc(8);
    var tarbuf = _stor_tar_bytes(entries, tc);
    if (tarbuf == 0) { return 0; }        # detail printed by _stor_tar_bytes
    var tarlen = load64(tc);
    store64(out_diff, sha256_digest(tarbuf, tarlen));

    var gzcap = tarlen + tarlen / 50 + 8192;
    var gzbuf = alloc(gzcap);
    # Streaming encoder, never the batch `gzip_compress` — the latter duplicates
    # bytes at every 1 MiB block boundary (see `_stor_gzip_compress`).
    var gzlen = _stor_gzip_compress(tarbuf, tarlen, gzbuf, gzcap);
    if (gzlen < 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "failed to gzip copy layer");
        return 0;
    }
    store64(out_len, gzlen);
    return gzbuf;
}

# Resolve the base image named by `base`. LOCAL FIRST, then the registry.
#
# DIVERGENCE: the oracle pulls unconditionally (build.rs:272), so a build
# against a base already in the store still needs the network and still races
# the registry's mutable tag. Local-first makes an offline rebuild reproducible
# and matches how the facade's `run` resolves. A pull still happens when the
# base is absent AND a client was supplied.
fn _bld_resolve_base(store, client, base) {
    var im = image_store_find(store, base);
    if (im != 0) { return im; }
    var ref = image_ref_parse(base);
    if (ref == 0) {
        stiva_err_print(STIVA_ERR_INVALID_REFERENCE, base);
        return 0;
    }
    # `base` as written ("alpine:3.19") and its canonical form
    # ("docker.io/library/alpine:3.19") are both legitimate index keys.
    im = image_store_find(store, image_ref_full_ref(ref));
    if (im != 0) { return im; }
    if (client == 0) {
        stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND,
          _img_cat2("base image not in the local store and no registry client is configured: ", base));
        return 0;
    }
    return image_store_pull(client, store, ref);
}

# ── layer digest → diff_id sidecar ───────────────────────
#
# A cached layer is reusable only if its UNCOMPRESSED digest is also known, and
# that is not recoverable from the stored blob without gunzipping it. The oracle
# never faced this because its diff_ids are the compressed digests it already
# has — which is the spec bug divergence 1 fixes.
#
# Keyed by LAYER digest rather than by cache key, because the mapping is a
# property of the blob: two different steps that happen to produce identical
# bytes share one entry, and it stays valid when a cache key is invalidated.

# "{root}/cache/diffid/{hex}", or 0 for a malformed layer digest (fails closed,
# like `_img_blob_path` — this string comes back off disk).
#[must_use]
fn _bld_diffid_path(store, layer_digest) {
    if (digest_is_valid(layer_digest) == 0) { return 0; }
    var dir = _img_cat2(image_store_root(store), "/cache/diffid/");
    return _img_cat2(dir, digest_hex(layer_digest));
}

# Record a layer's uncompressed digest. Returns 0 on success, -1 on failure —
# best-effort, exactly like `record_build_cache`: a failure here costs a rebuild
# next time, never correctness.
fn _bld_record_diff_id(store, layer_digest, diff_id) {
    var path = _bld_diffid_path(store, layer_digest);
    if (path == 0) { return 0 - 1; }
    var root = image_store_root(store);
    sys_mkdir(_img_cat2(root, "/cache"), 493);            # 0o755, idempotent
    sys_mkdir(_img_cat2(root, "/cache/diffid"), 493);
    if (file_write_all(path, diff_id, strlen(diff_id)) < 0) { return 0 - 1; }
    return 0;
}

# A layer's recorded uncompressed digest, or 0 when absent/malformed.
#[must_use]
fn _bld_cached_diff_id(store, layer_digest) {
    var path = _bld_diffid_path(store, layer_digest);
    if (path == 0) { return 0; }
    if (file_exists(path) == 0) { return 0; }
    var buf = alloc(128);
    var n = file_read_all(path, buf, 127);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);                                   # file_read_all does not NUL-terminate
    if (digest_is_valid(buf) == 0) { return 0; }
    return buf;
}

# Reuse a cached layer for `cache_key`, or 0 for a miss. The blob size lands in
# `out_size` and its uncompressed digest in `out_diff`.
#
# EVERY failure mode here is a MISS, never an error: a truncated cache file, a
# blob swept by `gc`, a missing diff_id sidecar, an entry written before the
# sidecar existed. The worst case is rebuilding a layer that was already cached,
# which is the correct outcome for a cache we cannot fully trust. Making any of
# these fatal would turn `rm -rf {root}/cache` into required user knowledge.
#
# Two guards the oracle does not have — it trusts the cache file verbatim
# (build.rs:286-299), so a hand-edited entry becomes a blob path.
# `_img_blob_path` already fails closed on a malformed digest, so this was a
# silent miss rather than an escape; validating here makes it a deliberate one.
#
# It does NOT re-hash the blob. Verifying content on every hit would re-read
# every layer of every build; that is `verify_integrity`'s job, and the store
# root is stiva-owned.
fn _bld_cache_hit(store, cache_key, out_size, out_diff) {
    var buf = alloc(128);
    var n = check_build_cache(store, cache_key, buf, 127);
    if (n <= 0) { return 0; }
    # `check_build_cache` returns a byte count and does NOT NUL-terminate.
    store8(buf + n, 0);
    if (digest_is_valid(buf) == 0) { return 0; }
    if (image_store_has_blob(store, buf) == 0) { return 0; }
    var diff_id = _bld_cached_diff_id(store, buf);
    if (diff_id == 0) { return 0; }
    var path = _img_blob_path(image_store_root(store), buf);
    if (path == 0) { return 0; }
    var sb = alloc(144);
    if (sys_lstat(path, sb) != 0) { return 0; }
    store64(out_size, load64(sb + 48));                   # st_size
    store64(out_diff, diff_id);
    return buf;
}

# Build an image from a parsed BuildSpec (rust-old: build_image).
#
#   spec        BuildSpec*
#   store       ImageStore*
#   client      RegistryClient*, or 0 for a strictly-local build
#   context_dir cstr — the directory COPY sources resolve against
#
# Returns the Image*, or 0 on failure with the detail already printed.
fn build_image(spec, store, client, context_dir) {
    if (spec == 0 || store == 0) { return 0; }
    var sp: BuildSpec = spec;
    var idef: ImageDef = sp.image;
    sakshi_info("starting image build", strlen("starting image build"));

    # ── 1. Base image ──
    var base = _bld_resolve_base(store, client, idef.base);
    if (base == 0) { return 0; }
    var base_diff_ids = _il_config_diff_ids(store, base);
    var base_layers = _img_layers(base);
    # A base with layers but no readable diff_ids would yield a config whose
    # rootfs omits every inherited layer — an image that unpacks to more than it
    # claims. Refuse rather than emit it.
    if (vec_len(base_layers) > 0) {
        if (vec_len(base_diff_ids) != vec_len(base_layers)) {
            stiva_err_print(STIVA_ERR_INVALID_STATE,
              "base image config has no usable rootfs.diff_ids; cannot derive from it");
            return 0;
        }
    }

    # ── 2. Steps ──
    var new_layers = vec_new();
    var new_diff_ids = vec_new();
    var env_vars = vec_new();
    var labels = vec_new();                         # alternating k, v
    var step_workdir = 0;
    # The cache key chains: each step's key covers the digest of the layer the
    # previous step produced, so an early change invalidates everything after it
    # (rust-old: `running_digest`).
    var running_digest = _img_id(base);

    var steps = sp.steps;
    var nsteps = vec_len(steps);
    var idx = 0;
    while (idx < nsteps) {
        var st: BuildStep = vec_get(steps, idx);
        var kind = st.kind;

        if (kind == BUILD_STEP_RUN) {
            stiva_err_print(STIVA_ERR_INVALID_STATE,
              _img_cat2("run steps are not executed by this build: the oracle emitted a marker file ",
                "rather than running the command, so the layer would assert work that never happened"));
            return 0;
        }
        if (kind == BUILD_STEP_FROM_STAGE) {
            stiva_err_print(STIVA_ERR_INVALID_STATE,
              "from_stage is not supported: multi-stage builds are not implemented");
            return 0;
        }

        if (kind == BUILD_STEP_ENV) {
            vec_push(env_vars, _img_cat3(st.key, "=", st.value));
        }
        if (kind == BUILD_STEP_WORKDIR) {
            step_workdir = st.source;
        }
        if (kind == BUILD_STEP_LABEL) {
            vec_push(labels, st.key);
            vec_push(labels, st.value);
        }

        if (kind == BUILD_STEP_COPY) {
            # Validate BEFORE the cache key, not just inside build_copy_layer.
            # The key's fingerprint WALKS the source tree, so on a cache miss the
            # checks in build_copy_layer would run only after an escaping path had
            # already been traversed (and its metadata folded into a key).
            if (_bld_copy_step_is_safe(context_dir, st.source, st.destination) == 0) {
                return 0;                     # detail printed by the validator
            }
            # Content-aware: the step JSON alone would let an edited context
            # reuse the previous layer. See _bld_source_fingerprint.
            var cache_key = build_copy_cache_key(running_digest, idx, vec_get(steps, idx),
              context_dir, st.source);
            var size_cell = alloc(8);
            var cdiff_cell = alloc(8);
            var cached = _bld_cache_hit(store, cache_key, size_cell, cdiff_cell);
            if (cached != 0) {
                sakshi_info("using cached layer", strlen("using cached layer"));
                vec_push(new_layers, layer_new(cached, load64(size_cell), media_oci_layer()));
                vec_push(new_diff_ids, load64(cdiff_cell));
                running_digest = cached;
            } else {
                var len_cell = alloc(8);
                var diff_cell = alloc(8);
                var gz = build_copy_layer(context_dir, st.source, st.destination, len_cell, diff_cell);
                if (gz == 0) { return 0; }
                var gzlen = load64(len_cell);
                var diff_id = load64(diff_cell);
                var digest = store_layer(store, gz, gzlen);
                if (digest == 0) {
                    stiva_err_print(STIVA_ERR_STORAGE, "failed to store copy layer blob");
                    return 0;
                }
                var _rc = record_build_cache(store, cache_key, digest);
                var _rd = _bld_record_diff_id(store, digest, diff_id);
                vec_push(new_layers, layer_new(digest, gzlen, media_oci_layer()));
                vec_push(new_diff_ids, diff_id);
                running_digest = digest;
            }
        }
        idx = idx + 1;
    }

    # ── 3. OCI image config ──
    var all_layers = vec_new();
    var all_diff_ids = vec_new();
    var bi = 0;
    var bn = vec_len(base_layers);
    while (bi < bn) {
        vec_push(all_layers, vec_get(base_layers, bi));
        vec_push(all_diff_ids, vec_get(base_diff_ids, bi));
        bi = bi + 1;
    }
    var ni = 0;
    var nn = vec_len(new_layers);
    while (ni < nn) {
        vec_push(all_layers, vec_get(new_layers, ni));
        vec_push(all_diff_ids, vec_get(new_diff_ids, ni));
        ni = ni + 1;
    }

    var bc: BuildConfig = sp.config;
    var exposed = vec_new();
    var ei = 0;
    var en = vec_len(bc.expose);
    while (ei < en) {
        var pb = str_builder_new();
        str_builder_add_int(pb, vec_get(bc.expose, ei));
        str_builder_add_cstr(pb, "/tcp");
        vec_push(exposed, str_cstr(str_builder_build(pb)));
        ei = ei + 1;
    }
    # [config].workdir wins over a `workdir` step (rust-old build.rs:412-416).
    var workdir = bc.workdir;
    if (workdir == 0) { workdir = step_workdir; }

    var arch = normalize_arch("x86_64");
    var cfg_obj = oci_config_object_jv(env_vars, 0, bc.entrypoint, workdir, bc.user, exposed, labels);
    var cfg_s = json_v_build(oci_config_build(arch, "linux", 0, cfg_obj, all_diff_ids, 0));
    var config_digest = sha256_digest(str_data(cfg_s), str_len(cfg_s));
    if (image_store_store_blob(store, config_digest, str_data(cfg_s), str_len(cfg_s)) == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "failed to store config blob");
        return 0;
    }

    # ── 4. OCI manifest blob (absent in the oracle — divergence 2) ──
    var layer_descs = vec_new();
    var total_size = 0;
    var li = 0;
    var ln = vec_len(all_layers);
    while (li < ln) {
        var lay: Layer = vec_get(all_layers, li);
        vec_push(layer_descs, descriptor_new(lay.media_type, lay.digest, lay.size_bytes));
        total_size = total_size + lay.size_bytes;
        li = li + 1;
    }
    var man = oci_manifest_new(descriptor_new(media_oci_config(), config_digest, str_len(cfg_s)), layer_descs);
    var mm: OciManifest = man;
    mm.media_type = media_oci_manifest();
    var man_s = json_v_build(oci_manifest_to_jv(man));
    var manifest_digest = sha256_digest(str_data(man_s), str_len(man_s));
    if (image_store_store_blob(store, manifest_digest, str_data(man_s), str_len(man_s)) == 0) {
        stiva_err_print(STIVA_ERR_STORAGE, "failed to store manifest blob");
        return 0;
    }

    # ── 5. Image record + index ──
    # The output reference is a TAG, so its digest slot stays EMPTY.
    #
    # The oracle sets `digest: Some(config_digest)` (build.rs:441). Under this
    # store's digest-aware index dedup that makes every build a PINNED add,
    # which replaces only an entry with the same manifest digest — so a rebuild
    # appends a second `local/<name>:<tag>` instead of moving the tag, and
    # `run`/`find` (first-match-wins) keep resolving the ORIGINAL image. The
    # rebuild appears to succeed and changes nothing, which is precisely how it
    # was found: an edited context produced a new image that nothing could
    # reach.
    #
    # A tag is a mutable pointer and must move on rebuild. Nothing is lost: the
    # image's own id IS the config digest. `image_import` already does this.
    var out_ref = image_ref_new("local", idef.name, idef.tag, 0);
    var image = image_new(config_digest, out_ref, total_size, all_layers, 0);
    _img_set_manifest_digest(image, manifest_digest);
    if (image_store_add_to_index(store, image) == 0) {
        stiva_err_print(STIVA_ERR_IO, "failed to update image index");
        return 0;
    }
    sakshi_info("build complete", strlen("build complete"));
    return image;
}

# --- encrypted.cyr ---

# stiva — encrypted & verified container storage (LUKS + dm-verity + OCI layer crypto)
# Ported from rust-old/src/encrypted.rs.
#
# The Rust module is entirely feature-gated on `encrypted`. WITHOUT that
# feature (the default build), every volume/crypto entry point returns an
# `Err(StivaError::Storage/Encryption(...))` and the availability probes
# return false. The Cyrius build has no `encrypted` feature yet, so this
# port faithfully mirrors the `#[cfg(not(feature = "encrypted"))]` arm:
# the disabled entry points return their error sentinel and carry the exact
# Rust message via stiva_err_print, matching the default build's behaviour.
#
# What ports fully (NOT feature-gated in Rust — active on every build):
#   struct LuksVolumeConfig / VerityVolumeConfig / OpenVolume
#   enum  KeySource (File | EnvVar) + key_source_new_file / _env
#   is_encrypted_media_type / strip_encrypted_suffix   (pure cstr)
#   load_key                                           (file read / env+hex)
#   cryptsetup_available / veritysetup_available       (false, no feature)
#
# What is DEFERRED to the `encrypted` feature (agnodrm LUKS/verity bundle
# calls + an AES-256-GCM codec) — see the block at the bottom:
#   stiva_luks_open / stiva_luks_close / stiva_luks_format
#   stiva_verity_open / stiva_verity_close / stiva_verity_format / make_verity_config
#   decrypt_layer / encrypt_layer / rand_nonce
# In the default build these return the disabled-path error, ported below.
# (LUKS/verity entry points carry a `stiva_` prefix because the crypto
# stdlib lib/sigil.cyr already mints global `luks_open/close/format`.)
#
# Error mapping (mirrors error.cyr): Rust `Err(StivaError::Storage(String))`
# → sentinel + STIVA_ERR_STORAGE; `Err(StivaError::Encryption(String))` →
# sentinel + STIVA_ERR_ENCRYPTION. The context string is carried by the
# caller via stiva_err_print(code, detail).

# ── LUKS volume configuration (rust-old: struct LuksVolumeConfig) ──
# Fields hold NUL-terminated cstr pointers except size_mb (integer MB).
struct LuksVolumeConfig {
    image_path;
    mapper_name;
    mount_point;
    size_mb;
}

#[must_use]
fn luks_volume_config_new(image_path, mapper_name, mount_point, size_mb) {
    var p = alloc(32);
    var v: LuksVolumeConfig = p;
    v.image_path = image_path;
    v.mapper_name = mapper_name;
    v.mount_point = mount_point;
    v.size_mb = size_mb;
    return p;
}

# ── dm-verity configuration (rust-old: struct VerityVolumeConfig) ──
struct VerityVolumeConfig {
    data_path;
    hash_path;
    root_hash;
    mapper_name;
}

#[must_use]
fn verity_volume_config_new(data_path, hash_path, root_hash, mapper_name) {
    var p = alloc(32);
    var v: VerityVolumeConfig = p;
    v.data_path = data_path;
    v.hash_path = hash_path;
    v.root_hash = root_hash;
    v.mapper_name = mapper_name;
    return p;
}

# ── result of opening an encrypted/verified volume (rust-old: OpenVolume) ──
struct OpenVolume {
    dm_path;
    mapper_name;
}

#[must_use]
fn open_volume_new(dm_path, mapper_name) {
    var p = alloc(16);
    var v: OpenVolume = p;
    v.dm_path = dm_path;
    v.mapper_name = mapper_name;
    return p;
}

# ── KeySource — key material source for OCI layer crypto ──
# rust-old: enum KeySource { File(PathBuf), EnvVar(String) }.
# Prefixed ENCRYPTED_KEYSRC_* for global enum-member uniqueness (see error.cyr).
enum KeySource {
    ENCRYPTED_KEYSRC_FILE = 0;
    ENCRYPTED_KEYSRC_ENVVAR = 1;
}

# A KeySource value: a kind tag + a single cstr payload (the file path for
# File, the env-var name for EnvVar).
struct KeySourceVal {
    kind;
    value;
}

#[must_use]
fn key_source_new_file(path) {
    var p = alloc(16);
    var v: KeySourceVal = p;
    v.kind = ENCRYPTED_KEYSRC_FILE;
    v.value = path;
    return p;
}

#[must_use]
fn key_source_new_env(var_name) {
    var p = alloc(16);
    var v: KeySourceVal = p;
    v.kind = ENCRYPTED_KEYSRC_ENVVAR;
    v.value = var_name;
    return p;
}

# ── media-type helpers (rust-old: is_encrypted_media_type / strip) ──

# True (1) iff `media_type` ends with "+encrypted".
# rust-old: media_type.ends_with("+encrypted").
#[must_use]
#[inline]
fn is_encrypted_media_type(media_type) {
    var suffix = "+encrypted";
    var slen = strlen(suffix);
    var mlen = strlen(media_type);
    if (mlen < slen) { return 0; }
    return memeq(media_type + mlen - slen, suffix, slen);
}

# Strip the "+encrypted" suffix from a media type, returning a fresh cstr.
# If the suffix is absent, returns a fresh copy of the whole input.
# rust-old: media_type.strip_suffix("+encrypted").unwrap_or(media_type).
#[must_use]
#[inline]
fn strip_encrypted_suffix(media_type) {
    var mlen = strlen(media_type);
    var keep = mlen;
    if (is_encrypted_media_type(media_type) == 1) {
        keep = mlen - strlen("+encrypted");
    }
    var out = alloc(keep + 1);
    memcpy(out, media_type, keep);
    store8(out + keep, 0);
    return out;
}

# ── load_key (rust-old: load_key) ──
# Load raw key bytes from a KeySource. NOT feature-gated in Rust — active
# on every build.
#   File(path)   -> read the file's raw bytes.
#   EnvVar(name) -> read env var, trim, hex-decode.
# Returns the heap buffer pointer on success and writes the byte length
# through `out_len` (an i64 address). Returns 0 (null) on failure; the
# caller reports via stiva_err_print(STIVA_ERR_ENCRYPTION, detail).
#[must_use]
fn load_key(source, out_len) {
    store64(out_len, 0);
    var src: KeySourceVal = source;
    if (src.kind == ENCRYPTED_KEYSRC_FILE) {
        # std::fs::read(path) — read the whole key file.
        var buf = alloc(4096);
        var n = file_read_all(src.value, buf, 4096);
        if (n < 0) { return 0; }
        store64(out_len, n);
        return buf;
    }
    # EnvVar: std::env::var(var), trim, hex::decode.
    var hex = getenv(src.value);
    if (hex == 0) { return 0; }
    # .trim() — strip leading/trailing ASCII whitespace.
    var start = hex;
    while (load8(start) != 0 && _enc_is_ws(load8(start)) == 1) { start = start + 1; }
    var end = start + strlen(start);
    while (end > start && _enc_is_ws(load8(end - 1)) == 1) { end = end - 1; }
    var hlen = end - start;
    # hex::decode — requires even length; hex_decode returns 0 on failure.
    var bytes = hex_decode(start, hlen);
    if (bytes == 0) { return 0; }
    store64(out_len, hlen / 2);
    return bytes;
}

# True (1) iff `c` is ASCII whitespace (space, tab, LF, CR, VT, FF) — the
# set Rust's str::trim strips for the ASCII range used by hex keys.
#[must_use]
fn _enc_is_ws(c) {
    if (c == 32) { return 1; }
    if (c >= 9 && c <= 13) { return 1; }
    return 0;
}

# ── availability probes ──
# rust-old: with the `encrypted` feature these delegate to agnosys; without
# it they return false. The Cyrius default build has no feature → false.
#[must_use]
fn cryptsetup_available() {
    return 0;
}

#[must_use]
fn veritysetup_available() {
    return 0;
}

# ── disabled-feature entry points ──
# These mirror rust-old's `#[cfg(not(feature = "encrypted"))]` arms exactly:
# each returns the disabled error and carries the Rust message string. The
# `encrypted`-feature implementations (agnodrm + AES-GCM) are DEFERRED below.

# rust-old luks_open (no feature): Err(Storage("encrypted storage requires
# the 'encrypted' feature")). Returns 0 (null OpenVolume); caller reports via
# stiva_err_print(STIVA_ERR_STORAGE, "...requires the 'encrypted' feature").
#[must_use]
fn stiva_luks_open(config, passphrase) {
    return 0;
}

# rust-old luks_close (no feature): Err(Storage("encrypted storage requires the 'encrypted' feature")).
# Returns -1; caller: STIVA_ERR_STORAGE.
#[must_use]
fn stiva_luks_close(mapper_name) {
    return 0 - 1;
}

# rust-old luks_format (no feature): Err(Storage("encrypted storage requires the 'encrypted' feature")).
# Returns 0 (null path); caller: STIVA_ERR_STORAGE.
#[must_use]
fn stiva_luks_format(config, passphrase) {
    return 0;
}

# rust-old verity_open (no feature): Err(Storage("verified storage requires the 'encrypted' feature")).
# Returns 0 (null OpenVolume); caller: STIVA_ERR_STORAGE.
#[must_use]
fn stiva_verity_open(config) {
    return 0;
}

# rust-old verity_close (no feature): Err(Storage("verified storage requires the 'encrypted' feature")).
# Returns -1; caller: STIVA_ERR_STORAGE.
#[must_use]
fn stiva_verity_close(mapper_name) {
    return 0 - 1;
}

# rust-old verity_format (no feature): Err(Storage("verified storage requires the 'encrypted' feature")).
# Returns 0 (null hash); caller: STIVA_ERR_STORAGE.
#[must_use]
fn stiva_verity_format(data_path, hash_path) {
    return 0;
}

# rust-old decrypt_layer (no feature): Err(Encryption("image encryption requires the 'encrypted' feature")).
# Returns 0 (null); caller: STIVA_ERR_ENCRYPTION.
#[must_use]
fn decrypt_layer(data, data_len, key_source, out_len) {
    store64(out_len, 0);
    return 0;
}

# rust-old encrypt_layer (no feature): Err(Encryption("image encryption requires the 'encrypted' feature")).
# Returns 0 (null); caller: STIVA_ERR_ENCRYPTION.
#[must_use]
fn encrypt_layer(data, data_len, key_source, out_len) {
    store64(out_len, 0);
    return 0;
}

# ── DEFERRED (land with the `encrypted` feature — agnodrm bundle + AES-GCM) ──
# rust-old/src/encrypted.rs, under `#[cfg(feature = "encrypted")]`, also
# implements the following against agnosys (now agnodrm) and aes_gcm/getrandom.
# The default build never compiles these, and the Cyrius build has no
# `encrypted` feature yet, so the active paths above are the parity target.
# When the feature lands, wire these to lib/agnodrm.cyr + a Cyrius AES-256-GCM
# codec:
#   fn luks_open(config, passphrase) -> Result<OpenVolume>
#       agnosys::luks::LuksConfig { name, backing_path, size_mb, mount_point }
#       + LuksKey::from_passphrase + agnosys::luks::luks_open
#   fn luks_close(mapper_name) -> Result<()>        agnosys::luks::luks_close
#   fn luks_format(config, passphrase) -> Result<PathBuf>  agnosys::luks::luks_format
#   fn verity_open(config) -> Result<OpenVolume>    agnosys::dmverity::verity_open
#       (dm_path = "/dev/mapper/{mapper_name}")
#   fn verity_close(mapper_name) -> Result<()>      agnosys::dmverity::verity_close
#   fn verity_format(data_path, hash_path) -> Result<String>
#       agnosys::dmverity::verity_format(.., Sha256, None)
#   fn make_verity_config(config) -> agnosys::dmverity::VerityConfig
#       (serde round-trip: data_block_size/hash_block_size = 4096, Sha256)
#   fn decrypt_layer(data, key_source) -> Result<Vec<u8>>
#       AES-256-GCM; nonce = data[..12], ciphertext = data[12..]; key must be 32 bytes
#   fn encrypt_layer(data, key_source) -> Result<Vec<u8>>
#       AES-256-GCM; result = nonce(12) || ciphertext || tag; key must be 32 bytes
#   fn rand_nonce() -> [u8; 12]                     getrandom::fill (→ lib/random.cyr random_bytes)
# agnodrm exposes LUKS/verity via cryptsetup/veritysetup shells; AES-256-GCM
# is achievable via sigil's aes_gcm (this module is the no-`encrypted`-feature
# arm anyway); the crypto bodies just aren't wired — NOT a Cyrius gap.

# --- runtime.cyr ---

# stiva — OCI runtime execution: spec types, mounts, /proc parsing, CRIU probe.
# Ported from rust-old/src/runtime.rs.
#
# This module bridges container config to kavach for process isolation. The
# The heavy paths — kavach sandbox build/exec/spawn, nsenter subprocess
# execution, tar/gzip codecs, cgroup fs writes, the ExternalizationGate — are all
# ported. Only CRIU remains; see the block at the bottom and
# docs/development/roadmap.md v3.1.0 item 3.
#
# What is ported here (self-contained + already-ported deps only):
#   * The runtime spec value types: Namespace enum, SpecMount, RuntimeSpec,
#     ContainerExecResult, ProcessInfo, ContainerStats (+ constructors).
#   * standard_mounts()  — the fixed /proc,/sys,/dev,/dev/pts,/dev/shm list.
#   * volume_mounts(vols, rootless) — SpecMount conversion via storage.parse_volume.
#   * parse_ppid_from_stat(stat) — pure /proc/<pid>/stat PPID field parser.
#   * container_top(pid) / is_descendant_of / read_process_info — the /proc
#     process-tree walk (synchronous; the oracle marked it async).
#   * copy_into_container / copy_from_container / copy_dir_recursive — host<->rootfs
#     file/dir copy (fs recursion via storage's mkdir/read helpers).
#   * criu_available() — PATH scan for the `criu` binary.
#
# Enum members are namespaced RUNTIME_NS_* for global uniqueness (see error.cyr).

# ── Namespace ───────────────────────────
# Linux namespaces for container isolation (rust-old: enum Namespace).
enum Namespace {
    RUNTIME_NS_PID = 0;
    RUNTIME_NS_NET = 1;
    RUNTIME_NS_MOUNT = 2;
    RUNTIME_NS_UTS = 3;
    RUNTIME_NS_IPC = 4;
    RUNTIME_NS_USER = 5;
    RUNTIME_NS_CGROUP = 6;
}

# serde wire name for a Namespace. Rust derives the default serde encoding for
# the enum, which serializes each unit variant as its PascalCase name.
#[must_use]
fn namespace_name(ns) {
    if (ns == RUNTIME_NS_PID) { return "Pid"; }
    if (ns == RUNTIME_NS_NET) { return "Net"; }
    if (ns == RUNTIME_NS_MOUNT) { return "Mount"; }
    if (ns == RUNTIME_NS_UTS) { return "Uts"; }
    if (ns == RUNTIME_NS_IPC) { return "Ipc"; }
    if (ns == RUNTIME_NS_USER) { return "User"; }
    if (ns == RUNTIME_NS_CGROUP) { return "Cgroup"; }
    return "Unknown";
}

# ── SpecMount ───────────────────────────
# A mount entry in the runtime spec (rust-old: struct SpecMount).
#   source      : cstr host path, or 0 for virtual filesystems (Option<PathBuf>)
#   destination : cstr container path
#   mount_type  : cstr ("proc", "sysfs", "tmpfs", "bind", ...)
#   options     : vec of option cstrs (vec.cyr handle)
struct SpecMount {
    source;
    destination;
    mount_type;
    options;
}

fn spec_mount_new(source, destination, mount_type, options) {
    var m = alloc(32);
    var mm: SpecMount = m;
    mm.source = source;
    mm.destination = destination;
    mm.mount_type = mount_type;
    mm.options = options;
    return m;
}

# ── RuntimeSpec ──────────────────────────
# Full OCI runtime configuration generated from a container's config
# (rust-old: struct RuntimeSpec, 22 fields).
#
# Optional Rust fields map as follows:
#   Option<u64>/<u32> numeric limits → the value when set, else 0 = unset
#     (mirrors ContainerConfig's own "0 = unlimited" convention).
#   Option<String> (user/backend/seccomp_profile/agent_id/domainname) → cstr, 0 = None.
#   Option<u8> min_isolation_score → value 0..100, or -1 = None.
#   secrets/scan_policy → kavach handles (i64), 0 = none.
#   namespaces/mounts/command/env → vec.cyr handles.
#   bools (read_only_rootfs, rootless) → 1/0.
struct RuntimeSpec {
    rootfs;                  # cstr
    command;                 # vec of cstr
    env;                     # vec of "KEY=VALUE" cstr
    namespaces;              # vec of Namespace ints
    memory_limit_bytes;      # u64, 0 = unlimited
    cpu_shares;              # u64, 0 = default
    max_pids;                # u32, 0 = unlimited
    user;                    # cstr or 0
    workdir;                 # cstr
    read_only_rootfs;        # 1/0
    mounts;                  # vec of SpecMount*
    rootless;                # 1/0
    secrets;                 # vec of kavach SecretRef handles
    scan_policy;             # kavach ExternalizationPolicy handle, 0 = none
    timeout_ms;              # u64, 0 = no timeout
    backend;                 # cstr backend name or 0
    min_isolation_score;     # 0..100 or -1 = none
    io_max_bytes_per_sec;    # u64, 0 = unlimited
    seccomp_profile;         # cstr or 0
    agent_id;                # cstr or 0
    domainname;              # cstr or 0
}

fn runtime_spec_new() {
    var s = alloc(168);   # 21 fields * 8
    var ss: RuntimeSpec = s;
    ss.rootfs = 0;
    ss.command = 0;
    ss.env = 0;
    ss.namespaces = 0;
    ss.memory_limit_bytes = 0;
    ss.cpu_shares = 0;
    ss.max_pids = 0;
    ss.user = 0;
    ss.workdir = 0;
    ss.read_only_rootfs = 0;
    ss.mounts = 0;
    ss.rootless = 0;
    ss.secrets = 0;
    ss.scan_policy = 0;
    ss.timeout_ms = 0;
    ss.backend = 0;
    ss.min_isolation_score = 0 - 1;
    ss.io_max_bytes_per_sec = 0;
    ss.seccomp_profile = 0;
    ss.agent_id = 0;
    ss.domainname = 0;
    return s;
}

# ── ContainerExecResult ───────────────────────
# Result of executing a container command (rust-old: struct ContainerExecResult).
struct ContainerExecResult {
    exit_code;     # i32
    stdout;        # cstr
    stderr;        # cstr
    duration_ms;   # u64
    timed_out;     # 1/0
}

fn container_exec_result_new(exit_code, stdout, stderr, duration_ms, timed_out) {
    var r = alloc(40);
    var rr: ContainerExecResult = r;
    rr.exit_code = exit_code;
    rr.stdout = stdout;
    rr.stderr = stderr;
    rr.duration_ms = duration_ms;
    rr.timed_out = timed_out;
    return r;
}

# ── ProcessInfo ──────────────────────────
# A process entry from /proc inside a container's PID namespace
# (rust-old: struct ProcessInfo). `state` is a single-char code (byte).
struct ProcessInfo {
    pid;
    ppid;
    comm;      # cstr
    cmdline;   # cstr
    state;     # byte (char)
}

fn process_info_new(pid, ppid, comm, cmdline, state) {
    var p = alloc(40);
    var pp: ProcessInfo = p;
    pp.pid = pid;
    pp.ppid = ppid;
    pp.comm = comm;
    pp.cmdline = cmdline;
    pp.state = state;
    return p;
}

# ── ContainerStats ─────────────────────────
# Runtime statistics for a container (rust-old: struct ContainerStats).
struct ContainerStats {
    memory_bytes;
    memory_limit_bytes;   # 0 = unlimited
    cpu_usage_us;
    pids_current;
    pids_limit;           # 0 = unlimited
}

fn container_stats_new(memory_bytes, memory_limit_bytes, cpu_usage_us, pids_current, pids_limit) {
    var c = alloc(40);
    var cc: ContainerStats = c;
    cc.memory_bytes = memory_bytes;
    cc.memory_limit_bytes = memory_limit_bytes;
    cc.cpu_usage_us = cpu_usage_us;
    cc.pids_current = pids_current;
    cc.pids_limit = pids_limit;
    return c;
}

# ── Spec generation helpers ──────────────────────

# Standard container mounts (/proc, /sys, /dev, /dev/pts, /dev/shm) — the
# fixed base every container gets (rust-old: standard_mounts). Returns a vec
# of 5 SpecMount*, each with its option list as a vec of cstrs.
#[must_use]
fn standard_mounts() {
    var mounts = vec_new();

    # /proc — proc, [nosuid, noexec, nodev]
    var o_proc = vec_new();
    vec_push(o_proc, "nosuid");
    vec_push(o_proc, "noexec");
    vec_push(o_proc, "nodev");
    vec_push(mounts, spec_mount_new(0, "/proc", "proc", o_proc));

    # /sys — sysfs, [nosuid, noexec, nodev, ro]
    var o_sys = vec_new();
    vec_push(o_sys, "nosuid");
    vec_push(o_sys, "noexec");
    vec_push(o_sys, "nodev");
    vec_push(o_sys, "ro");
    vec_push(mounts, spec_mount_new(0, "/sys", "sysfs", o_sys));

    # /dev — tmpfs, [nosuid, mode=755]
    var o_dev = vec_new();
    vec_push(o_dev, "nosuid");
    vec_push(o_dev, "mode=755");
    vec_push(mounts, spec_mount_new(0, "/dev", "tmpfs", o_dev));

    # /dev/pts — devpts, [nosuid, noexec, newinstance, mode=0620]
    var o_pts = vec_new();
    vec_push(o_pts, "nosuid");
    vec_push(o_pts, "noexec");
    vec_push(o_pts, "newinstance");
    vec_push(o_pts, "mode=0620");
    vec_push(mounts, spec_mount_new(0, "/dev/pts", "devpts", o_pts));

    # /dev/shm — tmpfs, [nosuid, noexec, nodev, mode=1777]
    var o_shm = vec_new();
    vec_push(o_shm, "nosuid");
    vec_push(o_shm, "noexec");
    vec_push(o_shm, "nodev");
    vec_push(o_shm, "mode=1777");
    vec_push(mounts, spec_mount_new(0, "/dev/shm", "tmpfs", o_shm));

    return mounts;
}

# ── runtime-local string helpers ──────────────────────
# Heap constructors (alloc + return; never a stack struct). Runtime-local so
# `cyrius check src/runtime.cyr` resolves them standalone (the per-module `_cat2`
# duplication is the established port idiom).

# Non-negative i64 → fresh heap cstr (mirror _container_int_to_cstr).
#[must_use]
fn _rt_int_to_cstr(n) {
    if (n == 0) {
        var z = alloc(2);
        store8(z, 48);
        store8(z + 1, 0);
        return z;
    }
    var digits = 0;
    var t = n;
    while (t > 0) { digits = digits + 1; t = t / 10; }
    var out = alloc(digits + 1);
    store8(out + digits, 0);
    var i = digits - 1;
    var v = n;
    while (i >= 0) {
        store8(out + i, 48 + v % 10);
        v = v / 10;
        i = i - 1;
    }
    return out;
}

# Concatenate two NUL-terminated cstrings into a fresh heap cstr.
#[must_use]
fn _rt_cat2(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    var out = alloc(la + lb + 1);
    memcpy(out, a, la);
    memcpy(out + la, b, lb);
    store8(out + la + lb, 0);
    return out;
}

# Concatenate three NUL-terminated cstrings into a fresh heap cstr.
#[must_use]
fn _rt_cat3(a, b, c) {
    var la = strlen(a);
    var lb = strlen(b);
    var lc = strlen(c);
    var out = alloc(la + lb + lc + 1);
    memcpy(out, a, la);
    memcpy(out + la, b, lb);
    memcpy(out + la + lb, c, lc);
    store8(out + la + lb + lc, 0);
    return out;
}

# Convert volume specs into SpecMount entries (rust-old: volume_mounts).
# `volumes` is a vec of "source:target[:ro]" cstrs; `rootless` is 1/0.
# Each mount gets options starting with "rbind", plus "ro" when the volume is
# read-only, plus "X-mount.idmap=" when rootless (OCI runtime-spec v1.2.0
# ID-mapped mounts). Returns a vec of SpecMount* on success, or 0 (null) if
# any spec is invalid (rust-old: Err(StivaError::Storage(...)) — caller reports
# via stiva_err_print(STIVA_ERR_STORAGE)).
fn volume_mounts(volumes, rootless) {
    var mounts = vec_new();
    var n = vec_len(volumes);
    var i = 0;
    while (i < n) {
        var spec = vec_get(volumes, i);
        var vol = parse_volume(spec);   # storage.cyr: 0 on invalid spec
        if (vol == 0) {
            # rust-old: Err(StivaError::Storage(format!("invalid volume spec: {spec}"))).
            stiva_err_print(STIVA_ERR_STORAGE, _rt_cat2("invalid volume spec: ", spec));
            return 0;
        }
        # storage.cyr VolumeMount layout is { source; target; read_only; } at
        # offsets 0/8/16. Accessed via load64 to avoid a cross-module struct
        # annotation (the standalone parse has no VolumeMount in scope).
        var vsource = load64(vol + 0);
        var vtarget = load64(vol + 8);
        var vread_only = load64(vol + 16);

        var options = vec_new();
        vec_push(options, "rbind");
        if (vread_only == 1) {
            vec_push(options, "ro");
        }
        if (rootless == 1) {
            vec_push(options, "X-mount.idmap=");
        }

        vec_push(mounts, spec_mount_new(vsource, vtarget, "bind", options));
        i = i + 1;
    }
    return mounts;
}

# ── /proc/<pid>/stat parsing ──────────────────────

# Parse the PPID field from /proc/<pid>/stat content (rust-old:
# parse_ppid_from_stat). Format: "pid (comm) state ppid ...". `comm` may itself
# contain parens, so we find the LAST ')', skip ") " (2 bytes), skip the state
# field (up to the next space), and parse the ppid that follows. Returns the
# PPID, or 0 when the format is unrecognized (matches Rust's unwrap_or(0)).
#[must_use]
fn parse_ppid_from_stat(stat) {
    var len = strlen(stat);

    # rfind(')') — last ')'.
    var close = 0 - 1;
    var i = 0;
    while (i < len) {
        if (load8(stat + i) == 41) { close = i; }   # ')' = 41
        i = i + 1;
    }
    if (close < 0) { return 0; }

    # remainder = &stat[close + 2..]  (skip ") ").
    var p = close + 2;
    if (p >= len) { return 0; }

    # split_whitespace(): the state field is the first token; skip it, then
    # skip the whitespace between state and ppid, then parse ppid digits.
    # Skip any leading spaces first (defensive; Rust's split_whitespace does).
    while (p < len && load8(stat + p) == 32) { p = p + 1; }   # ' ' = 32
    # Skip the state token (non-space run).
    while (p < len && load8(stat + p) != 32) { p = p + 1; }
    # Skip whitespace between state and ppid.
    while (p < len && load8(stat + p) == 32) { p = p + 1; }
    if (p >= len) { return 0; }

    # Parse the ppid integer (digits until next space/end). atoi stops at the
    # first non-digit, so we can hand it the tail directly.
    return atoi(stat + p);
}

# ── CRIU availability ────────────────────────

# True (1) iff the `criu` binary is found on PATH (rust-old: criu_available).
# Scans $PATH (colon-separated) and checks each dir for a `criu` file. Returns
# 0 when $PATH is unset or `criu` is absent. rust-old uses Path::is_file; here
# we probe existence via file_exists (a directory would not be openable as a
# read-only file on the platforms we target).
#[must_use]
fn criu_available() {
    var path_var = getenv("PATH");
    if (path_var == 0) { return 0; }

    var len = strlen(path_var);
    var start = 0;
    var i = 0;
    while (i <= len) {
        var at_sep = 0;
        if (i == len) {
            at_sep = 1;
        } elif (load8(path_var + i) == 58) {   # ':' = 58
            at_sep = 1;
        }

        if (at_sep == 1) {
            var seg_len = i - start;
            if (seg_len > 0) {
                # candidate = "<dir>/criu"
                var cand = alloc(seg_len + 6);   # "/criu" (5) + NUL
                memcpy(cand, path_var + start, seg_len);
                store8(cand + seg_len, 47);          # '/'
                store8(cand + seg_len + 1, 99);      # 'c'
                store8(cand + seg_len + 2, 114);     # 'r'
                store8(cand + seg_len + 3, 105);     # 'i'
                store8(cand + seg_len + 4, 117);     # 'u'
                store8(cand + seg_len + 5, 0);
                if (file_exists(cand) == 1) {
                    return 1;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# ── Spec generation (rust-old: generate_spec) ─────────────────────
# Build a RuntimeSpec from a Container + rootfs path. PURE + synchronous — no
# kavach, no async. Reads container.cyr's Container/ContainerConfig via raw
# load64 offsets (container.cyr is included AFTER runtime.cyr, so a cross-module
# struct annotation isn't in scope — same load64 idiom volume_mounts uses for
# VolumeMount). Returns a RuntimeSpec* on success, or 0 on an invalid volume.
#
#   Container layout:       config @ offset 64.
#   ContainerConfig layout: command@8 env@16 volumes@24 memory_limit@48
#     cpu_shares@56 max_pids@64 user@72 workdir@80 rootless@104 secrets@112
#     scan_policy@120 timeout_ms@128 backend@136 min_isolation_score@144
#     agent_id@152 domainname@160 seccomp_profile@176.
fn generate_spec(container, rootfs) {
    var config = load64(container + 64);

    var c_command = load64(config + 8);
    var c_env = load64(config + 16);
    var c_volumes = load64(config + 24);
    var c_memory = load64(config + 48);
    var c_cpu = load64(config + 56);
    var c_maxpids = load64(config + 64);
    var c_user = load64(config + 72);
    var c_workdir = load64(config + 80);
    var c_rootless = load64(config + 104);
    var c_secrets = load64(config + 112);
    var c_scan = load64(config + 120);
    var c_timeout = load64(config + 128);
    var c_backend = load64(config + 136);
    var c_minscore = load64(config + 144);
    var c_agent = load64(config + 152);
    var c_domain = load64(config + 160);
    var c_seccomp = load64(config + 176);

    # env: each (k,v) → "k=v". The env map is built with map_new (cstr keys) —
    # iterate via map_keys + map_get (mixing map_new_str keys would OOB-segfault).
    var envv = vec_new();
    if (c_env != 0) {
        var keys = map_keys(c_env);
        var kn = vec_len(keys);
        var ki = 0;
        while (ki < kn) {
            var k = vec_get(keys, ki);
            var v = map_get(c_env, k);
            vec_push(envv, _rt_cat3(k, "=", v));
            ki = ki + 1;
        }
    }

    # command: empty → ["/bin/sh"], else reuse config.command.
    var cmdv = c_command;
    if (c_command == 0) {
        cmdv = vec_new();
        vec_push(cmdv, "/bin/sh");
    } elif (vec_len(c_command) == 0) {
        cmdv = vec_new();
        vec_push(cmdv, "/bin/sh");
    }

    # workdir: config.workdir or "/".
    var wd = c_workdir;
    if (c_workdir == 0) { wd = "/"; }

    # limits: value if > 0 else 0 (unset).
    var mem = 0;
    if (c_memory > 0) { mem = c_memory; }
    var cpu = 0;
    if (c_cpu > 0) { cpu = c_cpu; }
    var pids = 0;
    if (c_maxpids > 0) { pids = c_maxpids; }

    # mounts: standard_mounts() ++ volume_mounts(volumes, rootless)?
    var mnts = standard_mounts();
    if (c_volumes != 0) {
        var vm = volume_mounts(c_volumes, c_rootless);
        if (vm == 0) {
            # volume_mounts already printed "invalid volume spec: <spec>".
            return 0;
        }
        var vn = vec_len(vm);
        var vi = 0;
        while (vi < vn) {
            vec_push(mnts, vec_get(vm, vi));
            vi = vi + 1;
        }
    }

    # namespaces: [Pid, Net, Mount, Uts, Ipc] (+ User if rootless).
    var nsv = vec_new();
    vec_push(nsv, RUNTIME_NS_PID);
    vec_push(nsv, RUNTIME_NS_NET);
    vec_push(nsv, RUNTIME_NS_MOUNT);
    vec_push(nsv, RUNTIME_NS_UTS);
    vec_push(nsv, RUNTIME_NS_IPC);
    if (c_rootless == 1) {
        vec_push(nsv, RUNTIME_NS_USER);
    }

    var s = runtime_spec_new();
    var ss: RuntimeSpec = s;
    ss.rootfs = rootfs;
    ss.command = cmdv;
    ss.env = envv;
    ss.namespaces = nsv;
    ss.memory_limit_bytes = mem;
    ss.cpu_shares = cpu;
    ss.max_pids = pids;
    ss.user = c_user;
    ss.workdir = wd;
    ss.read_only_rootfs = 0;
    ss.mounts = mnts;
    ss.rootless = c_rootless;
    ss.secrets = c_secrets;
    ss.scan_policy = c_scan;
    ss.timeout_ms = c_timeout;
    ss.backend = c_backend;
    ss.min_isolation_score = c_minscore;
    ss.io_max_bytes_per_sec = 0;
    ss.seccomp_profile = c_seccomp;
    ss.agent_id = c_agent;
    ss.domainname = c_domain;
    return s;
}

# ── Signals (rust-old: send_signal) ──────────────
# Send `signal` to `pid`. Returns STIVA_ERR_OK (0) on success, or an
# STIVA_ERR_RUNTIME sentinel on failure (the detail is printed to stderr).
# Validation order mirrors the oracle: signal first, then pid.
#   - invalid signal: mirror rustix Signal::from_named_raw (None for a value
#     outside the named-signal range) — accept 1..=64 (standard + realtime).
#   - invalid pid: mirror rustix Pid::from_raw (None for pid <= 0).
# Divergence: rustix's `{e}` errno text isn't available from the raw syscall, so
# the send-failure message drops the ": <e>" suffix.
fn send_signal(pid, signal) {
    var lm = _rt_cat3("sending signal to container: signal=", _rt_int_to_cstr(signal),
      _rt_cat2(" pid=", _rt_int_to_cstr(pid)));
    sakshi_info(lm, strlen(lm));
    if (signal < 1 || signal > 64) {
        stiva_err_print(STIVA_ERR_RUNTIME, _rt_cat2("invalid signal ", _rt_int_to_cstr(signal)));
        return STIVA_ERR_RUNTIME;
    }
    if (pid <= 0) {
        stiva_err_print(STIVA_ERR_RUNTIME, _rt_cat2("invalid PID ", _rt_int_to_cstr(pid)));
        return STIVA_ERR_RUNTIME;
    }
    var rc = sys_kill(pid, signal);
    if (rc < 0) {
        stiva_err_print(STIVA_ERR_RUNTIME,
          _rt_cat3("failed to send signal ", _rt_int_to_cstr(signal),
            _rt_cat2(" to PID ", _rt_int_to_cstr(pid))));
        return STIVA_ERR_RUNTIME;
    }
    return STIVA_ERR_OK;
}

# ── cgroup v2 limits (rust-old: resolve_cgroup_base / apply_cgroup_limits) ──

# Parse the cgroup v2 base path from /proc/<pid>/cgroup content. Finds the line
# whose LINE-START is "0::" (the unified-hierarchy entry), strips that prefix,
# trims surrounding whitespace, and returns "/sys/fs/cgroup<path>". Returns 0 if
# no such line exists. Pure — line-start anchored (not strstr-anywhere) so a
# pathological "1:x:/a/0::b" line cannot false-match.
#[must_use]
fn _rt_cgroup_base_from_content(content) {
    var len = strlen(content);
    var start = 0;
    var i = 0;
    while (i <= len) {
        var at_end = 0;
        if (i == len) { at_end = 1; } elif (load8(content + i) == 10) { at_end = 1; }   # '\n'
        if (at_end == 1) {
            var line_len = i - start;
            # prefix "0::" ('0'=48, ':'=58) at the line start.
            if (line_len >= 3 && load8(content + start) == 48
              && load8(content + start + 1) == 58 && load8(content + start + 2) == 58) {
                var pstart = start + 3;
                var pend = i;
                # trim() both ends (space/tab/CR/LF).
                while (pstart < pend
                  && (load8(content + pstart) == 32 || load8(content + pstart) == 9)) {
                    pstart = pstart + 1;
                }
                while (pend > pstart) {
                    var ch = load8(content + pend - 1);
                    if (ch == 32 || ch == 9 || ch == 13 || ch == 10) { pend = pend - 1; } else { break; }
                }
                var plen = pend - pstart;
                var prefix = "/sys/fs/cgroup";
                var pl0 = strlen(prefix);
                var out = alloc(pl0 + plen + 1);
                memcpy(out, prefix, pl0);
                memcpy(out + pl0, content + pstart, plen);
                store8(out + pl0 + plen, 0);
                return out;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# Resolve a container's cgroup v2 base dir from its PID. Reads /proc/<pid>/cgroup
# and returns "/sys/fs/cgroup<path>", or 0 on read failure / no v2 entry (the
# detail is printed to stderr). Divergence: the read-failure ": <e>" errno text
# is unavailable from file_read_all, so it's dropped.
fn resolve_cgroup_base(pid) {
    var path = _rt_cat3("/proc/", _rt_int_to_cstr(pid), "/cgroup");
    var buf = alloc(65536);
    var n = file_read_all(path, buf, 65535);
    if (n < 0) {
        stiva_err_print(STIVA_ERR_RUNTIME, _rt_cat2("failed to read cgroup for PID ", _rt_int_to_cstr(pid)));
        return 0;
    }
    store8(buf + n, 0);
    var base = _rt_cgroup_base_from_content(buf);
    if (base == 0) {
        stiva_err_print(STIVA_ERR_RUNTIME, _rt_cat2("no cgroup v2 entry for PID ", _rt_int_to_cstr(pid)));
        return 0;
    }
    return base;
}

# cpu.max quota for a cpu_shares value: 1024 shares == 1 core, period = 100ms
# (100000us). quota = shares * period / 1024 (rust-old apply_cgroup_limits).
#[must_use]
fn _rt_cpu_quota(shares) {
    return shares * 100000 / 1024;
}

# Apply CPU/memory/PID/IO limits to a running container's cgroup v2 files.
# BEST-EFFORT: never returns an error — a write failure is skipped (the oracle
# only warns) and resolve failure returns early. Returns 0 always.
fn apply_cgroup_limits(pid, spec) {
    var lm = _rt_cat2("applying cgroup v2 resource limits, pid=", _rt_int_to_cstr(pid));
    sakshi_info(lm, strlen(lm));
    var base = resolve_cgroup_base(pid);
    if (base == 0) {
        sakshi_warn("could not resolve cgroup base, skipping limits",
          strlen("could not resolve cgroup base, skipping limits"));
        return 0;
    }
    var sp: RuntimeSpec = spec;

    if (sp.memory_limit_bytes > 0) {
        var mp = _rt_cat2(base, "/memory.max");
        var mv = _rt_int_to_cstr(sp.memory_limit_bytes);
        file_write_all(mp, mv, strlen(mv));
    }
    if (sp.max_pids > 0) {
        var pp = _rt_cat2(base, "/pids.max");
        var pv = _rt_int_to_cstr(sp.max_pids);
        file_write_all(pp, pv, strlen(pv));
    }
    if (sp.cpu_shares > 0) {
        var cp = _rt_cat2(base, "/cpu.max");
        # "<quota> <period>" — period 100000us.
        var cv = _rt_cat3(_rt_int_to_cstr(_rt_cpu_quota(sp.cpu_shares)), " ", _rt_int_to_cstr(100000));
        file_write_all(cp, cv, strlen(cv));
    }
    if (sp.io_max_bytes_per_sec > 0) {
        var iov = _rt_int_to_cstr(sp.io_max_bytes_per_sec);
        var ip = _rt_cat2(base, "/io.max");
        # "252:0 rbps=<io> wbps=<io>" — device-mapper major 252 (overlay).
        var ival = _rt_cat2("252:0 rbps=", iov);
        ival = _rt_cat2(ival, " wbps=");
        ival = _rt_cat2(ival, iov);
        file_write_all(ip, ival, strlen(ival));
    }
    return 0;
}

# ── Container stats + pause/unpause (rust-old: cgroup v2 reads/writes) ──
# The oracle marked these async, but they are plain cgroup-fs reads/writes —
# synchronous here (same as apply_cgroup_limits).

# Read a cgroup v2 u64 file {base}/{filename}. "max" → 0 (unlimited); absent or
# unparseable → 0 (rust-old read_cgroup_u64 + unwrap_or(0)).
fn _rt_read_cgroup_u64(base, filename) {
    var path = _rt_cat3(base, "/", filename);
    var buf = alloc(256);
    var n = file_read_all(path, buf, 255);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    # trim trailing whitespace.
    while (n > 0) {
        var ch = load8(buf + n - 1);
        if (ch == 10 || ch == 13 || ch == 32 || ch == 9) { n = n - 1; } else { break; }
    }
    store8(buf + n, 0);
    if (streq(buf, "max") == 1) { return 0; }
    return atoi(buf);
}

# Read usage_usec from {base}/cpu.stat (rust-old read_cpu_usage). 0 if absent.
fn _rt_read_cpu_usage(base) {
    var path = _rt_cat2(base, "/cpu.stat");
    var buf = alloc(4096);
    var n = file_read_all(path, buf, 4095);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    var i = 0;
    while (i < n) {
        if (memeq(buf + i, "usage_usec ", 11) == 1) {
            return atoi(buf + i + 11);
        }
        while (i < n && load8(buf + i) != 10) { i = i + 1; }   # skip to '\n'
        i = i + 1;
    }
    return 0;
}

# Container resource stats from cgroup v2 (rust-old: container_stats). Returns a
# ContainerStats*, or 0 if the cgroup base can't be resolved.
fn container_stats(pid) {
    var base = resolve_cgroup_base(pid);
    if (base == 0) { return 0; }
    return container_stats_new(
      _rt_read_cgroup_u64(base, "memory.current"),
      _rt_read_cgroup_u64(base, "memory.max"),
      _rt_read_cpu_usage(base),
      _rt_read_cgroup_u64(base, "pids.current"),
      _rt_read_cgroup_u64(base, "pids.max"));
}

# Write to a cgroup v2 control file (rust-old: write_cgroup_file). Resolves the
# base, writes `value` to {base}/{filename}. Returns STIVA_ERR_OK or a
# STIVA_ERR_RUNTIME sentinel (detail printed).
fn _rt_write_cgroup_file(pid, filename, value) {
    var base = resolve_cgroup_base(pid);
    if (base == 0) { return STIVA_ERR_RUNTIME; }
    var path = _rt_cat3(base, "/", filename);
    if (file_write_all(path, value, strlen(value)) < 0) {
        stiva_err_print(STIVA_ERR_RUNTIME, _rt_cat2("failed to write cgroup file: ", path));
        return STIVA_ERR_RUNTIME;
    }
    return STIVA_ERR_OK;
}

# Pause a container by freezing its cgroup (rust-old: pause_container).
fn pause_container(pid) {
    var lm = _rt_cat2("pausing container via cgroup freezer, pid=", _rt_int_to_cstr(pid));
    sakshi_info(lm, strlen(lm));
    return _rt_write_cgroup_file(pid, "cgroup.freeze", "1");
}

# Unpause a container by thawing its cgroup (rust-old: unpause_container).
fn unpause_container(pid) {
    var lm = _rt_cat2("unpausing container via cgroup freezer, pid=", _rt_int_to_cstr(pid));
    sakshi_info(lm, strlen(lm));
    return _rt_write_cgroup_file(pid, "cgroup.freeze", "0");
}

# ── Sandbox build (rust-old: build_sandbox) ───────────────────────
# Assemble a kavach SandboxPolicy + SandboxConfig from a RuntimeSpec, create the
# sandbox, and transition it to RUNNING. Returns the sandbox ptr, or 0 on
# failure (detail printed to stderr). The kavach Cyrius port is SYNCHRONOUS
# (sandbox_create/transition are blocking) — no async needed.
#
# The command is NOT returned (avoids a dangling pair struct); exec_container
# rejoins spec.command itself.
#
# Divergences (documented): the kavach dist takes integer policy units — memory
# in MB (bytes/1048576, truncating) and CPU in tenths-of-a-core ((shares*10)/1024)
# rather than the oracle's f64 fractional cores. SandboxConfig has no secrets /
# externalization setter in the dist, so scan_policy + secret injection are
# roadmap v3.1.0 item 1. sandbox_create/exec return 0 (no error code) so their
# failure
# messages carry no "<e>"; sandbox_transition returns a code → kavach_err_name.
fn build_sandbox(spec) {
    var sp: RuntimeSpec = spec;
    var policy = policy_basic();

    if (sp.memory_limit_bytes > 0) {
        SandboxPolicy_set_memory_limit_mb(policy, sp.memory_limit_bytes / 1048576);
    }
    if (sp.max_pids > 0) {
        SandboxPolicy_set_max_pids(policy, sp.max_pids);
    }
    if (sp.cpu_shares > 0) {
        SandboxPolicy_set_cpu_limit_tenths(policy, sp.cpu_shares * 10 / 1024);
    }
    SandboxPolicy_set_network_enabled(policy, 0);
    SandboxPolicy_set_read_only_rootfs(policy, sp.read_only_rootfs);
    if (sp.seccomp_profile != 0) {
        SandboxPolicy_set_seccomp_enabled(policy, 1);
        SandboxPolicy_set_seccomp_profile(policy, sp.seccomp_profile);
    }

    # Backend cascade (order load-bearing): explicit name > min-strength resolve >
    # OCI-if-available > Process.
    var b = KavachBackend.PROCESS;
    if (sp.backend != 0) {
        b = backend_parse(sp.backend);
        if (b == 0 - 1) {
            stiva_err_print(STIVA_ERR_RUNTIME, _rt_cat2("unknown backend: ", sp.backend));
            return 0;
        }
    } elif (sp.min_isolation_score != 0 - 1) {
        # resolve_min_strength_backend returns -1 (NOT 0) when nothing meets the
        # score; 0 is a valid PROCESS backend.
        b = resolve_min_strength_backend(policy, sp.min_isolation_score);
        if (b == 0 - 1) {
            stiva_err_print(STIVA_ERR_RUNTIME,
              _rt_cat2("no backend meets minimum isolation score ", _rt_int_to_cstr(sp.min_isolation_score)));
            return 0;
        }
    } elif (backend_is_available(KavachBackend.OCI) == 1) {
        b = KavachBackend.OCI;
    } else {
        b = KavachBackend.PROCESS;
    }
    var lm = _rt_cat2("selected sandbox backend: ", os_backend_name(b));
    sakshi_debug(lm, strlen(lm));

    var cfg = config_new();
    config_backend(cfg, b);
    config_policy(cfg, policy);
    config_timeout_ms(cfg, sp.timeout_ms);
    if (sp.agent_id != 0) { config_agent_id(cfg, sp.agent_id); }
    if (sp.domainname != 0) { config_domainname(cfg, sp.domainname); }
    # The container's own filesystem. Without this kavach execs the command on
    # the HOST — a binary present only in the image never runs, and one that
    # happens to exist on the host runs the host's copy. Needs kavach >= 3.9.1
    # for the SandboxConfig.rootfs field; before that stiva could not express it
    # through the API at all (roadmap §K).
    if (sp.rootfs != 0) { config_rootfs(cfg, sp.rootfs); }
    # The image's declared environment (OCI `process.env`, parsed into
    # ContainerConfig.env and folded to "K=V" by generate_spec).
    #
    # ⚠ Before kavach 3.12.0 this line could not be written THROUGH THE KAVACH
    # API: every exec path built a hardcoded empty envp and SandboxConfig had no
    # field to carry one, so `sp.env` was assembled correctly and then DROPPED
    # here. Containers ran without the environment their image declared, which
    # the Rust oracle applied via `Command::env` (rust-old/src/runtime.rs:176,
    # :515) — a parity regression.
    #
    # ⚠ "Through the API" is load-bearing and the distinction is not pedantry.
    # stiva COULD have fixed this alone: `confine_child` is public and returns
    # rather than exec'ing, so forking here and calling it, then execve'ing with
    # our own envp, was available the whole time — demonstrated by execution, not
    # argued. We took the upstream setter because it keeps runc/gVisor/Firecracker
    # working, keeps the confinement audit trail, and is one line instead of
    # three hundred. That is a trade, not an impossibility. The first draft of
    # this comment said "no amount of stiva-side work could fix" and was wrong —
    # which is precisely the sentence shape that produced eight bad "blocked"
    # labels on the v3.1.0 roadmap. Do not write that sentence without a probe.
    #
    # It survived the suite because the test asserted the wrong half: that the
    # spec CARRIED the env, never that a container could READ it. If you touch
    # this, assert on what the payload observes.
    if (sp.env != 0) { config_env(cfg, sp.env); }
    # secret injection still needs a SandboxConfig setter kavach does not expose
    # — roadmap v3.1.0 item 1. scan_policy is threaded via
    # `sandbox_exec_set_ext_policy`, NOT `config_externalization`, which kavach
    # stores and never reads.

    var sb = sandbox_create(cfg);
    if (sb == 0) {
        sakshi_error("failed to create sandbox", strlen("failed to create sandbox"));
        stiva_err_print(STIVA_ERR_SANDBOX, "failed to create sandbox");
        return 0;
    }
    var rc = sandbox_transition(sb, SandboxState.RUNNING);
    if (rc != KAVACH_ERR_OK) {
        stiva_err_print(STIVA_ERR_SANDBOX, _rt_cat2("failed to transition sandbox: ", kavach_err_name(rc)));
        return 0;
    }
    return sb;
}

# Join a vec of cstrs with `sep` into a fresh heap cstr (rust-old: command.join(" ")).
#[must_use]
fn _rt_join(v, sep) {
    var n = vec_len(v);
    if (n == 0) {
        var e = alloc(1);
        store8(e, 0);
        return e;
    }
    var seplen = strlen(sep);
    var total = 0;
    var i = 0;
    while (i < n) { total = total + strlen(vec_get(v, i)); i = i + 1; }
    total = total + seplen * (n - 1);
    var out = alloc(total + 1);
    var pos = 0;
    i = 0;
    while (i < n) {
        if (i > 0) { memcpy(out + pos, sep, seplen); pos = pos + seplen; }
        var s = vec_get(v, i);
        var sl = strlen(s);
        memcpy(out + pos, s, sl);
        pos = pos + sl;
        i = i + 1;
    }
    store8(out + pos, 0);
    return out;
}

# ── One-shot exec (rust-old: exec_container) ──────────────────────
# Build a sandbox, run the joined command in it (blocking), tear it down, and
# map the kavach ExecResult → a stiva ContainerExecResult. Returns the result
# ptr, or 0 on failure (build_sandbox / sandbox_exec printed the detail).
#
# sandbox_exec returns 0 on any of {not-RUNNING, backend failure, gate BLOCK,
# gate QUARANTINE}; the oracle only distinguishes ok/err, so a generic
# STIVA_ERR_SANDBOX is faithful. The kavach ExecResult is copied field-by-field
# through accessors (NOT aliased across the module boundary).
# Spawn a container DETACHED under the same policy the one-shot path uses, with
# stdout+stderr appended to `log_path`. Returns the kavach SpawnedProcess*, or 0.
#
# The counterpart of exec_container: same build_sandbox, so the container gets
# the identical seccomp/landlock/namespace/cgroup treatment — only the waiting
# differs. Needs kavach >= 3.9.0 for `sandbox_spawn`; that symbol not existing
# is what kept `run -d` on the v3.1 blocked list.
#
# The sandbox is NOT destroyed here. sandbox_destroy tears down the isolation
# the child is still living inside, so it belongs with the reap — see
# container_manager_reap.
fn spawn_container(spec, log_path) {
    var sp: RuntimeSpec = spec;
    var command = _rt_join(sp.command, " ");
    var lm = _rt_cat2("spawning detached container via kavach: ", command);
    sakshi_info(lm, strlen(lm));

    var sb = build_sandbox(spec);
    if (sb == 0) { return 0; }   # error already printed by build_sandbox

    var handle = sandbox_spawn(sb, command, log_path);
    if (handle == 0) {
        # kavach prints the specific reason (guard violation, a policy it
        # cannot honour, fork failure), so do not paper over it with a generic
        # message here.
        sakshi_error("detached spawn failed", strlen("detached spawn failed"));
        stiva_err_print(STIVA_ERR_SANDBOX, "detached spawn failed");
        return 0;
    }
    var lc = _rt_cat2("container spawned, pid=", _rt_int_to_cstr(spawned_pid(handle)));
    sakshi_info(lc, strlen(lc));
    return handle;
}

fn exec_container(spec) {
    var sp: RuntimeSpec = spec;
    var command = _rt_join(sp.command, " ");
    var lm = _rt_cat2("executing one-shot container via kavach: ", command);
    sakshi_info(lm, strlen(lm));

    var sb = build_sandbox(spec);
    if (sb == 0) { return 0; }   # error already printed by build_sandbox

    var r = sandbox_exec(sb, command);
    if (r == 0) {
        sakshi_error("sandbox execution failed", strlen("sandbox execution failed"));
        stiva_err_print(STIVA_ERR_SANDBOX, "sandbox execution failed");
        return 0;
    }
    sandbox_destroy(sb);   # best-effort, ignore return (oracle: `let _ = ...`)

    var lc = _rt_cat2("container execution complete, exit_code=", _rt_int_to_cstr(ExecResult_exit_code(r)));
    sakshi_info(lc, strlen(lc));
    return container_exec_result_new(
      ExecResult_exit_code(r),
      ExecResult_stdout(r),
      ExecResult_stderr(r),
      ExecResult_duration_ms(r),
      ExecResult_timed_out(r));
}

# Write a container's exec output to its log file (rust-old: write_log). The
# template is byte-exact: "=== stdout ===\n{}\n=== stderr ===\n{}\n=== exit_code:
# {} | duration: {}ms | timed_out: {} ===\n". Best-effort; ignores write errors.
fn write_container_log(log_path, result) {
    var rr: ContainerExecResult = result;
    var so = rr.stdout;
    if (so == 0) { so = ""; }
    var se = rr.stderr;
    if (se == 0) { se = ""; }
    var s = _rt_cat3("=== stdout ===\n", so, "\n=== stderr ===\n");
    s = _rt_cat3(s, se, "\n=== exit_code: ");
    s = _rt_cat3(s, _rt_int_to_cstr(rr.exit_code), " | duration: ");
    s = _rt_cat3(s, _rt_int_to_cstr(rr.duration_ms), "ms | timed_out: ");
    s = _rt_cat3(s, _rt_int_to_cstr(rr.timed_out), " ===\n");
    file_write_all(log_path, s, strlen(s));
    return 0;
}

# Verdict + finding count from the most recent scan_output call. The oracle
# collapses QUARANTINE and BLOCK into one Err, and so does scan_output's 0;
# these let a caller or a test tell them apart without a second sentinel.
# Mirrors kavach's own sandbox_exec_last_scan_result idiom (kavach.cyr:8986).
var _rt_last_scan_verdict = 0;
var _rt_last_scan_findings = 0;

#[must_use]
fn scan_output_last_verdict() { return _rt_last_scan_verdict; }

#[must_use]
fn scan_output_last_findings() { return _rt_last_scan_findings; }

# ── Output scanning (rust-old: scan_output, runtime.rs:565-604) ───
# Run kavach's externalization gate over a ContainerExecResult before the
# bytes leave the runtime. Returns a NEW ContainerExecResult* (secrets
# redacted when the gate verdict was WARN and the policy opts in) on
# PASS/WARN, or 0 on QUARANTINE/BLOCK — mirroring the oracle's
# `Err(StivaError::Sandbox(format!("output scan: {e}")))`.
#
# Two shape divergences forced by the ported kavach, both benign:
#
#  1. There is no `ExternalizationGate` TYPE in lib/kavach.cyr — the Rust
#     `ExternalizationGate::new()` + `gate.apply(res, policy) -> Result<..>`
#     is the free function `gate_apply(exec_result, policy) -> ScanResult*`
#     (lib/kavach.cyr:5131). The old "[ExternalizationGate handle unported]"
#     note below was wrong: the surface has always been free functions.
#  2. `gate_apply` never returns a null sentinel; it reports through
#     `ScanResult_verdict` and REWRITES the ExecResult's stdout/stderr in
#     place when redacting. So we marshal in, apply, branch on the verdict,
#     and read the (possibly rewritten) strings back off the struct we
#     handed it.
#
# Error code is STIVA_ERR_SANDBOX, not STIVA_ERR_SCAN_BLOCKED: the oracle
# uses `StivaError::Sandbox` at runtime.rs:590 even though `ScanBlocked`
# exists at error.rs:63. Parity wins; 19 stays unused.
#
# NOT for `exec_container` — `sandbox_exec` already gate-applies one layer
# down (lib/kavach.cyr:9026) and returns 0 on BLOCK/QUARANTINE, so scanning
# its result would scan twice. This is for output that did NOT come through
# sandbox_exec: `logs`, and `exec_in_container` once that lands.
#[must_use]
fn scan_output(result, policy) {
    sakshi_info("scanning container output via externalization gate",
      strlen("scanning container output via externalization gate"));

    if (result == 0) { return 0; }
    if (policy == 0) {
        stiva_err_print(STIVA_ERR_SANDBOX, "output scan: null externalization policy");
        return 0;
    }

    # ContainerExecResult -> kavach ExecResult. Read by RAW OFFSET
    # (exit_code@0 stdout@8 stderr@16 duration_ms@24 timed_out@32), not
    # `var rr: ContainerExecResult = result`, per the cycc struct-id 20/21
    # SIMD-sentinel workaround documented in CLAUDE.md.
    var er = exec_result_new();
    ExecResult_set_exit_code(er, load64(result));
    ExecResult_set_stdout(er, load64(result + 8));
    ExecResult_set_stderr(er, load64(result + 16));
    ExecResult_set_duration_ms(er, load64(result + 24));
    ExecResult_set_timed_out(er, load64(result + 32));

    var sr = gate_apply(er, policy);
    var verdict = ScanResult_verdict(sr);
    _rt_last_scan_verdict = verdict;
    _rt_last_scan_findings = vec_len(ScanResult_findings(sr));

    if (verdict == ScanVerdict.BLOCK || verdict == ScanVerdict.QUARANTINE) {
        var dm = _rt_cat2("output scan: ", verdict_name(verdict));
        sakshi_error(dm, strlen(dm));
        stiva_err_print(STIVA_ERR_SANDBOX, dm);
        return 0;
    }

    sakshi_info("output scan passed", strlen("output scan passed"));
    return container_exec_result_new(
      ExecResult_exit_code(er),
      ExecResult_stdout(er),
      ExecResult_stderr(er),
      ExecResult_duration_ms(er),
      ExecResult_timed_out(er));
}

# ── Security scoring (rust-old: security_score / security_score_for) ──
# kavach score_backend returns the isolation strength as an i64 (0..100); the
# Rust StrengthScore wrapper collapses to that integer in the dist. No async.
fn security_score() {
    var backend = KavachBackend.PROCESS;
    if (backend_is_available(KavachBackend.OCI) == 1) { backend = KavachBackend.OCI; }
    var lm = _rt_cat2("computing security strength score: ", os_backend_name(backend));
    sakshi_info(lm, strlen(lm));
    var policy = policy_basic();
    return score_backend(backend, policy);
}

# Score an explicit (backend, policy) pair — no logging (parity: the oracle's
# security_score_for has none).
fn security_score_for(backend, policy) {
    return score_backend(backend, policy);
}

# ── Container top — list processes inside a container (rust-old: /proc walk) ──
# The oracle marked container_top/read_process_info async, but they are plain
# /proc reads — synchronous here (same as the cgroup stats above).

# ASCII-whitespace test (space/tab/LF/CR) for the /proc/<pid>/stat field scan.
#[must_use]
fn _rt_is_ws(ch) {
    if (ch == 32) { return 1; }
    if (ch == 9) { return 1; }
    if (ch == 10) { return 1; }
    if (ch == 13) { return 1; }
    return 0;
}

# True iff NUL-terminated `s` is non-empty and all ASCII digits (a /proc PID
# dir name; rust-old: name_str.parse::<u32>() succeeds).
#[must_use]
fn _rt_all_digits(s) {
    if (load8(s) == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var ch = load8(s + i);
        if (ch < 48 || ch > 57) { return 0; }
        i = i + 1;
    }
    return 1;
}

# comm field of a /proc stat line: between the FIRST '(' and the LAST ')'
# (rust-old: stat.find('(') .. stat.rfind(')')). "?" when absent.
#[must_use]
fn _rt_comm_from_stat(stat) {
    var len = strlen(stat);
    var lp = 0;
    while (lp < len && load8(stat + lp) != 40) { lp = lp + 1; }   # '('
    if (lp >= len) { return "?"; }
    var rp = len - 1;
    while (rp > lp && load8(stat + rp) != 41) { rp = rp - 1; }    # ')'
    if (rp <= lp) { return "?"; }
    return str_cstr(str_from_buf(stat + lp + 1, rp - lp - 1));
}

# State char of a /proc stat line: the byte at rfind(')')+2 (rust-old). '?'(63)
# when absent.
#[must_use]
fn _rt_state_from_stat(stat) {
    var len = strlen(stat);
    var rp = len - 1;
    while (rp >= 0) {
        if (load8(stat + rp) == 41) { break; }   # ')'
        rp = rp - 1;
    }
    if (rp < 0) { return 63; }
    var si = rp + 2;
    if (si >= len) { return 63; }
    return load8(stat + si);
}

# Trim leading/trailing ASCII whitespace → fresh cstr (rust-old: str::trim).
#[must_use]
fn _rt_trim(s) {
    var len = strlen(s);
    var start = 0;
    while (start < len && _rt_is_ws(load8(s + start)) == 1) { start = start + 1; }
    var end = len;
    while (end > start && _rt_is_ws(load8(s + end - 1)) == 1) { end = end - 1; }
    return str_cstr(str_from_buf(s + start, end - start));
}

# True (1) iff `child` is a descendant of `ancestor` by walking the PPID chain
# via /proc/<pid>/stat (rust-old: is_descendant_of). 64-iteration safety cap;
# a read failure or reaching PID<=1 without a match returns 0.
#[must_use]
fn is_descendant_of(child, ancestor) {
    if (child == ancestor) { return 1; }
    var current = child;
    var iter = 0;
    while (iter < 64) {
        var path = _rt_cat3("/proc/", _rt_int_to_cstr(current), "/stat");
        var buf = alloc(4096);
        var n = file_read_all(path, buf, 4095);
        if (n < 0) { return 0; }
        store8(buf + n, 0);
        var ppid = parse_ppid_from_stat(buf);
        if (ppid == ancestor) { return 1; }
        if (ppid <= 1) { return 0; }
        current = ppid;
        iter = iter + 1;
    }
    return 0;
}

# Read a ProcessInfo* from /proc/<pid>/ (rust-old: read_process_info). Returns 0
# when /proc/<pid>/stat is unreadable (rust-old: Err); cmdline is best-effort
# (NULs → spaces, trimmed; empty on failure).
fn read_process_info(pid) {
    var stat_path = _rt_cat3("/proc/", _rt_int_to_cstr(pid), "/stat");
    var sbuf = alloc(4096);
    var sn = file_read_all(stat_path, sbuf, 4095);
    if (sn < 0) { return 0; }
    store8(sbuf + sn, 0);

    var cmd_path = _rt_cat3("/proc/", _rt_int_to_cstr(pid), "/cmdline");
    var cbuf = alloc(65536);
    var cn = file_read_all(cmd_path, cbuf, 65535);
    var cmdline = "";
    if (cn > 0) {
        var j = 0;
        while (j < cn) {
            if (load8(cbuf + j) == 0) { store8(cbuf + j, 32); }   # '\0' → ' '
            j = j + 1;
        }
        store8(cbuf + cn, 0);
        cmdline = _rt_trim(cbuf);
    }

    var comm = _rt_comm_from_stat(sbuf);
    var ppid = parse_ppid_from_stat(sbuf);
    var state = _rt_state_from_stat(sbuf);
    return process_info_new(pid, ppid, comm, cmdline, state);
}

# List processes inside a container: every /proc PID whose PPID chain leads to
# `pid` (rust-old: container_top). Returns a vec of ProcessInfo*.
fn container_top(pid) {
    var lm = _rt_cat2("listing container processes, pid=", _rt_int_to_cstr(pid));
    sakshi_info(lm, strlen(lm));
    var processes = vec_new();
    var entries = dir_list(str_from("/proc"));
    var ne = vec_len(entries);
    var ei = 0;
    while (ei < ne) {
        var name = str_cstr(vec_get(entries, ei));
        if (_rt_all_digits(name) == 1) {
            var child_pid = atoi(name);
            if (is_descendant_of(child_pid, pid) == 1) {
                var info = read_process_info(child_pid);
                if (info != 0) { vec_push(processes, info); }
            }
        }
        ei = ei + 1;
    }
    var dm = _rt_cat3("container processes listed, pid=", _rt_int_to_cstr(pid),
      _rt_cat2(" count=", _rt_int_to_cstr(vec_len(processes))));
    sakshi_info(dm, strlen(dm));
    return processes;
}

# ProcessInfo* → JSON object (rust-old: serde on ProcessInfo). `state` is a char,
# serialized as a one-character JSON string (serde's char representation).
fn process_info_to_jv(info) {
    var p: ProcessInfo = info;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("pid"), json_v_int_new(p.pid));
    json_v_obj_set(o, str_from("ppid"), json_v_int_new(p.ppid));
    json_v_obj_set(o, str_from("comm"), json_v_str_new(str_from(p.comm)));
    json_v_obj_set(o, str_from("cmdline"), json_v_str_new(str_from(p.cmdline)));
    var sb = alloc(2);
    store8(sb, p.state);
    store8(sb + 1, 0);
    json_v_obj_set(o, str_from("state"), json_v_str_new(str_from(sb)));
    return o;
}

# JSON object → ProcessInfo* (rust-old: deserialize ProcessInfo). 0 when v is 0.
fn process_info_from_jv(v) {
    if (v == 0) { return 0; }
    var pf = json_v_obj_get(v, "pid");
    var pid = 0;
    if (json_v_is_int(pf) == 1) { pid = json_v_int(pf); }
    var ppf = json_v_obj_get(v, "ppid");
    var ppid = 0;
    if (json_v_is_int(ppf) == 1) { ppid = json_v_int(ppf); }
    var cf = json_v_obj_get(v, "comm");
    var comm = "";
    if (json_v_is_str(cf) == 1) { comm = str_cstr(json_v_str(cf)); }
    var clf = json_v_obj_get(v, "cmdline");
    var cmdline = "";
    if (json_v_is_str(clf) == 1) { cmdline = str_cstr(json_v_str(clf)); }
    var state = 63;                               # '?'
    var sf = json_v_obj_get(v, "state");
    if (json_v_is_str(sf) == 1) {
        var sc = str_cstr(json_v_str(sf));
        if (load8(sc) != 0) { state = load8(sc); }
    }
    return process_info_new(pid, ppid, comm, cmdline, state);
}

# ── Container copy — files in/out (rust-old: copy_into/from_container) ────────

# Join base + "/" + rel, collapsing a double slash when base ends in '/'
# (rust-old: Path::join). Both args are cstr; returns a fresh cstr. NB: distinct
# from _rt_join above, which joins a vec of cstrs with a separator.
#[must_use]
fn _rt_path_join(base, rel) {
    var bl = strlen(base);
    if (bl > 0 && load8(base + bl - 1) == 47) { return _rt_cat2(base, rel); }
    return _rt_cat3(base, "/", rel);
}

# Copy one file src → dst by value (rust-old: std::fs::copy). Whole-file read via
# storage's SEEK_END reader (no truncation). Returns 0 on success, -1 on failure.
fn _rt_copy_file(src, dst) {
    var len_cell = alloc(8);
    var data = _stor_read_file(src, len_cell);
    var n = load64(len_cell);
    if (n < 0) { return 0 - 1; }
    if (file_write_all(dst, data, n) < 0) { return 0 - 1; }
    return 0;
}

# Recursively copy directory src → dst (rust-old: copy_dir_recursive). Creates
# dst, then copies each entry (recursing into subdirs). Returns 0 / -1.
fn copy_dir_recursive(src, dst) {
    _stor_mkdir_p(dst);
    var entries = dir_list(str_from(src));
    var ne = vec_len(entries);
    var ei = 0;
    while (ei < ne) {
        var name = str_cstr(vec_get(entries, ei));
        var sp = _rt_path_join(src, name);
        var dp = _rt_path_join(dst, name);
        if (is_dir(str_from(sp)) == 1) {
            if (copy_dir_recursive(sp, dp) != 0) { return 0 - 1; }
        } else {
            if (_rt_copy_file(sp, dp) != 0) { return 0 - 1; }
        }
        ei = ei + 1;
    }
    return 0;
}

# Copy a host path into a container's rootfs (rust-old: copy_into_container).
# `container_dst` is rooted at the rootfs (leading '/' stripped). Creates the
# target's parent dirs; dirs are copied recursively. Returns 0 / -1.
fn copy_into_container(rootfs, host_src, container_dst) {
    var lm = _rt_cat3("copying file into container: ", host_src,
      _rt_cat2(" -> ", container_dst));
    sakshi_info(lm, strlen(lm));
    var rel = container_dst;
    if (load8(rel) == 47) { rel = rel + 1; }      # strip leading '/'
    var target = _rt_path_join(rootfs, rel);
    _stor_mkdir_parents(target);
    if (is_dir(str_from(host_src)) == 1) { return copy_dir_recursive(host_src, target); }
    return _rt_copy_file(host_src, target);
}

# Copy a container-rootfs path out to the host (rust-old: copy_from_container).
# Errors (-1) when the source path is absent in the container. Creates the host
# destination's parent dirs; dirs are copied recursively. Returns 0 / -1.
fn copy_from_container(rootfs, container_src, host_dst) {
    var lm = _rt_cat3("copying file from container: ", container_src,
      _rt_cat2(" -> ", host_dst));
    sakshi_info(lm, strlen(lm));
    var rel = container_src;
    if (load8(rel) == 47) { rel = rel + 1; }
    var source = _rt_path_join(rootfs, rel);
    if (file_exists(source) == 0) {
        stiva_err_print(STIVA_ERR_STORAGE,
          _rt_cat2("source path does not exist in container: ", container_src));
        return 0 - 1;
    }
    _stor_mkdir_parents(host_dst);
    if (is_dir(str_from(source)) == 1) { return copy_dir_recursive(source, host_dst); }
    return _rt_copy_file(source, host_dst);
}

# ══ §D — exec into a running container ═══════════════════
#
# `nsenter -t <pid> -p -m -n -u -i -- <command>`, exactly as the oracle does it
# (rust-old/src/runtime.rs:491-561). This path deliberately does NOT go through
# kavach: entering an existing container's namespaces is `execve("nsenter", …)`
# in a forked child, and kavach has no API for it — no `sandbox_enter` exists and
# none is needed.
#
# NOT over kavach's `persistent_spawn` either, despite it looking close. That
# path runs `check_command` with the default runtime guard, whose command
# blocklist rejects base names `sh`, `bash`, `dash`, `python`, `node`, … — so
# `stiva exec <ctr> /bin/sh`, the canonical use, would be refused. It also
# threads an EMPTY envp, has no working-directory hook, and sends the child's
# stderr to /dev/null. Working around all four is strictly more work than the
# primitive below.
#
# `exec -it` (TTY) is NOT here and is not merely a coroutine problem: there is no
# pty helper anywhere in `lib/` or `src/` (`openpty`/`posix_openpt`/`/dev/ptmx`/
# `TIOCSCTTY` all return nothing), so the `-t` half has no substrate to build on
# even if the runtime could suspend mid-body.

# Scratch path for one exec's stderr, under the container root so it inherits
# that directory's ownership rather than landing in a world-writable /tmp.
# A per-exec tag: "<pid>-<seq>". The sequence makes concurrent execs into the
# same container distinct; the pid keeps separate stiva processes distinct.
var _rt_exec_seq = 0;

#[must_use]
fn _rt_exec_tag(pid) {
    _rt_exec_seq = _rt_exec_seq + 1;
    return _rt_cat2(_rt_cat2(_rt_int_to_cstr(pid), "-"), _rt_int_to_cstr(_rt_exec_seq));
}

#[must_use]
fn _rt_exec_err_path(root, tag) {
    var b = _rt_cat2(root, "/.exec-err-");
    return _rt_cat2(b, tag);
}

# Read a whole file into a fresh cstr, capped at `cap` bytes, then unlink it.
# Returns "" when absent or unreadable — never 0.
fn _rt_take_file(path, cap) {
    var buf = alloc(cap + 1);
    store8(buf, 0);
    var n = file_read_all(path, buf, cap);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);                       # file_read_all does not terminate
    sys_unlink(path);
    return buf;
}

# Fork/exec `args` capturing stdout into `out_buf` and stderr into `err_path`,
# with `env` (a vec of "K=V" cstrs) and an optional `workdir`. Returns the number
# of stdout bytes captured, or -1; the decoded wait status lands in
# `_rt_last_exec_exit`.
#
# WHY STDERR GOES TO A FILE AND NOT A SECOND PIPE. Draining two pipes from one
# thread deadlocks the moment either fills: a child that writes 64 KiB to stderr
# before its first stdout byte blocks forever against a parent reading stdout.
# The usual answer is poll/epoll, but stiva has no `sys_poll` wrapper on any
# arch, and epoll's event struct is packed differently on x86_64 (data at +4,
# stride 12) than on aarch64 (+8, stride 16) — while the AGNOS wrappers take a
# different ARITY again (3-arg vs Linux's 4-arg), so an epoll drain would not
# compile for the v3.2 AGNOS target and would introduce this tree's first
# `#ifdef`. A regular file never blocks its writer, so none of that is needed.
# (Same reasoning, same shape, as kavach 3.9.2's `_oci_run`.)
var _rt_last_exec_exit = 0;
var _rt_last_exec_truncated = 0;

# 1 when the most recent capture filled its buffer and discarded the rest. The
# command still ran to completion and its exit code is real; only the captured
# text is short.
#[must_use]
fn rt_last_exec_truncated() { return _rt_last_exec_truncated; }

# Exit status of the most recent `_exec_capture2`: the code for a normal exit,
# `128 + signal` for a signalled child — the convention kavach's
# `confine_capture` uses, so a status means the same thing on both sides.
#[must_use]
fn rt_last_exec_exit() { return _rt_last_exec_exit; }

fn _exec_capture2(args, env, workdir, out_buf, out_cap, err_path) {
    var argc = vec_len(args);
    if (argc < 1) { _rt_last_exec_exit = 0 - 1; return 0 - 1; }
    var argv = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) {
        store64(argv + i * 8, vec_get(args, i));
        i = i + 1;
    }
    store64(argv + argc * 8, 0);

    var envc = 0;
    if (env != 0) { envc = vec_len(env); }
    var envp = alloc((envc + 1) * 8);
    var e = 0;
    while (e < envc) {
        store64(envp + e * 8, vec_get(env, e));
        e = e + 1;
    }
    store64(envp + envc * 8, 0);

    var pipefd[16];
    if (sys_pipe(&pipefd) < 0) { _rt_last_exec_exit = 0 - 1; return 0 - 1; }
    var rfd = load32(&pipefd);
    var wfd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(rfd);
        sys_close(wfd);
        _rt_last_exec_exit = 0 - 1;
        return 0 - 1;
    }
    if (pid == 0) {
        sys_close(rfd);
        # stdin from /dev/null — the oracle uses Stdio::null(), and a child that
        # inherits the CLI's stdin would steal the user's terminal input.
        var devnull = sys_open("/dev/null", 0, 0);          # O_RDONLY
        if (devnull >= 0) {
            sys_dup2(devnull, 0);
            sys_close(devnull);
        }
        # Guarded: `dup2(fd, N)` is a no-op when fd == N, so an unguarded
        # `close(fd)` right after would destroy the descriptor just installed.
        # Reachable whenever the caller starts with fd 1 closed (a daemon that
        # tidied its descriptors), which the pipe would then be allocated into.
        if (wfd != 1) {
            sys_dup2(wfd, 1);
            sys_close(wfd);
        }
        # O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, 0600. NOT 1089 — that is
        # O_WRONLY|O_CREAT|O_APPEND (the comment here used to claim O_TRUNC and
        # was simply wrong), which made a leftover file turn this exec's stderr
        # into the CONCATENATION of a previous exec's and this one's. The parent
        # unlinks first, so O_EXCL guarantees a fresh regular file and
        # O_NOFOLLOW refuses a planted symlink.
        var efd = sys_open(err_path, 131265, 384);
        if (efd >= 0) {
            sys_dup2(efd, 2);
            sys_close(efd);
        }
        # chdir(2) via the PER-ARCH constant, not a hardcoded 80. On aarch64 80
        # is `fstat`, so the literal made this a silent no-op there. A failure is
        # not fatal: a missing workdir inside the container is better reported by
        # the command itself than by refusing to run it.
        if (workdir != 0) {
            if (strlen(workdir) > 0) { syscall(SYS_CHDIR, workdir); }
        }
        # CVE-2024-21626: close inherited host fds before exec, or the container
        # can reach host resources through /proc/self/fd/N. The oracle bounds
        # this by sysconf(_SC_OPEN_MAX); a fixed ceiling is the portable
        # equivalent and covers every fd this process ever opens.
        var fd = 3;
        while (fd < 1024) {
            sys_close(fd);
            fd = fd + 1;
        }
        # NO_NEW_PRIVS — a hardening divergence, not parity. The oracle does not
        # set it here (it does in the container-launch pre_exec), but an exec is
        # the same trust boundary.
        #
        # Through `sys_prctl`, NOT `syscall(157, ...)`. 157 is prctl only on
        # x86_64; on aarch64 it is `setsid`, so the literal silently skipped the
        # hardening AND detached the child into a new session. PR_SET_NO_NEW_PRIVS = 38.
        sys_prctl(38, 1, 0, 0, 0);
        sys_execve(vec_get(args, 0), argv, envp);
        # execve failed — 127 is the shell's "command not found", visible to the
        # caller instead of being swallowed into a success.
        sys_exit(127);
    }

    sys_close(wfd);
    var total = 0;
    var rgo = 1;
    _rt_last_exec_truncated = 0;
    # Once the buffer is full, KEEP DRAINING into a scratch block instead of
    # closing the pipe.
    #
    # Closing here — what this did before — sends the child SIGPIPE on its next
    # write, so a command that merely produced a lot of output was reported as
    # exit 141: a successful `cat` of a large file looked like a signal death,
    # and the truncation was silent besides. The child now runs to completion and
    # reports its own status; the caller learns about the truncation from
    # `rt_last_exec_truncated()`.
    var sink = 0;
    while (rgo == 1) {
        var n = 0;
        if (total < out_cap) {
            n = sys_read(rfd, out_buf + total, out_cap - total);
            if (n > 0) { total = total + n; }
        } else {
            if (sink == 0) { sink = alloc(65536); }
            n = sys_read(rfd, sink, 65536);
            if (n > 0) { _rt_last_exec_truncated = 1; }
        }
        if (n <= 0) { rgo = 0; }
    }
    sys_close(rfd);

    var stbuf[4];
    store32(&stbuf, 0);
    sys_waitpid(pid, &stbuf, 0);
    var status = load32(&stbuf);
    var sig = status & 127;
    if (sig == 0) { _rt_last_exec_exit = (status >> 8) & 255; }
    else { _rt_last_exec_exit = 128 + sig; }
    return total;
}

# 1 when `pid` lives in a DIFFERENT user namespace than we do — i.e. the
# container is rootless. Compared by the `/proc/<pid>/ns/user` symlink target,
# which is the kernel's own namespace identity ("user:[4026532656]"), so this is
# an exact test rather than an inference from configuration.
#
# 0 when either link is unreadable: the privileged flag set is the oracle's
# behaviour, so an unknown answer falls back to parity rather than to the
# divergence.
# 1 when `s` is a non-null, non-empty cstr.
#[must_use]
fn _rt_nonempty(s) {
    if (s == 0) { return 0; }
    if (strlen(s) == 0) { return 0; }
    return 1;
}

# 1 when `workdir` is safe to hand to nsenter's `--wd`.
#
# THIS IS A CONFINEMENT BOUNDARY, not a tidiness check. The workdir is spliced
# onto `/proc/<pid>/root` — see the `--wd` construction in `exec_in_container`,
# and the reason it has to be — so a `..` component walks straight back OUT of
# the container: `--wd=/proc/<pid>/root/../../..` leaves the process chrooted
# into the container with its cwd on the HOST, and every relative path the
# command then opens reads the host filesystem.
#
# That is reachable two ways: an operator typing `stiva exec -w ../../..`, and —
# worse — `mcp_handle_exec`, where `workdir` arrives as untrusted JSON from a
# client that is not the host operator. Verified as an arbitrary host-file read
# before this guard existed.
#
# Absolute-only, because a relative workdir has no meaning against a root the
# caller cannot see. Component-wise, so a directory legitimately named `..foo`
# or `a..b` still works.
#[must_use]
fn _rt_workdir_is_safe(workdir) {
    if (workdir == 0) { return 0; }
    var n = strlen(workdir);
    if (n == 0) { return 0; }
    if (load8(workdir) != 47) { return 0; }        # must be absolute
    var i = 0;
    var start = 0;
    while (i <= n) {
        var c = 0;
        if (i < n) { c = load8(workdir + i); }
        if (c == 47 || i == n) {
            if (i - start == 2) {
                if (load8(workdir + start) == 46) {
                    if (load8(workdir + start + 1) == 46) { return 0; }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

#[must_use]
fn _rt_userns_differs(pid) {
    var mine = alloc(256);
    var theirs = alloc(256);
    var n1 = sys_readlink("/proc/self/ns/user", mine, 255);
    if (n1 <= 0) { return 0; }
    store8(mine + n1, 0);
    var p = _rt_cat2(_rt_cat2("/proc/", _rt_int_to_cstr(pid)), "/ns/user");
    var n2 = sys_readlink(p, theirs, 255);
    if (n2 <= 0) { return 0; }
    store8(theirs + n2, 0);
    if (streq(mine, theirs) == 1) { return 0; }
    return 1;
}

# Cap on captured exec output, per stream. Beyond this the stream is truncated
# rather than grown — an exec is interactive-scale output, and an unbounded
# buffer here is a memory DoS from inside the container.
var _RT_EXEC_MAX_OUTPUT = 1048576;

# Run `command` (a vec of cstrs) inside the namespaces of the running process
# `pid` (rust-old: exec_in_container). `env` is a vec of "K=V" cstrs or 0;
# `workdir` a cstr or 0. `root` is the container-data root, used only to place
# the stderr scratch file. Returns a ContainerExecResult*, or 0 on failure with
# the detail printed.
fn exec_in_container(root, pid, command, env, workdir) {
    if (command == 0) {
        stiva_err_print(STIVA_ERR_RUNTIME, "empty exec command");
        return 0;
    }
    if (vec_len(command) == 0) {
        stiva_err_print(STIVA_ERR_RUNTIME, "empty exec command");
        return 0;
    }

    var args = vec_new();
    vec_push(args, _nsenter_bin());
    vec_push(args, "-t");
    vec_push(args, _rt_int_to_cstr(pid));
    # The target's filesystem view. kavach's process backend `chroot`s rather
    # than `pivot_root`s, so entering the mount namespace alone leaves our root
    # at "/" and the container's own paths do not resolve — `/app/x` reports
    # "No such file or directory" for a binary that is plainly in the image.
    # `-r` roots us at /proc/<pid>/root, which is the chroot; `-w` follows the
    # target's cwd. Neither is in the oracle's invocation.
    vec_push(args, "-r");
    # The working directory MUST be nsenter's, not the child's. `_exec_capture2`
    # chdirs before exec, but nsenter chdirs again afterwards and wins — so a
    # child-side chdir to `/app` silently lands in `/`.
    #
    # And it must be spelled as a HOST path through `/proc/<pid>/root`, because
    # nsenter resolves `--wd` BEFORE `-r` takes effect: a plain `--wd=/app` is
    # looked up on the host and dies with "cannot open /app: No such file or
    # directory" for a directory that exists only in the container. Routing it
    # through /proc/<pid>/root resolves into the container's filesystem while
    # still being a valid host path, and the resulting cwd is correct after the
    # root change (verified on util-linux 2.42.2).
    #
    # Bare `-w` — the target's own cwd — is the default. Omitting the flag
    # entirely is NOT the same: the cwd then stays whatever the caller's was,
    # which does not exist under the new root, and getcwd() inside the container
    # fails outright.
    if (_rt_nonempty(workdir) == 1) {
        # Refuse before splicing, not after: an unvalidated `..` here is a
        # container escape, not a bad path. See _rt_workdir_is_safe.
        if (_rt_workdir_is_safe(workdir) == 0) {
            stiva_err_print(STIVA_ERR_INVALID_STATE,
              _rt_cat2("exec workdir must be an absolute path inside the container, free of '..': ", workdir));
            return 0;
        }
        var wd = _rt_cat2(_rt_cat2("--wd=/proc/", _rt_int_to_cstr(pid)), "/root");
        vec_push(args, _rt_cat2(wd, workdir));
    } else {
        vec_push(args, "-w");
    }
    if (_rt_userns_differs(pid) == 1) {
        # ROOTLESS — the container owns a user namespace we are outside of.
        #
        # This whole branch is a divergence, and without it `exec` cannot work
        # in the mode stiva actually runs in. The oracle's fixed
        # `-p -m -n -u -i` assumes a privileged daemon; unprivileged it fails
        # with "reassociate to namespaces failed: Operation not permitted" for
        # every one of those flags.
        #
        # `--preserve-credentials` is required, not optional: without it nsenter
        # tries to setgroups() on entry, which an unprivileged user namespace
        # denies (/proc/<pid>/setgroups is "deny"), and the exec dies before it
        # starts. With it we keep our own credentials and therefore gain no
        # capabilities inside the namespace — which is why the network, UTS and
        # IPC namespaces are NOT entered here. Joining them needs CAP_SYS_ADMIN
        # in the owning user namespace, which is exactly what preserving
        # credentials gives up. Mount + user + root is the reachable set, and it
        # is the set that matters for exec: the container's filesystem and its
        # processes.
        vec_push(args, "-U");
        vec_push(args, "--preserve-credentials");
        vec_push(args, "-m");
    } else {
        # PRIVILEGED — the oracle's full set (rust-old/src/runtime.rs:507-511).
        vec_push(args, "-p");                 # PID namespace
        vec_push(args, "-m");                 # mount
        vec_push(args, "-n");                 # network
        vec_push(args, "-u");                 # UTS
        vec_push(args, "-i");                 # IPC
    }
    vec_push(args, "--");
    var ci = 0;
    while (ci < vec_len(command)) {
        vec_push(args, vec_get(command, ci));
        ci = ci + 1;
    }

    var lm = _rt_cat2("exec into running container via nsenter, pid=", _rt_int_to_cstr(pid));
    sakshi_info(lm, strlen(lm));

    # Per-EXEC, not per-container: keying the scratch file on the container's pid
    # alone meant two concurrent execs into one container shared it, and one
    # exec's stderr was silently lost. A monotonic counter makes each exec's path
    # distinct within a process; the pid keeps it distinct across processes.
    var err_path = _rt_exec_err_path(root, _rt_exec_tag(pid));
    # Clear it before the fork: O_EXCL in the child would otherwise FAIL on a
    # leftover and send stderr to the inherited fd 2, and the read-back would
    # return purely the stale contents — worse than appending.
    sys_unlink(err_path);
    var out_buf = alloc(_RT_EXEC_MAX_OUTPUT + 1);
    var start = mono_now_ns();
    # workdir goes to nsenter via --wd above, NOT to the child: nsenter chdirs
    # after us and would override it.
    var n = _exec_capture2(args, env, 0, out_buf, _RT_EXEC_MAX_OUTPUT, err_path);
    var dur_ms = (mono_now_ns() - start) / 1000000;

    if (n < 0) {
        sys_unlink(err_path);
        stiva_err_print(STIVA_ERR_RUNTIME, "nsenter exec failed");
        return 0;
    }
    store8(out_buf + n, 0);
    var errtext = _rt_take_file(err_path, _RT_EXEC_MAX_OUTPUT);

    var lc = _rt_cat2("exec complete, exit_code=", _rt_int_to_cstr(rt_last_exec_exit()));
    sakshi_info(lc, strlen(lc));
    return container_exec_result_new(rt_last_exec_exit(), out_buf, errtext, dur_ms, 0);
}

# ── NOT PORTED: CRIU (roadmap v3.1.0 item 3) ──
# The only rust-old/src/runtime.rs surface still missing. Everything else that
# used to live in this block — spawn_container/DaemonHandle, export_rootfs,
# import_rootfs, exec_in_container — has landed.
#
#   checkpoint_container(pid, dump_dir, leave_running)      criu dump
#   pre_dump_container(pid, dump_dir, parent_dir)           criu pre-dump
#   restore_container(dump_dir, rootfs) -> pid              criu restore
#   restore_lazy(dump_dir, rootfs, page_server_addr) -> pid criu lazy restore
#
# The port is straightforward — the oracle shells out to the `criu` binary and
# `criu_available()` is already ported here. What blocks it is one layer down:
# every stiva container runs in the HOST pid namespace, because `NS_PID` is set
# by no caller and `build_sandbox` never forwards the spec's namespace list (so
# `RUNTIME_NS_PID` above is decorative). `criu restore` would have to re-claim
# the exact host PIDs via /proc/sys/kernel/ns_last_pid — racy by construction.
# kavach must honour the namespace list first. See the roadmap.

# --- container.cyr ---

# stiva — container lifecycle: state, config, records, log rotation.
# Ported from rust-old/src/container.rs.
#
# This module carries the self-contained, synchronous surface of
# container.rs: the ContainerState enum (+ serde names), the Container /
# ContainerConfig / MigrationBundle records and their defaults/constructors,
# the pure log-rotation and log-tail helpers, and the state-validation
# (require_pid) and persisted-state-fixup logic.
#
# The async, stateful `ContainerManager` (tokio RwLock over a
# HashMap<String, Container>, majra PubSub lifecycle events, NetworkManager
# connect/disconnect, and all lifecycle methods that drive runtime's async
# exec/spawn/kill/checkpoint) is DEFERRED — it needs an async runtime,
# pub/sub, and shared-lock infra the ported base does not yet have. See the
# DEFERRED block at the bottom (matches the storage/registry precedent).
#
# Enum members are namespaced `CONTAINER_STATE_*` so Cyrius's global
# member-hoisting ("last def wins") cannot silently collide with a dep's
# member of the same bare name (same convention as error.cyr).

# ── ContainerState (rust-old: enum ContainerState) ──────────────

# Container lifecycle state. `#[non_exhaustive]` in Rust; the variant set
# and ordinals are the parity oracle.
enum ContainerState {
    CONTAINER_STATE_CREATED = 0;
    CONTAINER_STATE_RUNNING = 1;
    CONTAINER_STATE_PAUSED = 2;
    CONTAINER_STATE_STOPPED = 3;
    CONTAINER_STATE_REMOVING = 4;
}

# Serde wire name for a ContainerState. Serde derives PascalCase variant
# names for this enum (no `rename`), so the JSON tokens are "Created",
# "Running", "Paused", "Stopped", "Removing".
#[must_use]
fn container_state_name(state) {
    if (state == CONTAINER_STATE_CREATED) { return "Created"; }
    if (state == CONTAINER_STATE_RUNNING) { return "Running"; }
    if (state == CONTAINER_STATE_PAUSED) { return "Paused"; }
    if (state == CONTAINER_STATE_STOPPED) { return "Stopped"; }
    if (state == CONTAINER_STATE_REMOVING) { return "Removing"; }
    return "unknown";
}

# Parse a serde wire name back to a ContainerState ordinal, or -1 if the
# token is not a known state (mirrors serde_json::from_str round-trip).
#[must_use]
fn container_state_from_name(name) {
    if (streq(name, "Created") == 1) { return CONTAINER_STATE_CREATED; }
    if (streq(name, "Running") == 1) { return CONTAINER_STATE_RUNNING; }
    if (streq(name, "Paused") == 1) { return CONTAINER_STATE_PAUSED; }
    if (streq(name, "Stopped") == 1) { return CONTAINER_STATE_STOPPED; }
    if (streq(name, "Removing") == 1) { return CONTAINER_STATE_REMOVING; }
    return 0 - 1;
}

# ── ContainerConfig (rust-old: struct ContainerConfig) ────────────

# Default SIGTERM→SIGKILL grace period, in milliseconds (rust-old:
# default_stop_grace_ms = 10_000). The serde default for stop_grace_ms.
#[must_use]
fn default_stop_grace_ms() {
    return 10000;
}

# Container creation configuration.
#
# Optional Rust fields (`Option<String>`, `Option<u8>`) are represented as
# a cstr pointer or 0 for None; `Vec<String>` / `HashMap` fields hold a vec
# / hashmap handle (0 = empty until populated); the kavach `secrets` vec and
# `scan_policy` Option hold kavach bundle handles (0 = none). `bool` fields
# are 0/1. Field ordering matches the Rust struct for clarity.
struct ContainerConfig {
    name;                 # Option<String>  → cstr | 0
    command;              # Vec<String>     → vec handle
    env;                  # HashMap<String,String> → hashmap handle
    volumes;              # Vec<String>
    ports;                # Vec<String>
    network;              # Option<String>  → cstr | 0
    memory_limit;         # u64
    cpu_shares;           # u64
    max_pids;             # u32
    user;                 # Option<String>  → cstr | 0
    workdir;              # Option<String>  → cstr | 0
    detach;               # bool 0/1
    stop_grace_ms;        # u64
    rootless;             # bool 0/1
    secrets;              # Vec<kavach::SecretRef> → vec handle
    scan_policy;          # Option<kavach::ExternalizationPolicy> → handle | 0
    timeout_ms;           # u64
    backend;              # Option<String>  → cstr | 0
    min_isolation_score;  # Option<u8>      → int (0..100) | -1 for None
    agent_id;             # Option<String>  → cstr | 0
    domainname;           # Option<String>  → cstr | 0
    annotations;          # HashMap<String,String> → hashmap handle
    seccomp_profile;      # Option<String>  → cstr | 0
    log_max_bytes;        # u64
    log_max_files;        # u32
}

# Allocate a ContainerConfig with the Rust `Default` values: everything
# empty/None/0/false except stop_grace_ms = default_stop_grace_ms(), and
# min_isolation_score encoded as -1 (None). 25 fields × 8 bytes = 200.
#[must_use]
fn container_config_default() {
    var p = alloc(200);
    var c: ContainerConfig = p;
    c.name = 0;
    c.command = 0;
    c.env = 0;
    c.volumes = 0;
    c.ports = 0;
    c.network = 0;
    c.memory_limit = 0;
    c.cpu_shares = 0;
    c.max_pids = 0;
    c.user = 0;
    c.workdir = 0;
    c.detach = 0;
    c.stop_grace_ms = default_stop_grace_ms();
    c.rootless = 0;
    c.secrets = 0;
    c.scan_policy = 0;
    c.timeout_ms = 0;
    c.backend = 0;
    c.min_isolation_score = 0 - 1;
    c.agent_id = 0;
    c.domainname = 0;
    c.annotations = 0;
    c.seccomp_profile = 0;
    c.log_max_bytes = 0;
    c.log_max_files = 0;
    return p;
}

# ── Container (rust-old: struct Container) ─────────────────

# A container instance. `state` is a CONTAINER_STATE_* ordinal; `pid` is a
# PID or -1 for None; `created_at` / `started_at` are epoch-millis i64
# (chrono::DateTime<Utc> in Rust; -1 for started_at = None); `config` is a
# ContainerConfig*; `exit_code` is the process exit code or -1 for None.
struct Container {
    id;          # String
    name;        # Option<String> → cstr | 0
    image_id;    # String
    image_ref;   # String (image_ref_full_ref of the source image)
    state;       # ContainerState ordinal
    pid;         # Option<u32> → pid | -1
    created_at;  # DateTime<Utc> → epoch millis
    started_at;  # Option<DateTime<Utc>> → epoch millis | -1
    config;      # ContainerConfig*
    exit_status; # Option<i32> → exit code | -1. NB: named exit_status, NOT
    # exit_code, to avoid a cycc field-name/offset collision with
    # ContainerExecResult.exit_code (@0) that mis-resolves reads in a
    # large compilation unit. JSON key stays "exit_code" (Rust parity).
    start_ticks; # /proc/<pid>/stat field 22 (starttime) captured at spawn, or 0.
    # Guards against pid REUSE: after `run -d` the container outlives
    # this process and is reparented to init, so a later `stiva stop`
    # has only the pid to go on — and a recycled pid would look alive
    # and be signalled, killing an unrelated process. APPENDED at
    # offset 80 so no existing field offset moves (the same
    # append-only discipline Image.manifest_digest follows).
}

# Construct a Container record (rust-old: struct literal in `create`).
#[must_use]
fn container_new(id, name, image_id, image_ref, state, pid, created_at, started_at, config, exit_code) {
    var p = alloc(88);          # 11 fields (start_ticks appended at 80)
    var c: Container = p;
    c.id = id;
    c.name = name;
    c.image_id = image_id;
    c.image_ref = image_ref;
    c.state = state;
    c.pid = pid;
    c.created_at = created_at;
    c.started_at = started_at;
    c.config = config;
    c.exit_status = exit_code;
    c.start_ticks = 0;
    return p;
}

# On daemon restart, a container that was persisted as Running or Paused is
# now Stopped (its process is gone) with no PID. This is the per-record
# fixup applied by rust-old `load_persisted_state`. Mutates `c` in place and
# returns 1 if it changed the record, else 0.
# /proc/<pid>/stat field 22 (starttime, in clock ticks since boot), or 0 when
# the pid is gone or unreadable.
#
# Field 2 is the executable name in parentheses and MAY CONTAIN SPACES and
# parens, so the fields are counted from the LAST ')' rather than by splitting
# the whole line — the classic way to misparse /proc/pid/stat.
#[must_use]
fn _cm_proc_start_ticks(pid) {
    if (pid <= 0) { return 0; }
    var path = _container_cat2(_container_cat2("/proc/", _rt_int_to_cstr(pid)), "/stat");
    var buf = alloc(4096);
    var n = file_read_all(path, buf, 4095);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    # Find the last ')': everything after it is space-separated and fixed-position.
    var close = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 41) { close = i; }
        i = i + 1;
    }
    if (close < 0) { return 0; }
    # After ')' comes " S" (field 3). starttime is field 22, so it is the 20th
    # whitespace-separated token following the ')'.
    var field = 2;
    var j = close + 1;
    while (j < n) {
        while (j < n && load8(buf + j) == 32) { j = j + 1; }
        if (j >= n) { return 0; }
        field = field + 1;
        var start = j;
        while (j < n && load8(buf + j) != 32) { j = j + 1; }
        if (field == 22) {
            store8(buf + j, 0);
            return atoi(buf + start);
        }
    }
    return 0;
}

# 1 when `pid` is alive AND is still the process we started — the recorded
# starttime must match. Without the starttime check a recycled pid reads as a
# live container and `stop` signals whatever now owns that pid.
#[must_use]
fn container_pid_is_ours(pid, start_ticks) {
    if (pid <= 0) { return 0; }
    var now = _cm_proc_start_ticks(pid);
    if (now == 0) { return 0; }                 # gone
    if (start_ticks == 0) { return 0; }         # nothing recorded — assume not ours
    if (now != start_ticks) { return 0; }       # pid reused
    return 1;
}

# Stop a detached container we did NOT spawn — the cross-process case.
#
# `internals` is in-memory only, so a second `stiva` process has no
# SpawnedProcess handle and cannot use spawned_terminate: all it has is
# (pid, start_ticks) from state.json. It also cannot waitpid — after the
# spawning process exits the child is reparented to init, which reaps it — so
# liveness is polled with the same starttime-checked probe rather than reaped.
#
# Returns 1 when the process is gone afterwards, 0 when it survived SIGKILL
# (which would mean an uninterruptible state, not a missed signal).
fn _cm_stop_by_pid(pid, start_ticks, grace_ms) {
    if (container_pid_is_ours(pid, start_ticks) == 0) { return 1; }   # already gone
    sys_kill(pid, 15);                                    # SIGTERM
    var waited = 0;
    while (waited < grace_ms) {
        if (container_pid_is_ours(pid, start_ticks) == 0) { return 1; }
        sleep_ms(20);
        waited = waited + 20;
    }
    sys_kill(pid, 9);                                     # SIGKILL
    var settle = 0;
    while (settle < 500) {
        if (container_pid_is_ours(pid, start_ticks) == 0) { return 1; }
        sleep_ms(20);
        settle = settle + 20;
    }
    return 0;
}

fn container_fixup_after_restart(c) {
    var cc: Container = c;
    if (cc.state == CONTAINER_STATE_RUNNING || cc.state == CONTAINER_STATE_PAUSED) {
        # A DETACHED container genuinely outlives the process that started it —
        # it is reparented to init and keeps running. Blanket-marking it STOPPED
        # (correct when nothing could outlive us) would make `ps` lie and `stop`
        # a no-op. So probe: still alive and still OUR process → leave it be.
        if (container_pid_is_ours(cc.pid, cc.start_ticks) == 1) { return 0; }
        cc.state = CONTAINER_STATE_STOPPED;
        cc.pid = 0 - 1;
        return 1;
    }
    return 0;
}

# ── MigrationBundle (rust-old: struct MigrationBundle) ────────────

# Everything needed to transfer a container to another node.
struct MigrationBundle {
    source_container_id;  # String
    image_ref;            # String
    config;               # ContainerConfig*
    checkpoint_dir;       # PathBuf → cstr path
    source_node;          # String
    prepared_at;          # DateTime<Utc> → epoch millis
}

#[must_use]
fn migration_bundle_new(source_container_id, image_ref, config, checkpoint_dir, source_node, prepared_at) {
    var p = alloc(48);
    var b: MigrationBundle = p;
    b.source_container_id = source_container_id;
    b.image_ref = image_ref;
    b.config = config;
    b.checkpoint_dir = checkpoint_dir;
    b.source_node = source_node;
    b.prepared_at = prepared_at;
    return p;
}

# ── State validation (rust-old: ContainerManager::require_pid) ────

# True (1) iff `state` appears in the `allowed` vec of CONTAINER_STATE_*
# ordinals (length `n`). Mirrors `allowed_states.contains(&state)`.
#[must_use]
fn _container_state_allowed(state, allowed, n) {
    var i = 0;
    for (i = 0; i < n; i = i + 1) {
        if (vec_get(allowed, i) == state) { return 1; }
    }
    return 0;
}

# The pure decision of rust-old `require_pid`, minus the map lookup and lock.
# Given a container's `state` and `pid` (pid = -1 for None), and the set of
# `allowed` states (vec of length `n`), returns:
#   pid  (>= 0)  → allowed and has a PID
#   -1           → wrong state OR no PID; both are `StivaError::InvalidState`
#                  in rust-old, so the caller reports via
#                  stiva_err_print(STIVA_ERR_INVALID_STATE, detail).
# The caller supplies the ContainerNotFound branch (missing from the map) and
# builds the context string.
#[must_use]
fn container_require_pid(state, pid, allowed, n) {
    if (_container_state_allowed(state, allowed, n) == 0) {
        return 0 - 1;
    }
    if (pid < 0) {
        return 0 - 1;
    }
    return pid;
}

# ── Log rotation (rust-old: rotate_logs) ──────────────────

# Build "container.log.<n>" (the with_extension("log.{n}") path names).
# `log_path` is the base ".../container.log" cstr; the rotated sibling
# replaces the "log" extension. rust-old uses `Path::with_extension`, which
# swaps the final extension: "…/container.log" → "…/container.log.N".
#[must_use]
fn _container_rotated_path(log_path, n) {
    var dot = _container_cat2(log_path, ".");
    var num = _container_int_to_cstr(n);
    return _container_cat2(dot, num);
}

# Rotate log files: container.log → .1 → .2 → … → .N (oldest deleted).
# Mirrors rust-old `rotate_logs`: remove the .max_files file, shift
# .N-1→.N down to .1→.2, then move the live log to .1. All fs ops are
# best-effort (errors ignored), matching the Rust `let _ =`.
fn rotate_logs(log_path, max_files) {
    # Delete the oldest rotated file.
    var oldest = _container_rotated_path(log_path, max_files);
    sys_unlink(oldest);

    # Shift existing rotated files downward: N-1 → N, … , 1 → 2.
    var i = max_files - 1;
    while (i >= 1) {
        var from = _container_rotated_path(log_path, i);
        var to = _container_rotated_path(log_path, i + 1);
        if (file_exists(from) == 1) {
            sys_rename(from, to);
        }
        i = i - 1;
    }

    # Move the current log to .1.
    var first = _container_rotated_path(log_path, 1);
    sys_rename(log_path, first);
    return 0;
}

# Decide whether a pending write should trigger rotation (rust-old
# write_log guard): rotate iff log_max_bytes > 0 AND log_max_files > 0 AND
# current_size + pending_len > log_max_bytes. Returns 1 to rotate, else 0.
#[must_use]
fn container_should_rotate(log_max_bytes, log_max_files, current_size, pending_len) {
    if (log_max_bytes <= 0) { return 0; }
    if (log_max_files <= 0) { return 0; }
    if (current_size + pending_len > log_max_bytes) { return 1; }
    return 0;
}

# ── log_tail line math (rust-old: ContainerManager::log_tail) ─────

# The saturating start index for tailing `total` lines down to the last
# `want` (rust-old: `all_lines.len().saturating_sub(lines)`). Never negative.
#[must_use]
fn container_tail_start(total, want) {
    if (want >= total) { return 0; }
    return total - want;
}

# Read a container log file and return the last `n` lines (rust-old: log_tail;
# content.lines() + saturating_sub). n <= 0 → the whole file. Returns a cstr
# pointer (into the read buffer), or 0 if the log file is absent. 4 MiB cap.
fn container_log_tail(log_path, n) {
    var cap = 4194304;
    var buf = alloc(cap);
    var len = file_read_all(log_path, buf, cap - 1);
    if (len < 0) { return 0; }
    store8(buf + len, 0);
    if (n <= 0) { return buf; }

    # total line count (lines() ignores a single trailing newline).
    var nl = 0;
    var i = 0;
    while (i < len) {
        if (load8(buf + i) == 10) { nl = nl + 1; }
        i = i + 1;
    }
    var total = nl;
    if (len > 0 && load8(buf + len - 1) != 10) { total = total + 1; }

    var start = container_tail_start(total, n);
    if (start <= 0) { return buf; }
    # advance past `start` newlines to the start of the tail.
    var seen = 0;
    var pos = 0;
    while (pos < len && seen < start) {
        if (load8(buf + pos) == 10) { seen = seen + 1; }
        pos = pos + 1;
    }
    return buf + pos;
}

# ── small local string helpers (no external deps) ───────────────

# Format a non-negative i64 as a fresh decimal NUL-terminated cstr. Used
# to build rotated-log path suffixes (rust-old uses format!("log.{n}")).
#[must_use]
fn _container_int_to_cstr(n) {
    if (n == 0) {
        var z = alloc(2);
        store8(z, 48);
        store8(z + 1, 0);
        return z;
    }
    # Count digits.
    var digits = 0;
    var t = n;
    while (t > 0) { digits = digits + 1; t = t / 10; }
    var out = alloc(digits + 1);
    store8(out + digits, 0);
    var i = digits - 1;
    var v = n;
    while (i >= 0) {
        store8(out + i, 48 + v % 10);
        v = v / 10;
        i = i - 1;
    }
    return out;
}

# Concatenate two NUL-terminated cstrings into a fresh heap cstr.
#[must_use]
fn _container_cat2(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    var out = alloc(la + lb + 1);
    memcpy(out, a, la);
    memcpy(out + la, b, lb);
    store8(out + la + lb, 0);
    return out;
}

# ── Container state persistence (rust-old: state.json round-trip) ─────
# The ContainerManager is in this file (§C); its DISK format is independent of
# it: state.json is a JSON array of Container records
# (serde_json Vec<Container>). These fns implement the SYNCHRONOUS save/load
# used by the single-shot CLI, via the bayan JSON codec (same pattern as
# image.cyr's images.json index).
#
# Divergences (documented): `secrets` (Vec<kavach::SecretRef>) and `scan_policy`
# are runtime handles with no persisted meaning here — serialized as [] / null
# and dropped on load (re-injected at start in v3.1). `created_at`/`started_at`
# are epoch-millis ints (the port's convention), not chrono RFC3339 strings.

# cstr → JSON string value, or JSON null when 0 (Option<String>=None).
fn _ct_str_or_null(s) {
    if (s == 0) { return json_v_null(); }
    return json_v_str_new(str_from(s));
}

# i64 → JSON int, or JSON null when the -1 None sentinel (pid/started_at/exit_code/score).
fn _ct_int_or_null(v) {
    if (v == 0 - 1) { return json_v_null(); }
    return json_v_int_new(v);
}

# vec of cstr → JSON array of strings (empty array when 0).
fn _ct_vec_str_to_jv(vec) {
    var a = json_v_arr_new();
    if (vec == 0) { return a; }
    var n = vec_len(vec);
    var i = 0;
    while (i < n) {
        json_v_arr_push(a, json_v_str_new(str_from(vec_get(vec, i))));
        i = i + 1;
    }
    return a;
}

# hashmap (cstr keys+vals) → JSON object (empty object when 0).
fn _ct_map_to_jv(m) {
    var o = json_v_obj_new();
    if (m == 0) { return o; }
    var keys = map_keys(m);
    var n = vec_len(keys);
    var i = 0;
    while (i < n) {
        var k = vec_get(keys, i);
        json_v_obj_set(o, str_from(k), json_v_str_new(str_from(map_get(m, k))));
        i = i + 1;
    }
    return o;
}

# ── scan_policy round-trip (roadmap v3.0.17 item 3) ────────
#
# The field used to serialize as `null` and read back as 0, so a per-container
# externalization policy never survived a save/load. That is why `stiva logs
# --scan` is an explicit flag: the oracle gates scanning on the PERSISTED value
# (rust-old/src/container.rs:1210-1222) and the port had nothing to read.
#
# kavach's `ExternalizationPolicy` is five scalars, so this is a plain object —
# no handle smuggling, and a policy written by one stiva build is readable by
# the next.
#
# Absent or null → 0, meaning "no per-container policy", which is what every
# existing state.json on disk already says. The upgrade is silent and lossless
# in both directions.
#[must_use]
fn _ct_scan_policy_to_jv(p) {
    if (p == 0) { return json_v_null(); }
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("enabled"), json_v_int_new(ExternalizationPolicy_enabled(p)));
    json_v_obj_set(o, str_from("max_artifact_size_bytes"),
      json_v_int_new(ExternalizationPolicy_max_artifact_size_bytes(p)));
    json_v_obj_set(o, str_from("block_threshold"),
      json_v_int_new(ExternalizationPolicy_block_threshold(p)));
    json_v_obj_set(o, str_from("quarantine_threshold"),
      json_v_int_new(ExternalizationPolicy_quarantine_threshold(p)));
    json_v_obj_set(o, str_from("redact_secrets"),
      json_v_int_new(ExternalizationPolicy_redact_secrets(p)));
    return o;
}

# Rebuild a policy from its JSON object, or 0 when absent/null/not an object.
# Starts from `ext_policy_default()` so a field the writer omitted keeps kavach's
# default rather than becoming 0 — a 0 `block_threshold` would silently BLOCK
# every artifact, the opposite of a missing field's intent.
#[must_use]
fn _ct_scan_policy_from_jv(v) {
    if (v == 0) { return 0; }
    if (json_v_is_obj(v) == 0) { return 0; }
    var p = ext_policy_default();
    var e = json_v_obj_get(v, "enabled");
    if (e != 0) { ExternalizationPolicy_set_enabled(p, json_v_int(e)); }
    var m = json_v_obj_get(v, "max_artifact_size_bytes");
    if (m != 0) { ExternalizationPolicy_set_max_artifact_size_bytes(p, json_v_int(m)); }
    var b = json_v_obj_get(v, "block_threshold");
    if (b != 0) { ExternalizationPolicy_set_block_threshold(p, json_v_int(b)); }
    var q = json_v_obj_get(v, "quarantine_threshold");
    if (q != 0) { ExternalizationPolicy_set_quarantine_threshold(p, json_v_int(q)); }
    var r = json_v_obj_get(v, "redact_secrets");
    if (r != 0) { ExternalizationPolicy_set_redact_secrets(p, json_v_int(r)); }
    return p;
}

# ContainerConfig* → JSON object.
fn _container_config_to_jv(config) {
    var c: ContainerConfig = config;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("name"), _ct_str_or_null(c.name));
    json_v_obj_set(o, str_from("command"), _ct_vec_str_to_jv(c.command));
    json_v_obj_set(o, str_from("env"), _ct_map_to_jv(c.env));
    json_v_obj_set(o, str_from("volumes"), _ct_vec_str_to_jv(c.volumes));
    json_v_obj_set(o, str_from("ports"), _ct_vec_str_to_jv(c.ports));
    json_v_obj_set(o, str_from("network"), _ct_str_or_null(c.network));
    json_v_obj_set(o, str_from("memory_limit"), json_v_int_new(c.memory_limit));
    json_v_obj_set(o, str_from("cpu_shares"), json_v_int_new(c.cpu_shares));
    json_v_obj_set(o, str_from("max_pids"), json_v_int_new(c.max_pids));
    json_v_obj_set(o, str_from("user"), _ct_str_or_null(c.user));
    json_v_obj_set(o, str_from("workdir"), _ct_str_or_null(c.workdir));
    json_v_obj_set(o, str_from("detach"), json_v_bool_new(c.detach));
    json_v_obj_set(o, str_from("stop_grace_ms"), json_v_int_new(c.stop_grace_ms));
    json_v_obj_set(o, str_from("rootless"), json_v_bool_new(c.rootless));
    json_v_obj_set(o, str_from("secrets"), json_v_arr_new());     # roadmap v3.1.0 item 1
    json_v_obj_set(o, str_from("scan_policy"), _ct_scan_policy_to_jv(c.scan_policy));
    json_v_obj_set(o, str_from("timeout_ms"), json_v_int_new(c.timeout_ms));
    json_v_obj_set(o, str_from("backend"), _ct_str_or_null(c.backend));
    json_v_obj_set(o, str_from("min_isolation_score"), _ct_int_or_null(c.min_isolation_score));
    json_v_obj_set(o, str_from("agent_id"), _ct_str_or_null(c.agent_id));
    json_v_obj_set(o, str_from("domainname"), _ct_str_or_null(c.domainname));
    json_v_obj_set(o, str_from("annotations"), _ct_map_to_jv(c.annotations));
    json_v_obj_set(o, str_from("seccomp_profile"), _ct_str_or_null(c.seccomp_profile));
    json_v_obj_set(o, str_from("log_max_bytes"), json_v_int_new(c.log_max_bytes));
    json_v_obj_set(o, str_from("log_max_files"), json_v_int_new(c.log_max_files));
    return o;
}

# Container* → JSON object (rust-old: serde on Container).
fn container_to_jv(container) {
    var ct: Container = container;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("id"), json_v_str_new(str_from(ct.id)));
    json_v_obj_set(o, str_from("name"), _ct_str_or_null(ct.name));
    json_v_obj_set(o, str_from("image_id"), json_v_str_new(str_from(ct.image_id)));
    json_v_obj_set(o, str_from("image_ref"), json_v_str_new(str_from(ct.image_ref)));
    json_v_obj_set(o, str_from("state"), json_v_str_new(str_from(container_state_name(ct.state))));
    json_v_obj_set(o, str_from("pid"), _ct_int_or_null(ct.pid));
    json_v_obj_set(o, str_from("created_at"), json_v_int_new(ct.created_at));
    json_v_obj_set(o, str_from("started_at"), _ct_int_or_null(ct.started_at));
    json_v_obj_set(o, str_from("config"), _container_config_to_jv(ct.config));
    json_v_obj_set(o, str_from("exit_code"), _ct_int_or_null(ct.exit_status));
    json_v_obj_set(o, str_from("start_ticks"), json_v_int_new(ct.start_ticks));
    return o;
}

# Read a JSON string field as a fresh cstr, or 0 if absent/null/non-string.
fn _ct_jv_str(v, key) {
    var f = json_v_obj_get(v, key);
    if (f == 0) { return 0; }
    if (json_v_is_str(f) == 0) { return 0; }
    return str_cstr(json_v_str(f));
}

# Read a JSON int field, or `dflt` if absent/null.
fn _ct_jv_int_or(v, key, dflt) {
    var f = json_v_obj_get(v, key);
    if (f == 0) { return dflt; }
    if (json_v_is_null(f) == 1) { return dflt; }
    return json_v_int(f);
}

# Read a JSON bool field as 1/0 (0 if absent).
fn _ct_jv_bool(v, key) {
    var f = json_v_obj_get(v, key);
    if (f == 0) { return 0; }
    if (json_v_is_bool(f) == 1) { return json_v_bool(f); }
    return 0;
}

# Read a JSON string array as a vec of cstr (empty vec if absent).
fn _ct_jv_vec_str(v, key) {
    var out = vec_new();
    var a = json_v_obj_get(v, key);
    if (a == 0) { return out; }
    if (json_v_is_arr(a) == 0) { return out; }
    var n = json_v_arr_len(a);
    var i = 0;
    while (i < n) {
        var e = json_v_arr_get(a, i);
        if (json_v_is_str(e) == 1) { vec_push(out, str_cstr(json_v_str(e))); }
        i = i + 1;
    }
    return out;
}

# Read a JSON object as a hashmap (cstr keys), or 0 when absent/empty.
fn _ct_jv_map(v, key) {
    var o = json_v_obj_get(v, key);
    if (o == 0) { return 0; }
    if (json_v_is_obj(o) == 0) { return 0; }
    var n = json_v_obj_len(o);
    if (n == 0) { return 0; }
    var m = map_new();
    var i = 0;
    while (i < n) {
        var val = json_v_obj_val(o, i);
        if (json_v_is_str(val) == 1) {
            map_set(m, str_cstr(json_v_obj_key(o, i)), str_cstr(json_v_str(val)));
        }
        i = i + 1;
    }
    return m;
}

# JSON object → ContainerConfig* (rust-old: deserialize ContainerConfig).
fn _container_config_from_jv(v) {
    var config = container_config_default();
    if (v == 0) { return config; }
    var c: ContainerConfig = config;
    c.name = _ct_jv_str(v, "name");
    c.command = _ct_jv_vec_str(v, "command");
    c.env = _ct_jv_map(v, "env");
    c.volumes = _ct_jv_vec_str(v, "volumes");
    c.ports = _ct_jv_vec_str(v, "ports");
    c.network = _ct_jv_str(v, "network");
    c.memory_limit = _ct_jv_int_or(v, "memory_limit", 0);
    c.cpu_shares = _ct_jv_int_or(v, "cpu_shares", 0);
    c.max_pids = _ct_jv_int_or(v, "max_pids", 0);
    c.user = _ct_jv_str(v, "user");
    c.workdir = _ct_jv_str(v, "workdir");
    c.detach = _ct_jv_bool(v, "detach");
    c.stop_grace_ms = _ct_jv_int_or(v, "stop_grace_ms", default_stop_grace_ms());
    c.rootless = _ct_jv_bool(v, "rootless");
    c.secrets = 0;                                       # roadmap v3.1.0 item 1
    c.scan_policy = _ct_scan_policy_from_jv(json_v_obj_get(v, "scan_policy"));
    c.timeout_ms = _ct_jv_int_or(v, "timeout_ms", 0);
    c.backend = _ct_jv_str(v, "backend");
    c.min_isolation_score = _ct_jv_int_or(v, "min_isolation_score", 0 - 1);
    c.agent_id = _ct_jv_str(v, "agent_id");
    c.domainname = _ct_jv_str(v, "domainname");
    c.annotations = _ct_jv_map(v, "annotations");
    c.seccomp_profile = _ct_jv_str(v, "seccomp_profile");
    c.log_max_bytes = _ct_jv_int_or(v, "log_max_bytes", 0);
    c.log_max_files = _ct_jv_int_or(v, "log_max_files", 0);
    return config;
}

# JSON object → Container* (rust-old: deserialize Container). 0 if id is missing.
fn container_from_jv(v) {
    if (v == 0) { return 0; }
    var id = _ct_jv_str(v, "id");
    if (id == 0) { return 0; }
    var name = _ct_jv_str(v, "name");
    var image_id = _ct_jv_str(v, "image_id");
    if (image_id == 0) { image_id = ""; }
    var image_ref = _ct_jv_str(v, "image_ref");
    if (image_ref == 0) { image_ref = ""; }
    var state = CONTAINER_STATE_CREATED;
    var sname = _ct_jv_str(v, "state");
    if (sname != 0) {
        var s = container_state_from_name(sname);
        if (s != 0 - 1) { state = s; }
    }
    var pid = _ct_jv_int_or(v, "pid", 0 - 1);
    var created_at = _ct_jv_int_or(v, "created_at", 0);
    var started_at = _ct_jv_int_or(v, "started_at", 0 - 1);
    var config = _container_config_from_jv(json_v_obj_get(v, "config"));
    var exit_code = _ct_jv_int_or(v, "exit_code", 0 - 1);
    var rec = container_new(id, name, image_id, image_ref, state, pid, created_at, started_at, config, exit_code);
    # Records written before start_ticks existed decode as 0, which
    # container_pid_is_ours reads as "not ours" — so an old RUNNING record still
    # gets the safe STOPPED fixup rather than being trusted.
    var rr: Container = rec;
    rr.start_ticks = _ct_jv_int_or(v, "start_ticks", 0);
    return rec;
}

# Persist a vec of Container* to `{root}/state.json` (atomic tmp+rename).
# Best-effort: returns 1 on success, 0 on write/rename failure (only warns).
fn container_state_save(root, containers) {
    var arr = json_v_arr_new();
    var n = vec_len(containers);
    var i = 0;
    while (i < n) {
        json_v_arr_push(arr, container_to_jv(vec_get(containers, i)));
        i = i + 1;
    }
    var s = json_v_build_pretty(arr, 2);
    var path = _container_cat2(root, "/state.json");
    var tmp = _container_cat2(path, ".tmp");
    if (file_write_all(tmp, str_data(s), str_len(s)) < 0) {
        sakshi_warn("failed to write container state", strlen("failed to write container state"));
        return 0;
    }
    if (sys_rename(tmp, path) < 0) {
        sakshi_warn("failed to rename container state file", strlen("failed to rename container state file"));
        return 0;
    }
    return 1;
}

# Load container records from `{root}/state.json` (rust-old: load_persisted_state).
# Applies the Running/Paused → Stopped, pid → -1 restart fixup. A missing/
# unparseable file yields a fresh empty vec.
fn container_state_load(root) {
    var out = vec_new();
    var path = _container_cat2(root, "/state.json");
    if (file_exists(path) == 0) { return out; }
    var cap = 16777216;
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap);
    if (n <= 0) { return out; }
    var rv = bayan_json_v_parse_buf(buf, n);
    if (rv == 0) {
        sakshi_warn("failed to parse container state, starting fresh",
          strlen("failed to parse container state, starting fresh"));
        return out;
    }
    if (json_v_is_arr(rv) == 0) { return out; }
    var cnt = json_v_arr_len(rv);
    var i = 0;
    while (i < cnt) {
        var c = container_from_jv(json_v_arr_get(rv, i));
        if (c != 0) {
            container_fixup_after_restart(c);
            vec_push(out, c);
        }
        i = i + 1;
    }
    sakshi_info("restored container state from disk", strlen("restored container state from disk"));
    return out;
}

# Find a container by id OR name in a loaded vec. Returns the Container* or 0.
fn container_state_find(containers, id) {
    var n = vec_len(containers);
    var i = 0;
    while (i < n) {
        var c = vec_get(containers, i);
        var cc: Container = c;
        if (streq(cc.id, id) == 1) { return c; }
        if (cc.name != 0 && streq(cc.name, id) == 1) { return c; }
        i = i + 1;
    }
    return 0;
}

# ── OCI runtime state (rust-old/src/oci.rs: OciState / to_oci_status /
#    build_state / parse_bundle) ──────────────────────────
# These couple oci.rs to the container.rs types (ContainerState / Container /
# ContainerConfig) and, in the port, to the bayan JSON codec — so they land
# here next to ContainerConfig construction rather than in the oci.cyr leaf.
# OCI_STATUS_* / oci_version / oci_status_name / oci_status_from_name come
# from the earlier oci.cyr module.

# OCI runtime state — the `state` command's output (rust-old: struct OciState).
# pid = -1 encodes Option<u32>::None; annotations = 0 encodes Option::None.
struct OciState {
    oci_version;  # String  → cstr
    id;           # String  → cstr
    status;       # OciStatus ordinal
    pid;          # Option<u32> → pid | -1
    bundle;       # String  → cstr
    annotations;  # Option<HashMap<String,String>> → hashmap handle | 0
}

#[must_use]
fn oci_state_new(oci_version, id, status, pid, bundle, annotations) {
    var p = alloc(48);
    var s: OciState = p;
    s.oci_version = oci_version;
    s.id = id;
    s.status = status;
    s.pid = pid;
    s.bundle = bundle;
    s.annotations = annotations;
    return p;
}

# Map internal ContainerState → OCI spec status (rust-old: to_oci_status).
# Created→Created, Running|Paused→Running, Stopped|Removing→Stopped.
#[must_use]
fn to_oci_status(state) {
    if (state == CONTAINER_STATE_CREATED) { return OCI_STATUS_CREATED; }
    if (state == CONTAINER_STATE_RUNNING) { return OCI_STATUS_RUNNING; }
    if (state == CONTAINER_STATE_PAUSED) { return OCI_STATUS_RUNNING; }
    return OCI_STATUS_STOPPED;
}

# Build the OCI state for a container (rust-old: build_state). annotations=None.
#[must_use]
fn build_state(container, bundle_path) {
    var ct: Container = container;
    return oci_state_new(oci_version(), ct.id, to_oci_status(ct.state), ct.pid,
      bundle_path, 0);
}

# OciState* → JSON object (rust-old: serde Serialize on OciState). `pid` and
# `annotations` use skip_serializing_if = Option::is_none: emitted only when set.
fn oci_state_to_jv(state) {
    var s: OciState = state;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("ociVersion"), json_v_str_new(str_from(s.oci_version)));
    json_v_obj_set(o, str_from("id"), json_v_str_new(str_from(s.id)));
    json_v_obj_set(o, str_from("status"), json_v_str_new(str_from(oci_status_name(s.status))));
    if (s.pid != 0 - 1) {
        json_v_obj_set(o, str_from("pid"), json_v_int_new(s.pid));
    }
    json_v_obj_set(o, str_from("bundle"), json_v_str_new(str_from(s.bundle)));
    if (s.annotations != 0) {
        json_v_obj_set(o, str_from("annotations"), _ct_map_to_jv(s.annotations));
    }
    return o;
}

# JSON object → OciState* (rust-old: serde Deserialize on OciState). 0 if v is 0.
fn oci_state_from_jv(v) {
    if (v == 0) { return 0; }
    var oci_version = _ct_jv_str(v, "ociVersion");
    if (oci_version == 0) { oci_version = ""; }
    var id = _ct_jv_str(v, "id");
    if (id == 0) { id = ""; }
    var status = OCI_STATUS_CREATING;
    var sname = _ct_jv_str(v, "status");
    if (sname != 0) {
        var st = oci_status_from_name(sname);
        if (st != 0 - 1) { status = st; }
    }
    var pid = _ct_jv_int_or(v, "pid", 0 - 1);
    var bundle = _ct_jv_str(v, "bundle");
    if (bundle == 0) { bundle = ""; }
    var annotations = _ct_jv_map(v, "annotations");
    return oci_state_new(oci_version, id, status, pid, bundle, annotations);
}

# Parse an OCI bundle's `config.json` into a ContainerConfig* (rust-old:
# parse_bundle). Reads {bundle_path}/config.json, extracts the fields stiva
# needs, and forces detach=true (OCI runtime containers are daemon-style).
# Returns 0 on a missing/unreadable/invalid config.json (rust-old:
# Err(StivaError::OciBundle) — the caller maps 0 → STIVA_ERR_OCI_BUNDLE).
fn parse_bundle(bundle_path) {
    var config_path = _container_cat2(bundle_path, "/config.json");
    sakshi_info("parsing OCI bundle", strlen("parsing OCI bundle"));
    if (file_exists(config_path) == 0) { return 0; }
    var cap = 1048576;
    var buf = alloc(cap);
    var n = file_read_all(config_path, buf, cap);
    if (n <= 0) { return 0; }
    var root = bayan_json_v_parse_buf(buf, n);
    if (root == 0) { return 0; }

    var config = container_config_default();
    var c: ContainerConfig = config;
    var process = json_v_obj_get(root, "process");

    # process.args → command (Vec<String>).
    var args = json_v_obj_get(process, "args");
    if (json_v_is_arr(args) == 1) {
        var cmd = vec_new();
        var na = json_v_arr_len(args);
        var i = 0;
        while (i < na) {
            var e = json_v_arr_get(args, i);
            if (json_v_is_str(e) == 1) { vec_push(cmd, str_cstr(json_v_str(e))); }
            i = i + 1;
        }
        c.command = cmd;
    }

    # process.env → env (HashMap), each "KEY=VALUE" split on the first '='.
    var env = json_v_obj_get(process, "env");
    if (json_v_is_arr(env) == 1) {
        var m = map_new();
        var ne = json_v_arr_len(env);
        var j = 0;
        while (j < ne) {
            var ee = json_v_arr_get(env, j);
            if (json_v_is_str(ee) == 1) {
                var es = json_v_str(ee);
                var eq = str_index_of(es, 61);          # '='
                if (eq >= 0) {
                    var key = str_cstr(str_substr(es, 0, eq));
                    var val = str_cstr(str_substr(es, eq + 1, str_len(es)));
                    map_set(m, key, val);
                }
            }
            j = j + 1;
        }
        c.env = m;
    }

    # process.user.uid != 0 → rootless. Rust reads uid via serde_json as_u64,
    # which is None for negatives/floats — so only a positive integer counts
    # (uid > 0 ⇔ as_u64 succeeded AND != 0).
    var uidv = json_v_obj_get(json_v_obj_get(process, "user"), "uid");
    if (json_v_is_int(uidv) == 1) {
        if (json_v_int(uidv) > 0) { c.rootless = 1; }
    }

    # hostname → domainname (OCI "hostname" maps to stiva's domainname).
    var hn = json_v_obj_get(root, "hostname");
    if (json_v_is_str(hn) == 1) { c.domainname = str_cstr(json_v_str(hn)); }

    # linux.resources.memory.limit → memory_limit. Guard >= 0 to match as_u64
    # (a negative limit is ignored by Rust, leaving the default 0).
    var res = json_v_obj_get(json_v_obj_get(root, "linux"), "resources");
    var mem = json_v_obj_get(json_v_obj_get(res, "memory"), "limit");
    if (json_v_is_int(mem) == 1 && json_v_int(mem) >= 0) { c.memory_limit = json_v_int(mem); }

    # linux.resources.pids.limit → max_pids (same as_u64 >= 0 guard).
    var pids = json_v_obj_get(json_v_obj_get(res, "pids"), "limit");
    if (json_v_is_int(pids) == 1 && json_v_int(pids) >= 0) { c.max_pids = json_v_int(pids); }

    # OCI runtime containers are always daemon-style.
    c.detach = 1;
    return config;
}

# ══ ContainerManager (rust-old/src/container.rs) ═════════════════
# The stateful lifecycle manager. The oracle's every method is `async` over
# tokio::sync::RwLock; here the single-node run-to-completion model collapses
# `Arc<RwLock<HashMap>>` to a plain heap vec + map and blocking calls, so this
# is a synchronous port, not an async one (§C). What is still missing is listed
# in docs/development/roadmap.md, not here.

# ── ContainerInternals (rust-old: struct ContainerInternals) ──────
# Runtime-only side data for a container, keyed by id in the manager's
# `internals` map. Never persisted (state.json holds only Container records).
struct ContainerInternals {
    overlay;      # OverlayPaths* | 0
    spec;         # RuntimeSpec*  | 0
    exec_result;  # ContainerExecResult* | 0 (one-shot result, cached for wait)
    log_path;     # cstr — {root}/containers/{id}/container.log
    spawned;      # DaemonHandle* | 0 — ALWAYS 0 here (detached spawn is v3.1)
}

fn container_internals_new(overlay, spec, exec_result, log_path, spawned) {
    var ci = alloc(40);
    var c: ContainerInternals = ci;
    c.overlay = overlay;
    c.spec = spec;
    c.exec_result = exec_result;
    c.log_path = log_path;
    c.spawned = spawned;
    return ci;
}

# ── ContainerManager (rust-old: struct ContainerManager) ──────────
# `containers` is deliberately a VEC (not a map): it mirrors the state.json
# array, so container_state_save/load round-trip its order byte-for-byte and
# are reused unchanged. `internals` is a cstr-keyed map (id → ContainerInternals*)
# for the runtime side table. `network_manager` is built lazily on first
# connect and stays 0 on the one-shot path.
struct ContainerManager {
    root;             # cstr
    containers;       # vec<Container*>
    internals;        # map(id -> ContainerInternals*)
    image_store;      # ImageStore* (borrowed; the facade also holds it — not freed here)
    publisher;        # PubSub* (owned; pubsub_new)
    network_manager;  # NetworkManager* | 0
}

# Open a manager rooted at `root` over `image_store` (rust-old: new). Loads any
# persisted state (with the restart fixup applied by container_state_load) and
# stands up an empty internals table + a fresh lifecycle-event bus. Returns a
# ContainerManager*, or 0 on alloc failure.
fn container_manager_new(root, image_store) {
    var m = alloc(48);
    if (m == 0) { return 0; }
    var mm: ContainerManager = m;
    mm.root = root;
    mm.containers = container_state_load(root);
    mm.internals = map_new();
    mm.image_store = image_store;
    mm.publisher = pubsub_new();
    mm.network_manager = 0;
    return m;
}

# Persist the current container set to {root}/state.json (rust-old: persist_state).
# Returns 1/0 (best-effort, matching container_state_save).
fn _cm_persist(mgr) {
    var mm: ContainerManager = mgr;
    return container_state_save(mm.root, mm.containers);
}

# List all containers (rust-old: list). Returns the live vec<Container*> — the
# manager owns it, callers must not free.
#[must_use]
fn container_manager_list(mgr) {
    var mm: ContainerManager = mgr;
    return mm.containers;
}

# Find a container by id OR name (rust-old: the HashMap get in each method).
# Returns the Container*, or 0 if absent.
#[must_use]
fn container_manager_get(mgr, id) {
    var mm: ContainerManager = mgr;
    return container_state_find(mm.containers, id);
}

# The map-lookup + ContainerNotFound wrapper around the pure container_require_pid
# decision (rust-old: require_pid). Returns the pid when the container exists and
# is in one of the `allowed` states, else -1 (the detail is printed here).
fn container_manager_require_pid(mgr, id, allowed, n) {
    var c = container_manager_get(mgr, id);
    if (c == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return 0 - 1;
    }
    var cc: Container = c;
    return container_require_pid(cc.state, cc.pid, allowed, n);
}

# ── lifecycle events (rust-old: publish_event / event_bus) ────────
# The manager owns one majra PubSub hub and publishes a JSON event on each
# lifecycle transition to the "container.lifecycle" topic. Payloads are
# non-zero JSON cstr pointers (the chan_try_recv 0-sentinel is ambiguous).

# Event timestamp: epoch MILLIS, via clock_epoch_ns (wall clock), NOT
# clock_now_ms — which lib/chrono.cyr:45 documents as monotonic (ns since boot)
# and which would make `stiva events --since $(date +%s)` compare a wall-clock
# bound against an uptime. Millis rather than seconds so events inside the same
# second still order (the oracle printed %H:%M:%S%.3f, container.rs:531).
#[must_use]
fn _cm_event_ts_ms() {
    return clock_epoch_ns() / 1000000;
}

# {"ts":<millis>,"event":<event>,"container_id":<id>,<key2>:<val2>} as a fresh
# cstr. `ts` leads so a line is orderable without a full parse.
#[must_use]
fn _cm_event_json(event, id, key2, val2) {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("ts"), json_v_int_new(_cm_event_ts_ms()));
    json_v_obj_set(o, str_from("event"), json_v_str_new(str_from(event)));
    json_v_obj_set(o, str_from("container_id"), json_v_str_new(str_from(id)));
    json_v_obj_set(o, str_from(key2), json_v_str_new(str_from(val2)));
    return str_cstr(json_v_build(o));
}

# Publish a pre-built event JSON to the lifecycle topic (rust-old: publish_event,
# container.rs:1341). Topic is the exact string "container.lifecycle".
#
# The port additionally APPENDS the payload to {root}/events.jsonl, because the
# bus alone cannot serve `stiva events` — see the event-log section below. The
# append is best-effort and never changes this function's result: an event log
# that could fail `stiva run` would be a worse liability than a missing line.
fn container_manager_publish_event(mgr, event_json) {
    var mm: ContainerManager = mgr;
    pubsub_publish(mm.publisher, "container.lifecycle", event_json);
    container_events_append(mm.root, event_json);
    return 0;
}

# ── the on-disk lifecycle event log ({root}/events.jsonl) ─────────
# The pubsub hub above is an in-process `pubsub_new()` owned by ONE
# ContainerManager and never persisted (:896). Every stiva CLI invocation is a
# separate process building its own manager, so a subscriber in one process can
# never observe a publish from another: a `stiva events` built on the bus would
# subscribe to its own empty publisher and poll forever printing nothing. The
# verb needs the property `logs -f` relies on — a file on disk, observable
# across processes — so each published event is also appended here as one JSON
# object per line (JSONL).
#
# The log is PER-ROOT, not per-container. `stiva events` is a whole-runtime
# stream, so per-container files would have to be discovered and merged in
# timestamp order; a container that failed before its directory existed would
# have nowhere to write; and — decisively — container_manager_remove deletes
# {root}/containers/{id}, which would destroy the `removed` event as it was
# written. A log that loses the record of a removal at the moment of the removal
# is not an event log.
#
# Writes go through file_append_locked: O_APPEND under an flock, so concurrent
# stiva processes interleave whole lines instead of shredding each other.

# Default rotation policy: 8 MiB per file, 3 rotated generations kept (so at
# most ~32 MiB total). At the ~120 bytes an event costs, 8 MiB is roughly 70k
# lifecycle transitions — enough that rotation is rare on a real host, small
# enough that an unattended root cannot fill a disk.
var _CM_EVENTS_MAX_BYTES = 8388608;
var _CM_EVENTS_MAX_FILES = 3;

# {root}/events.jsonl — the lifecycle event log.
#[must_use]
fn container_events_path(root) {
    return _container_cat2(root, "/events.jsonl");
}

# Size of `path` in bytes; 0 when it does not exist or cannot be stat'd (both
# mean "nothing to rotate" here). sys_stat rather than open+SEEK_END+close: one
# syscall instead of three, on a path that runs at every lifecycle transition.
#[must_use]
fn _cm_file_size(path) {
    var st = alloc(STAT_BUFSZ);
    if (sys_stat(path, st) < 0) { return 0; }
    return load64(st + STAT_SIZE);
}

# Whether lifecycle events are persisted at all. STIVA_EVENTS=off → no; unset
# or "on" → yes. The opt-out exists because persistence adds two syscalls-plus
# to every state change; an operator who does not use `stiva events` and wants
# the run path to touch nothing but the container's own directory can say so.
# An unrecognized value is a typo, and silently reading "0"/"false"/"no" as "on"
# would make the knob look broken, so it warns and keeps the default.
#[must_use]
fn _cm_events_enabled() {
    var e = getenv("STIVA_EVENTS");
    if (e == 0) { return 1; }
    if (streq(e, "off") == 1) { return 0; }
    if (streq(e, "on") == 1) { return 1; }
    sakshi_warn("STIVA_EVENTS: expected \"on\" or \"off\"; using \"on\"",
      strlen("STIVA_EVENTS: expected \"on\" or \"off\"; using \"on\""));
    return 1;
}

# A positive integer from the environment, or `dflt`. Non-positive is REFUSED
# rather than honored: atoi returns 0 for junk, and 0 means "never rotate" to
# container_should_rotate — so a typo in STIVA_EVENTS_MAX_BYTES would silently
# buy an unbounded log file instead of the smaller one the operator asked for.
#[must_use]
fn _cm_events_int_env(name, dflt) {
    var e = getenv(name);
    if (e == 0) { return dflt; }
    var v = atoi(e);
    if (v > 0) { return v; }
    sakshi_warn("events: ignoring a non-positive rotation limit from the environment",
      strlen("events: ignoring a non-positive rotation limit from the environment"));
    return dflt;
}

# Append one event to {root}/events.jsonl under an explicit rotation policy —
# the same container_should_rotate / rotate_logs pair the container logs use,
# so ".jsonl → .jsonl.1 → … → .jsonl.N, oldest dropped". Returns 1 when the line
# was written, else 0.
#
# Best-effort by contract: every failure path returns 0 without printing to
# stdout, because the caller is a lifecycle transition (`create`, `stop`, `rm`)
# whose success must not hinge on a log append.
fn container_events_append_with(root, event_json, max_bytes, max_files) {
    if (root == 0) { return 0; }
    if (event_json == 0) { return 0; }
    var jlen = strlen(event_json);
    if (jlen == 0) { return 0; }

    # One line = one event. The newline is part of the SAME write as the
    # payload, so a reader never sees a record without its terminator unless
    # the write itself was torn.
    var line = alloc(jlen + 2);
    memcpy(line, event_json, jlen);
    store8(line + jlen, 10);
    store8(line + jlen + 1, 0);

    var path = container_events_path(root);
    # KNOWN RACE, recorded rather than papered over with a mitigation that does
    # not mitigate.
    #
    # `_cm_file_size` and `rotate_logs` run OUTSIDE `file_append_locked`'s flock,
    # so two stiva processes crossing the threshold together can both decide to
    # rotate, and the second's renames shift the first's already-rotated
    # generations along — discarding whole retained files.
    #
    # Closing it needs `file_append_locked` to expose its lock so the rotate can
    # happen inside it; taking a SECOND lock here would invert the acquisition
    # order against the container-log path that shares `rotate_logs`. Re-reading
    # the size just before rotating was considered and rejected: both reads are
    # still outside the lock, so it narrows nothing and reads like a fix.
    #
    # The blast radius is bounded and worth stating: a lost RETAINED generation
    # under concurrent writers at the exact rollover. The live append is flocked,
    # so no event is ever lost or interleaved.
    if (container_should_rotate(max_bytes, max_files, _cm_file_size(path), jlen + 1) == 1) {
        rotate_logs(path, max_files);
    }
    if (file_append_locked(path, line, jlen + 1) >= 0) { return 1; }

    # The only routine reason for that to fail is {root} not existing yet — the
    # store creates it on the normal path, but a manager can be opened against a
    # bare path. Create it once and retry rather than mkdir'ing on every event.
    sys_mkdir(root, 493);
    if (file_append_locked(path, line, jlen + 1) >= 0) { return 1; }
    sakshi_warn("events: failed to append to the lifecycle event log",
      strlen("events: failed to append to the lifecycle event log"));
    return 0;
}

# container_events_append_with under the environment's policy (see
# _CM_EVENTS_MAX_BYTES / _CM_EVENTS_MAX_FILES and STIVA_EVENTS*).
fn container_events_append(root, event_json) {
    if (_cm_events_enabled() == 0) { return 0; }
    return container_events_append_with(root, event_json,
      _cm_events_int_env("STIVA_EVENTS_MAX_BYTES", _CM_EVENTS_MAX_BYTES),
      _cm_events_int_env("STIVA_EVENTS_MAX_FILES", _CM_EVENTS_MAX_FILES));
}

# The `ts` of one event-log line as epoch millis, or -1 when the line carries no
# parsable timestamp (unparsable JSON, missing key, or an explicit null).
# `line` must be NUL-terminated and must NOT include the trailing newline.
#[must_use]
fn container_event_ts(line) {
    if (line == 0) { return 0 - 1; }
    var v = bayan_json_v_parse_buf(line, strlen(line));
    if (v == 0) { return 0 - 1; }
    return _ct_jv_int_or(v, "ts", 0 - 1);
}

# Whether an event stamped `ts` falls inside the [since, until] window (both
# epoch millis, both inclusive; <= 0 means unbounded on that side).
#
# A line with NO timestamp (ts < 0) is always included. An event stream is an
# audit surface, and silently dropping a record because one field failed to
# parse hides exactly the malformed entry an operator most needs to see.
#[must_use]
fn container_event_in_range(ts, since_ms, until_ms) {
    if (ts < 0) { return 1; }
    if (since_ms > 0 && ts < since_ms) { return 0; }
    if (until_ms > 0 && ts > until_ms) { return 0; }
    return 1;
}

# Reap a detached container that has already exited, updating the record.
# Returns 1 when it was reaped by this call, 0 when it is still running, and -1
# when there is nothing to reap (not detached, or already reaped).
#
# A detached child is this process's child, so nothing else can reap it — leave
# it and it stays a zombie and its cgroup is never released.
fn container_manager_reap(mgr, id) {
    var mm: ContainerManager = mgr;
    var ci = map_get(mm.internals, id);
    if (ci == 0) { return 0 - 1; }
    var cint: ContainerInternals = ci;
    if (cint.spawned == 0) { return 0 - 1; }
    if (spawned_try_wait(cint.spawned) != 1) { return 0; }

    var c = container_state_find(mm.containers, id);
    if (c != 0) {
        var cc: Container = c;
        cc.exit_status = spawned_exit_code(cint.spawned);
        cc.state = CONTAINER_STATE_STOPPED;
        cc.pid = 0 - 1;
    }
    container_manager_publish_event(mgr, _cm_event_json("died", id, "detach", "true"));
    _cm_persist(mgr);
    return 1;
}

# The on-disk log path for a container, resolved through its record so a
# name works as well as an id, or 0 when the container is unknown. `logs -f`
# needs the path itself, not its contents, so it can poll for growth.
#[must_use]
fn container_manager_log_path(mgr, id) {
    var mm: ContainerManager = mgr;
    var c = container_state_find(mm.containers, id);
    if (c == 0) { return 0; }
    var cc: Container = c;
    return _cm_log_path(mgr, cc.id);
}

# The lifecycle event bus (rust-old: event_bus, container.rs:1346). A consumer
# (e.g. `stiva events`) subscribes via pubsub_subscribe(bus, "container.lifecycle").
#[must_use]
fn container_manager_event_bus(mgr) {
    var mm: ContainerManager = mgr;
    return mm.publisher;
}

# ── create + start (one-shot) ─────────────────────
# rust-old create() (container.rs:325) + the one-shot branch of start() (:416).

# 32-char lowercase-hex container id (rust-old: uuid::Uuid::new_v4 rendered
# simple). 16 random bytes → hex.
#[must_use]
fn _cm_gen_id() {
    var buf = alloc(16);
    random_bytes(buf, 16);
    return hex_encode(buf, 16);
}

# First 12 bytes of `s` into a fresh cstr — the oracle's `id[..12]` default name.
#[must_use]
fn _cm_id12(s) {
    var n = strlen(s);
    if (n > 12) { n = 12; }
    var out = alloc(n + 1);
    memcpy(out, s, n);
    store8(out + n, 0);
    return out;
}

# {root}/containers/{id}
#[must_use]
fn _cm_container_dir(root, id) {
    return _container_cat2(_container_cat2(root, "/containers/"), id);
}

# Whether the no-overlay rootfs is materialized by flattening the image layers
# (1) or left empty the way the oracle leaves it (0).
#
# Default ON: an empty rootfs is not a cheaper container, it is a container that
# cannot run its own entrypoint, so "off" is not a sane default. The opt-out
# exists because flattening costs real disk — one copy of the image per
# container, reclaimed by `stiva rm` with the rest of {croot} — and a caller who
# only wants the record and the spec (a `create` that is never started, a
# privileged host that will mount the overlay itself) should be able to decline.
#
# STIVA_ROOTFS_FALLBACK=none → off; unset or "copy" → on. Any other value is a
# typo, and silently guessing "on" for `STIVA_ROOTFS_FALLBACK=off` would make
# the knob look broken, so it warns and keeps the default.
#[must_use]
fn _cm_flatten_fallback_enabled() {
    var e = getenv("STIVA_ROOTFS_FALLBACK");
    if (e == 0) { return 1; }
    if (streq(e, "none") == 1) { return 0; }
    if (streq(e, "copy") == 1) { return 1; }
    sakshi_warn("STIVA_ROOTFS_FALLBACK: expected \"copy\" or \"none\"; using \"copy\"",
      strlen("STIVA_ROOTFS_FALLBACK: expected \"copy\" or \"none\"; using \"copy\""));
    return 1;
}

# Marker recording that {croot}/rootfs is a FLATTENED COPY of the image layers
# rather than an overlay merged dir. `internals` is process-local and never
# persisted, and `setup_overlay` creates upper/work/merged even when the mount
# fails, so neither an OverlayPaths nor the presence of `upper` tells a later
# process which layout it is looking at. `diff` needs that distinction: over an
# overlay the changed set IS {croot}/upper, whereas a flattened rootfs has no
# upper and has to be compared against the layer dirs.
#[must_use]
fn _cm_flatten_marker(croot) {
    return _container_cat2(croot, "/.rootfs-flattened");
}

# Create a container record + its rootfs from `image` under `config`
# (rust-old: create, container.rs:325). Unpacks layers, sets up the overlay
# (falling back to a flattened {croot}/rootfs when the mount is unavailable —
# see the fallback branch; this is the one place create diverges from the
# oracle), generates the runtime spec, records the runtime-only internals,
# appends the CREATED record, and persists. Returns the Container*, or 0 on
# failure (detail already printed).
#
# `image` is in the cycc struct-id 20/21 class, so its fields are read through
# the raw-offset accessors (_img_layers/_img_id/_image_reference), never
# `img.field` — a struct-field read miscompiles (segfaults) in some units.
fn container_manager_create(mgr, image, config) {
    var mm: ContainerManager = mgr;
    var cfg: ContainerConfig = config;
    var id = _cm_gen_id();
    var name = cfg.name;
    if (name == 0) { name = _cm_id12(id); }

    sys_mkdir(_container_cat2(mm.root, "/containers"), 493);
    var croot = _cm_container_dir(mm.root, id);
    sys_mkdir(croot, 493);

    var layer_dirs = prepare_layers(mm.image_store, _img_layers(image));
    if (layer_dirs == 0) {
        stiva_err_print(STIVA_ERR_LAYER_UNPACK, _img_id(image));
        return 0;
    }
    var overlay = setup_overlay(layer_dirs, croot);
    var rootfs = 0;
    if (overlay != 0) {
        rootfs = load64(overlay + 0);   # OverlayPaths.merged
    } else {
        # No overlay — no CAP_SYS_ADMIN or no overlayfs, i.e. every unprivileged
        # run. DIVERGENCE FROM THE ORACLE, deliberately: rust-old stops at the
        # bare `container_root.join("rootfs")` (container.rs:366-369) and never
        # fills it, discarding the layers it just unpacked, so the container
        # starts against an empty directory and cannot execute its own
        # entrypoint. Flatten the prepared layers into it instead.
        rootfs = _container_cat2(croot, "/rootfs");
        sys_mkdir(rootfs, 493);
        if (_cm_flatten_fallback_enabled() == 1) {
            if (flatten_layers(layer_dirs, rootfs) != 0) {
                # Half a rootfs runs even worse than none: fail the create rather
                # than hand back a container whose filesystem is silently partial.
                # Drop what was copied — no container record exists to `rm`, so
                # otherwise a failed create leaks a whole image's worth of disk.
                _stor_remove_dir_all(rootfs);
                stiva_err_print(STIVA_ERR_STORAGE,
                  _container_cat2("cannot materialize container rootfs from image ", _img_id(image)));
                return 0;
            }
            file_write_all(_cm_flatten_marker(croot), "", 0);
        }
    }

    var full_ref = image_ref_full_ref(_image_reference(image));
    var rec = container_new(id, name, _img_id(image), full_ref,
      CONTAINER_STATE_CREATED, 0 - 1, clock_now_ms(), 0 - 1, config, 0 - 1);
    var spec = generate_spec(rec, rootfs);
    if (spec == 0) {
        # Reclaim the container directory. Everything expensive has already
        # happened by this point — the layers are unpacked and flattened into
        # {croot}/rootfs, a full image-sized copy — and the record is NOT
        # persisted on this path, so nothing could ever reach that directory
        # again: not `rm`, not `prune`, not `gc`. It would leak one image copy
        # per failed create, forever.
        _stor_remove_dir_all(croot);
        return 0;                       # detail printed by generate_spec
    }

    var logp = _container_cat2(croot, "/container.log");
    map_set(mm.internals, id, container_internals_new(overlay, spec, 0, logp, 0));
    vec_push(mm.containers, rec);
    container_manager_publish_event(mgr, _cm_event_json("created", id, "image", full_ref));
    _cm_persist(mgr);
    return rec;
}

# Write a container's one-shot output to its log file (rust-old: write_log,
# container.rs:684). Uses the cached internals log_path, or reconstructs it
# when internals is empty (a fresh process — cross-invocation).
fn _cm_write_log(mgr, id, exec_result) {
    var mm: ContainerManager = mgr;
    var ci = map_get(mm.internals, id);
    var logp = 0;
    if (ci != 0) {
        var cint: ContainerInternals = ci;
        logp = cint.log_path;
    } else {
        logp = _container_cat2(_cm_container_dir(mm.root, id), "/container.log");
    }
    write_container_log(logp, exec_result);
    return 0;
}

# Start a created container to completion (rust-old: start one-shot branch,
# container.rs:416-540). Flips CREATED→RUNNING, runs the command blocking via
# exec_container, records the exit code + STOPPED, writes the log, and
# persists. Detached (daemon) start is v3.1. Returns STIVA_ERR_OK, or a
# STIVA_ERR_* sentinel (detail printed).
#
# The ContainerExecResult is in the cycc 20/21 class, so its fields are read by
# RAW OFFSET (exit_code@0 stdout@8 stderr@16), not a typed view — the manager
# lands in three unit shapes and a struct-field read segfaults in some.
fn container_manager_start(mgr, id) {
    var mm: ContainerManager = mgr;
    var c = container_state_find(mm.containers, id);
    if (c == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return STIVA_ERR_CONTAINER_NOT_FOUND;
    }
    var cc: Container = c;
    var ci = map_get(mm.internals, id);
    if (ci == 0) {
        # No runtime spec (a fresh process): one-shot start can only run a
        # container created in this same process. Daemon re-attach is v3.1.
        stiva_err_print(STIVA_ERR_RUNTIME, "start: no runtime spec (created in another process?)");
        return STIVA_ERR_RUNTIME;
    }
    var cint: ContainerInternals = ci;
    var spec = cint.spec;
    var cfg: ContainerConfig = cc.config;

    cc.state = CONTAINER_STATE_RUNNING;
    cc.started_at = clock_now_ms();

    # ── detached (`run -d`) ──
    # The container outlives this call, so the record stays RUNNING with a live
    # pid and the handle is kept for stop/kill/wait. Unlike the one-shot branch
    # there is no exit status yet — that is the point.
    if (cfg.detach == 1) {
        var handle = spawn_container(spec, cint.log_path);
        if (handle == 0) {
            cc.state = CONTAINER_STATE_STOPPED;
            cc.pid = 0 - 1;
            container_manager_publish_event(mgr,
              _cm_event_json("start_failed", id, "error", "spawn failed"));
            _cm_persist(mgr);
            return STIVA_ERR_SANDBOX;
        }
        cint.spawned = handle;
        cc.pid = spawned_pid(handle);
        # Capture the child's starttime NOW, while we know the pid is ours. A
        # later process has only (pid, start_ticks) to decide whether the
        # container is still alive.
        cc.start_ticks = _cm_proc_start_ticks(cc.pid);
        # Rootless networking (roadmap v3.0.17 item 2). This is the ONLY point
        # with a live pid — slirp4netns and pasta attach to a running process's
        # network namespace, so it cannot happen at create.
        #
        # Unprivileged only: with root the bridge/veth path already ran. The
        # helper's own failure is logged, never fatal — a container without port
        # forwarding is still a container, and refusing to start one because a
        # helper is missing would be a worse default than the warning this
        # replaces.
        _cm_start_rootless_net(mgr, cc, _cm_container_dir(mm.root, id));
        container_manager_publish_event(mgr, _cm_event_json("started", id, "detach", "true"));
        _cm_persist(mgr);
        return STIVA_ERR_OK;
    }

    var res = exec_container(spec);
    if (res == 0) {
        cc.state = CONTAINER_STATE_STOPPED;
        cc.pid = 0 - 1;
        container_manager_publish_event(mgr, _cm_event_json("start_failed", id, "error", "exec failed"));
        _cm_persist(mgr);
        return STIVA_ERR_SANDBOX;
    }

    cc.exit_status = load64(res);        # ContainerExecResult.exit_code @0
    cc.state = CONTAINER_STATE_STOPPED;
    cc.pid = 0 - 1;
    cint.exec_result = res;
    _cm_write_log(mgr, id, res);
    container_manager_publish_event(mgr, _cm_event_json("started", id, "detach", "false"));
    _cm_persist(mgr);
    return STIVA_ERR_OK;
}

# {"ts":<millis>,"event":<event>,"container_id":<id>,<key>:<intval>} — int-valued
# variant for the `stopped` event's numeric exit_code.
#[must_use]
fn _cm_event_json_int(event, id, key, intval) {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("ts"), json_v_int_new(_cm_event_ts_ms()));
    json_v_obj_set(o, str_from("event"), json_v_str_new(str_from(event)));
    json_v_obj_set(o, str_from("container_id"), json_v_str_new(str_from(id)));
    json_v_obj_set(o, str_from(key), json_v_int_new(intval));
    return str_cstr(json_v_build(o));
}

# {root}/containers/{real_id}/container.log — from cached internals, or rebuilt
# when internals is empty (a fresh CLI process; the record is on disk but the
# runtime side table is not). `real_id` MUST be the container's actual id (the
# directory + internals key are named by id, never by a name alias), so callers
# resolve the record first via container_state_find and pass cc.id.
#[must_use]
fn _cm_log_path(mgr, real_id) {
    var mm: ContainerManager = mgr;
    var ci = map_get(mm.internals, real_id);
    if (ci != 0) {
        var cint: ContainerInternals = ci;
        return cint.log_path;
    }
    return _container_cat2(_cm_container_dir(mm.root, real_id), "/container.log");
}

# ── network (best-effort; rust-old connect/disconnect_network) ────
# Only a daemon-start path would connect, and stiva has none: the one-shot path
# never builds a NetworkManager, so disconnect is a no-op. Ported for parity and
# for the rootless-networking work (roadmap v3.0.17 item 2), which is what makes
# this reachable.
fn _cm_disconnect_network(mgr, id) {
    var mm: ContainerManager = mgr;
    # Tear down the rootless helper first — it is per-container and this is the
    # one place that knows the container is going away. Keyed on the id so it
    # works cross-process, where `internals` is empty.
    _cm_stop_rootless_net(mm.root, id);
    if (mm.network_manager == 0) { return 0; }
    # A real NetworkManager would detach the container here; the one-shot path
    # never constructs one, so this only runs on the (v3.1) daemon path.
    return 0;
}

# Where a container's rootless-helper pid is recorded, so a LATER process can
# stop it. `internals` is in-memory, so without this a second `stiva` invocation
# could not reap the helper and it would outlive the container.
#[must_use]
fn _cm_rootless_pidfile(root, id) {
    return _container_cat2(_cm_container_dir(root, id), "/rootless-net.pid");
}

# Start the rootless network helper for a freshly-spawned container, recording
# its pid. Best-effort: every failure is a warning, never a start failure.
fn _cm_start_rootless_net(mgr, cc_in, croot) {
    var cc: Container = cc_in;
    if (is_unprivileged() == 0) { return 0; }       # root: the bridge path ran
    if (cc.pid <= 0) { return 0; }
    var cfg = cc.config;
    var ports = vec_new();
    if (cfg != 0) {
        var cf: ContainerConfig = cfg;
        if (cf.ports != 0) { ports = parse_port_mappings(cf.ports); }
    }
    var logp = _container_cat2(croot, "/rootless-net.log");
    var h = start_rootless_network(NETWORK_ROOTLESS_BACKEND_AUTO, cc.pid, ports, logp);
    if (h == 0) {
        sakshi_warn("rootless network unavailable; the container has no external connectivity",
          strlen("rootless network unavailable; the container has no external connectivity"));
        return 0;
    }
    var pf = _container_cat2(croot, "/rootless-net.pid");
    var sb = str_builder_new();
    str_builder_add_int(sb, rootless_handle_pid(h));
    var pstr = str_builder_build(sb);
    file_write_all(pf, str_data(pstr), str_len(pstr));
    return 0;
}

# Stop a container's rootless helper, if one was recorded.
fn _cm_stop_rootless_net(root, id) {
    var pf = _cm_rootless_pidfile(root, id);
    if (file_exists(pf) == 0) { return 0; }
    var buf = alloc(64);
    var n = file_read_all(pf, buf, 63);
    sys_unlink(pf);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    var pid = str_to_int(str_from(buf));
    if (pid > 0) { sys_kill(pid, 15); }
    return 0;
}

# ── mutating + read ops (rust-old/src/container.rs) ───────────────

# Stop a container (rust-old: stop, container.rs:625). One-shot containers have
# already completed, so this flips to Stopped, clears pid, disconnects the
# network, emits `stopped`, and persists. (The daemon SIGTERM/grace/SIGKILL
# branch needs DaemonHandle → v3.1.)
fn container_manager_stop(mgr, id) {
    var mm: ContainerManager = mgr;
    var c = container_state_find(mm.containers, id);
    if (c == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return STIVA_ERR_CONTAINER_NOT_FOUND;
    }
    var cc: Container = c;
    # A DETACHED container has a live process that must actually be stopped —
    # SIGTERM, grace, then SIGKILL — and reaped, or it survives the "stop" as an
    # orphan holding its cgroup. Marking the record STOPPED without signalling
    # would make `ps` lie. The one-shot path has already exited, so this is a
    # no-op there.
    # The container's OWN configured grace, not a fixed one — a process that
    # needs 30 s to flush should get it (rust-old: stop_grace_ms).
    var scfg: ContainerConfig = cc.config;
    var grace = scfg.stop_grace_ms;
    if (grace <= 0) { grace = default_stop_grace_ms(); }

    var handled = 0;
    var ci = map_get(mm.internals, id);
    if (ci != 0) {
        var cint: ContainerInternals = ci;
        if (cint.spawned != 0) {
            # We spawned it: signal AND reap, so no zombie and the cgroup goes.
            cc.exit_status = spawned_terminate(cint.spawned, grace);
            handled = 1;
        }
    }
    if (handled == 0) {
        # A detached container from an EARLIER process. Without this the record
        # was marked Stopped while the process kept running — `ps` would say
        # stopped and the container would still be there.
        if (container_pid_is_ours(cc.pid, cc.start_ticks) == 1) {
            if (_cm_stop_by_pid(cc.pid, cc.start_ticks, grace) == 0) {
                stiva_err_print(STIVA_ERR_RUNTIME, "container survived SIGKILL");
                return STIVA_ERR_RUNTIME;
            }
        }
    }
    cc.state = CONTAINER_STATE_STOPPED;
    cc.pid = 0 - 1;
    _cm_disconnect_network(mgr, id);
    container_manager_publish_event(mgr, _cm_event_json_int("stopped", id, "exit_code", cc.exit_status));
    _cm_persist(mgr);
    return STIVA_ERR_OK;
}

# Send a signal to a running container (rust-old: signal, container.rs:724).
fn container_manager_signal(mgr, id, signal) {
    var allowed = vec_new();
    vec_push(allowed, CONTAINER_STATE_RUNNING);
    var pid = container_manager_require_pid(mgr, id, allowed, 1);
    if (pid < 0) { return STIVA_ERR_RUNTIME; }   # detail printed by require_pid
    return send_signal(pid, signal);
}

# Exec a command inside a running container (rust-old: exec, container.rs:702).
# `command` is a vec of cstrs, `env` a vec of "K=V" cstrs or 0, `workdir` a cstr
# or 0. Returns a ContainerExecResult*, or 0 with the detail already printed.
#
# RUNNING only, not RUNNING-or-PAUSED: nsenter into a frozen container's
# namespaces succeeds and then the exec'd process blocks in the freezer with no
# way out, so the caller hangs forever. `top` accepts PAUSED because reading
# /proc is safe against a frozen process; running a command is not.
fn container_manager_exec(mgr, id, command, env, workdir) {
    var mm: ContainerManager = mgr;
    # Resolve first, so the two failures are distinguishable. `require_pid`
    # collapses them: it returns -1 both for a container that does not exist
    # (having printed "container not found") and for one that exists in the
    # wrong state (printing nothing), so branching on its return alone leaves a
    # stopped container failing SILENTLY.
    if (container_manager_get(mgr, id) == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return 0;
    }
    var allowed = vec_new();
    vec_push(allowed, CONTAINER_STATE_RUNNING);
    var pid = container_manager_require_pid(mgr, id, allowed, 1);
    if (pid <= 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, "container is not running");
        return 0;
    }
    return exec_in_container(mm.root, pid, command, env, workdir);
}

# Pause a running container via the cgroup freezer (rust-old: pause, :732).
fn container_manager_pause(mgr, id) {
    var mm: ContainerManager = mgr;
    var allowed = vec_new();
    vec_push(allowed, CONTAINER_STATE_RUNNING);
    var pid = container_manager_require_pid(mgr, id, allowed, 1);
    if (pid < 0) { return STIVA_ERR_RUNTIME; }
    var r = pause_container(pid);
    if (r != STIVA_ERR_OK) { return r; }
    var cc: Container = container_state_find(mm.containers, id);
    cc.state = CONTAINER_STATE_PAUSED;
    container_manager_publish_event(mgr, _cm_event_json("paused", id, "state", "paused"));
    _cm_persist(mgr);
    return STIVA_ERR_OK;
}

# Unpause a paused container (rust-old: unpause, :753).
fn container_manager_unpause(mgr, id) {
    var mm: ContainerManager = mgr;
    var allowed = vec_new();
    vec_push(allowed, CONTAINER_STATE_PAUSED);
    var pid = container_manager_require_pid(mgr, id, allowed, 1);
    if (pid < 0) { return STIVA_ERR_RUNTIME; }
    var r = unpause_container(pid);
    if (r != STIVA_ERR_OK) { return r; }
    var cc: Container = container_state_find(mm.containers, id);
    cc.state = CONTAINER_STATE_RUNNING;
    container_manager_publish_event(mgr, _cm_event_json("unpaused", id, "state", "running"));
    _cm_persist(mgr);
    return STIVA_ERR_OK;
}

# Runtime stats for a running/paused container (rust-old: stats, :774). Returns
# a ContainerStats*, or 0 (not running/paused, or cgroup unavailable).
#[must_use]
fn container_manager_stats(mgr, id) {
    var allowed = vec_new();
    vec_push(allowed, CONTAINER_STATE_RUNNING);
    vec_push(allowed, CONTAINER_STATE_PAUSED);
    var pid = container_manager_require_pid(mgr, id, allowed, 2);
    if (pid < 0) { return 0; }
    return container_stats(pid);
}

# Remove a stopped container (rust-old: remove, container.rs:832). Refuses a
# Running container, tears down its overlay, removes its directory + internals,
# drops the record, emits `removed`, and persists. Returns STIVA_ERR_OK or a
# sentinel (detail printed).
fn container_manager_remove(mgr, id) {
    var mm: ContainerManager = mgr;
    var c = container_state_find(mm.containers, id);
    if (c == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return STIVA_ERR_CONTAINER_NOT_FOUND;
    }
    var cc: Container = c;
    if (cc.state == CONTAINER_STATE_RUNNING) {
        stiva_err_print(STIVA_ERR_INVALID_STATE,
          _container_cat2("cannot remove running container — stop it first: ", id));
        return STIVA_ERR_INVALID_STATE;
    }
    # Tear down the overlay if we still hold its internals.
    var ci = map_get(mm.internals, id);
    if (ci != 0) {
        var cint: ContainerInternals = ci;
        if (cint.overlay != 0) { teardown_overlay(cint.overlay); }
    }
    # Remove the container directory tree.
    _stor_remove_dir_all(_cm_container_dir(mm.root, id));

    # Drop the record (filter the vec by id, since removal is by id-or-name).
    var kept = vec_new();
    var n = vec_len(mm.containers);
    var i = 0;
    while (i < n) {
        var rc: Container = vec_get(mm.containers, i);
        if (streq(rc.id, cc.id) == 0) { vec_push(kept, vec_get(mm.containers, i)); }
        i = i + 1;
    }
    mm.containers = kept;
    container_manager_publish_event(mgr, _cm_event_json("removed", id, "state", "removed"));
    _cm_persist(mgr);
    return STIVA_ERR_OK;
}

# Rename a container (rust-old: rename, container.rs:924). No lifecycle event.
fn container_manager_rename(mgr, id, new_name) {
    var mm: ContainerManager = mgr;
    var c = container_state_find(mm.containers, id);
    if (c == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return STIVA_ERR_CONTAINER_NOT_FOUND;
    }
    var cc: Container = c;
    cc.name = new_name;
    _cm_persist(mgr);
    return STIVA_ERR_OK;
}

# Update resource limits on a running container (rust-old: update, :941). Builds
# a minimal RuntimeSpec carrying only the non-zero limits and applies the cgroup
# writes (best-effort). Returns STIVA_ERR_OK or a sentinel.
fn container_manager_update(mgr, id, memory_limit, cpu_shares, max_pids) {
    var allowed = vec_new();
    vec_push(allowed, CONTAINER_STATE_RUNNING);
    var pid = container_manager_require_pid(mgr, id, allowed, 1);
    if (pid < 0) { return STIVA_ERR_RUNTIME; }
    var spec = runtime_spec_new();
    var ss: RuntimeSpec = spec;
    if (memory_limit > 0) { ss.memory_limit_bytes = memory_limit; }
    if (cpu_shares > 0) { ss.cpu_shares = cpu_shares; }
    if (max_pids > 0) { ss.max_pids = max_pids; }
    apply_cgroup_limits(pid, spec);
    return STIVA_ERR_OK;
}

# Restart a stopped container (rust-old: restart, container.rs:876). Requires
# Stopped, resets to Created (clearing the exit code) and re-runs start. The
# one-shot re-run needs the cached spec in internals (same process); a
# cross-process restart has no spec and start reports it.
fn container_manager_restart(mgr, id) {
    var mm: ContainerManager = mgr;
    var c = container_state_find(mm.containers, id);
    if (c == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return STIVA_ERR_CONTAINER_NOT_FOUND;
    }
    var cc: Container = c;
    if (cc.state != CONTAINER_STATE_STOPPED) {
        stiva_err_print(STIVA_ERR_INVALID_STATE,
          _container_cat2("cannot restart: container is not stopped: ", id));
        return STIVA_ERR_INVALID_STATE;
    }
    cc.state = CONTAINER_STATE_CREATED;
    cc.exit_status = 0 - 1;
    return container_manager_start(mgr, id);
}

# Rootfs path for a container (rust-old: get_rootfs, :906). The overlay merged
# dir from internals, or the reconstructed {root}/containers/{id}/rootfs
# fallback when internals is empty (cross-process) — matching today's _cli_export.
#[must_use]
# ══ diff (roadmap v3.0.17 item 1) ════════════════════════
#
# THERE IS NO ORACLE FOR THIS. `ContainerManager::new` restores containers from
# state.json but leaves `internals` empty (rust-old/src/container.rs:260) and
# nothing rehydrates it, so `get_rootfs` always returns ContainerNotFound and the
# Rust `diff` verb has never executed in the CLI. Its walk is also wrong twice
# over: it emits only C and D (never A), and it looks for `.wh.` files in the
# overlay upper — but overlayfs whiteouts are character devices 0:0, not `.wh.`
# files, so that branch could never fire. This is a rewrite.
#
# TWO LAYOUTS, and they cannot be told apart after the fact — `internals` is
# process-local and `setup_overlay` creates upper/work/merged even when the mount
# FAILS, so their presence proves nothing. `create` therefore drops a
# `{croot}/.rootfs-flattened` marker and this reads it.
#
#   overlay   → the changed set IS {croot}/upper; walk it.
#   flattened → no upper. Compare {croot}/rootfs against the image's layer dirs.
#
# Output is the Docker convention, one entry per line: `A <path>` added,
# `C <path>` changed, `D <path>` deleted.

# One diff entry: a status byte ('A'/'C'/'D') and a container-absolute path.
var _CM_DIFF_ADD = 65;
var _CM_DIFF_CHG = 67;
var _CM_DIFF_DEL = 68;

#[must_use]
fn _cm_diff_entry(status, path) {
    var e = alloc(16);
    store64(e, status);
    store64(e + 8, path);
    return e;
}

#[must_use]
fn cm_diff_status(e) { return load64(e); }
#[must_use]
fn cm_diff_path(e) { return load64(e + 8); }

# Walk `dir`, recording every entry into `out` as path → "<type>:<size>:<mode>".
# Paths are container-absolute ("/etc/passwd"). Directories are recorded too, so
# a directory that appears or disappears is reported.
#
# The fingerprint deliberately excludes mtime: unpacking a layer sets it from the
# tar, and a container that merely READ a file would otherwise show as changed.
# Size + mode + type is what "changed" means for a filesystem diff.
fn _cm_diff_scan(dir, prefix, out) {
    var fd = sys_open(dir, 196608, 0);          # O_DIRECTORY|O_NOFOLLOW
    if (fd < 0) { return 0; }
    var buf = alloc(4096);
    var sb = alloc(144);
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents64(fd, buf, 4096);
        if (n <= 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var nm = buf + pos + 19;
                var skip = 0;
                if (load8(nm) == 46) {
                    if (load8(nm + 1) == 0) { skip = 1; }
                    if (load8(nm + 1) == 46) { if (load8(nm + 2) == 0) { skip = 1; } }
                }
                # prepare_layers' own bookkeeping, never image content.
                if (skip == 0) { if (streq(nm, ".unpacked") == 1) { skip = 1; } }
                if (skip == 0) {
                    var named = _stor_dup(nm);
                    var child = _container_cat2(_container_cat2(dir, "/"), named);
                    var path = _container_cat2(_container_cat2(prefix, "/"), named);
                    if (sys_lstat(child, sb) == 0) {
                        var st = load64(sb + 24);
                        var typ = st & 61440;
                        var fb = str_builder_new();
                        str_builder_add_int(fb, typ);
                        str_builder_add_cstr(fb, ":");
                        str_builder_add_int(fb, load64(sb + 48));      # size
                        str_builder_add_cstr(fb, ":");
                        str_builder_add_int(fb, st & 4095);            # mode
                        map_set(out, path, str_cstr(str_builder_build(fb)));
                        if (typ == 16384) { _cm_diff_scan(child, path, out); }
                    }
                }
                pos = pos + load16(buf + pos + 16);
            }
        }
    }
    sys_close(fd);
    return 0;
}

# The merged metadata view of `layer_dirs`, bottom-to-top, with whiteouts
# applied — i.e. what the rootfs looked like BEFORE the container ran.
#
# Rebuilt here rather than shared with `flatten_layers` because that one copies
# bytes; this needs only names and metadata, and running it would cost a second
# full copy of the image per `diff`.
fn _cm_diff_lower_view(layer_dirs) {
    var view = map_new();
    var n = vec_len(layer_dirs);
    var i = 0;
    while (i < n) {
        var ld = vec_get(layer_dirs, i);
        # Whiteouts first, exactly as the merge applies them: a marker in THIS
        # layer removes what the layers below contributed.
        _cm_diff_apply_wh(ld, "", view);
        var one = map_new();
        _cm_diff_scan(ld, "", one);
        var ks = map_keys(one);
        var k = 0;
        while (k < vec_len(ks)) {
            var key = vec_get(ks, k);
            # The markers themselves are metadata, never content.
            if (_cm_diff_is_wh_path(key) == 0) { map_set(view, key, map_get(one, key)); }
            k = k + 1;
        }
        i = i + 1;
    }
    return view;
}

# 1 when any component of `path` is a `.wh.` marker.
#[must_use]
fn _cm_diff_is_wh_path(path) {
    var n = strlen(path);
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) {
            if (i + 4 < n) { if (memeq(path + i + 1, ".wh.", 4) == 1) { return 1; } }
        }
        i = i + 1;
    }
    return 0;
}

# Remove from `view` everything this layer's whiteouts delete.
fn _cm_diff_apply_wh(dir, prefix, view) {
    var fd = sys_open(dir, 196608, 0);
    if (fd < 0) { return 0; }
    var buf = alloc(4096);
    var sb = alloc(144);
    var subs = vec_new();
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_getdents64(fd, buf, 4096);
        if (n <= 0) { rgo = 0; }
        else {
            var pos = 0;
            while (pos < n) {
                var nm = buf + pos + 19;
                var skip = 0;
                if (load8(nm) == 46) {
                    if (load8(nm + 1) == 0) { skip = 1; }
                    if (load8(nm + 1) == 46) { if (load8(nm + 2) == 0) { skip = 1; } }
                }
                if (skip == 0) {
                    var named = _stor_dup(nm);
                    if (memeq(named, ".wh.", 4) == 1) {
                        if (streq(named, ".wh..wh..opq") == 1) {
                            _cm_diff_drop_subtree(view, prefix);
                        } else {
                            _cm_diff_drop_subtree(view,
                              _container_cat2(_container_cat2(prefix, "/"), named + 4));
                        }
                    } else {
                        var child = _container_cat2(_container_cat2(dir, "/"), named);
                        if (sys_lstat(child, sb) == 0) {
                            if ((load64(sb + 24) & 61440) == 16384) {
                                vec_push(subs, named);
                            }
                        }
                    }
                }
                pos = pos + load16(buf + pos + 16);
            }
        }
    }
    sys_close(fd);
    var s = 0;
    while (s < vec_len(subs)) {
        var sn = vec_get(subs, s);
        _cm_diff_apply_wh(_container_cat2(_container_cat2(dir, "/"), sn),
          _container_cat2(_container_cat2(prefix, "/"), sn), view);
        s = s + 1;
    }
    return 0;
}

# Drop `path` and everything under it from `view`. A whiteout on a directory
# removes the whole subtree, not just the directory entry.
fn _cm_diff_drop_subtree(view, path) {
    var plen = strlen(path);
    var ks = map_keys(view);
    var i = 0;
    while (i < vec_len(ks)) {
        var k = vec_get(ks, i);
        var drop = 0;
        if (streq(k, path) == 1) { drop = 1; }
        elif (strlen(k) > plen) {
            if (memeq(k, path, plen) == 1) {
                if (load8(k + plen) == 47) { drop = 1; }   # a real child, not a prefix match
            }
        }
        if (drop == 1) { map_set(view, k, 0); }
        i = i + 1;
    }
    return 0;
}

# Diff a container's filesystem against the image it was created from. Returns a
# vec of diff entries (`_cm_diff_entry`), or 0 when the container is unknown.
# An empty vec means no changes.
fn container_manager_diff(mgr, id) {
    var mm: ContainerManager = mgr;
    var c = container_state_find(mm.containers, id);
    if (c == 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, id);
        return 0;
    }
    var cc: Container = c;
    var croot = _cm_container_dir(mm.root, cc.id);
    var out = vec_new();

    # OVERLAY: the upper layer IS the change set, so no comparison is needed —
    # but the marker decides, not the presence of `upper`, because setup_overlay
    # creates it even when the mount failed.
    if (file_exists(_cm_flatten_marker(croot)) == 0) {
        var upper = _container_cat2(croot, "/upper");
        if (file_exists(upper) == 0) { return out; }
        var up = map_new();
        _cm_diff_scan(upper, "", up);
        # Which of these are ADDS rather than CHANGES needs the lower view.
        var lower_o = _cm_diff_lower_view(_cm_diff_layer_dirs(mm, cc));
        var ks = map_keys(up);
        var i = 0;
        while (i < vec_len(ks)) {
            var k = vec_get(ks, i);
            var meta = map_get(up, k);
            if (meta != 0) {
                # An overlayfs whiteout is a character device 0:0 — NOT a `.wh.`
                # file. The oracle checked for `.wh.` here, which could never
                # match on a real overlay. S_IFCHR = 8192; a 0:0 rdev is the
                # marker, and st_size on a chardev is 0 so the fingerprint's
                # size field is a safe proxy only for the type check.
                if (_cm_diff_meta_type(meta) == 8192) {
                    vec_push(out, _cm_diff_entry(_CM_DIFF_DEL, k));
                } elif (map_get(lower_o, k) == 0) {
                    vec_push(out, _cm_diff_entry(_CM_DIFF_ADD, k));
                } else {
                    vec_push(out, _cm_diff_entry(_CM_DIFF_CHG, k));
                }
            }
            i = i + 1;
        }
        return out;
    }

    # FLATTENED: no upper exists, so the rootfs must be compared against what the
    # image's layers merge to.
    var lower = _cm_diff_lower_view(_cm_diff_layer_dirs(mm, cc));
    var upper2 = map_new();
    _cm_diff_scan(_container_cat2(croot, "/rootfs"), "", upper2);

    var uk = map_keys(upper2);
    var a = 0;
    while (a < vec_len(uk)) {
        var key = vec_get(uk, a);
        var now = map_get(upper2, key);
        if (now != 0) {
            var was = map_get(lower, key);
            if (was == 0) { vec_push(out, _cm_diff_entry(_CM_DIFF_ADD, key)); }
            elif (streq(was, now) == 0) { vec_push(out, _cm_diff_entry(_CM_DIFF_CHG, key)); }
        }
        a = a + 1;
    }
    var lk = map_keys(lower);
    var d = 0;
    while (d < vec_len(lk)) {
        var lkey = vec_get(lk, d);
        if (map_get(lower, lkey) != 0) {
            if (map_get(upper2, lkey) == 0) {
                vec_push(out, _cm_diff_entry(_CM_DIFF_DEL, lkey));
            }
        }
        d = d + 1;
    }
    return out;
}

# The S_IFMT field of a `_cm_diff_scan` fingerprint ("<type>:<size>:<mode>").
#[must_use]
fn _cm_diff_meta_type(meta) {
    var i = 0;
    var v = 0;
    while (load8(meta + i) != 0) {
        var ch = load8(meta + i);
        if (ch == 58) { return v; }                 # ':'
        v = v * 10 + (ch - 48);
        i = i + 1;
    }
    return v;
}

# The unpacked layer dirs for the container's image, or an empty vec when the
# image is gone (`rmi` while a container still references it). An empty lower
# view degrades the diff to "everything is an add", which is the honest answer
# when the baseline cannot be established.
fn _cm_diff_layer_dirs(mm_in, cc_in) {
    var mm: ContainerManager = mm_in;
    var cc: Container = cc_in;
    var img = image_store_find(mm.image_store, cc.image_id);
    if (img == 0) { return vec_new(); }
    var dirs = prepare_layers(mm.image_store, _img_layers(img));
    if (dirs == 0) { return vec_new(); }
    return dirs;
}

fn container_manager_get_rootfs(mgr, id) {
    var mm: ContainerManager = mgr;
    # Resolve id-or-name → the real id (the dir + internals key use the id).
    var c = container_state_find(mm.containers, id);
    if (c == 0) { return 0; }
    var cc: Container = c;
    var ci = map_get(mm.internals, cc.id);
    if (ci != 0) {
        var cint: ContainerInternals = ci;
        if (cint.overlay != 0) { return load64(cint.overlay + 0); }   # OverlayPaths.merged
    }
    return _container_cat2(_cm_container_dir(mm.root, cc.id), "/rootfs");
}

# Whole-file logs (rust-old: logs, container.rs:1191). scan_policy does not
# persist yet — roadmap v3.0.17 item 3.
# persisted (loads as 0), so this returns the content unscanned — `stiva logs
# --scan` drives scan_output explicitly. Returns the content cstr, or 0 if the
# log file does not exist.
#[must_use]
fn container_manager_logs(mgr, id) {
    var mm: ContainerManager = mgr;
    var c = container_state_find(mm.containers, id);
    if (c == 0) { return 0; }
    var cc: Container = c;
    var logp = _cm_log_path(mgr, cc.id);
    if (file_exists(logp) == 0) { return 0; }
    return container_log_tail(logp, 0);   # n=0 → whole file
}

# Last-N-lines logs (rust-old: log_tail, :1230). Reuses container_log_tail.
#[must_use]
fn container_manager_log_tail(mgr, id, n) {
    var mm: ContainerManager = mgr;
    var c = container_state_find(mm.containers, id);
    if (c == 0) { return 0; }
    var cc: Container = c;
    var logp = _cm_log_path(mgr, cc.id);
    if (file_exists(logp) == 0) { return 0; }
    return container_log_tail(logp, n);
}

# Wait for a container's exit result (rust-old: wait, :549). One-shot containers
# already have a cached result in internals; returns that ContainerExecResult*,
# or 0 when the container was not started in this process.
#[must_use]
fn container_manager_wait(mgr, id) {
    var mm: ContainerManager = mgr;
    var ci = map_get(mm.internals, id);
    if (ci == 0) { return 0; }
    var cint: ContainerInternals = ci;
    # A detached container has no cached result — block on the child, then
    # synthesize one so callers see the same shape either way.
    if (cint.spawned != 0) {
        var code = spawned_wait(cint.spawned);
        var c = container_state_find(mm.containers, id);
        if (c != 0) {
            var cc: Container = c;
            cc.exit_status = code;
            cc.state = CONTAINER_STATE_STOPPED;
            cc.pid = 0 - 1;
        }
        _cm_persist(mgr);
        var res = container_exec_result_new(code, "", "", 0, 0);
        cint.exec_result = res;
        return res;
    }
    return cint.exec_result;
}

# Non-blocking exit-code check (rust-old: try_wait, :589). For one-shot
# containers this reads the persisted exit_status off the record, so it works
# across processes (what `stiva wait` needs). Returns the exit code, or -1.
#[must_use]
fn container_manager_try_wait(mgr, id) {
    var c = container_manager_get(mgr, id);
    if (c == 0) { return 0 - 1; }
    var cc: Container = c;
    return cc.exit_status;
}

# ── DEFERRED to v3.1 (external- or coroutine-blocked) ────────────
# The remaining ContainerManager surface is gated on landings outside stiva:
#   start(daemon branch)/wait/try_wait(daemon)  — runtime::spawn_container +
#       DaemonHandle (kavach sandbox_spawn); the one-shot branches ship in §C.
#   exec(&self, id, command)                    — runtime::exec_in_container
#       (kavach sandbox_exec, non-interactive); interactive exec -it needs
#       cyrius stackless coroutines.
#   checkpoint/restore/prepare_migration/apply_migration — CRIU
#       checkpoint_container/restore_container.
# Tracked in docs/development/roadmap.md (v3.1).

# --- cron.cyr ---

# stiva — scheduled (cron) containers. Roadmap §H.
#
# NET-NEW: `rust-old` has no time-triggered container start of any kind, so
# there is no parity oracle here. The cron SEMANTICS come from samay, which
# already implements the hard parts — a standard 5-field parser with
# `@shortcuts`, ranges, steps, name lookup and the Vixie `crontab(5)`
# DOM-vs-DOW star rule; a scheduler with a missed-schedule policy, catch-up
# counting and a firing cap; and an injected-clock `check_due_at` so the whole
# thing is deterministically testable with no wall clock.
#
# WHAT SAMAY DOES NOT GIVE YOU, and why this module exists at all:
#
#   1. `CronTaskTemplate` carries name/description/agent_id/priority/
#      resource_requirements — no image, command, env, mounts or restart
#      policy — and its JSON codec cannot carry them either. So stiva owns the
#      entry-name → container-spec table and its persistence.
#   2. The typed cron EXPRESSION STRING is not persisted by samay's codec
#      (only the seven bitmasks), so stiva stores its own copy — otherwise
#      `stiva cron ls` could not show the user what they typed.
#   3. There is no poll site. `src/main.cyr` is a one-shot dispatcher ending in
#      `syscall(SYS_EXIT, …)`, so v1 is `stiva cron add/ls/rm/check` driven by
#      an external systemd timer: `check` fires whatever is due and exits. An
#      in-process loop is a later increment, not a blocker.
#
# The scheduler is rebuilt from stiva's table on each `check` and its
# `last_fired` written back, so catch-up survives across the one-shot
# invocations that are the whole point of the design.

# ── CronJob ──
# One scheduled container. `command` is a vec of cstrs (may be empty, meaning
# the image's own entrypoint). `last_fired_ns` is 0 until the first firing.
struct CronJob {
    name;
    expr;             # the cron expression AS TYPED
    image;            # image reference
    command;          # vec<cstr>
    enabled;          # 1/0
    last_fired_ns;
}

#[must_use]
fn cron_job_new(name, expr, image, command, enabled, last_fired_ns) {
    var p = alloc(48);
    var j: CronJob = p;
    j.name = name;
    j.expr = expr;
    j.image = image;
    j.command = command;
    j.enabled = enabled;
    j.last_fired_ns = last_fired_ns;
    return p;
}

#[must_use]
fn cron_job_name(j) { var x: CronJob = j; return x.name; }
#[must_use]
fn cron_job_expr(j) { var x: CronJob = j; return x.expr; }
#[must_use]
fn cron_job_image(j) { var x: CronJob = j; return x.image; }
#[must_use]
fn cron_job_command(j) { var x: CronJob = j; return x.command; }
#[must_use]
fn cron_job_enabled(j) { var x: CronJob = j; return x.enabled; }
#[must_use]
fn cron_job_last_fired(j) { var x: CronJob = j; return x.last_fired_ns; }

# ── persistence: {root}/cron.json ──

#[must_use]
fn cron_store_path(root) {
    return _container_cat2(root, "/cron.json");
}

# Validate a cron expression. Returns 1 when samay can parse it.
#
# Done HERE, at `add` time, rather than at `check`: a typo that is only caught
# by the timer is a job that silently never runs, and the operator has no reason
# to look again at something `add` accepted.
#[must_use]
fn cron_expr_is_valid(expr) {
    if (expr == 0) { return 0; }
    if (strlen(expr) == 0) { return 0; }
    # `cron_expr_parse` returns a RESULT, not a raw pointer — it answers `Err(1)`
    # for a bad expression, which is non-zero. Testing `!= 0` therefore accepts
    # every string, which is how "not a cron" was accepted as a schedule.
    return is_ok(cron_expr_parse(str_from(expr)));
}

# The parsed CronExpr for `expr`, or 0 when it does not parse.
#[must_use]
fn _cron_parsed(expr) {
    var r = cron_expr_parse(str_from(expr));
    if (is_ok(r) == 0) { return 0; }
    return result_unwrap(r);
}

# Load the job table, or an empty vec. A malformed file yields an empty vec
# rather than an error: `cron.json` is written by stiva, so a corrupt one is a
# bug or tampering, and refusing every subsequent `check` would turn it into an
# outage. The condition is logged.
fn cron_store_load(root) {
    var out = vec_new();
    var path = cron_store_path(root);
    if (file_exists(path) == 0) { return out; }
    var cell = alloc(8);
    var buf = _img_read_file(path, cell);
    if (buf == 0) { return out; }
    var v = bayan_json_v_parse_buf(buf, load64(cell));
    if (v == 0) {
        sakshi_warn("cron.json is not valid JSON; treating the schedule as empty",
          strlen("cron.json is not valid JSON; treating the schedule as empty"));
        return out;
    }
    var arr = json_v_obj_get(v, "jobs");
    if (arr == 0) { return out; }
    if (json_v_is_arr(arr) == 0) { return out; }
    var n = json_v_arr_len(arr);
    var i = 0;
    while (i < n) {
        var e = json_v_arr_get(arr, i);
        var nm = _cron_jv_str(e, "name");
        var ex = _cron_jv_str(e, "expr");
        var im = _cron_jv_str(e, "image");
        if (nm != 0 && ex != 0 && im != 0) {
            var cmd = vec_new();
            var ca = json_v_obj_get(e, "command");
            if (ca != 0) {
                if (json_v_is_arr(ca) == 1) {
                    var k = 0;
                    while (k < json_v_arr_len(ca)) {
                        var el = json_v_arr_get(ca, k);
                        if (json_v_is_str(el) == 1) { vec_push(cmd, str_cstr(json_v_str(el))); }
                        k = k + 1;
                    }
                }
            }
            var en = 1;
            var ev = json_v_obj_get(e, "enabled");
            if (ev != 0) { en = json_v_int(ev); }
            var lf = 0;
            var lv = json_v_obj_get(e, "last_fired_ns");
            if (lv != 0) { lf = json_v_int(lv); }
            vec_push(out, cron_job_new(nm, ex, im, cmd, en, lf));
        }
        i = i + 1;
    }
    return out;
}

#[must_use]
fn _cron_jv_str(v, key) {
    if (v == 0) { return 0; }
    var f = json_v_obj_get(v, key);
    if (f == 0) { return 0; }
    if (json_v_is_str(f) == 0) { return 0; }
    return str_cstr(json_v_str(f));
}

# Write the job table atomically (tmp + rename), the same way `state.json` is
# written — a half-written schedule read by the next timer tick would drop jobs.
# Returns 1 on success, 0 on failure.
fn cron_store_save(root, jobs) {
    var arr = json_v_arr_new();
    var i = 0;
    while (i < vec_len(jobs)) {
        var j = vec_get(jobs, i);
        var o = json_v_obj_new();
        json_v_obj_set(o, str_from("name"), json_v_str_new(str_from(cron_job_name(j))));
        json_v_obj_set(o, str_from("expr"), json_v_str_new(str_from(cron_job_expr(j))));
        json_v_obj_set(o, str_from("image"), json_v_str_new(str_from(cron_job_image(j))));
        var ca = json_v_arr_new();
        var cmd = cron_job_command(j);
        if (cmd != 0) {
            var k = 0;
            while (k < vec_len(cmd)) {
                json_v_arr_push(ca, json_v_str_new(str_from(vec_get(cmd, k))));
                k = k + 1;
            }
        }
        json_v_obj_set(o, str_from("command"), ca);
        json_v_obj_set(o, str_from("enabled"), json_v_int_new(cron_job_enabled(j)));
        json_v_obj_set(o, str_from("last_fired_ns"), json_v_int_new(cron_job_last_fired(j)));
        json_v_arr_push(arr, o);
        i = i + 1;
    }
    var doc = json_v_obj_new();
    json_v_obj_set(doc, str_from("jobs"), arr);
    var s = json_v_build(doc);

    var path = cron_store_path(root);
    var tmp = _container_cat2(path, ".tmp");
    sys_mkdir(root, 493);
    if (file_write_all(tmp, str_data(s), str_len(s)) < 0) { return 0; }
    if (sys_rename(tmp, path) != 0) { sys_unlink(tmp); return 0; }
    return 1;
}

# Index of `name` in `jobs`, or -1.
#[must_use]
fn cron_find(jobs, name) {
    var i = 0;
    while (i < vec_len(jobs)) {
        if (streq(cron_job_name(vec_get(jobs, i)), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ── operations ──

# Add (or replace) a scheduled container. Returns 1, or 0 with the detail
# printed. Replacing rather than refusing a duplicate name matches how a tag
# behaves elsewhere in stiva: the name is a mutable pointer to a definition.
fn cron_add(root, name, expr, image, command) {
    if (name == 0 || strlen(name) == 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, "cron: a job name is required");
        return 0;
    }
    if (cron_expr_is_valid(expr) == 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, _container_cat2("cron: unparseable expression: ", expr));
        return 0;
    }
    if (image == 0 || strlen(image) == 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, "cron: an image reference is required");
        return 0;
    }
    var jobs = cron_store_load(root);
    var at = cron_find(jobs, name);
    var job = cron_job_new(name, expr, image, command, 1, 0);
    if (at >= 0) { vec_set(jobs, at, job); } else { vec_push(jobs, job); }
    if (cron_store_save(root, jobs) == 0) {
        stiva_err_print(STIVA_ERR_IO, "cron: failed to write the schedule");
        return 0;
    }
    return 1;
}

# Remove a job. Returns 1 when one was removed, 0 when the name was unknown.
fn cron_remove(root, name) {
    var jobs = cron_store_load(root);
    var at = cron_find(jobs, name);
    if (at < 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, _container_cat2("cron: no such job: ", name));
        return 0;
    }
    var kept = vec_new();
    var i = 0;
    while (i < vec_len(jobs)) {
        if (i != at) { vec_push(kept, vec_get(jobs, i)); }
        i = i + 1;
    }
    if (cron_store_save(root, kept) == 0) {
        stiva_err_print(STIVA_ERR_IO, "cron: failed to write the schedule");
        return 0;
    }
    return 1;
}

# Enable or disable a job without deleting it. Returns 1/0.
fn cron_set_enabled(root, name, enabled) {
    var jobs = cron_store_load(root);
    var at = cron_find(jobs, name);
    if (at < 0) {
        stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, _container_cat2("cron: no such job: ", name));
        return 0;
    }
    var j: CronJob = vec_get(jobs, at);
    j.enabled = enabled;
    if (cron_store_save(root, jobs) == 0) {
        stiva_err_print(STIVA_ERR_IO, "cron: failed to write the schedule");
        return 0;
    }
    return 1;
}

# Which jobs are due at `now_ns`? Returns a vec of CronJob*, and updates each
# returned job's `last_fired_ns` in `jobs` (the caller persists).
#
# Built on samay's scheduler rather than re-deriving the timing: the
# missed-schedule policy, the catch-up counting and the firing cap are the hard
# part and are already solved there. A samay entry is created per enabled job,
# seeded with the persisted `last_fired`, and `check_due_at` decides.
#
# CRON_SKIP is the policy, not CRON_CATCHUP: a container that missed six hours
# of hourly runs because the machine was off should start ONCE, not sixty times.
# samay logs the drop either way, so nothing is silent.
fn cron_due_at(jobs, now_ns) {
    var due = vec_new();
    var sched = cron_scheduler_new();
    var i = 0;
    while (i < vec_len(jobs)) {
        var j = vec_get(jobs, i);
        if (cron_job_enabled(j) == 1) {
            var expr = _cron_parsed(cron_job_expr(j));
            if (expr != 0) {
                var tmpl = cron_task_template_new(str_from(cron_job_name(j)),
                  str_from(""), str_from(""), 0, resource_req_default());
                var e = cron_entry_new(str_from(cron_job_name(j)), expr, tmpl, 1, CRON_SKIP);
                CronEntry_set_last_fired(e, cron_job_last_fired(j));
                cron_scheduler_add_entry(sched, e);
            }
        }
        i = i + 1;
    }
    var tasks = cron_scheduler_check_due_at(sched, now_ns);
    # Map the fired tasks back to stiva jobs. samay appends " (cron)" to the
    # task name, so it has to come off before the lookup.
    var t = 0;
    while (t < vec_len(tasks)) {
        var nm = _cron_strip_suffix(str_cstr(ScheduledTask_name(vec_get(tasks, t))));
        var at = cron_find(jobs, nm);
        if (at >= 0) {
            var j2: CronJob = vec_get(jobs, at);
            j2.last_fired_ns = now_ns;
            vec_push(due, vec_get(jobs, at));
        }
        t = t + 1;
    }
    # Advance last_fired for every ENABLED job, not only the fired ones —
    # otherwise a job whose expression did not match keeps its stale anchor and
    # the next check re-counts the whole interval as missed.
    var k = 0;
    while (k < vec_len(jobs)) {
        var j3: CronJob = vec_get(jobs, k);
        if (j3.enabled == 1) { j3.last_fired_ns = now_ns; }
        k = k + 1;
    }
    return due;
}

# Strip samay's " (cron)" task-name suffix.
#[must_use]
fn _cron_strip_suffix(name) {
    var n = strlen(name);
    var suffix = " (cron)";
    var sl = strlen(suffix);
    if (n <= sl) { return name; }
    if (memeq(name + n - sl, suffix, sl) == 0) { return name; }
    return _img_slice(name, 0, n - sl);
}

# --- health.cyr ---

# stiva — container health monitoring (majra heartbeat FSM wrapper)
# Ported from rust-old/src/health.rs.
#
# Wraps majra's ConcurrentHeartbeatTracker (Cyrius bundle: chb_* in
# lib/majra.cyr) for container liveness, and layers restart-policy tracking
# on top. The Rust `RwLock<HashMap<String, RestartState>>` collapses to a
# plain map handle here (the chb_* tracker is already mutex-guarded); the
# async fns become synchronous.
#
# Enum members are namespaced HEALTH_* / RESTART_* — Cyrius hoists enum
# members to global constants under "last-def-wins", so bare names would
# collide with other modules (see error.cyr / oci.cyr).
#
# NOT PORTED: run_probe / start_probe_loop. `exec_in_container` landed in §D, so
# the exec half is available; what is still missing is a timer/task loop to drive
# the probes on an interval. See docs/development/roadmap.md.

# ── RestartPolicy (rust-old: enum RestartPolicy) ───────────────
# Serde kebab-case wire names: never / always / on-failure / unless-stopped.
# `OnFailure { max_retries }` carries a payload — the u32 is stored on the
# RestartState alongside the policy kind (see RESTART_STATE).
enum RestartPolicy {
    HEALTH_RESTART_NEVER = 0;
    HEALTH_RESTART_ALWAYS = 1;
    HEALTH_RESTART_ON_FAILURE = 2;
    HEALTH_RESTART_UNLESS_STOPPED = 3;
}

# Serde wire name for a restart-policy kind (kebab-case).
#[must_use]
fn restart_policy_name(kind) {
    if (kind == HEALTH_RESTART_NEVER) { return "never"; }
    if (kind == HEALTH_RESTART_ALWAYS) { return "always"; }
    if (kind == HEALTH_RESTART_ON_FAILURE) { return "on-failure"; }
    if (kind == HEALTH_RESTART_UNLESS_STOPPED) { return "unless-stopped"; }
    return "never";
}

# Inverse of restart_policy_name: serde wire name → RESTART_* ordinal, or -1 for
# an unknown token (used by ansamblu.parse_ansamblu for `restart = "..."`).
#[must_use]
fn restart_policy_from_name(name) {
    if (streq(name, "never") == 1) { return HEALTH_RESTART_NEVER; }
    if (streq(name, "always") == 1) { return HEALTH_RESTART_ALWAYS; }
    if (streq(name, "on-failure") == 1) { return HEALTH_RESTART_ON_FAILURE; }
    if (streq(name, "unless-stopped") == 1) { return HEALTH_RESTART_UNLESS_STOPPED; }
    return 0 - 1;
}

# ── HealthStatus (rust-old: enum HealthStatus) ────────────────
enum HealthStatus {
    HEALTH_STATUS_HEALTHY = 0;
    HEALTH_STATUS_UNHEALTHY = 1;
    HEALTH_STATUS_STARTING = 2;
    HEALTH_STATUS_UNKNOWN = 3;
}

# Serde wire name for a HealthStatus. Rust derives serde with no rename, so
# variants serialize by their PascalCase name.
#[must_use]
fn health_status_name(status) {
    if (status == HEALTH_STATUS_HEALTHY) { return "Healthy"; }
    if (status == HEALTH_STATUS_UNHEALTHY) { return "Unhealthy"; }
    if (status == HEALTH_STATUS_STARTING) { return "Starting"; }
    if (status == HEALTH_STATUS_UNKNOWN) { return "Unknown"; }
    return "Unknown";
}

# majra NodeStatus raw values (lib/majra.cyr: STATUS_ONLINE=0, SUSPECT=1,
# OFFLINE=2). Referenced by literal here — the chb_* tracker stores/returns
# these as raw ints (node_state offset 0) — to keep this module parseable
# standalone and avoid re-minting majra's enum names (last-def-wins).
enum HealthMajraStatus {
    HEALTH_MAJRA_ONLINE = 0;
    HEALTH_MAJRA_SUSPECT = 1;
    HEALTH_MAJRA_OFFLINE = 2;
}

# Map a majra NodeStatus to a HealthStatus
# (rust-old: impl From<Status> for HealthStatus).
#   Online  -> Healthy
#   Suspect -> Starting
#   Offline -> Unhealthy
#   _       -> Unknown
#[must_use]
fn health_status_from_majra(s) {
    if (s == HEALTH_MAJRA_ONLINE) { return HEALTH_STATUS_HEALTHY; }
    if (s == HEALTH_MAJRA_SUSPECT) { return HEALTH_STATUS_STARTING; }
    if (s == HEALTH_MAJRA_OFFLINE) { return HEALTH_STATUS_UNHEALTHY; }
    return HEALTH_STATUS_UNKNOWN;
}

# ── RestartState (rust-old: struct RestartState) ───────────────
# Per-container restart bookkeeping.
#   policy_kind  — one of HEALTH_RESTART_*
#   max_retries  — the OnFailure payload (0 for other policies)
#   restart_count
#   user_stopped — 1 iff the user explicitly stopped the container
struct RestartState {
    policy_kind;
    max_retries;
    restart_count;
    user_stopped;
}

#[must_use]
fn restart_state_new(policy_kind, max_retries) {
    var r = alloc(32);
    var rr: RestartState = r;
    rr.policy_kind = policy_kind;
    rr.max_retries = max_retries;
    rr.restart_count = 0;
    rr.user_stopped = 0;
    return r;
}

# ── HealthMonitor (rust-old: struct HealthMonitor) ──────────────
# tracker        — ConcurrentHeartbeatTracker handle (chb_*)
# restart_states — map: container_id cstr -> RestartState ptr
struct HealthMonitor {
    tracker;
    restart_states;
}

# Create a new health monitor with default heartbeat config
# (suspect_after 30s, offline_after 90s, no eviction).
# (rust-old: HealthMonitor::new / Default.)
#[must_use]
fn health_monitor_new() {
    var cfg = heartbeat_config_new(30000000000, 90000000000, 0);
    return health_monitor_with_config(cfg);
}

# Create with a custom heartbeat config handle (rust-old: with_config).
#[must_use]
fn health_monitor_with_config(config) {
    var m = alloc(16);
    var mm: HealthMonitor = m;
    mm.tracker = chb_tracker_new(config);
    mm.restart_states = map_new();
    return m;
}

# Register a container for health tracking (rust-old: register, async).
# `restart_policy_kind` is one of HEALTH_RESTART_*; `max_retries` is the
# OnFailure payload (pass 0 for other policies).
fn health_monitor_register(m, container_id, restart_policy_kind, max_retries) {
    var mm: HealthMonitor = m;
    # Register with the heartbeat tracker. The Rust builds a serde_json
    # metadata blob {"type":"container","restart_policy":"..."}; we register
    # with no metadata payload (0) — parity of behaviour, not of the opaque
    # blob (the tracker never reads it).
    chb_register(mm.tracker, container_id, 0);

    var state = restart_state_new(restart_policy_kind, max_retries);
    map_set(mm.restart_states, container_id, state);
    return 0;
}

# Record a successful heartbeat. Returns 1 if the container is tracked,
# 0 otherwise (rust-old: heartbeat -> bool).
fn health_monitor_heartbeat(m, container_id) {
    var mm: HealthMonitor = m;
    return chb_heartbeat(mm.tracker, container_id);
}

# Deregister a container from health tracking (rust-old: deregister, async).
fn health_monitor_deregister(m, container_id) {
    var mm: HealthMonitor = m;
    chb_deregister(mm.tracker, container_id);
    map_delete(mm.restart_states, container_id);
    return 0;
}

# Mark a container as explicitly stopped by the user (rust-old:
# mark_user_stopped, async). No-op if the container is not tracked.
fn health_monitor_mark_user_stopped(m, container_id) {
    var mm: HealthMonitor = m;
    var state = map_get(mm.restart_states, container_id);
    if (state != 0) {
        var s: RestartState = state;
        s.user_stopped = 1;
    }
    return 0;
}

# Get health status for a container (rust-old: get_status). Unknown if the
# container is not tracked.
#[inline]
#[must_use]
fn health_monitor_get_status(m, container_id) {
    var mm: HealthMonitor = m;
    var ns = chb_get(mm.tracker, container_id);
    if (ns == 0) { return HEALTH_STATUS_UNKNOWN; }
    return health_status_from_majra(load64(ns));
}

# Update all container statuses and return a vec of container-id cstrs that
# need restart (rust-old: check_and_restart, async).
#
# Transitions the FSM (Online->Suspect->Offline), then for every currently-
# offline container consults its restart policy:
#   Never          -> false
#   Always         -> !user_stopped
#   OnFailure(n)   -> !user_stopped && restart_count < n
#   UnlessStopped  -> !user_stopped
# Each restart increments restart_count.
#[must_use]
fn health_monitor_check_and_restart(m) {
    var mm: HealthMonitor = m;

    # Advance the FSM.
    chb_update_statuses(mm.tracker);

    var offline = chb_list_by_status(mm.tracker, HEALTH_MAJRA_OFFLINE);
    var needs_restart = vec_new();

    var i = 0;
    var len = vec_len(offline);
    while (i < len) {
        var id = vec_get(offline, i);
        var state = map_get(mm.restart_states, id);
        if (state != 0) {
            var s: RestartState = state;
            var should_restart = _health_should_restart(s.policy_kind, s.max_retries, s.restart_count, s.user_stopped);
            if (should_restart == 1) {
                s.restart_count = s.restart_count + 1;
                vec_push(needs_restart, id);
            }
        }
        i = i + 1;
    }

    return needs_restart;
}

# Restart-eligibility predicate for an offline container. Returns 1/0.
#[must_use]
fn _health_should_restart(policy_kind, max_retries, restart_count, user_stopped) {
    if (policy_kind == HEALTH_RESTART_NEVER) { return 0; }
    if (policy_kind == HEALTH_RESTART_ALWAYS) {
        if (user_stopped == 0) { return 1; }
        return 0;
    }
    if (policy_kind == HEALTH_RESTART_ON_FAILURE) {
        if (user_stopped == 0 && restart_count < max_retries) { return 1; }
        return 0;
    }
    if (policy_kind == HEALTH_RESTART_UNLESS_STOPPED) {
        if (user_stopped == 0) { return 1; }
        return 0;
    }
    return 0;
}

# Get the restart count for a container (rust-old: restart_count, async).
# Returns 0 for untracked containers.
#[must_use]
fn health_monitor_restart_count(m, container_id) {
    var mm: HealthMonitor = m;
    var state = map_get(mm.restart_states, container_id);
    if (state == 0) { return 0; }
    var s: RestartState = state;
    return s.restart_count;
}

# Number of tracked containers (rust-old: len).
#[inline]
#[must_use]
fn health_monitor_len(m) {
    var mm: HealthMonitor = m;
    return chb_len(mm.tracker);
}

# Whether any containers are tracked (rust-old: is_empty).
#[inline]
#[must_use]
fn health_monitor_is_empty(m) {
    var mm: HealthMonitor = m;
    return chb_is_empty(mm.tracker);
}

# ── DEFERRED (land with runtime async exec + tokio infra) ──────────
# rust-old/src/health.rs also defines two probe-driver methods that depend
# on runtime::exec_in_container (itself DEFERRED in src/runtime.cyr — async,
# kavach exec) plus tokio timeout / task spawn / interval, none of which the
# ported base provides yet:
#
#   async fn run_probe(&self, container_id: &str, pid: u32,
#                      command: &[String], timeout_secs: u64) -> bool
#       tokio::time::timeout(runtime::exec_in_container(pid, command, [], None));
#       on Ok(exit_code == 0) -> heartbeat + true; else false.
#
#   fn start_probe_loop(container_id: String, pid: u32, command: Vec<String>,
#                       interval_secs: u64, timeout_secs: u64)
#                       -> tokio::task::JoinHandle<()>
#       tokio::spawn loop: a fresh HealthMonitor registers the container
#       (RestartPolicy::Never) and runs run_probe every interval_secs.
#
# These land once runtime's async exec surface and a Cyrius task/timer
# runtime are available. Tracked in the roadmap.

# --- ansamblu.cyr ---

# stiva — multi-container orchestration (ansamblu): types, DAG ordering,
# rolling-update / scale planning, service→config conversion.
# Ported from rust-old/src/ansamblu.rs.
#
# What ports cleanly here (self-contained, or depends only on already-ported
# container.cyr / error.cyr and the sibling health.cyr):
#   struct ServiceDef / NetworkDef / VolumeDef / HealthCheck / AnsambluFile
#   struct AnsambluSession / RollingUpdateConfig / RollingUpdatePlan
#   default_interval / default_timeout / default_retries
#   default_max_surge / default_max_unavailable / default_update_delay
#   rolling_update_config_default
#   plan_rolling_update / compute_scale / service_container_ids
#   service_to_config / replica_count
#   build_dag / resolve_startup_order / ready_services
#
# In rust-old the DAG helpers delegate to `majra::queue::Dag` +
# `DagScheduler::topological_sort` / `::new(..).ready(..)`. The vendored
# majra bundle (lib/majra.cyr) exposes only the workflow-step DAG engine, not
# that `queue::Dag { edges }` surface — so the two graph algorithms
# (dependency-first topological sort with cycle detection, and the "ready"
# frontier) are implemented locally here over the AnsambluFile's own
# service→depends_on adjacency. Semantics match the Rust oracle.
#
# What is DEFERRED (see the block at the bottom):
#   * parse_ansamblu — TOML → AnsambluFile. ACHIEVABLE via bayan's TOML object
#     model (`toml_parse`/`toml_get`), exactly like build.cyr's now-ported
#     parse_build_spec — it just isn't wired yet (NOT a Cyrius gap).
#   * the serde JSON round-trip tests likewise use bayan's JSON codec — not
#     yet ported. (compose-YAML is no longer a stdlib gap either: bayan 1.2.0
#     ships a YAML parser, wired in src/convert.cyr at v3.0.6.)
#
# RestartPolicy is `pub use crate::health::RestartPolicy` in the oracle; it is
# defined once in the sibling health.cyr (RESTART_POLICY_*), referenced here —
# NOT redefined (Cyrius hoists enum members to globals, last-def-wins, so a
# second definition would collide).
#
# Error mapping (mirrors error.cyr): Rust `Err(StivaError::Ansamblu(String))`
# becomes an integer sentinel — resolve_startup_order returns 0 on a
# dependency cycle; the caller reports it via
# stiva_err_print(STIVA_ERR_ANSAMBLU, detail).

# ── serde defaults (rust-old: default_* fns) ────────────────
# HealthCheck field defaults.
#[must_use]
fn default_interval() {
    return 30;
}
#[must_use]
fn default_timeout() {
    return 5;
}
#[must_use]
fn default_retries() {
    return 3;
}

# RollingUpdateConfig field defaults.
#[must_use]
fn default_max_surge() {
    return 1;
}
#[must_use]
fn default_max_unavailable() {
    return 1;
}
#[must_use]
fn default_update_delay() {
    return 10;
}

# ── HealthCheck (rust-old: struct HealthCheck) ────────────────
# `command` is a Vec<String> (vec handle, 0 = empty). interval_secs /
# timeout_secs are u64; retries is u32. 4 fields × 8 = 32 bytes.
struct HealthCheck {
    command;
    interval_secs;
    timeout_secs;
    retries;
}

# Allocate a HealthCheck with serde defaults for the numeric fields.
#[must_use]
fn health_check_new(command) {
    var p = alloc(32);
    var h: HealthCheck = p;
    h.command = command;
    h.interval_secs = default_interval();
    h.timeout_secs = default_timeout();
    h.retries = default_retries();
    return p;
}

# ── ServiceDef (rust-old: struct ServiceDef) ────────────────
# image: String (cstr). command/ports/volumes/depends_on: Vec<String>
# (vec handle, 0 = empty). env: HashMap<String,String> (map handle, 0 =
# empty). replicas: Option<u32> → count | -1 for None. restart:
# Option<RestartPolicy> → RESTART_POLICY_* ordinal | -1 for None.
# health_check: Option<HealthCheck> → HealthCheck* | 0 for None.
# 9 fields × 8 = 72 bytes.
struct ServiceDef {
    image;
    command;
    env;
    ports;
    volumes;
    depends_on;
    replicas;
    restart;
    health_check;
}

# Construct a ServiceDef. Callers pass 0 for empty vecs/maps, -1 for a None
# replicas/restart, and 0 for a None health_check.
#[must_use]
fn service_def_new(image, command, env, ports, volumes, depends_on) {
    var p = alloc(72);
    var s: ServiceDef = p;
    s.image = image;
    s.command = command;
    s.env = env;
    s.ports = ports;
    s.volumes = volumes;
    s.depends_on = depends_on;
    s.replicas = 0 - 1;
    s.restart = 0 - 1;
    s.health_check = 0;
    return p;
}

# ── NetworkDef (rust-old: struct NetworkDef, Default) ────────────
# driver / subnet: Option<String> → cstr | 0 for None. 2 × 8 = 16 bytes.
struct NetworkDef {
    driver;
    subnet;
}

# Default NetworkDef — both fields None (0).
#[must_use]
fn network_def_default() {
    var p = alloc(16);
    var n: NetworkDef = p;
    n.driver = 0;
    n.subnet = 0;
    return p;
}

# ── VolumeDef (rust-old: struct VolumeDef, Default) ──────────────
# driver: Option<String> → cstr | 0. 1 × 8 = 8 bytes.
struct VolumeDef {
    driver;
}

# Default VolumeDef — driver None (0).
#[must_use]
fn volume_def_default() {
    # VolumeDef is single-field; Cyrius gives single-field structs VALUE
    # semantics, so `v.driver = 0` would not write through the pointer.
    # Store the field (driver = None) directly at offset 0.
    var p = alloc(8);
    store64(p, 0);
    return p;
}

# ── AnsambluFile (rust-old: struct AnsambluFile) ───────────────
# services: HashMap<String, ServiceDef*> (map handle). networks:
# HashMap<String, NetworkDef*> (map handle, 0 = empty). volumes:
# HashMap<String, VolumeDef*> (map handle, 0 = empty). 3 × 8 = 24 bytes.
struct AnsambluFile {
    services;
    networks;
    volumes;
}

# Construct an AnsambluFile from three (already-populated) map handles.
#[must_use]
fn ansamblu_file_new(services, networks, volumes) {
    var p = alloc(24);
    var a: AnsambluFile = p;
    a.services = services;
    a.networks = networks;
    a.volumes = volumes;
    return p;
}

# ── AnsambluSession (rust-old: struct AnsambluSession) ───────────
# id: String (cstr). services: HashMap<String, Vec<String>> (map handle:
# service name → vec of container-id cstrs). networks / startup_order:
# Vec<String> (vec handle). created_at: DateTime<Utc> → epoch millis i64.
# 5 fields × 8 = 40 bytes.
struct AnsambluSession {
    id;
    services;
    networks;
    startup_order;
    created_at;
}

#[must_use]
fn ansamblu_session_new(id, services, networks, startup_order, created_at) {
    var p = alloc(40);
    var s: AnsambluSession = p;
    s.id = id;
    s.services = services;
    s.networks = networks;
    s.startup_order = startup_order;
    s.created_at = created_at;
    return p;
}

# ── RollingUpdateConfig (rust-old: struct RollingUpdateConfig) ────
# max_surge / max_unavailable: u32. delay_secs: u64. 3 × 8 = 24 bytes.
struct RollingUpdateConfig {
    max_surge;
    max_unavailable;
    delay_secs;
}

# Default RollingUpdateConfig — rust-old impl Default: { 1, 1, 10 }.
# (Matches the serde default_* fns.)
#[must_use]
fn rolling_update_config_default() {
    var p = alloc(24);
    var c: RollingUpdateConfig = p;
    c.max_surge = default_max_surge();
    c.max_unavailable = default_max_unavailable();
    c.delay_secs = default_update_delay();
    return p;
}

# ── RollingUpdatePlan (rust-old: struct RollingUpdatePlan) ───────
# service_name: String. old_containers: Vec<String>. new_replica_count: u32.
# new_image: String. config: RollingUpdateConfig*. 5 × 8 = 40 bytes.
struct RollingUpdatePlan {
    service_name;
    old_containers;
    new_replica_count;
    new_image;
    config;
}

# ── replica_count (rust-old: replica_count) ─────────────────
# service.replicas.unwrap_or(1).max(1) — a None (-1) or a 0 both become 1.
#[inline]
#[must_use]
fn replica_count(service) {
    var s: ServiceDef = service;
    var r = s.replicas;
    if (r < 1) { return 1; }
    return r;
}

# ── plan_rolling_update (rust-old: plan_rolling_update) ──────────
# Build a RollingUpdatePlan from the session's current containers for
# `service_name` and the new ServiceDef. old_containers defaults to an empty
# vec when the service is absent. new_replica_count = replica_count(new).
# In rust-old this is infallible-in-practice (returns Ok(...)); here it
# returns the RollingUpdatePlan* directly.
#[must_use]
fn plan_rolling_update(session, service_name, new_service) {
    var sess: AnsambluSession = session;
    var old_containers = map_get(sess.services, service_name);
    if (old_containers == 0) { old_containers = vec_new(); }

    var new_svc: ServiceDef = new_service;
    var p = alloc(40);
    var plan: RollingUpdatePlan = p;
    plan.service_name = service_name;
    plan.old_containers = old_containers;
    plan.new_replica_count = replica_count(new_service);
    plan.new_image = new_svc.image;
    plan.config = rolling_update_config_default();
    return p;
}

# ── compute_scale (rust-old: compute_scale) ─────────────────
# Returns (to_add, to_remove). Cyrius has no tuple return; the caller passes
# `out` (an i64* to a 2-slot buffer): out[0] = to_add (u32),
# out[1] = to_remove (vec handle of container-id cstrs, newest-first).
#   desired > current → (desired-current, [])
#   desired < current → (0, last `current-desired` ids reversed)
#   desired == current → (0, [])
# The "reversed, take remove_count" matches Rust `ids.iter().rev().take(n)`.
fn compute_scale(session, service_name, desired, out) {
    var sess: AnsambluSession = session;
    var ids = map_get(sess.services, service_name);
    var current = 0;
    if (ids != 0) { current = vec_len(ids); }

    if (desired > current) {
        store64(out, desired - current);
        store64(out + 8, vec_new());
        return 0;
    }
    if (desired < current) {
        var remove_count = current - desired;
        var to_remove = vec_new();
        # ids present (current > desired >= 0 implies current > 0).
        var taken = 0;
        var i = current - 1;
        while (i >= 0 && taken < remove_count) {
            vec_push(to_remove, vec_get(ids, i));
            taken = taken + 1;
            i = i - 1;
        }
        store64(out, 0);
        store64(out + 8, to_remove);
        return 0;
    }
    store64(out, 0);
    store64(out + 8, vec_new());
    return 0;
}

# ── service_container_ids (rust-old: service_container_ids) ──────
# The session's container ids for a service, or an empty vec when absent.
#[must_use]
fn service_container_ids(session, service_name) {
    var sess: AnsambluSession = session;
    var ids = map_get(sess.services, service_name);
    if (ids == 0) { return vec_new(); }
    return ids;
}

# ── service_to_config (rust-old: service_to_config) ──────────────
# Convert a ServiceDef into a container ContainerConfig for one replica.
# Name is "{service}-{replica_index}" when replicas > 1, else just the
# service name. Copies command / env / ports / volumes; everything else is
# the ContainerConfig default.
#[must_use]
fn service_to_config(service_name, service, replica_index) {
    var s: ServiceDef = service;

    # service.replicas.unwrap_or(1) > 1  (None (-1) → 1, so > 1 is false)
    var reps = s.replicas;
    if (reps < 0) { reps = 1; }

    var name = service_name;
    if (reps > 1) {
        # "{service_name}-{replica_index}"
        var sb = str_builder_new();
        str_builder_add_cstr(sb, service_name);
        str_builder_putc(sb, 45);          # '-'
        str_builder_add_int(sb, replica_index);
        name = str_cstr(str_builder_build(sb));
    }

    # ContainerConfig is defined in the sibling container.cyr; write its
    # fields by their documented byte offsets (name=0, command=8, env=16,
    # volumes=24, ports=32) rather than a cross-file struct annotation, which
    # a standalone parse of this module cannot resolve.
    var cfg = container_config_default();
    store64(cfg, name);           # name
    store64(cfg + 8, s.command);  # command
    store64(cfg + 16, s.env);     # env
    store64(cfg + 24, s.volumes); # volumes
    store64(cfg + 32, s.ports);   # ports
    return cfg;
}

# ── DAG dependency resolution ─────────────────────
# rust-old builds a majra `Dag { edges: name → depends_on }` and delegates
# to DagScheduler. The vendored majra bundle lacks that surface, so the two
# algorithms below operate directly on the AnsambluFile's service map.

# The service names of an AnsambluFile, as a vec of cstr keys.
#[must_use]
fn _ansamblu_service_names(spec) {
    var s: AnsambluFile = spec;
    return map_keys(s.services);
}

# depends_on vec for a service name (empty vec if the service or its deps are
# absent). Never returns 0.
#[must_use]
fn _ansamblu_deps_of(spec, name) {
    var s: AnsambluFile = spec;
    var svc = map_get(s.services, name);
    if (svc == 0) { return vec_new(); }
    var sd: ServiceDef = svc;
    if (sd.depends_on == 0) { return vec_new(); }
    return sd.depends_on;
}

# 1 iff `name` is present in vec `names` (cstr equality), else 0.
#[must_use]
fn _ansamblu_name_in(names, name) {
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(names, i), name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# build_dag — placeholder for the rust-old `majra::queue::Dag`. Since the
# adjacency lives in the AnsambluFile itself and the bundle exposes no
# compatible Dag type, this returns the spec handle unchanged; the sort /
# ready helpers read the service map directly. Kept for name parity.
#[must_use]
fn build_dag(spec) {
    return spec;
}

# resolve_startup_order — dependency-first topological order (Kahn's
# algorithm). Returns a vec of service-name cstrs on success, or 0 on a
# dependency cycle (rust-old: Err(StivaError::Ansamblu("dependency cycle
# detected"))). Only edges to services that exist in the file are counted,
# matching the Rust DAG which keys strictly off the declared services.
#[must_use]
fn resolve_startup_order(spec) {
    var names = _ansamblu_service_names(spec);
    var count = vec_len(names);
    var order = vec_new();

    # in_degree[i] = number of THIS service's depends_on entries that name a
    # service also present in the file (unresolved edges are ignored, as in
    # the majra DAG). placed[i] = 1 once emitted.
    var in_degree = alloc(count * 8);
    var placed = alloc(count * 8);
    var i = 0;
    while (i < count) {
        var name = vec_get(names, i);
        var deps = _ansamblu_deps_of(spec, name);
        var dn = vec_len(deps);
        var deg = 0;
        var j = 0;
        while (j < dn) {
            var d = vec_get(deps, j);
            if (_ansamblu_name_in(names, d) == 1) { deg = deg + 1; }
            j = j + 1;
        }
        store64(in_degree + i * 8, deg);
        store64(placed + i * 8, 0);
        i = i + 1;
    }

    # Emit services with in-degree 0, then decrement dependents, repeat.
    var emitted = 0;
    while (emitted < count) {
        var progressed = 0;
        i = 0;
        while (i < count) {
            if (load64(placed + i * 8) == 0 && load64(in_degree + i * 8) == 0) {
                var ni = vec_get(names, i);
                vec_push(order, ni);
                store64(placed + i * 8, 1);
                emitted = emitted + 1;
                progressed = 1;
                # decrement in-degree of every not-yet-placed service that
                # depends on ni.
                var k = 0;
                while (k < count) {
                    if (load64(placed + k * 8) == 0) {
                        var kdeps = _ansamblu_deps_of(spec, vec_get(names, k));
                        var kd = vec_len(kdeps);
                        var m = 0;
                        while (m < kd) {
                            if (streq(vec_get(kdeps, m), ni) == 1) {
                                store64(in_degree + k * 8, load64(in_degree + k * 8) - 1);
                            }
                            m = m + 1;
                        }
                    }
                    k = k + 1;
                }
            }
            i = i + 1;
        }
        if (progressed == 0) {
            # Remaining nodes form a cycle.
            return 0;
        }
    }

    return order;
}

# ready_services — services whose every declared (and present) dependency is
# in `completed` and which are not themselves completed. `completed` is a set
# represented as a map (name cstr → any non-null); a container-id vec-of-name
# also works via _ansamblu_name_in. Here `completed` is a map handle (0 =
# empty). Returns a vec of ready service-name cstrs. Mirrors
# rust-old `DagScheduler::new(&dag).ready(completed)`.
#[must_use]
fn ready_services(spec, completed) {
    var names = _ansamblu_service_names(spec);
    var count = vec_len(names);
    var ready = vec_new();

    var i = 0;
    while (i < count) {
        var name = vec_get(names, i);
        var done = 0;
        if (completed != 0 && map_has(completed, name) == 1) { done = 1; }
        if (done == 0) {
            var deps = _ansamblu_deps_of(spec, name);
            var dn = vec_len(deps);
            var all_done = 1;
            var j = 0;
            while (j < dn) {
                var d = vec_get(deps, j);
                # Only depends_on entries that name an existing service gate
                # readiness (matches the DAG keyed off declared services).
                if (_ansamblu_name_in(names, d) == 1) {
                    if (completed == 0 || map_has(completed, d) == 0) {
                        all_done = 0;
                    }
                }
                j = j + 1;
            }
            if (all_done == 1) { vec_push(ready, name); }
        }
        i = i + 1;
    }

    return ready;
}

# ── parse_ansamblu (rust-old: toml::from_str → AnsambluFile) ─────────
# Drives bayan's flat TOML section model. Dotted headers become section names
# verbatim: `[services.web]` → "services.web", `[services.web.health_check]` →
# "services.web.health_check", so services/networks/volumes are enumerated by
# scanning for the "<kind>.<name>" prefix (a single trailing segment). env is a
# TOML inline table (`{ K = "V", ... }`) captured raw by bayan, parsed here.

# The single leaf segment after `prefix` in section-name Str `sname`, iff there
# is exactly one more segment (no further '.'); else 0. E.g. ("services.web",
# "services.") → "web"; ("services.web.health_check", "services.") → 0.
#[must_use]
fn _ans_prefixed_name(sname, prefix) {
    var sd = str_data(sname);
    var slen = str_len(sname);
    var plen = strlen(prefix);
    if (slen <= plen) { return 0; }
    if (memeq(sd, prefix, plen) == 0) { return 0; }
    var j = plen;
    while (j < slen) {
        if (load8(sd + j) == 46) { return 0; }   # '.' → not a single segment
        j = j + 1;
    }
    return str_cstr(str_from_buf(sd + plen, slen - plen));
}

# Service name X iff `sname` is "services.X.health_check" (X single-segment); else 0.
#[must_use]
fn _ans_healthcheck_service(sname) {
    var sd = str_data(sname);
    var slen = str_len(sname);
    var pre = "services.";
    var plen = strlen(pre);
    var suf = ".health_check";
    var suflen = strlen(suf);
    if (slen <= plen + suflen) { return 0; }
    if (memeq(sd, pre, plen) == 0) { return 0; }
    if (memeq(sd + slen - suflen, suf, suflen) == 0) { return 0; }
    var xlen = slen - suflen - plen;
    var j = 0;
    while (j < xlen) {
        if (load8(sd + plen + j) == 46) { return 0; }   # multi-segment → not a plain service
        j = j + 1;
    }
    return str_cstr(str_from_buf(sd + plen, xlen));
}

# Parse a TOML inline table `{ K = "V", K2 = "V2" }` (raw cstr, as bayan
# captures it) into a cstr→cstr map. Returns 0 for 0/no-brace input. Values may
# be double-quoted or bare (bare trimmed of trailing whitespace).
fn _ans_inline_table(raw) {
    if (raw == 0) { return 0; }
    var len = strlen(raw);
    var i = 0;
    while (i < len && load8(raw + i) != 123) { i = i + 1; }   # '{'
    if (i >= len) { return 0; }
    i = i + 1;
    var m = map_new();
    while (i < len) {
        # skip whitespace and commas between entries
        while (i < len) {
            var c = load8(raw + i);
            if (c == 32 || c == 9 || c == 44) { i = i + 1; } else { break; }
        }
        if (i >= len) { break; }
        if (load8(raw + i) == 125) { break; }               # '}'
        # key
        var kstart = i;
        while (i < len) {
            var c = load8(raw + i);
            if (c == 61 || c == 32 || c == 9) { break; }
            i = i + 1;
        }
        var key = str_cstr(str_from_buf(raw + kstart, i - kstart));
        while (i < len && (load8(raw + i) == 32 || load8(raw + i) == 9)) { i = i + 1; }
        if (i >= len || load8(raw + i) != 61) { break; }     # malformed
        i = i + 1;
        while (i < len && (load8(raw + i) == 32 || load8(raw + i) == 9)) { i = i + 1; }
        # value — must be a double-quoted string (env is HashMap<String,String>);
        # a bare/numeric value is a serde type error → signal -1 to the caller.
        if (i >= len || load8(raw + i) != 34) { return 0 - 1; }   # not '"'
        i = i + 1;
        var vs = i;
        while (i < len && load8(raw + i) != 34) { i = i + 1; }
        var val = str_cstr(str_from_buf(raw + vs, i - vs));
        if (i < len) { i = i + 1; }
        map_set(m, key, val);
    }
    return m;
}

# Concatenate two cstrs into a fresh cstr (ansamblu-local).
#[must_use]
fn _ans_cat(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    var out = alloc(la + lb + 1);
    memcpy(out, a, la);
    memcpy(out + la, b, lb);
    store8(out + la + lb, 0);
    return out;
}

# Scan the RAW toml for `[prefix<name>]` single-bracket headers and return a map
# (used as a set: name→name) of the single-segment `<name>`s. bayan drops a
# section that has no key=values (e.g. an empty `[volumes.pgdata]`), so
# networks/volumes must be enumerated from the raw headers to keep those.
fn _ans_header_names(toml_str, prefix) {
    var names = map_new();
    var len = strlen(toml_str);
    var plen = strlen(prefix);
    var i = 0;
    while (i < len) {
        while (i < len && (load8(toml_str + i) == 32 || load8(toml_str + i) == 9)) { i = i + 1; }
        if (i < len && load8(toml_str + i) == 91) {          # '['
            if (i + 1 < len && load8(toml_str + i + 1) == 91) {
                # '[[' array-of-tables — not used by ansamblu; skip.
            } else {
                var hstart = i + 1;
                var j = hstart;
                while (j < len && load8(toml_str + j) != 93 && load8(toml_str + j) != 10) { j = j + 1; }
                var hlen = j - hstart;
                if (hlen > plen && memeq(toml_str + hstart, prefix, plen) == 1) {
                    var ok = 1;
                    var k = plen;
                    while (k < hlen) {
                        if (load8(toml_str + hstart + k) == 46) { ok = 0; }   # '.' → multi-segment
                        k = k + 1;
                    }
                    if (ok == 1) {
                        var nm = str_cstr(str_from_buf(toml_str + hstart + plen, hlen - plen));
                        map_set(names, nm, nm);
                    }
                }
            }
        }
        while (i < len && load8(toml_str + i) != 10) { i = i + 1; }
        if (i < len) { i = i + 1; }
    }
    return names;
}

# Pairs of the section named `full` (exact), or 0 when absent (bayan dropped it
# because it had no key=values).
fn _ans_section_pairs(sections, full) {
    var secs = bayan_toml_get_sections(sections, full);
    if (vec_len(secs) == 0) { return 0; }
    return bayan_toml_section_pairs(vec_get(secs, 0));
}

# Parse an ansamblu TOML file into an AnsambluFile* (rust-old: parse_ansamblu).
# Returns 0 on error (rust: Err(StivaError::Ansamblu)) — which covers malformed
# TOML, an empty string, and a file with no `[services.*]` (serde requires the
# `services` field; bayan is lenient, so all three reduce to "no services").
#[must_use]
fn parse_ansamblu(toml_str) {
    sakshi_info("parsing ansamblu file", strlen("parsing ansamblu file"));
    var sections = bayan_toml_parse(str_from(toml_str));
    var nsec = vec_len(sections);

    # Pass 1: [services.NAME] → ServiceDef.
    var services = map_new();
    var i = 0;
    while (i < nsec) {
        var sec = vec_get(sections, i);
        var svc_name = _ans_prefixed_name(bayan_toml_section_name(sec), "services.");
        if (svc_name != 0) {
            var pairs = bayan_toml_section_pairs(sec);
            var image = _bld_val_cstr(bayan_toml_get(pairs, "image"));
            if (image == 0) { return 0; }                    # ServiceDef requires `image`
            var env = _ans_inline_table(_bld_val_cstr(bayan_toml_get(pairs, "env")));
            if (env == 0 - 1) { return 0; }                  # non-string env value (serde: HashMap<String,String>)
            var svc = service_def_new(image, _bld_str_vec(pairs, "command"), env,
              _bld_str_vec(pairs, "ports"), _bld_str_vec(pairs, "volumes"),
              _bld_str_vec(pairs, "depends_on"));
            var ss: ServiceDef = svc;
            var rep = bayan_toml_get(pairs, "replicas");
            if (rep != 0) { ss.replicas = atoi(str_cstr(rep)); }
            var rp = _bld_val_cstr(bayan_toml_get(pairs, "restart"));
            if (rp != 0) {
                # Rust accepts only the UNIT variants as a bare string; the
                # struct variant "on-failure" (needs a map) and any unknown value
                # are rejected by toml::from_str → error.
                var rpk = restart_policy_from_name(rp);
                if (rpk == 0 - 1) { return 0; }
                if (rpk == HEALTH_RESTART_ON_FAILURE) { return 0; }
                ss.restart = rpk;
            }
            map_set(services, svc_name, svc);
        }
        i = i + 1;
    }

    # Pass 2: [services.NAME.health_check] → attach to the service.
    i = 0;
    while (i < nsec) {
        var sec2 = vec_get(sections, i);
        var hc_svc = _ans_healthcheck_service(bayan_toml_section_name(sec2));
        if (hc_svc != 0) {
            var svc2 = map_get(services, hc_svc);
            # A health_check subtable implicitly defines its parent service; if no
            # [services.X] with an image exists, Rust errors on the missing image.
            if (svc2 == 0) { return 0; }
            var hp = bayan_toml_section_pairs(sec2);
            # HealthCheck.command has no serde default → it is required.
            if (bayan_toml_get(hp, "command") == 0) { return 0; }
            var hc = health_check_new(_bld_str_vec(hp, "command"));
            var hh: HealthCheck = hc;
            var iv = bayan_toml_get(hp, "interval_secs");
            if (iv != 0) { hh.interval_secs = atoi(str_cstr(iv)); }
            var tv = bayan_toml_get(hp, "timeout_secs");
            if (tv != 0) { hh.timeout_secs = atoi(str_cstr(tv)); }
            var rv = bayan_toml_get(hp, "retries");
            if (rv != 0) { hh.retries = atoi(str_cstr(rv)); }
            var svs: ServiceDef = svc2;
            svs.health_check = hc;
        }
        i = i + 1;
    }

    # serde: the `services` field is required — no services means an error.
    if (map_size(services) == 0) { return 0; }

    # networks: [networks.NAME] (serde default = empty). Enumerated from the raw
    # headers so an empty/minimal section is not lost.
    var networks = map_new();
    var net_names = map_keys(_ans_header_names(toml_str, "networks."));
    i = 0;
    while (i < vec_len(net_names)) {
        var nname = vec_get(net_names, i);
        var np = _ans_section_pairs(sections, _ans_cat("networks.", nname));
        var nd = network_def_default();
        var ndd: NetworkDef = nd;
        if (np != 0) {
            ndd.driver = _bld_val_cstr(bayan_toml_get(np, "driver"));
            ndd.subnet = _bld_val_cstr(bayan_toml_get(np, "subnet"));
        }
        map_set(networks, nname, nd);
        i = i + 1;
    }

    # volumes: [volumes.NAME] (serde default = empty). Same header enumeration —
    # a bare `[volumes.pgdata]` (no fields) is a valid VolumeDef::default.
    var volumes = map_new();
    var vol_names = map_keys(_ans_header_names(toml_str, "volumes."));
    i = 0;
    while (i < vec_len(vol_names)) {
        var vname = vec_get(vol_names, i);
        var vp = _ans_section_pairs(sections, _ans_cat("volumes.", vname));
        var vd = volume_def_default();
        if (vp != 0) { store64(vd, _bld_val_cstr(bayan_toml_get(vp, "driver"))); }  # single-field
        map_set(volumes, vname, vd);
        i = i + 1;
    }

    return ansamblu_file_new(services, networks, volumes);
}

# ── DEFERRED (JSON codec) ────────────────
#   serde JSON round-trip tests: ansamblu_file_serde_round_trip,
#   ansamblu_session_serde, network_def_serde, volume_def_serde,
#   restart_policy_serde — need a JSON serializer for these records; they land
#   with the JSON codec.
#
# RestartPolicy itself (`pub use crate::health::RestartPolicy`) is defined in
# the sibling src/health.cyr and referenced here, not re-ported.

# --- agent.cyr ---

# stiva — daimon agent integration (register containers as agents)
# Ported from rust-old/src/agent.rs.
#
# rust-old talks to daimon's agent registry over HTTP (reqwest, async),
# avoiding a direct dependency on agent-runtime — same pattern sutra-daimon
# uses. The self-contained, testable surface ports here:
#   - DEFAULT_REGISTRY_URL constant
#   - struct AgentRegistration + struct AgentStatus
#   - build_registration(container) — pure, mirrors the Rust builder
# The three network functions (register/deregister/report_status) require an
# async reqwest client + HTTP/TLS which the ported base lacks; they live in
# the DEFERRED block at the bottom (legitimate HTTP/async deferral, matching
# the registry-module precedent).

# Default daimon registry URL (rust-old: DEFAULT_REGISTRY_URL).
#[must_use]
fn agent_default_registry_url() {
    return "http://localhost:8090";
}

# Agent registration payload (rust-old: struct AgentRegistration).
# Fields are cstr / handle valued:
#   id            — cstr (container id)
#   name          — cstr (container name, or first-12 of id)
#   agent_type    — cstr ("container")
#   capabilities  — Vec handle of cstrs
#   metadata      — handle to a metadata record (see AgentMetadata below);
#                   rust-old carried a serde_json::Value, we carry the fields.
struct AgentRegistration {
    id;
    name;
    agent_type;
    capabilities;
    metadata;
}

# Metadata about the container placed in the registration payload
# (rust-old: the serde_json::json!({...}) object in build_registration).
struct AgentMetadata {
    image_ref;   # cstr
    image_id;    # cstr
    state;       # cstr (rust-old: format!("{:?}", container.state))
    ports;       # Vec handle of cstrs (container.config.ports) | 0
}

# Agent status report (rust-old: struct AgentStatus).
#   id       — cstr
#   status   — cstr
#   metadata — handle to AgentMetadata | 0 (rust-old: Option<serde_json::Value>)
struct AgentStatus {
    id;
    status;
    metadata;
}

# Construct an AgentStatus record.
#[must_use]
fn agent_status_new(id, status, metadata) {
    var p = alloc(24);
    var s: AgentStatus = p;
    s.id = id;
    s.status = status;
    s.metadata = metadata;
    return p;
}

# Build an agent registration from a container (rust-old: build_registration).
#
# Mirrors the Rust builder exactly:
#   id           = container.id
#   name         = container.name, or first 12 chars of id when name is absent
#   agent_type   = "container"
#   capabilities = ["container-runtime", "stiva"]
#   metadata     = { image_ref, image_id, state = "{:?}", ports }
#
# `container` is a Container* (see src/container.cyr). Returns an
# AgentRegistration*.
#[must_use]
fn build_registration(container) {
    # Container* field layout (src/container.cyr, 8-byte fields):
    #   id@0 name@8 image_id@16 image_ref@24 state@32 pid@40
    #   created_at@48 started_at@56 config@64 exit_code@72
    # We read via load64 rather than a `: Container` annotation so this file
    # parses standalone (Container is defined in the sibling module, not here).
    var c_id = load64(container + 0);
    var c_name = load64(container + 8);
    var c_image_id = load64(container + 16);
    var c_image_ref = load64(container + 24);
    var c_state = load64(container + 32);
    var c_config = load64(container + 64);

    # name: container.name, falling back to &container.id[..12].
    var name = c_name;
    if (name == 0) {
        name = _agent_first12(c_id);
    }

    # capabilities: ["container-runtime", "stiva"].
    var caps = vec_new();
    vec_push(caps, "container-runtime");
    vec_push(caps, "stiva");

    # metadata object. ContainerConfig.ports is field index 4 → offset 32.
    var c_ports = load64(c_config + 32);
    var mp = alloc(32);
    var meta: AgentMetadata = mp;
    meta.image_ref = c_image_ref;
    meta.image_id = c_image_id;
    meta.state = container_state_name(c_state);
    meta.ports = c_ports;

    var rp = alloc(40);
    var reg: AgentRegistration = rp;
    reg.id = c_id;
    reg.name = name;
    reg.agent_type = "container";
    reg.capabilities = caps;
    reg.metadata = mp;
    return rp;
}

# First 12 bytes of NUL-terminated `id` as a fresh NUL-terminated cstr
# (rust-old: container.id[..12].to_string()). If `id` is shorter than 12
# bytes the whole string is copied. Returns a heap cstr.
#[must_use]
fn _agent_first12(id) {
    var n = strlen(id);
    if (n > 12) { n = 12; }
    var buf = alloc(n + 1);
    memcpy(buf, id, n);
    store8(buf + n, 0);
    return buf;
}

# ── DEFERRED (HTTP/async — no reqwest/TLS/async runtime in ported base) ──
# rust-old/src/agent.rs also defines these network functions. Each builds a
# URL under `{registry_url}` and issues a request against daimon's agent
# registry using an async reqwest::Client, mapping transport failures to
# StivaError::Network (STIVA_ERR_NETWORK). Port them once an HTTP client
# lands (same status as registry.cyr's network paths):
#
#   async fn register_container(client, container, registry_url)
#       POST {registry_url}/v1/agents/register  body = build_registration(...)
#       non-2xx or transport error → Err(STIVA_ERR_NETWORK
#         "daimon registration failed: {e}" /
#         "daimon registration returned HTTP {status}")
#
#   async fn deregister_container(client, container_id, registry_url)
#       DELETE {registry_url}/v1/agents/{container_id}
#       non-2xx → warn (does NOT error); transport error → Err(NETWORK
#         "daimon deregistration failed: {e}")
#
#   async fn report_status(client, container_id, status, registry_url)
#       PUT {registry_url}/v1/agents/{container_id}/status
#         body = AgentStatus { id: container_id, status, metadata: none }
#       non-2xx → warn (does NOT error); transport error → Err(NETWORK
#         "daimon status report failed: {e}")

# --- fleet.cyr ---

# stiva — daimon edge fleet scheduling: container placement + migration.
# Ported from rust-old/src/fleet.rs.
#
# Distributes containers across a fleet of nodes managed by daimon. Three
# scheduling strategies (Spread / BinPack / Pinned), a migration-target
# selector, fleet-health heartbeat sweep, and a rollback planner.
#
# i64-everywhere representation:
#   * Every public struct (FleetDeployment, DeploymentConstraints, FleetNode,
#     FleetNodeCapacity, ScheduleResult) is a heap pointer to an 8-byte-per-field
#     record; constructors alloc and return the pointer. `alloc_init()` must
#     have run once before use.
#   * String fields (`id`, `image`, `address`, `node_id`) are NUL-terminated
#     cstr pointers. `Vec<String>` (preferred_nodes, reasons) is a vec handle.
#     `HashMap<String,String>` (node_labels, node.labels) is a cstr-keyed
#     hashmap handle (map_new / KeyTypeCstr). `HashMap<String,u32>`
#     (assignments) is a cstr-keyed hashmap whose values are the counts.
#   * `Option<u64>` / `Option<u32>` constraint fields use the sentinel -1 for
#     None (min_memory_mb, min_cpus), since real capacities are non-negative.
#   * `chrono::DateTime<Utc>` (created_at, last_seen) is an epoch-ns i64.
#
# Error mapping (mirrors error.cyr): every Rust `Err(StivaError::Fleet(...))`
# maps to the integer sentinel `0 - 1` returned from a scheduling / selection
# fn; the caller reports the context via stiva_err_print(STIVA_ERR_FLEET,
# detail). `schedule` returns a ScheduleResult pointer on success, or 0 on
# failure. `select_migration_target` returns the chosen node-id cstr on
# success, or 0 on failure.

# ── DeploymentStrategy (rust-old: enum DeploymentStrategy) ────────
# Prefixed FLEET_STRATEGY_* for global enum-member uniqueness (see error.cyr).
# The `Pinned { node_id }` payload is carried separately on the deployment
# (see FleetDeployment.pinned_node), since Cyrius enum members are bare ints.
enum DeploymentStrategy {
    FLEET_STRATEGY_SPREAD = 0;
    FLEET_STRATEGY_BINPACK = 1;
    FLEET_STRATEGY_PINNED = 2;
}

# serde tag/name for a strategy — matches Rust's derived enum names.
#[must_use]
fn fleet_strategy_name(s) {
    if (s == FLEET_STRATEGY_SPREAD) { return "Spread"; }
    if (s == FLEET_STRATEGY_BINPACK) { return "BinPack"; }
    if (s == FLEET_STRATEGY_PINNED) { return "Pinned"; }
    return "unknown";
}

# The Rust `Default` for DeploymentStrategy is Spread.
#[must_use]
fn fleet_strategy_default() {
    return FLEET_STRATEGY_SPREAD;
}

# ── NodeStatus (rust-old: enum NodeStatus) ─────────────────
# Prefixed FLEET_NODE_* for global enum-member uniqueness.
enum NodeStatus {
    FLEET_NODE_READY = 0;
    FLEET_NODE_NOT_READY = 1;
    FLEET_NODE_DRAINING = 2;
    FLEET_NODE_CORDONED = 3;
}

# serde name for a node status — matches Rust's derived enum names.
#[must_use]
fn fleet_node_status_name(s) {
    if (s == FLEET_NODE_READY) { return "Ready"; }
    if (s == FLEET_NODE_NOT_READY) { return "NotReady"; }
    if (s == FLEET_NODE_DRAINING) { return "Draining"; }
    if (s == FLEET_NODE_CORDONED) { return "Cordoned"; }
    return "unknown";
}

# ── FleetNodeCapacity (rust-old: struct NodeCapacity) ───────────────
# Renamed from the oracle's bare `NodeCapacity`: samay (pulled transitively via
# kavach ≥ 3.8.0) defines its own `NodeCapacity` — 9 fields / 72 B / 5-arg ctor
# vs this 4 / 32 B / 4-arg one — and cycc is SILENT on duplicate structs, so the
# clash surfaces as a bogus parse error in whichever file compiles last. Same
# `stiva_*`-prefix idiom as stiva_audit_log_new / stiva_port_mapping_new.
# 4 fields × 8 bytes = 32.
struct FleetNodeCapacity {
    memory_mb;            # u64
    cpus;                 # u32
    max_containers;       # u32
    running_containers;   # u32
    accel_profiles;       # vec<ai-hwaccel profile*> | 0 = none known (§I)
}

#[must_use]
fn fleet_node_capacity_new(memory_mb, cpus, max_containers, running_containers) {
    var p = alloc(40);
    var c: FleetNodeCapacity = p;
    c.memory_mb = memory_mb;
    c.cpus = cpus;
    c.max_containers = max_containers;
    c.running_containers = running_containers;
    c.accel_profiles = 0;
    return p;
}

# Attach a node's accelerator profiles (roadmap §I). A vec of ai-hwaccel
# `profile_*` pointers, or 0 for "none known" — which is NOT the same as "no
# accelerators": an undetected node must not silently satisfy a GPU
# requirement, so `_fleet_accel_ok` treats 0 as unsatisfiable for any non-NONE
# request.
#
# GRAFTED onto stiva's own struct rather than adopting samay's `NodeCapacity`,
# which is a superset only on the continuous dimensions: it has no
# `max_containers` (stiva's entire fit test), no node status, no label
# constraints, and only best-fit-by-utilization against stiva's three
# strategies. Adopting it would regress three shipped features. Its ledger also
# leaks — `node_capacity_release` is reached only from `cancel_task`, so a task
# reaching COMPLETED/FAILED never releases its reservation.
fn fleet_node_capacity_set_accel(cap, profiles) {
    var c: FleetNodeCapacity = cap;
    c.accel_profiles = profiles;
    return 0;
}

#[must_use]
fn fleet_node_capacity_accel(cap) {
    var c: FleetNodeCapacity = cap;
    return c.accel_profiles;
}

# ── FleetNode (rust-old: struct FleetNode) ─────────────────
# id : cstr, address : cstr, labels : hashmap<str,str> handle (0 = empty),
# capacity : FleetNodeCapacity pointer, status : NodeStatus int,
# last_seen : epoch-ns i64. 6 fields × 8 bytes = 48.
struct FleetNode {
    id;
    address;
    labels;
    capacity;
    status;
    last_seen;
}

#[must_use]
fn fleet_node_new(id, address, labels, capacity, status, last_seen) {
    var p = alloc(48);
    var n: FleetNode = p;
    n.id = id;
    n.address = address;
    n.labels = labels;
    n.capacity = capacity;
    n.status = status;
    n.last_seen = last_seen;
    return p;
}

# ── DeploymentConstraints (rust-old: struct DeploymentConstraints) ──
# node_labels : hashmap<str,str> handle (0 = empty),
# min_memory_mb : u64 | -1 for None, min_cpus : u32 | -1 for None,
# preferred_nodes : vec<cstr> handle (0 = empty). 4 fields × 8 bytes = 32.
struct DeploymentConstraints {
    node_labels;
    min_memory_mb;
    min_cpus;
    preferred_nodes;
    accel_req;            # ai-hwaccel REQ_* (§I); REQ_NONE = CPU is enough
    accel_min_chips;
}

# Rust `Default` for DeploymentConstraints: empty labels, no min_memory/min_cpus
# (encoded -1), empty preferred_nodes. Empty maps/vecs are the 0 sentinel.
#[must_use]
fn deployment_constraints_default() {
    var p = alloc(48);
    var c: DeploymentConstraints = p;
    c.node_labels = 0;
    c.min_memory_mb = 0 - 1;
    c.min_cpus = 0 - 1;
    c.preferred_nodes = 0;
    c.accel_req = REQ_NONE;
    c.accel_min_chips = 0;
    return p;
}

# ── FleetDeployment (rust-old: struct FleetDeployment) ───────────
# id : cstr, image : cstr, config : ContainerConfig pointer,
# constraints : DeploymentConstraints pointer, replicas : u32,
# strategy : DeploymentStrategy int, pinned_node : cstr | 0 (the Pinned
# payload; non-null only when strategy == FLEET_STRATEGY_PINNED),
# created_at : epoch-ns i64. 8 fields × 8 bytes = 64.
struct FleetDeployment {
    id;
    image;
    config;
    constraints;
    replicas;
    strategy;
    pinned_node;
    created_at;
}

#[must_use]
fn fleet_deployment_new(id, image, config, constraints, replicas, strategy, pinned_node, created_at) {
    var p = alloc(64);
    var d: FleetDeployment = p;
    d.id = id;
    d.image = image;
    d.config = config;
    d.constraints = constraints;
    d.replicas = replicas;
    d.strategy = strategy;
    d.pinned_node = pinned_node;
    d.created_at = created_at;
    return p;
}

# ── ScheduleResult (rust-old: struct ScheduleResult) ─────────────
# assignments : hashmap<str,u32> handle (node_id -> replica count),
# reasons : vec<cstr> handle. 2 fields × 8 bytes = 16.
struct ScheduleResult {
    assignments;
    reasons;
}

#[must_use]
fn schedule_result_new(assignments, reasons) {
    var p = alloc(16);
    var r: ScheduleResult = p;
    r.assignments = assignments;
    r.reasons = reasons;
    return p;
}

# ── constraint matching ───────────────────────

# True (1) iff `node` satisfies every constraint in `constraints`
# (rust-old: node_matches_constraints). All label keys must be present on
# the node with an equal value; capacity must meet min_memory_mb / min_cpus
# when those are set (non -1). An empty (0) label map matches anything.
#[must_use]
#[inline]
fn node_matches_constraints(node, constraints) {
    var n: FleetNode = node;
    var c: DeploymentConstraints = constraints;

    # Label constraints — every required key must match.
    if (c.node_labels != 0) {
        var keys = map_keys(c.node_labels);
        var nk = vec_len(keys);
        var i = 0;
        while (i < nk) {
            var key = vec_get(keys, i);
            var want = map_get(c.node_labels, key);
            # Node must have the key AND its value must equal `want`.
            if (n.labels == 0) { return 0; }
            if (map_has(n.labels, key) == 0) { return 0; }
            var got = map_get(n.labels, key);
            if (streq(got, want) == 0) { return 0; }
            i = i + 1;
        }
    }

    var cap: FleetNodeCapacity = n.capacity;

    # Memory constraint (Some(min) → node.memory_mb >= min).
    if (c.min_memory_mb != 0 - 1) {
        if (cap.memory_mb < c.min_memory_mb) { return 0; }
    }

    # Accelerator constraint (§I). `find_satisfying_profile` + `requirement_
    # satisfied` were written for exactly this — ai-hwaccel's header calls it
    # "used for scheduling integration".
    #
    # A node with NO known profiles fails any non-NONE request. Treating unknown
    # as satisfying would place a GPU workload on a node nobody has inventoried,
    # which is the failure the constraint exists to prevent.
    # RAW OFFSETS. Typed access to the two fields ADDED here segfaults — the
    # cycc struct-id 20/21 miscompile, per-function-context, so `cap.memory_mb`
    # a few lines below is fine and `cap.accel_profiles` is fatal. Verified by
    # bisection: the two tests reaching this branch crashed, the one that only
    # read the defaults passed.
    #   FleetNodeCapacity:     memory_mb@0 cpus@8 max_containers@16
    #                          running_containers@24 accel_profiles@32
    #   DeploymentConstraints: node_labels@0 min_memory_mb@8 min_cpus@16
    #                          preferred_nodes@24 accel_req@32 accel_min_chips@40
    var req = load64(constraints + 32);
    if (req != REQ_NONE) {
        var prof = load64(n.capacity + 32);
        if (prof == 0) { return 0; }
        if (find_satisfying_profile(req, load64(constraints + 40), prof) == 0) { return 0; }
    }

    # CPU constraint.
    if (c.min_cpus != 0 - 1) {
        if (cap.cpus < c.min_cpus) { return 0; }
    }

    return 1;
}

# Remaining container slots on a node (rust-old: free_slots) —
# max_containers saturating_sub running_containers (never negative).
#[must_use]
#[inline]
fn free_slots(node) {
    var n: FleetNode = node;
    var cap: FleetNodeCapacity = n.capacity;
    if (cap.max_containers < cap.running_containers) { return 0; }
    return cap.max_containers - cap.running_containers;
}

# ── candidate filtering ───────────────────────

# Build a vec of node pointers that are Ready, match constraints, and have
# 1 when `node` is named in the constraints' `preferred_nodes`.
#
# DIVERGENCE: the oracle declares the field and never reads it
# (rust-old/src/fleet.rs:43), so a caller expressing a placement preference got
# silence. It is honoured as a PREFERENCE, not a filter: a preferred node that is
# full or fails the hard constraints must not block the deployment, it just loses
# its priority. Treating it as a filter would turn a hint into an outage.
#[must_use]
fn _fleet_is_preferred(node, constraints) {
    var c: DeploymentConstraints = constraints;
    if (c.preferred_nodes == 0) { return 0; }
    var n: FleetNode = node;
    var i = 0;
    while (i < vec_len(c.preferred_nodes)) {
        if (streq(vec_get(c.preferred_nodes, i), n.id) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 when a node in `status` may receive NEW work.
#
# DIVERGENCE: the oracle tests `== Ready` at every filter site
# (rust-old/src/fleet.rs), so `Draining` and `Cordoned` are defined and then
# behave EXACTLY like `Ready` nowhere and like `NotReady` nowhere — they have no
# effect at all, which makes cordoning a node a silent no-op. Both now mean "no
# new work", which is what the names say and what an operator cordoning a node
# before maintenance expects.
#
# They are deliberately NOT the same as NotReady: a draining node is still
# healthy and still running its containers, so `check_fleet_health` must not
# sweep it and a rollback must not migrate off it.
#[must_use]
fn _fleet_node_schedulable(status) {
    if (status == FLEET_NODE_READY) { return 1; }
    return 0;
}

# free slots — the shared candidate set for schedule / select_migration_target.
#[must_use]
fn _fleet_candidates(nodes, count, constraints) {
    # Two tiers, concatenated: preferred nodes first, everything else after. Every
    # strategy consumes this list in order, so the preference is honoured without
    # any of them having to know about it — and without it ever excluding a node.
    var pref = vec_new();
    var rest = vec_new();
    var i = 0;
    while (i < count) {
        var node = vec_get(nodes, i);
        var n: FleetNode = node;
        if (_fleet_node_schedulable(n.status) == 1) {
            if (node_matches_constraints(node, constraints) == 1) {
                if (free_slots(node) > 0) {
                    if (_fleet_is_preferred(node, constraints) == 1) { vec_push(pref, node); }
                    else { vec_push(rest, node); }
                }
            }
        }
        i = i + 1;
    }
    var out = vec_new();
    var p = 0;
    while (p < vec_len(pref)) { vec_push(out, vec_get(pref, p)); p = p + 1; }
    var r = 0;
    while (r < vec_len(rest)) { vec_push(out, vec_get(rest, r)); r = r + 1; }
    return out;
}

# ── format helpers for the `reasons` strings ────────────────

# Build "spread: assigned 1 replica to node {id}".
#[must_use]
fn _fleet_reason_spread(node_id) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "spread: assigned 1 replica to node ");
    str_builder_add_cstr(sb, node_id);
    return str_cstr(str_builder_build(sb));
}

# Build "binpack: assigned {n} replicas to node {id}".
#[must_use]
fn _fleet_reason_binpack(assign, node_id) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "binpack: assigned ");
    str_builder_add_int(sb, assign);
    str_builder_add_cstr(sb, " replicas to node ");
    str_builder_add_cstr(sb, node_id);
    return str_cstr(str_builder_build(sb));
}

# Build "pinned: assigned {n} replicas to node {id}".
#[must_use]
fn _fleet_reason_pinned(remaining, node_id) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "pinned: assigned ");
    str_builder_add_int(sb, remaining);
    str_builder_add_cstr(sb, " replicas to node ");
    str_builder_add_cstr(sb, node_id);
    return str_cstr(str_builder_build(sb));
}

# ── schedule ───────────────────────────

# Sort a vec of FleetNode pointers ascending by running_containers
# (Spread: most headroom first). In-place insertion sort — candidate lists
# are small (fleet size). Matches Rust's `sort_by_key(running_containers)`.
fn _fleet_sort_by_running_asc(cands) {
    var n = vec_len(cands);
    var i = 1;
    while (i < n) {
        var cur = vec_get(cands, i);
        var curn: FleetNode = cur;
        var curcap: FleetNodeCapacity = curn.capacity;
        var key = curcap.running_containers;
        var j = i - 1;
        var done = 0;
        while (j >= 0 && done == 0) {
            var pv = vec_get(cands, j);
            var pvn: FleetNode = pv;
            var pvcap: FleetNodeCapacity = pvn.capacity;
            if (pvcap.running_containers > key) {
                vec_set(cands, j + 1, pv);
                j = j - 1;
            } else {
                done = 1;
            }
        }
        vec_set(cands, j + 1, cur);
        i = i + 1;
    }
    return 0;
}

# Sort a vec of FleetNode pointers descending by running_containers
# (BinPack: most packed first). Matches Rust's `sort_by(b.cmp(a))`.
fn _fleet_sort_by_running_desc(cands) {
    var n = vec_len(cands);
    var i = 1;
    while (i < n) {
        var cur = vec_get(cands, i);
        var curn: FleetNode = cur;
        var curcap: FleetNodeCapacity = curn.capacity;
        var key = curcap.running_containers;
        var j = i - 1;
        var done = 0;
        while (j >= 0 && done == 0) {
            var pv = vec_get(cands, j);
            var pvn: FleetNode = pv;
            var pvcap: FleetNodeCapacity = pvn.capacity;
            if (pvcap.running_containers < key) {
                vec_set(cands, j + 1, pv);
                j = j - 1;
            } else {
                done = 1;
            }
        }
        vec_set(cands, j + 1, cur);
        i = i + 1;
    }
    return 0;
}

# Schedule a deployment across fleet nodes (rust-old: schedule).
#
# `nodes` is a vec of FleetNode pointers; `count` is its length. Selects
# nodes by constraints, capacity, and strategy. Returns a ScheduleResult
# pointer on success. On failure returns 0 and reports via
# stiva_err_print(STIVA_ERR_FLEET, detail); the specific Fleet(...) message
# strings are preserved as the reported detail.
#[must_use]
fn schedule(deployment, nodes, count) {
    var d: FleetDeployment = deployment;

    var cands = _fleet_candidates(nodes, count, d.constraints);
    if (vec_len(cands) == 0) {
        stiva_err_print(STIVA_ERR_FLEET, "no ready nodes matching constraints");
        return 0;
    }

    # cstr-keyed map (map_new → KeyTypeCstr / hash_str+streq). map_new_str is
    # for Str fat-pointer keys and would mis-hash our NUL-terminated node ids.
    var assignments = map_new();
    var reasons = vec_new();
    var remaining = d.replicas;

    # Branch-local variables use per-strategy suffixes (_sp / _bp / _pn)
    # because Cyrius `var`s are function-scoped, not block-scoped: a bare
    # `node` / `n` / `slots` / `sb` reused across the if/elif/else arms would
    # be a duplicate-variable error.
    if (d.strategy == FLEET_STRATEGY_SPREAD) {
        # Most headroom first, then round-robin.
        _fleet_sort_by_running_asc(cands);
        var ncand_sp = vec_len(cands);
        var idx_sp = 0;
        var limit_sp = ncand_sp * (d.replicas + 1);
        while (remaining > 0) {
            var node_sp = vec_get(cands, idx_sp % ncand_sp);
            var n_sp: FleetNode = node_sp;
            var current_sp = map_get_or(assignments, n_sp.id, 0);
            var fs_sp = free_slots(node_sp);
            var slots_sp = 0;
            if (fs_sp > current_sp) { slots_sp = fs_sp - current_sp; }
            if (slots_sp > 0) {
                map_set(assignments, n_sp.id, current_sp + 1);
                remaining = remaining - 1;
                vec_push(reasons, _fleet_reason_spread(n_sp.id));
            }
            idx_sp = idx_sp + 1;
            # Safety: prevent infinite loop if total capacity is insufficient.
            if (idx_sp >= limit_sp) {
                var sb_sp = str_builder_new();
                str_builder_add_cstr(sb_sp, "insufficient capacity: need ");
                str_builder_add_int(sb_sp, remaining);
                str_builder_add_cstr(sb_sp, " more replicas but no slots available");
                stiva_err_print(STIVA_ERR_FLEET, str_cstr(str_builder_build(sb_sp)));
                return 0;
            }
        }
    } elif (d.strategy == FLEET_STRATEGY_BINPACK) {
        # Most-packed first, fill each greedily.
        _fleet_sort_by_running_desc(cands);
        var ncand_bp = vec_len(cands);
        var i_bp = 0;
        while (i_bp < ncand_bp) {
            if (remaining == 0) { i_bp = ncand_bp; } else {
                var node_bp = vec_get(cands, i_bp);
                var n_bp: FleetNode = node_bp;
                var slots_bp = free_slots(node_bp);
                var assign_bp = remaining;
                if (slots_bp < assign_bp) { assign_bp = slots_bp; }
                if (assign_bp > 0) {
                    map_set(assignments, n_bp.id, assign_bp);
                    vec_push(reasons, _fleet_reason_binpack(assign_bp, n_bp.id));
                    remaining = remaining - assign_bp;
                }
                i_bp = i_bp + 1;
            }
        }
        if (remaining > 0) {
            var sb_bp = str_builder_new();
            str_builder_add_cstr(sb_bp, "insufficient capacity: need ");
            str_builder_add_int(sb_bp, remaining);
            str_builder_add_cstr(sb_bp, " more replicas");
            stiva_err_print(STIVA_ERR_FLEET, str_cstr(str_builder_build(sb_bp)));
            return 0;
        }
    } else {
        # Pinned — find the pinned node among candidates.
        var pinned_pn = d.pinned_node;
        var ncand_pn = vec_len(cands);
        var found_pn = 0;
        var i_pn = 0;
        while (i_pn < ncand_pn) {
            var node_pn = vec_get(cands, i_pn);
            var n_pn: FleetNode = node_pn;
            if (streq(n_pn.id, pinned_pn) == 1) { found_pn = node_pn; i_pn = ncand_pn; } else { i_pn = i_pn + 1; }
        }
        if (found_pn == 0) {
            var sb_pn = str_builder_new();
            str_builder_add_cstr(sb_pn, "pinned node '");
            str_builder_add_cstr(sb_pn, pinned_pn);
            str_builder_add_cstr(sb_pn, "' not found or not ready");
            stiva_err_print(STIVA_ERR_FLEET, str_cstr(str_builder_build(sb_pn)));
            return 0;
        }
        var slots_pn = free_slots(found_pn);
        if (slots_pn < remaining) {
            var sb2_pn = str_builder_new();
            str_builder_add_cstr(sb2_pn, "pinned node '");
            str_builder_add_cstr(sb2_pn, pinned_pn);
            str_builder_add_cstr(sb2_pn, "' has only ");
            str_builder_add_int(sb2_pn, slots_pn);
            str_builder_add_cstr(sb2_pn, " slots, need ");
            str_builder_add_int(sb2_pn, remaining);
            stiva_err_print(STIVA_ERR_FLEET, str_cstr(str_builder_build(sb2_pn)));
            return 0;
        }
        map_set(assignments, pinned_pn, remaining);
        vec_push(reasons, _fleet_reason_pinned(remaining, pinned_pn));
    }

    return schedule_result_new(assignments, reasons);
}

# ── migration target selection ─────────────────────

# Select the best node for a single container migration (rust-old:
# select_migration_target). Picks the Ready node with the most free capacity
# that matches constraints. Returns the chosen node-id cstr on success, or 0
# on failure (reported as STIVA_ERR_FLEET). `nodes` is a vec of FleetNode
# pointers; `count` its length.
#[must_use]
fn select_migration_target(nodes, count, constraints) {
    var best = 0;
    var best_slots = 0 - 1;
    var best_pref = 0;
    var i = 0;
    while (i < count) {
        var node = vec_get(nodes, i);
        var n: FleetNode = node;
        if (_fleet_node_schedulable(n.status) == 1) {
            if (node_matches_constraints(node, constraints) == 1) {
                var fs = free_slots(node);
                var isp = _fleet_is_preferred(node, constraints);
                # A preferred node outranks ANY non-preferred one; within a tier,
                # max_by_key semantics — ties resolve to the last max, as Rust's
                # iterator does, hence `>=`.
                if (isp > best_pref) { best_pref = isp; best_slots = 0 - 1; }
                if (fs > 0 && isp == best_pref) {
                    if (fs >= best_slots) {
                        best = node;
                        best_slots = fs;
                    }
                }
            }
        }
        i = i + 1;
    }

    if (best == 0) {
        stiva_err_print(STIVA_ERR_FLEET, "no suitable migration target node found");
        return 0;
    }
    # Copy into a fresh local before the struct annotation: annotating the
    # loop-mutated `best` directly mis-computes the field offset in codegen.
    var bp = best + 0;
    var b: FleetNode = bp;
    return b.id;
}

# ── fleet health monitoring ──────────────────────

# Check fleet node health based on heartbeat timestamps (rust-old:
# check_fleet_health). Nodes that haven't been seen within `timeout_ns`
# (a duration in nanoseconds; the Rust `chrono::Duration`) are marked
# NotReady. Mutates the FleetNode records in place. Returns a vec of the
# node-id cstrs whose status changed. `now_ns` is the current epoch-ns
# (caller supplies it so the sweep is testable, matching chrono::Utc::now()).
#[must_use]
fn check_fleet_health(nodes, count, now_ns, timeout_ns) {
    var cutoff = now_ns - timeout_ns;
    var changed = vec_new();
    var i = 0;
    while (i < count) {
        var node = vec_get(nodes, i);
        var n: FleetNode = node;
        if (n.status == FLEET_NODE_READY) {
            if (n.last_seen < cutoff) {
                n.status = FLEET_NODE_NOT_READY;
                vec_push(changed, n.id);
            }
        }
        i = i + 1;
    }
    return changed;
}

# Plan a rollback: reschedule containers from failed nodes to healthy ones
# (rust-old: plan_rollback). Returns a vec of 2-element [source_id, target_id]
# pair pointers (each pair a 16-byte heap record) for container migration.
# For each NotReady node with running containers, finds a healthy target per
# running container (skipping a target equal to the failed node itself).
#[must_use]
fn plan_rollback(nodes, count, constraints) {
    var migrations = vec_new();
    var i = 0;
    while (i < count) {
        var node = vec_get(nodes, i);
        var fn0: FleetNode = node;
        var cap: FleetNodeCapacity = fn0.capacity;
        if (fn0.status == FLEET_NODE_NOT_READY) {
            if (cap.running_containers > 0) {
                var k = 0;
                while (k < cap.running_containers) {
                    var target = _fleet_select_and_reserve(nodes, count, constraints, fn0.id);
                    if (target != 0) {
                        var pair = alloc(16);
                        store64(pair, fn0.id);
                        store64(pair + 8, target);
                        vec_push(migrations, pair);
                    }
                    k = k + 1;
                }
            }
        }
        i = i + 1;
    }
    return migrations;
}

# Pick a migration target and RESERVE a slot on it, so the next call in the same
# plan sees the reduced capacity.
#
# DIVERGENCE from the oracle (rust-old/src/fleet.rs:336-345), which calls
# `select_migration_target` once per running container with no reservation
# between calls — so `select_migration_target` returns the node with the most
# free slots every time and **all N containers on a failed node plan onto the
# same target**, regardless of whether it can hold them. A rollback plan that
# cannot be executed is worse than none.
#
# `skip_id` excludes the failing node itself. The reservation mutates
# `running_containers` on the candidate, which is what `free_slots` reads; the
# node vec is the caller's planning copy, so this is a projection, not a
# commitment against live state.
# RAW OFFSETS, not typed struct locals — deliberate, per the cycc struct-id
# 20/21 workaround this tree carries elsewhere. A `var n: FleetNode = node;`
# here SEGFAULTS: the bug is per-function-context, so the identical access is
# fine in `select_migration_target` two functions up and fatal in this one.
# Verified by bisection — the two tests that reach this function crashed, the
# two that do not passed.
#   FleetNode:         id@0 address@8 labels@16 capacity@24 status@32 last_seen@40
#   FleetNodeCapacity: memory_mb@0 cpus@8 max_containers@16 running_containers@24
fn _fleet_select_and_reserve(nodes, count, constraints, skip_id) {
    var best = 0;
    var best_slots = 0 - 1;
    var i = 0;
    while (i < count) {
        var node = vec_get(nodes, i);
        if (_fleet_node_schedulable(load64(node + 32)) == 1) {
            if (streq(load64(node), skip_id) == 0) {
                if (node_matches_constraints(node, constraints) == 1) {
                    var fs = free_slots(node);
                    if (fs > 0) {
                        if (fs >= best_slots) { best_slots = fs; best = node; }
                    }
                }
            }
        }
        i = i + 1;
    }
    if (best == 0) { return 0; }
    var bcap = load64(best + 24);
    store64(bcap + 24, load64(bcap + 24) + 1);
    return load64(best);
}

# ── DEFERRED (already-ported; no deferral needed) ───────────────
# FleetDeployment.config is a container::ContainerConfig pointer. container
# is already ported (src/container.cyr: struct ContainerConfig +
# container_config_default). Callers build the config via
# container_config_default() and pass the pointer to fleet_deployment_new —
# fleet defines no config type of its own.

# --- mcp.cyr ---

# stiva — MCP (Model Context Protocol) tools
# Ported from rust-old/src/mcp.rs.
#
# Exposes container runtime operations as MCP tools that AI agents discover
# and invoke via daimon. This module carries the self-contained surface:
#   - McpResult / ContentPart data types + ok/resource/err constructors
#   - tool_list() — the 9 static ToolDef definitions (built via lib/bote-core)
#
# The live async dispatch layer (handle_tool + the per-tool handle_* fns,
# list_resources, read_resource) is coupled to the live async `Stiva`
# instance (rust-old/src/lib.rs: stiva.pull/run/ps/stop/exec/push/inspect…),
# an async runtime, and serde_json Value construction. Those handlers landed in
# §E and live in stiva_core.cyr, which is downstream of this file and can reach
# the facade; this module keeps the schema, McpResult, and the facade-free
# handler.
#
# Enum members are namespaced (MCP_CONTENT_*) — Cyrius hoists enum members
# to global constants under "last definition wins", so bare names would
# silently collide across modules (see error.cyr).
#
# Parity notes vs Rust:
#   - McpResult::ok/resource take a `serde_json::Value`; here they take a
#     pre-serialized JSON cstr (the audit.cyr precedent). The Rust
#     serde_json::to_string_pretty is the caller's responsibility — the
#     content `text` is stored verbatim.
#   - ContentPart is `#[serde(tag = "type")]`: the wire "type" value is
#     "text" for Text and "resource" for Resource (mcp_content_type_name).
#   - Resource mime_type is always "application/json".

# ── ContentPart ──────────────────────────
# Typed content part in an MCP tool result (rust-old: enum ContentPart,
# #[serde(tag = "type")], #[non_exhaustive]). Two shapes:
#   MCP_CONTENT_TEXT     — { text }
#   MCP_CONTENT_RESOURCE — { uri, mime_type, text }
enum ContentPartKind {
    MCP_CONTENT_TEXT = 0;
    MCP_CONTENT_RESOURCE = 1;
}

# Serde `type` tag wire name for a ContentPart kind (the `#[serde(rename)]`
# values on the variants).
#[must_use]
fn mcp_content_type_name(kind) {
    if (kind == MCP_CONTENT_TEXT) { return "text"; }
    if (kind == MCP_CONTENT_RESOURCE) { return "resource"; }
    return "text";
}

# ContentPart layout (32 bytes):
#   +0  kind      MCP_CONTENT_* tag
#   +8  text      cstr (the text payload, present for both kinds)
#   +16 uri       cstr or 0 (Resource only)
#   +24 mime_type cstr or 0 (Resource only; "application/json")

# Construct a Text content part (rust-old: ContentPart::Text { text }).
fn content_part_text(text) {
    var p = alloc(32);
    store64(p, MCP_CONTENT_TEXT);
    store64(p + 8, text);
    store64(p + 16, 0);
    store64(p + 24, 0);
    return p;
}

# Construct a Resource content part
# (rust-old: ContentPart::Resource { uri, mime_type, text }).
fn content_part_resource(uri, mime_type, text) {
    var p = alloc(32);
    store64(p, MCP_CONTENT_RESOURCE);
    store64(p + 8, text);
    store64(p + 16, uri);
    store64(p + 24, mime_type);
    return p;
}

fn content_part_kind(p) { return load64(p); }
fn content_part_text_of(p) { return load64(p + 8); }
fn content_part_uri(p) { return load64(p + 16); }
fn content_part_mime_type(p) { return load64(p + 24); }

# ── McpResult ───────────────────────────
# Result of an MCP tool invocation in structured MCP content format
# (rust-old: struct McpResult { success, content }).
#
# Layout (16 bytes):
#   +0  success   1 (ok) / 0 (err)
#   +8  content   vec of ContentPart pointers
struct McpResult {
    success;
    content;
}

fn mcp_result_success(r) { return load64(r); }
fn mcp_result_content(r) { return load64(r + 8); }

# Create a success result with text content
# (rust-old: McpResult::ok). `data_json` is a pre-serialized JSON cstr
# (the caller does serde_json::to_string_pretty).
#[must_use]
fn mcp_result_ok(data_json) {
    var r = alloc(16);
    store64(r, 1);
    var content = vec_new();
    vec_push(content, content_part_text(data_json));
    store64(r + 8, content);
    return r;
}

# Create a success result with a JSON resource (rust-old: McpResult::resource).
# mime_type is always "application/json". `data_json` is a pre-serialized
# JSON cstr.
#[must_use]
fn mcp_result_resource(uri, data_json) {
    var r = alloc(16);
    store64(r, 1);
    var content = vec_new();
    vec_push(content, content_part_resource(uri, "application/json", data_json));
    store64(r + 8, content);
    return r;
}

# Create an error result (rust-old: McpResult::err). `message` is stored as
# the text content verbatim.
#[must_use]
fn mcp_result_err(message) {
    var r = alloc(16);
    store64(r, 0);
    var content = vec_new();
    vec_push(content, content_part_text(message));
    store64(r + 8, content);
    return r;
}

# ── tool_list ───────────────────────────
# Return the list of MCP tools provided by stiva (rust-old: tool_list()).
# Nine ToolDefs, each built via lib/bote-core (tool_def_new + schema_new +
# schema_prop_new + annotations). Property values are raw JSON literals
# preserved verbatim from the Rust serde_json::json!(...) schema fragments.
#
# Returns a vec of ToolDef pointers.
#[must_use]
fn tool_list() {
    var tools = vec_new();

    # stiva_pull — read-only
    var pull_props = vec_new();
    vec_push(pull_props, schema_prop_new("image",
        "{\"type\": \"string\", \"description\": \"Image reference (e.g., 'nginx:latest', 'ghcr.io/org/repo:tag')\"}"));
    var pull_req = vec_new();
    vec_push(pull_req, "image");
    var pull = tool_def_new("stiva_pull",
      "Pull an OCI container image from a registry",
      schema_new("object", pull_props, pull_req));
    tool_def_with_annotations(pull, ann_read_only());
    vec_push(tools, pull);

    # stiva_run — destructive
    var run_props = vec_new();
    vec_push(run_props, schema_prop_new("image",
        "{\"type\": \"string\", \"description\": \"Image reference to run\"}"));
    vec_push(run_props, schema_prop_new("name",
        "{\"type\": \"string\", \"description\": \"Container name (optional)\"}"));
    vec_push(run_props, schema_prop_new("command",
        "{\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"Command to execute (overrides entrypoint)\"}"));  #skip-lint
    vec_push(run_props, schema_prop_new("env",
        "{\"type\": \"object\", \"additionalProperties\": {\"type\": \"string\"}, \"description\": \"Environment variables\"}"));  #skip-lint
    vec_push(run_props, schema_prop_new("ports",
        "{\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"Port mappings (e.g., '8080:80')\"}"));  #skip-lint
    vec_push(run_props, schema_prop_new("volumes",
        "{\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"Volume mounts (e.g., '/host:/container:ro')\"}"));  #skip-lint
    var run_req = vec_new();
    vec_push(run_req, "image");
    var run = tool_def_new("stiva_run",
      "Run a container from an image",
      schema_new("object", run_props, run_req));
    tool_def_with_annotations(run, ann_destructive());
    vec_push(tools, run);

    # stiva_ps — read-only, no params
    var ps = tool_def_new("stiva_ps",
      "List all containers",
      schema_new("object", vec_new(), vec_new()));
    tool_def_with_annotations(ps, ann_read_only());
    vec_push(tools, ps);

    # stiva_stop — destructive
    var stop_props = vec_new();
    vec_push(stop_props, schema_prop_new("id",
        "{\"type\": \"string\", \"description\": \"Container ID to stop\"}"));
    var stop_req = vec_new();
    vec_push(stop_req, "id");
    var stop = tool_def_new("stiva_stop",
      "Stop a running container",
      schema_new("object", stop_props, stop_req));
    tool_def_with_annotations(stop, ann_destructive());
    vec_push(tools, stop);

    # stiva_ansamblu — destructive
    var ans_props = vec_new();
    vec_push(ans_props, schema_prop_new("action",
        "{\"type\": \"string\", \"enum\": [\"up\", \"down\"], \"description\": \"Ansamblu action to perform\"}"));
    vec_push(ans_props, schema_prop_new("file",
        "{\"type\": \"string\", \"description\": \"TOML ansamblu file content\"}"));
    vec_push(ans_props, schema_prop_new("session_id",
        "{\"type\": \"string\", \"description\": \"Session ID (required for 'down')\"}"));
    var ans_req = vec_new();
    vec_push(ans_req, "action");
    var ans = tool_def_new("stiva_ansamblu",
      "Manage multi-service deployments via ansamblu files",
      schema_new("object", ans_props, ans_req));
    tool_def_with_annotations(ans, ann_destructive());
    vec_push(tools, ans);

    # stiva_exec — destructive
    var exec_props = vec_new();
    vec_push(exec_props, schema_prop_new("id",
        "{\"type\": \"string\", \"description\": \"Container ID\"}"));
    vec_push(exec_props, schema_prop_new("command",
        "{\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"Command and arguments to execute\"}"));  #skip-lint
    var exec_req = vec_new();
    vec_push(exec_req, "id");
    vec_push(exec_req, "command");
    var exec = tool_def_new("stiva_exec",
      "Execute a command inside a running container",
      schema_new("object", exec_props, exec_req));
    tool_def_with_annotations(exec, ann_destructive());
    vec_push(tools, exec);

    # stiva_build — destructive
    var build_props = vec_new();
    vec_push(build_props, schema_prop_new("spec",
        "{\"type\": \"string\", \"description\": \"TOML build spec content\"}"));
    vec_push(build_props, schema_prop_new("context_dir",
        "{\"type\": \"string\", \"description\": \"Build context directory path\"}"));
    var build_req = vec_new();
    vec_push(build_req, "spec");
    vec_push(build_req, "context_dir");
    var build = tool_def_new("stiva_build",
      "Build an image from a Stivafile specification",
      schema_new("object", build_props, build_req));
    tool_def_with_annotations(build, ann_destructive());
    vec_push(tools, build);

    # stiva_push — destructive
    var push_props = vec_new();
    vec_push(push_props, schema_prop_new("image",
        "{\"type\": \"string\", \"description\": \"Image ID or reference to push\"}"));
    vec_push(push_props, schema_prop_new("target",
        "{\"type\": \"string\", \"description\": \"Target registry reference (optional)\"}"));
    var push_req = vec_new();
    vec_push(push_req, "image");
    var push = tool_def_new("stiva_push",
      "Push a local image to a registry",
      schema_new("object", push_props, push_req));
    tool_def_with_annotations(push, ann_destructive());
    vec_push(tools, push);

    # stiva_inspect — read-only
    var insp_props = vec_new();
    vec_push(insp_props, schema_prop_new("id",
        "{\"type\": \"string\", \"description\": \"Container or image ID\"}"));
    vec_push(insp_props, schema_prop_new("type",
        "{\"type\": \"string\", \"enum\": [\"container\", \"image\"], \"description\": \"What to inspect\"}"));
    var insp_req = vec_new();
    vec_push(insp_req, "id");
    vec_push(insp_req, "type");
    var insp = tool_def_new("stiva_inspect",
      "Inspect a container or image",
      schema_new("object", insp_props, insp_req));
    tool_def_with_annotations(insp, ann_read_only());
    vec_push(tools, insp);

    return tools;
}

# ── Synchronous tool handlers (rust-old: handle_build / handle_ansamblu) ──────
# These two rust handlers are marked `async` but have fully SYNCHRONOUS bodies —
# they only drive the ported parse_build_spec / parse_ansamblu and assemble a
# structured McpResult (no `.await`). `params` is a bayan JSON object value; the
# response JSON is serialized pretty (the caller's job here, per McpResult::ok).

# Read a string param → fresh cstr, or 0 if absent/non-string
# (rust: params.get(key).and_then(|v| v.as_str())).
fn _mcp_param_str(params, key) {
    var v = json_v_obj_get(params, key);
    if (json_v_is_str(v) == 0) { return 0; }
    return str_cstr(json_v_str(v));
}

# NOTE: `mcp_handle_build` is NOT defined here. It was, while it only parsed the
# spec — but a real build needs the ImageStore and the RegistryClient, which
# live on the `Stiva` facade, and include order puts this file UPSTREAM of
# stiva_core.cyr. It therefore moved to stiva_core.cyr as
# `mcp_handle_build(s, params)`, the same migration pull/push/ps/stop/inspect
# got, and for the same reason. The schema for the tool stays here.

# stiva_ansamblu tool (rust-old: handle_ansamblu): "up" parses the ansamblu file
# and reports the service count; "down" queues a teardown; other actions → error.
fn mcp_handle_ansamblu(params) {
    var action = _mcp_param_str(params, "action");
    if (action == 0) { return mcp_result_err("missing required parameter: action"); }
    if (streq(action, "up") == 1) {
        var file = _mcp_param_str(params, "file");
        if (file == 0) { file = ""; }
        var af = parse_ansamblu(file);
        if (af == 0) { return mcp_result_err("ansamblu parse failed"); }
        var aa: AnsambluFile = af;
        var o = json_v_obj_new();
        json_v_obj_set(o, str_from("action"), json_v_str_new(str_from("ansamblu_up")));
        json_v_obj_set(o, str_from("services"), json_v_int_new(map_size(aa.services)));
        json_v_obj_set(o, str_from("status"), json_v_str_new(str_from("parsed")));
        return mcp_result_ok(str_cstr(json_v_build_pretty(o, 2)));
    }
    if (streq(action, "down") == 1) {
        var sid = _mcp_param_str(params, "session_id");
        if (sid == 0) { sid = "unknown"; }
        var o = json_v_obj_new();
        json_v_obj_set(o, str_from("action"), json_v_str_new(str_from("ansamblu_down")));
        json_v_obj_set(o, str_from("session_id"), json_v_str_new(str_from(sid)));
        json_v_obj_set(o, str_from("status"), json_v_str_new(str_from("queued")));
        return mcp_result_ok(str_cstr(json_v_build_pretty(o, 2)));
    }
    return mcp_result_err(_img_cat2("unknown ansamblu action: ", action));
}

# ── DEFERRED (land with the Stiva async runtime driver) ───────────
# rust-old/src/mcp.rs also defines the live tool-dispatch + resource layer,
# coupled to the async `Stiva` instance (rust-old/src/lib.rs), an async
# runtime, and serde_json::Value construction the ported base lacks. The two
# fully-synchronous handlers (handle_build / handle_ansamblu) are ported above;
# the rest drive the async Stiva facade:
#
#   async fn handle_tool(stiva: &Arc<Stiva>, name, params) -> McpResult
#     — dispatch by tool name to the handle_* fns; the two sync ones route to
#       mcp_handle_build / mcp_handle_ansamblu, the rest stay async.
#   async fn handle_pull(stiva, params) -> McpResult      (stiva.pull)
#   async fn handle_run(stiva, params) -> McpResult       (stiva.run; builds
#       container::ContainerConfig with name/command/ports/volumes, detach=true)
#   async fn handle_ps(stiva) -> McpResult                (stiva.ps)
#   async fn handle_stop(stiva, params) -> McpResult      (stiva.stop)
#   async fn handle_exec(stiva, params) -> McpResult      (stiva.exec)
#   async fn handle_push(stiva, params) -> McpResult      (stiva.push)
#   async fn handle_inspect(stiva, params) -> McpResult   (stiva.inspect /
#       stiva.inspect_image; type ∈ {"container","image"})
#   async fn list_resources(stiva: &Arc<Stiva>) -> Vec<serde_json::Value>
#       — container + image resources (stiva.ps + stiva.images)
#   async fn read_resource(stiva: &Arc<Stiva>, uri) -> Result<Value, String>
#       — strip_prefix "stiva://containers/" | "stiva://images/" then inspect.
#
# These reference the async Stiva runtime methods, serde_json Value
# assembly, and the params Value accessor pattern (params.get(k).as_str());
# they are ported alongside the Stiva runtime driver for parity. Tracked in
# the roadmap.

# --- stiva_core.cyr ---

# stiva — crate-root surface (StivaConfig + the Stiva runtime facade)
# Ported from rust-old/src/lib.rs.
#
# rust-old/src/lib.rs is the crate root: it re-exports the domain modules
# (that aggregation lives in src/lib.cyr) AND defines `StivaConfig` (ported
# below) + the top-level `Stiva` runtime facade. `Stiva` and its ~40
# orchestration methods drive not-yet-ported async surfaces
# (ContainerManager, RegistryClient, AuditLog::new, ImageStore async pull/
# push) — captured in the DEFERRED block at the bottom, matching the
# container/registry precedent.

# ── StivaConfig (rust-old: struct StivaConfig) ────────────────
# Configuration for the stiva runtime. Fields:
#   root_path       — cstr, default "/var/lib/agnos/containers"
#   image_path      — cstr, default "/var/lib/agnos/images"
#   default_network — NetworkModeVal pointer (network_mod.cyr), default Bridge
#   max_containers  — i64 (Rust usize), default 64
#   audit_log       — cstr path or 0 for None (Rust Option<PathBuf>), default 0
# 5 fields × 8 = 40 bytes.
struct StivaConfig {
    root_path;
    image_path;
    default_network;
    max_containers;
    audit_log;
}

# Heap constructor — explicit field values.
#[must_use]
fn stiva_config_new(root_path, image_path, default_network, max_containers, audit_log) {
    var p = alloc(40);
    var c: StivaConfig = p;
    c.root_path = root_path;
    c.image_path = image_path;
    c.default_network = default_network;
    c.max_containers = max_containers;
    c.audit_log = audit_log;
    return p;
}

# Default StivaConfig (rust-old: impl Default for StivaConfig).
# root "/var/lib/agnos/containers", image "/var/lib/agnos/images",
# NetworkMode::Bridge, max_containers 64, audit_log None (0).
#[must_use]
fn stiva_config_default() {
    var net = network_mode_new(NETWORK_MODE_BRIDGE, 0);
    return stiva_config_new(
      "/var/lib/agnos/containers",
      "/var/lib/agnos/images",
      net,
      64,
      0
      );
}

# ══ Stiva runtime facade (rust-old/src/lib.rs) ═══════════════════
# The top-level entry point: wires the ImageStore, ContainerManager, audit
# log, and config, and delegates the lifecycle verbs to the manager while
# emitting audit around the mutating ones (stop/rm/signal/pull — the set the
# oracle audits — PLUS push, which is net-new: the oracle never constructs
# AuditOperation::Push at all, so a push left no trace. run/ps/etc. are not
# audited, matching the oracle). Single-node, synchronous:
# the oracle's Arc/async collapses to plain pointers.
#
# pull/push/discovery are LIVE as of §B Inc-10 (v3.0.10); `build` is still
# stubbed. Facade `run` still resolves the image from the LOCAL store rather
# than pulling it — a documented divergence from the oracle's `run` =
# pull-then-create-then-start, kept deliberately so `run` never reaches the
# network implicitly. Pull first, then run.

struct Stiva {
    image_store;      # ImageStore*
    registry_client;  # RegistryClient* (§B Inc-10: always constructed)
    containers;       # ContainerManager*
    audit;            # AuditLog* | 0 (stiva_audit_log_new when config.audit_log set)
    config;           # StivaConfig*
}

# Create a stiva runtime from a config (rust-old: Stiva::new, lib.rs:125).
# Stands up the image store over config.image_path, the container manager over
# config.root_path, and (when config.audit_log is set) the audit log. Returns
# a Stiva*, or 0 on failure.
fn stiva_new(config) {
    var cfg: StivaConfig = config;
    sakshi_info("initializing stiva runtime", strlen("initializing stiva runtime"));
    sys_mkdir(cfg.root_path, 493);
    var image_store = image_store_new(cfg.image_path);
    if (image_store == 0) { stiva_err_print(STIVA_ERR_IO, cfg.image_path); return 0; }
    var containers = container_manager_new(cfg.root_path, image_store);
    if (containers == 0) { return 0; }
    var audit = 0;
    if (cfg.audit_log != 0) { audit = stiva_audit_log_new(cfg.audit_log); }

    var s = alloc(40);
    var ss: Stiva = s;
    ss.image_store = image_store;
    ss.registry_client = registry_client_new();
    ss.containers = containers;
    ss.audit = audit;
    ss.config = config;
    return s;
}

# As stiva_new, but builds the registry client from an explicit registry config
# (rust-old: with_registry, lib.rs:154) — credentials and mirrors.
fn stiva_with_registry(config, registry_config) {
    var s = stiva_new(config);
    if (s == 0) { return 0; }
    if (registry_config != 0) {
        var ss: Stiva = s;
        ss.registry_client = registry_client_with_config(registry_config);
    }
    return s;
}

# The registry client (rust-old: registry_client field).
#[must_use]
fn stiva_registry_client(s) {
    var ss: Stiva = s;
    return ss.registry_client;
}

# The facade's ImageStore — the sibling of stiva_registry_client above. Exposed
# so a caller that already holds a `Stiva` (the CLI, the MCP handlers, tests)
# does not have to construct a second store over the same root.
#[must_use]
fn stiva_image_store(s) {
    var ss: Stiva = s;
    return ss.image_store;
}

# The audit log handle, or 0 (rust-old: audit()).
#[must_use]
fn stiva_audit(s) {
    var ss: Stiva = s;
    return ss.audit;
}

# The lifecycle event bus (rust-old: event_bus()). Forwards to the manager's.
#[must_use]
fn stiva_event_bus(s) {
    var ss: Stiva = s;
    return container_manager_event_bus(ss.containers);
}

# Write an audit entry, warning (not failing) on write error and no-op when no
# audit log is configured (rust-old: emit_audit, lib.rs:766).
fn _stiva_emit_audit(s, entry) {
    var ss: Stiva = s;
    if (ss.audit == 0) { return 0; }
    if (audit_log_log(ss.audit, entry) != STIVA_ERR_OK) {
        sakshi_warn("failed to write audit entry", strlen("failed to write audit entry"));
    }
    return 0;
}

# AUDIT_RESULT_SUCCESS / _FAILED from a STIVA_ERR_* code (0 == OK).
#[must_use]
fn _stiva_audit_result(code) {
    if (code == STIVA_ERR_OK) { return AUDIT_RESULT_SUCCESS; }
    return AUDIT_RESULT_FAILED;
}

# Resolve an image ref (full "registry/repo:tag" OR id) in a loaded index.
# Image fields are read via the raw-offset accessors — Image is in the cycc
# struct-id 20/21 class (a struct-field read segfaults in some units).
#[must_use]
fn _stiva_find_image(images, ref) {
    if (images == 0) { return 0; }
    var n = vec_len(images);
    var i = 0;
    while (i < n) {
        var im = vec_get(images, i);
        if (streq(image_ref_full_ref(_image_reference(im)), ref) == 1) { return im; }
        if (streq(_img_id(im), ref) == 1) { return im; }
        i = i + 1;
    }
    return 0;
}

# Create and start a container from a local image (rust-old: run, lib.rs:198).
# DIVERGENCE: the oracle pulls from a registry first; the blocking client is §B,
# so this resolves the image from the local store instead. Returns the
# post-start Container* (Stopped for one-shot), or 0 (detail printed).
fn stiva_run(s, image_ref, config) {
    var ss: Stiva = s;
    var img = _stiva_find_image(image_store_load_index(ss.image_store), image_ref);
    if (img == 0) {
        stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, image_ref);
        return 0;
    }
    var rec = container_manager_create(ss.containers, img, config);
    if (rec == 0) { return 0; }
    var rc: Container = rec;
    if (container_manager_start(ss.containers, rc.id) != STIVA_ERR_OK) { return 0; }
    return rec;
}

# List containers (rust-old: ps, lib.rs). Not audited.
#[must_use]
fn stiva_ps(s) {
    var ss: Stiva = s;
    return container_manager_list(ss.containers);
}

# Inspect one container by id-or-name (rust-old: inspect). Not audited.
#[must_use]
fn stiva_inspect(s, id) {
    var ss: Stiva = s;
    return container_manager_get(ss.containers, id);
}

# Stop a container + audit (rust-old: stop, lib.rs:221).
fn stiva_stop(s, id) {
    var ss: Stiva = s;
    var r = container_manager_stop(ss.containers, id);
    _stiva_emit_audit(s, audit_entry_container(AUDIT_OP_STOP, id, _stiva_audit_result(r), 0));
    return r;
}

# Remove a container + audit (rust-old: rm, lib.rs:236).
fn stiva_rm(s, id) {
    var ss: Stiva = s;
    var r = container_manager_remove(ss.containers, id);
    _stiva_emit_audit(s, audit_entry_container(AUDIT_OP_REMOVE, id, _stiva_audit_result(r), 0));
    return r;
}

# Signal a container + audit (with the signal number as metadata; rust-old:
# signal, lib.rs:255 → AuditOperation::Kill).
fn stiva_signal(s, id, signal) {
    var ss: Stiva = s;
    var r = container_manager_signal(ss.containers, id, signal);
    var e = audit_entry_container(AUDIT_OP_KILL, id, _stiva_audit_result(r), 0);
    var md = json_v_obj_new();
    json_v_obj_set(md, str_from("signal"), json_v_int_new(signal));
    audit_entry_with_metadata(e, str_cstr(json_v_build(md)));
    _stiva_emit_audit(s, e);
    return r;
}

# Diff a container's filesystem against its image (roadmap v3.0.17 item 1).
# Returns a vec of diff entries, or 0. Not audited — a read-only inspection, the
# same treatment ps/inspect/stats get.
#[must_use]
fn stiva_diff(s, id) {
    var ss: Stiva = s;
    return container_manager_diff(ss.containers, id);
}

# Exec a command inside a running container (rust-old: Stiva::exec, lib.rs).
# Returns a ContainerExecResult*, or 0 with the detail printed.
#
# Audited, like the oracle: AUDIT_OP_EXEC exists precisely for this, and running
# an arbitrary command inside a container is the operation the trail most needs.
# The command itself goes in the metadata — an exec entry that records only "an
# exec happened" is not an audit trail.
fn stiva_exec(s, id, command, env, workdir) {
    var ss: Stiva = s;
    var res = container_manager_exec(ss.containers, id, command, env, workdir);
    var result = AUDIT_RESULT_FAILED;
    if (res != 0) { result = AUDIT_RESULT_SUCCESS; }
    var e = audit_entry_container(AUDIT_OP_EXEC, id, result, 0);
    var md = json_v_obj_new();
    var arr = json_v_arr_new();
    if (command != 0) {
        var i = 0;
        while (i < vec_len(command)) {
            json_v_arr_push(arr, json_v_str_new(str_from(vec_get(command, i))));
            i = i + 1;
        }
    }
    json_v_obj_set(md, str_from("command"), arr);
    # Deliberately NOT the env: `stiva exec -e AWS_SECRET_ACCESS_KEY=…` would
    # write the secret into an append-only audit log that outlives the container.
    # The key NAMES are the useful part and carry no secret.
    var keys = json_v_arr_new();
    if (env != 0) {
        var j = 0;
        while (j < vec_len(env)) {
            var kv = vec_get(env, j);
            var eq = _img_find(kv, 61);          # '='
            if (eq > 0) { json_v_arr_push(keys, json_v_str_new(str_from(_img_slice(kv, 0, eq)))); }
            j = j + 1;
        }
    }
    json_v_obj_set(md, str_from("env_keys"), keys);
    audit_entry_with_metadata(e, str_cstr(json_v_build(md)));
    _stiva_emit_audit(s, e);
    return res;
}

# The remaining lifecycle verbs are pure delegation (not audited by the
# oracle): restart/pause/unpause/rename/update, and the read ops
# stats/wait/logs/log_tail/get_rootfs.
fn stiva_restart(s, id) { var ss: Stiva = s; return container_manager_restart(ss.containers, id); }
fn stiva_pause(s, id) { var ss: Stiva = s; return container_manager_pause(ss.containers, id); }
fn stiva_unpause(s, id) { var ss: Stiva = s; return container_manager_unpause(ss.containers, id); }
fn stiva_rename(s, id, new_name) { var ss: Stiva = s; return container_manager_rename(ss.containers, id, new_name); }
fn stiva_update(s, id, mem, cpu, pids) {
    var ss: Stiva = s;
    return container_manager_update(ss.containers, id, mem, cpu, pids);
}

#[must_use]
fn stiva_stats(s, id) { var ss: Stiva = s; return container_manager_stats(ss.containers, id); }
#[must_use]
fn stiva_wait(s, id) { var ss: Stiva = s; return container_manager_try_wait(ss.containers, id); }
#[must_use]
fn stiva_logs(s, id) { var ss: Stiva = s; return container_manager_logs(ss.containers, id); }
#[must_use]
fn stiva_log_tail(s, id, n) { var ss: Stiva = s; return container_manager_log_tail(ss.containers, id, n); }
#[must_use]
fn stiva_get_rootfs(s, id) { var ss: Stiva = s; return container_manager_get_rootfs(ss.containers, id); }

# Remove all stopped containers, then GC dangling image blobs (rust-old:
# prune, lib.rs:407). Returns the number of containers removed (the image GC
# runs for its side effect). Collect ids first — removal mutates the vec.
fn stiva_prune(s) {
    var ss: Stiva = s;
    var ids = vec_new();
    var list = container_manager_list(ss.containers);
    var i = 0;
    while (i < vec_len(list)) {
        var rc: Container = vec_get(list, i);
        if (rc.state == CONTAINER_STATE_STOPPED) { vec_push(ids, rc.id); }
        i = i + 1;
    }
    var removed = 0;
    var j = 0;
    while (j < vec_len(ids)) {
        if (container_manager_remove(ss.containers, vec_get(ids, j)) == STIVA_ERR_OK) {
            removed = removed + 1;
        }
        j = j + 1;
    }
    image_store_gc(ss.image_store);
    return removed;
}

# ══ Build (§F) ══════════════════════

# Build an image from Stivafile TOML CONTENT (rust-old: Stiva::build,
# lib.rs:294 — which also takes the content, not a path; reading the file is the
# caller's job). Returns the Image*, or 0 with the detail already printed.
#
# Audited either way. NET-NEW, like push's audit: see AUDIT_OP_BUILD.
fn stiva_build(s, toml_content, context_dir) {
    var ss: Stiva = s;
    if (toml_content == 0) { return 0; }
    var spec = parse_build_spec(toml_content);
    if (spec == 0) {
        stiva_err_print(STIVA_ERR_INVALID_STATE, "invalid build spec");
        _stiva_emit_audit(s, audit_entry_image(AUDIT_OP_BUILD, "", AUDIT_RESULT_FAILED, 0));
        return 0;
    }
    var sp: BuildSpec = spec;
    var idef: ImageDef = sp.image;
    var target = _img_cat3(_img_cat2("local/", idef.name), ":", idef.tag);

    var im = build_image(spec, ss.image_store, ss.registry_client, context_dir);
    var res = AUDIT_RESULT_FAILED;
    if (im != 0) { res = AUDIT_RESULT_SUCCESS; }
    _stiva_emit_audit(s, audit_entry_image(AUDIT_OP_BUILD, target, res, 0));
    return im;
}

# ══ Registry verbs (§B Inc-10) ══════════════════════════

# Pull an image by reference (rust-old: Stiva::pull, lib.rs:180). Returns the
# Image*, or 0. Audited either way, like the oracle.
fn stiva_pull(s, reference) {
    var ss: Stiva = s;
    if (reference == 0) { return 0; }
    var parsed = image_ref_parse(reference);
    if (parsed == 0) {
        stiva_err_print(STIVA_ERR_INVALID_REFERENCE, reference);
        return 0;
    }
    var im = image_store_pull(ss.registry_client, ss.image_store, parsed);
    var res = AUDIT_RESULT_FAILED;
    if (im != 0) { res = AUDIT_RESULT_SUCCESS; }
    _stiva_emit_audit(s, audit_entry_image(AUDIT_OP_PULL, reference, res, 0));
    return im;
}

# Push a local image to a registry (rust-old: Stiva::push, lib.rs:314).
# `target` may be 0, meaning "push to the image's own reference".
# Returns 1 on success, 0 on failure.
#
# Audited either way. NET-NEW, not parity: the oracle's push emits no audit
# entry and never constructs AuditOperation::Push, so a push was invisible to
# the audit trail. Publishing an image is exactly the operation you want a
# record of.
fn stiva_push(s, image_id, target) {
    var ss: Stiva = s;
    if (image_id == 0) { return 0; }

    # No target => push to the image's OWN reference, read from the store
    # (rust-old lib.rs:322: `None => image.reference.clone()`).
    #
    # NOT to image_id-parsed-as-a-reference: image_id is routinely a config
    # digest, and image_ref_parse("sha256:c0ffee…") yields
    # docker.io/library/sha256:c0ffee… — which would push a local, possibly
    # private, image to Docker Hub under a nonsense repository name.
    var parsed = 0;
    var tref = target;
    if (target == 0) {
        var found = image_store_find(ss.image_store, image_id);
        if (found == 0) {
            stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, image_id);
            _stiva_emit_audit(s, audit_entry_image(AUDIT_OP_PUSH, image_id, AUDIT_RESULT_FAILED, 0));
            return 0;
        }
        parsed = _image_reference(found);
        tref = image_ref_full_ref(parsed);
    } else {
        parsed = image_ref_parse(target);
        if (parsed == 0) {
            stiva_err_print(STIVA_ERR_INVALID_REFERENCE, target);
            _stiva_emit_audit(s, audit_entry_image(AUDIT_OP_PUSH, target, AUDIT_RESULT_FAILED, 0));
            return 0;
        }
    }
    var r = image_store_push(ss.registry_client, ss.image_store, image_id, parsed);
    var res = AUDIT_RESULT_FAILED;
    if (r == 1) { res = AUDIT_RESULT_SUCCESS; }
    _stiva_emit_audit(s, audit_entry_image(AUDIT_OP_PUSH, tref, res, 0));
    return r;
}

# Tags for a repository reference (rust-old: RegistryClient::list_tags).
# Returns a vec of cstr, or 0 on failure. Read-only — not audited.
fn stiva_list_tags(s, reference) {
    var ss: Stiva = s;
    if (reference == 0) { return 0; }
    var parsed = image_ref_parse(reference);
    if (parsed == 0) {
        stiva_err_print(STIVA_ERR_INVALID_REFERENCE, reference);
        return 0;
    }
    return registry_list_tags(ss.registry_client, parsed);
}

# Repositories in a registry (rust-old: RegistryClient::catalog).
fn stiva_catalog(s, registry) {
    var ss: Stiva = s;
    return registry_catalog(ss.registry_client, registry);
}

# 1 signed · 0 unsigned · -1 the query failed. See registry_verify_signature
# for why "unsigned" and "could not ask" are kept distinct.
fn stiva_verify_signature(s, reference) {
    var ss: Stiva = s;
    if (reference == 0) { return 0 - 1; }
    # Resolve the image FIRST, then take the registry target from what the store
    # holds — never from the lookup key. `reference` may be a config-digest ID,
    # and image_ref_parse("sha256:<64hex>") yields docker.io/library/sha256:…,
    # which would send this repository's manifest digest to Docker Hub and
    # authenticate there. Same defect as stiva_push's default target.
    var found = image_store_find(ss.image_store, reference);
    if (found == 0) {
        stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, reference);
        return 0 - 1;
    }
    # Referrers are keyed on the MANIFEST digest.
    #
    # DIVERGENCE: the oracle passes image.id — the CONFIG digest
    # (rust-old/src/image.rs:531) — which no cosign or notation `subject` ever
    # carries, so its signature lookup can only ever come back empty.
    var md = _img_manifest_digest(found);
    if (md == 0) {
        stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, reference);
        return 0 - 1;
    }
    return registry_verify_signature(ss.registry_client, _image_reference(found), md);
}

# Local images (rust-old: Stiva::images). Returns a vec of Image*.
#[must_use]
fn stiva_images(s) {
    var ss: Stiva = s;
    return image_store_list(ss.image_store);
}

# One local image by config-digest ID or full reference (rust-old:
# Stiva::inspect_image). Returns Image*, or 0.
#[must_use]
fn stiva_inspect_image(s, id) {
    var ss: Stiva = s;
    return image_store_find(ss.image_store, id);
}

# Security strength score for the current backend (rust-old: security_score).
#[must_use]
fn stiva_security_score(s) {
    return security_score();
}

# ══ MCP live dispatch (roadmap §E) ═══════════════════════
# Oracle: rust-old/src/mcp.rs:256-585 (handle_tool + the per-tool handlers +
# list_resources / read_resource).
#
# This lives in stiva_core.cyr rather than mcp.cyr purely because of include
# order: mcp.cyr is included FIRST, so it cannot reach the Stiva facade. mcp.cyr
# keeps the schema, McpResult, and the two facade-free handlers (build,
# ansamblu); everything that drives the runtime is here. Same split, and the
# same reason, as the §B pull driver living in imagelayout.cyr.

# A container as the JSON object the ps / inspect / resource paths all return.
# `full` adds created_at + the config block (oracle: inspect and read_resource
# carry it, ps does not).
fn _mcp_container_jv(c, full) {
    var cc: Container = c;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("id"), json_v_str_new(str_from(cc.id)));
    var nm = cc.name;
    if (nm == 0) { nm = cc.id; }
    json_v_obj_set(o, str_from("name"), json_v_str_new(str_from(nm)));
    json_v_obj_set(o, str_from("state"), json_v_str_new(str_from(container_state_name(cc.state))));
    if (full == 0) {
        json_v_obj_set(o, str_from("image"), json_v_str_new(str_from(cc.image_ref)));
        return o;
    }
    json_v_obj_set(o, str_from("created_at"), json_v_int_new(cc.created_at));
    var cfg: ContainerConfig = cc.config;
    var co = json_v_obj_new();
    json_v_obj_set(co, str_from("command"), _mcp_str_arr_jv(cfg.command));
    json_v_obj_set(co, str_from("env"), _mcp_map_jv(cfg.env));
    json_v_obj_set(co, str_from("ports"), _mcp_str_arr_jv(cfg.ports));
    json_v_obj_set(co, str_from("volumes"), _mcp_str_arr_jv(cfg.volumes));
    json_v_obj_set(co, str_from("detach"), json_v_bool_new(cfg.detach));
    json_v_obj_set(o, str_from("config"), co);
    return o;
}

# vec<cstr> → JSON array, ALWAYS an array (never omitted). _il_str_arr returns 0
# for an empty vec so the caller can skip the key — right for a manifest, wrong
# here: an MCP client reading `config.command` should find `[]`, not a missing
# field it has to special-case.
fn _mcp_str_arr_jv(v) {
    var arr = json_v_arr_new();
    if (v == 0) { return arr; }
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        json_v_arr_push(arr, json_v_str_new(str_from(vec_get(v, i))));
        i = i + 1;
    }
    return arr;
}

# map<cstr,cstr> → JSON object (empty object when absent, same reasoning).
fn _mcp_map_jv(m) {
    var o = json_v_obj_new();
    if (m == 0) { return o; }
    var keys = map_keys(m);
    if (keys == 0) { return o; }
    var n = vec_len(keys);
    var i = 0;
    while (i < n) {
        var k = vec_get(keys, i);
        var val = map_get(m, k);
        if (val != 0) { json_v_obj_set(o, str_from(k), json_v_str_new(str_from(val))); }
        i = i + 1;
    }
    return o;
}

fn _mcp_image_jv(im) {
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("id"), json_v_str_new(str_from(_img_id(im))));
    json_v_obj_set(o, str_from("reference"),
      json_v_str_new(str_from(image_ref_full_ref(_image_reference(im)))));
    var ii: Image = im;
    json_v_obj_set(o, str_from("size_bytes"), json_v_int_new(ii.size_bytes));
    var nl = 0;
    if (ii.layers != 0) { nl = vec_len(ii.layers); }
    json_v_obj_set(o, str_from("layers"), json_v_int_new(nl));
    json_v_obj_set(o, str_from("created_at"), json_v_int_new(ii.created_at));
    return o;
}

fn _mcp_uri(prefix, id) {
    return _img_cat2(prefix, id);
}

# stiva_build (oracle mcp.rs:handle_build). MOVED here from mcp.cyr, where it
# could only ever parse the spec — a real build needs the store and the registry
# client, and those live on the facade.
fn mcp_handle_build(s, params) {
    var spec = _mcp_param_str(params, "spec");
    if (spec == 0) { return mcp_result_err("missing required parameter: spec"); }
    var ctx = _mcp_param_str(params, "context_dir");
    if (ctx == 0) { ctx = "."; }
    var im = stiva_build(s, spec, ctx);
    if (im == 0) { return mcp_result_err("build failed"); }
    return mcp_result_resource(_mcp_uri("stiva://images/", _img_id(im)),
      str_cstr(json_v_build_pretty(_mcp_image_jv(im), 2)));
}

# stiva_exec (oracle mcp.rs). `command` is a JSON array of strings; `env` an
# optional array of "K=V"; `workdir` an optional string.
fn mcp_handle_exec(s, params) {
    var id = _mcp_param_str(params, "id");
    if (id == 0) { return mcp_result_err("missing required parameter: id"); }
    var cmd_v = json_v_obj_get(params, "command");
    if (cmd_v == 0) { return mcp_result_err("missing required parameter: command"); }
    if (json_v_is_arr(cmd_v) == 0) { return mcp_result_err("command must be an array of strings"); }
    var command = vec_new();
    var i = 0;
    while (i < json_v_arr_len(cmd_v)) {
        var el = json_v_arr_get(cmd_v, i);
        # REJECT a non-string element rather than skipping it. Skipping silently
        # SHIFTS every later argument left, so `["sh","-c",7,"echo hi"]` would
        # run `sh -c "echo hi"` — a different command than the client asked for,
        # with no indication anything was dropped.
        if (json_v_is_str(el) == 0) {
            return mcp_result_err("command must contain only strings");
        }
        vec_push(command, str_cstr(json_v_str(el)));
        i = i + 1;
    }
    if (vec_len(command) == 0) { return mcp_result_err("command must be a non-empty array of strings"); }

    var env = vec_new();
    var env_v = json_v_obj_get(params, "env");
    if (env_v != 0) {
        if (json_v_is_arr(env_v) == 1) {
            var j = 0;
            while (j < json_v_arr_len(env_v)) {
                var ev = json_v_arr_get(env_v, j);
                if (json_v_is_str(ev) == 0) {
                    return mcp_result_err("env must contain only \"KEY=VALUE\" strings");
                }
                var evs = str_cstr(json_v_str(ev));
                # Same rule as the CLI: execve rejects the whole envp for one
                # entry with no '=', so a bare NAME must not reach it.
                if (_img_find(evs, 61) <= 0) {
                    return mcp_result_err("env entries must be KEY=VALUE");
                }
                vec_push(env, evs);
                j = j + 1;
            }
        }
    }
    var workdir = _mcp_param_str(params, "workdir");

    var res = stiva_exec(s, id, command, env, workdir);
    if (res == 0) { return mcp_result_err(_img_cat2("exec failed: ", id)); }
    var rr: ContainerExecResult = res;
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("exit_code"), json_v_int_new(rr.exit_code));
    json_v_obj_set(o, str_from("stdout"), json_v_str_new(str_from(rr.stdout)));
    json_v_obj_set(o, str_from("stderr"), json_v_str_new(str_from(rr.stderr)));
    json_v_obj_set(o, str_from("duration_ms"), json_v_int_new(rr.duration_ms));
    return mcp_result_ok(str_cstr(json_v_build_pretty(o, 2)));
}

# stiva_pull (oracle mcp.rs:271).
fn mcp_handle_pull(s, params) {
    var image = _mcp_param_str(params, "image");
    if (image == 0) { return mcp_result_err("missing required parameter: image"); }
    var im = stiva_pull(s, image);
    if (im == 0) { return mcp_result_err(_img_cat2("pull failed: ", image)); }
    return mcp_result_resource(_mcp_uri("stiva://images/", _img_id(im)),
      str_cstr(json_v_build_pretty(_mcp_image_jv(im), 2)));
}

# stiva_ps (oracle mcp.rs:336).
fn mcp_handle_ps(s) {
    var list = json_v_arr_new();
    var cs = stiva_ps(s);
    if (cs != 0) {
        var n = vec_len(cs);
        var i = 0;
        while (i < n) {
            json_v_arr_push(list, _mcp_container_jv(vec_get(cs, i), 0));
            i = i + 1;
        }
    }
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("containers"), list);
    return mcp_result_ok(str_cstr(json_v_build_pretty(o, 2)));
}

# stiva_stop (oracle mcp.rs:356).
fn mcp_handle_stop(s, params) {
    var id = _mcp_param_str(params, "id");
    if (id == 0) { return mcp_result_err("missing required parameter: id"); }
    if (stiva_stop(s, id) != STIVA_ERR_OK) {
        return mcp_result_err(_img_cat2("stop failed: ", id));
    }
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("id"), json_v_str_new(str_from(id)));
    json_v_obj_set(o, str_from("status"), json_v_str_new(str_from("stopped")));
    return mcp_result_ok(str_cstr(json_v_build_pretty(o, 2)));
}

# stiva_push (oracle mcp.rs:417). `target` is optional — absent means "push to
# the image's own reference", which stiva_push resolves from the store.
fn mcp_handle_push(s, params) {
    var image = _mcp_param_str(params, "image");
    if (image == 0) { return mcp_result_err("missing required parameter: image"); }
    var target = _mcp_param_str(params, "target");
    if (stiva_push(s, image, target) != 1) {
        return mcp_result_err(_img_cat2("push failed: ", image));
    }
    var o = json_v_obj_new();
    json_v_obj_set(o, str_from("image"), json_v_str_new(str_from(image)));
    if (target != 0) {
        json_v_obj_set(o, str_from("target"), json_v_str_new(str_from(target)));
    }
    json_v_obj_set(o, str_from("status"), json_v_str_new(str_from("pushed")));
    return mcp_result_ok(str_cstr(json_v_build_pretty(o, 2)));
}

# stiva_inspect (oracle mcp.rs:434). `type` ∈ {"container","image"}, defaulting
# to "container".
fn mcp_handle_inspect(s, params) {
    var id = _mcp_param_str(params, "id");
    if (id == 0) { return mcp_result_err("missing required parameter: id"); }
    var kind = _mcp_param_str(params, "type");
    if (kind == 0) { kind = "container"; }
    if (streq(kind, "container") == 1) {
        var c = stiva_inspect(s, id);
        if (c == 0) { return mcp_result_err(_img_cat2("inspect failed: ", id)); }
        var cc: Container = c;
        return mcp_result_resource(_mcp_uri("stiva://containers/", cc.id),
          str_cstr(json_v_build_pretty(_mcp_container_jv(c, 1), 2)));
    }
    if (streq(kind, "image") == 1) {
        var im = stiva_inspect_image(s, id);
        if (im == 0) { return mcp_result_err(_img_cat2("inspect failed: ", id)); }
        return mcp_result_resource(_mcp_uri("stiva://images/", _img_id(im)),
          str_cstr(json_v_build_pretty(_mcp_image_jv(im), 2)));
    }
    return mcp_result_err(_img_cat2("unknown inspect type: ", kind));
}

# Container + image resources (oracle mcp.rs:521). Returns a vec of jv objects.
fn mcp_list_resources(s) {
    var out = vec_new();
    var cs = stiva_ps(s);
    if (cs != 0) {
        var n = vec_len(cs);
        var i = 0;
        while (i < n) {
            var cc: Container = vec_get(cs, i);
            var o = json_v_obj_new();
            json_v_obj_set(o, str_from("uri"),
              json_v_str_new(str_from(_mcp_uri("stiva://containers/", cc.id))));
            var nm = cc.name;
            if (nm == 0) { nm = cc.id; }
            json_v_obj_set(o, str_from("name"), json_v_str_new(str_from(nm)));
            json_v_obj_set(o, str_from("mimeType"), json_v_str_new(str_from("application/json")));
            json_v_obj_set(o, str_from("description"),
              json_v_str_new(str_from(_img_cat2(_img_cat2("Container ", cc.id),
                    _img_cat2(" (", _img_cat2(container_state_name(cc.state), ")"))))));
            vec_push(out, o);
            i = i + 1;
        }
    }
    var ims = stiva_images(s);
    if (ims != 0) {
        var m = vec_len(ims);
        var j = 0;
        while (j < m) {
            var im = vec_get(ims, j);
            var o2 = json_v_obj_new();
            json_v_obj_set(o2, str_from("uri"),
              json_v_str_new(str_from(_mcp_uri("stiva://images/", _img_id(im)))));
            json_v_obj_set(o2, str_from("name"),
              json_v_str_new(str_from(image_ref_full_ref(_image_reference(im)))));
            json_v_obj_set(o2, str_from("mimeType"), json_v_str_new(str_from("application/json")));
            var iid: Image = im;
            json_v_obj_set(o2, str_from("description"),
              json_v_str_new(str_from(_img_cat2(_img_cat2("Image ", _img_id(im)),
                    _img_cat2(" (", _img_cat2(_rt_int_to_cstr(iid.size_bytes), " bytes)"))))));
            vec_push(out, o2);
            j = j + 1;
        }
    }
    return out;
}

# Read one resource by URI (oracle mcp.rs:552). Returns the JSON cstr, or 0 with
# the reason on the error channel — an unknown scheme and a missing container
# are different failures and the caller has to be able to say which.
fn mcp_read_resource(s, uri) {
    if (uri == 0) { return 0; }
    var cpfx = "stiva://containers/";
    var ipfx = "stiva://images/";
    var clen = strlen(cpfx);
    var ilen = strlen(ipfx);
    if (strlen(uri) > clen) {
        if (memeq(uri, cpfx, clen) == 1) {
            var c = stiva_inspect(s, uri + clen);
            if (c == 0) {
                stiva_err_print(STIVA_ERR_CONTAINER_NOT_FOUND, uri + clen);
                return 0;
            }
            return str_cstr(json_v_build_pretty(_mcp_container_jv(c, 1), 2));
        }
    }
    if (strlen(uri) > ilen) {
        if (memeq(uri, ipfx, ilen) == 1) {
            var im = stiva_inspect_image(s, uri + ilen);
            if (im == 0) {
                stiva_err_print(STIVA_ERR_IMAGE_NOT_FOUND, uri + ilen);
                return 0;
            }
            return str_cstr(json_v_build_pretty(_mcp_image_jv(im), 2));
        }
    }
    stiva_err_print(STIVA_ERR_INVALID_REFERENCE, _img_cat2("unknown resource URI: ", uri));
    return 0;
}

# Tool dispatch by name (oracle mcp.rs:256).
#
# `stiva_run` stays advertised in tool_list() but reports why it is unavailable
# rather than being dropped from the schema: the schema is the contract a client
# caches, and silently shrinking it is worse than a precise error. It is gated on
# the detached mode the oracle's MCP run uses (mcp.rs:291-334 sets detach=true).
# `stiva_exec` is LIVE as of §D.
fn mcp_handle_tool(s, name, params) {
    if (name == 0) { return mcp_result_err("missing tool name"); }
    if (streq(name, "stiva_pull") == 1) { return mcp_handle_pull(s, params); }
    if (streq(name, "stiva_ps") == 1) { return mcp_handle_ps(s); }
    if (streq(name, "stiva_stop") == 1) { return mcp_handle_stop(s, params); }
    if (streq(name, "stiva_push") == 1) { return mcp_handle_push(s, params); }
    if (streq(name, "stiva_inspect") == 1) { return mcp_handle_inspect(s, params); }
    if (streq(name, "stiva_build") == 1) { return mcp_handle_build(s, params); }
    if (streq(name, "stiva_ansamblu") == 1) { return mcp_handle_ansamblu(params); }
    if (streq(name, "stiva_run") == 1) {
        return mcp_result_err(
          "stiva_run unavailable: MCP run is detached, needing kavach sandbox_spawn (v3.1)");
    }
    if (streq(name, "stiva_exec") == 1) { return mcp_handle_exec(s, params); }
    return mcp_result_err(_img_cat2("unknown tool: ", name));
}
