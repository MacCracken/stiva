# --- error.cyr ---

# stiva — error codes
# Ported from rust-old/src/error.rs (enum StivaError).
#
# The Rust `StivaError` variants each carry a `String` context payload; in
# Cyrius the idiom (mirroring kavach's error.cyr) is an integer code enum
# plus a `stiva_err_print(code, detail)` where the caller supplies the
# context cstr. Functions return the code; callers carry the detail.
#
# Members are namespaced `STIVA_ERR_*` — Cyrius hoists enum members to
# global constants under "last definition wins", so bare generic names
# (`OK`, `RUNTIME`, `IO_ERROR`) would silently collide with any dep minting
# the same name. The `STIVA_ERR_*` prefix keeps every member globally
# unique. (Same convention as kavach `KAVACH_ERR_*`.)

enum StivaError {
    STIVA_ERR_OK = 0;
    STIVA_ERR_IMAGE_NOT_FOUND = 1;
    STIVA_ERR_PULL_FAILED = 2;
    STIVA_ERR_CONTAINER_NOT_FOUND = 3;
    STIVA_ERR_ALREADY_RUNNING = 4;
    STIVA_ERR_INVALID_STATE = 5;
    STIVA_ERR_RUNTIME = 6;
    STIVA_ERR_NETWORK = 7;
    STIVA_ERR_STORAGE = 8;
    STIVA_ERR_REGISTRY = 9;
    STIVA_ERR_INVALID_REFERENCE = 10;
    STIVA_ERR_DIGEST_MISMATCH = 11;
    STIVA_ERR_AUTH_FAILED = 12;
    STIVA_ERR_UNSUPPORTED_PLATFORM = 13;
    STIVA_ERR_ANSAMBLU = 14;
    STIVA_ERR_LAYER_UNPACK = 15;
    STIVA_ERR_OVERLAY = 16;
    STIVA_ERR_PORT_MAPPING = 17;
    STIVA_ERR_SANDBOX = 18;
    STIVA_ERR_SCAN_BLOCKED = 19;
    STIVA_ERR_FLEET = 20;
    STIVA_ERR_MIGRATION = 21;
    STIVA_ERR_AUDIT = 22;
    STIVA_ERR_ENCRYPTION = 23;
    STIVA_ERR_OCI_BUNDLE = 24;
    STIVA_ERR_ROOTLESS_NETWORK = 25;
    STIVA_ERR_IO = 26;
    STIVA_ERR_JSON = 27;
    STIVA_ERR_HTTP = 28;
}

# Human-readable message for an error code — matches the Rust
# `#[error("...")]` display strings (context payload elided; append `detail`
# at the call site via stiva_err_print).
#[must_use]
fn stiva_err_name(code) {
    if (code == STIVA_ERR_OK) { return "ok"; }
    if (code == STIVA_ERR_IMAGE_NOT_FOUND) { return "image not found"; }
    if (code == STIVA_ERR_PULL_FAILED) { return "image pull failed"; }
    if (code == STIVA_ERR_CONTAINER_NOT_FOUND) { return "container not found"; }
    if (code == STIVA_ERR_ALREADY_RUNNING) { return "container already running"; }
    if (code == STIVA_ERR_INVALID_STATE) { return "invalid state"; }
    if (code == STIVA_ERR_RUNTIME) { return "runtime error"; }
    if (code == STIVA_ERR_NETWORK) { return "network error"; }
    if (code == STIVA_ERR_STORAGE) { return "storage error"; }
    if (code == STIVA_ERR_REGISTRY) { return "registry error"; }
    if (code == STIVA_ERR_INVALID_REFERENCE) { return "invalid image reference"; }
    if (code == STIVA_ERR_DIGEST_MISMATCH) { return "digest mismatch"; }
    if (code == STIVA_ERR_AUTH_FAILED) { return "authentication failed"; }
    if (code == STIVA_ERR_UNSUPPORTED_PLATFORM) { return "unsupported platform"; }
    if (code == STIVA_ERR_ANSAMBLU) { return "ansamblu error"; }
    if (code == STIVA_ERR_LAYER_UNPACK) { return "layer unpack error"; }
    if (code == STIVA_ERR_OVERLAY) { return "overlay error"; }
    if (code == STIVA_ERR_PORT_MAPPING) { return "port mapping error"; }
    if (code == STIVA_ERR_SANDBOX) { return "sandbox error"; }
    if (code == STIVA_ERR_SCAN_BLOCKED) { return "scan blocked"; }
    if (code == STIVA_ERR_FLEET) { return "fleet error"; }
    if (code == STIVA_ERR_MIGRATION) { return "migration error"; }
    if (code == STIVA_ERR_AUDIT) { return "audit error"; }
    if (code == STIVA_ERR_ENCRYPTION) { return "encryption error"; }
    if (code == STIVA_ERR_OCI_BUNDLE) { return "oci bundle error"; }
    if (code == STIVA_ERR_ROOTLESS_NETWORK) { return "rootless network error"; }
    if (code == STIVA_ERR_IO) { return "io error"; }
    if (code == STIVA_ERR_JSON) { return "json error"; }
    if (code == STIVA_ERR_HTTP) { return "http error"; }
    return "unknown error";
}

# Diagnostics to stderr (fd 2): "stiva: <name>[: <detail>]\n". `detail` is
# a NUL-terminated cstr or 0 for none.
fn stiva_err_print(code, detail) {
    var name = stiva_err_name(code);
    sys_write(2, "stiva: ", 7);
    sys_write(2, name, strlen(name));
    if (detail != 0) {
        sys_write(2, ": ", 2);
        sys_write(2, detail, strlen(detail));
    }
    sys_write(2, "\n", 1);
    return 0;
}

# --- oci.cyr ---

# stiva — OCI runtime spec conformance (leaf surface)
# Ported from rust-old/src/oci.rs.
#
# This module carries the parts of oci.rs with no intra-crate coupling:
# the OCI runtime-spec version, the OciStatus enum + its serde names, and
# `parse_signal`. The container-coupled helpers from oci.rs
# (`to_oci_status`, `build_state`, `parse_bundle`) depend on
# container.rs's `Container` / `ContainerState` / `ContainerConfig` and
# land with src/container.cyr — see the DEFERRED block at the bottom.

# OCI runtime spec version we conform to (rust-old: OCI_VERSION).
#[must_use]
fn oci_version() {
    return "1.2.0";
}

# OCI container status — spec-defined values (rust-old: enum OciStatus).
# Prefixed OCI_STATUS_* for global enum-member uniqueness (see error.cyr).
enum OciStatus {
    OCI_STATUS_CREATING = 0;
    OCI_STATUS_CREATED = 1;
    OCI_STATUS_RUNNING = 2;
    OCI_STATUS_STOPPED = 3;
}

# Serde wire name for an OciStatus (the `#[serde(rename = "...")]` values).
#[must_use]
fn oci_status_name(status) {
    if (status == OCI_STATUS_CREATING) { return "creating"; }
    if (status == OCI_STATUS_CREATED) { return "created"; }
    if (status == OCI_STATUS_RUNNING) { return "running"; }
    if (status == OCI_STATUS_STOPPED) { return "stopped"; }
    return "unknown";
}

# Inverse of oci_status_name: serde wire name → OciStatus ordinal, or -1 for
# an unknown token (used by OciState deserialization in container.cyr).
#[must_use]
fn oci_status_from_name(name) {
    if (streq(name, "creating") == 1) { return OCI_STATUS_CREATING; }
    if (streq(name, "created") == 1) { return OCI_STATUS_CREATED; }
    if (streq(name, "running") == 1) { return OCI_STATUS_RUNNING; }
    if (streq(name, "stopped") == 1) { return OCI_STATUS_STOPPED; }
    return 0 - 1;
}

# True (1) iff every byte of NUL-terminated `s` is an ASCII digit and `s`
# is non-empty. Used to decide the numeric-vs-name branch in parse_signal.
#[must_use]
fn _sig_is_numeric(s) {
    if (load8(s) == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Parse a signal string — accepts numbers ("15"), names ("TERM"), and
# SIG-prefixed names ("SIGTERM"). Returns the signal number (1..64) on
# success, or -1 on an invalid/unknown signal (rust-old returned
# Err(StivaError::OciBundle(...)); the caller maps -1 → STIVA_ERR_OCI_BUNDLE).
#[must_use]
fn parse_signal(s) {
    # Numeric first — valid range is 1..64 inclusive (rust-old: 0 < n < 65).
    if (_sig_is_numeric(s) == 1) {
        var n = atoi(s);
        if (n > 0 && n < 65) { return n; }
        return 0 - 1;
    }

    # Strip an optional "SIG" prefix.
    var name = s;
    if (strlen(s) >= 3 && memeq(s, "SIG", 3) == 1) { name = s + 3; }

    if (streq(name, "HUP") == 1) { return 1; }
    if (streq(name, "INT") == 1) { return 2; }
    if (streq(name, "QUIT") == 1) { return 3; }
    if (streq(name, "ILL") == 1) { return 4; }
    if (streq(name, "TRAP") == 1) { return 5; }
    if (streq(name, "ABRT") == 1 || streq(name, "ABORT") == 1) { return 6; }
    if (streq(name, "BUS") == 1) { return 7; }
    if (streq(name, "FPE") == 1) { return 8; }
    if (streq(name, "KILL") == 1) { return 9; }
    if (streq(name, "USR1") == 1) { return 10; }
    if (streq(name, "SEGV") == 1) { return 11; }
    if (streq(name, "USR2") == 1) { return 12; }
    if (streq(name, "PIPE") == 1) { return 13; }
    if (streq(name, "ALRM") == 1 || streq(name, "ALARM") == 1) { return 14; }
    if (streq(name, "TERM") == 1) { return 15; }
    if (streq(name, "STKFLT") == 1) { return 16; }
    if (streq(name, "CHLD") == 1 || streq(name, "CHILD") == 1) { return 17; }
    if (streq(name, "CONT") == 1) { return 18; }
    if (streq(name, "STOP") == 1) { return 19; }
    if (streq(name, "TSTP") == 1) { return 20; }
    if (streq(name, "TTIN") == 1) { return 21; }
    if (streq(name, "TTOU") == 1) { return 22; }
    return 0 - 1;
}

